  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Highly skilled and attentive groomers"
      },
      "text": {
        "en": "Clients consistently applaud groomers Kevin, Beth, Jasmine, and concierge Ruben for their professionalism, warmth, and attention to detail. Reviewers emphasize that the team listens closely to styling requests and follows them precisely. Several owners note that groomers also alert them to potential health issues, like new lumps or limping, observed during care."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Exceptional styling across diverse coats"
      },
      "text": {
        "en": "Pet owners rave about the beautiful results of every grooming session, highlighting immaculate haircuts, thorough deshedding, and pleasant-smelling coats. Reviewers specifically praise the salon's capability with demanding breeds, including wire-hair coat hand-stripping, fluffy Samoyeds, and dense Doodle textures that require expert styling."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Gentle approach for sensitive dogs"
      },
      "text": {
        "en": "Reviewers repeatedly note how comfortable and relaxed their dogs feel at the salon. Owners of shy, fearful, or paw-sensitive dogs praise the staff's calm patience and reassuring demeanor. Clients appreciate the stress-free environment, emphasizing that even pets who previously disliked grooming show visible excitement upon arrival."
      }
    }
  ],
  "faq": [
