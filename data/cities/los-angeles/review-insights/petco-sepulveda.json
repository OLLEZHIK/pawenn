    },
    {
      "q": {
        "en": "Can staff assist customers with heavy purchases to vehicles?"
      },
      "a": {
        "en": "Yes, shoppers mention helpful employees assisting with carrying heavy bags of pet food and cat litter."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are visiting pets welcome inside the store?"
      },
      "a": {
        "en": "Yes, customers regularly bring leashed pets inside, and cashiers often offer them treats at checkout."
