      "title": {
        "en": "Unexpected fees and package costs"
      },
      "text": {
        "en": "Multiple reviewers express dissatisfaction with overall pricing transparency. Clients mention recurring exam charges added to booster vaccinations without upfront notice, while others report steep estimates for diagnostic tests and feel pressured toward purchasing monthly wellness packages."
      }
    }
