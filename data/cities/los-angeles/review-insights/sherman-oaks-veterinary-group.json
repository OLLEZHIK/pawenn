    },
    {
      "q": {
        "en": "Does the clinic offer in-home or compassionate end-of-life care?"
      },
      "a": {
        "en": "Yes, clients highlight Dr. Lockhart's gentle and supportive in-home euthanasia services for senior pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is assistance available for pet owners with disabilities?"
      },
      "a": {
        "en": "Yes, staff accommodate handicapped owners by assisting with pet transfer directly from parked vehicles."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are international pet health certificates provided?"
      },
      "a": {
        "en": "Yes, staff members guide clients through veterinary documentation and requirements for relocations, including to Hawaii."
      },
      "basis": "reviews"
    }
