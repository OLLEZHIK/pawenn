  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 29,
      "title": {
        "en": "Courteous clerks alongside line delays"
      },
      "text": {
        "en": "Many shoppers praise store associates for their warm customer service, helpful directions in the aisles, and welcoming assistance during checkout. On the other hand, multiple dissatisfied customers report frustrating experiences with management communication, unhelpful telephone support, and cashier shortages that leave staff overwhelmed during peak store hours."
      }
    },
    {
      "topic": "place",
      "sentiment": "mixed",
      "mentions": 16,
      "title": {
        "en": "Large store selection with facility issues"
      },
      "text": {
        "en": "Pet owners value this large retail location for its extensive stock of cat and dog food brands, pet habitats, and treats. Several shoppers appreciate easy parking access and spacious aisles, though critical customers noted disappointing facility changes including the removal of public restrooms and an instance of poorly maintained rental equipment."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 8,
      "title": {
        "en": "Persistent delays at checkout registers"
      },
      "text": {
        "en": "A frequent complaint among reviewers centers on prolonged wait times and bottlenecked checkout lines. Shoppers report standing in lines with ten to twenty customers during both weekdays and weekends due to undermanned registers, with several pet owners advising future visitors to anticipate delays when purchasing items in person."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are checkout wait times typically long at this store?"
      },
      "a": {
        "en": "Yes, multiple reviewers report long register lines with ten to twenty shoppers, advising visitors to expect delays."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is parking readily accessible for shoppers?"
      },
      "a": {
        "en": "Yes, visitors mention convenient and plentiful parking available near the store entrance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the store offer fast in-store pickup for online orders?"
      },
      "a": {
        "en": "Yes, customers and delivery drivers report quick turnaround for pre-ordered items and online order pickups."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are public restrooms available inside the facility?"
      },
      "a": {
        "en": "Reviewers note that public restrooms were discontinued for customers at this location."
      },
