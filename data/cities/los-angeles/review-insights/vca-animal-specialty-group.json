  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 54,
      "title": {
        "en": "Skilled specialists beside front desk friction"
      },
      "text": {
        "en": "Pet owners express deep appreciation for board-certified surgeons and neurologists who handle complex medical cases with dedication. However, numerous clients report dismissive interactions with triage staff and administrative personnel during emergency check-ins."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Dependable specialty and surgical outcomes"
      },
      "text": {
        "en": "Clients report strong clinical success for spinal neurosurgeries, orthopedic TPLO repairs, and intensive emergency interventions. Families credit the hospital team with stabilizing critically ill pets and guiding them through difficult postoperative recoveries."
      }
    },
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 15,
      "title": {
        "en": "Persistent challenges with medical updates"
      },
      "text": {
        "en": "A substantial number of pet parents recount frustrating communication barriers while their animals were hospitalized. Common complaints involve difficulty reaching attending veterinarians, delayed test updates, and perceived lack of empathy during triage."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the hospital handle specialized neurology and spinal cases?"
      },
      "a": {
        "en": "Yes, reviewers frequently highlight the neurology department for managing seizures, disk disease, and advanced spinal surgeries."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the emergency triage process work?"
      },
      "a": {
        "en": "Patients are triaged based on medical acuity; clients note that non-life-threatening cases may experience lengthy waits in the lobby."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are estimates provided prior to major surgeries or hospitalization?"
      },
      "a": {
        "en": "Yes, written estimates are given, though reviewers advise preparing for substantial costs associated with multi-day intensive care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pet owners receive daily updates when an animal is admitted?"
      },
      "a": {
        "en": "Reviewers report mixed experiences, with surgical teams providing thorough post-op calls while emergency updates can require persistent owner outreach."
      },
      "basis": "reviews"
    }
  ],
