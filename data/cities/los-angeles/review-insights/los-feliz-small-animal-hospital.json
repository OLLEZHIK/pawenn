  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "en": "Attentive and dedicated veterinary team"
      },
      "text": {
        "en": "Pet owners frequently praise the veterinary doctors, technicians, and reception team for their supportive and attentive care. Reviewers often highlight Dr. Ehlinger and Dr. Erlinger for their patience and gentle guidance during visits. A few clients noted occasional communication friction with front desk staff or specific doctors, but overall sentiment remains overwhelmingly appreciative."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Reliable treatments and wellness procedures"
      },
      "text": {
        "en": "Clients report dependable medical treatments across routine wellness visits, dental cleaning, vaccinations, and diagnostic evaluations. Many pet parents note successful health outcomes for cats and senior dogs dealing with ongoing conditions. While a couple of reviewers felt complex diagnostic situations could have been handled better, most express strong satisfaction with clinical treatments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Gentle handling for anxious pets"
      },
      "text": {
        "en": "Reviewers consistently highlight how gently and patiently the clinic staff handles pets, including anxious dogs and fearful cats with behavioral challenges. Clients appreciate that veterinary technicians and doctors take time to comfort animals during exams and procedures, avoiding rushed or forceful behavior to keep pets at ease throughout their visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do reviewers describe the veterinary staff and doctors?"
      },
      "a": {
        "en": "Most clients praise the doctors and technicians for compassionate, patient, and knowledgeable care, highlighting attentive checkups for both dogs and cats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What procedures and clinical services are commonly mentioned?"
      },
      "a": {
        "en": "Reviews frequently cite routine wellness exams, dental cleanings and extractions, puppy vaccinations, allergy treatments, and diagnostic evaluations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the clinic accommodate anxious pets?"
      },
      "a": {
        "en": "Owners of fearful or reactive pets report that staff members take their time, handle pets gently, and create a calm atmosphere without rushing."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are appointments easy to schedule at this hospital?"
      },
      "a": {
        "en": "Clients generally report smooth booking and prompt visit flow, though urgent care slots can fill up quickly on busy days."
      },
      "basis": "reviews"
    }
  ],
