  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 60,
      "title": {
        "en": "Compassionate specialists and attentive nurses"
      },
      "text": {
        "en": "A substantial majority of pet owners praise the specialty doctors, surgeons, oncologists, and emergency clinicians for their empathy and clear explanations. Reviewers highlight Dr. Hadar and the nursing staff for attentive monitoring during critical illnesses, though a few clients encountered friction with reception personnel."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "en": "Advanced surgical care and trauma recovery"
      },
      "text": {
        "en": "Clients report dependable outcomes for complex medical conditions, including emergency blockages, foreign body surgeries, cancer management, and acute cardiac events. Pet parents credit the specialty clinical team with saving their companions' lives when local primary veterinarians could not provide advanced care."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 17,
      "title": {
        "en": "Steep emergency hospitalization and procedural fees"
      },
      "text": {
        "en": "Reviewers frequently note that medical care at this specialty center is costly, with surgical estimates and inpatient stays ranging from several thousand dollars upward. While many owners consider the expense worthwhile for advanced intensive care, several clients felt distressed by unexpected diagnostic charges."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the hospital operate twenty-four hours a day?"
      },
      "a": {
        "en": "Yes, the San Fernando Valley location provides 24-hour emergency intake and critical veterinary care."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What specialized veterinary disciplines are offered?"
      },
      "a": {
        "en": "Specialties include emergency and critical care, internal medicine, soft tissue and orthopedic surgery, and oncology."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are detailed treatment estimates provided prior to procedures?"
      },
      "a": {
        "en": "Yes, clinicians provide cost breakdowns and treatment plans, though emergency care and inpatient stays remain costly."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the clinic communicate with primary family veterinarians?"
      },
      "a": {
        "en": "Specialists coordinate with referring family doctors by transmitting medical records, diagnostic scans, and post-discharge summaries."
      },
      "basis": "both"
    }
  ],
