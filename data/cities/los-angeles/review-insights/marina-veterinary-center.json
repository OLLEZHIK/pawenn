  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Caring doctors and friendly support staff"
      },
      "text": {
        "en": "The majority of pet owners express strong confidence in Dr. Karen Halligan, Dr. Jordan, and the veterinary technicians. Reviewers praise their compassionate demeanor, thorough diagnostics, and patient explanations during examinations. A few negative reviews mention occasional friction with front desk staff and communication regarding fees."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Attentive treatment of visiting pets"
      },
      "text": {
        "en": "Pet parents highlight the gentle care shown to both dogs and cats. Reviews mention staff assisting clients carrying cats into the facility, calming anxious pets during examinations, and showing deep compassion during difficult end-of-life care. Clients feel their pets are treated with genuine respect."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Effective treatments and diagnostic results"
      },
      "text": {
        "en": "Clients report dependable medical outcomes for complex illnesses and emergencies. Reviewers credit the medical team with accurately diagnosing autoimmune conditions, performing successful emergency surgeries, and improving pet mobility through integrative treatments including light laser therapy."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the center handle walk-in pet emergencies?"
      },
      "a": {
        "en": "Yes, clients report that the team accommodated emergency walk-ins for urgent issues like pyometra and acute pain."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What specialized treatments are available here?"
      },
      "a": {
        "en": "Pet owners mention traditional medical care alongside integrative modalities such as laser therapy and acupuncture."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can I obtain a pet health certificate for travel?"
      },
      "a": {
        "en": "Yes, clients report scheduling appointments specifically to obtain official health certificates for dog travel."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are treatment costs and estimates handled?"
      },
      "a": {
        "en": "Estimates are provided before treatment, though several reviewers note that fees for specialized care can be high."
      },
      "basis": "reviews"
    }
