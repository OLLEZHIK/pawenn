  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "en": "Skilled emergency doctors and nursing team"
      },
      "text": {
        "en": "Pet owners consistently commend the clinical capabilities of the emergency doctors, veterinary surgeons, and intensive care nurses. Clinicians are praised for prompt interventions that saved choking pets and stabilized trauma cases. However, some reviewers felt customer service representatives in the lobby were detached during billing."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 35,
      "title": {
        "en": "Life-saving interventions alongside grave diagnoses"
      },
      "text": {
        "en": "Reviewers report life-saving recoveries following severe gastrointestinal blockages, respiratory distress, and internal oncology treatments. Nevertheless, sentiment remains mixed because emergency cases frequently involve advanced terminal illnesses or sudden pet loss, leaving grieving owners feeling devastated."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 17,
      "title": {
        "en": "Substantial emergency estimates and diagnostic fees"
      },
      "text": {
        "en": "Many reviewers express shock at the substantial costs associated with emergency hospitalization, advanced CT imaging, and surgical procedures. Clients report estimates ranging from five thousand to over ten thousand dollars, noting that high upfront payment requirements add intense emotional pressure during crises."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is emergency veterinary care available around the clock?"
      },
      "a": {
        "en": "Yes, BluePearl operates as a 24-hour emergency and specialty hospital every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners stay with their pets in the treatment area?"
      },
      "a": {
        "en": "Reviewers report that animals are typically taken to back evaluation rooms for triage while owners wait in the reception lobby."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What specialty departments operate at this facility?"
      },
      "a": {
        "en": "The hospital offers emergency medicine, critical care, internal medicine, surgery, oncology, and advanced diagnostic imaging."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the hospital handle treatment payment estimates?"
      },
      "a": {
        "en": "Staff provide itemized financial estimates prior to admission, requiring deposits or upfront approval before hospitalization."
      },
      "basis": "reviews"
    }
  ],
