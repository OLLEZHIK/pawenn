  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 236,
      "title": {
        "en": "Caring and supportive emergency staff"
      },
      "text": {
        "en": "Pet owners overwhelmingly commend the doctors, veterinary technicians, and reception team for their warmth, compassion, and tireless dedication. Reviewers frequently call out individual technicians by name, highlighting their reassuring presence during high-stress emergency visits. A smaller group of reviewers felt certain interactions felt rushed or indifferent, but the vast majority report exceptional support."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 138,
      "title": {
        "en": "Gentle and compassionate pet care"
      },
      "text": {
        "en": "Reviewers frequently praise how tenderly and respectfully the veterinary team handles pets during emergency triage, medical checkups, and post-surgery care. Clients with nervous or distressed dogs and cats appreciate the calm, gentle techniques used by technicians to soothe animals in pain, helping them feel secure and comfortable during stressful clinic visits."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 81,
      "title": {
        "en": "Clear guidance and thorough explanations"
      },
      "text": {
        "en": "Most clients appreciate the clear and transparent explanations provided by veterinary technicians and veterinarians regarding treatment plans, medication schedules, and surgical procedures. Several reviewers note that staff members patiently answered all of their questions. A subset of clients reported occasional gaps in communication or delayed phone updates during peak emergency triage."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do reviewers view the veterinary technicians and staff?"
      },
      "a": {
        "en": "Clients consistently praise technicians and doctors for compassionate care, gentle pet handling, and thorough explanations during both routine and emergency visits."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What should pet owners know about wait times during emergencies?"
      },
      "a": {
        "en": "Wait times vary significantly; while many patients are seen quickly, critical triage cases during peak emergency periods can result in longer waits for non-life-threatening conditions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital provide detailed explanations of post-care instructions?"
      },
      "a": {
        "en": "Yes, numerous pet owners specifically mention that technicians provide clear, step-by-step guidance on administering medications and managing recovery at home."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are emergency and urgent medical services available?"
      },
      "a": {
        "en": "Yes, clients frequently utilize the hospital for acute issues such as sudden injuries, infections, ingestions, and after-hours medical emergencies."
      },
      "basis": "reviews"
    }
  ],
