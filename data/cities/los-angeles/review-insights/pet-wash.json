  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Fresh grooming cuts and thorough baths"
      },
      "text": {
        "en": "Clients express high satisfaction with the quality of bathing, hair trims, and nail care provided by the salon. Pet owners frequently note that dogs leave smelling fresh, thoroughly dried, and looking impeccably brushed, with de-shedding treatments significantly reducing shedding at home. Isolated complaints mention occasional damp coats or minor nail irritation."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Gentle groomers and accommodating front desk"
      },
      "text": {
        "en": "The grooming staff receives widespread praise for patience and gentle animal handling, with groomer Hector frequently highlighted for his calm demeanor. Patrons appreciate that employees accommodate nervous rescues and high-energy pets with care. Front desk attendants are commended for flexible scheduling, though one client noted an unprofessional cashier encounter."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 9,
      "title": {
        "en": "Gentle handling for multiple animals"
      },
      "text": {
        "en": "Reviewers emphasize how comfortably pets behave during salon visits, noting that dogs frequently walk through the door eagerly with wagging tails. Cat owners appreciate the delicate attention given during feline grooming and claw care. Patrons feel reassured that groomers prioritize pet safety and comfort above all else."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are self-service dog wash stations available?"
      },
      "a": {
        "en": "Yes, pet owners can bathe their own dogs using on-site wash tubs, shampoos, and blow-drying equipment, with cutoff times typically around 5:00 PM."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the salon groom cats as well as dogs?"
      },
      "a": {
        "en": "Yes, clients report booking bath, claw-trimming, and vinyl nail cap services for cats, though groomers prioritize safety if a cat becomes overly stressed."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can I book a specialized de-shedding treatment?"
      },
      "a": {
        "en": "Yes, owners of double-coated breeds like Huskies frequently add de-shedding treatments to their full grooming packages to reduce heavy seasonal shedding."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How easy is it to schedule an appointment?"
      },
      "a": {
        "en": "Clients mention that online booking is quick and straightforward, and the salon frequently accommodates flexible scheduling requests."
      },
      "basis": "reviews"
    }
  ],
