  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Compassionate doctors and skilled medical team"
      },
      "text": {
        "en": "The vast majority of clients commend Dr. McGrath, Dr. Miller, and attentive assistants like Abby for thorough clinical evaluations and compassionate care. Longtime pet owners appreciate their thoughtful bedside manner during difficult medical crises. While most experiences are warm and supportive, a few clients noted occasional friction with front desk receptionists."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 14,
      "title": {
        "en": "Strong emergency outcomes alongside misdiagnoses"
      },
      "text": {
        "en": "Medical treatments receive mixed evaluations depending on the circumstance. Numerous reviewers credit the team with resolving complex conditions, performing flawless surgeries, and providing vital emergency interventions for acute allergic reactions. In contrast, several clients report delayed diagnoses, unresolved symptoms following hospital discharge, and pain management oversights."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 8,
      "title": {
        "en": "High fees and test upcharges"
      },
      "text": {
        "en": "Pricing is a consistent source of criticism among clients. Many pet owners characterize the clinic as among the costliest in the San Fernando Valley, citing steep examination fees and expensive medication markups. Several reviewers report unexpected estimates exceeding several hundred to thousands of dollars, expressing concern over perceived pressure to approve extensive diagnostic testing."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is the center equipped to handle pet emergencies?"
      },
      "a": {
        "en": "Yes, clients frequently highlight the hospital's advanced emergency capabilities for urgent medical situations such as acute allergic reactions and trauma."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How quickly can appointments be scheduled?"
      },
      "a": {
        "en": "Reviewers note that appointments can often be secured within 24 hours, and same-day visits are frequently accommodated for urgent medical concerns."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are detailed estimates provided prior to treatment?"
      },
      "a": {
        "en": "Yes, while clients note high overall costs, the clinic routinely presents estimates before proceeding with hospital procedures and diagnostic testing."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital provide overnight hospitalization?"
      },
      "a": {
        "en": "Yes, pet owners report multi-day inpatient stays and observation for pets suffering from serious systemic illnesses like pancreatitis."
      },
      "basis": "reviews"
    }
