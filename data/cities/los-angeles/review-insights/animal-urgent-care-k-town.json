  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 58,
      "title": {
        "en": "Compassionate Emergency Doctors and Technicians"
      },
      "text": {
        "en": "A large majority of pet owners praise the emergency veterinarians and nursing staff for their empathy, calm guidance, and quick action during crises. Reviewers specifically thank Dr. Goodman, Dr. Linney, and Dr. Lee, although several dissatisfied clients reported encountering dismissive attitudes at the front desk."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Prompt Walk-in Triage and Intake"
      },
      "text": {
        "en": "Clients consistently appreciate the fast intake and availability for immediate walk-in emergencies, especially on weekends and late Friday evenings when primary clinics are closed. While most pets are examined right away, one reviewer reported an extreme wait during an overcrowded shift."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Effective Crisis Intervention and Stabilization"
      },
      "text": {
        "en": "Pet parents report dependable clinical outcomes for critical emergencies, including severe allergic reactions, toxin ingestion, bite wounds, and urinary blockages. Reviewers credit the veterinary team with saving their animals' lives, with only isolated concerns regarding post-procedure wound follow-ups."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the urgent care clinic accept walk-ins without an appointment?"
      },
      "a": {
        "en": "Yes, pet parents report that the clinic accepts immediate same-day walk-ins for pet medical crises and weekend emergencies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are Spanish-speaking staff members available at the facility?"
      },
      "a": {
        "en": "Yes, clients highlight that bilingual Spanish-speaking veterinary staff members are available to assist pet owners."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What types of pet emergencies are treated here?"
      },
      "a": {
        "en": "Reviewers report treatment for allergic reactions, toxic ingestion, fight wounds requiring stitches, urinary blockages, and sudden illnesses."
      },
      "basis": "reviews"
    }
  ],
