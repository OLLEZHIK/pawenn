  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 23,
      "title": {
        "en": "Compassionate doctors alongside reception concerns"
      },
      "text": {
        "en": "Many reviewers express gratitude for veterinarians like Dr. Ramirez, Dr. Cano, and Dr. Rodriguez, praising their medical dedication and bedside manner. Technicians and assistants are often credited with saving pets in emergencies. However, a significant number of clients report frustrated interactions with front desk personnel, citing unreturned calls, rude remarks, and disorganization during busy hours."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 9,
      "title": {
        "en": "Substantial appointment and lobby delays"
      },
      "text": {
        "en": "Wait times represent a major source of dissatisfaction among visitors. While a few clients experienced prompt care, many report waiting between one and three hours past their scheduled arrival times, even for brief checkups or vaccine administration. Several owners express frustration that pets were kept in back holding rooms for extended periods without timely updates."
      }
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "mentions": 8,
      "title": {
        "en": "Fair routine fees with billing disputes"
      },
      "text": {
        "en": "Opinions regarding fees vary widely across the community. Several clients commend the hospital for providing affordable care, accepting welfare vouchers, and treating lower-income pet owners with respect. Conversely, other reviewers express dismay over unexpectedly high estimates, charges presented only after visits, and disputes over unauthorized diagnostic tests."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic accept vouchers or financial assistance?"
      },
      "a": {
        "en": "Yes, clients report that the clinic works with animal welfare organizations and accepts vouchers to help reduce veterinary costs for low-income pet owners."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What should I know about parking at the clinic?"
      },
      "a": {
        "en": "The on-site parking lot is very compact with only about five or six spaces, so clients recommend seeking street parking nearby."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are pet owners permitted in exam rooms during vaccinations?"
      },
      "a": {
        "en": "Some reviewers note that pets were taken into the back treatment area for routine shots and examinations rather than being treated in the owner's presence."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can the clinic handle same-day urgent care visits?"
      },
      "a": {
        "en": "Yes, reviewers describe successful same-day visits for acute traumas and digestive issues, though advance notice is helpful when possible."
      },
      "basis": "reviews"
    }
