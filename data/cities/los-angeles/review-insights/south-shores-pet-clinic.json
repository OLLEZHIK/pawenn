  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "en": "Helpful and attentive veterinary team"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinarians and support staff at this clinic for their kindness, dedication, and patient demeanor. Many clients highlight Dr. Weimer and Dr. Wills for their thorough evaluations and clear explanations during appointments. A couple of reviews express frustration with front desk interactions or rushed conversations during stressful visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Reliable diagnostic care and recovery"
      },
      "text": {
        "en": "Numerous pet owners report successful health outcomes for their animals, ranging from prompt treatments for ear infections to urgent surgical interventions that saved pets' lives. Clients appreciate accurate diagnoses and effective treatment regimens. Conversely, two negative reviews recount unfortunate outcomes during severe pet illnesses."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "en": "Gentle handling during examinations"
      },
      "text": {
        "en": "Reviewers frequently describe a calm and gentle approach when clinicians handle their dogs and cats. Longtime patrons note that even anxious or elderly animals feel comfortable in the examination rooms. The clinic staff is recognized for showing genuine affection and comforting pets through routine visits and difficult procedures."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can I get a same-day appointment for an urgent issue?"
      },
      "a": {
        "en": "Yes, several clients note that the clinic accommodated urgent same-day or next-day visits for sick animals."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do the doctors explain treatment options clearly?"
      },
      "a": {
        "en": "Yes, pet owners appreciate that veterinarians take time to explain medical findings and home care instructions thoroughly."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is Spanish spoken at the clinic?"
      },
      "a": {
        "en": "Yes, reviewers specifically mention that bilingual staff members are available to assist Spanish-speaking clients."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are wait times and check-out procedures handled?"
      },
      "a": {
        "en": "Appointments generally move quickly, though a few reviewers note occasional delays when waiting to check out and pay."
      },
      "basis": "reviews"
    }
  ],
