    },
    {
      "q": {
        "en": "Does the hospital accept urgent walk-in patients?"
      },
      "a": {
        "en": "Clients report that the clinic accommodates same-day walk-in visits for urgent pet issues, though calling ahead is recommended."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What routine wellness treatments are provided?"
      },
      "a": {
        "en": "The clinic provides general health exams, vaccinations, dental cleanings, spay and neuter surgeries, and pharmacy services."
      },
      "basis": "both"
