  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Warm and caring clinic team"
      },
      "text": {
        "en": "Reviewers frequently praise the veterinary doctors, technicians, and front desk receptionists for their attentive, welcoming demeanor. Pet parents express gratitude for the staff's gentle approach and thorough examinations during visits. While a few clients encountered occasional scheduling confusion or felt rushed, the vast majority describe a positive and compassionate environment."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Clean and welcoming clinic atmosphere"
      },
      "text": {
        "en": "Clients consistently appreciate the clean, modern, and well-maintained clinic facility on Overland Avenue. Pet owners highlight the calm waiting area, tidy examination rooms, and convenient neighborhood location with accessible parking. The professional setting helps put both pet owners and animals at ease during routine wellness checkups and veterinary visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Gentle handling of family pets"
      },
      "text": {
        "en": "Pet owners frequently highlight how lovingly and gently the clinic staff treats dogs and cats. Many reviews describe veterinary technicians using soft techniques, treats, and calming handling to comfort fearful or timid pets during exams, blood draws, and routine vaccinations. Clients feel confident bringing their beloved companion animals to the clinic."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do clients describe the hospital environment?"
      },
      "a": {
        "en": "Reviewers frequently commend the clean, calm, and well-organized facility, noting that the tidy environment helps anxious pets feel comfortable."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the veterinary staff treat nervous animals?"
      },
      "a": {
        "en": "Pet parents report that doctors and technicians handle animals with exceptional patience and gentleness, taking extra care to soothe nervous pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What routine services are most frequently mentioned?"
      },
      "a": {
        "en": "Reviews commonly highlight wellness exams, vaccinations, heartworm tests, microchipping, and routine preventive care for cats and dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the clinic easy to access?"
      },
      "a": {
        "en": "Yes, clients appreciate the convenient West LA location on Overland Avenue along with accessible neighborhood parking."
      },
      "basis": "reviews"
    }
  ],
