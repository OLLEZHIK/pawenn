  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 61,
      "title": {
        "pl": "Cierpliwa i serdeczna właścicielka salonu",
        "en": "Patient and caring salon founder"
      },
      "text": {
        "pl": "Klienci w dziesiątkach opinii niezwykle ciepło wypowiadają się o pani Ewelinie, podkreślając jej wieloletnie doświadczenie, empatię i cierpliwość. Wielu właścicieli korzysta z jej usług regularnie od kilku, a nawet kilkunastu lat. Pojawił się pojedynczy głos zarzucający chłodniejsze podejście.",
        "en": "Clients in numerous glowing reviews enthusiastically commend Ms. Ewelina for her gentle bedside manner, decades of hands-on expertise, and exceptional patience. Many pet parents have visited faithfully for years. A rare isolated note mentioned a cooler reception during a busy period."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "pl": "Bezstresowe podejście do wrażliwych psów",
        "en": "Low-stress care for nervous dogs"
      },
      "text": {
        "pl": "Opiekunowie czworonogów zachwycają się doskonałym podejściem do psów lękliwych, starszych oraz wymagających szczególnego traktowania. W salonie strzyżone i pielęgnowane są pudle, maltańczyki, sznaucery oraz owczarki, które według relacji wychodzą zadowolone, zrelaksowane i spokojne.",
        "en": "Dog guardians frequently applaud the gentle handling of nervous, rescue, and senior pets that require soothing reassurance. Poodles, Maltese dogs, Schnauzers, and German Shepherds are groomed calmly, with clients reporting their companions leave relaxed, happy, and remarkably stress-free."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "pl": "Precyzyjne fryzury i staranna pielęgnacja",
        "en": "Precise haircuts and attentive grooming"
      },
      "text": {
        "pl": "Recenzje systematycznie chwalą wysoką jakość strzyżenia, kąpieli pielęgnacyjnych oraz trymowania szaty. Właściciele psów podkreślają estetykę wykonania, dbałość o detale i idealne dopasowanie fryzury do wzorca rasy, określając metamorfozy swoich czworonogów jako nienaganne.",
        "en": "Reviews consistently praise the high standards of coat trimming, conditioning baths, and hand stripping. Pet owners emphasize flawless styling, meticulous attention to detail, and coat trims neatly tailored to breed standards, often describing the results as marvelous transformations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pl": "Jakie rasy psów są przyjmowane w salonie MyDog?",
        "en": "Which dog breeds are accepted at the MyDog salon?"
      },
      "a": {
        "pl": "Salon obsługuje psy małych, średnich i dużych ras, w tym pudle i maltańczyki.",
        "en": "The salon caters to small, medium, and large breeds, including Poodles and Maltese."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "pl": "Gdzie mieści się salon groomerski MyDog?",
        "en": "Where is the MyDog grooming salon located?"
      },
      "a": {
        "pl": "Salon znajduje się przy ul. Krowoderskich Zuchów 14 w krakowskich Krowodrzach.",
        "en": "The salon is located at ul. Krowoderskich Zuchów 14 in Kraków's Krowodrza district."
      },
      "basis": "website"
    },
    {
      "q": {
        "pl": "Czy oprócz usług fryzjerskich dostępny jest sklep?",
        "en": "Is a pet supply store available alongside the salon?"
      },
      "a": {
        "pl": "Tak, na miejscu prowadzona jest także sprzedaż karmy, przysmaków i akcesoriów.",
        "en": "Yes, the premises also include retail sales of food, treats, and pet accessories."
      },
      "basis": "both"
    }
  ],
