  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "en": "Empathetic personnel and experienced doctors",
        "pl": "Empatyczny personel i doświadczeni lekarze"
      },
      "text": {
        "pl": "Opiekunowie zwierząt bardzo ciepło wypowiadają się o kadrze kliniki, wyróżniając dr. Sebastiana Harnika, dr Darię Bachurewicz oraz dr Karinę Skrzypoń. Lekarze są doceniani za ogromne serce, cierpliwość i wyczerpujące wyjaśnienia, choć pojedyncze opinie zwracają uwagę na zmienne zaangażowanie personelu na recepcji.",
        "en": "Pet owners consistently commend the clinical team, frequently singling out doctors for warmth, dedication, and clear medical advice. Veterinarians receive praise for thorough diagnostic explanations and patience with anxious guardians, though isolated remarks note occasional uneven communication at the reception desk."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Gentle and stress-free pet handling",
        "pl": "Delikatne traktowanie czworonogów bez stresu"
      },
      "text": {
        "pl": "W recenzjach powtarza się wątek wyjątkowo łagodnego traktowania psów, kotów i małych ssaków w gabinetach zabiegowych. Personel poświęca czas na oswojenie zwierzęcia przed badaniem, co sprawia, że nawet lękliwe czworonogi znoszą procedury medyczne spokojniej niż w innych miejscach, nie kojarząc wizyty z traumą.",
        "en": "Reviews routinely emphasize the gentle and reassuring bedside manner practiced across all consultation rooms. Veterinary staff prioritize patient comfort by allowing nervous dogs, cats, and small mammals to settle down before exams, resulting in visibly reduced anxiety during blood draws and physical evaluations."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 20,
      "title": {
        "en": "Accurate treatments with isolated disagreements",
        "pl": "Trafne leczenie z pojedynczymi rozbieżnościami"
      },
      "text": {
        "pl": "Większość klientów opisuje skuteczne terapie internistyczne, pomyślne operacje chirurgiczne i trafną diagnostykę USG. Pojawiają się jednak również opinie krytyczne dotyczące sytuacji, w których wstępne rozpoznanie wymagało weryfikacji w innej placówce lub koszty zleconych badań nie przyniosły jednoznacznego rozwiązania problemu.",
        "en": "Most clients report successful outcomes for complex internal medicine cases, surgical procedures, and routine ultrasound evaluations. However, several critical reviews mention instances where preliminary diagnoses differed from secondary specialist opinions, or where extensive diagnostic batteries felt inconclusive."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Where is Alphavet center situated?",
        "pl": "Gdzie znajduje się klinika Alphavet?"
      },
      "a": {
        "en": "The facility is located in the CH Lubostroń shopping center at Lubostroń 15 in the Ruczaj district in Kraków.",
        "pl": "Klinika mieści się w pasażu handlowym CH Lubostroń przy ulicy Lubostroń 15 na krakowskim Ruczaju."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Is the clinic open on weekends?",
        "pl": "Czy klinika przyjmuje pacjentów w weekendy?"
      },
      "a": {
        "en": "Yes, Alphavet is open on Saturdays from 09:00 to 16:00 and on Sundays from 10:00 to 16:00.",
        "pl": "Tak, lecznica jest czynna w soboty w godzinach 09:00–16:00 oraz w niedziele od 10:00 do 16:00."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Is customer parking available near the clinic?",
        "pl": "Czy przy klinice znajduje się parking dla zmotoryzowanych?"
      },
      "a": {
        "en": "Yes, a dedicated parking lot for center customers is available right in front of the building.",
        "pl": "Tak, przed budynkiem centrum handlowego dostępny jest bezpłatny parking dla zmotoryzowanych opiekunów."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet passports and microchips be issued here?",
        "pl": "Czy w klinice można wyrobić paszport i zaczipować pupila?"
      },
      "a": {
        "en": "Yes, veterinarians perform electronic microchipping and issue European pet passports for travel.",
        "pl": "Tak, uprawnieni lekarze przeprowadzają czipowanie oraz wystawiają urzędowe paszporty dla zwierząt."
      },
      "basis": "website"
    }
  ],
