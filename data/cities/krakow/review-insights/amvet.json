  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 66,
      "title": {
        "en": "Dedicated specialists alongside reception criticism",
        "pl": "Zaangażowani specjaliści z krytyką recepcji"
      },
      "text": {
        "pl": "Wielu opiekunów z całego serca dziękuje lekarzom za wiedzę i ratowanie życia zwierząt, wyróżniając dr Golonkę i dr Piątkowską. Jednocześnie liczne opinie bardzo ostro krytykują personel recepcji za chłód, brak empatii w nagłych wypadkach oraz biurokratyczne podejście do zestresowanych właścicieli w poczekalni.",
        "en": "Many owners express profound gratitude to veterinary specialists for lifesaving clinical care, praising specific doctors for dedication and skill. Concurrently, numerous reviews sharply criticize front-desk operations for perceived coldness, lack of empathy during emergencies, and rigid administrative hurdles."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Compassionate approach to diverse animal patients",
        "pl": "Ciepłe podejście do leczonych zwierząt"
      },
      "text": {
        "pl": "Wielu opiekunów podkreśla autentyczną troskę i serce lekarzy do psów, kotów oraz małych ssaków przyjmowanych na oddział. Personel stara się zapewnić spokój pacjentom w stanach zagrożenia życia, poświęcając czas na łagodne obchodzenie się ze zwierzętami cierpiącymi po urazach powypadkowych.",
        "en": "Many owners emphasize the genuine warmth and dedication shown by practitioners toward dogs, cats, and small mammals admitted to the ward. Clinical staff strive to soothe frightened patients during acute crises, handling injured and critically ill animals with attentiveness and gentle care."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 16,
      "title": {
        "en": "Advanced critical care with divided outcomes",
        "pl": "Zaawansowane ratownictwo z rozbieżnymi ocenami"
      },
      "text": {
        "pl": "Klinika dysponuje zaawansowanym zapleczem diagnostycznym i szpitalnym, skutecznie wyprowadzając zwierzęta z ciężkich wypadków i stanów nagłych. Obok licznych podziękowań pojawiają się jednak krytyczne recenzje zarzucające błędy diagnostyczne, opóźnienia w podjęciu terapii czy pogorszenie stanu małych ssaków w szpitalu.",
        "en": "The clinic features advanced imaging and hospital facilities, effectively stabilizing animals after traumatic injuries and acute medical episodes. Beside heartfelt praise, critical reviews report diagnostic discrepancies, delayed intervention on night shifts, or clinical deterioration in hospitalized exotic patients."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Where is AMVET Kraków clinic located?",
        "pl": "Gdzie znajduje się klinika AMVET Kraków?"
      },
      "a": {
        "en": "The clinic is situated at Jasnogórska 1 in the Bronowice district in Kraków.",
        "pl": "Klinika mieści się przy ulicy Jasnogórskiej 1 na krakowskich Bronowicach."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Does the clinic provide round-the-clock emergency care?",
        "pl": "Czy klinika prowadzi dyżur całodobowy?"
      },
      "a": {
        "en": "Yes, emergency admissions, intensive care, and hospitalization operate 24 hours a day, 7 days a week.",
        "pl": "Tak, placówka prowadzi całodobowe przyjęcia w trybie ostrodyżurowym oraz hospitalizację zwierząt."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What advanced diagnostics are available on site?",
        "pl": "Jakie zaawansowane badania diagnostyczne są na miejscu?"
      },
      "a": {
        "en": "The clinic is equipped with veterinary MRI, computed tomography (CT), digital X-ray, and an in-house lab.",
        "pl": "Placówka posiada rezonans magnetyczny (MRI), tomograf (TK), RTG, USG oraz własne laboratorium analityczne."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "How long are wait times during night emergency admissions?",
        "pl": "Ile wynosi czas oczekiwania podczas dyżuru nocnego?"
      },
      "a": {
        "en": "Reviewers note that depending on triage priority and emergency volume, night waits can range from 1 to 4 hours.",
        "pl": "Z opinii wynika, że w zależności od liczby ciężkich przypadków czas oczekiwania w nocy wynosi od 1 do 4 godzin."
      },
      "basis": "reviews"
    }
  ],
