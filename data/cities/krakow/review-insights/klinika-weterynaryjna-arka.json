  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 74,
      "title": {
        "en": "Experienced team and 24-hour availability",
        "pl": "Doświadczony zespół i całodobowa dostępność"
      },
      "text": {
        "en": "Clients value the vast clinical experience and around-the-clock availability of doctors during acute emergencies. While many reviews praise dedicated surgeons and intensive care staff, several owners note occasional haste during peak night shifts when patient influx is heavy.",
        "pl": "Klienci cenią bogate doświadczenie kliniczne oraz całodobową gotowość zespołu podczas nocnych dyżurów. Choć liczne opinie chwalą zaangażowanie chirurgów, pojedynczy opiekunowie wspominają o pośpiechu personelu w momentach dużego obłożenia na ostrym dyżurze."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 65,
      "title": {
        "en": "Intensive monitoring and mixed ward reviews",
        "pl": "Intensywna opieka i zróżnicowane oceny szpitala"
      },
      "text": {
        "en": "Pet guardians acknowledge the advanced intensive care unit for critical hospitalizations, where pets receive oxygen and continuous monitoring. However, a noticeable portion of reviewers express concern regarding high stress levels and limited visitation in inpatient wards.",
        "pl": "Opiekunowie doceniają zaplecze intensywnej terapii dla zwierząt w stanie zagrożenia życia, w tym tlenoterapię i stały monitoring. Część klientów zwraca jednak uwagę na stres hospitalizowanych czworonogów oraz ograniczone możliwości odwiedzin w szpitalu."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 53,
      "title": {
        "en": "Complex surgeries and advanced diagnostic tools",
        "pl": "Zaawansowana chirurgia i nowoczesna diagnostyka"
      },
      "text": {
        "en": "Reviews frequently highlight successful orthopedic, neurosurgical, and emergency procedures carried out using specialized hospital equipment. Most owners credit the clinic with saving critically ill pets, while some report disappointment when prognoses were poor.",
        "pl": "W opiniach często przewijają się relacje z udanych operacji ortopedycznych i neurochirurgicznych z wykorzystaniem szpitalnego sprzętu. Wielu właścicieli zawdzięcza klinice uratowanie życia pupila, choć przy ciężkich schorzeniach pojawiają się też głosy rozczarowania."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is Arka clinic open 24 hours every day?",
        "pl": "Czy klinika Arka działa całodobowo?"
      },
      "a": {
        "en": "Yes, Arka maintains continuous 24/7 veterinary emergency and inpatient hospital services.",
        "pl": "Tak, klinika Arka prowadzi całodobowy ostry dyżur weterynaryjny oraz szpital przez 7 dni w tygodniu."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Where is the clinic located?",
        "pl": "Gdzie mieści się klinika Arka?"
      },
      "a": {
        "en": "The facility is located at Chłopska 2a in the Bieżanów-Prokocim district in Kraków.",
        "pl": "Lecznica znajduje się przy ulicy Chłopskiej 2a w dzielnicy Bieżanów-Prokocim w Krakowie."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Does the clinic have CT and specialized imaging?",
        "pl": "Czy klinika wykonuje tomografię komputerową?"
      },
      "a": {
        "en": "Yes, the hospital has an advanced computed tomography scanner, digital X-ray, and endoscopy systems.",
        "pl": "Tak, placówka posiada nowoczesny tomograf komputerowy, cyfrowy aparat RTG oraz pracownię endoskopową."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Do routine visits require prior appointment booking?",
        "pl": "Czy wizyty planowane wymagają wcześniejszej rejestracji?"
      },
      "a": {
        "en": "Yes, routine consultations should be booked in advance, whereas emergency cases are triaged immediately upon arrival.",
        "pl": "Tak, na wizyty planowe należy umówić się wcześniej, natomiast nagłe przypadki przyjmowane są w trybie ostrym."
      },
      "basis": "both"
    }
  ],
