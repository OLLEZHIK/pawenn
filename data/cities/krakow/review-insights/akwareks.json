  "cards": [
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Specialized aquarium store and rich biotope inventory",
        "pl": "Specjalistyczny sklep akwarystyczny i bogaty asortyment"
      },
      "text": {
        "en": "Aquarium hobbyists describe the shop as a superbly equipped store featuring diverse aquatic plants, specialized CO2 equipment, tank covers, and accessories. Clean, well-maintained display aquariums showcase both standard and exceptionally rare freshwater species.",
        "pl": "Akwaryści opisują sklep jako doskonale zaopatrzony punkt z szerokim wyborem roślin wodnych, zestawów CO2, pokryw oraz specjalistycznego osprzętu. Bardzo zadbane, czyste zbiorniki ekspozycyjne prezentują zarówno popularne, jak i rzadko spotykane gatunki ryb."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Passionate 20-year expertise and patient guidance",
        "pl": "Ponad 20 lat doświadczenia i fachowe doradztwo"
      },
      "text": {
        "en": "The proprietor and staff receive enthusiastic commendations for their deep encyclopedic knowledge and willingness to advise both novice and experienced aquarists. Reviewers praise their helpfulness in tank stocking, cycling tips, and careful mail-order packaging.",
        "pl": "Właściciel oraz personel zbierają znakomite oceny za encyklopedyczną wiedzę, wieloletnią pasję oraz gotowość do pomocy początkującym i zaawansowanym akwarystom. Klienci doceniają cenne wskazówki dotyczące obsady zbiornika oraz bezpieczne pakowanie przesyłek żywych ryb."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Vibrant condition of ornamental fish and invertebrates",
        "pl": "Doskonała kondycja ryb akwariowych i skorupiaków"
      },
      "text": {
        "en": "Customers highlight the vibrant coloration, health, and vitality of purchased fish – such as green neons, rasboras, and corydoras – as well as ornamental shrimps and snails. In-store and delivered animals arrive in excellent shape and adapt quickly to home tanks.",
        "pl": "Kupujący podkreślają świetną kondycję, intensywne wybarwienie i witalność ryb – takich jak neony, razbory czy kiryski – oraz ozdobnych krewetek i ślimaków. Zwierzęta kupowane stacjonarnie lub z bezpieczną wysyłką są zdrowe i bezproblemowo aklimatyzują się w akwariach."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Akwareks offer specialized aquascaping and CO2 equipment?",
        "pl": "Czy Akwareks oferuje sprzęt do aquascapingu i zestawy CO2?"
      },
      "a": {
        "en": "Yes, the store carries complete CO2 cylinder kits, specialized filters, aquatic plants, and aquarium covers.",
        "pl": "Tak, na miejscu dostępne są butle CO2, osprzęt filtracyjny, pokrywy oraz różnorodne rośliny akwariowe."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can ornamental fish and shrimps be ordered with shipping?",
        "pl": "Czy w sklepie można zamówić ryby i krewetki z bezpieczną wysyłką?"
      },
      "a": {
        "en": "Yes, customers report fast, well-insulated delivery of live fish and invertebrates in excellent condition.",
        "pl": "Tak, recenzje chwalą szybką i starannie zabezpieczoną wysyłkę żywych ryb oraz bezkręgowców."
      },
      "basis": "reviews"
    },
    {
      "q": {
