  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 63,
      "title": {
        "en": "Extensive selection of pet products",
        "pl": "Bogaty wybór produktów dla zwierząt"
      },
      "text": {
        "en": "Customers highlight the vast assortment of high-grade pet foods, specialized supplements, and training accessories. Reviewers frequently appreciate receiving well-packed parcels containing complimentary treats, noting that both standard diets and niche items are reliably stocked.",
        "pl": "Klienci podkreślają bogaty asortyment wysokiej jakości karm, suplementów oraz akcesoriów treningowych. Kupujący doceniają starannie zabezpieczone przesyłki z drobnymi upominkami, zwracając uwagę na stałą dostępność karm weterynaryjnych i niszowych produktów."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "en": "Fast order processing and dispatch",
        "pl": "Szybka realizacja i sprawna wysyłka"
      },
      "text": {
        "en": "Shoppers commend the quick fulfillment process, with packages routinely dispatched and delivered within one to two days. In urgent situations, reviewers note helpful telephone support that promptly arranges exchanges or confirms stock availability before weekend departures.",
        "pl": "Osoby zamawiające w sklepie chwalą szybką obsługę zamówień, które są wysyłane i doręczane zazwyczaj w ciągu jednego lub dwóch dni. W pilnych sytuacjach klienci pozytywnie wspominają wsparcie telefoniczne przy natychmiastowej wymianie rozmiaru przed wyjazdem."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "en": "Helpful and knowledgeable customer service",
        "pl": "Pomocna i kompetentna obsługa klienta"
      },
      "text": {
        "en": "Reviewers regularly describe the store staff as courteous, competent, and willing to advise on suitable food choices or accessories. Buyers value proactive communication when specific items require confirmation, ensuring a smooth purchasing experience.",
        "pl": "Klienci regularnie opisują pracowników jako osoby uprzejme, kompetentne i chętne do doradzenia w wyborze karmy lub szelek. Kupujący doceniają sprawny kontakt w razie potrzeby uzgodnienia szczegółów zamówienia, co zapewnia duże poczucie bezpieczeństwa i komfort zakupów."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How can orders be placed with Karusek?",
        "pl": "Jak można złożyć zamówienie w sklepie Karusek?"
      },
      "a": {
        "en": "Orders can be placed online through the official website with courier delivery or in-person pickup in Kraków.",
        "pl": "Zamówienia można składać przez stronę internetową z dostawą kurierską lub odbiorem osobistym w Krakowie."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Where is the physical store and pickup point?",
        "pl": "Gdzie mieści się punkt odbioru stacjonarnego?"
      },
      "a": {
        "en": "The stationary shop and warehouse are located at Nad Sudołem 6A in Kraków.",
        "pl": "Sklep stacjonarny i punkt odbioru mieszczą się przy ulicy Nad Sudołem 6A w Krakowie."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Does the store offer veterinary diets and BARF supplements?",
        "pl": "Czy sklep oferuje karmy weterynaryjne i suplementy BARF?"
      },
      "a": {
        "en": "Yes, the store carries a comprehensive range of veterinary foods, raw feeding supplements, and health preparations.",
        "pl": "Tak, sklep posiada szeroką ofertę karm specjalistycznych, suplementów do diety BARF oraz preparatów zdrowotnych."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How quickly are courier deliveries dispatched?",
        "pl": "Jak szybko realizowane są przesyłki kurierskie?"
      },
      "a": {
        "en": "Reviewers note that in-stock orders are typically dispatched within 24 to 48 hours.",
        "pl": "Z opinii wynika, że zamówienia na produkty dostępne w magazynie są wysyłane zazwyczaj w ciągu 24–48 godzin."
      },
      "basis": "reviews"
    }
  ],
