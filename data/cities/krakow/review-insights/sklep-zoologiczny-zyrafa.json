  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 58,
      "title": {
        "en": "Expert, passionate staff and personalized advice",
        "pl": "Ekspercka, zaangażowana obsługa i fachowe doradztwo"
      },
      "text": {
        "en": "Shoppers enthusiastically praise store staff for deep pet care knowledge, friendliness, and patient guidance. The team readily advises on selecting specialized diets for sensitive dogs and provides thorough instructions for setting up first-time aquariums.",
        "pl": "Klienci jednogłośnie chwalą pracowników sklepu za ogromną wiedzę zoologiczną, życzliwość i pomocne podejście. Obsługa chętnie doradza w doborze karmy dla psów z alergiami oraz udziela wyczerpujących wskazówek dotyczących zakładania pierwszego akwarium."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 57,
      "title": {
        "en": "Bi-level pet and aquarium store on Nowowiejska",
        "pl": "Dwupoziomowy sklep zoologiczno-akwarystyczny"
      },
      "text": {
        "en": "Located on Nowowiejska, the store impresses visitors with extensive inventory arranged across two floors: a dedicated lower aquarium level and an upper floor with pet foods and accessories. Reviewers value the vast treat selection and charity drives for animal shelters.",
        "pl": "Sklep na krakowskiej Nowowiejskiej zachwyca bogatym wyposażeniem podzielonym na dwa poziomy: dolną część akwarystyczną oraz górne piętro z karmami i akcesoriami. Klienci doceniają duży wybór przysmaków, czyste zbiorniki oraz organizowane zbiórki dla schronisk."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Healthy aquarium fish, shrimps, and happy dogs",
        "pl": "Zdrowe ryby, krewetki i zadowolone psy"
      },
      "text": {
        "en": "Fishkeepers purchase freshwater fish, shrimp, and vibrant aquarium plants with confidence, noting robust health, longevity, and absence of nuisance algae. The shop is also welcoming to dogs visiting with owners, frequently offering complimentary treats at the counter.",
        "pl": "Akwaryści z pełnym zaufaniem kupują w sklepie ryby słodkowodne, krewetki oraz bujne rośliny, podkreślając brak glonów i wieloletnią żywotność okazów. Sklep jest również bardzo przyjazny dla psów, które zawsze mogą liczyć na powitanie i darmowe smaczki przy ladzie."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How is the store organized across its floors?",
        "pl": "Jak zorganizowany jest sklep na poziomach?"
      },
      "a": {
        "en": "The lower level features an extensive aquarium section, while the upper floor offers pet foods and accessories.",
        "pl": "Dolny poziom mieści bogaty dział akwarystyczny, a na górnym piętrze znajdują się karmy i akcesoria dla psów i kotów."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are the aquarium fish and plants healthy and quarantined?",
        "pl": "Czy rybki i rośliny akwariowe są zdrowe i w dobrej kondycji?"
      },
      "a": {
        "en": "Yes, customers emphasize that fish, shrimps, and aquatic plants are healthy, long-living, and free of algae.",
        "pl": "Tak, klienci podkreślają, że ryby, krewetki i rośliny są zdrowe, żyją długo i nie mają glonów."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the shop support animal charity initiatives?",
        "pl": "Czy sklep angażuje się w pomoc bezdomnym zwierzętom?"
      },
      "a": {
        "en": "Yes, reviewers note regular donation drives and food collections organized to support animal shelters.",
        "pl": "Tak, klienci wspominają o regularnych zbiórkach karmy i akcesoriów organizowanych dla schronisk."
      },
      "basis": "reviews"
    }
