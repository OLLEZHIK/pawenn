  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Specialized knowledge in veterinary ophthalmology",
        "pl": "Specjalistyczna wiedza i doświadczenie okulistyczne"
      },
      "text": {
        "en": "Clients emphasize the profound professional knowledge and specialized diagnostic expertise of the veterinary ophthalmologists. Pet owners note thorough slit-lamp examinations, detailed explanations of eye pathology, and courteous communication during complex consultations.",
        "pl": "Klienci podkreślają wysokie kwalifikacje i rzetelną wiedzę lekarzy w dziedzinie okulistyki weterynaryjnej. Opiekunowie chwalą szczegółowe badania w lampie szczelinowej, cierpliwe objaśnianie chorób oczu oraz życzliwy kontakt podczas wizyt specjalistycznych."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 27,
      "title": {
        "en": "Ocular surgeries and mixed outcome reviews",
        "pl": "Operacje okulistyczne i zróżnicowane rezultaty"
      },
      "text": {
        "en": "Reviews describe advanced microsurgical eye procedures and medical therapies for corneal ulcers, glaucoma, and cataracts. Many guardians report restored vision and successful treatments, though several critical voices mention post-surgical complications or persistent eye issues.",
        "pl": "W opiniach opisywane są skomplikowane zabiegi mikrochirurgiczne oraz leczenie wrzodów rogówki, jaskry czy zaćmy. Wielu klientów cieszy się z uratowania wzroku pupila, jednak część recenzji wspomina o powikłaniach pozabiegowych i trudnościach w terapii."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 25,
      "title": {
        "en": "Patient handling during detailed ophthalmic tests",
        "pl": "Postępowanie ze zwierzętami podczas badań wzroku"
      },
      "text": {
        "en": "Evaluating delicate eye conditions requires stillness, and owners provide differing accounts of how pet stress was handled. While many praise calm handling and treats, others felt the examination was rushed, leading to heightened anxiety in sensitive dogs and cats.",
        "pl": "Dokładne badanie narządu wzroku wymaga spokoju, a opiekunowie w różny sposób oceniali podejście do stresu zwierząt. Wielu chwali cierpliwość lekarzy, lecz niektórzy właściciele odczuli pośpiech, który nasilił lęk u bardziej wrażliwych psów i kotów podczas procedur w gabinecie."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What is the primary specialization of Retina clinic?",
        "pl": "Jaki jest główny profil działalności przychodni Retina?"
      },
      "a": {
        "en": "Retina specializes exclusively in veterinary ophthalmology, eye microsurgery, and treatment of vision disorders.",
        "pl": "Retina specjalizuje się w okulistyce weterynaryjnej, mikrochirurgii oka oraz diagnozowaniu schorzeń narządu wzroku."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Where is Retina clinic situated?",
        "pl": "Gdzie zlokalizowany jest gabinet Retina?"
      },
      "a": {
        "en": "The clinic is located at Antoniego Szyllinga 3 in the Łagiewniki-Borek Fałęcki district of Kraków.",
        "pl": "Przychodnia mieści się przy ulicy Antoniego Szyllinga 3 w krakowskich Łagiewnikach."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Is prior appointment reservation necessary?",
        "pl": "Czy przed wizytą wymagana jest rezerwacja terminu?"
      },
      "a": {
        "en": "Yes, visits are scheduled by advance telephone booking to accommodate thorough eye testing.",
        "pl": "Tak, konsultacje okulistyczne odbywają się po uprzedniej rejestracji telefonicznej."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What eye diagnostic tests are conducted on site?",
        "pl": "Jakie badania okulistyczne wykonywane są na miejscu?"
      },
      "a": {
        "en": "The practice conducts tonometry, biomicroscopy, funduscopy, gonioscopy, and ophthalmic ultrasound.",
        "pl": "W gabinecie wykonywana jest tonometria, badanie lampą szczelinową, oftalmoskopia, gonioskopia i USG gałki ocznej."
      },
      "basis": "website"
    }
  ],
