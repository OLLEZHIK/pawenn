  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 77,
      "title": {
        "en": "Supportive, kind, and professional clinicians"
      },
      "text": {
        "en": "Pet owners on Shettleston Road warmly commend the veterinary surgeons and clinical support team at ScotVet Sandyhills. Reviewers note that staff members are consistently friendly, patient, and understanding when handling routine inquiries or urgent pet concerns. Clients appreciate the attentive bedside manner, although an isolated reviewer reported dissatisfaction with medical communication."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "en": "Caring and considerate animal treatment"
      },
      "text": {
        "en": "Clients emphasize the thoughtful and affectionate care provided to visiting dogs, cats, and small animals during appointments. Reviewers frequently remark that clinicians treat pets as if they were their own, using gentle handling to soothe nervous or fearful animals. Pet owners describe their companions feeling relaxed and at ease throughout vaccinations, health checks, and minor clinical procedures."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "en": "Reliable diagnostic and post-operative recovery care"
      },
      "text": {
        "en": "Pet parents highlight the clinic high standard of surgical, dental, and diagnostic veterinary treatment. Reviewers report positive health outcomes after routine neutering operations, dental cleanings, and emergency interventions for unwell animals. Clients value the thorough medical explanations and clear aftercare guidance provided to support prompt pet recovery at home."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does ScotVet Sandyhills offer emergency support?"
      },
      "a": {
        "en": "Yes, the practice provides round-the-clock 24/7 on-call emergency veterinary assistance for registered clients."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is car parking available for clients at the clinic?"
      },
      "a": {
        "en": "Yes, dedicated parking spaces are situated directly adjacent to the clinic building on Shettleston Road."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What preventative care options are provided?"
      },
      "a": {
        "en": "The practice provides routine puppy and kitten vaccinations, annual health checks, microchipping, and dental scale and polish treatments."
      },
      "basis": "both"
    }
  ],
