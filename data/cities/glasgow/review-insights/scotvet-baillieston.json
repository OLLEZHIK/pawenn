  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 88,
      "title": {
        "en": "Warm, welcoming, and reassuring veterinary team"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinary surgeons, veterinary nurses, and receptionists at ScotVet Baillieston for their friendliness, kindness, and dedication. Reviewers highlight that clinicians take ample time to answer questions and explain procedures without rushing. While the vast majority share glowing feedback, an occasional reviewer felt uncomfortable regarding communication."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "en": "Gentle and compassionate handling for pets"
      },
      "text": {
        "en": "Clients emphasize how gently, calmly, and attentively their dogs, cats, and small animals are treated during examinations and routine booster visits. Reviewers with anxious, timid, or reactive pets appreciate that the staff soothe animals with treats, gentle strokes, and patient care. Many owners report that their pets are happy to enter the clinic without signs of fear or distress."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Effective treatments and thorough diagnostic care"
      },
      "text": {
        "en": "Pet parents express strong confidence in the clinic clinical capabilities, ranging from preventative health checks and spaying to urgent medical interventions. Reviewers note that clinicians conduct thorough examinations, accurately diagnose complex health issues, and follow up closely after operations. Clients appreciate the team attentive post-operative care and medical advice."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does ScotVet Baillieston offer emergency veterinary services?"
      },
      "a": {
        "en": "Yes, the practice provides 24/7 on-call emergency veterinary support for registered pet owners."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is parking available at ScotVet Baillieston?"
      },
      "a": {
        "en": "Yes, dedicated parking spaces are situated directly adjacent to the surgery on Maxwell Street."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What routine clinical treatments are provided?"
      },
      "a": {
        "en": "The clinic provides core pet vaccinations, microchipping, routine surgical neutering, dental care, and regular health checks."
      },
      "basis": "both"
    }
  ],
