    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Stress-free handling for feline clients"
      },
      "text": {
        "en": "Cat owners overwhelmingly highlight the exceptionally calm and soothing environment at PURR, praising gentle techniques that keep nervous, anxious, or vocal cats at ease. Many clients note that their pets fall asleep during drying or stop trembling entirely thanks to initial meet-and-greet sessions and feline-focused care."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Skilled and caring cat groomers"
      },
      "text": {
        "en": "Reviewers frequently commend Britnee, Saffa, and Caitlin for their extensive knowledge, patience, and genuine love for cats. Clients appreciate regular photo updates during grooming and detailed discussions about coat health. While one reviewer felt a junior groomer left tangles, nearly all praise the team's exceptional dedication."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "High-quality styling and coat de-matting"
      },
      "text": {
        "en": "Owners report outstanding grooming results, including teddy bear cuts, wet baths, lion trims, and knot removal for long-haired breeds like Maine Coons and Ragdolls. Clients mention that pets return home smelling fantastic with glossy, soft coats, though one visitor felt a knot removal session fell short of expectations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does PURR Cat Grooming groom anxious or aggressive cats?"
      },
      "a": {
        "en": "Yes, the team specializes in feline handling and uses calm techniques and meet-and-greet sessions for nervous cats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are other animals present during grooming appointments?"
      },
      "a": {
        "en": "No, the studio enforces a strict one-household policy so cats are groomed in a peaceful environment without dogs."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What grooming services are offered for long-haired cats?"
      },
      "a": {
        "en": "Services include full wet grooms, teddy bear cuts, nail clipping, and knot or mat removal."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners book introductory meet-and-greet sessions?"
      },
      "a": {
        "en": "Yes, introductory sessions are available so cats can explore the studio space before full grooming."
      },
      "basis": "both"
    }
