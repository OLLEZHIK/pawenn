    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 32,
      "title": {
        "en": "Caring clinicians with management concerns"
      },
      "text": {
        "en": "Many long-term clients commend individual veterinarians like Dr. Morel and veterinary technicians for compassionate handling, kind bedside manner, and accommodating emergency walk-ins. Conversely, numerous dissatisfied reviewers report poor customer service, feeling rushed through exams, and an impersonal corporate atmosphere following recent ownership changes."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 16,
      "title": {
        "en": "Routine wellness alongside clinical disputes"
      },
      "text": {
        "en": "Several pet owners report smooth routine care, successful minor treatments, and gentle nail trims for both dogs and cats. However, critical reviews describe severe post-treatment infections from dog bites, disputed dental extractions, and missed vaccinations, prompting some owners to seek corrective emergency care elsewhere."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "en": "Attentive care for routine pet visits"
      },
      "text": {
        "en": "Dog and cat owners frequently express gratitude for the gentle care their pets receive during wellness visits and routine check-ups on Front Street. Reviewers note that veterinary assistants and technicians handle pets with kindness, helping them feel settled during physical examinations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are walk-in or emergency visits accepted?"
      },
      "a": {
        "en": "Clients report that the clinic occasionally accommodates urgent walk-ins for nail trims or acute assessments, though appointments are preferred."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer pet wellness plans?"
      },
      "a": {
        "en": "The clinic promotes an annual Pet Health Club, though pet owners advise confirming cancellation terms and included services in advance."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What procedures are performed on-site?"
      },
      "a": {
        "en": "Services include routine physical wellness exams, dental cleanings, surgical extractions, vaccinations, and diagnostic consultations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How are treatment quotes and records communicated?"
      },
      "a": {
        "en": "Clients note that medical estimates are discussed during appointments, with written documentation provided upon request."
      },
      "basis": "reviews"
    }
