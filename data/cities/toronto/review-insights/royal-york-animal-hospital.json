  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 152,
      "title": {
        "en": "Caring veterinary team and specialists"
      },
      "text": {
        "en": "Pet owners in Etobicoke express profound gratitude for the veterinarians, registered technicians, and client coordinators on Dundas Street West. Reviewers frequently describe the medical staff as empathetic, attentive, and exceptionally thorough during routine checkups and complex emergencies. Clients note feeling immense reassurance leaving their pets in experienced hands."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 91,
      "title": {
        "en": "Compassionate bedside manner for pets"
      },
      "text": {
        "en": "Clients consistently report that their dogs and cats receive gentle, reassuring treatment throughout hospital visits. Reviewers note that nervous animals are comforted with calm voices, soft blankets, and treats during clinical examinations. Feline owners particularly appreciate the dedicated waiting areas and low-stress handling methods employed by the veterinary team."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Effective medical care and surgical outcomes"
      },
      "text": {
        "en": "Patrons commend the clinic's diagnostic precision and surgical capabilities across complex orthopedic and soft tissue procedures. Reviewers share heartfelt experiences of urgent health crises accurately resolved and companion animals nursed back to full health. Many clients report longstanding loyalty to the practice, trusting its clinicians with generations of family pets."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the hospital provide emergency care?"
      },
      "a": {
        "en": "Yes, the hospital accommodates urgent pet emergencies during regular operating hours and collaborates with partner emergency clinics."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is the facility accredited by AAHA?"
      },
      "a": {
        "en": "Yes, Royal York Animal Hospital holds accreditation from the American Animal Hospital Association for veterinary standards."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Can owners schedule appointments on weekends?"
      },
      "a": {
        "en": "Yes, the clinic offers extended Saturday appointments alongside evening weekday hours for client convenience."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What surgical procedures are performed on site?"
      },
      "a": {
        "en": "The hospital performs routine spays, neuters, dentistry, and advanced soft tissue and orthopedic surgeries."
      },
      "basis": "website"
    }
  ],
