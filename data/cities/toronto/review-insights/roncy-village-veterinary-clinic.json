      "q": {
        "en": "Does the clinic treat both dogs and cats?"
      },
      "a": {
        "en": "Yes, the practice offers comprehensive medical, surgical, and preventive veterinary care for canine and feline patients."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are routine dental cleanings and surgery available?"
      },
      "a": {
        "en": "Yes, the hospital performs dental procedures, laparoscopic spays, and soft tissue surgeries using advanced diagnostics."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do staff follow up on recovering pets after visits?"
      },
      "a": {
        "en": "Yes, clients frequently mention receiving thoughtful check-in calls from the clinic team to ensure pets are recovering well."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can appointments be booked online?"
      },
      "a": {
        "en": "Yes, clients can book veterinary appointments online or contact the clinic reception directly by phone."
