    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Knowledgeable and dedicated shop team"
      },
      "text": {
        "en": "Customers repeatedly praise the shop owner Josh and the rest of the team for their deep knowledge, passionate guidance, and friendly service. Reviewers note that staff take time to explain reptile habitats, goldfish care, and terrarium setups. Only two negative reviews cite staff issues regarding online fish identification and accessibility."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Unique store with impressive terrariums"
      },
      "text": {
        "en": "Visitors highlight the welcoming atmosphere and remarkable bioactive terrariums in this Cabbagetown shop, describing an engaging display of exotic animals, plants, and supplies. While most customers love the store setup, a few reviewers express frustration with the lack of wheelchair accessibility at the physical entrance."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Healthy exotics and proper habitats"
      },
      "text": {
        "en": "Pet owners appreciate the healthy condition of geckos, snakes, bettas, and exotic pets, noting that tanks are clean and bettas live in proper setups rather than small plastic cups. The vast majority report thriving animals and helpful care tips, though isolated reviews voice complaints regarding tank maintenance."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What types of pets does The Beastiary cater to?"
      },
      "a": {
        "en": "The shop specializes in reptiles, amphibians, bettas, freshwater fish, and exotic pets, alongside supplies for dogs and cats."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the store offer bioactive terrarium setups?"
      },
      "a": {
        "en": "Yes, customers note that staff help design and build custom bioactive terrariums with live plants and tailored decor."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is local delivery available for pet supplies?"
      },
      "a": {
        "en": "Yes, the shop provides local delivery options and online ordering for in-store pickup."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is The Beastiary wheelchair accessible?"
      },
      "a": {
        "en": "Reviewers note that the physical storefront currently lacks wheelchair accessibility at the entrance."
      },
      "basis": "reviews"
    }
