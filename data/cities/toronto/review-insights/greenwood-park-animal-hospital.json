      "q": {
        "en": "Does the clinic treat exotic pets and small mammals?"
      },
      "a": {
        "en": "Yes, the hospital routinely cares for rabbits, fancy rats, geckos, tortoises, birds, and other exotic companions."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are financial payment plans available for unexpected treatments?"
      },
      "a": {
        "en": "Reviewers note that the clinic offers compassionate financial options and flexible payment plans when managing major veterinary expenses."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the team accommodate skittish or anxious pets?"
      },
      "a": {
        "en": "Veterinarians and technicians employ patient, low-stress handling techniques to keep nervous dogs and exotic animals calm."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What routine wellness services are provided?"
      },
      "a": {
        "en": "The clinic offers preventive examinations, vaccinations, nutritional counseling, senior pet bloodwork, and dental procedures."
