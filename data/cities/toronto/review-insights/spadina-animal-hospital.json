    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 28,
      "title": {
        "en": "Caring veterinarians beside front-desk friction"
      },
      "text": {
        "en": "Reviewers share mixed perspectives regarding hospital staff, drawing a sharp distinction between doctors and front-desk personnel. Pet owners consistently commend attending veterinarians like Dr. Stewart, Dr. Gonzalez, and Dr. Pusong for their kindness, patience, and attentive bedside manner. Conversely, dissatisfied clients describe front-office encounters marked by snappy attitudes, disorganization, and dismissive customer service."
      }
    },
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 15,
      "title": {
        "en": "Critical lapses in administrative communication"
      },
      "text": {
        "en": "Communication receives predominantly critical feedback from pet parents experiencing administrative breakdowns. While veterinarians are praised for explaining treatment plans during appointments, several clients report significant clerical errors with international pet travel documentation, refusal to provide phone estimates, and distressing automated appointment reminders sent for pets that passed away years ago."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 10,
      "title": {
        "en": "Concerns over high costs and sales"
      },
      "text": {
        "en": "Pricing transparency is a prominent source of client dissatisfaction at the clinic. Although a few reviewers consider veterinary fees standard for central Toronto, multiple owners report feeling pressured into costly diagnostic add-ons and unexpected invoice increases. Discontented visitors express frustration over refusal to quote procedure pricing over the telephone and steep charges for resolving paperwork mistakes."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Spadina Animal Hospital handle international pet travel paperwork?"
      },
      "a": {
        "en": "Yes, the clinic prepares travel health certificates, though clients advise verifying documentation details carefully with authorities."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners obtain treatment cost estimates over the phone?"
      },
      "a": {
        "en": "Reviewers report that the front desk typically requires in-person examinations before quoting procedural fees and treatment costs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are emergency or same-day appointments accommodated?"
      },
      "a": {
        "en": "Yes, pet owners appreciate that the clinic occasionally accommodates urgent walk-ins and same-day medical visits when schedule permits."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Which veterinarians practice at the clinic?"
      },
      "a": {
        "en": "Clients frequently mention receiving care from Dr. Luke Stewart, Dr. Gonzalez, and Dr. Pusong during routine and specialized visits."
      },
      "basis": "reviews"
    }
