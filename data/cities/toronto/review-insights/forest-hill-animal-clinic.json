  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 97,
      "title": {
        "en": "Expert dermatologists and compassionate team"
      },
      "text": {
        "en": "Pet owners extensively commend veterinary dermatologist Dr. Stephen Waisglass alongside Dr. Sharon Kates and the nursing team for their remarkable clinical knowledge and compassionate bedside manner. While one reviewer experienced administrative delays at reception, clients overwhelmingly describe the staff as caring and reassuring."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Effective treatment for chronic skin allergies"
      },
      "text": {
        "en": "Reviewers celebrate transformative clinical results for pets suffering from chronic allergies, severe itching, ear infections, and complex dermatologic conditions. Many clients express immense gratitude that targeted diagnostic testing and custom therapy regimens brought lasting comfort after years of unresolved symptoms."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Gentle and patient pet handling"
      },
      "text": {
        "en": "Clients appreciate the thoughtful, low-stress approach taken with anxious dogs and sensitive cats during examinations on Eglinton Avenue West. Pet parents note that clinicians take ample time to soothe nervous animals, creating an unhurried clinical environment where pets feel genuinely safe."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic specialize in pet dermatology and allergies?"
      },
      "a": {
        "en": "Yes, the practice offers specialized veterinary dermatology for complex skin conditions, chronic allergies, and ear disorders."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are general veterinary wellness services available?"
      },
      "a": {
        "en": "Alongside dermatology, the clinic provides comprehensive wellness exams, preventive care, vaccinations, and dental services."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners request consultations for referral cases?"
      },
      "a": {
        "en": "The clinic accepts direct specialist dermatology referrals from other veterinary practices across Ontario."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the team handle anxious or sensitive pets?"
      },
      "a": {
        "en": "Clinicians employ gentle handling techniques and unhurried appointments to minimize stress for nervous dogs and cats."
      },
      "basis": "reviews"
    }
  ],
