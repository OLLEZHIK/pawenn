  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 82,
      "title": {
        "en": "Caring veterinary doctors and technicians"
      },
      "text": {
        "en": "Clients frequently commend the veterinary physicians and clinical team at Sherbourne Animal Hospital for their professionalism, warmth, and thorough bedside manner. Reviewers highlight veterinarians like Dr. Kelsick who patiently address health concerns and answer detailed dietary questions. While several clients noted occasional front-desk friction, pet owners overwhelmingly report supportive interactions."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "en": "Gentle handling for nervous companions"
      },
      "text": {
        "en": "Pet owners consistently appreciate the clinic's gentle and low-stress handling methods when treating anxious cats and dogs. Reviewers describe how clinical staff comfort fearful animals with treats, quiet voices, and unhurried examinations during checkups. Families highlight that nervous pets settle down comfortably, making routine medical visits significantly smoother for both pets and owners."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Modern, spotless, and welcoming facility"
      },
      "text": {
        "en": "Reviewers emphasize the modern aesthetic, cleanliness, and thoughtful organization of the veterinary hospital in central Toronto. Clients appreciate the spacious, bright examination rooms and dedicated feline-friendly waiting spaces that keep appointments calm. Visitors frequently remark on the welcoming ambiance and immaculate hygienic standards maintained across the clinic."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the clinic accommodate anxious pets?"
      },
      "a": {
        "en": "Reviewers emphasize that veterinarians and veterinary technicians use soothing techniques and low-stress handling to comfort fearful animals."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners contact the clinic for email follow-ups?"
      },
      "a": {
        "en": "Yes, clients appreciate receiving prompt email responses and test result follow-ups from the medical team after examinations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are cat spay and neuter procedures performed at the hospital?"
      },
      "a": {
        "en": "Yes, the hospital performs routine surgical procedures including cat spays, neuters, and dental cleanings."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where is Sherbourne Animal Hospital located?"
      },
      "a": {
        "en": "The hospital is situated on Sherbourne Street in downtown Toronto, providing accessible veterinary care for neighborhood pets."
      },
      "basis": "website"
    }
  ],
