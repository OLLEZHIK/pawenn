      "mentions": 49,
      "title": {
        "en": "Thorough, caring, and attentive veterinary staff"
      },
      "text": {
        "en": "Reviewers universally praise Dr. Scott and the entire healthcare team for their patience, clinical expertise, and clear communication. Clients value that the doctors spend ample time discussing all aspects of a pet's wellbeing without rushing consultations."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Gentle handling and stress-free visits"
      },
      "text": {
        "en": "Pet owners love how comfortable their animals feel at the clinic, noting that dogs happily walk in for liver treats while feisty cats receive gentle, patient handling. Reviewers appreciate the staff's dedication to keeping veterinary visits fear-free."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Clean, renovated, and welcoming facility"
      },
      "text": {
        "en": "Clients frequently remark on the modern, beautifully renovated clinic environment and spotless consultation rooms. Pet parents appreciate the comfortable, organized veterinary facility which helps both pets and owners feel completely at ease during every appointment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can Woodbine Animal Clinic accommodate urgent or last-minute visits?"
      },
      "a": {
        "en": "Yes, reviewers report that the clinic has accommodated urgent same-day appointments for sick pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer online appointment booking?"
      },
      "a": {
        "en": "Yes, pet owners can conveniently request and schedule veterinary appointments online through the clinic website."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is the clinic equipped for both feline and canine care?"
      },
      "a": {
        "en": "Yes, the hospital treats dogs and cats, with staff experienced in low-stress handling for anxious or spicy animals."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What facilities are available at the clinic?"
      },
      "a": {
        "en": "The recently renovated facility includes modern examination rooms, diagnostic equipment, and surgical suites."
      },
      "basis": "both"
    }
