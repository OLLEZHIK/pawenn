  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Stress-free handling for anxious pets"
      },
      "text": {
        "en": "Dog and cat owners overwhelmingly praise the salon's calm and compassionate approach towards fearful, nervous, and reactive pets. Reviewers report that animals leave appointments relaxed and happy without lingering stress, though an isolated review reported an accidental nail injury during a trim."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Attentive and passionate styling team"
      },
      "text": {
        "en": "Clients speak warmly of Juju and her grooming staff, highlighting their welcoming customer service, patience, and deep affection for animals. While regular visitors praise the team's dedication, a couple of clients reported difficulties when attempting same-day cancellations under salon policies."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Beautiful breed cuts and scissoring"
      },
      "text": {
        "en": "Customers consistently compliment the quality of haircuts, Asian-style styling, and de-shedding treatments for dogs and long-haired cats. Owners appreciate that coats return soft, clean, and neatly trimmed, although one client was dissatisfied when a requested teddy bear style fell short of expectations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Juju Grooms work with reactive or nervous pets?"
      },
      "a": {
        "en": "Yes, clients frequently praise the team's specialized positive reinforcement techniques for grooming anxious dogs and cats."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do they groom cats as well as dogs?"
      },
      "a": {
        "en": "Yes, reviewers highlight gentle baths, sanitary trims, and de-shedding services for long-haired cats."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Where is Juju Grooms located in Toronto?"
      },
      "a": {
        "en": "The salon is located on Queen Street West in Toronto's Parkdale neighbourhood."
      },
