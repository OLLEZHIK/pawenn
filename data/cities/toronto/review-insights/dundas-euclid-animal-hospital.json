    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Compassionate and skilled veterinary team"
      },
      "text": {
        "en": "Clients frequently commend Dr. Catalina Román and the clinic care team for their professional, warm, and attentive approach. Reviewers note that doctors take extensive time to assess pets thoroughly and provide genuine comfort during stressful visits. While an isolated reviewer mentioned an unhelpful phone call, the overwhelming majority describe the staff as caring and dependable."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Expert handling of anxious pets"
      },
      "text": {
        "en": "Pet owners consistently appreciate how staff handle pets with severe anxiety, fear, or reactive temperaments without frustration or judgment. Reviewers recount how technicians and doctors calm frightened kittens, nervous rescue dogs, and distressed senior cats. Clients observe that their animals feel genuinely secure and well cared for throughout medical examinations."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 9,
      "title": {
        "en": "Transparent discussions and bilingual care"
      },
      "text": {
        "en": "Reviewers value the clear explanations provided regarding clinical diagnoses and care choices, noting that doctors discuss affordable options openly. Clients praise the availability of consultations in Spanish with Dr. Román, which helps multilingual families feel comfortable. While one client noted confusion over weekend hours, owners generally report prompt communication."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can veterinary consultations be conducted in Spanish?"
      },
      "a": {
        "en": "Yes, clients note that Dr. Catalina Román is fluent in Spanish, and pet owners can request Spanish-speaking appointments when scheduling."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the clinic handle highly anxious or reactive animals?"
      },
      "a": {
        "en": "Reviewers emphasize that veterinarians and veterinary technicians manage difficult or scared temperaments with patience, expertise, and zero judgment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are cost estimates provided before treatments are conducted?"
      },
      "a": {
        "en": "Yes, pet parents appreciate that the team provides detailed itemized costs upfront and works with owners to keep treatment plans manageable."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Dundas Euclid Animal Hospital perform surgical and dental procedures?"
      },
      "a": {
        "en": "The hospital provides comprehensive surgical and dental services, including routine spaying, neutering, dental cleanings, and digital X-rays."
      },
      "basis": "website"
    }
