  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 68,
      "title": {
        "en": "Compassionate doctors and attentive veterinary technicians"
      },
      "text": {
        "en": "Reviewers warmly commend veterinarians like Dr. Chi and the clinic staff for their clinical skill, empathy, and patient explanations. While a few clients noted occasional front desk miscommunications or booking delays, the vast majority praise the team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "en": "Gentle and loving care for companions"
      },
      "text": {
        "en": "Pet owners highlight the hospital's tender handling of sensitive rescue dogs, first-time puppies, and senior cats. Reviewers express deep appreciation for the gentle, respectful bedside manner provided during stressful medical visits and peaceful goodbyes."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Modern, clean, and well-equipped hospital"
      },
      "text": {
        "en": "Clients praise the accessible downtown location on Yonge Street and the clean, well-maintained clinical environment. Pet parents note that the hospital offers comprehensive in-house veterinary equipment, modern treatment rooms, and a welcoming front lobby."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Wellesley Animal Hospital offer online appointment requests?"
      },
      "a": {
        "en": "Yes, clients can submit appointment requests and manage bookings through the clinic's online portal."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic provide end-of-life and palliative pet care?"
      },
      "a": {
        "en": "Yes, reviewers frequently praise the compassionate, dignified palliative and euthanasia support provided by the veterinary team."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are emergency or urgent medical cases accepted?"
      },
      "a": {
        "en": "The clinic accommodates daytime medical emergencies, though clients are advised to call ahead to ensure doctor availability."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What payment methods are accepted at the hospital?"
      },
      "a": {
        "en": "The clinic accepts major credit cards, debit cards, and electronic payment options for veterinary services."
      },
      "basis": "both"
    }
  ],
