  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Caring vets with dedicated service"
      },
      "text": {
        "en": "Pet owners consistently praise Dr. Bick, Dr. Harmeet, and the clinical team for their warmth, thorough evaluations, and compassionate care. Clients appreciate that doctors take time to explain medical conditions without rushing. However, a few critical reviews report indifferent responses from receptionists during emergency inquiries."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Successful surgeries and effective treatments"
      },
      "text": {
        "en": "Clients report excellent medical results across surgeries, dental cleanings, bump removals, and allergy management, noting that dogs and cats recover quickly under close supervision. Post-operative care and follow-up communication are widely commended, though one owner shared a tragic experience involving a delayed specialist referral."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Gentle approach for anxious pets"
      },
      "text": {
        "en": "Reviewers emphasize the gentle handling of anxious dogs and nervous cats, noting that pets feel at ease and receive thoughtful attention during consultations. Doctors accommodate difficult behaviors to minimize distress during visits. Conversely, an unhappy visitor felt the clinic prioritized upselling over genuine concern for their animal."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Toronto Veterinary Clinic accept emergency cases?"
      },
      "a": {
        "en": "Reviewers note that while the clinic accommodates urgent needs when possible, clients are sometimes directed to emergency hospitals when scheduling is full."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What procedures are commonly performed here?"
      },
      "a": {
        "en": "Clients frequently mention surgical bump removals, dental cleanings, routine vaccinations, and chronic illness management."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the staff handle fearful or aggressive pets?"
      },
      "a": {
        "en": "Reviewers praise Dr. Bick and staff for using low-stress handling methods, avoiding unnecessary sedation when possible."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are treatment costs explained before procedures?"
      },
      "a": {
        "en": "Most clients report fair and transparent estimates, though a few reviewers advise double-checking pricing details prior to examinations."
      },
      "basis": "reviews"
    }
  ],
