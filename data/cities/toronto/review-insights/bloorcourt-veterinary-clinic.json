  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Compassionate and thorough clinical team"
      },
      "text": {
        "en": "Pet owners consistently commend the veterinarians and receptionists on Bloor Street West for their professional and welcoming bedside manner. Clients value that doctors explain diagnoses patiently and answer health concerns in simple language. A few reviewers voiced dissatisfaction regarding bedside humor or disagreement over prescriptions."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Gentle handling for sensitive pets"
      },
      "text": {
        "en": "Reviewers emphasize that veterinary staff handle nervous dogs and skittish cats with genuine warmth and patience. Owners appreciate that pets are examined comfortably at floor level with treats to reduce anxiety. Multiple clients report that their animals feel relaxed during routine visits and post-operative checkups rather than fearful."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Clear medical guidance and updates"
      },
      "text": {
        "en": "Pet parents highlight the clear, step-by-step communication regarding surgical procedures, dental estimates, and ongoing health plans. Clients appreciate receiving proactive check-in calls and emails following clinic visits. Two reviewers noted frustration when emergency scheduling was unavailable or when communication lagged during a nail trim."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What veterinary services are offered at Bloorcourt?"
      },
      "a": {
        "en": "The hospital provides wellness checks, routine vaccinations, dental cleanings, soft tissue surgery, and on-site diagnostics."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Can veterinary appointments be booked online?"
      },
      "a": {
        "en": "Yes, clients can schedule wellness checkups and non-urgent consultations using the clinic's online booking system."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the team handle anxious or fearful animals?"
      },
      "a": {
        "en": "Staff use gentle fear-free handling, offer treats, and frequently perform examinations at floor level to ensure pets stay calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is Bloorcourt Veterinary Clinic accessible by public transit?"
      },
      "a": {
        "en": "Yes, clients note that the clinic is located directly on Bloor Street West near subway transit, making visits easy without a car."
      },
      "basis": "both"
    }
  ],
