  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 101,
      "title": {
        "en": "Respected clinicians and long-standing care"
      },
      "text": {
        "en": "Generations of Toronto families celebrate the dedicated veterinary team, with dozens of reviewers paying tribute to Dr. Bob Watson on his retirement after 42 years of service alongside Dr. Mireille Cardinal. Clients praise the staff's welcoming warmth, professional guidance, and honest approach to veterinary medicine."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Attentive handling for canine and feline patients"
      },
      "text": {
        "en": "Pet owners consistently note that both dogs and cats receive thorough, gentle examinations in a calm clinical atmosphere on Eglinton Avenue West. Reviewers appreciate that veterinarians take time to help timid pets feel at ease, ensuring comfortable visits without causing unnecessary stress."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Reliable surgery and dental procedures"
      },
      "text": {
        "en": "Clients report smooth recoveries following routine spays, complex laparoscopic operations, and dental extractions. Pet parents value the clinic's transparent medical recommendations and practical follow-up calls, noting that treatments are carried out skillfully without pressuring owners into extraneous tests."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What surgical capabilities are provided at the clinic?"
      },
      "a": {
        "en": "The clinic performs routine soft tissue surgeries, dental procedures, and advanced laparoscopic operations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are appointments available in languages other than English?"
      },
      "a": {
        "en": "Yes, multilingual veterinary care is available in English, French, and Spanish."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can appointments be scheduled online?"
      },
      "a": {
        "en": "Clients can arrange appointments online through the clinic's digital booking system or by telephone."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic treat both dogs and cats?"
      },
      "a": {
        "en": "The practice provides comprehensive medical, dental, and surgical services for both dogs and cats."
      },
      "basis": "both"
    }
  ],
