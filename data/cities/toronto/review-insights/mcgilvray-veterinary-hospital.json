  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "title": {
        "en": "Dedicated and caring veterinary staff"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinarians and veterinary technicians for their professional expertise, warmth, and thoroughness during examinations. Many long-time clients express deep gratitude for the team's comforting bedside manner, noting that doctors explain medical conditions and treatment choices with great clarity."
      },
      "mentions": 70
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "title": {
        "en": "Well-equipped and clean veterinary hospital"
      },
      "text": {
        "en": "Visitors regularly commend the clean, well-appointed hospital facilities and organized front desk team on Yonge Street. Pet owners appreciate the comfortable environment and prompt service during scheduled visits, with many noting that the hospital provides a welcoming space for both pets and their families."
      },
      "mentions": 30
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "title": {
        "en": "Reliable medical and surgical care"
      },
      "text": {
        "en": "Clients report high confidence in the clinic's diagnostic thoroughness and surgical capabilities, from routine dental cleanings to complex internal treatments. Pet guardians appreciate that the veterinary team provides detailed recovery plans and attentive follow-up consultations, helping pets heal comfortably following hospital procedures."
      },
      "mentions": 29
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does McGilvray Veterinary Hospital provide after-hours medical assistance?"
      },
      "a": {
        "en": "Yes, the hospital offers 24/7 after-hours telephone triage with a registered veterinary technician to help clients assess urgent concerns."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What diagnostic and surgical services are available on site?"
      },
      "a": {
        "en": "Facilities include digital radiography, ultrasonography, endoscopy, routine and orthopedic surgery, dentistry, and an in-house laboratory."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "How long have clients trusted McGilvray Veterinary Hospital with their pets?"
      },
      "a": {
        "en": "Multiple reviewers mention bringing multiple generations of family dogs and cats to the hospital for more than fifteen to twenty years."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pet owners schedule appointments online?"
      },
      "a": {
        "en": "Yes, clients can conveniently book routine veterinary appointments and consultations through the hospital's official website."
      },
      "basis": "both"
    }
  ],
