  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Experienced and empathetic veterinary team"
      },
      "text": {
        "en": "Clients consistently praise the doctors, technicians, and front desk personnel on Danforth Avenue for their high competence and compassionate support. Reviewers frequently mention feeling fully supported during difficult health crises and end-of-life care. Pet parents describe the staff as dedicated, attentive, and genuinely kind."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Loving and comforting pet care"
      },
      "text": {
        "en": "Pet owners appreciate that animals are treated with genuine affection and gentle reassurance during examinations and procedures. Multiple reviewers note that nervous dogs and sick cats are calmed by the staff's soothing presence. Longtime patrons emphasize that their pets receive attentive, personalized consideration on every visit."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "en": "Responsive triage and treatment guidance"
      },
      "text": {
        "en": "Reviewers value the timely communication from the clinical team, noting swift telephone triage during urgent situations and thorough explanations of surgical recommendations. Clients appreciate that staff keep owners informed about care options. One reviewer shared a cautionary perspective on emergency overnight monitoring policies."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What clinical capabilities does Blue Cross provide?"
      },
      "a": {
        "en": "Services include preventative healthcare, diagnostic radiography, ultrasound imaging, soft tissue and orthopedic surgery, and pet dentistry."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Does Blue Cross Animal Hospital provide 24-hour emergency care?"
      },
      "a": {
        "en": "No, the hospital operates as a daytime clinical practice and directs critical after-hours emergencies to specialized 24-hour emergency hospitals."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are veterinary appointments available on Saturdays?"
      },
      "a": {
        "en": "Yes, the hospital is open for appointments on Saturdays from 9:00 AM to 5:00 PM."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Can clients pay for services using credit and debit cards?"
      },
      "a": {
        "en": "Yes, the clinic accepts major credit and debit cards alongside online booking options."
      },
      "basis": "website"
    }
  ],
