    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Welcoming veterinary doctors and staff"
      },
      "text": {
        "en": "Pet owners commend Dr. Andrea Martin, Dr. Mozes, and Dr. Davidson alongside receptionist Charlie for their attentive, reassuring, and compassionate service. Clients appreciate being kept informed throughout procedures and receiving thorough explanations. A couple of reviews report negative experiences involving front desk tone or perceived unprofessionalism."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Loving care for anxious pets"
      },
      "text": {
        "en": "Clients emphasize the tender attention provided to dogs and cats, noting that pets feel loved and comfortable during routine visits, vaccinations, and surgical procedures. Owners value the patient approach taken with anxious animals. Conversely, one client reported a distressing visit where their dog was handled roughly during a routine vaccination."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Skilled dental surgery and recovery"
      },
      "text": {
        "en": "Reviewers report excellent clinical outcomes for canine and feline dental surgeries, tooth extractions, and routine teeth cleanings. Owners appreciate detailed pre-op instructions, attentive monitoring under anesthesia, and smooth post-operative recoveries, though one customer expressed frustration with an incomplete physical examination."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are dental surgeries performed at Upper Village?"
      },
      "a": {
        "en": "Yes, clients frequently praise the clinic for dental cleanings, extractions, and emergency dental surgery with thorough pre-op care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are estimates provided for procedures?"
      },
      "a": {
        "en": "Reviewers appreciate upfront itemized estimates with lower and higher ranges, though clients recommend confirming rates prior to payment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital accept urgent appointments?"
      },
      "a": {
        "en": "Yes, pet owners report that staff have accommodated dental emergencies and urgent appointments on short notice."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How responsive is the clinic to communications?"
      },
      "a": {
        "en": "Clients note quick email responses from reception and personal phone updates from veterinarians before and after surgeries."
      },
      "basis": "reviews"
