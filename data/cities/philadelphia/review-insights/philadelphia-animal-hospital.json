  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 147,
      "title": {
        "en": "Compassionate clinical and nursing team"
      },
      "text": {
        "en": "The overwhelming majority of reviewers commend the veterinarians and veterinary technicians for their warm, empathetic bedside manner and thorough clinical care. Pet parents praise named doctors for explaining health conditions clearly. A small group of reviewers noted occasional friction with front desk receptionists."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 109,
      "title": {
        "en": "Gentle handling of family pets"
      },
      "text": {
        "en": "Clients frequently remark on how gently the clinical team handles anxious dogs and nervous cats during examinations, treatments, and vaccinations. Reviewers appreciate that veterinary assistants take time to comfort frightened animals, helping pets stay calm throughout routine check-ups and urgent visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Effective diagnostics and surgical recovery"
      },
      "text": {
        "en": "Pet owners report positive treatment outcomes across dental extractions, wound care, soft-tissue surgeries, and medication management. Many reviewers express gratitude to the veterinary team for accurately diagnosing chronic illnesses and assisting critically ill pets on the path to full recovery."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Philadelphia Animal Hospital accept walk-in patients?"
      },
      "a": {
        "en": "Yes, the clinic accommodates walk-in cases, though clients report that pre-booked appointments experience shorter waiting times."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What diagnostic services are available at the facility?"
      },
      "a": {
        "en": "The hospital provides comprehensive diagnostic care including bloodwork, digital radiography, ultrasound scans, and dental evaluations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can the veterinary team manage dental procedures for pets?"
      },
      "a": {
        "en": "Yes, veterinarians perform regular teeth cleaning, extractions, and oral surgery for both canine and feline patients."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients evaluate communication from the clinic?"
      },
      "a": {
        "en": "Most clients praise veterinary staff for thorough explanations during exams, though some report delays when requesting phone follow-ups or prescription refills."
      },
      "basis": "reviews"
    }
  ],
