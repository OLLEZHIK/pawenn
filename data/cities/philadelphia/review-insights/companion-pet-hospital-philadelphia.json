  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Warm and compassionate veterinary staff"
      },
      "text": {
        "en": "Clients speak very warmly of the clinicians and nursing team, singling out Dr Shakory, Shauna, and Mia for their patient care. Long-time pet owners appreciate the clinic's accommodating nature and friendly reception, noting that staff go out of their way to reassure anxious owners. A small minority of reviewers reported rushed or dismissive interactions."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Dedicated and calm animal handling"
      },
      "text": {
        "en": "Reviewers repeatedly note that dogs and cats receive affectionate, gentle care during check-ups, diagnostic bloodwork, and medical procedures. Multiple pet parents observe that even feisty cats or nervous rescues are handled calmly and comfortably. Clients remark that their pets show genuine excitement when visiting the practice rather than showing fear."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Reliable surgical outcomes and ongoing therapy"
      },
      "text": {
        "en": "Owners report solid medical outcomes for complex procedures, including spay and neuter operations, gastropexy, dental cleanings, and ongoing management of chronic feline illness. Clients praise the clear post-procedure recovery instructions and quick turnaround on diagnostic tests, though one reviewer questioned recommendations for costly invasive interventions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What veterinary services are offered at Companion Pet Hospital?"
      },
      "a": {
        "en": "The hospital offers wellness exams, vaccinations, dental cleanings, soft-tissue surgeries, spaying, and chronic disease management."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can owners schedule short-notice or urgent appointments?"
      },
      "a": {
        "en": "Yes, reviewers appreciate that the reception team frequently accommodates same-day sick appointments for distressed pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital offer pet bathing or grooming?"
      },
      "a": {
        "en": "Yes, clients specifically recommend the clinic groomer, Lisa, for baths and routine hygiene care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are cats and dogs treated at this facility?"
      },
      "a": {
        "en": "Yes, the hospital routinely cares for both dogs and cats, accommodating nervous rescues and senior animals."
      },
      "basis": "both"
    }
  ],
