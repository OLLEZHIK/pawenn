  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "en": "Compassionate clinical and nursing team"
      },
      "text": {
        "en": "Reviewers consistently commend the veterinarians, veterinary technicians, and reception staff for their gentle bedside manner and attentive patient care. Many clients describe team members going to great lengths to answer questions and comfort anxious animals during wellness checks. Although a few owners felt rushed during emergency visits, the vast majority describe a supportive hospital atmosphere."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Patient treatment of companion pets"
      },
      "text": {
        "en": "Pet parents highlight the calm and considerate approach taken by clinical staff when examining dogs, cats, and small animals. Reviewers note that technicians sit on exam room floors with nervous rescues, offering treats and taking time to build trust before administering vaccinations. Numerous clients express gratitude that their pets remain remarkably at ease throughout medical procedures."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "en": "Effective treatments and surgical care"
      },
      "text": {
        "en": "Pet owners frequently report successful diagnostic investigations, prompt surgical recoveries, and effective treatment plans for acute injuries and recurring infections. Reviewers note that veterinary doctors formulate clear therapeutic regimens that quickly alleviate discomfort for their companions. While a handful of complex emergencies proved difficult, overall clinical outcomes receive praise."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What animals are treated at Washington Ave Animal Hospital?"
      },
      "a": {
        "en": "The hospital provides comprehensive veterinary medical care for dogs, cats, and small companion animals."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are same-day appointments or urgent visits available?"
      },
      "a": {
        "en": "Yes, the clinic frequently accommodates same-day veterinary appointments and urgent medical concerns when schedule availability permits."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic provide on-site diagnostic and surgical services?"
      },
      "a": {
        "en": "Yes, the hospital is equipped with in-house laboratory testing, digital radiography, and dedicated surgical suites."
      },
      "basis": "both"
    }
  ],
