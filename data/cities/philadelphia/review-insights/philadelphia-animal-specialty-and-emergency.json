  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "en": "Supportive emergency doctors and nurses"
      },
      "text": {
        "en": "Most pet owners praise the emergency doctors, intensive care nurses, and receptionists for their compassionate support during severe pet crises. Clients appreciate that veterinary clinicians remain composed and reassuring. However, a small minority of visitors felt certain staff lacked empathy when discussing costly care options."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Dedicated care for critical patients"
      },
      "text": {
        "en": "Reviewers emphasize the tender, vigilant attention provided to critically injured or suddenly sick cats and dogs. Pet parents note that emergency personnel monitored their companions closely in the intensive care unit, ensuring animals remained comfortable and pain-free during challenging overnight stays."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Life-saving interventions and surgery"
      },
      "text": {
        "en": "Numerous pet owners credit the hospital with saving their pets lives through emergency surgery, poison toxicity treatment, and stabilisation of acute trauma. Clients report that pets made remarkable recoveries following complicated surgical procedures and round-the-clock supportive care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is Philadelphia Animal Specialty and Emergency open 24 hours a day?"
      },
      "a": {
        "en": "Yes, PASE operates continuous 24/7 emergency care and critical care triage every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are appointments required for emergency admissions?"
      },
      "a": {
        "en": "No appointment is necessary for emergency intake, as patients are evaluated and prioritised by medical triage on arrival."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the hospital offer advanced diagnostic imaging?"
      },
      "a": {
        "en": "Yes, the emergency hospital is equipped with digital radiography, ultrasonography, and advanced specialist imaging modalities."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do pet owners view treatment expenses at PASE?"
      },
      "a": {
        "en": "Clients note that emergency care and specialist diagnostics can be expensive, but many feel the round-the-clock intervention is invaluable during life-threatening crises."
      },
      "basis": "reviews"
    }
  ],
