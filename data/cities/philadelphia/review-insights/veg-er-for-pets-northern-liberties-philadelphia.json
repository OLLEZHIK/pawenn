  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 122,
      "title": {
        "en": "Compassionate emergency clinicians and nursing staff"
      },
      "text": {
        "en": "Pet owners consistently praise the emergency veterinarians, veterinary nurses, and triage team for their kindness and clinical skill during crises. Clients appreciate that staff remain calm under intense pressure, explain every diagnostic step clearly, and provide comforting emotional support."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 89,
      "title": {
        "en": "Rapid medical intervention and life-saving care"
      },
      "text": {
        "en": "Reviewers credit the facility with saving pets facing life-threatening conditions, from severe trauma and toxic ingestions to emergency abdominal surgeries and urgent transfusions. While critical outcomes are largely positive, a few owners noted diagnostic disputes in complex cases."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 60,
      "title": {
        "en": "Prompt urgent triage alongside peak delays"
      },
      "text": {
        "en": "Many visitors report being seen immediately upon arrival, praising rapid triage where veterinarians begin assessment straight away. However, clients presenting with stable conditions or arriving during peak night hours sometimes face extended waits lasting several hours before treatment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is VEG ER for Pets open 24 hours for emergencies?"
      },
      "a": {
        "en": "Yes, the facility operates 24 hours a day, 365 days a year, providing round-the-clock emergency and critical veterinary care."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can owners stay with their pet during emergency treatment?"
      },
      "a": {
        "en": "Yes, VEG features an open hospital floor plan allowing pet parents to remain by their companion's side throughout treatment."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does emergency patient triage operate?"
      },
      "a": {
        "en": "Patients are prioritized by medical urgency; life-threatening emergencies are treated immediately, while stable cases may wait."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are emergency diagnostic and treatment estimates provided upfront?"
      },
      "a": {
        "en": "Yes, clinicians provide cost breakdowns and treatment plans prior to initiating non-critical procedures and overnight stays."
      },
      "basis": "reviews"
    }
  ],
