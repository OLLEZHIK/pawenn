  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 73,
      "title": {
        "en": "Empathetic and experienced veterinary team"
      },
      "text": {
        "en": "Pet owners consistently commend the clinical staff for their comforting and compassionate approach during examinations and end-of-life visits. Reviewers frequently mention Dr. Palis, Dr. Wheeler, and Dr. Amber Lee for their thorough medical assessments and gentle manner. Clients express immense gratitude for the front desk staff and veterinary technicians, describing the entire practice as welcoming and dependable."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 66,
      "title": {
        "en": "Attentive care for anxious pets"
      },
      "text": {
        "en": "Clients frequently highlight how lovingly nervous dogs and frightened cats are handled throughout their appointments. Reviewers note that veterinary technicians and doctors take extra time to soothe skittish animals, ensuring exams proceed without unnecessary stress. Owners of senior pets and animals with chronic illnesses appreciate the gentle and patient care provided during each consultation."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "en": "Transparent pricing and thorough explanations"
      },
      "text": {
        "en": "Reviewers emphasize the clear and attentive communication from doctors and technicians regarding diagnoses and treatment options. Pet parents appreciate that costs are explained upfront before tests or procedures are performed, avoiding unexpected fees at checkout. The team's willingness to answer questions thoroughly helps clients feel confident and well informed about their pets' healthcare."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can the clinic accommodate urgent or same-day appointments?"
      },
      "a": {
        "en": "Yes, reviewers note that the team accommodated urgent situations when pet owners needed prompt medical guidance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Love City Vet provide end-of-life care?"
      },
      "a": {
        "en": "Yes, clients highlight compassionate and dignified end-of-life support from the veterinary team during difficult moments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the clinic handle anxious or fearful animals?"
      },
      "a": {
        "en": "Staff members use gentle techniques and take extra time to help nervous dogs and cats feel safe during exams."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are prices transparent before veterinary treatments?"
      },
      "a": {
        "en": "Yes, reviewers appreciate that doctors explain treatment costs and provide estimates before conducting tests or procedures."
      },
      "basis": "reviews"
    }
  ],
