  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Patient care for diverse canine personalities"
      },
      "text": {
        "en": "Reviewers praise the minders for their genuine devotion to dogs of all temperaments, including energetic rescues, timid pups, and senior canines. Owners note that walkers adapt easily to leash challenges, follow custom pacing for older pets, and build deep bonds of trust with each animal."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Dependable walkers and dedicated leadership"
      },
      "text": {
        "en": "Clients consistently commend the dog walkers and administrative directors for their punctuality, warmth, and reliable service over many years. Longtime customers highlight thoughtful organisation, steady scheduling, and minders who treat client pets with the same care as their own."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Detailed daily updates and user-friendly app"
      },
      "text": {
        "en": "Pet parents highlight the convenient mobile app for straightforward walk scheduling, quick schedule adjustments, and seamless messaging. Reviewers especially look forward to daily visit reports with photos, bathroom summaries, and notes detailing how their pet enjoyed the outing."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do owners receive visit updates after each dog walk?"
      },
      "a": {
        "en": "Yes, walkers provide daily reports through their app complete with visit photos, notes, and activity updates."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can Monster Minders care for elderly or high-energy dogs?"
      },
      "a": {
        "en": "Yes, reviewers highlight how walkers tailor walk pace and attention for energetic rescues and senior pets up to 17 years old."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How is dog walking scheduled and managed?"
      },
      "a": {
        "en": "Clients use an online portal and mobile app to book visits, modify appointments, and communicate with walkers."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is an introductory consultation provided for new clients?"
      },
      "a": {
        "en": "Yes, new customers complete an initial onboarding process where team members meet the pet and review household routines."
      },
      "basis": "both"
    }
