  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Gentle handling for sensitive pets"
      },
      "text": {
        "en": "Pet owners consistently note how calmly and lovingly the dog walkers interact with their animals, including timid rescues, senior dogs with mobility limitations, and cats needing home visits. Reviewers describe pets forming close bonds with regular walkers, returning from outings relaxed and content. Clients feel reassuring peace of mind knowing their companions are treated with genuine affection."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Dependable and conscientious dog walkers"
      },
      "text": {
        "en": "Clients express deep trust in Steph, Kim, Rory, and the wider walking team for their punctuality and dependable attendance across all seasons. Reviewers frequently emphasise that staff members handle sudden scheduling adjustments smoothly and never rush outings with their pets. Many long-standing customers rely on the team for both daily neighborhood walks and periodic overnight pet sitting."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Detailed reports and photo updates"
      },
      "text": {
        "en": "Dog owners appreciate the regular digital updates delivered through the scheduling application immediately following each visit. Reviewers frequently comment on the fun photographs, thorough walk notes, and timely bathroom logs provided by the walkers. Clients remark that this transparent communication provides daily reassurance while they are working or traveling away from home."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What pet care services does Wag The Dog provide?"
      },
      "a": {
        "en": "The team offers daily dog walking, in-home pet sitting, cat visits, and occasional boarding for established clients."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients track their dog's walks and updates?"
      },
      "a": {
        "en": "Clients book visits and receive detailed post-walk reports with photographs and notes through their dedicated mobile app."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can Wag The Dog accommodate reactive or senior dogs?"
      },
      "a": {
        "en": "Yes, reviewers frequently note that the walkers are experienced with reactive pups, rescue dogs, and senior pets with mobility restrictions."
      },
      "basis": "reviews"
    }
  ],
