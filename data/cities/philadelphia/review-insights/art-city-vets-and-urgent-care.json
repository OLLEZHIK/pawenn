  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "en": "Knowledgeable and compassionate medical clinicians"
      },
      "text": {
        "en": "Most pet parents commend Dr. Glantz, Dr. Zemanian, Dr. Schafer, and the urgent care nursing team for their empathy and diagnostic skill during acute crises. A small number of critical reviews describe inconsistent bedside manners, but the vast majority of visitors felt well supported."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Urgent stabilization and surgical care"
      },
      "text": {
        "en": "Clients frequently credit the urgent care team with saving pets after toxin ingestion, dental trauma, and severe metabolic emergencies. Although a few reviewers experienced diagnostic disagreements or delayed prescriptions, most report rapid stabilization and reliable clinical treatments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Attentive care for distressed animals"
      },
      "text": {
        "en": "Owners highlight that veterinary assistants handle sick and injured pets with great gentleness to reduce stress in high-anxiety triage settings. Reviewers appreciate that the clinical team keeps fragile cats and agitated dogs calm during essential examinations and monitoring."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners walk in for urgent veterinary care?"
      },
      "a": {
        "en": "Yes, the hospital accepts walk-in urgent cases seven days a week, though call-aheads are recommended during peak hours."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How long are typical urgent care wait times?"
      },
      "a": {
        "en": "Wait times vary by triage urgency; some non-critical patients report waits of one to two hours, while acute emergencies are seen promptly."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are pet owners permitted inside examination rooms?"
      },
      "a": {
        "en": "Standard urgent care triage often takes pets to treatment areas for initial assessment, though staff accommodates owner requests when feasible."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Art City Vets Urgent Care have an onsite pharmacy?"
      },
      "a": {
        "en": "Yes, urgent prescriptions and discharge medications can be dispensed directly from the on-premises pharmacy."
      },
      "basis": "both"
    }
  ],
