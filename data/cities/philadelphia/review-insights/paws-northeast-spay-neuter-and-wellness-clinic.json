  "faq": [
    {
      "q": {
        "en": "What low-cost surgical services are offered at PAWS Northeast?"
      },
      "a": {
        "en": "The clinic specializes in low-cost spay and neuter surgeries, trap-neuter-return (TNR) packages, and preventive wellness care for dogs and cats."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are appointments required for veterinary examinations and surgery?"
      },
      "a": {
        "en": "Yes, surgical procedures and wellness visits require advance scheduling, and clients should arrive promptly at their designated appointment times."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What preventive treatments are administered during wellness visits?"
      },
      "a": {
        "en": "The clinic provides core vaccinations, microchipping, flea prevention, heartworm testing, and nail trims alongside general health checks."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic assist community and feral cats?"
      },
      "a": {
        "en": "Yes, the clinic actively supports local trap-neuter-return efforts, offering subsidized neutering and rabies vaccinations for feral community cats."
      },
      "basis": "reviews"
    }
