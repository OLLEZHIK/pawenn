  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Warm reception and attentive team"
      },
      "text": {
        "en": "Clients frequently praise the clinic team for their welcoming demeanor and clear explanations during appointments. Reviewers highlight that Dr Karwacki and the veterinary nurses take time to answer questions and ease concerns. While a few clients felt dissatisfied during urgent medical visits, the broad majority report supportive and thorough communication."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 15,
      "title": {
        "en": "Mixed feedback on care outcomes"
      },
      "text": {
        "en": "Many pet owners report successful treatment for allergies, routine wellness checks, and positive grooming appointments. However, several reviewers experienced issues, including unexpected full shave-downs during dog grooming and concerns over missed diagnostic findings during illness. While routine care receives praise, clinical outcomes vary for some patients."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Patience with anxious pets"
      },
      "text": {
        "en": "Reviewers emphasize how gently the clinic handles nervous animals, from skittish kittens to senior dogs who dislike paw handling. Pet parents appreciate that staff members move at the animal's pace and offer soothing reassurance throughout nail trims and examinations. Many clients feel confident bringing sensitive pets here."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Heart + Paw Callowhill handle both veterinary visits and grooming?"
      },
      "a": {
        "en": "Yes, clients frequently visit the clinic for routine medical care, vaccinations, and dog or cat grooming sessions."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is parking available directly at the Callowhill clinic?"
      },
      "a": {
        "en": "The clinic does not provide private parking, but visitors note paid parking lots directly adjacent and street spaces within walking distance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the team accommodate pets with severe vet anxiety?"
      },
      "a": {
        "en": "Clients report that groomers and veterinary technicians use gentle techniques, allow extra time, and avoid rushing nervous animals."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can veterinary appointments be booked or adjusted online?"
      },
      "a": {
        "en": "Yes, pet owners mention that scheduling and modifying appointments can be handled either online or by telephone."
      },
      "basis": "both"
    }
  ],
