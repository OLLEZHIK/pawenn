  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 34,
      "title": {
        "pt": "Equipa médica especializada com opiniões divergentes",
        "en": "Specialized medical staff with mixed reviews"
      },
      "text": {
        "pt": "Muitos tutores agradecem a competência e a humanidade do corpo clínico e de enfermagem, citando médicos específicos em casos graves. Em contrapartida, outras opiniões criticam o atendimento de profissionais mais jovens e uma postura impessoal na receção durante momentos de aflição.",
        "en": "Many owners express gratitude for the clinical skill and compassion of veterinarians and nurses, mentioning specific doctors during severe cases. Conversely, other reviews criticize younger on-duty staff and perceived impersonal handling at reception during stressful visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 16,
      "title": {
        "pt": "Cuidados intensivos e diagnósticos com resultados mistos",
        "en": "Intensive care and diagnostics with mixed results"
      },
      "text": {
        "pt": "Vários clientes relatam intervenções cirúrgicas bem-sucedidas e tratamentos cruciais em situações de risco de vida, como intoxicações e oncologia. Por outro lado, surgem relatos de diagnósticos inconclusivos e agravamento clínico em urgências noturnas que geraram forte descontentamento.",
        "en": "Several clients report successful surgical procedures and life-saving treatments in critical emergencies such as poisonings or oncology. On the other hand, reports of disputed diagnoses and clinical deterioration during night emergency visits led to significant dissatisfaction."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 12,
      "title": {
        "pt": "Demoras prolongadas no atendimento de urgência",
        "en": "Extended waiting times during urgent visits"
      },
      "text": {
        "pt": "As críticas incidem com frequência sobre o tempo de espera no serviço permanente, com esperas de várias horas para a observação de animais com sintomas agudos. Os utilizadores apontam falhas na triagem inicial e a escassez de médicos de serviço nas madrugadas como problemas centrais.",
        "en": "Critiques frequently focus on lengthy delays in the round-the-clock emergency service, with owners waiting several hours for acutely ill pets to be examined. Reviewers point to slow initial triage and limited veterinary staffing during overnight shifts as recurring pain points."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "O Hospital Veterinário AniCura Santa Marinha funciona 24 horas?",
        "en": "Is AniCura Santa Marinha Veterinary Hospital open 24 hours?"
      },
      "a": {
        "pt": "Sim, o hospital dispõe de serviço permanente de urgências veterinárias durante 24 horas por dia, todos os dias do ano.",
        "en": "Yes, the hospital operates a 24-hour continuous emergency veterinary service every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Como é gerido o atendimento urgente sem marcação prévia?",
        "en": "How are walk-in emergency visits managed at the clinic?"
      },
      "a": {
        "pt": "Os casos urgentes são atendidos por ordem de chegada ou gravidade clínica, embora os clientes assinalem demoras no período noturno.",
        "en": "Emergency cases are seen based on arrival or clinical urgency, although clients note potential delays at night."
      },
      "basis": "reviews"
