  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 57,
      "title": {
        "pt": "Equipa elogiada pela simpatia e dedicação",
        "en": "Team praised for kindness and dedication"
      },
      "text": {
        "pt": "Os clientes em Vila Nova de Gaia destacam o atendimento caloroso e a grande competência dos profissionais, nomeadamente do Dr. João. A equipa médica e de apoio é frequentemente elogiada pela paciência e atenção prestada aos tutores durante as consultas. Apenas uma avaliação refere alguma rigidez no atendimento telefónico da receção.",
        "en": "Clients in Vila Nova de Gaia highlight the warm welcome and strong competence of the staff, particularly Dr. João. The medical and support team is frequently commended for patience and attentiveness shown to owners during appointments. Only one review notes occasional rigidity in phone handling at the reception desk."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "pt": "Acolhimento carinhoso e foco no bem-estar",
        "en": "Warm handling and pet welfare focus"
      },
      "text": {
        "pt": "As avaliações sublinham o carinho e os mimos dispensados aos animais, fazendo com que cães e gatos se sintam tranquilos durante a visita à clínica. Os tutores apreciam a delicadeza no manuseamento dos patudos, mesmo em momentos de vacinação ou exames. O ambiente é descrito como seguro e muito acolhedor para os animais de companhia.",
        "en": "Reviews emphasize the affection and pampering given to pets, helping dogs and cats remain calm during clinic visits. Guardians appreciate the gentle handling of their four-legged friends, even during vaccinations or diagnostic procedures. The clinic atmosphere is described as safe and very welcoming for companion animals."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 9,
      "title": {
        "pt": "Tratamentos cirúrgicos e preventivos bem-sucedidos",
        "en": "Successful preventive and surgical treatments"
      },
      "text": {
        "pt": "Os tutores manifestam total confiança na eficácia dos cuidados veterinários, relatando cirurgias de esterilização bem-sucedidas e recuperações rápidas. A administração regular de vacinas e o acompanhamento clínico preventivo garantem saúde e tranquilidade aos animais. Os resultados clínicos reforçam a fidelização contínua das famílias.",
        "en": "Pet parents express strong trust in the effectiveness of veterinary care, reporting successful spaying surgeries and smooth, rapid recoveries. Regular vaccination schedules and preventive monitoring keep pets healthy and reassure families. These reliable clinical outcomes reinforce long-term client loyalty in Vila Nova de Gaia."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "A clínica atende cães, gatos e animais exóticos?",
        "en": "Does the clinic treat dogs, cats, and exotic animals?"
      },
      "a": {
        "pt": "Sim, o espaço disponibiliza serviços médico-veterinários para cães, gatos e diversas espécies de animais exóticos.",
        "en": "Yes, the practice offers medical and clinical services for dogs, cats, and various exotic animal species."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Onde se localiza a clínica O Nosso Veterinário?",
        "en": "Where is O Nosso Veterinário clinic located?"
      },
      "a": {
        "pt": "A clínica situa-se na Rua Visconde das Devesas 872, em Vila Nova de Gaia, junto a acessos práticos da cidade.",
        "en": "The clinic is located on Rua Visconde das Devesas 872 in Vila Nova de Gaia, with convenient city access."
      },
      "basis": "website"
    },
    {
      "q": {
        "pt": "Como agendar consulta ou pedir esclarecimentos?",
        "en": "How can one book an appointment or ask questions?"
      },
      "a": {
        "pt": "As marcações de consulta e pedidos de informação são efetuados por contacto telefónico direto ou via WhatsApp.",
        "en": "Appointments and inquiries are handled directly through phone contact or via WhatsApp messaging."
      },
      "basis": "website"
    }
  ],
