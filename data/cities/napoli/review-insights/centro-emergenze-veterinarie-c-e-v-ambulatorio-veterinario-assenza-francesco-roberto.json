  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "it": "Disponibilità costante ed empatia del veterinario",
        "en": "Constant availability and empathetic veterinary care"
      },
      "text": {
        "it": "I clienti elogiano con costanza il dottor Francesco Assenza per la grande dedizione, l'onestà e il supporto umano anche durante i periodi estivi. Molti proprietari sottolineano la tempestività negli interventi e la capacità di trasmettere serenità sia agli animali sia alle famiglie nelle situazioni più critiche.",
        "en": "Clients consistently praise Dr. Francesco Assenza for dedication, honesty, and compassionate guidance, even throughout peak holiday periods. Numerous pet owners emphasize his prompt interventions and his ability to reassure both anxious pets and families during medical emergencies."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "it": "Diagnosi tempestive e interventi chirurgici risolutivi",
        "en": "Timely diagnoses and effective surgical interventions"
      },
      "text": {
        "it": "Nelle recensioni risaltano casi complessi risolti con successo, dalla chirurgia oncologica alle sterilizzazioni e al trattamento di gravi infezioni. Sebbene emergano rare segnalazioni critiche legate a esiti diagnostici felini, la maggioranza evidenzia guarigioni decisive dove altre cliniche non avevano dato speranze.",
        "en": "Reviewers highlight complex cases successfully managed, ranging from oncology surgeries to sterilizations and acute infections. While occasional complaints note unfavorable outcomes in feline cases, most clients report decisive recoveries where previous veterinary consultations had offered little hope."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 7,
      "title": {
        "it": "Cura affettuosa e rispetto per gli animali",
        "en": "Affectionate care and respect for animals"
      },
      "text": {
        "it": "Chi frequenta la struttura apprezza l'approccio dolce e scrupoloso riservato a cani e gatti di ogni età, compresi animali anziani o particolarmente spaventati. I proprietari notano una sincera passione verso i pazienti a quattro zampe, trattati sempre con sensibilità e attenzioni durante le visite.",
        "en": "Visitors appreciate the gentle and scrupulous care provided to dogs and cats of all ages, including elderly or frightened pets. Owners note genuine affection and patience towards their four-legged companions, who are consistently treated with empathy and delicate attention during consultations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "La clinica gestisce emergenze veterinarie?",
        "en": "Does the clinic handle veterinary emergencies?"
      },
      "a": {
        "it": "Sì, la struttura si occupa di pronto soccorso e interventi urgenti, anche se per le chiamate telefoniche è consigliabile insistere nei momenti di punta.",
        "en": "Yes, the facility manages first aid and urgent interventions, though reviewers advise persisting by phone during busy peak hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Vengono eseguiti interventi chirurgici complessi?",
        "en": "Are complex surgeries performed at the clinic?"
      },
      "a": {
        "it": "Sì, i proprietari segnalano interventi chirurgici oncologici, sterilizzazioni e trattamenti per traumi complessi.",
        "en": "Yes, pet owners report oncology surgeries, routine sterilizations, and treatment for complex traumatic conditions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Dove si trova l'ambulatorio a Napoli?",
        "en": "Where is the clinic located in Naples?"
      },
      "a": {
        "it": "L'ambulatorio si trova in via Emilio Scaglione nel quartiere Chiaiano, facilmente raggiungibile a Napoli nord.",
        "en": "The practice is located on Via Emilio Scaglione in the Chiaiano district, conveniently reachable in northern Naples."
      },
      "basis": "both"
    }
