  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 54,
      "title": {
        "it": "Equipe medica competente ma pareri contrastanti",
        "en": "Skilled medical team with contrasting opinions"
      },
      "text": {
        "it": "Molti proprietari esprimono gratitudine verso medici e infermieri per la tempestività e la dedizione dimostrata nel salvare cani e gatti in situazioni critiche. D'altra parte, diverse testimonianze denunciano freddezza, scarsa empatia da parte dell'accoglienza e comunicazioni percepite come scostanti nei momenti di emergenza.",
        "en": "Many pet owners praise the dedication and clinical skill of veterinary doctors and nurses who rescued dogs and cats in critical emergencies. Conversely, multiple reviews voice strong dissatisfaction regarding perceived detachment, limited empathy at the desk, and brusque communication during stressful hours."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 20,
      "title": {
        "it": "Tempi di attesa al pronto soccorso",
        "en": "Wait times at emergency triage"
      },
      "text": {
        "it": "La disponibilità continuativa ventiquattr'ore su ventiquattro viene apprezzata come risorsa fondamentale a Napoli. Tuttavia, numerosi utenti segnalano code estenuanti al pronto soccorso, con attese che possono superare le due o tre ore durante i turni notturni e nel fine settimana anche per pazienti sofferenti.",
        "en": "Continuous 24-hour availability is recognized as a vital lifeline in Naples. However, numerous clients report grueling wait times in the emergency area, with queues frequently stretching over two or three hours during night shifts and weekends, even for patients experiencing acute distress."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 19,
      "title": {
        "it": "Cure salvavita ed esiti della degenza",
        "en": "Emergency care and inpatient clinical outcomes"
      },
      "text": {
        "it": "Nelle recensioni si registrano numerosi interventi salvavita per pancreatiti, toracocentesi d'urgenza e blocchi urinari, con animali dimessi guariti dopo la degenza intensiva. Non mancano tuttavia segnalazioni dolorose di decessi e diagnosi ritenute tardive o errate in casi particolarmente gravi.",
        "en": "Reviews document several life-saving clinical procedures for pancreatitis, urgent thoracentesis, and feline urinary blockages resulting in recovery after intensive care. At the same time, painful accounts mention pet fatalities and diagnoses perceived as delayed or inaccurate in severe cases."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "Il policlinico è sempre aperto per le emergenze h24?",
        "en": "Is the veterinary hospital always open for 24/7 emergencies?"
      },
      "a": {
        "it": "Sì, la struttura garantisce servizio di pronto soccorso e degenza continuativa 24 ore su 24 tutti i giorni dell'anno.",
        "en": "Yes, the facility provides continuous emergency room and inpatient veterinary care 24/7 every day of the year."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Quali sono i tempi di attesa per le visite di pronto soccorso?",
        "en": "What are the typical wait times in the emergency area?"
      },
      "a": {
        "it": "Le attese dipendono dalla priorità clinica del triage, ma durante la notte e nei festivi possono verificarsi attese prolungate.",
        "en": "Wait times depend on clinical triage urgency, but long waits can occur during night shifts and weekend hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "La clinica dispone di reparto per la degenza intensiva?",
        "en": "Does the facility have an intensive care inpatient ward?"
      },
      "a": {
        "it": "Sì, i clienti confermano la presenza di ricovero con monitoraggio continuo per animali reduci da interventi o malattie acute.",
        "en": "Yes, clients confirm round-the-clock inpatient monitoring for pets recovering from surgery or acute medical conditions."
      },
      "basis": "reviews"
