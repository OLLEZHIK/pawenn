  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 35,
      "title": {
        "es": "Equipo quirúrgico experto y atención dividida",
        "en": "Expert surgical team and divided feedback"
      },
      "text": {
        "es": "Muchos usuarios elogian la dedicación y habilidad de cirujanos y veterinarios en Benipeixcar, destacando su implicación en intervenciones complejas y llamadas diarias durante ingresos. Sin embargo, varios clientes critican el trato en triaje de urgencias y señalan falta de empatía o frialdad al comunicar pronósticos desfavorables.",
        "en": "Many reviewers praise the dedication and technical skill of surgeons and veterinarians at Benipeixcar, highlighting daily updates during critical stays. However, several pet owners criticize the emergency triage reception, citing impersonal communication and a perceived lack of empathy during delicate prognostic consultations."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 19,
      "title": {
        "es": "Cirugías avanzadas y experiencias dispares",
        "en": "Advanced surgery and variable outcomes"
      },
      "text": {
        "es": "Numerosos testimonios agradecen intervenciones salvadoras en traumatología, hernias discales, endoscopias de urgencia y parvovirosis. En contraposición, otros propietarios reportan complicaciones postoperatorias, diagnósticos contradictorios y desenlaces dolorosos en animales que ingresaron en estado de extrema gravedad.",
        "en": "Numerous testimonials express gratitude for life-saving surgeries in trauma, spinal herniations, emergency endoscopies, and severe infections. Conversely, other guardians report postoperative complications, disputed diagnoses, and distressing outcomes when animals were admitted in critically unstable condition."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 7,
      "title": {
        "es": "Tarifas de urgencias y hospitalización",
        "en": "Emergency and hospitalization pricing"
      },
      "text": {
        "es": "Varios tutores manifiestan desacuerdo con el elevado coste de la hospitalización, pruebas diagnósticas y suplementos de urgencia en horario nocturno o festivo. Aunque algunos valoran la disponibilidad ininterrumpida de tecnología hospitalaria, predomina la percepción de que los presupuestos resultan elevados y poco flexibles.",
        "en": "Several clients express dissatisfaction with high charges for emergency admissions, advanced imaging, and overnight intensive care on weekends. While a few pet owners accept the expense given the 24-hour hospital infrastructure, prevailing feedback considers diagnostic estimates steep and difficult for families to absorb."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿El hospital veterinario está abierto las 24 horas?",
        "en": "Is the veterinary hospital open 24 hours?"
      },
      "a": {
        "es": "Sí, cuenta con servicio de urgencias médicas y quirúrgicas las 24 horas, todos los días del año.",
        "en": "Yes, they provide 24-hour medical and surgical emergency services every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Disponen de quirófano y diagnóstico por imagen avanzado?",
        "en": "Do they have on-site operating rooms and advanced imaging?"
      },
      "a": {
        "es": "Sí, realizan tomografía computarizada (TAC), endoscopia, radiología digital, ecografía y cirugía traumatológica y de tejidos blandos.",
        "en": "Yes, they perform CT scans, endoscopy, digital radiography, ultrasound, and orthopedic and soft-tissue surgery."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Se informa diariamente a los tutores durante la hospitalización?",
        "en": "Are pet guardians updated daily during hospitalization?"
      },
      "a": {
        "es": "Sí, el equipo veterinario realiza partes médicos regulares y llamadas de seguimiento sobre la evolución del paciente ingresado.",
        "en": "Yes, the veterinary team provides regular medical updates and telephone follow-ups regarding the patient's progress."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "es": "¿Es necesario pagar las pruebas antes de realizarlas en urgencias?",
        "en": "Must diagnostic tests be paid before being performed in emergencies?"
      },
      "a": {
        "es": "La clínica presenta un presupuesto previo para la aprobación y abono de las pruebas diagnósticas o ingresos necesarios.",
        "en": "The clinic presents an upfront estimate for approval and payment before carrying out diagnostic tests or hospital admission."
      },
      "basis": "reviews"
    }
