  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 103,
      "title": {
        "es": "Especialistas veterinarios en medicina de exóticos",
        "en": "Specialized veterinarians in exotic animal medicine"
      },
      "text": {
        "es": "Los clientes de L'Olivereta destacan la extraordinaria preparación del equipo médico en animales exóticos. Los propietarios alaban la paciencia y el conocimiento específico de las veterinarias para tratar especies delicadas, aunque un par de reseñas críticas cuestionan diagnósticos recibidos en casos complejos.",
        "en": "Clients in L'Olivereta highlight the exceptional expertise of the veterinary staff regarding exotic pets. Owners frequently praise the patience and specialized species-specific knowledge of the doctors, though a couple of critical reviews question diagnoses received in complicated cases."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "es": "Manejo experto de animales exóticos",
        "en": "Expert handling of diverse exotic species"
      },
      "text": {
        "es": "Los tutores de conejos, aves, reptiles y pequeños mamíferos subrayan el trato respetuoso y adaptado a la anatomía de cada especie. Se valora especialmente la tranquilidad con la que exploran a ejemplares propensos al estrés, minimizando el impacto emocional durante las consultas clínicas.",
        "en": "Guardians of rabbits, birds, reptiles, and small mammals emphasize the gentle and anatomically respectful handling provided to each species. Reviewers particularly value the calm demeanor used during physical exams on stress-prone pets, minimizing anxiety throughout their clinic visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "es": "Resultados en cirugías y patologías graves",
        "en": "Effective outcomes in exotic pet surgeries"
      },
      "text": {
        "es": "Las reseñas reportan numerosas recuperaciones exitosas tras cirugías complejas, tratamientos digestivos y cuidados intensivos en animales de pequeño tamaño. Muchas familias afirman que la clínica salvó la vida de sus mascotas cuando otros centros convencionales no contaban con medios adecuados.",
        "en": "Reviews document numerous successful recoveries following intricate surgeries, gastrointestinal treatments, and intensive care in small exotic pets. Many owners emphasize that the clinic saved their animals' lives when standard practices lacked the necessary specialized diagnostic tools."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Atiende la clínica animales domésticos convencionales como perros o gatos?",
        "en": "Does the clinic treat traditional pets such as dogs or cats?"
      },
      "a": {
        "es": "No, el centro se dedica con exclusividad a la medicina de animales exóticos: aves, conejos, hurones, roedores y reptiles.",
        "en": "No, the practice is exclusively dedicated to exotic animal care: birds, rabbits, ferrets, rodents, and reptiles."
      },
      "basis": "website"
    },
    {
      "q": {
        "es": "¿Qué pruebas diagnósticas realizan en consulta para animales exóticos?",
        "en": "What diagnostic tests are performed during exotic pet consultations?"
      },
      "a": {
        "es": "Disponen de radiografía digital, ecografía, endoscopia y analíticas específicas para evaluar la salud de cada especie.",
        "en": "They utilize digital radiography, ultrasound, endoscopy, and dedicated in-house lab testing adapted to each species."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Es necesario pedir cita con antelación para una revisión de exóticos?",
        "en": "Is it necessary to schedule an appointment in advance for an exotic pet?"
      },
      "a": {
        "es": "Sí, se atiende con cita previa para garantizar el tiempo de consulta y preparar el manejo específico de cada animal.",
        "en": "Yes, consultations require prior booking to ensure adequate examination time and species-tailored handling."
      },
      "basis": "both"
    }
  ],
