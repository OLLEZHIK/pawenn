  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 110,
      "title": {
        "es": "Atención comercial amable y asesoramiento cercano",
        "en": "Helpful store staff and friendly advice"
      },
      "text": {
        "es": "La gran mayoría de clientes elogia la amabilidad y buena disposición de los empleados en el centro comercial Aqua. Resaltan la ayuda de dependientes como Fran o Andrea para cargar sacos pesados y recomendar piensos adecuados, aunque algunos compradores señalan esperas puntuales en caja.",
        "en": "The vast majority of clients praise the friendly approach and willingness of the sales team at the Aqua shopping center. Shoppers appreciate staff members assisting with heavy pet food bags and recommending nutritional diets, despite occasional complaints regarding checkout delays."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 70,
      "title": {
        "es": "Gran surtido y aparcamiento cómodo",
        "en": "Extensive selection and easy mall parking"
      },
      "text": {
        "es": "Los usuarios aprecian la amplitud de la tienda y la gran variedad de marcas de alimentación, accesorios, rascadores y lechos higiénicos. La ubicación dentro de Aqua Multiespacio facilita el acceso gracias al aparcamiento del centro comercial, ideal para compras voluminosas.",
        "en": "Shoppers appreciate the spacious store layout and wide variety of pet food brands, accessories, cat scratchers, and hygienic litter. The location inside Aqua Multiespacio facilitates easy visits thanks to mall parking, making bulk purchases and heavy loading convenient."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "es": "Pequeños mamíferos y nutrición variada",
        "en": "Small pets and diverse animal nutrition"
      },
      "text": {
        "es": "Los visitantes destacan el espacio dedicado a pequeños mamíferos como conejos y cobayas, además de la variedad de juguetes y alimentos para roedores y aves. Los tutores valoran encontrar alternativas de comida natural, suplementos y bar de snacks a granel para sus mascotas.",
        "en": "Visitors highlight the section dedicated to small domestic pets such as rabbits and guinea pigs, alongside toys and food for rodents and birds. Pet owners appreciate finding natural diet options, dietary supplements, and a bulk snack bar with treats for dogs and cats."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Tiene la tienda servicio de Click & Collect para pedidos online?",
        "en": "Does the store offer Click & Collect for online orders?"
      },
      "a": {
        "es": "Sí, es posible comprar a través de la web oficial y recoger el pedido en la tienda del centro comercial Aqua en 24/48 horas sin coste.",
        "en": "Yes, customers can place orders online and pick them up at the Aqua shopping center store within 24 to 48 hours free of charge."
      },
      "basis": "website"
    },
    {
      "q": {
        "es": "¿Disponen de zona de pequeños mamíferos y roedores?",
        "en": "Do they have a dedicated small pet and rodent section?"
      },
      "a": {
        "es": "Sí, el establecimiento cuenta con una sección específica de pequeños mamíferos, alimentación especializada, lechos y accesorios.",
        "en": "Yes, the store features a dedicated small mammal area offering specialized feed, bedding, and pet care accessories."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Se puede aparcar fácilmente para recoger compras grandes?",
        "en": "Is parking readily available for picking up large orders?"
      },
      "a": {
        "es": "Sí, al estar ubicada en el Centro Comercial Aqua Multiespacio, los clientes disponen del aparcamiento subterráneo del propio centro.",
        "en": "Yes, being located inside Centro Comercial Aqua Multiespacio, clients have access to the shopping center's underground parking."
      },
      "basis": "both"
    }
  ],
