  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 61,
      "title": {
        "es": "Asesoramiento cercano y atención del personal",
        "en": "Attentive store staff and helpful advice"
      },
      "text": {
        "es": "Los clientes elogian con entusiasmo el trato amable y la profesionalidad de las dependientas del CC Arena, destacando en repetidas ocasiones la ayuda de Lara, Ari y Andrea. Valoran las explicaciones claras sobre piensos para perros y gatos, así como el acompañamiento paciente para encontrar productos específicos por toda la tienda.",
        "en": "Shoppers enthusiastically praise the welcoming attitude and helpfulness of the Arena mall sales team, frequently highlighting personalized guidance from Lara, Ari, and Andrea. Reviews appreciate detailed recommendations regarding pet diets as well as patient assistance navigating aisles to locate suitable supplies."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "es": "Atención orientada al bienestar animal",
        "en": "Care focused on companion animal needs"
      },
      "text": {
        "es": "Los visitantes aprecian el cariño hacia las mascotas que visitan la tienda y las pautas nutricionales recibidas para cachorros, gatos mayores y pequeños mamíferos como roedores o conejos. En contraste, se registra una reseña crítica grave sobre conejos jóvenes que llegaron parasitados, demandando mayor control sanitario en tienda.",
        "en": "Visitors appreciate the affectionate care shown toward visiting pets and the dietary advice offered for puppies, senior cats, and small animals such as hamsters. In contrast, there is a notable complaint concerning young pet shop rabbits suffering from parasitic infections, urging stricter preventive hygiene standards on site."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "es": "Amplia variedad y suministros para mascotas",
        "en": "Broad selection and complete pet inventory"
      },
      "text": {
        "es": "La clientela valora la gran amplitud del establecimiento en el Centro Comercial Arena Multiespacio y la diversidad de su catálogo, que incluye accesorios, acuariofilia y alimentación específica. No obstante, varios compradores lamentan la falta de actualización en los horarios publicados sobre aperturas en domingos y festivos.",
        "en": "Customers appreciate the spacious layout of the store at Arena Multiespacio shopping center and the diversity of its catalog, spanning pet toys, aquarium care, and specialized nutrition. However, several visitors express frustration regarding outdated Google Maps listings concerning holiday and Sunday store opening hours."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Se puede acudir a la tienda con perro?",
        "en": "Can customers bring their dogs into the store?"
      },
      "a": {
        "es": "Sí, el centro comercial y la tienda son pet friendly, permitiendo la entrada de perros atados.",
        "en": "Yes, the mall and store are pet friendly, welcoming leashed dogs inside the premises."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Disponen de servicio Click & Collect de recogida?",
        "en": "Is Click & Collect store pickup available?"
      },
      "a": {
        "es": "Sí, permiten comprar online a través de la web oficial de Kiwoko y recoger el pedido en tienda.",
        "en": "Yes, shoppers can purchase items online via Kiwoko's website and pick up orders in store."
      },
      "basis": "website"
    },
    {
      "q": {
        "es": "¿Tienen sección de acuarios y peces ornamentales?",
        "en": "Do they stock aquariums and aquarium supplies?"
      },
      "a": {
        "es": "Sí, la tienda cuenta con un departamento de acuariofilia con peceras, filtros y alimentación para peces.",
        "en": "Yes, the store features an aquatics section with fish tanks, water care, and specialty food."
      },
      "basis": "website"
    },
    {
      "q": {
        "es": "¿Abre la tienda los domingos y días festivos?",
        "en": "Is the store open on Sundays and holidays?"
      },
      "a": {
        "es": "La apertura en domingos depende del calendario comercial del CC Arena; conviene consultar antes de acudir.",
        "en": "Sunday opening depends on the mall commercial calendar; verifying ahead of time is recommended."
      },
      "basis": "reviews"
    }
