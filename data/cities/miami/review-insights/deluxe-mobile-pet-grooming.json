  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Thorough styling and fresh coats"
      },
      "text": {
        "en": "Clients consistently express satisfaction with the quality of cuts, styling, and hygiene treatments provided at their doorstep. Pet owners report that dogs return smelling fresh and clean, with neatly clipped nails, brushed fur, and thorough teeth cleanings across breeds like pugs, cocker spaniels, and French bulldogs."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Attentive and polite mobile groomers"
      },
      "text": {
        "en": "Reviewers frequently praise individual groomers, notably Luis and Yosuan, for their professional conduct and friendly communication. Pet owners appreciate the courteous approach and clear updates upon arrival. Clients emphasize that the grooming team listens to styling requests and maintains high standards of care inside their equipped mobile vans."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "en": "Gentle handling for anxious pups"
      },
      "text": {
        "en": "Multiple dog owners mention that their pets stay relaxed throughout the grooming process despite initial nervousness. Reviewers appreciate that the groomers work calmly and gently, allowing dogs to finish their baths and haircuts without unnecessary stress, returning to their families calm and happy."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do groomers bring their own mobile grooming equipment?"
      },
      "a": {
        "en": "Yes, clients note that groomers arrive in fully equipped, clean mobile vans with all necessary tools for bathing, haircutting, and nail trimming."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How punctual are arrival times for home appointments?"
      },
      "a": {
        "en": "Reviewers generally report prompt arrivals within scheduled appointment windows, though clients note arrival times can occasionally shift depending on daily routes."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can groomers accommodate sensitive or specific dog breeds?"
      },
      "a": {
        "en": "Yes, pet owners praise the groomers for successfully and gently styling various breeds, including French bulldogs, cocker spaniels, pugs, and yorkies."
      },
      "basis": "reviews"
    }
  ],
