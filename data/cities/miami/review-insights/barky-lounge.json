  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Affectionate and patient pet handling"
      },
      "text": {
        "en": "Pet owners consistently remark that their dogs genuinely love visiting Barky Lounge, often arriving with tail-wagging excitement. Reviewers emphasize that the staff handles dogs of all sizes, from Yorkies to Huskies and Standard Poodles, with gentle patience and attentive affection. Clients feel fully confident leaving their beloved companions in such caring hands."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Immaculate haircuts and soft coats"
      },
      "text": {
        "en": "Clients frequently praise the high quality of grooming and bathing, noting that dogs emerge looking clean, smelling wonderful, and sporting beautifully tailored cuts. Owners highlight how soft, fluffy, and well-brushed their pets' fur feels after visits. Groomer Kharla is especially commended for delivering precision styling that matches owner requests perfectly."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Dedicated owner and courteous team"
      },
      "text": {
        "en": "Reviewers express immense appreciation for the welcoming and professional customer service. The owner, Jed, is frequently commended for greeting clients and pets by name with personalized warmth, while the reception team is described as sweet, organized, and helpful. Pet parents also value knowledgeable advice on dietary recommendations for skin allergies."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Barky Lounge provide parking for customers?"
      },
      "a": {
        "en": "Yes, clients note that the Edgewater salon features convenient free parking for pet drop-off and pickup."
      },
      "basis": "reviews"
    },
    {
