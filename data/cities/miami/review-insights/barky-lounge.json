    {
      "q": {
        "en": "Does the salon carry pet treats and boutique accessories?"
      },
      "a": {
        "en": "Yes, customers praise an extensive boutique selection of high-quality treats, dog food, and pet accessories in the store."
      },
      "basis": "reviews"
