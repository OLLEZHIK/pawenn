  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "en": "Attentive clinical and front-desk team"
      },
      "text": {
        "en": "Pet owners frequently highlight the attentiveness and kindness of the medical staff, mentioning Dr. Perez, Lazaro, Nancy, and Amarilis by name. Reviewers appreciate that the team listens closely to questions and guides clients through health certificate paperwork. A few owners reported administrative disputes or feeling rushed during appointments, but the vast majority describe a supportive and dedicated staff."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Gentle handling across diverse pets"
      },
      "text": {
        "en": "Clients consistently praise how patiently the team handles animals during stressful visits, including nervous dogs and senior cats. Several reviewers specifically commend the staff for their careful approach with rabbits, birds, and other small pets during spays and nail trims. Pet parents note that animals are greeted with genuine affection and calm reassurance."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Dependable surgical and routine outcomes"
      },
      "text": {
        "en": "Many reviewers express deep gratitude for successful medical treatments, ranging from routine neutering and dental cleanings to emergency surgeries. Clients report smooth recoveries and clean surgical incisions for puppies and rabbits alike. While one reviewer shared grief over a bird that did not survive illness, most clients credit the clinic with life-saving interventions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Miami Springs Animal Hospital treat exotic pets like rabbits and birds?"
      },
      "a": {
        "en": "Yes, clients report successful spaying, nail trims, and checkups for rabbits, birds, and other small animals."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can the clinic assist with international pet travel certificates?"
      },
      "a": {
        "en": "Yes, pet owners mention that the staff and management guide travelers through paperwork and health certificates."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do pet parents need an appointment for routine visits?"
      },
      "a": {
        "en": "The hospital accommodates appointments and walk-in visits for pet examinations and urgent concerns."
      },
      "basis": "both"
    }
  ],
