  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 81,
      "title": {
        "en": "Courteous and reliable mobile groomers"
      },
      "text": {
        "en": "Clients warmly praise the friendly and attentive mobile groomers, frequently singling out Miguel, Carlos, Victor, and Pablo for their punctuality and care. While an isolated critical complaint reported distress and a rushed service, the vast majority of pet parents describe the technicians as dependable and dedicated professionals."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "en": "Fresh haircuts and clean finishes"
      },
      "text": {
        "en": "Reviewers express strong satisfaction with grooming outcomes, highlighting spotless coats, pleasant-smelling shampoo scents, neat breed haircuts, and thorough teeth cleaning. While a couple of reviews expressed dissatisfaction with trimming quality, most clients emphasize that pets emerge looking immaculate and well groomed."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 79,
      "title": {
        "en": "Gentle and patient pet care"
      },
      "text": {
        "en": "Pet owners consistently note that dogs, puppies, and cats are handled with great patience, warmth, and affection directly at their homes. Clients appreciate that groomers keep nervous pets relaxed and calm throughout bathing and brushing. Aside from one serious grievance regarding an older dog, reviewers report trusting the team."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does Yofren Master Mobile Pet Grooming operate?"
      },
      "a": {
        "en": "The service provides full mobile pet grooming directly at clients homes across Miami, equipped with self-contained grooming vans."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Which groomers are frequently praised by pet owners?"
      },
      "a": {
        "en": "Clients frequently praise groomers such as Miguel, Victor, Carlos, and Pablo for their gentle handling and attentive care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients view the convenience of at-home mobile grooming?"
      },
      "a": {
        "en": "Pet parents highlight the comfort of having pets groomed at their doorstep without stressful travel or waiting in salon crates."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where is the business based?"
      },
      "a": {
        "en": "The business is based on SW 37th Terrace in Miami, dispatching mobile grooming vans to surrounding neighborhoods."
      },
      "basis": "both"
    }
  ],
