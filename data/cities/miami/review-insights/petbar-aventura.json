    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 18,
      "title": {
        "en": "Mixed grooming finishes and washes"
      },
      "text": {
        "en": "Pet owners report contrasting experiences with grooming outcomes at this Aventura salon. Many clients are pleased with neat teddy bear haircuts, thorough baths, and clean nail trims for puppies and small dogs. However, several dissatisfied customers noted uneven cuts, accidental nicks, or results that did not match reference photos, making overall opinions mixed."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Helpful and welcoming store team"
      },
      "text": {
        "en": "Most reviewers praise employees like Billy and Jennifer for welcoming guests warmly and explaining self-service wash equipment clearly. Pet owners note that front-desk staff remain polite and accommodating during check-in and product selection. Although a few reviewers criticized individual groomers after disappointing haircut sessions, the overall impression of the team remains positive."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Attentive care for bathers"
      },
      "text": {
        "en": "Clients generally appreciate that bathers and attendants treat dogs with affection and patience during salon visits. Reviewers mention that pets enjoy the warm water and gentle handling during bath appointments and self-wash sessions. Aside from a couple of reports regarding skin nicks during clipping, pet parents feel their dogs are handled with warmth."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Petbar Aventura offer self-service dog wash stations?"
      },
      "a": {
        "en": "Yes, pet parents can wash their own dogs using elevated tubs, specialty shampoos, and high-velocity dryers."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are specific haircut styles available upon request?"
      },
      "a": {
        "en": "Yes, groomers offer styled haircuts like teddy bear trims, though client satisfaction varies depending on the groomer."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is booking required for self-wash tubs?"
      },
      "a": {
        "en": "Self-wash stations generally accommodate walk-ins, while full-service grooming appointments are booked in advance."
      },
      "basis": "both"
    }
