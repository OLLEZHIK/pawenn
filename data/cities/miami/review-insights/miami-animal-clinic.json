  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 66,
      "title": {
        "en": "Attentive doctors and supportive staff"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinary team at Miami Animal Clinic, particularly Dr. Palacios, Dr. Lorente, and front desk receptionist Carla. Clients appreciate their patient explanations and dedication during urgent visits. A few reviewers voiced frustration regarding communication or high surgical estimates, but most describe a compassionate bedside manner."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 57,
      "title": {
        "en": "Gentle handling for household pets"
      },
      "text": {
        "en": "Reviewers frequently highlight the affectionate and calming treatment their dogs and cats receive during appointments. Many clients emphasize that staff treat pets like family members, keeping anxious animals comfortable during examinations, blood draws, and dental checkups. Families feel reassured knowing their companions are handled with patience."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Reliable surgical and wellness outcomes"
      },
      "text": {
        "en": "Clients report dependable medical results across major procedures, including spay surgeries, wound repairs, and dental extractions. Many pet parents note smooth recoveries following difficult procedures and credit the clinical team with saving ailing animals. While one client questioned diagnostic necessity, overall feedback reflects high trust in treatment success."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do pet owners need an appointment, or are walk-ins accepted?"
      },
      "a": {
        "en": "The clinic accepts both scheduled appointments and walk-in visits, though clients mention that calling ahead helps minimize wait times during busy hours."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does Miami Animal Clinic perform surgical and dental procedures?"
      },
      "a": {
        "en": "Yes, clients frequently report successful soft-tissue surgeries, wound repairs, spay procedures, and complex dental extractions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are the veterinarians and front desk staff bilingual?"
      },
      "a": {
        "en": "Yes, multiple reviewers note that staff and clinicians communicate comfortably in both English and Spanish."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What do clients report about routine visit pricing?"
      },
      "a": {
        "en": "Many owners describe office visits and routine treatments as reasonably priced, though several clients noted steep estimates for major surgeries."
      },
      "basis": "reviews"
    }
  ],
