  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "en": "Social play and home-like atmosphere"
      },
      "text": {
        "en": "Pet parents overwhelmingly report that their dogs and cats receive affectionate, family-like care during overnight boarding and daycare stays. Reviewers emphasize that pets enjoy socializing in group play, roaming freely without confinement, and returning home happy and relaxed."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Attentive hospitality and hands-on caregivers"
      },
      "text": {
        "en": "Reviewers frequently praise Susana and Mario for their dedicated hospitality, personal warmth, and professional pet oversight. Clients note that the team adheres strictly to medical and feeding routines, creating a welcoming and trustworthy environment that puts pet owners at ease."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Daily photo updates and responsive messaging"
      },
      "text": {
        "en": "Owners consistently appreciate receiving frequent photo and video updates throughout their pets' boarding visits. Multiple reviewers mention that the staff promptly answers messages and shares cheerful pictures of playtime, providing valuable peace of mind while families travel."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do owners receive regular updates during boarding stays?"
      },
      "a": {
        "en": "Yes, clients frequently note that Susana and Mario send daily photos, videos, and text updates showing their pets playing and resting."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are dogs allowed cage-free playtime and socialization?"
      },
      "a": {
        "en": "Reviewers emphasize that dogs enjoy open play areas and group socializing matched by temperament rather than being confined to cages."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where is Pet Ville Inn located?"
      },
      "a": {
        "en": "The boarding facility is located on SW 224th Street in southern Miami-Dade County near the Redland agricultural area."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can the team manage specific medication schedules?"
      },
      "a": {
        "en": "Yes, clients mention that instructions and medications for boarded pets are followed conscientiously by the caretakers."
      },
      "basis": "reviews"
    }
  ],
