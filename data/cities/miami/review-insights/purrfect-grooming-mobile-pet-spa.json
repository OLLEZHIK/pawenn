  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 22,
      "title": {
        "en": "Praised individual groomers alongside service disputes"
      },
      "text": {
        "en": "Many pet owners praise individual mobile groomers, commending specialists like Manuel, Leidy, and Francisco for their professionalism, punctuality, and friendly demeanor. However, multiple dissatisfied clients describe serious service issues, including no-show appointments without notification, pressure for gratuity, and management offering refunds conditioned on non-disclosure agreements."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 14,
      "title": {
        "en": "Show-quality styling mixed with haircut errors"
      },
      "text": {
        "en": "Numerous reviewers celebrate beautiful grooming outcomes, reporting that dogs and cats smell fresh and look show-competition ready after breed-specific styling. Conversely, critical reviews report significant clipping mistakes, citing instances where dogs were completely shaved against owner instructions, schnauzer eyelashes were cut, and one cat suffered an accidental clipper injury."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 9,
      "title": {
        "en": "Gentle handling for dogs and cats"
      },
      "text": {
        "en": "The majority of clients highlight the gentle, patient handling demonstrated inside the mobile spa vans. Pet parents note that groomers take time to comfort nervous puppies, play with pets before bathing, and provide calm care for senior dogs and sensitive cats. Aside from an isolated grooming accident, reviewers feel their pets are treated with genuine affection."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Purrfect Grooming groom cats as well as dogs?"
      },
      "a": {
        "en": "Yes, clients frequently mention booking mobile spa sessions for cats, praising groomers who provide gentle baths and coat styling."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are same-day mobile appointments available?"
      },
      "a": {
        "en": "Yes, reviewers note that same-day bookings are often accommodated, with vans sometimes arriving within hours of booking."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners monitor their pet during the grooming session?"
      },
      "a": {
        "en": "The company advertises an interactive live pet camera, though a reviewer noted that the video link was not provided during their visit."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do customers describe pricing transparency?"
      },
      "a": {
        "en": "Reviewers advise confirming full pricing in writing beforehand, as several clients reported unexpected charges and unclear quotes."
