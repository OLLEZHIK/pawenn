  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 93,
      "title": {
        "en": "Empathetic emergency medical team"
      },
      "text": {
        "en": "Pet owners overwhelmingly praise the emergency veterinarians, veterinary nurses, and technicians for their compassion, attentiveness, and calming presence during stressful visits. While most visitors feel well supported, several critical reviews mention instances of impersonal bedside manner and disagreements over diagnostic recommendations."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Prompt triage with emergency priority"
      },
      "text": {
        "en": "Clients consistently commend the clinic for fast walk-in triage, noting that pets in acute medical distress are evaluated almost immediately upon arrival. Most reviewers appreciate being seen without appointments, though during busy periods or complex emergency stabilizations, some pet parents experienced longer waiting times."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Open floor model comforting pets"
      },
      "text": {
        "en": "Visitors frequently celebrate the hospital's open-concept design that allows owners to stay beside their dogs and cats throughout examinations and treatment. Pet parents note that being physically present reduces pet anxiety significantly, with nursing staff providing gentle handling and comfortable bedding during care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners stay with their animals during emergency care?"
      },
      "a": {
        "en": "Yes, clients frequently highlight the open hospital model where families remain beside their pets throughout triage, diagnostics, and treatments."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is VEG ER for Pets Pinecrest open 24 hours?"
      },
      "a": {
        "en": "Yes, reviewers confirm the hospital operates 24/7 every day of the week, accepting walk-in emergencies without requiring an advance appointment."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are estimates provided prior to performing emergency procedures?"
      },
      "a": {
        "en": "Yes, pet parents report that staff discuss treatment plans and provide pricing estimates upfront, though costs for intensive emergency care can be high."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the Pinecrest facility treat exotic pets?"
      },
      "a": {
        "en": "Yes, the practice accepts companion animals as well as exotic pets requiring urgent veterinary assessment and supportive care."
      },
      "basis": "both"
    }
  ],
