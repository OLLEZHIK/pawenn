  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 69,
      "title": {
        "en": "Friendly and attentive mobile groomers"
      },
      "text": {
        "en": "Pet owners frequently praise groomers like Jorge, Santos, Liliana, and Carlos for their friendly demeanor, professionalism, and dedication. Clients appreciate their patient attitude and careful attention to styling requests, though one client reported an unpleasant interaction with an individual groomer."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Fresh scents and stylish haircuts"
      },
      "text": {
        "en": "Reviews consistently highlight the quality of the haircuts, noting that dogs return looking clean, well-trimmed, and smelling wonderful. Customers value neat styling on a variety of breeds including poodles and doodles, with several owners mentioning that their pets looked noticeably happier after grooming."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Gentle care for nervous dogs"
      },
      "text": {
        "en": "Many clients emphasize how comfortably their dogs handle the mobile grooming session, even puppies having their very first cut or senior pets with arthritis. Owners appreciate that groomers take time to calm nervous animals, helping pets feel safe and relaxed throughout the appointment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does mobile grooming work with this service?"
      },
      "a": {
        "en": "A fully equipped mobile grooming van arrives directly at the client's home or driveway, completing baths and haircuts curbside."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do groomers work with nervous or senior dogs?"
      },
      "a": {
        "en": "Yes, reviewers frequently note that the groomers show great patience with anxious puppies, nervous dogs, and older pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How far in advance do appointments need to be booked?"
      },
      "a": {
        "en": "Many clients report convenient scheduling and occasional next-day or short-notice availability, though advance booking is recommended."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What dog breeds do they groom?"
      },
      "a": {
        "en": "Reviewers mention grooming for diverse breeds including poodles, doodles, miniature schnauzers, golden retrievers, and dachshunds."
      },
      "basis": "reviews"
    }
  ],
