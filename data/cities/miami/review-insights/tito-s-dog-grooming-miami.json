  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Friendly and attentive mobile groomers"
      },
      "text": {
        "en": "Pet owners overwhelmingly praise the mobile grooming team for their punctuality, warmth, and professionalism. Specific groomers including Jonathan, Eduardo, Armando, Daniel, and Maribel receive frequent accolades for their courteous communication and dedication. While one reviewer reported reckless driving by a company van, clients almost unanimously describe the staff as reliable and caring."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Gentle handling of anxious pets"
      },
      "text": {
        "en": "Many reviews emphasize the staff's gentle approach toward nervous, sensitive, or senior animals. Pet parents frequently note that groomers take time to comfort anxious dogs, successfully handling large breeds and fragile older pets without causing distress. Aside from a rare report of a dog feeling stressed after styling, owners appreciate that pets return calm, happy, and relaxed."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Consistently clean and fragrant grooming"
      },
      "text": {
        "en": "Clients consistently express satisfaction with the styling results, noting that their dogs and cats come back looking clean, fluffy, and smelling wonderful. Reviewers highlight thorough deshedding, tidy face trimming, nail clipping, and ear cleaning. With the exception of a single critique regarding haircut styling, most customers consider the finished appearance to be excellent."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do groomers handle anxious or nervous dogs?"
      },
      "a": {
        "en": "Reviewers report that groomers take extra time to calm nervous pets, working gently with both anxious rescues and senior dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Tito's Dog Grooming groom cats as well?"
      },
      "a": {
        "en": "Yes, client reviews and service descriptions confirm that mobile groomers provide bathing and gentle grooming for cats."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How are mobile grooming appointments coordinated?"
      },
      "a": {
        "en": "Clients note that scheduling is handled smoothly via text messaging, with groomers arriving directly at the client's residence."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are progress updates provided during grooming?"
      },
      "a": {
        "en": "Several owners mention that groomers send progress photos and text updates during appointments to reassure pet parents."
      },
      "basis": "reviews"
    }
  ],
