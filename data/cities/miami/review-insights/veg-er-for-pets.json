  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 111,
      "title": {
        "en": "Compassionate 24/7 emergency medical team"
      },
      "text": {
        "en": "Reviewers frequently applaud doctors like Dr. Brannon, Dr. Alvarez, and Dr. Reyes alongside emergency nurses for their exceptional empathy and quick action during stressful visits. Clients appreciate staff who listen carefully and comfort families, though a few visitors noted inconsistent bedside manner."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 57,
      "title": {
        "en": "Swift stabilization during critical trauma"
      },
      "text": {
        "en": "Pet owners describe life-saving emergency care for toxic ingestions, sudden seizures, respiratory distress, and severe trauma. Many reviews note that rapid diagnostic testing and emergency treatments quickly stabilized pets in danger, though several owners faced heartbreaking losses during acute crises."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "en": "Tender handling in open hospital setting"
      },
      "text": {
        "en": "Clients consistently praise how warmly animals are treated, noting that the open-concept hospital allows pet parents to stay right beside their pets during exams and treatment. Owners report that nervous dogs, injured cats, and even avian patients receive gentle, soothing attention from triage to discharge."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners stay with their pets during treatment?"
      },
      "a": {
        "en": "Yes, reviewers frequently mention VEG's open-concept emergency floor where owners can stay alongside their pets throughout examinations and procedures."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is an appointment required for emergency visits?"
      },
      "a": {
        "en": "No, the hospital operates on a walk-in basis 24 hours a day, 365 days a year for urgent pet medical emergencies."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the hospital treat exotic pets?"
      },
      "a": {
        "en": "Yes, reviews mention that the emergency medical team cares for dogs, cats, and exotic animals including birds."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How transparent is pricing for emergency care?"
      },
      "a": {
        "en": "Many clients appreciate upfront estimates and transparent cost discussions before treatments or diagnostic tests proceed."
      },
      "basis": "reviews"
    }
  ],
