    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 74,
      "title": {
        "en": "Attentive clinical team and bilingual support"
      },
      "text": {
        "en": "Clients frequently praise the veterinarians and veterinary assistants for their warm bedside manner, thorough explanations, and compassionate care during wellness exams and routine visits. However, two reviewers expressed frustration over perceived insensitivity and unaddressed concerns during critical situations."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Spotless facilities and welcoming atmosphere"
      },
      "text": {
        "en": "Pet owners consistently comment on the modern, exceptionally clean, and organized clinical environment, highlighting comfortable exam rooms and calm waiting spaces. Many reviewers describe the clinic as an orderly setting where both dogs and cats feel at ease throughout appointments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Affectionate handling of pets"
      },
      "text": {
        "en": "Reviewers frequently highlight the gentle, loving approach shown to puppies, adult dogs, and cats during examinations, vaccinations, and nail trims. Clients appreciate that staff take time to soothe nervous animals, though one owner reported a tragic complication following anesthesia."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What routine services are provided at Dollys Animal Clinic?"
      },
      "a": {
        "en": "The clinic offers routine wellness exams, vaccinations, blood tests, dental cleanings, and surgical consultations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the clinic environment suitable for nervous pets?"
      },
      "a": {
        "en": "Yes, reviewers frequently describe calm exam rooms and gentle staff who help keep dogs and cats relaxed."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are services offered in English and Spanish?"
      },
      "a": {
        "en": "Yes, clients note that bilingual staff communicate comfortably in both English and Spanish."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where is Dollys Animal Clinic located?"
      },
      "a": {
        "en": "The clinic is located on SW 142nd Avenue in Miami."
      },
      "basis": "website"
    }
