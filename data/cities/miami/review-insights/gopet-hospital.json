  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 57,
      "title": {
        "en": "Compassionate clinical and front-desk team"
      },
      "text": {
        "en": "Most pet owners express deep gratitude for Dr. Eric Gutierrez and assistants like Gina and Brenda, praising their warm bedside manner, honesty, and dedication. Clients feel like family and trust the practice for years. However, several critical reviewers report dissatisfaction with newer staff, mentioning rude front-desk interactions and difficult communication."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Gentle and loving pet handling"
      },
      "text": {
        "en": "Reviewers frequently praise the clinic's patient, affectionate handling of dogs and cats, especially senior animals, stubborn breeds, and nervous pets. Multiple clients describe Dr. Gutierrez as having an intuitive bond with animals, treating each patient with genuine tenderness. Pet parents appreciate that their animals remain relaxed during visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "en": "Accurate diagnostics and effective treatments"
      },
      "text": {
        "en": "Clients consistently commend the practice for reliable medical outcomes, from complex wound healing and fracture repair to correctly diagnosing pancreatitis and chronic conditions when other clinics failed. While one reviewer experienced a tragic outcome during senior cardiac treatment, most owners credit the clinic with saving or extending their pets' lives."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do veterinarians handle anxious or senior pets?"
      },
      "a": {
        "en": "Reviewers note that the veterinary team is gentle and experienced with senior pets, cats, and anxious dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are diagnostic and surgical procedures available on site?"
      },
      "a": {
        "en": "Yes, the hospital provides digital radiology, endoscopy, soft-tissue surgeries, and advanced diagnostic lab testing."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can clients request detailed estimates before treatment?"
      },
      "a": {
        "en": "Yes, the clinic prepares treatment estimates, though pet owners recommend reviewing requested tests in advance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic treat complex chronic health conditions?"
      },
      "a": {
        "en": "Pet owners report successful ongoing treatment for chronic pancreatitis, severe allergies, and orthopedic injuries."
      },
      "basis": "reviews"
    }
  ],
