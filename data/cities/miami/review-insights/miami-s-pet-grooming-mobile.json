  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "en": "Beloved mobile groomers and individualized attention"
      },
      "text": {
        "en": "A large majority of reviewers passionately praise individual mobile groomers, particularly Jose F., Yusleidy, Danny, and Marcos. Pet parents commend their warmth, patience with senior dogs, and punctual doorstep arrivals. Nonetheless, isolated complaints cite poor management response and unprofessionalism when incidents occur."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Comforting approach for anxious pets"
      },
      "text": {
        "en": "Most dog owners highlight that pets feel calm, relaxed, and happy during home grooming sessions, praising groomers for gentle handling and soothing nervous rescues. However, several critical reviews recount alarming incidents involving clipper injuries or corneal eye irritation from shampoo products."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 29,
      "title": {
        "en": "Flawless styling alongside safety concerns"
      },
      "text": {
        "en": "Many clients are thrilled with the aesthetic results, praising fresh haircuts, fragrant coats, and thorough teeth brushing. Conversely, multiple severe complaints point to cut ears, suspected missing baths masked with heavy cologne, and corneal burns requiring emergency veterinary treatment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the mobile grooming service work?"
      },
      "a": {
        "en": "Groomers bring fully equipped mobile vans directly to clients' homes to provide baths, haircuts, nail trimming, and ear cleaning curbside."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can I request a specific mobile groomer?"
      },
      "a": {
        "en": "Yes, many reviewers mention repeatedly booking trusted groomers such as Jose F. or Yusleidy for consistent care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are the groomers experienced with nervous or senior dogs?"
      },
      "a": {
        "en": "Yes, pet parents report that seasoned groomers handle anxious, timid, and elderly dogs with gentle patience."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What safety concerns have been raised by clients?"
      },
      "a": {
        "en": "A few reviewers reported physical cuts or shampoo-related eye irritation, advising owners to inspect their pets thoroughly after each session."
      },
      "basis": "reviews"
    }
  ],
