  "observed_at": "2026-10-10",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 53,
      "title": {
        "en": "Punctual and courteous mobile groomers"
      },
      "text": {
        "en": "A wide majority of pet owners praise the groomers and customer service at Nadia Mobile Grooming for their prompt arrivals, friendly demeanor, and helpful styling advice. Clients regularly mention staff members like Leo and Carlos for their reliable service right at the doorstep. A small number of reviewers noted frustration with turnover or communication when addressing complaints."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "en": "Fresh styling and coat care"
      },
      "text": {
        "en": "Reviewers frequently praise the quality of bathing, haircut styling, nail trimming, and deshedding treatments. Many owners remark that their dogs look neatly groomed, feel soft, and smell pleasant for days after their appointments. Occasional dissatisfied customers noted uneven trimming or haircuts that ended up shorter than requested."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "en": "Calm handling in mobile van"
      },
      "text": {
        "en": "Pet parents emphasize how gently the groomers handle nervous, senior, or anxious animals inside the mobile unit. Multiple reviews describe dogs who normally struggle with grooming feeling relaxed and happy throughout the visit. While a few clients noted minor nicks during squirming, the overall feedback highlights affectionate, attentive pet care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Nadia Mobile Grooming provide services directly at the customer's home?"
      },
      "a": {
        "en": "Yes, fully equipped mobile grooming vans provide bathing, haircutting, and styling directly at the client's residence across Miami."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do groomers handle anxious or senior dogs?"
      },
      "a": {
        "en": "Reviewers report that the mobile groomers take time to calm nervous pets and handle senior dogs with patience and care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners request specific styling preferences for their pets?"
      },
      "a": {
        "en": "Yes, clients can specify cut lengths and styling preferences, though pet owners recommend clearly confirming instructions with the groomer before the session starts."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What additional grooming treatments are provided during visits?"
      },
      "a": {
        "en": "The service includes ear cleaning, teeth brushing, deshedding treatments, nail clipping, and decorative bandanas."
      },
      "basis": "both"
    }
  ],
