  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 106,
      "title": {
        "en": "Attentive emergency veterinary care team"
      },
      "text": {
        "en": "The vast majority of pet owners praise the doctors, technicians, and front desk staff at this Pinecrest clinic for their warmth, empathy, and calming bedside manner. Reviewers highlight practitioners for reassuring nervous pet parents during late-night visits. While a few clients felt communication was lacking regarding wait times, most commend the team for dedicated care."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "en": "Gentle handling for distressed pets"
      },
      "text": {
        "en": "Pet owners consistently note how gently veterinarians and assistants handle anxious, injured, or frightened animals. Reviewers describe team members offering treats, soothing trembling dogs, and treating sick companions with genuine affection. A couple of reviewers felt their pets received hurried attention, but the overwhelming consensus highlights loving care."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "en": "Reliable diagnostics and urgent treatments"
      },
      "text": {
        "en": "Clients report dependable outcomes for acute conditions, including swift pain relief, thorough digital imaging, wound repairs, and effective stabilizing therapy for sudden poisoning or respiratory distress. Many pet owners credit the hospital with saving their pets during critical hours. A small fraction of clients wished for more cost-effective testing paths."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is My Pet Hospital open for late-night pet emergencies?"
      },
      "a": {
        "en": "Yes, the facility operates during evening hours on weekdays and all day on weekends to treat acute veterinary emergencies in Pinecrest."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do they accommodate emergency walk-in arrivals?"
      },
      "a": {
        "en": "Yes, walk-ins are accepted for urgent conditions, though reviewers advise that triage prioritizes the most critical cases first."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can the hospital perform urgent diagnostic imaging and blood testing?"
      },
      "a": {
        "en": "Yes, in-house laboratory testing and diagnostic digital radiography are available on-site for immediate medical evaluation."
      },
      "basis": "website"
    }
  ],
