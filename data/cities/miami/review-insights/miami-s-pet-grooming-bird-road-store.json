  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "en": "Loving attention from devoted stylists"
      },
      "text": {
        "en": "Reviewers repeatedly praise Annie and her team for their genuine warmth, kindness, and attentive dedication to every visiting pet. Long-time customers emphasize that the groomers greet pets by name and maintain a welcoming, dependable atmosphere that inspires lasting loyalty."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Warm environment keeping pets comfortable"
      },
      "text": {
        "en": "Clients emphasize that their pets enter the salon eagerly without trembling or fear, with several dogs acting as comfortably as if they were at home. Owners of toy poodles and anxious rescues especially appreciate the gentle handling that keeps their animals calm during bathing."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Consistently clean and fragrant grooming"
      },
      "text": {
        "en": "Customers highlight thorough bathing, neat nail clippings, and attractive breed-appropriate haircuts that leave dogs and cats looking handsome and smelling fresh. While nearly all feedback is glowing, one reviewer felt their pet was rushed through a full service."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Miami's Pet Grooming service both cats and dogs?"
      },
      "a": {
        "en": "Yes, clients bring both large cats and various dog breeds, noting that the groomers produce excellent results for felines as well."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are same-day grooming appointments possible?"
      },
      "a": {
        "en": "Pet owners mention that the salon accommodates same-day scheduling requests when schedule availability allows."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do pets react to returning to the salon?"
      },
      "a": {
        "en": "Multiple reviewers report that their pets run inside willingly and show excitement rather than stress when arriving for grooming."
      },
      "basis": "reviews"
    }
  ],
