  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 96,
      "title": {
        "en": "Attentive and punctual mobile team"
      },
      "text": {
        "en": "Reviewers routinely praise individual groomers including Yasiel, Barbara, Javier, Gabriel, and Milena for their polite communication and dedication. Pet parents appreciate that groomers arrive on schedule, listen carefully to specific styling instructions, and maintain an upbeat attitude throughout the appointment."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 74,
      "title": {
        "en": "Neat haircuts and deep cleaning"
      },
      "text": {
        "en": "Clients consistently report excellent grooming results, noting fresh scents, soft coats, and precise breed-standard haircuts. Dog owners particularly appreciate the thorough dental hygiene brushing, tidy paw and ear cleaning, and careful nail trims, noting that their pets look polished and happy when stepping out of the van."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "en": "Calm and loving pet handling"
      },
      "text": {
        "en": "Pet owners frequently mention how patiently and gently groomers interact with their pets. Many reviews highlight that anxious, senior, or energetic dogs feel comfortable and calm in the groomer's hands, making the home mobile grooming visit completely stress-free for both pets and their owners."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do the mobile grooming vans come directly to the client's home?"
      },
      "a": {
        "en": "Yes, reviewers confirm that fully equipped mobile vans arrive right at their residence for doorstep grooming."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do they offer teeth cleaning services during the grooming visit?"
      },
      "a": {
        "en": "Yes, clients frequently praise the deep dental brushing and teeth cleaning included during their appointments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can anxious or nervous dogs be accommodated comfortably?"
      },
      "a": {
        "en": "Yes, dog owners note that groomers demonstrate great patience and gentle care with nervous and senior pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are the groomers receptive to specific styling instructions?"
      },
      "a": {
        "en": "Reviewers emphasize that groomers follow custom haircut and styling preferences accurately."
      },
      "basis": "reviews"
    }
  ],
