      "mentions": 39,
      "title": {
        "en": "Attentive groomers and friendly boutique team"
      },
      "text": {
        "en": "Pet owners consistently praise groomer Aylen, JJ, and the retail team for their warm welcome and gentle customer care. Clients report that the staff listens closely to styling preferences and treats every visiting dog with patience, warmth, and genuine enthusiasm."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Neat coat styling and thorough grooming"
      },
      "text": {
        "en": "Reviewers report that dogs leave the salon looking tidy, smelling clean, and beautifully groomed. Clients praise full haircut transformations, deshedding treatments, and careful nail trims, noting that styling matches breed standards and owner requests accurately."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Patient care for sensitive rescue dogs"
      },
      "text": {
        "en": "Clients frequently highlight how gentle and patient the groomers are with nervous, shy, or rescue pets. Several reviewers note that dogs that normally dislike grooming remain calm and relaxed throughout baths and haircuts. Pet owners appreciate the calm and nurturing approach that puts sensitive dogs at ease."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What grooming services are offered at the Key Biscayne location?"
      },
      "a": {
        "en": "Clients report full grooming packages, baths, nail trimming, teeth brushing, and ear cleaning for various dog breeds."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the team handle shy or nervous dogs?"
      },
      "a": {
        "en": "Reviewers note that groomers are gentle and patient, taking extra time to help anxious or rescue dogs feel calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are baked treats and pet supplies sold in the shop?"
      },
      "a": {
        "en": "Yes, clients praise the curated selection of gourmet dog bakery items, chews, toys, and premium pet foods available in store."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is advance appointment booking recommended for grooming?"
      },
      "a": {
        "en": "Yes, pet owners mention booking grooming sessions ahead of time, especially for full haircuts and weekend time slots."
      },
      "basis": "both"
    }
