  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 73,
      "title": {
        "en": "Knowledgeable and compassionate clinic staff"
      },
      "text": {
        "en": "Clients consistently commend veterinarians like Dr. Javid and team members like Eva for their attentive bedside manner and professional competence. Pet owners appreciate the warm, patient atmosphere during appointments, though several reviewers noted difficult experiences with front desk responsiveness or individual doctors."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 61,
      "title": {
        "en": "Attentive care for household pets"
      },
      "text": {
        "en": "Reviewers frequently praise the clinic for gentle handling of pets across various breeds and ages, including cats, puppies, huskies, and shiba inus. Owners note that the medical staff treats animals with genuine care, helping pets feel at ease during routine exams, vaccinations, and diagnostic testing."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Prompt treatment and emergency care"
      },
      "text": {
        "en": "Many pet parents report positive clinical results when bringing in sick pets or managing urgent issues, including ear infections and sudden illnesses. Clients value the rapid diagnoses and effective treatments, though a small number of reviewers reported dissatisfied outcomes during critical pet emergencies."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic accommodate emergency and walk-in visits?"
      },
      "a": {
        "en": "Yes, reviewers frequently mention that the clinic handles walk-ins and urgent medical situations promptly, including on Sundays."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients describe the veterinary staff's approach?"
      },
      "a": {
        "en": "Pet owners describe doctors and veterinary technicians as knowledgeable, gentle with anxious pets, and thorough in explaining treatments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are diagnostic testing and medical treatments performed on site?"
      },
      "a": {
        "en": "Yes, clients note that the clinic provides on-site diagnostic exams, vaccinations, prescription medications, and surgical treatments."
      },
      "basis": "reviews"
    }
  ],
