  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 53,
      "title": {
        "en": "Attentive doctors and caring veterinary staff"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinary doctors and technicians for their thoroughness, patience, and warmth during examinations. Clients frequently highlight Dr. Weir, Dr. Lantigua, and the nursing assistants for explaining diagnoses in detail and treating animals with genuine kindness. Longtime clients often note feeling welcomed like family during every clinic visit."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Clean clinic with updated hospital facility"
      },
      "text": {
        "en": "Reviewers frequently describe the clinic as spotless, welcoming, and well organized. Many clients specifically appreciate the updated hospital facility located along South Dixie Highway, pointing out comfortable waiting areas and clean examination rooms. Several pet parents emphasize that the calm environment helps reduce stress for both dogs and cats."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Gentle handling for anxious pets"
      },
      "text": {
        "en": "Clients frequently point out how gentle and patient the veterinary team is when handling sensitive or nervous animals. Multiple reviews note that cats and dogs remain calm during vaccinations, blood draws, and routine wellness checkups. Pet owners appreciate that doctors and technicians take extra time to keep anxious pets comfortable throughout the entire visit."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do veterinarians at South Kendall Animal Hospital explain treatment options clearly?"
      },
      "a": {
        "en": "Yes, clients frequently note that doctors take time to walk through diagnostic findings and discuss treatment plans thoroughly."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the clinic equipped to handle routine exams and surgeries?"
      },
      "a": {
        "en": "Yes, pet owners report comprehensive care ranging from wellness vaccinations to dental cleanings and soft-tissue surgeries."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can owners request same-day or urgent appointments?"
      },
      "a": {
        "en": "Several reviewers mention that the staff accommodated urgent prescription needs and same-day appointments when their pets were unwell."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital provide international travel health certificates?"
      },
      "a": {
        "en": "Yes, clients report that the clinic is USDA-accredited to issue international pet health certificates for travel."
      },
      "basis": "reviews"
    }
  ],
