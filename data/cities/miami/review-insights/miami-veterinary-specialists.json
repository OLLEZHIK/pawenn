  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Skilled specialists and emergency team"
      },
      "text": {
        "en": "Most pet owners express sincere appreciation for the veterinary surgeons, oncologists, and intensive care nurses at Miami Veterinary Specialists. Practitioners receive praise for saving critically ill animals and demonstrating empathy during stressful emergencies. Conversely, several clients criticized front desk interactions or felt clinicians appeared rushed."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Gentle treatment during critical illness"
      },
      "text": {
        "en": "Clients frequently note the careful, gentle attention given to pets in distress, including dogs with traumatic injuries and cats undergoing advanced oncology treatment. Reviewers mention that hospital technicians comfort frightened pets during overnight stays and intensive care monitoring. Many pet parents felt their companions received compassionate attention."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 27,
      "title": {
        "en": "Advanced interventions alongside mixed outcomes"
      },
      "text": {
        "en": "Reviewers report high clinical expertise for complex surgeries, oncology care, and emergency diagnostics like MRI imaging, with many crediting the hospital for saving their pets' lives. At the same time, a subset of pet parents reported heartbreaking outcomes or felt that treatments did not yield the promised prognosis, highlighting varied patient experiences."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is the emergency room open 24 hours every day?"
      },
      "a": {
        "en": "Yes, the hospital operates a dedicated emergency room and critical care unit that is open 24 hours a day, 7 days a week."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What specialty medical services are offered?"
      },
      "a": {
        "en": "The facility provides board-certified veterinary surgery, oncology, internal medicine, advanced neurology, and on-site MRI diagnostics."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients describe emergency wait times?"
      },
      "a": {
        "en": "Reviewers note that critically unstable patients are triaged immediately, but non-life-threatening emergencies can experience several hours of waiting."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What should pet owners know regarding payment and estimates?"
      },
      "a": {
        "en": "Clients report that the hospital requires upfront deposits for emergency admissions and specialized diagnostic procedures."
      },
      "basis": "reviews"
    }
  ],
