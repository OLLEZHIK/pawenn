  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "en": "Caring veterinary doctors and dedicated technicians"
      },
      "text": {
        "en": "Reviewers frequently praise Dr. Marian De La Rosa along with veterinary technicians Anthony and Emily for their welcoming attitude and medical thoroughness. Pet owners appreciate that the clinical team takes time to listen to concerns and explain diagnoses clearly. A small number of negative reviews mention isolated interpersonal friction and staffing changes over recent months."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Gentle handling for anxious companion pets"
      },
      "text": {
        "en": "Pet parents emphasize how gently the clinic staff interacts with their dogs and cats, particularly animals that experience intense clinic anxiety. Clients highlight patient techniques during blood draws, nail trimmings, and routine hygiene exams. Reviewers consistently note that technicians soothe nervous pets and make them feel safe and comfortable during visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Effective treatment plans and wellness recovery"
      },
      "text": {
        "en": "Reviews reflect dependable clinical outcomes across a wide spectrum of care, including dental cleanings, neutering procedures, and managing chronic ailments in senior animals. Clients value prompt attention during emergency visits and thoughtful treatment adjustments that resolve illnesses. One reviewer reported dissatisfaction regarding a delayed diagnostic assessment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the team handle anxious or nervous pets?"
      },
      "a": {
        "en": "Clients frequently note that veterinary technicians use calm, patient techniques to keep fearful dogs and cats comfortable during examinations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are emergency or same-day visits accommodated?"
      },
      "a": {
        "en": "Yes, pet owners report that the clinic accommodates urgent situations and fits patients in during emergencies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What types of routine procedures are performed?"
      },
      "a": {
        "en": "Reviewers describe successful routine visits for vaccinations, dental cleanings, nail trims, bloodwork, and neutering procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are transparent estimates provided before procedures?"
      },
      "a": {
        "en": "Most clients report straightforward treatment plans without unexpected fees, though owners recommend confirming procedural timelines in advance."
      },
      "basis": "reviews"
    }
