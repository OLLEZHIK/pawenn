  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 50,
      "title": {
        "en": "Compassionate doctors alongside staff complaints"
      },
      "text": {
        "en": "Reviewers share contrasting views regarding the veterinary staff. Many clients express gratitude toward veterinarians and nurses who provided attentive, lifesaving care during late-night emergencies. At the same time, numerous pet owners describe cold interactions, unhelpful front desk communication, and a perception that some staff lacked empathy during critical moments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 32,
      "title": {
        "en": "Critical emergency care with handling concerns"
      },
      "text": {
        "en": "Pet owners frequently discuss how their animals were handled during urgent hospital visits. Positive reviews note gentle stabilization and thoughtful bedside manner when pets arrived in distress. Conversely, critical feedback mentions rough handling, elevated pet anxiety during procedures, and frustration over long periods pets spent separated from their owners."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 26,
      "title": {
        "en": "Lifesaving outcomes alongside treatment frustrations"
      },
      "text": {
        "en": "Clinical outcomes receive varied reactions from clients. Several pet parents credit the hospital with successfully treating acute trauma, toxic ingestions, and surgical complications. However, other reviewers recount persistent symptoms, misdiagnoses, missed staples, and post-treatment infections, leaving some clients dissatisfied with the clinical results."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is the hospital open 24/7 for veterinary emergencies?"
      },
      "a": {
        "en": "Yes, clients frequently mention visiting at night or during holidays for emergency veterinary triage and critical care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What should pet owners expect regarding wait times?"
      },
      "a": {
        "en": "Wait times can be lengthy, with multiple reviewers reporting waits exceeding two hours depending on triage severity."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are detailed treatment cost estimates provided?"
      },
      "a": {
        "en": "Reviewers report that quotes are provided before procedures, though several pet parents note high overall emergency treatment costs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can emergency surgery be performed on site?"
      },
      "a": {
        "en": "Yes, pet owners mention emergency surgical procedures and stabilization performed for acute conditions."
      },
      "basis": "reviews"
    }
