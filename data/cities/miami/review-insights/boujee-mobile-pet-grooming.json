  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 101,
      "title": {
        "en": "Attentive groomers with mixed experiences"
      },
      "text": {
        "en": "A large majority of pet owners praise groomers like Dorian and Maria for their polite and friendly manner. Clients appreciate that staff are usually accommodating and attentive when handling mobile appointments. However, a few negative reviews mention instances of discourteous or unhelpful communication from specific groomers."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 66,
      "title": {
        "en": "Fresh styling alongside clipping complaints"
      },
      "text": {
        "en": "Most customers are pleased with their pets' haircuts, noting clean styling, soft fur, and pleasant post-grooming scents. Conversely, several dissatisfied clients reported uneven trims, issues with double-coated dogs being shaved too close, or minor skin irritation and clipper cuts that required veterinary attention."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 52,
      "title": {
        "en": "Caring handling for most pets"
      },
      "text": {
        "en": "Numerous pet parents note that groomers treat their dogs with patience and affection, helping them remain relaxed throughout the session. Nevertheless, a couple of reviewers felt their dogs were unusually distressed or stressed following their appointment, emphasizing the need for gentle handling."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Boujee Mobile Pet Grooming offer home visits across Miami-Dade?"
      },
      "a": {
        "en": "Yes, clients confirm that mobile vans travel directly to residential addresses for doorstep pet grooming."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can I request specific styling preferences or coat lengths?"
      },
      "a": {
        "en": "Yes, pet owners can specify haircut styles, though reviewers recommend discussing instructions clearly for double-coated breeds."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How long does a typical mobile grooming session take?"
      },
      "a": {
        "en": "While most visits are completed promptly, some reviewers note that sessions can take several hours depending on traffic and coat condition."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are there additional charges for matted coats?"
      },
      "a": {
        "en": "Reviewers note that dematting or severe knots can incur extra fees beyond the initial quoted rate."
      },
      "basis": "reviews"
    }
  ],
