    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Compassionate and thorough veterinary team"
      },
      "text": {
        "en": "Reviewers across the board praise the doctors and technicians for their empathy, warmth, and thorough bedside manner. Clients specifically mention Dr. Hew and Dr. Rose for taking ample time during exams, answering every question without rushing, and making owners feel heard. The support staff and front desk are repeatedly commended for welcoming service."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Loving care across life stages"
      },
      "text": {
        "en": "Pet owners emphasize that the staff genuinely loves animals and handles them with remarkable tenderness. Feedback highlights gentle care for young puppies during initial vaccinations as well as attentive, comfortable treatment for geriatric dogs and sick cats. Many reviewers note that even anxious pets feel relaxed in the clinic's calm environment."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "en": "Reliable diagnoses and successful treatments"
      },
      "text": {
        "en": "Clients frequently credit the hospital with accurate medical assessments and effective clinical solutions. Reviewers share success stories ranging from routine wellness and senior checkups to tumor removals and life-saving urgent care for sick cats. Pet parents express strong confidence in the medical expertise and follow-through of the veterinary team."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the team handle new puppy examinations?"
      },
      "a": {
        "en": "Reviewers note that the veterinarians walk new puppy owners through care routines thoroughly in a relaxed, low-stress environment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are the veterinarians experienced with senior pets?"
      },
      "a": {
        "en": "Yes, numerous long-term clients highlight dedicated geriatric care, tumor removals, and routine management for elderly dogs and cats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic follow up on pet recovery after visits?"
      },
      "a": {
        "en": "Yes, clients mention that staff members call owners multiple times following appointments to check on their pet's health progress."
      },
      "basis": "reviews"
    }
