  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "en": "Attentive veterinarians and dedicated staff"
      },
      "text": {
        "en": "Reviewers overwhelmingly praise Dr. Joanne Medina, Dr. Randy Dominguez, practice manager Monika, and Jonathan at reception for their kindness and professionalism. Clients describe the team as welcoming, patient with questions, and genuinely invested in each patient's well-being. One client reported dissatisfaction following an inconclusive diagnostic visit, but the vast majority of owners feel completely supported."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Gentle and compassionate animal handling"
      },
      "text": {
        "en": "Pet owners frequently mention how gently dogs and cats are treated during examinations, checkups, and post-operative recovery. Reviewers appreciate that the clinical team keeps puppies and senior animals calm, offering affection and treats throughout visits. Many long-time clients note that even nervous pets feel secure and comfortable coming into the hospital."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 10,
      "title": {
        "en": "Successful surgical outcomes and recoveries"
      },
      "text": {
        "en": "Clients frequently highlight exceptional outcomes following complex orthopedic surgeries, dental procedures, and emergency interventions. Pet owners share successful recoveries after TPLO operations, fracture repairs, and foreign body removals, noting that their animals regained full mobility. While one owner raised concerns over an initial fecal test, most report excellent clinical recovery."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What surgical procedures does Westchester Animal Hospital perform?"
      },
      "a": {
        "en": "The hospital specializes in orthopedic procedures such as TPLO, fracture repairs, soft tissue operations, and emergency surgeries."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the team keep pet owners informed after surgery?"
      },
      "a": {
        "en": "Reviewers note that veterinarians and the practice manager provide detailed updates, post-op instructions, and check-in texts throughout recovery."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic accommodate emergency cases?"
      },
      "a": {
        "en": "Yes, clients report that the hospital takes in urgent and emergency cases promptly, providing immediate stabilization and surgical care."
      },
      "basis": "both"
    }
  ],
