      "a": {
        "nl": "Ja, het team stuurt tijdens de opvangperiode regelmatig persoonlijke foto- en video-updates.",
        "en": "Yes, staff members send regular personalised photo and video check-ins throughout the boarding period."
      },
      "basis": "reviews"
    },
