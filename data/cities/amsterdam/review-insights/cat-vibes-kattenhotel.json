  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "nl": "Hartelijke en deskundige verzorging door het team",
        "en": "Warm and knowledgeable care by the team"
      },
      "text": {
        "nl": "Eigenaren zijn unaniem enthousiast over de gastvrijheid van beheerster Lana en haar attente medewerkers. Katten krijgen volop individuele aandacht, knuffels en liefdevolle toewijding tijdens hun verblijf. Baasjes laten hun katten met een gerust hart achter gedurende vakanties of verhuizingen.",
        "en": "Pet owners express unanimous appreciation for host Lana and her conscientious team members. Cats receive generous individual affection, cuddles, and loving dedication throughout their boarding stay. Families leave their felines behind with complete reassurance during trips or relocations."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "nl": "Regelmatige updates met leuke foto's en video's",
        "en": "Regular updates featuring photos and videos"
      },
      "text": {
        "nl": "Klanten zijn bijzonder te spreken over de transparante en vlotte communicatie tijdens de opvangperiode. Het hotel deelt dagelijks duidelijke foto's en video's via WhatsApp, waardoor eigenaren precies zien hoe hun kat zich vermaakt. Deze constante updates worden als heel fijn ervaren.",
        "en": "Clients are exceptionally impressed with the responsive communication maintained throughout the cat boarding period. The hotel frequently sends clear photo and video updates via messaging, allowing owners to follow their pets' activities. This constant contact provides tremendous peace of mind."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "nl": "Ruime, schone kamers met volop klimgelegenheid",
        "en": "Spacious, clean suites with climbing structures"
      },
      "text": {
        "nl": "Bezoekers roemen de hygiënische, comfortabele en veilige inrichting van de kattenverblijven. De kamers zijn uitgerust met krabpalen, ligmandjes en speelelementen, en beschikken over webcams waarmee eigenaren kunnen meekijken. De huiselijke sfeer zorgt voor een ontspannen vakantieverblijf.",
        "en": "Visitors admire the hygienic, cosy, and secure configuration of the cat hotel rooms. Each suite is furnished with scratching towers, sleeping nooks, and toys, and features integrated webcams for remote viewing. The domestic atmosphere fosters a deeply relaxing boarding stay for every guest."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "nl": "Kunnen eigenaren via webcams meekijken naar hun kat?",
        "en": "Can pet owners monitor their cat via live webcams?"
      },
      "a": {
        "nl": "Ja, de kamers zijn voorzien van camera's waarmee baasjes tijdens het verblijf live kunnen inloggen.",
        "en": "Yes, suites are equipped with individual cameras allowing owners to log in and observe their cat live."
      },
      "basis": "both"
    },
    {
      "q": {
        "nl": "Krijgen eigenaren tussentijdse updates met foto's en filmpjes?",
        "en": "Do owners receive updates with photos and video clips?"
