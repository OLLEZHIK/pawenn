  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "nl": "Hartelijk ontvangst en professioneel trimsalonteam",
        "en": "Warm hospitality and professional salon staff"
      },
      "text": {
        "nl": "Het salonpersoneel wordt door het overgrote deel van de bezoekers geprezen om de warme gastvrijheid, vlotte communicatie en professionele houding. Klanten waarderen dat medewerkers goed luisteren naar specifieke stylingwensen. Enkele recensenten noemen echter incidentele misverstanden over wensen en extra kosten, al blijft het team zeer geliefd.",
        "en": "The salon staff is praised by the vast majority of visitors for their warm hospitality, prompt communication, and professional attitude. Customers appreciate that groomers listen attentively to individual styling requests. An occasional reviewer reported miscommunication regarding extra charges, though overall appreciation remains very high."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "nl": "Uitzonderlijke styling en grondige gebitsverzorging",
        "en": "Exceptional styling and thorough dental care"
      },
      "text": {
        "nl": "Baasjes zijn buitengewoon tevreden over het uiterlijk van hun viervoeters na afloop van de trim- en spabehandelingen. Honden verlaten de zaak prachtig geknipt, heerlijk ruikend en met een fluweelzachte vacht. Naast vachtverzorging krijgt ook de diepe gebitsreiniging veel lof, hoewel een enkele klant het knipwerk soms korter vond dan verwacht.",
        "en": "Pet owners are exceptionally pleased with their companions' appearance following grooming and spa treatments. Dogs leave looking beautifully trimmed, smelling delightful, and featuring silky soft coats. Alongside hair styling, ultrasonic dental cleanings receive strong praise, though isolated reviews noted cuts slightly shorter than intended."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "nl": "Liefdevolle verzorging van angstige huisdieren",
        "en": "Gentle handling for nervous pet patients"
      },
      "text": {
        "nl": "De salon staat bekend om haar geduldige en respectvolle benadering van puppy's, asieldieren en nerveuze viervoeters. Veel honden die elders gestrest raakten, voelen zich bij GlamourPets snel op hun gemak en worden enthousiast bij aankomst. Op een zeldzaam gemeld knipincident na, vertrouwen eigenaren de veilige verzorging van hun dieren volledig.",
        "en": "The salon is renowned for its patient, respectful handling of puppies, rescue dogs, and anxious companions. Many dogs previously stressed by grooming feel comfortable here and eagerly recognize the shop upon arrival. Aside from a rare isolated trimming mishap, owners thoroughly trust the gentle, loving environment provided for their pets."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "nl": "Welke verzorgingsdiensten biedt GlamourPets aan in Amsterdam?",
        "en": "Which grooming services does GlamourPets provide in Amsterdam?"
      },
      "a": {
        "nl": "De salon biedt complete trimbeurten, was- en blaassessies, spabaden en diepe ultrasone gebitsreinigingen.",
        "en": "The salon offers complete haircutting, bathing, blow-drying, spa treatments, and deep dental cleanings."
      },
      "basis": "website"
    },
    {
      "q": {
        "nl": "Kunnen nerveuze of getraumatiseerde honden hier terecht?",
        "en": "Can nervous or anxious dogs be groomed at GlamourPets?"
      },
      "a": {
        "nl": "Ja, recensies bevestigen dat het team gespecialiseerd is in een geduldige en kalme aanpak voor bange viervoeters.",
        "en": "Yes, numerous reviews confirm the staff takes great care to provide a calm, reassuring visit for anxious pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "nl": "Verzorgt de trimsalon honden van verschillende rassen?",
        "en": "Does the grooming studio welcome diverse dog breeds?"
      },
      "a": {
        "nl": "Zeker, van kleine pomeranians en poedels tot grote labradoodles en golden retrievers worden vakkundig behandeld.",
        "en": "Absolutely, from small Pomeranians and poodles to large doodles and retrievers, all breeds are professionally groomed."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "nl": "Waar bevindt de trimsalon zich in Amsterdam?",
        "en": "Where is the salon situated in Amsterdam?"
      },
      "a": {
        "nl": "De salon is gevestigd aan de Pretoriusstraat 21 in de Transvaalbuurt in Amsterdam-Oost.",
        "en": "The salon is situated on Pretoriusstraat 21 in the Transvaalbuurt area of eastern Amsterdam."
      },
      "basis": "website"
    }
  ],
