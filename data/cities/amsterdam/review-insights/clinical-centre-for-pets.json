  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 59,
      "title": {
        "nl": "Toegewijd veterinair specialistenteam bij spoedzorg",
        "en": "Dedicated veterinary specialist team in emergency care"
      },
      "text": {
        "nl": "Eigenaren spreken grote waardering uit voor de deskundigheid van de specialisten en intensivisten in Amsterdam. Het team wordt geprezen om hun medische toewijding en empathie bij acute noodgevallen. Ondanks de hoge werkdruk voelen veel baasjes zich gesteund tijdens kritieke momenten.",
        "en": "Pet parents express deep appreciation for the expertise of specialists and intensive care veterinarians in Amsterdam. The medical staff is praised for clinical skill and empathy during critical moments. Despite intense emergency workloads, many families feel thoroughly supported."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 59,
      "title": {
        "nl": "Zorgvuldige bewaking en opvang van kwetsbare dieren",
        "en": "Attentive monitoring and housing for vulnerable animals"
      },
      "text": {
        "nl": "Patiënten op de intensive care en verpleegafdelingen worden continu met grote toewijding en zachtheid verzorgd. Cliënten observeren dat honden en katten professionele pijnstilling en continue monitoring ontvangen. De liefdevolle benadering van ernstig zieke dieren biedt eigenaren veel troost.",
        "en": "Patients admitted to intensive care and hospital wards are monitored continuously with great devotion and gentle handling. Clients note that sick dogs and cats receive careful pain management and monitoring. The compassionate approach toward critically ill pets offers families great comfort."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "nl": "Geavanceerde diagnostiek en levensreddende ingrepen",
        "en": "Advanced diagnostics and life-saving surgical care"
      },
      "text": {
        "nl": "Vele recensies beschrijven geslaagde operaties en accurate diagnoses dankzij apparatuur zoals CT- en MRI-scans. Dieren die elders waren opgegeven, konden door snel specialistisch ingrijpen worden gered. Dankbare baasjes zien hun huisdier na zware behandelingen weer opbloeien.",
        "en": "Numerous testimonials describe successful surgeries and precise diagnoses facilitated by equipment like on-site CT and MRI scanners. Pets facing complex prognoses elsewhere were saved through swift specialized procedures. Grateful owners see their animals recover and regain vitality."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "nl": "Is het klinisch centrum 24 uur per dag geopend voor spoed?",
        "en": "Is the clinical centre open 24 hours daily for emergencies?"
      },
      "a": {
        "nl": "Ja, de spoedkliniek en intensive care zijn dag en nacht geopend voor acute veterinaire noodhulp.",
        "en": "Yes, the emergency hospital and intensive care unit operate day and night for acute veterinary needs."
      },
      "basis": "website"
    },
    {
      "q": {
        "nl": "Wat vinden bezoekers van de tarieven voor spoedzorg?",
        "en": "What do clients report regarding the cost of emergency services?"
      },
      "a": {
        "nl": "Meerdere recensenten wijzen erop dat de kosten voor spoedconsulten en opnames aanzienlijk hoger zijn dan bij een reguliere dierenarts.",
        "en": "Multiple reviewers note that emergency consultations and hospitalizations carry significantly higher rates than general clinics."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "nl": "Beschikt de kliniek over specialistische beeldvorming zoals MRI en CT?",
        "en": "Does the clinic have advanced imaging such as MRI and CT scanners?"
      },
      "a": {
        "nl": "Ja, het centrum beschikt over geavanceerde diagnostiek waaronder MRI, CT en uitgebreide echografie.",
        "en": "Yes, the medical centre features advanced diagnostic modalities including on-site MRI, CT, and ultrasound."
      },
      "basis": "both"
    },
    {
      "q": {
        "nl": "Is een verwijzing van een eigen dierenarts noodzakelijk?",
        "en": "Is a referral from a primary veterinarian required?"
      },
      "a": {
        "nl": "Voor planbare specialistische consulten is een verwijzing gebruikelijk; bij levensbedreigende spoed kan men direct bellen en langskomen.",
        "en": "A formal referral is typical for scheduled specialist consultations; for acute life-threatening trauma, direct phone contact is advised."
      },
      "basis": "website"
    }
  ],
