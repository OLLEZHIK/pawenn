  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "nl": "Uitzonderlijk geduldige en lieve trimster",
        "en": "Exceptionally patient and caring groomer"
      },
      "text": {
        "nl": "Hondeneigenaren zijn vol lof over trimster Maika en haar vriendelijke team in de salon. Klanten prijzen haar rustige energie, oprechte liefde voor dieren en het vermogen om ook bange of beweeglijke honden direct gerust te stellen. Er wordt uitgebreid de tijd genomen voor elke hond, wat veel vertrouwen geeft.",
        "en": "Dog owners consistently praise groomer Maika and her welcoming team at the salon. Clients highlight her calming presence, genuine passion for pets, and the ability to soothe anxious or energetic dogs immediately. Ample time is dedicated to each individual canine visit, creating substantial trust among guardians."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "nl": "Prachtige knipbeurten en verzorgde vachten",
        "en": "Beautiful styling and well-groomed coats"
      },
      "text": {
        "nl": "Klanten zijn zeer tevreden over het resultaat van de trimbeurten, van poedels en labradoodles tot spaanse waterhonden. Honden verlaten de trimsalon met een strak geknipte vacht, verzorgde nagels en een heerlijk frisse geur. Baasjes waarderen dat er precies geknipt wordt volgens de specifieke wensen van het ras.",
        "en": "Clients report great satisfaction with grooming outcomes, from poodles and labradoodles to Spanish water dogs. Pets leave the salon with neatly contoured coats, trimmed nails, and a delightful scent. Guardians appreciate that styling is tailored precisely according to breed standards and personal preferences."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "nl": "Ontspannen ervaring voor jonge pups",
        "en": "Relaxed experience for young puppies"
      },
      "text": {
        "nl": "Baasjes van jonge pups en senioren benadrukken hoe ontspannen hun viervoeters blijven tijdens de verzorging. Zelfs honden die normaal gesproken nerveus zijn bij de kapper, voelen zich hier op hun gemak en vallen soms zelfs rustig in slaap. Het algehele welzijn van het dier staat tijdens de behandeling voorop.",
        "en": "Owners of young puppies and senior dogs emphasize how relaxed their companions stay throughout grooming. Even pets typically anxious during grooming sessions feel entirely at ease here, with some even falling asleep calmly. Animal wellbeing and comfort remain the foremost priority throughout every appointment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "nl": "Biedt de salon speciale wenbeurten voor pups?",
        "en": "Does the salon offer puppy introductory grooms?"
      },
      "a": {
        "nl": "Ja, veel eigenaren brengen hun jonge puppy voor een rustige eerste kennismaking en lichte trim.",
        "en": "Yes, many owners bring their young puppies for a gentle introductory session and light trim."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "nl": "Worden bange of moeilijke honden goed geholpen?",
        "en": "Are fearful or difficult dogs handled gently?"
      },
      "a": {
        "nl": "Ja, de trimster staat bekend om haar geduldige aanpak waardoor zelfs angstige honden ontspannen.",
        "en": "Yes, the groomer is noted for a patient demeanor that helps even nervous dogs remain calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "nl": "Welke talen spreekt het salonpersoneel?",
