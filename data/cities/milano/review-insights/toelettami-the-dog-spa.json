  "google_maps_url": "https://www.google.com/maps/place/Toelettami+The+Dog+Spa/data=!4m7!3m6!1s0x4786c77b6a72c69f:0xcfbfba378cda8e47!8m2!3d45.4707177!4d9.2151907!16s%2Fg%2F11md_zzxsl!19sChIJn8ZyanvHhkcRR47ajDe6v88?authuser=0&hl=it&g_ep=EgoyMDI2MTAwNy4wIJJjKgBIAVAD&rclk=1",
  "period_from": "2026-04-12",
  "period_to": "2026-10-12",
  "reviews_in_period": 102,
  "observed_at": "2026-10-12",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 100,
      "title": {
        "it": "Accoglienza e professionalità del personale",
        "en": "Welcoming care and salon staff service"
      },
      "text": {
        "it": "La stragrande maggioranza dei visitatori elogia la cortesia, la dolcezza e la passione del team del salone in Via Gustavo Modena. Non mancano tuttavia lamentele isolate su incomprensioni organizzative o toni ritenuti poco accoglienti all'arrivo in struttura.",
        "en": "The vast majority of visitors commend the warmth, patience, and dedication of the team on Via Gustavo Modena. However, several reviews voice frustration over miscommunications regarding appointments or a perceived brusqueness during busy reception hours."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 81,
      "title": {
        "it": "Cura del manto e trattamenti igienizzanti",
        "en": "Coat grooming and hygiene treatments"
      },
      "text": {
        "it": "I risultati dei bagni e delle tosature riscuotono ampi consensi per la morbidezza del pelo e la profumazione duratura. Alcune segnalazioni critiche evidenziano nodi rimasti dopo la seduta o spazzolature giudicate eccessivamente energiche su pelli sensibili.",
        "en": "Bathing and coat styling results generally earn high customer satisfaction for long-lasting fragrance, thorough cleaning, and soft fur. A handful of critical reviewers, however, reported missed tangles or overly intense brushing on delicate canine skin."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "it": "Trasparenza tariffaria e servizi extra",
        "en": "Pricing transparency and add-on services"
      },
      "text": {
        "it": "Mentre molti clienti considerano i costi del salone adeguati e competitivi per la zona, diverse recensioni negative contestano supplementi imprevisti aggiunti al conto finale per balsami specifici o arrotondamenti contestati sulla fascia di peso del cane.",
        "en": "While numerous customers view the baseline rates as fair and well-aligned with neighborhood standards, several negative reviews contest unexpected surcharges added for special conditioners or disputes regarding pet weight bracket thresholds at checkout."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "È possibile prenotare la toelettatura tramite applicazione?",
        "en": "Can grooming sessions be booked through an app?"
      },
      "a": {
        "it": "Sì, il salone offre un sistema di prenotazione online per scegliere trattamenti e orari disponibili.",
        "en": "Yes, the parlour provides an online booking system enabling clients to select services and time slots."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "Il centro dispone di un servizio taxi per animali?",
        "en": "Does the centre offer a pet taxi transport service?"
      },
      "a": {
        "it": "Sì, la struttura propone un servizio navetta pet taxi per il ritiro e la riconsegna a domicilio del cane.",
        "en": "Yes, the salon provides a pet taxi service for picking up and returning dogs directly to owners' homes."
      },
      "basis": "website"
    },
    {
      "q": {
        "it": "Vengono eseguiti trattamenti di stripping per cani a pelo ruvido?",
        "en": "Does the parlour carry out hand stripping for wire-haired breeds?"
      },
      "a": {
        "it": "Sì, i toelettatori effettuano lo stripping specialistico, valutando preventivamente la maturità del manto.",
        "en": "Yes, groomers offer hand stripping for wire coats, assessing coat readiness prior to the treatment."
      },
      "basis": "both"
    }
  ],
