  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 179,
      "title": {
        "it": "Fiducia straordinaria nello staff medico",
        "en": "Extraordinary trust in medical staff"
      },
      "text": {
        "it": "La quasi totalità delle recensioni esprime enorme entusiasmo per la dottoressa Roberta Bonalumi e l'équipe della clinica. I clienti lodano la disponibilità costante, la dolcezza nel trattare gli animali e la capacità di rassicurare le famiglie. Soltanto una manciata di commenti isolati segnala attriti o divergenze diagnostiche.",
        "en": "The overwhelming majority of reviews expresses immense enthusiasm for Dr. Roberta Bonalumi and the clinic team. Clients praise constant availability, gentle handling of animals, and reassuring guidance for families. Only a handful of isolated comments mention occasional friction or diagnostic disagreements."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 106,
      "title": {
        "it": "Cure amorevoli per cani e gatti",
        "en": "Loving care for dogs and cats"
      },
      "text": {
        "it": "I proprietari descrivono un ambiente in cui cani e gatti vengono accolti con sincero affetto e rispetto, anche quando sono spaventati o sofferenti. L'attenzione verso gli animali anziani e i pazienti cronici è considerata esemplare dalla clientela abituale. Rarissime critiche riguardano la gestione del fine vita.",
        "en": "Pet guardians describe an environment where dogs and cats are received with genuine affection and respect, even when frightened or unwell. Attention toward senior pets and chronic patients is viewed as exemplary by long-standing clients. Very rare critiques touch upon the management of end-of-life care."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "it": "Diagnosi accurate ed esiti positivi",
        "en": "Accurate diagnoses and positive outcomes"
      },
      "text": {
        "it": "Moltissimi clienti testimoniano percorsi di guarigione eccellenti, interventi chirurgici riusciti e terapie che hanno salvato la vita a numerosi animali domestici. La precisione ecografica e clinica viene citata come garanzia di serenità. Soltanto due casi negativi lamentano diagnosi tardive su patologie complesse.",
        "en": "Scores of pet owners testify to excellent recovery journeys, successful surgeries, and effective therapies that saved the lives of numerous household companions. Ultrasound precision and clinical acumen are frequently cited as pillars of confidence. Only two critical reviews cite delayed diagnoses in complex cases."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "Quale dottoressa è particolarmente apprezzata dai clienti?",
        "en": "Which veterinarian is particularly praised by clients?"
      },
      "a": {
        "it": "La dottoressa Roberta Bonalumi riceve centinaia di encomi per competenza clinica, empatia e dedizione ai pazienti.",
        "en": "Dr. Roberta Bonalumi receives hundreds of commendations for clinical skill, empathy, and dedication to patients."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "La clinica offre esami diagnostici avanzati ed ecografie?",
        "en": "Does the clinic offer advanced diagnostic tests and ultrasounds?"
      },
      "a": {
        "it": "Sì, la struttura effettua ecografie specialistiche, esami ematici e diagnostica per immagini in sede.",
        "en": "Yes, the facility performs specialized ultrasounds, blood tests, and on-site diagnostic imaging."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "La clinica è consigliata per cani anziani o malati cronici?",
        "en": "Is the clinic recommended for senior dogs or chronic patients?"
      },
      "a": {
        "it": "Sì, numerosi clienti affidano animali anziani e cardiopatici all'équipe per terapie continuative di lunga durata.",
        "en": "Yes, numerous owners entrust senior pets and heart patients to the team for long-term continuous therapies."
      },
      "basis": "reviews"
    }
  ],
