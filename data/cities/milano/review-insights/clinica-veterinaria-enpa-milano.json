  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "it": "Personale accogliente e veterinari competenti",
        "en": "Welcoming team and skilled veterinarians"
      },
      "text": {
        "it": "I proprietari apprezzano l'empatia e la dedizione dei medici, in particolare delle dottoresse Irene Franco e Bruno, oltre all'accoglienza calorosa di Lina alla reception. Il personale si dimostra disponibile e attento anche nelle situazioni più delicate. Solo rari commenti segnalano momenti di freddezza nei casi urgenti.",
        "en": "Pet owners appreciate the empathy and dedication of the veterinary doctors, particularly Dr. Irene Franco and Dr. Bruno, alongside the warm welcome from Lina at reception. The team proves helpful and attentive even during delicate situations. Only isolated comments mention occasional friction during emergency visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "it": "Soccorso dedicato a ogni animale",
        "en": "Dedicated care for rescued animals"
      },
      "text": {
        "it": "La clinica è un punto di riferimento per cani, gatti ma anche per colombi e fauna selvatica in difficoltà. Gli utenti sottolineano l'impegno costante nell'accogliere volatili feriti e animali abbandonati per rimetterli in sesto. Pochi utenti lamentano la difficoltà di gestire alcune segnalazioni sul territorio.",
        "en": "The clinic is a trusted rescue center for dogs, cats, and injured pigeons or local wildlife. Reviewers emphasize the team's ongoing commitment to admitting wounded birds and abandoned animals to restore their health. A few visitors note limitations when requesting direct interventions in the field."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 7,
      "title": {
        "it": "Interventi chirurgici e cure efficaci",
        "en": "Surgical interventions and effective treatments"
      },
      "text": {
        "it": "Diversi proprietari raccontano di interventi chirurgici complessi, come asportazioni di tumori e operazioni ortopediche riuscite con successo. Gli animali seguiti con terapie mirate hanno recuperato una buona qualità di vita. Un caso critico ha espresso delusione per la mancata risposta a una terapia palliativa.",
        "en": "Several pet owners report complex surgeries, including successful tumor removals and orthopedic operations. Animals treated with targeted therapies have regained stability and vitality. One critical review expressed frustration when palliative injections failed to produce noticeable improvement."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "La clinica ENPA accoglie anche uccelli o animali selvatici feriti?",
        "en": "Does the ENPA clinic admit injured birds or wild animals?"
      },
      "a": {
        "it": "Sì, molti utenti segnalano di aver portato colombi e fauna selvatica trovati per strada, ricevendo pronta assistenza.",
        "en": "Yes, many reviewers report bringing in pigeons and injured urban wildlife found on the street for medical assistance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "È necessario prenotare prima di recarsi in clinica?",
        "en": "Is an appointment required before visiting the clinic?"
