  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 112,
      "title": {
        "it": "Competenza medica e supporto specialistico",
        "en": "Medical expertise and specialist care"
      },
      "text": {
        "it": "Moltissimi utenti lodano la preparazione dei medici veterinari e degli anestesisti, evidenziando dedizione e gentilezza nelle situazioni più difficili. Pur con alcune lamentele sull'accoglienza in orari notturni, l'esperienza del team clinico rimane un punto fermo.",
        "en": "Numerous clients praise the expertise of veterinarians and anesthesiologists, emphasizing their dedication and empathy in critical situations. Despite occasional complaints regarding overnight reception, the clinical team's competence is widely commended."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 87,
      "title": {
        "it": "Pronto soccorso attrezzato e operativo 24h",
        "en": "Well-equipped facility with 24h emergency"
      },
      "text": {
        "it": "La clinica di Via Pezzotti è apprezzata per la disponibilità continua del pronto soccorso e per le attrezzature avanzate di diagnostica per immagini e laboratorio. Gli spazi ampi e i reparti di degenza garantiscono un presidio fondamentale per tutta l'area milanese.",
        "en": "The veterinary facility on Via Pezzotti is praised for continuous emergency availability and advanced diagnostic imaging and laboratory equipment. Spacious consultation rooms and specialized hospitalization wards make it a central clinical reference point across Milan."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 79,
      "title": {
        "it": "Assistenza intensiva e riscontri contrastanti",
        "en": "Intensive care and divided feedback"
      },
      "text": {
        "it": "Numerosi proprietari ringraziano per aver salvato la vita a cani e gatti in condizioni disperate mediante ricoveri intensivi. D'altro canto, emergono critiche dolorose da parte di famiglie che hanno vissuto lutti o percepito scarsa empatia verso animali molto anziani.",
        "en": "Many pet owners express gratitude for life-saving interventions and intensive monitoring that stabilized dogs and cats in critical states. Conversely, critical reviews voice grief over lost companions and perceived insensitivity regarding frail geriatric pets."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "La clinica Tibaldi offre pronto soccorso 24 ore su 24?",
        "en": "Does Clinica Tibaldi offer 24-hour emergency services?"
      },
      "a": {
        "it": "Sì, il pronto soccorso veterinario è sempre aperto giorno e notte, 365 giorni all'anno, senza necessità di preavviso.",
        "en": "Yes, veterinary emergency services operate continuously day and night, 365 days a year, without prior appointment."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "Come sono organizzati i tempi di attesa per le urgenze?",
        "en": "How are waiting times managed for emergency cases?"
      },
      "a": {
        "it": "I casi critici con codice rosso hanno precedenza immediata, mentre visite meno urgenti possono richiedere attese prolungate.",
        "en": "Life-threatening emergencies receive immediate priority triage, whereas non-critical visits may encounter extended waits."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Qual è il riscontro sui prezzi dei servizi di emergenza?",
        "en": "What is the feedback regarding emergency service fees?"
      },
      "a": {
        "it": "I clienti segnalano tariffe di pronto soccorso e diagnostica elevate, tipiche di strutture ospedaliere private h24.",
        "en": "Clients note that emergency consultations and diagnostics carry premium fees typical of private 24/7 animal hospitals."
      },
      "basis": "reviews"
    }
  ],
