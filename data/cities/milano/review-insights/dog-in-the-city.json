  "google_maps_url": "https://www.google.com/maps/place/Dog+in+the+city/data=!4m7!3m6!1s0x4786c425d29f6d69:0xcafd5adfa9f38607!8m2!3d45.4507605!4d9.2114265!16s%2Fg%2F1tqck2nk!19sChIJaW2f0iXEhkcRB4bzqd9a_co?authuser=0&hl=it&g_ep=EgoyMDI2MTAwNy4wIJJjKgBIAVAD&rclk=1",
  "period_from": "2026-04-12",
  "period_to": "2026-10-12",
  "reviews_in_period": 65,
  "observed_at": "2026-10-12",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "it": "Professionalità, dolcezza e consigli dedicati",
        "en": "Professional expertise, gentleness, and tailored advice"
      },
      "text": {
        "it": "I clienti premiano con entusiasmo le toelettatrici del salone, in particolare Debora e Vanessa, per la pazienza, la cortesia e la prontezza nel comprendere le necessità di cani e gatti. Il team sa rassicurare i proprietari fornendo suggerimenti utili sulla cura quotidiana del manto.",
        "en": "Pet parents enthusiastically praise the salon's groomers, particularly Debora and Vanessa, for their patience, warmth, and intuitive understanding of dogs and cats. The team reassures owners by offering valuable practical guidance on routine coat maintenance and brushing techniques."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "it": "Tosature rifinite e pelo profumato",
        "en": "Flawless grooming finishes and long-lasting freshness"
      },
      "text": {
        "it": "I proprietari notano costantemente risultati estetici impeccabili: cani e gatti escono profumati, con un manto morbido, pulito e vaporoso. I tagli a forbice e le rasature vengono eseguiti con grande precisione, valorizzando la morfologia della razza e risolvendo i nodi più ostinati.",
        "en": "Reviews consistently highlight impeccable aesthetic results, with dogs and cats emerging fragrant, exceptionally soft, and beautifully fluffed. Scissor trims and breed-specific cuts are executed with precision, highlighting natural contours and resolving persistent tangles."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "it": "Trattamento rassicurante anche per gatti",
        "en": "Gentle handling for sensitive pets"
      },
      "text": {
        "it": "L'ambiente del salone garantisce un'atmosfera serena che tranquillizza anche gli animali più diffidenti o spaventati dall'acqua. Sia per cuccioli al primo bagno sia per felini bisognosi di spazzolatura, gli operatori sanno instaurare un rapporto di totale fiducia e delicatezza.",
        "en": "The parlour provides a soothing environment that calms even cautious animals or pets frightened by running water. Whether grooming young puppies for their initial wash or handling sensitive cats, the team establishes genuine trust through patience and gentle techniques."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "Il salone accetta anche gatti per toelettatura e snodatura?",
        "en": "Does the salon groom and demat cats as well as dogs?"
      },
      "a": {
        "it": "Sì, i proprietari di gatti confermano un trattamento paziente e attento, capace di tranquillizzare anche felini paurosi.",
        "en": "Yes, cat owners report patient and attentive grooming, successfully calming even nervous or sensitive felines."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Vengono eseguiti tagli a forbice specifici per razza?",
        "en": "Are breed-specific scissor styling cuts available?"
      },
      "a": {
        "it": "Sì, il personale realizza tagli a forbice modellati sulla morfologia di barboni e altre razze a pelo lungo.",
        "en": "Yes, the staff provides meticulous scissor trims adapted to the breed standard of poodles and long-haired breeds."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "È richiesta la prenotazione anticipata per il bagno?",
        "en": "Is advance booking required for bathing and grooming?"
      },
      "a": {
        "it": "Sì, è opportuno fissare un appuntamento per concordare i tempi e garantire un servizio puntuale senza attese.",
        "en": "Yes, scheduling an appointment is necessary to guarantee prompt service and avoid waiting times for pets."
      },
      "basis": "both"
    }
  ],
