  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "it": "Passione ed empatia dei toelettatori",
        "en": "Passionate and welcoming parlour team"
      },
      "text": {
        "it": "I toelettatori Giuseppe e Nino ricevono unanimi attestati di stima per la loro professionalità, cordialità e dedizione. I proprietari sottolineano la capacità del team di mettere a proprio agio sia gli animali che le persone fin dal primo ingresso in salone.",
        "en": "Groomers Giuseppe and Nino receive unanimous praise for their professionalism, warmth, and dedication. Pet parents consistently emphasize the team's natural ability to make both dogs and their owners feel entirely comfortable from the moment they step into the salon."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "it": "Perfezione nei tagli e cura del manto",
        "en": "Impeccable coat styling and scissor trims"
      },
      "text": {
        "it": "La resa estetica e igienica dei trattamenti viene definita impeccabile da ogni cliente. I cani escono dal salone profumati, con manti morbidi e tagli a forbice eseguiti con straordinaria precisione tecnica, suscitando complimenti spontanei anche per strada.",
        "en": "The aesthetic and hygiene outcomes of grooming treatments are described as flawless across all reviews. Dogs leave looking radiant, smelling fresh, with soft fur and scissor trims executed with remarkable skill, frequently drawing compliments from passersby."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "it": "Pazienza e rispetto del benessere animale",
        "en": "Patient and gentle handling of pets"
      },
      "text": {
        "it": "L'amore verso gli animali emerge in ogni recensione: anche cani diffidenti, cuccioli di pochi mesi o gatti timorosi vengono trattati con infinita dolcezza e rispetto dei loro tempi, trasformando la toelettatura in un momento piacevole e privo di stress.",
        "en": "Genuine care for animal well-being shines through every comment: even wary dogs, very young puppies, and sensitive cats are handled with boundless tenderness and unhurried patience, turning what could be stressful grooming visits into relaxing, positive experiences."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "Il salone effettua la toelettatura anche per i gatti?",
        "en": "Does the parlour provide grooming services for cats?"
      },
      "a": {
        "it": "Sì, il personale tratta anche i felini con estrema calma per il taglio delle unghie, la spazzolatura e il bagno.",
        "en": "Yes, staff groom cats with exceptional calmness, handling nail clipping, thorough brushing, and gentle baths."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "Vengono accettati cuccioli alla loro prima toelettatura?",
        "en": "Are puppies welcomed for their first grooming visit?"
      },
      "a": {
        "it": "Sì, i toelettatori dedicano tempo supplementare ai cuccioli per abituarli gradualmente all'acqua e ai rumori.",
        "en": "Yes, the groomers spend dedicated time with puppies to gently familiarize them with water and equipment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "È disponibile il bagno all'ozono con idromassaggio?",
        "en": "Are ozone hydrotherapy baths available?"
      },
      "a": {
        "it": "Sì, la struttura offre trattamenti all'ozono con sistema Idropet per la salute cutanea e la cura del pelo.",
        "en": "Yes, the salon provides ozone treatments with the Idropet system for skin wellness and deep coat cleansing."
      },
      "basis": "website"
    }
