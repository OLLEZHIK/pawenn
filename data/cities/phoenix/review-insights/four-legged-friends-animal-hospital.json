  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "en": "Attentive and trusted veterinary team"
      },
      "text": {
        "en": "Pet owners consistently praise Dr Ferguson, Dr Isom, and the veterinary nurses for their warmth, thorough explanations, and compassionate manner. Many longtime clients mention visiting the clinic for over two decades, emphasizing that doctors listen closely to family concerns. Reviewers value the supportive approach taken during both routine wellness exams and challenging illnesses."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Gentle handling for anxious pets"
      },
      "text": {
        "en": "Reviewers repeatedly note how calmly and patiently the team handles nervous dogs and cats during clinical examinations. Owners of rescued animals and senior pets appreciate that staff take extra time to keep animals relaxed during blood draws and nail trims. Clients highlight that their pets feel comfortable and safe throughout visits to the hospital."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Reliable diagnoses and clinical care"
      },
      "text": {
        "en": "Clients report dependable outcomes for complex medical conditions, diagnostic lab work, and urgent treatments. Pet parents describe how prompt assessments and effective medication plans helped their pets recover comfortably from sudden illnesses and pain. Reviewers express strong peace of mind relying on the clinical decisions made by the veterinary team."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do the veterinarians at Four-Legged Friends treat senior and rescue pets?"
      },
      "a": {
        "en": "Yes, clients frequently bring senior dogs and rescued animals, praising the gentle handling and tailored veterinary care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is scheduling in advance required for appointments?"
      },
      "a": {
        "en": "Yes, reviewers recommend booking ahead, as appointment slots can fill quickly due to high demand for the veterinarians."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can the hospital perform in-house lab work and blood tests?"
      },
      "a": {
        "en": "Yes, reviewers mention that the veterinary team conducts diagnostic blood tests, laboratory panels, and health screenings on site."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients view the clinic communication?"
      },
      "a": {
        "en": "Pet parents highlight that doctors and assistants provide clear updates and follow up promptly regarding test results."
      },
      "basis": "reviews"
    }
  ],
