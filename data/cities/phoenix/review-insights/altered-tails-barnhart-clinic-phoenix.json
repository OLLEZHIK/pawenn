  "faq": [
    {
      "q": {
        "en": "How much does spay and neuter surgery cost at Altered Tails Barnhart Clinic?"
      },
      "a": {
        "en": "Published fees include $85 for male cat neutering, $105 for female cat spaying, and $172 for spaying dogs up to 30 lbs, which reviewers note is far below standard clinic rates."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic work with feral and stray cats?"
      },
      "a": {
        "en": "Yes, multiple reviewers highlight the clinic's trap-neuter-return (TNR) surgeries and low-cost care for community and feral cats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do drop-off and pick-up work on surgery days?"
      },
      "a": {
        "en": "Clients complete registration forms online beforehand, drop pets off in the morning, and receive a phone call as soon as their pet wakes from anaesthesia and is ready to go home."
      },
      "basis": "reviews"
    }
