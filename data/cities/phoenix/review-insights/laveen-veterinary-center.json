  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "en": "Attentive and welcoming veterinary team"
      },
      "text": {
        "en": "The vast majority of reviewers praise Dr. Ware, Dr. Weber, and the support staff for their friendliness, clear communication, and empathetic bedside manner. Longtime clients highlight that doctors call personally on their days off to check on recovering patients. While a couple of pet owners felt rushed or disputed record accuracy, most clients describe a dedicated team that treats pets like family."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Comforting approach with fragile pets"
      },
      "text": {
        "en": "Pet parents frequently commend the staff for their gentle touch with anxious dogs, large breeds, and senior cats. Reviewers appreciate that the team takes extra time to comfort nervous animals and conducts unhurried examinations. Clients also express gratitude for the sincere compassion and dignified support provided during difficult end-of-life visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "en": "Effective surgical and medical treatments"
      },
      "text": {
        "en": "Clients report dependable medical outcomes for complex procedures, including CCL repairs, patella surgeries, dental work, and urgent wound treatments. Reviewers appreciate thorough pre-operative explanations and attentive post-operative follow-up calls. Despite one grievance regarding emergency heatstroke capabilities, most owners express complete confidence in the clinical care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can appointments be scheduled online?"
      },
      "a": {
        "en": "Yes, clients appreciate the ability to book appointments online directly through the clinic's booking system."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the hospital perform orthopaedic surgeries?"
      },
      "a": {
        "en": "Yes, the hospital regularly performs orthopaedic procedures, including CCL repairs and luxating patella surgeries."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What facilities are available on site?"
      },
      "a": {
        "en": "Reviewers describe a spacious, clean, and modern hospital facility with private examination rooms designed to keep waiting times brief."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the clinic handle surgical follow-up?"
      },
      "a": {
        "en": "Pet owners note that doctors and veterinary technicians call promptly the following day to monitor patient recovery and answer home care questions."
      },
      "basis": "reviews"
    }
  ],
