  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Welcoming team and helpful guidance"
      },
      "text": {
        "en": "Pet owners frequently praise groomers Lauren, Hailey, Kat, and Ashley alongside the front desk staff for their warmth and helpful instructions at the self-wash tubs. Although one client was upset after being turned away when arriving twelve minutes late without a deposit refund, the vast majority describe a kind and accommodating crew."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Thorough coats and de-shedding washes"
      },
      "text": {
        "en": "Clients report that dogs return home with soft, tidy coats after full haircuts, baths, and de-shedding sessions in Arcadia. Owners of doodles, schnauzers, and shepherd mixes note a clear reduction in shedding at home and appreciate the clean finish achieved during both full-service appointments and self-service washes."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Patient handling for nervous pets"
      },
      "text": {
        "en": "Reviewers with shy rescues, large anxious dogs, and sensitive cats highlight how calmly the bathers and groomers work. Owners appreciate that staff lift heavy dogs into tubs, use protective ear covers during loud blow-drying, and let pets rest comfortably in open areas rather than cages while waiting for collection."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does petbar Boutique Arcadia offer self-service dog washing?"
      },
      "a": {
        "en": "Yes, the salon provides self-wash tubs stocked with shampoos, conditioner, brushes, towels, aprons, and private blow-dry rooms."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the salon handle dogs that are afraid of loud dryers?"
      },
      "a": {
        "en": "Reviewers note that staff provide protective ear covers and smaller, quieter dryers for dogs sensitive to noise."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are dogs kept in kennels while waiting for collection?"
      },
      "a": {
        "en": "Clients mention that dogs are able to rest comfortably outside of kennels and can be viewed on a video monitor at pick-up."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What happens if an owner arrives late for a grooming booking?"
      },
      "a": {
        "en": "Appointments follow a strict schedule; one reviewer reported that arriving twelve minutes late resulted in a cancelled session and forfeited deposit."
      },
      "basis": "reviews"
    }
  ],
