  "cards": [
    {
      "topic": "staff",
      "title": {
        "en": "Helpful and attentive veterinary clinic team"
      },
      "text": {
        "en": "A substantial majority of clients applaud the veterinary doctors, technicians, and front desk personnel for their warmth, friendliness, and dedication. Pet parents frequently note that staff explain clinical treatments clearly and treat pet owners with respect. While a few reviewers reported curt interactions with reception or technician staff, the overall consensus highlights a supportive team."
      },
      "mentions": 127,
      "sentiment": "positive"
    },
    {
      "topic": "animals",
      "title": {
        "en": "Gentle handling for companion animals"
      },
      "text": {
        "en": "Reviewers frequently praise the gentle, affectionate care shown to dogs and cats during examinations, vaccinations, and surgical treatments. Clients note that veterinarians and assistants handle nervous pets with patience and soothing techniques, helping animals remain calm during clinic appointments. Owners express strong trust when leaving pets for spay or neuter procedures."
      },
      "mentions": 109,
      "sentiment": "positive"
    },
    {
      "topic": "waiting",
      "title": {
        "en": "Efficient scheduling and prompt appointments"
      },
      "text": {
        "en": "Clients appreciate prompt appointment scheduling and generally short lobby wait times, noting that visits often run efficiently from check-in to checkout. Reviewers mention that routine checkups and quick technician visits are accommodated smoothly. Although some pet parents experienced occasional delays during busy periods, most report timely, well-managed appointments."
      },
      "mentions": 56,
      "sentiment": "positive"
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does North Phoenix Animal Clinic perform spay and neuter surgeries?"
      },
      "a": {
        "en": "Yes, reviewers frequently mention bringing dogs and cats in for spaying, neutering, and routine surgical procedures."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners schedule routine technician visits?"
      },
      "a": {
        "en": "Yes, clients mention quick appointments for vaccinations, nail trims, and Cytopoint injections administered by veterinary technicians."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients describe wait times at the hospital?"
      },
      "a": {
        "en": "Most reviewers report prompt check-in and short wait times in exam rooms, though occasional delays happen during peak hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are companion pets handled gently during clinic visits?"
      },
      "a": {
        "en": "Yes, pet parents consistently praise the gentle, reassuring approach used by veterinarians and technicians with nervous animals."
      },
      "basis": "reviews"
    }
  ],
