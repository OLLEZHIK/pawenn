    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Skilled and gentle mobile groomers"
      },
      "text": {
        "en": "Many pet owners praise individual groomers including Amanda, James, and Milton for their courteous manners, gentleness with pets, and attention to detail. Reviewers appreciate that groomers communicate well during appointments and make pets feel comfortable inside the mobile van. Satisfied clients frequently request the same groomer for recurring home visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 9,
      "title": {
        "en": "Convenient care for household pets"
      },
      "text": {
        "en": "Reviewers value the mobile service for reducing travel stress on dogs and cats, particularly elderly or timid animals. Several pet owners note that dogs enjoy the van sessions and look well-kept after full grooms. However, one client reported a stressful experience where a cat remained damp and agitated, while another noted a whisker trim mishap."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 8,
      "title": {
        "en": "Frequent appointment cancellations and delays"
      },
      "text": {
        "en": "Multiple clients express strong frustration over repeated last-minute cancellations, missed booking windows, and rescheduling difficulties. Several reviewers describe rearranging their daily schedules only to receive cancellation texts shortly before arrival or finding out that assigned groomers had departed. Customers emphasize that dispatch reliability needs improvement."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Furry Land of Phoenix provide mobile grooming at the customer's home?"
      },
      "a": {
        "en": "Yes, the company operates self-contained mobile vans that travel directly to pet owners' residences."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners request a specific mobile groomer?"
      },
      "a": {
        "en": "Yes, clients frequently request specific groomers like James or Milton, though staffing changes have occasionally disrupted recurring bookings."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How dependable is appointment scheduling?"
      },
      "a": {
        "en": "Reviewers report mixed experiences, with several noting short-notice cancellations and scheduling delays from the dispatch office."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do the mobile vans groom both dogs and cats?"
      },
      "a": {
        "en": "Yes, services are available for dogs of various sizes as well as cats, though clients recommend confirming cat grooming details in advance."
      },
      "basis": "both"
    }
