  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 52,
      "title": {
        "en": "Compassionate and supportive clinic personnel"
      },
      "text": {
        "en": "Pet owners consistently praise Dr. Karner, veterinary technicians, and reception staff for their exceptional kindness, empathy, and professionalism. Clients note that clinicians explain procedures thoroughly and take time to comfort families during difficult consultations. While one reviewer expressed disappointment with service, the staff is overwhelmingly commended."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Gentle bedside care and comfort"
      },
      "text": {
        "en": "Reviewers regularly emphasize how gently dogs and cats are treated throughout physical examinations, vaccinations, and surgical procedures. Clients with fearful or senior pets appreciate the calm, unhurried approach that keeps animals relaxed during visits. Families facing end-of-life care highlight the profound dignity and tenderness shown to their pets."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Reliable treatments and surgical care"
      },
      "text": {
        "en": "Pet parents report excellent clinical outcomes for routine spay and neuter surgeries, dental procedures, and complex medical conditions. Reviewers appreciate accurate diagnoses that helped alleviate chronic discomfort and restore their pets to full health. Except for a single complaint of poor service, clients express complete trust in the veterinary treatments."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Desert Rose Animal Hospital provide compassionate end-of-life care?"
      },
      "a": {
        "en": "Yes, reviewers frequently commend the clinic for its gentle and dignified support during euthanasia appointments."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What surgical procedures are performed at the hospital?"
      },
      "a": {
        "en": "The hospital routinely performs spay and neuter surgeries, dental cleanings, soft tissue procedures, and mass removals."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are appointments required for routine examinations?"
      },
      "a": {
        "en": "Yes, pet owners schedule appointments in advance for wellness checks, vaccinations, and consultations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients view the clinic's pricing and service value?"
      },
      "a": {
        "en": "Many pet parents describe fees as reasonable and transparent, with clear estimates provided prior to procedures."
      },
      "basis": "reviews"
    }
  ],
