  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "en": "Knowledgeable and supportive clinic staff"
      },
      "text": {
        "en": "Clients widely commend the veterinarians and veterinary technicians for their professional expertise, empathy, and clear explanations. Many pet owners report having visited the hospital for several years, praising the doctors for their attentive bedside manner. A few reviewers voiced dissatisfaction with billing policies and administrative management, but overall client sentiment is strongly positive."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Compassionate treatment of household pets"
      },
      "text": {
        "en": "Pet owners consistently note how gently and reassuringly the veterinary team treats their dogs and cats during exams. Reviewers with stressed or aging animals appreciate the staff's calm handling, which helps reduce fear and anxiety during clinical visits. Clients express deep gratitude for the loving attention their pets receive during routine check-ups and medical emergencies."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Reliable medical care and diagnostics"
      },
      "text": {
        "en": "Reviewers express strong confidence in the clinic's diagnostic abilities, surgical care, and chronic illness management. Clients highlight successful treatment plans for dental cleanings, urgent illnesses, and complex pet ailments that restored pet comfort and health. While an isolated reviewer noted an overlooked diagnosis, the vast majority describe effective clinical care and prompt outcomes."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Ingleside Animal Hospital offer emergency or urgent care?"
      },
      "a": {
        "en": "Yes, clients note that the hospital accommodates urgent pet illnesses and emergency appointments during practice hours."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is an appointment deposit required when scheduling visits?"
      },
      "a": {
        "en": "Several reviewers mention that the clinic requests an upfront non-refundable deposit when booking appointments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital provide on-site diagnostic testing?"
      },
      "a": {
        "en": "Yes, the hospital performs in-house diagnostic blood panels, screenings, and laboratory tests for cats and dogs."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do the veterinarians treat chronic pet conditions like kidney disease?"
      },
      "a": {
        "en": "Yes, reviewers frequently praise the team for long-term management of feline kidney disease, diabetes, and senior ailments."
      },
      "basis": "reviews"
    }
  ],
