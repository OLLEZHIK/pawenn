  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 75,
      "title": {
        "en": "Supportive and informative veterinary team"
      },
      "text": {
        "en": "The majority of pet owners praise the veterinary clinicians, technicians, and receptionists for their compassionate approach and thorough explanations during medical visits. Clients frequently highlight that doctors explain diagnoses in clear detail without rushing consultations. While two reviewers felt ignored or delayed by clinic personnel, most visitors describe a dedicated, attentive clinical staff."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "en": "Effective treatments and surgical care"
      },
      "text": {
        "en": "Pet parents report dependable clinical outcomes for routine health checks, diagnostic procedures, dental treatments, and soft tissue surgeries. Many reviewers credit the medical team with resolving complex conditions, managing chronic illnesses, and providing life-saving interventions. Although one client experienced delayed prescription approvals, clients largely report positive recoveries and effective medical care."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 52,
      "title": {
        "en": "Gentle handling for diverse species"
      },
      "text": {
        "en": "Reviewers frequently praise the gentle manner in which staff handle dogs, cats, rabbits, and exotic companion animals during physical examinations. Clients note that clinicians make deliberate efforts to keep anxious or ailing pets comfortable during procedures and blood tests. Pet owners appreciate the hospital's willingness to treat exotic species alongside standard canine and feline patients."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Palm Glen Animal Hospital treat exotic pets?"
      },
      "a": {
        "en": "Yes, clients and hospital records confirm that clinicians provide medical examinations and care for rabbits, reptiles, and other exotic animals."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can veterinary appointments be booked online?"
      },
      "a": {
        "en": "Yes, pet owners can request and schedule appointments through the hospital's official website."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Does the hospital perform pet dental cleanings and surgeries?"
      },
      "a": {
        "en": "Yes, reviewers describe successful soft tissue surgeries, dental cleanings, and diagnostic ultrasound evaluations conducted at the clinic."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients describe communication regarding treatment plans?"
      },
      "a": {
        "en": "Most pet owners report thorough medical guidance from clinicians, though occasional delays in prescription coordination have been noted."
      },
      "basis": "reviews"
    }
  ],
