  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "en": "Warm and patient mobile veterinary clinicians"
      },
      "text": {
        "en": "Clients consistently praise Dr Val and the mobile veterinary team for their empathetic bedside manner and thorough consultations. Pet owners note that clinicians take their time during home visits, answer questions without rush, and provide compassionate guidance during routine care and end-of-life support."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Low-stress examinations for anxious pets"
      },
      "text": {
        "en": "Reviewers frequently highlight how beneficial home visits are for pets with severe clinic anxiety, mobility challenges, or trauma. Dogs and cats are examined gently in their familiar environment, allowing veterinarians to administer vaccines and conduct health assessments without causing distress."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Convenience of doorstep veterinary appointments"
      },
      "text": {
        "en": "Pet owners emphasise the immense convenience of having a fully equipped veterinary team arrive directly at their home. Families appreciate avoiding stressful car journeys and crowded clinic waiting rooms, particularly when caring for multiple pets or elderly animals with limited mobility."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Valet Vet provide in-home veterinary checkups?"
      },
      "a": {
        "en": "Yes, veterinarians travel directly to residences across the Phoenix area for wellness examinations, blood tests, and routine vaccinations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is the mobile service suitable for anxious dogs and cats?"
      },
      "a": {
        "en": "Yes, reviewers specifically recommend the service for pets that experience severe anxiety or motion sickness during car travel to traditional clinics."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Valet Vet provide in-home euthanasia services?"
      },
      "a": {
        "en": "Yes, clients express gratitude for the gentle and dignified hospice care and in-home euthanasia support provided by the veterinary team."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can appointments be booked online?"
      },
      "a": {
        "en": "Yes, pet owners can schedule visits and check service availability through the online booking portal."
      },
      "basis": "both"
    }
  ],
