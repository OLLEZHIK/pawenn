  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "en": "Caring vets with occasional front-desk friction"
      },
      "text": {
        "en": "Most reviewers in Laveen Village praise Dr. Clifford Fraser, Dr. Gifford, and technicians like Esmeralda for their kindness and dedication. A few dissatisfied clients, however, reported rushed exams or argumentative staff during billing and waiting disputes."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Supportive handling for dogs and cats"
      },
      "text": {
        "en": "Pet owners frequently mention how gently the team treats kittens, fractious cats, and large dogs, even carrying mobility-impaired pets in from the car. While one reviewer felt their pet was ignored during a wait, most say their animals are excited to visit."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "en": "Thorough diagnostics and surgical care"
      },
      "text": {
        "en": "Clients credit the veterinarians with catching hidden splenic tumours during routine visits, resolving ear haematomas through surgery, and treating urgent illnesses. Conversely, one cat owner blamed an antibiotic dose for a fatal outcome and another felt an exam was too brief."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can Animal Hospital of Laveen accommodate same-day urgent visits?"
      },
      "a": {
        "en": "Yes, several pet owners report being fitted in on the same day or as walk-ins for urgent dog and cat illnesses, even as first-time clients."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do reviewers describe the pricing at Animal Hospital of Laveen?"
      },
      "a": {
        "en": "Most clients describe the fees as fair and appreciate cost-effective treatment options and new-client discounts, though a couple of reviewers disputed quote changes or surgery estimates."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic assist pets with mobility difficulties?"
      },
      "a": {
        "en": "Yes, reviewers note that veterinary assistants help carry dogs with spinal or mobility conditions like IVDD directly from the car into the clinic."
      },
      "basis": "reviews"
    }
  ],
