  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Trusted vets and compassionate team"
      },
      "text": {
        "en": "Pet owners overwhelmingly praise Dr. Temple, Dr. Maddy, Dr. Jeri, and the support team on East Thomas Road for their warmth and attentiveness. Many clients have visited for 10 to 30 years, though one reviewer reported a dispute with a doctor over sedation doses."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Calm handling for dogs and cats"
      },
      "text": {
        "en": "Reviewers frequently highlight how gently the staff treat nervous puppies, multi-cat households, and fearful pit bulls, greeting pets by name with treats during vaccinations. Long-standing clients also value the team's deep empathy during end-of-life visits."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 9,
      "title": {
        "en": "Independent pricing without pushy upsells"
      },
      "text": {
        "en": "Clients appreciate that this independently run hospital offers fair rates, price-matches medications, and respects owner budgets without pushing unnecessary panels. Only one critical review alleged pressure to purchase extra sedatives for bandage changes."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is Animal Care Hospital of Phoenix good with fearful or anxious dogs?"
      },
      "a": {
        "en": "Yes, multiple dog owners note that the veterinarians and technicians are patient and gentle with anxious puppies and fearful dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital assist with international pet travel health checks?"
      },
      "a": {
        "en": "Yes, reviewers mention bringing dogs to Dr. Jeri for examinations and vaccination requirements ahead of international moves."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients view the pricing and treatment recommendations?"
      },
      "a": {
        "en": "Most reviewers state that the doctors provide transparent advice without upselling unnecessary tests and help owners save through price matching."
      },
      "basis": "reviews"
    }
  ],
