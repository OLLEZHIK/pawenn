  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Skilled nail trims and tidy styling"
      },
      "text": {
        "en": "Most clients praise the salon for neat grooming, thorough coat washes, and skilled nail clippings on fidgety dogs. Many reviewers appreciate having quick touch-ups performed on the same day. While two customers reported issues with uneven clipping or over-trimmed quicks on sensitive dogs, the overall feedback highlights consistent styling quality and clean results."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "en": "Gentle handling for nervous pets"
      },
      "text": {
        "en": "Reviewers repeatedly note how patiently the groomers handle anxious, elderly, or touch-sensitive dogs during nail care and washing. Pet parents appreciate that staff members take time to calm uneasy pets and allow owners to stay close during routine clipping. Although one client reported a painful nail trim, the vast majority commend the gentle and caring treatment."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Friendly and helpful salon team"
      },
      "text": {
        "en": "Clients frequently remark on the welcoming attitude of the salon staff and groomers, noting that team members are helpful and attentive at reception. Multiple reviewers mention that staff readily discuss grooming preferences and accommodate busy schedules. Pet parents describe a friendly neighbourhood team that genuinely cares about the well-being of visiting dogs."
      }
    }
  ],
  "faq": [
