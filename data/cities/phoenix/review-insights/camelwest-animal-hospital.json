  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Compassionate and thorough veterinary doctors"
      },
      "text": {
        "en": "Clients consistently commend Dr. McCready, Dr. Pollard, Dr. Flick, and the veterinary support staff for their gentle bedside manner and clear medical explanations. Pet owners appreciate that the doctors take time to listen to questions and never rush examinations. While one individual felt unattended during a stray animal emergency, the overwhelming majority describe a dedicated, empathetic team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Experienced care across diverse species"
      },
      "text": {
        "en": "Many reviewers emphasize the clinic's capability in treating various animals beyond dogs and cats, including rabbits, chinchillas, guinea pigs, and conure parrots. Pet parents note that veterinarians handle nervous dogs, energetic puppies, and fragile exotic animals with patience and soothing techniques. Owners express strong confidence in bringing different species for treatment."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Reliable diagnostics and medical outcomes"
      },
      "text": {
        "en": "Pet owners frequently report successful treatment outcomes for urgent allergic reactions, dental care, tumor aspirations, and routine vaccinations. Several longtime clients credit the doctors with saving their pets' lives during critical health crises through accurate and timely interventions. Reviewers express peace of mind knowing follow-up calls and clear treatment plans are standard."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Camelwest Animal Hospital treat exotic pets and small mammals?"
      },
      "a": {
        "en": "Yes, clients frequently report successful visits for rabbits, chinchillas, conures, and small pocket pets alongside cats and dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are same-day or urgent veterinary appointments available?"
      },
      "a": {
        "en": "Yes, pet owners report being accommodated for same-day appointments and urgent situations during regular business hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer weekend appointment hours?"
      },
      "a": {
        "en": "Yes, reviewers mention that the veterinary hospital provides convenient appointment availability on weekends."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients evaluate treatment pricing at the hospital?"
      },
      "a": {
        "en": "Most pet owners describe the clinic's fees as fair and reasonable compared to other animal hospitals in the Valley."
      },
      "basis": "reviews"
    }
