  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 66,
      "title": {
        "en": "Gentle and patient pet handling"
      },
      "text": {
        "en": "Pet parents describe enthusiastic dogs that happily run through the doors on grooming days. Reviewers note that groomers demonstrate immense patience with elderly dogs, nervous rescues, and high-energy doodles, ensuring pets feel secure and comfortable throughout their styling sessions."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 62,
      "title": {
        "en": "Consistent haircuts and immaculate styling"
      },
      "text": {
        "en": "Owners praise the quality and consistency of full haircuts, gentle baths, and thorough coat treatments. Dogs routinely return home smelling pleasant, with clean coats and precisely trimmed paws and nails that match owner preferences across various breed styling requests."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "en": "Friendly groomers and welcoming reception"
      },
      "text": {
        "en": "Reviewers frequently commend individual stylists including Ophelia, Kaleena, Shara, and Kara for their attentive service and cheerful demeanour. Clients appreciate that reception staff greet visitors warmly and keep pet parents updated regarding collection times."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners request a specific groomer at The Hairy Dog?"
      },
      "a": {
        "en": "Yes, clients frequently mention booking regular appointments with their preferred stylists who understand their pets' individual preferences."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the salon groom senior or anxious dogs?"
      },
      "a": {
        "en": "Yes, reviewers praise groomers for handling older dogs with arthritis and nervous rescues with patience and gentle care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are haircuts available for large dog breeds?"
      },
      "a": {
        "en": "Yes, pet owners confirm that the team grooms large breeds, including Golden Retrievers, Bernedoodles, and Saint Bernards."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can grooming appointments be booked online?"
      },
      "a": {
        "en": "Yes, clients appreciate the convenience of scheduling grooming sessions through the salon's online booking system."
      },
      "basis": "both"
    }
  ],
