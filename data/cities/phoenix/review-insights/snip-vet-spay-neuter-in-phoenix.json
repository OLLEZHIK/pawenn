  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Efficient surgery and smooth healing"
      },
      "text": {
        "en": "Reviewers report positive surgical outcomes for spaying and neutering procedures, noting tiny incisions and clean sutures. Many owners highlight that companion animals recovered swiftly following anaesthesia and routine discharges. While several clients experienced post-operative complications or excessive bleeding, the majority praise the clinical execution."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Helpful reception and veterinary care"
      },
      "text": {
        "en": "The clinical team and veterinary assistants receive praise for managing large volumes of surgical patients with warmth and diligence. Clients appreciate the concise discharge briefings and guidance provided on wound management. Although a few visitors felt customer service was curt during check-in, most pet parents describe the personnel as kind and caring."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Affordable sterilisation and transparent rates"
      },
      "text": {
        "en": "Pet owners consistently highlight the clinic for offering budget-friendly neutering and spaying packages. Clients frequently remark that accessible fees allow families and rescuers to sterilise multiple cats and dogs without severe financial strain. While one reviewer questioned the price of plastic recovery collars, most describe the pricing structure as remarkably fair."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What surgical procedures does SNiP Vet specialise in?"
      },
      "a": {
        "en": "The clinic primarily focuses on high-volume, low-cost spay and neuter surgeries alongside routine vaccinations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are postoperative recovery instructions provided after surgery?"
      },
      "a": {
        "en": "Yes, clients receive clear guidance on incision monitoring, pain management, and activity limits upon collection."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can community cats and rescue animals be sterilised here?"
      },
      "a": {
        "en": "Yes, reviewers frequently bring trapped feral cats, strays, and shelter rescues for sterilisation and ear-tipping."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are veterinary appointments required in advance?"
      },
      "a": {
        "en": "Yes, surgical visits must be scheduled beforehand to manage daily surgical intakes efficiently."
      },
      "basis": "both"
    }
  ],
