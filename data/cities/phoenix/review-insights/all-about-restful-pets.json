  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 81,
      "title": {
        "en": "Gentle and compassionate home veterinarians"
      },
      "text": {
        "en": "Pet owners overwhelmingly commend Dr Victoria Pugnetti, Dr Gina Sarnelli, and Dr Kristin Falcone for their profound empathy and gentleness during in-home euthanasia visits. Families note that the veterinarians explain every step calmly, giving owners space to grieve, though one client reported an unsympathetic telephone call."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 76,
      "title": {
        "en": "Dignified care for senior pets"
      },
      "text": {
        "en": "Clients express heartfelt gratitude for the respectful way their dogs and cats are treated during their final moments. Reviewers emphasize that the veterinarians sit with pets, offer comforting treats, and ensure animals remain completely peaceful and comfortable in familiar surroundings without distress."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 61,
      "title": {
        "en": "Peaceful transitions in home comfort"
      },
      "text": {
        "en": "Families widely value being able to say goodbye to their companion animals at home rather than in a clinical hospital setting. Reviews describe peaceful, dignified, and gentle passings surrounded by family, highlighting how much comfort this provides during an emotionally demanding transition."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does All About Restful Pets provide in-home pet euthanasia?"
      },
      "a": {
        "en": "Yes, the mobile veterinary service specializes in compassionate, gentle end-of-life care and pet euthanasia within owners' homes."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do the veterinarians explain each stage of the euthanasia process?"
      },
      "a": {
        "en": "Yes, clients frequently report that visiting veterinarians explain every medical step thoroughly and allow families to proceed at their own pace."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can aftercare and cremation services be arranged through the visit?"
      },
      "a": {
        "en": "Yes, pet owners mention that respectful transportation and communal or private cremation arrangements are coordinated smoothly."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is home euthanasia available for both dogs and cats?"
      },
      "a": {
        "en": "Yes, reviewers confirm using the in-home service for elderly dogs, cats, and companion animals suffering from terminal medical conditions."
      },
      "basis": "reviews"
    }
  ],
