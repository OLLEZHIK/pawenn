  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "en": "Caring vets and welcoming reception"
      },
      "text": {
        "en": "Pet owners consistently praise Dr. Bob, Dr. Miyamoto, Dr. Hooper, and the veterinary team at this East Greenway Road clinic for their patience and genuine compassion. Many long-term clients have visited for decades, though one reviewer noted a brusque early-morning reception encounter."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Gentle care for pets and exotics"
      },
      "text": {
        "en": "Reviewers frequently highlight how calmly the veterinarians and technicians handle nervous dogs, cats, and small exotic pets including rabbits, rats, hamsters, and box turtles. Owners of anxious or protective dogs appreciate that examinations are never rushed."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Thorough explanations and follow-up calls"
      },
      "text": {
        "en": "Most clients value how clearly the doctors explain diagnoses and treatment options, alongside prompt text reminders, email summaries, and next-day check-in calls. Two reviewers, however, reported unclear upfront cost estimates or miscommunication over third-party pharmacy orders."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does All Creatures Animal Clinic treat exotic pets?"
      },
      "a": {
        "en": "Yes, the clinic treats exotic animals, and reviewers mention bringing rabbits, hamsters, rats, and box turtles for care."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are appointments required at All Creatures Animal Clinic?"
      },
      "a": {
        "en": "Yes, visits are by appointment with online booking available, though several clients note securing same-day slots for urgent pet concerns."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the clinic communicate after veterinary visits?"
      },
      "a": {
        "en": "Clients report receiving text appointment reminders, detailed email summaries after exams, and follow-up phone calls to check on recovering pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What payment methods are accepted at the clinic?"
      },
      "a": {
        "en": "The clinic accepts credit and debit card payments, and reviewers note the convenience of paying directly inside the examination room."
      },
      "basis": "both"
    }
  ],
