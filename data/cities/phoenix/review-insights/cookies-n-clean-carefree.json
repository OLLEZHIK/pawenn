  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Thorough grooming and tidy trims"
      },
      "text": {
        "en": "Dog owners consistently highlight tidy haircuts, thorough deshedding treatments, and pleasant-smelling coats after appointments. Clients frequenting the self-wash stations appreciate the heavy-duty tubs, warm water, and professional blow dryers that make bathing effortless. While one cat owner was dissatisfied with a mobile trim, most reviewers praise the clean results."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Calm handling and complimentary treats"
      },
      "text": {
        "en": "Clients regularly note how relaxed their dogs remain during bathing and professional styling sessions. Reviewers appreciate that groomers handle anxious pets with patience, reducing stress for dogs that dislike nail trimming. Pet parents also mention that dogs eagerly anticipate visits thanks to the signature baked cookies offered at checkout."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Welcoming and accommodating salon staff"
      },
      "text": {
        "en": "Pet owners praise the front-desk team and groomers for their polite greetings, helpful tub demonstrations, and attentive customer service. Reviewers note that assistants readily supply extra towels, brushes, and specialised shampoos without hesitation. Although one client reported an unhelpful dispute regarding a mobile service fee, the staff is widely commended."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What supplies are provided at the self-serve dog wash?"
      },
      "a": {
        "en": "The facility supplies elevated wash tubs, warm water, aprons, specialised shampoos, towels, brushes, and high-velocity dryers."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are treats provided for pets after their wash?"
      },
      "a": {
        "en": "Yes, clients highlight that pets receive fresh gourmet dog cookies as a reward following bathing or grooming."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners book full-service professional grooming?"
      },
      "a": {
        "en": "Yes, the salon provides full grooming appointments including baths, breed-specific haircuts, and nail clipping."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is walk-in self-service washing available without an appointment?"
      },
      "a": {
        "en": "Yes, reviewers frequently use the self-serve washing stations on a walk-in basis during regular operating hours."
      },
      "basis": "reviews"
    }
  ],
