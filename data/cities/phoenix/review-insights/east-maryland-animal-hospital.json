  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Friendly and attentive veterinary team"
      },
      "text": {
        "en": "Clients frequently commend the veterinarians and veterinary technicians for their warm, attentive care and thorough medical expertise. Multiple pet parents highlight clinicians like Dr Lawrence and Dr Ghuzlan for their reassuring presence and unhurried examinations. Longtime clients who have visited for years emphasize that the reception and nursing staff remain consistently welcoming."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Gentle treatment for anxious pets"
      },
      "text": {
        "en": "Reviewers frequently remark on how tenderly the clinical team handles nervous, rescued, or elderly dogs and cats. Owners appreciate that technicians take extra time to offer cuddles and comfort to frightened pets, making check-ups far less stressful. Several families note that their anxious pets relaxed visibly during routine vaccination visits and diagnostic exams."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 9,
      "title": {
        "en": "Informative consultations and treatment plans"
      },
      "text": {
        "en": "Pet owners value the clear explanations provided regarding senior wellness checks, diet recommendations, and proposed therapies. Clinicians are praised for answering questions thoughtfully and listening closely to owner observations. While one client felt that add-on costs under wellness plans required clearer guidance, most reviewers describe transparent and helpful discussions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does East Maryland Animal Hospital offer preventative wellness plans?"
      },
      "a": {
        "en": "Yes, pet parents mention using the clinic's wellness plans to cover routine vaccinations, exams, and preventative procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are appointments available for newly adopted or nervous pets?"
      },
      "a": {
        "en": "Yes, reviewers note that the team accommodates anxious rescues with calm, low-stress examinations and unhurried introductions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pet parents remain with animals during examinations?"
      },
      "a": {
        "en": "Yes, clients appreciate staying alongside their pets in the examination room throughout health assessments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What services are provided for senior dogs and cats?"
      },
      "a": {
        "en": "The hospital offers senior wellness checks, comprehensive blood panels, chronic pain management, and nutritional advice."
      },
      "basis": "reviews"
    }
  ],
