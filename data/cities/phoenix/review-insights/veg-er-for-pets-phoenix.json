  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 98,
      "title": {
        "en": "Empathetic and responsive emergency team"
      },
      "text": {
        "en": "Clients frequently praise the emergency doctors, nurses, and technicians for their rapid triage, calmness, and profound empathy during frightening medical crises. Reviewers note that clinical staff listen attentively and explain immediate care options clearly, though a few clients experienced rushed or insensitive interactions during peak hours."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 74,
      "title": {
        "en": "Compassionate care for distressed pets"
      },
      "text": {
        "en": "Pet owners consistently highlight the tender and respectful manner in which sick or injured animals are treated. Reviewers appreciate that veterinary teams prioritize pain relief, soothe terrified dogs and cats, and manage delicate end-of-life moments with the utmost dignity, ensuring pets feel protected."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Open-concept emergency hospital facility"
      },
      "text": {
        "en": "Reviewers enthusiastically commend VEG's unique open hospital layout, which permits owners to remain by their pet's side throughout all examinations, tests, and treatments. Clients describe the facility as clean, comfortable, and reassuring, offering seating and refreshments that ease long emergency stays."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can owners remain with their pets during emergency treatment?"
      },
      "a": {
        "en": "Yes, clients emphasize that VEG's open-floor model allows pet owners to stay by their pet's side through every examination and procedure."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the hospital open 24/7 for pet emergencies?"
      },
      "a": {
        "en": "Yes, the practice operates around the clock every day of the year for urgent and critical pet healthcare."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the triage process work upon arrival?"
      },
      "a": {
        "en": "Reviewers note that emergency personnel assess critical patients immediately upon entry to stabilize pets without delay."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital treat exotic animals as well as dogs and cats?"
      },
      "a": {
        "en": "Yes, the practice accepts avian and exotic pets in addition to dogs and cats for emergency treatment."
      },
      "basis": "both"
    }
  ],
