  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "de": "Riesiges Sortiment mit BARF und Snackbars",
        "en": "Huge assortment with raw food snacks"
      },
      "text": {
        "de": "Tierbesitzer loben das außergewöhnlich breite Angebot, das von Premium-Nassfutter über BARF-Tiefkühlkost bis hin zu Vogelbedarf und Hundegeschirren reicht. Die offene Snackbar mit Kausnacks und die Markenvielfalt kommen sehr gut an. Vereinzelt wurde bemerkt, dass manche Spezialsorten zeitweise vergriffen waren.",
        "en": "Pet owners praise the extensive selection ranging from premium wet foods and raw frozen BARF supplies to bird care and harnesses. The open dog snack bar and broad brand variety receive positive mentions. Occasionally, reviewers note that specific specialty flavors were temporarily missing from shelves."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "de": "Sehr hilfsbereiter und kompetenter Kundenservice",
        "en": "Supportive and competent customer service"
      },
      "text": {
        "de": "Die Mitarbeiter werden für ihre Freundlichkeit, Fachkompetenz und Geduld bei Ernährungsfragen geschätzt. Kunden heben hervor, dass bei technischen Störungen an den Servicegeräten unkompliziert und kulant geholfen wird. Das Team sorgt für eine einladende Atmosphäre für Tierhalter und begleitende Hunde.",
        "en": "Store staff receive warm feedback for their friendly guidance, knowledge, and patience with nutrition questions. Shoppers note that personnel handle machine hiccups swiftly with generous goodwill. The team maintains an accommodating atmosphere for visiting pet owners and their four-legged companions."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 10,
      "title": {
        "de": "Moderne Ausstattung mit Hundewaschstation und Waschsalon",
        "en": "Modern store with pet washing stations"
      },
      "text": {
        "de": "Der Markt überzeugt durch Sauberkeit, Übersichtlichkeit und moderne Selbstbedienungskassen. Ein besonderes Merkmal sind die Hunde-Duschstation sowie Außenwaschmaschinen für große Decken. Samstags kann es auf dem Parkplatz enger werden, und ein Rezensent mahnte hygienische Vorsicht bei offenen Näpfen an.",
        "en": "The store stands out with its clean, structured aisles and modern self-checkout options. Unique standout amenities include a self-service dog wash station and heavy-duty outdoor laundry machines for pet blankets. Parking can be tight on Saturdays, and one review cautioned regarding open community water bowls."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Gibt es eine Waschstation für Hunde und Decken?",
        "en": "Are washing stations for dogs and blankets available?"
      },
      "a": {
        "de": "Ja, vor dem Markt gibt es eine Hundedusche sowie Großwaschmaschinen für Tier- und Pferdedecken.",
        "en": "Yes, the store provides an outdoor dog shower as well as heavy-duty washing machines for pet blankets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Bietet der Markt BARF-Produkte an?",
        "en": "Does the store carry raw BARF pet food?"
      },
      "a": {
        "de": "Ja, Kunden heben eine große Auswahl an BARF-Tiefkühlkost und passenden Futterzusätzen hervor.",
        "en": "Yes, customers highlight an extensive selection of frozen BARF meats and dietary supplements."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Gibt es Selbstbedienungskassen im Markt?",
        "en": "Are self-checkout registers available?"
      },
      "a": {
        "de": "Ja, neben regulären Kassen stehen moderne SB-Kassen für schnelles Bezahlen zur Verfügung.",
        "en": "Yes, modern self-checkout terminals are available alongside traditional cash registers."
      },
      "basis": "reviews"
