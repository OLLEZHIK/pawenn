  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "de": "Freundliche Beratung und hilfsbereites Team",
        "en": "Helpful customer advice and service"
      },
      "text": {
        "de": "Kunden loben die hilfsbereite und sachkundige Beratung im Markt, insbesondere in der Aquaristikabteilung und beim Nagerzubehör. Das Personal unterstützt verlässlich bei der Produktauswahl und bei Click-und-Collect-Bestellungen. Vereinzelt wurde unnahbares Auftreten einzelner Mitarbeiter angemerkt.",
        "en": "Shoppers frequently praise the knowledgeable and friendly guidance provided across departments, particularly for aquaristics and small animals. Staff members reliably assist with finding items and picking up click-and-collect orders. Occasional isolated remarks note indifferent service from individual clerks."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 17,
      "title": {
        "de": "Breite Auswahl mit einzelnen Lücken",
        "en": "Wide selection with occasional stock gaps"
      },
      "text": {
        "de": "Besucher heben die große Auswahl an Tiernahrung, Leckerlis und Aquaristikbedarf für Hunde, Katzen und Fische hervor. Viele Kunden finden verlässlich bekannte Marken. Allerdings merken mehrere Rezensenten an, dass medizinische Spezialnahrung, Katzengras oder Diätfutter wiederholt vergriffen oder Regale zeitweise leer waren.",
        "en": "Visitors highlight the extensive range of pet food, treats, and aquatics supplies for dogs, cats, and fish. Most shoppers reliably find popular brands. However, several reviewers note that specialized veterinary diets, fresh cat grass, or specific nutrition lines were repeatedly out of stock or shelves looked bare."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "de": "Große Verkaufsfläche mit eigenen Parkplätzen",
        "en": "Spacious store layout with parking"
      },
      "text": {
        "de": "Der Markt überzeugt Besucher durch seine übersichtliche Gestaltung, breite Gänge und den barrierefreien Zugang direkt vom Parkplatz. Kunden schätzen die bequeme Erreichbarkeit mit dem Auto. Vereinzelt wurde ein unangenehmer Tiergeruch im Laden oder zeitweise Unordnung in Teilbereichen kritisiert.",
        "en": "Customers appreciate the spacious floor plan, clearly arranged aisles, and step-free access straight from the dedicated parking lot. Reaching the location by car is seen as very convenient. Occasional reviews mention noticeable animal odors indoors or temporary clutter in specific sections."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Gibt es Parkmöglichkeiten vor der Filiale?",
        "en": "Is customer parking available on site?"
      },
      "a": {
        "de": "Ja, Kunden heben die zahlreichen kostenfreien Parkplätze direkt vor dem Geschäftseingang hervor.",
        "en": "Yes, customers highlight the ample free parking spaces located directly in front of the store entrance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Wird Click und Collect angeboten?",
        "en": "Is click and collect service available?"
      },
      "a": {
        "de": "Ja, Online-Bestellungen können zur Abholung in der Filiale Farmsen hinterlegt und dort abgeholt werden.",
        "en": "Yes, online orders can be collected directly at the Farmsen store branch."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Gibt es eine eigene Aquaristikabteilung?",
        "en": "Does this branch have an aquarium section?"
      },
      "a": {
        "de": "Ja, der Markt verfügt über eine gut ausgestattete Aquaristikabteilung mit Zubehör und Beratung.",
        "en": "Yes, the store features a well-equipped aquaristics section offering accessories and advice."
      },
      "basis": "reviews"
    }
