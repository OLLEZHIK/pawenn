  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 42,
      "title": {
        "de": "Engagierte Ärzte mit gemischten Eindrücken",
        "en": "Dedicated doctors with mixed feedback"
      },
      "text": {
        "de": "Viele Kunden schätzen den pragmatischen Einsatz und die jahrzehntelange Erfahrung der behandelnden Tierärzte sehr. Demgegenüber äußern etliche Tierhalter deutliche Kritik am forschen Auftreten einzelner Ärzte sowie an der teils ungeduldigen Kommunikation am Empfangstresen.",
        "en": "Many clients deeply value the pragmatic dedication and long-standing experience of the treating veterinarians. In contrast, several pet owners express clear criticism regarding an abrupt communication style from certain staff members and tense reception interactions."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 23,
      "title": {
        "de": "Chirurgische Eingriffe mit geteilten Meinungen",
        "en": "Surgical treatments with divided experiences"
      },
      "text": {
        "de": "Zahlreiche Halter berichten von geglückten Operationen, Tumorbehandlungen und spürbaren gesundheitlichen Verbesserungen ihrer Tiere. Allerdings wird vereinzelt von unerwarteten postoperativen Komplikationen und strittigen Behandlungsansätzen bei komplexen Krankheitsverläufen berichtet.",
        "en": "Numerous guardians report successful surgeries, tumor removals, and marked health improvements for their beloved pets. However, isolated reviews recount disputed treatment paths, differing medical conclusions, and unexpected post-operative complications during complex recovery phases."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 18,
      "title": {
        "de": "Erhebliche Wartezeiten und hohes Aufkommen",
        "en": "Considerable waiting times and crowded rooms"
      },
      "text": {
        "de": "Zwar schätzen viele die Möglichkeit, akute Fälle ohne festen Termin vorzustellen, doch führt dies regelmäßig zu extrem langen Wartezeiten. Besucher berichten von überfüllten Räumen und zeitweiser Hektik im Praxisablauf, was für gestresste Tiere eine erhebliche Belastung darstellt.",
        "en": "Although clients appreciate the option to walk in without a fixed appointment for acute cases, this frequently results in very long waiting periods. Reviews describe crowded waiting zones and rushed workflows, which can cause significant distress for already agitated animals."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Benötigt man für den Besuch einen festen Termin?",
        "en": "Do clients need an appointment to visit?"
      },
      "a": {
        "de": "Die Praxis bietet offene Sprechstunden an, sodass Patienten auch ohne vorherige Terminvereinbarung vorbeikommen können.",
        "en": "The practice offers open walk-in consultation hours, allowing patients to arrive without a scheduled appointment."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden in der Praxis Operationen durchgeführt?",
        "en": "Are surgical procedures performed at the clinic?"
      },
      "a": {
        "de": "Ja, das Team führt sowohl Routineeingriffe als auch spezialisierte Weichteil- und Knochenoperationen durch.",
        "en": "Yes, the team performs routine procedures as well as specialized soft tissue and bone surgeries."
      },
      "basis": "website"
    },
    {
      "q": {
        "de": "Hat die Praxis auch am Wochenende geöffnet?",
        "en": "Is the practice open on weekends?"
      },
      "a": {
        "de": "Die Praxis bietet am Samstagvormittag reguläre Sprechzeiten für Kleintiere an.",
        "en": "The practice offers regular consultation hours on Saturday mornings for small animals."
      },
      "basis": "both"
    }
  ],
