  "google_maps_url": "https://www.google.com/maps/place/felmo+Mobiler+Tierarzt+Hamburg/@53.6050408,9.9792362,17z/data=!3m1!4b1!4m6!3m5!1s0x47b189458b2e857f:0x29e930c39b522a8e!8m2!3d53.6050408!4d9.9792362!16s%2Fg%2F11ny2glch0?authuser=0&hl=de&entry=ttu&g_ep=EgoyMDI2MDkzMC4wIKXMDSoASAFQAw%3D%3D",
  "period_from": "2026-04-06",
