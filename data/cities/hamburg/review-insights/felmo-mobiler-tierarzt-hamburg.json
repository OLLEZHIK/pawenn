  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 131,
      "title": {
        "de": "Einfühlsame Tierärzte bei Hausbesuchen",
        "en": "Compassionate veterinarians on home visits"
      },
      "text": {
        "de": "Tierhalter schätzen das freundliche Auftreten und die ruhige Geduld der mobilen Tierärzte bei Untersuchungen daheim. Behandlungsansätze und Befunde werden ausführlich und verständlich dargelegt. In Einzelfällen wünschen sich Besitzer bei schwierigen Patienten noch etwas mehr praktische Routine.",
        "en": "Pet owners appreciate the friendly attitude and calm patience shown by visiting veterinarians during home consultations. Medical findings and care steps are explained in clear detail. In rare cases, clients feel that practitioners could show greater routine when treating restless pets."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 77,
      "title": {
        "de": "Stressfreie Untersuchung in vertrauter Umgebung",
        "en": "Stress-free examinations in familiar surroundings"
      },
      "text": {
        "de": "Zahlreiche Berichte heben den großen Vorteil für ängstliche Katzen und Hunde hervor, denen die Fahrt im Transportkorb erspart bleibt. Die Tiere bleiben in ihrer gewohnten Wohnung meist deutlich gelassener. Vereinzelt reagieren sensible Vierbeiner jedoch auch auf fremden Besuch gestresst.",
        "en": "Many reviews highlight the major relief for anxious cats and dogs who do not have to endure stressful travel in a carrier. Most animals remain far more relaxed in their home environment. Occasionally, sensitive pets still react with stress when an unfamiliar practitioner enters their space."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "de": "Bequeme Terminbuchung mit Zeitfenstern",
        "en": "Convenient scheduling with arrival windows"
      },
      "text": {
        "de": "Kunden loben die unkomplizierte Terminvergabe über die App sowie die pünktliche Einhaltung der vereinbarten Besuchszeiten. Die zeitnahe Organisation von Hausbesuchen erleichtert den Alltag vieler Halter erheblich. Selten führen kurzfristige Absagen oder Verschiebungen zu Enttäuschungen.",
        "en": "Clients praise the convenient appointment booking through the app and reliable adherence to agreed arrival times. Having quick access to home visits makes everyday pet care significantly easier to manage. Rarely, unexpected schedule adjustments or cancellations cause disappointment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Wie läuft ein Hausbesuch von felmo ab?",
        "en": "How does a felmo home visit work?"
      },
      "a": {
        "de": "Der Tierarzt reist mit medizinischer Ausrüstung an und untersucht das Tier direkt in der gewohnten häuslichen Umgebung.",
        "en": "The veterinarian arrives with medical equipment to examine and treat the pet directly in its familiar home environment."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Für welche Tierarten ist der mobile Dienst gedacht?",
        "en": "Which pets does the mobile service treat?"
      },
      "a": {
        "de": "Das mobile Angebot richtet sich hauptsächlich an Hunde und Katzen im Hamburger Stadtgebiet.",
        "en": "The mobile service is designed primarily for dogs and cats across the Hamburg metropolitan area."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Wie erfolgt die Bezahlung der Behandlung?",
        "en": "How is payment handled after the appointment?"
      },
      "a": {
        "de": "Die Abrechnung erfolgt bargeldlos nach dem Besuch über gängige Kartenzahlung oder direkt über das Kundenkonto der App.",
        "en": "Payment is handled cashless after the examination via standard card payment or directly through the app account."
      },
      "basis": "both"
    }
  ],
