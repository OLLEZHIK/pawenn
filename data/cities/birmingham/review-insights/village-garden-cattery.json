  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "en": "Content and relaxed feline guests"
      },
      "text": {
        "en": "Cat owners overwhelmingly report that their pets return home calm, relaxed, and happy after staying at the cattery. Reviewers frequently describe cats settling back into household routines without stress, even among elderly or naturally timid felines. Clients value that staff spend dedicated time pampering and brushing each boarding guest."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Reassuring updates from attentive carers"
      },
      "text": {
        "en": "Reviewers warmly praise Donna, Lee, Bibi, and the cattery team for their warm hospitality and attentiveness. Anxious owners particularly appreciate receiving regular photo updates and messages showing their pets relaxing in their pens while families are away on holiday. Clients consistently highlight the reassuring, cat-loving staff culture."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Spacious pens in garden setting"
      },
      "text": {
        "en": "Visitors highlight the peaceful country garden environment and the layout of the accommodation. Reviewers describe the boarding pens as clean, well-ventilated, and spacious, featuring separate sleeping quarters and outdoor vantage areas where cats can watch wildlife. Pet owners frequently refer to the facility as a comfortable cat hotel."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Where is Village Garden Cattery located?"
      },
      "a": {
        "en": "The cattery is located in a quiet garden setting on Bickenhill Lane near Catherine-de-Barnes and Marston Green, Birmingham."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do owners receive progress updates while away?"
      },
      "a": {
        "en": "Yes, reviewers frequently praise the team for sending reassuring messages and photos of their cats during boarding."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can elderly or timid cats be accommodated?"
      },
      "a": {
        "en": "Yes, clients note that senior cats up to 17 years old and nervous rescues receive gentle, tailored attention."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What features do the boarding pens include?"
      },
      "a": {
        "en": "Reviewers describe spacious multi-level pens with heated indoor sleeping areas and outdoor runs overlooking the garden."
      },
      "basis": "both"
    }
  ],
