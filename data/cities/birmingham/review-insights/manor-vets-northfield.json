    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Friendly and reassuring veterinary team"
      },
      "text": {
        "en": "Pet owners consistently commend the receptionists, nurses, and vets for their approachable and respectful service. Reviewers appreciate that veterinary surgeons explain diagnostic options and medication plans in clear detail without pressure. Clients with longstanding pets frequently mention deep trust in the team across many years of visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Patient and gentle pet handling"
      },
      "text": {
        "en": "Reviewers emphasize how thoughtfully veterinarians treat anxious dogs and cats, giving nervous animals space and time to relax. Clients appreciate gentle handling during first puppy vaccinations, cat neutering, and emergency checks. Multiple owners mention that even timid rescue pets feel settled and calm in the consulting rooms."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 10,
      "title": {
        "en": "Effective clinical treatments and surgery"
      },
      "text": {
        "en": "Clients report dependable outcomes for medical treatments, routine health checks, and minor surgeries such as cat neutering. Pet owners appreciate prompt intervention during emergencies, including foreign object removal and acute illness recovery. Reviewers express confidence in the post-treatment care and medication plans provided."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can urgent cases receive same-day veterinary appointments?"
      },
      "a": {
        "en": "Yes, clients frequently report receiving same-day appointments and prompt nurse triage for urgent conditions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Manor Vets Northfield offer kitten or puppy vaccination packages?"
      },
      "a": {
        "en": "Yes, reviewers mention comprehensive puppy and kitten starter packages covering vaccinations, microchipping, and food."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the practice handle anxious or fearful pets?"
      },
      "a": {
        "en": "Veterinarians allow nervous pets extra time to adjust, examining them gently without rushing or unnecessary restraint."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where are out-of-hours emergencies directed?"
      },
      "a": {
        "en": "Out-of-hours emergency calls are redirected to the nearby Blaise Veterinary Hospital on Bristol Road South."
      },
      "basis": "reviews"
    }
