  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 67,
      "title": {
        "en": "Direct instruction and structured coaching"
      },
      "text": {
        "en": "Dog owners widely commend Adam for his confident, clear, and no-nonsense coaching during group sessions and private lessons. Reviewers highlight his deep understanding of canine body language, noting that his firm guidance educates owners on handling techniques just as much as it trains the dogs, instilling practical confidence in handlers."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "en": "Marked improvement in lead reactivity"
      },
      "text": {
        "en": "Clients report substantial behavioural turnarounds after training, particularly with excessive pulling, reactivity towards other dogs, and recall reliability. Many owners note that dogs who were previously stressful to walk outside became manageable and focused after applying the structured heelwork and boundary exercises taught in class."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "en": "Confidence with large and reactive breeds"
      },
      "text": {
        "en": "Reviewers frequently praise the training programme for successfully managing powerful working dogs, including German Shepherds, Rottweilers, and Akitas. Owners appreciate that reactive and easily distracted dogs learn to remain composed around other animals, though a couple of reviewers found the corrective tools more traditional than expected."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does MidlandsGrizzlys work with reactive or aggressive dogs?"
      },
      "a": {
        "en": "Yes, reviewers frequently bring highly reactive dogs and report significant improvements in social exposure and control."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are classes suitable for large and powerful dog breeds?"
      },
      "a": {
        "en": "Multiple clients note successful training outcomes with large breeds such as German Shepherds, Rottweilers, and Akitas."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What training style is used during the sessions?"
      },
      "a": {
        "en": "Sessions focus on structured handler leadership, firm boundary setting, and lead control to establish clear communication with the dog."
      },
      "basis": "reviews"
    }
  ],
