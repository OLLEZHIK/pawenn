    {
      "q": {
        "en": "Can Kitty Angels administer complex medications or injections?"
      },
      "a": {
        "en": "Yes, sitters routinely handle oral medications, ear creams, insulin, and prescribed fluids for senior cats."
      },
      "basis": "reviews"
    },
    {
