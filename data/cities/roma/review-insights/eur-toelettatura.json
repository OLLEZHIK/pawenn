  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 53,
      "title": {
        "it": "Esperienza pluriennale e precisione organizzativa",
        "en": "Longstanding expertise and dedicated care"
      },
      "text": {
        "it": "Il personale di Eur Toelettatura e le titolari ricevono ampio consenso per la professionalità, la dedizione e la precisione organizzativa. I clienti storici confermano una fiducia decennale nel salone all'EUR, sebbene un piccolo gruppo di recensioni critiche segnali rigidità nell'applicazione delle regole di cancellazione e ritardo.",
        "en": "The team at Eur Toelettatura and its managers earn extensive recognition for professional skill, dedication, and organizational efficiency. Longstanding clients confirm decades of satisfaction at the EUR salon, though a minor fraction of critical reviews reported strict enforcement of late arrival and cancellation policies."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "it": "Tagli a forbice e toeletta impeccabile",
        "en": "Scissor styling and show-quality grooming"
      },
      "text": {
        "it": "I proprietari sottolineano la qualità superiore dei tagli a forbice, dello stripping e dei lavaggi, con particolare competenza su razze come cocker spaniel e cavalier king. I cani escono puliti, profumati e con un manto brillante e morbido, curato nei minimi dettagli e conforme agli standard estetici ufficiali.",
        "en": "Pet guardians highlight top-tier workmanship across scissor trimming, hand stripping, and hygiene baths, with notable skill on breeds like cocker spaniels and cavalier kings. Dogs leave thoroughly clean, pleasantly fragranced, and with soft, lustrous coats styled strictly according to breed standards."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "it": "Attenzione delicata e cani sereni",
        "en": "Gentle handling and relaxed pets"
      },
      "text": {
        "it": "Nelle opinioni ricorre la dolcezza con cui i toelettatori approcciano cani e cuccioli, creando un ambiente tranquillo che riduce l'ansia da manipolazione. I quattro zampe vengono descritti come felici di entrare nel salone, trattati con rispetto e affetto durante la spazzolatura e l'asciugatura.",
        "en": "Customer opinions frequently note the kindness with which groomers approach dogs and puppies, establishing a tranquil setting that eases handling anxiety. Four-legged guests are described as enthusiastic when entering the salon, receiving gentle, respectful attention throughout brushing and drying."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "Il salone esegue stripping e taglio a forbice per razze specifiche?",
        "en": "Does the salon perform hand stripping and scissor styling for specific breeds?"
      },
      "a": {
        "it": "Sì, i clienti evidenziano grande competenza nello stripping e nella rifinitura a forbice, in particolare per cocker spaniel.",
        "en": "Yes, clients emphasize exceptional expertise in hand stripping and scissor trimming, particularly for cocker spaniels."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "Come vengono gestiti i ritardi agli appuntamenti?",
        "en": "How are appointment delays handled by the salon?"
      },
      "a": {
        "it": "Il salone applica regole organizzative rigorose sulla puntualità degli orari per garantire il benessere di tutti i clienti.",
        "en": "The salon maintains strict scheduling rules regarding punctuality to safeguard the appointment flow for all clients."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "È necessario prenotare con anticipo?",
        "en": "Is advance booking required for grooming appointments?"
      },
      "a": {
        "it": "Sì, dato l'elevato afflusso di clienti è consigliabile prenotare l'appuntamento con debito anticipo.",
        "en": "Yes, given high customer volume, booking appointments well in advance is recommended."
      },
      "basis": "reviews"
    }
  ],
