  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "it": "Competenza ed empatia del personale",
        "en": "Professional competence and staff empathy"
      },
      "text": {
        "it": "Numerosi clienti lodano l'équipe di veterinari e infermieri per la grande professionalità, la disponibilità e la dedizione mostrata nell'accogliere animali in situazioni critiche. I proprietari si sentono rassicurati da spiegazioni chiare e attenzioni costanti, sebbene alcune recensioni lamentino un approccio talvolta percepito come distaccato.",
        "en": "Many pet owners praise the veterinary and nursing team for their high competence, helpfulness, and dedication when admitting animals in critical states. Families feel reassured by clear clinical explanations and attentive care, although a few reviews note occasional perceptions of a more detached corporate approach."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "it": "Struttura moderna e tecnologie avanzate",
        "en": "Modern facility and advanced equipment"
      },
      "text": {
        "it": "La clinica si distingue come una struttura sanitaria all'avanguardia, dotata di sale operatorie moderne, diagnostica per immagini e reparti puliti e ben organizzati per la degenza. I proprietari apprezzano l'efficienza degli ambienti ospedalieri e la disponibilità continua di strumentazioni necessarie per gestire esami complessi sul posto.",
        "en": "The clinic stands out as a state-of-the-art veterinary hospital, equipped with modern operating rooms, advanced diagnostic imaging, and clean, well-organized inpatient wards. Pet guardians appreciate the clean hospital setting and the immediate availability of equipment necessary to run comprehensive clinical exams on site."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 15,
      "title": {
        "it": "Interventi sanitari ed esiti clinici",
        "en": "Clinical outcomes and treatment results"
      },
      "text": {
        "it": "Molti proprietari esprimono gratitudine per diagnosi tempestive e cure efficaci che hanno salvato la vita a cani e gatti con patologie gravi o traumi urgenti. Tuttavia, alcune testimonianze critiche riportano diagnosi contestate o decorsi clinici sfavorevoli, evidenziando esperienze contrastanti sui risultati delle terapie in casi ad alta complessità.",
        "en": "Many owners express deep gratitude for timely diagnoses and successful treatments that saved dogs and cats facing life-threatening trauma or acute illness. However, several critical reviews recount disputed diagnoses and difficult clinical outcomes, reflecting contrasting experiences regarding treatment success in complex emergency cases."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "La Clinica Veterinaria Borghesiana è aperta 24 ore su 24?",
        "en": "Is Clinica Veterinaria Borghesiana open 24/7?"
      },
      "a": {
        "it": "Sì, la struttura dispone di pronto soccorso veterinario attivo 24 ore su 24 per emergenze giorno e notte.",
        "en": "Yes, the facility operates a 24-hour veterinary emergency service active day and night."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "Vengono eseguite indagini diagnostiche sul posto?",
        "en": "Are on-site diagnostic investigations available?"
      },
      "a": {
        "it": "Sì, la clinica è dotata di strumentazioni avanzate per radiologia, ecografia ed esami di laboratorio immediati.",
        "en": "Yes, the clinic is equipped with advanced tools for radiology, ultrasound, and rapid laboratory testing."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "È presente un reparto di degenza per animali ricoverati?",
        "en": "Is there an inpatient hospital ward for admitted pets?"
      },
      "a": {
        "it": "Sì, la struttura offre reparti dedicati per il monitoraggio continuo e la degenza post-operatoria.",
        "en": "Yes, the hospital provides dedicated wards for continuous monitoring and post-operative recovery."
      },
      "basis": "reviews"
    }
  ],
