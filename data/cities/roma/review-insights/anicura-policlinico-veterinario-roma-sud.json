  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 59,
      "title": {
        "it": "Competenza medica e dedizione dello staff",
        "en": "Medical expertise and dedicated care"
      },
      "text": {
        "it": "La maggior parte dei clienti elogia l'elevata professionalità dei medici specialisti e la dedizione del personale infermieristico, ringraziando per l'assistenza continua in condizioni critiche. Non mancano tuttavia segnalazioni critiche che lamentano tempi di attesa prolungati in accettazione e momenti di comunicazione percepiti come sbrigativi.",
        "en": "Most clients praise the high medical expertise of specialist veterinarians and dedicated nursing staff, expressing gratitude for steady care during life-threatening crises. However, some critical reviews report lengthy triage waits and occasional communication perceived as hurried during busy emergency shifts."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "it": "Policlinico avanzato con pronto soccorso H24",
        "en": "Advanced hospital with 24/7 emergency care"
      },
      "text": {
        "it": "Il policlinico impressiona i visitatori per l'ampiezza degli spazi, la pulizia impeccabile e la disponibilità di tecnologie diagnostiche e chirurgiche di livello ospedaliero. I proprietari sottolineano l'importanza di avere un centro di riferimento aperto 24 ore su 24, attrezzato per gestire qualsiasi emergenza veterinaria complessa nella capitale.",
        "en": "The polyclinic impresses visitors with its extensive facilities, impeccable cleanliness, and hospital-grade diagnostic and surgical technologies. Pet guardians emphasize the value of having a round-the-clock emergency hospital fully equipped to handle complex veterinary emergencies across the metropolitan area."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 18,
      "title": {
        "it": "Cure salvavita ed esperienze terapeutiche",
        "en": "Life-saving care and clinical outcomes"
      },
      "text": {
        "it": "Numerosi clienti testimoniano con gratitudine interventi chirurgici salvavita, terapie intensive riuscite e recuperi straordinari di animali gravemente malati. Di contro, diverse testimonianze riferiscono diagnosi errate o complicazioni severe in pazienti fragili, mostrando come le aspettative cliniche possano variare fortemente in casi critici.",
        "en": "Numerous pet owners gratefully recount life-saving surgical operations, successful intensive care, and remarkable recoveries of critically ill animals. In contrast, several reviews recount disputed diagnoses or severe complications in fragile pets, illustrating varied outcomes and expectations in high-risk emergency cases."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "Il Policlinico Veterinario Roma Sud è sempre aperto per emergenze?",
        "en": "Is Policlinico Veterinario Roma Sud always open for emergencies?"
      },
      "a": {
        "it": "Sì, il pronto soccorso veterinario è operativo 24 ore su 24 tutti i giorni dell'anno senza interruzioni.",
        "en": "Yes, the emergency veterinary department operates 24 hours a day, 365 days a year without interruption."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "La struttura accetta anche animali non convenzionali?",
        "en": "Does the facility treat unconventional and exotic pets?"
      },
      "a": {
        "it": "Sì, il policlinico offre visite specialistiche per animali esotici, sebbene alcune recensioni consiglino di verificare gli orari del reparto.",
        "en": "Yes, the hospital provides specialized care for exotic animals, though some reviews advise verifying department schedules."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Come viene gestita la degenza intensiva degli animali ricoverati?",
        "en": "How is intensive inpatient care managed for hospitalized pets?"
      },
      "a": {
        "it": "Gli animali ricoverati sono monitorati costantemente dal personale medico e infermieristico nei reparti di terapia intensiva.",
        "en": "Hospitalized animals are monitored continuously by veterinary and nursing teams within dedicated intensive care units."
      },
      "basis": "reviews"
    }
  ],
