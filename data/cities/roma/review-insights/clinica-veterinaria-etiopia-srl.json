  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 68,
      "title": {
        "it": "Competenze specialistiche con pareri contrastanti",
        "en": "Specialist expertise with polarized opinions"
      },
      "text": {
        "it": "I medici della clinica Etiopia, tra cui il neurologo dottor Papa e il team di cardiologia, ricevono frequenti lodi per la prontezza e la sensibilità mostrate nei casi complessi. Tuttavia, diversi utenti segnalano episodi di scarsa empatia all'accettazione e comunicazioni giudicate fredde in momenti di sofferenza del paziente.",
        "en": "Veterinarians at Etiopia Clinic, including neurologist Dr. Papa and the cardiology team, receive frequent praise for their diagnostic readiness in intricate cases. Conversely, several reviewers note instances of perceived insensitivity at reception and communication described as detached during stressful patient visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 17,
      "title": {
        "it": "Interventi salvavita ed esiti controversi",
        "en": "Life-saving interventions and contested outcomes"
      },
      "text": {
        "it": "Molteplici proprietari testimoniano interventi d'urgenza risolutivi che hanno salvato cani e gatti da gravi crisi respiratorie o traumi acuti, lodando la rapidità diagnostica. Al contempo, alcune recensioni critiche lamentano diagnosi errate o terapie farmacologiche che non hanno arrestato il deterioramento clinico dell'animale.",
        "en": "Numerous pet owners report decisive emergency treatments that stabilized dogs and cats facing acute trauma or respiratory distress, praising rapid clinical diagnostics. At the same time, critical reviews recount contested diagnoses or medication regimens that failed to prevent further health deterioration in their companions."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 5,
      "title": {
        "it": "Perplessità sui costi delle prestazioni",
        "en": "Reservations regarding veterinary service costs"
      },
      "text": {
        "it": "Le valutazioni sui costi della struttura evidenziano diffuse perplessità tra i clienti. Diversi proprietari considerano i preventivi per esami specialistici e biopsie notevolmente superiori rispetto ad altre realtà cittadine, mentre solo pochi recensori definiscono i prezzi allineati al livello dei servizi erogati.",
        "en": "Feedback concerning clinic fees indicates widespread concern among visitors. Several pet owners perceive estimates for specialist tests and biopsies as substantially higher than standard urban averages, whereas only occasional reviewers describe the final costs as commensurate with the clinical services provided."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "La clinica dispone di specialisti in neurologia veterinaria?",
        "en": "Does the clinic offer veterinary neurology specialists?"
      },
      "a": {
        "it": "Sì, il dottor Papa è ampiamente citato dai proprietari per visite neurologiche specialistiche e gestione dell'epilessia.",
        "en": "Yes, Dr. Papa is frequently cited by clients for specialized neurological consultations and epilepsy management."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Il pronto soccorso è accessibile 24 ore su 24?",
        "en": "Is the emergency department accessible 24/7?"
      },
      "a": {
        "it": "Sì, la struttura gestisce emergenze continuative, anche se alcuni utenti segnalano attese prolungate nei giorni festivi.",
        "en": "Yes, the facility provides continuous emergency care, though some clients note extended waits on public holidays."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "I clienti ritengono i prezzi degli esami accessibili?",
