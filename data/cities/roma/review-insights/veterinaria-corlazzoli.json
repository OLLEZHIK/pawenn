  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 132,
      "title": {
        "it": "Competenza neurologica e disponibilità dello staff",
        "en": "Neurological expertise and supportive clinic team"
      },
      "text": {
        "it": "I clienti esprimono profonda gratitudine verso il dottor Corlazzoli e l'intera équipe medica per l'elevata preparazione clinica e l'empatia dimostrata durante visite complesse. Molti proprietari segnalano spiegazioni accurate dei quadri diagnostici e supporto rassicurante, sebbene alcuni riferiscano qualche difficoltà di comunicazione in segreteria.",
        "en": "Clients express heartfelt gratitude toward Dr. Corlazzoli and the medical team for their high clinical proficiency and empathy during intricate neurological consultations. Many pet owners note thorough diagnostic explanations and reassuring support, although an occasional reviewer mentions administrative lapses at reception."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 62,
      "title": {
        "it": "Cure dedicate per pazienti neurologici",
        "en": "Dedicated care for neurological patients"
      },
      "text": {
        "it": "Le recensioni descrivono una dedizione eccezionale verso cani e gatti affetti da gravi patologie cerebrali, spinali o ortopediche. Gli animali vengono gestiti con grande dolcezza e sensibilità, garantendo un monitoraggio continuo durante i ricoveri e percorsi di degenza studiati per ridurre al minimo lo stress e il dolore dei pazienti.",
        "en": "Pet owners describe extraordinary dedication toward dogs and cats suffering from severe spinal, brain, or orthopedic conditions. Animals are handled with gentleness and warmth, benefiting from careful inpatient monitoring and hospitalization protocols tailored to minimize pain and distress in delicate cases."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "it": "Struttura all'avanguardia e tecnologie moderne",
        "en": "State-of-the-art facility and modern technology"
      },
      "text": {
        "it": "I clienti descrivono la clinica sulla via Salaria come una struttura all'avanguardia, estremamente pulita, accogliente e dotata delle più avanzate tecnologie diagnostiche. La disponibilità di apparecchiature avanzate per risonanza magnetica e TAC consente accertamenti completi in un unico centro, offrendo tranquillità alle famiglie.",
        "en": "Clients describe the clinic on Via Salaria as a cutting-edge facility, exceptionally clean, comfortable, and equipped with the most advanced diagnostic technologies. The presence of on-site high-field MRI and CT imaging units allows comprehensive evaluations in a single center, providing immense peace of mind to visiting pet owners."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "La clinica è specializzata in neurologia e risonanza magnetica?",
        "en": "Is the clinic specialized in neurology and MRI imaging?"
      },
      "a": {
        "it": "Sì, la struttura è un centro di riferimento europeo per neurologia, neurochirurgia e diagnostica avanzata.",
        "en": "Yes, the facility is a recognized referral center for neurology, neurosurgery, and advanced imaging."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "Gli animali ricoverati ricevono assistenza continua?",
        "en": "Do hospitalized pets receive ongoing inpatient care?"
      },
      "a": {
        "it": "I proprietari confermano degenze controllate con monitoraggio medico attento per pazienti chirurgici o critici.",
        "en": "Owners confirm supervised inpatient stays with attentive medical monitoring for surgical or critical patients."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "I trattamenti consentono il recupero motorio di animali paralizzati?",
        "en": "Do the treatments help paralyzed animals regain mobility?"
      },
      "a": {
        "it": "Molte testimonianze documentano cani che sono tornati a camminare dopo interventi chirurgici e terapie mirate.",
        "en": "Many customer reviews document dogs regaining mobility and walking following surgery and targeted medical care."
      },
      "basis": "reviews"
    }
  ],
