  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 70,
      "title": {
        "it": "Chirurghi esperti e tensioni al triage",
        "en": "Skilled clinicians alongside triage tensions"
      },
      "text": {
        "it": "I clienti riconoscono l'elevata preparazione dei medici specialisti e dei chirurghi che hanno salvato animali in condizioni gravissime. Al contempo, diverse testimonianze lamentano una comunicazione fredda o distaccata da parte della reception e difficoltà nel contattare il centralino.",
        "en": "Clients acknowledge the high clinical skill of veterinary specialists and surgeons who intervened in critical, life-threatening conditions. Concurrently, several reviews complain of distant communication at front-desk triage and difficulties obtaining phone updates through the call center."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 44,
      "title": {
        "it": "Costi elevati per degenze ed esami",
        "en": "High rates for hospitalization and tests"
      },
      "text": {
        "it": "Numerosi clienti sollevano forti perplessità riguardo alle tariffe della clinica, giudicate molto alte rispetto ad altre strutture di Roma. Vengono contestati in particolare i costi delle notti di ricovero e le batterie di accertamenti diagnostici d'urgenza proposti dai medici.",
        "en": "Numerous clients raise strong concerns regarding the clinic's fee schedule, considered very expensive compared to other Rome facilities. Pet owners specifically criticize the high cost of overnight hospitalization stays and the extensive batteries of emergency diagnostic tests."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 30,
      "title": {
        "it": "Attese prolungate al pronto soccorso",
        "en": "Extended waiting times at emergency"
      },
      "text": {
        "it": "Una delle criticità più ricorrenti riguarda i tempi di attesa nella sala d'aspetto del pronto soccorso, spesso superiori alle due o tre ore. Gli utenti lamentano la scarsità di aggiornamenti sullo stato di salute degli animali e ritardi legati ai cambi di turno del personale.",
        "en": "One of the most frequent complaints centers on prolonged wait times in the emergency waiting area, frequently exceeding two or three hours. Reviewers express frustration over sparse updates regarding their pet's clinical state and disruptions caused by medical shift changes."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "Il Policlinico Gregorio VII dispone di pronto soccorso veterinario h24?",
        "en": "Does Policlinico Gregorio VII provide 24/7 emergency veterinary care?"
      },
      "a": {
        "it": "Sì, la struttura è attiva continuativamente 24 ore su 24 per emergenze veterinarie e ricoveri intensivi.",
        "en": "Yes, the facility operates around the clock for veterinary emergencies and intensive care admissions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Quali sono i tempi medi di attesa per le urgenze non critiche?",
        "en": "What are the average wait times for non-critical emergencies?"
      },
      "a": {
        "it": "Le recensioni segnalano che per i codici meno urgenti l'attesa in pronto soccorso può superare le due o tre ore.",
        "en": "Client reviews indicate that waiting times for less urgent triage codes can exceed two to three hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "È possibile ricoverare animali per terapia intensiva e degenza post-operatoria?",
        "en": "Can companion animals be hospitalized for intensive care and postoperative stays?"
      },
      "a": {
        "it": "Sì, il policlinico dispone di reparti di degenza attrezzati per il monitoraggio continuo dei pazienti critici.",
        "en": "Yes, the hospital maintains inpatient wards equipped for continuous monitoring of critical pet patients."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Come vengono giudicati i costi dei servizi e del ricovero?",
        "en": "How do reviewers view the costs of services and overnight stays?"
      },
      "a": {
        "it": "Diversi clienti ritengono le tariffe elevate, specialmente per i costi giornalieri di degenza e per esami specialistici.",
        "en": "Multiple reviewers consider prices steep, especially for daily hospitalization fees and specialized diagnostic panels."
