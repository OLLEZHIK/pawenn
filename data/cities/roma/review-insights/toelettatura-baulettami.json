  "google_maps_url": "https://www.google.com/maps/place/Toelettatura+Baulettami/@41.8569064,12.5688523,17z/data=!3m1!4b1!4m6!3m5!1s0x1325893a148f2975:0xfbdd2f29d7f43a38!8m2!3d41.8569064!4d12.5688523!16s%2Fg%2F11t8c0h1sy?authuser=0&hl=it&entry=ttu&g_ep=EgoyMDI2MTAwNy4wIKXMDSoASAFQAw%3D%3D",
