  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "it": "Cura attenta del benessere e video giornalieri",
        "en": "Attentive pet welfare and daily video updates"
      },
      "text": {
        "it": "I quattro zampe affidati alla pensione o impegnati nei corsi sportivi vengono seguiti con profondo rispetto delle loro esigenze emotive e fisiche. I proprietari evidenziano l'invio quotidiano di video mattutini e serali che documentano la felicità del cane durante il soggiorno, permettendo di ritrovare al rientro animali sereni, socievoli e in piena forma.",
        "en": "Four-legged companions staying at boarding kennels or participating in canine sports receive dedicated attention tailored to their emotional and physical well-being. Owners emphasize the daily morning and evening video updates sent by staff, ensuring reassurance while finding their dogs cheerful, well-socialized, and in top condition upon return."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "it": "Dedizione ed esperienza degli educatori cinofili",
        "en": "Dedication and expertise of canine educators"
      },
      "text": {
        "it": "Gli utenti lodano con entusiasmo la preparazione tecnica e la passione della responsabile Francesca e del suo gruppo di istruttori. Gli educatori guidano con pazienza sia le lezioni per cuccioli sia il recupero comportamentale di soggetti impegnativi. La disponibilità e il supporto costante infondono sicurezza e creano un clima familiare e professionale.",
        "en": "Clients enthusiastically praise the technical skill and genuine passion of manager Francesca and her team of dog trainers. Instructors patiently guide puppy development as well as behavioural rehabilitation for complex dogs. Consistent helpfulness and ongoing advice inspire complete trust and create a supportive, highly skilled training environment."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "it": "Struttura verde attrezzata per sport e custodia",
        "en": "Equipped green facility for sports and boarding"
      },
      "text": {
        "it": "Il centro cinofilo a Castelverde viene descritto come un ambiente curato e immerso nel verde, dotato di ampi campi di addestramento, comodo parcheggio e box confortevoli per la pensione. Gli spazi ampi permettono di svolgere molteplici attività all'aria aperta in totale sicurezza, offrendo anche aree di attesa piacevoli per i conduttori durante le sessioni.",
        "en": "The dog center in Castelverde is described as a clean and well-kept facility surrounded by greenery, featuring expansive training grounds, convenient parking, and comfortable boarding kennels. Ample open spaces enable a variety of outdoor canine sports in complete safety, alongside pleasant waiting zones for handlers during training sessions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "it": "Come vengono tenuti informati i proprietari durante la pensione?",
        "en": "How are owners kept updated during boarding stays?"
      },
      "a": {
        "it": "Il personale invia quotidianamente video e messaggi su WhatsApp per mostrare le attività e la serenità del cane.",
        "en": "The staff sends daily video clips and WhatsApp messages demonstrating the pet's activities and comfort."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "it": "Quali attività di addestramento vengono svolte al centro?",
        "en": "What training activities are offered at the facility?"
      },
      "a": {
        "it": "Il centro offre corsi per cuccioli, obbedienza base e avanzata, recupero comportamentale, agility e corsi per addestratori ENCI.",
        "en": "The facility offers puppy classes, basic and advanced obedience, behavioral rehabilitation, agility dog, and ENCI courses."
      },
      "basis": "both"
    },
    {
      "q": {
        "it": "La struttura accoglie anche gatti per la custodia?",
        "en": "Does the facility board cats as well as dogs?"
      },
      "a": {
        "it": "Sì, oltre alla pensione canina, il centro offre alloggi dedicati e sicuri per ospitare gatti durante le vacanze.",
        "en": "Yes, alongside dog boarding, the facility provides dedicated, secure accommodations for cats during holidays."
      },
      "basis": "both"
    }
  ],
