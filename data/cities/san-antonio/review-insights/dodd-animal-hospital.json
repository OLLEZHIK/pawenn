  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 67,
      "title": {
        "en": "Caring doctors with mixed front desk feedback"
      },
      "text": {
        "en": "Clients widely praise the compassionate care of Dr Dodd, Dr Floyd, and the veterinary technicians, describing them as dedicated, skilled, and gentle with pets. However, several reviewers report dissatisfaction with front-desk receptionists, citing rude interactions, unhelpful phone service, or reluctance to assist during urgent walk-ins."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Gentle and patient pet handling"
      },
      "text": {
        "en": "Pet owners emphasize that the clinical team treats dogs and cats with warmth and consideration during routine boosters and illness visits. Reviewers note that technicians handle reactive or frightened animals with reassurance and respect. Pet parents consistently trust the medical staff to keep their pets comfortable during examinations."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 17,
      "title": {
        "en": "Mixed feedback on front desk communication"
      },
      "text": {
        "en": "While pet owners praise the clinical communication and thorough explanations provided by the veterinarians, several clients report frustrating interactions with the reception desk. Reviewers mention difficulty obtaining price estimates over the phone, contradictory instructions regarding routine bloodwork, and curt customer service at check-in."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pets be boarded at Dodd Animal Hospital?"
      },
      "a": {
        "en": "Yes, clients report positive boarding experiences with affordable pricing and attentive pet supervision."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic offer same-day appointments?"
      },
      "a": {
        "en": "Yes, reviewers note that the hospital accommodates urgent same-day appointments, though front-desk assistance varies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What should pet owners know regarding front-desk interactions?"
      },
      "a": {
        "en": "While veterinarians receive high praise, several clients have reported delays or curt service at the reception counter."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are wellness exams and vaccinations provided for dogs and cats?"
      },
      "a": {
        "en": "Yes, the clinic administers annual vaccine boosters, parasite prevention, and routine health checks."
      },
      "basis": "both"
    }
