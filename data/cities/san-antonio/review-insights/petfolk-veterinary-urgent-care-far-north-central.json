  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 98,
      "title": {
        "en": "Attentive and reassuring veterinary practitioners"
      },
      "text": {
        "en": "Clients speak with high praise of the veterinary surgeons and support team at Petfolk. Pet owners appreciate the calm bedside manner, patience, and clear guidance offered during acute illness and annual consultations. Although a few reviewers experienced dismissive consultations or delayed diagnostics, the overwhelming majority describe a team that listens closely to families."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 80,
      "title": {
        "en": "Gentle handling and stress-free care"
      },
      "text": {
        "en": "Reviewers repeatedly emphasise the clinic's gentle and considerate approach towards anxious pets. The practice provides calming lavender blankets, warm treats, and quiet exam rooms that help soothe nervous cats and dogs before examinations. Pet parents report that their animals feel relaxed during routine vaccinations and urgent evaluations alike."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Convenient same-day visits and scheduling"
      },
      "text": {
        "en": "The practice receives strong praise for its accessible urgent care model and straightforward online booking system. Many clients highlight rapid intake for emergency walk-ins, noting that pets were examined promptly when sudden medical symptoms arose. A few reviewers cited long waits past scheduled appointment times, but most report timely attention."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Petfolk offer same-day urgent care appointments?"
      },
      "a": {
        "en": "Yes, clients confirm the clinic accepts same-day appointments and urgent care walk-ins for sudden illnesses and injuries."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the clinic help comfort anxious pets during visits?"
      },
      "a": {
        "en": "Reviewers note the use of calming lavender blankets, quiet examination rooms, and gentle handling techniques to reduce animal stress."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is an annual pet wellness membership required to visit?"
      },
      "a": {
        "en": "No, pet owners can book individual consultations without a membership, though an optional annual plan is offered."
      },
      "basis": "both"
    }
  ],
