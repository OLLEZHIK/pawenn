    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "en": "Approachable and reassuring veterinary clinicians"
      },
      "text": {
        "en": "Clients describe the veterinarians, technicians, and front desk personnel as welcoming and attentive during check-in. Reviewers frequently praise Dr Stewart, Justin, Erica, and Kharlie for explaining diagnoses clearly and providing steady support throughout difficult appointments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Patient care for various pets"
      },
      "text": {
        "en": "Pet owners consistently note how calmly staff handle nervous dogs, reactive cats, and exotic companion animals. Reviews mention specialised attention for brachycephalic French bulldogs, gentle nail trims for squirmy puppies, and comfortable handling for rabbits and guinea pigs."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Reliable treatments and surgical care"
      },
      "text": {
        "en": "Families with multi-year loyalty to the clinic highlight dependable clinical outcomes across routine wellness, claw trims, and soft tissue surgeries. While one client noted a fatal decline following a flea medication reaction, most pet parents report successful recoveries."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the practice examine exotic pets such as rabbits and guinea pigs?"
      },
      "a": {
        "en": "Yes, clients confirm that veterinarians provide examinations and claw trims for pocket pets including guinea pigs and bunnies."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pets stay for boarding at this hospital?"
      },
      "a": {
        "en": "Yes, the hospital maintains dedicated cat and dog boarding accommodations on Stone Oak Parkway."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Are urgent same-day appointments available?"
      },
      "a": {
        "en": "Yes, reviewers appreciate that the clinic accommodates same-day appointments when pets require prompt medical attention."
      },
      "basis": "reviews"
    }
