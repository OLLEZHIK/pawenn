  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 41,
      "title": {
        "en": "Praise for Dr. Rogers alongside service disputes"
      },
      "text": {
        "en": "Many clients commend Dr. Rogers, nurses, and receptionists for compassionate care and clear explanations during surgeries and check-ups. Conversely, multiple dissatisfied reviewers describe the office manager and front desk as rude or dismissive when questioned about billing discrepancies, medical records, or prescriptions."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 26,
      "title": {
        "en": "Successful surgeries mixed with treatment concerns"
      },
      "text": {
        "en": "Numerous pet owners credit the clinic with saving dogs from parvo, pyometra, and pancreatitis, as well as performing smooth same-day spay and neuter operations. However, several critical reviews report serious complications, including a blocked feline urinary catheter, disputed diagnoses, and an incorrect kitten medication dosage."
      }
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "mentions": 20,
      "title": {
        "en": "Low vaccine rates versus unexpected surgery fees"
      },
      "text": {
        "en": "Supporters value the clinic for accessible vaccination rates, budget-friendly emergency care, and willingness to work within financial constraints. On the other hand, several cat and dog owners report being quoted a low base price for spay or neuter surgery only to face hundreds of dollars in unexpected add-on charges at pick-up."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Pet Shotz Inc. accept walk-ins and same-day spay appointments?"
      },
      "a": {
        "en": "Reviewers note that the clinic accommodates walk-in visits, urgent cases, and same-day drop-offs for cat and dog spay or neuter procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What veterinary services are offered at Pet Shotz Inc.?"
      },
      "a": {
        "en": "The clinic provides dog and cat vaccinations, spay and neuter surgeries, heartworm testing, microchipping, flea prevention, and urgent care."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What do reviewers advise regarding treatment estimates at Pet Shotz Inc.?"
      },
      "a": {
        "en": "Several clients recommend requesting a written, itemised estimate before leaving a pet for surgery or lab work to clarify any extra fees."
      },
      "basis": "reviews"
    }
  ],
