  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "en": "Supportive veterinary and technician care"
      },
      "text": {
        "en": "Clients describe veterinarians like Dr Ehrlund, Dr Saunders, and Dr Michelle as attentive and empathetic throughout examinations. Pet owners appreciate informative consultations and thorough answers regarding chronic conditions, despite two clients expressing frustration during urgent emergencies."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Reassuring handling for household pets"
      },
      "text": {
        "en": "Reviewers note that personnel treat dogs and cats with genuine care and gentle handling techniques. Multiple pet owners highlight how calmly veterinary nurses handle anxious German shepherds, fragile rescue kittens with bone fractures, and elderly pets needing palliative comfort."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Diagnostic investigations and clinical treatments"
      },
      "text": {
        "en": "Pet parents report satisfactory outcomes across diagnostic blood panels, dental cleaning, oncology consultations, and congestive heart failure monitoring. While one owner voiced concerns over a missed cardiac mass, most families note substantial improvement in pet recovery and vitality."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the hospital have in-house diagnostics and intensive care?"
      },
      "a": {
        "en": "Yes, Great Northwest Animal Hospital maintains digital radiography, an in-house laboratory, and an intensive care unit on Grissom Road."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do veterinarians communicate regarding chronic conditions?"
      },
      "a": {
        "en": "Reviewers report that doctors take time to explain conditions such as heart failure and cancer, offering guidance on medications and refills."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What do clients report regarding lobby wait times?"
      },
      "a": {
        "en": "Pet owners typically report brief waiting intervals of ten to fifteen minutes before being called into exam rooms."
      },
      "basis": "reviews"
    }
  ],
