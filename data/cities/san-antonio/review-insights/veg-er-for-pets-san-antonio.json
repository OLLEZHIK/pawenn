  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 124,
      "title": {
        "en": "Compassionate emergency veterinary clinicians"
      },
      "text": {
        "en": "Pet owners praise the emergency veterinarians and vet nurses for their kindness and calm bedside manner during distressing crises. Many clients value clear updates and empathetic guidance, though a few reviewers felt communication lacked warmth during emotionally charged end-of-life decisions."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 97,
      "title": {
        "en": "Gentle handling in critical situations"
      },
      "text": {
        "en": "Families emphasize how tenderly the clinical team cares for critically injured and sick pets. Clinicians provide soft bedding, pain relief, and soothing attention, allowing owners to stay alongside their animals during triage and inpatient treatment to keep distress to an absolute minimum."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 77,
      "title": {
        "en": "Life-saving interventions and stabilisations"
      },
      "text": {
        "en": "Reviewers express gratitude for prompt emergency care, successful poison treatments, and critical surgical procedures that saved pets' lives. While several owners reported complications or felt diagnoses were difficult to accept, the broad consensus confirms reliable emergency intervention."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners stay with their pets during emergency treatment?"
      },
      "a": {
        "en": "Yes, clients frequently highlight the open hospital setup that allows owners to remain alongside their pets during examinations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the emergency hospital open twenty-four hours a day?"
      },
      "a": {
        "en": "Yes, the facility provides around-the-clock emergency veterinary care every day of the week."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How are consultation fees structured at VEG ER for Pets?"
      },
      "a": {
        "en": "Reviewers note that emergency visits involve an initial consultation fee, with additional estimates provided before treatments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do clinicians treat exotic animals and birds in emergencies?"
      },
      "a": {
        "en": "Yes, reviewers mention emergency care for pocket pets, reptiles, and avian patients alongside dogs and cats."
      },
      "basis": "both"
    }
  ],
