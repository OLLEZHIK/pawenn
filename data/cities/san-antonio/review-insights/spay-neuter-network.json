  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 122,
      "title": {
        "en": "Supportive and helpful clinic staff"
      },
      "text": {
        "en": "Most pet owners highlight the kindness and dedication of the veterinary assistants and clinical staff during intake and discharge. Reviewers appreciate the clear post-operative guidance provided by the team. A few clients noted occasional communication issues with desk management, but the overwhelming consensus describes an approachable and patient team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 86,
      "title": {
        "en": "Gentle handling for surgical patients"
      },
      "text": {
        "en": "Clients consistently praise how calmly dogs and cats are treated during check-in and post-operative recovery. Many reviewers note that nervous rescue animals and young kittens receive reassuring attention from handlers. While one client raised concern regarding rough handling by a supervisor, the vast majority commend the gentle care shown to their pets."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 70,
      "title": {
        "en": "Reliable neutering and swift recovery"
      },
      "text": {
        "en": "Pet owners report smooth surgical outcomes for routine spay, neuter, and microchipping procedures. Reviewers frequently note that animals heal quickly with neat incisions and minimal discomfort. A couple of reviews report complications after anaesthesia or postoperative infections, yet most families confirm their animals recovered safely without issue."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are walk-in appointments accepted for pet surgery?"
      },
      "a": {
        "en": "Surgeries typically require prior online booking, though morning walk-ins may be accommodated depending on clinic capacity."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How are surgical fees structured at the clinic?"
      },
      "a": {
        "en": "Reviewers emphasize low-cost, accessible pricing for spay, neuter, and vaccination services compared to standard veterinary practices."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What instructions are provided for post-operative recovery?"
      },
      "a": {
        "en": "The clinical team provides detailed written aftercare instructions, pain relief medication, and recovery advice at pet collection."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer vaccinations alongside surgery?"
      },
      "a": {
        "en": "Yes, clients frequently add core pet vaccines, microchipping, and parasite prevention to their surgical appointments."
      },
      "basis": "both"
    }
  ],
