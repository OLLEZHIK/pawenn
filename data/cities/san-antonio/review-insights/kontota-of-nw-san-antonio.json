  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Punctual and accommodating mobile groomers"
      },
      "text": {
        "en": "Clients consistently commend groomers including Raul, Destiny, Sean, Amber, and Naily for their punctuality, gentle approach, and clear communication. Reviewers value that stylists send text updates, share before-and-after photos, and listen carefully to styling preferences. While two clients noted instances of rushed service or unreturned messages, the vast majority describe a courteous and dependable team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Stress-free grooming in familiar surroundings"
      },
      "text": {
        "en": "Pet parents highlight how comfortable anxious, rescue, or senior dogs feel having grooming completed right outside their doorstep. Reviewers appreciate that pets avoid stressful car journeys and bustling commercial salon floors. Stylists are frequently praised for taking their time to calm nervous animals, ensuring that dogs remain relaxed and return inside happy and untraumatised."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Thorough bathing and styling finishes"
      },
      "text": {
        "en": "Owners regularly compliment the finished grooming quality, noting fluffy coats, thorough deshedding, neatly clipped claws, and clean fragrances. Clients appreciate tailored cuts for various breeds including Doodles, Maltese, and Dobermans. Although one reviewer reported an uneven coat length and another noted incomplete drying, most pet parents express complete satisfaction with the styling outcomes."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does mobile pet grooming work with Kontota?"
      },
      "a": {
        "en": "A fully equipped van arrives at the client's home with warm water and styling tools, completing full grooming right in the driveway."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet parents book mobile grooming appointments online?"
      },
      "a": {
        "en": "Yes, clients can reserve grooming appointments online seven days a week through the Kontota booking platform."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do the mobile groomers handle senior or anxious dogs?"
      },
      "a": {
        "en": "Yes, reviewers frequently praise the groomers for their patience and gentle care with elderly, nervous, and rescue dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do stylists share updates during the grooming appointment?"
      },
      "a": {
        "en": "Yes, clients appreciate that stylists send text updates and before-and-after photos to show how their pet is progressing."
      },
      "basis": "reviews"
    }
  ],
