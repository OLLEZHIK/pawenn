  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Helpful and courteous retail associates"
      },
      "text": {
        "en": "Customers consistently praise the store associates for their welcoming manner, attentiveness, and product knowledge. Reviewers mention that employees readily assist with locating supplies, answering questions regarding farm animal nutrition, and loading heavy feed sacks and hay bales into vehicles. Aside from one remark about an unfriendly cashier, customer service feedback is warmly enthusiastic."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Well-stocked store with broad inventory"
      },
      "text": {
        "en": "The store environment earns widespread praise for cleanliness, neat organization, and extensive inventory. Patrons appreciate the diverse range of agricultural supplies, livestock feed, gardening plants, and pet accessories housed under one roof. Regular visitors highlight the convenience of finding everything from poultry feed to souvenirs in a single well-maintained location."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Poultry and small farm animals"
      },
      "text": {
        "en": "Many shoppers visit specifically for small companion animals and poultry, including baby chicks, rabbits, hamsters, and birds. Positive reviews highlight clean coops and active livestock. While a few critical accounts report receiving unwell bunnies or losing newly purchased pets to illness, the overall volume of positive comments regarding animal variety remains strong."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What types of livestock and feed does Mini Ranch Feed Store stock?"
      },
      "a": {
        "en": "Reviewers note that the store carries feed and bedding for horses, goats, poultry, and domestic pets, as well as live baby chicks and rabbits."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do employees help customers load heavy feed and hay purchases?"
      },
      "a": {
        "en": "Yes, customer feedback highlights that workers regularly assist with loading heavy sacks of feed and hay bales directly into customer vehicles."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are there extra fees for debit or credit card payments?"
      },
      "a": {
        "en": "A reviewer noted a small surcharge applied when paying with a debit card, so customers may prefer cash if wishing to avoid card fees."
      },
      "basis": "reviews"
    }
  ],
