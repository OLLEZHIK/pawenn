  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "en": "Attentive handling for canine guests"
      },
      "text": {
        "en": "Dog owners report that salon staff manage both energetic and timid companion animals with gentle patience. Reviewers note that nervous rescues and small breeds settle quickly, with staff using soothing handling techniques during fur washing, ear drying, and nail care routines."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Bath washes and styling precision"
      },
      "text": {
        "en": "Most feedback highlights tidy breed cuts, thorough de-shedding treatments, and pleasant smelling coat washes. While a couple of customers reported uneven styling lengths or quick-clipped nails on small dogs, the majority of visitors return to collect well-groomed and clean pets."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Welcoming reception and salon personnel"
      },
      "text": {
        "en": "Clients frequently praise groomers and owner Melissa for friendly greetings and helpful advice on drop-off. A small number of reviewers noted defensive reactions when discussing unexpected bill totals, but most patrons describe interactions as courteous, warm, and accommodating."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Glam Pet Groom offer walk-in services?"
      },
      "a": {
        "en": "Yes, the salon welcomes walk-in customers for nail trims, while full grooming treatments require prior scheduling."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are cats accepted for bathing and grooming?"
      },
      "a": {
        "en": "Yes, the salon provides bath and nail services for cats by telephone appointment."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "What do reviewers report about turnaround times?"
      },
      "a": {
        "en": "Most clients report efficient turnaround times of two to three hours, receiving a prompt phone call when their pet is ready."
      },
      "basis": "reviews"
    }
  ],
