  "cards": [
    {
      "topic": "staff",
      "title": {
        "en": "Dedicated veterinary care and staff"
      },
      "text": {
        "en": "Many reviewers praise the veterinarians and veterinary technicians for their compassion, attentiveness, and willingness to assist during urgent pet health situations. Clients appreciate team members who take time to comfort nervous animals. Nevertheless, some visitors experienced friction with front desk receptionists regarding scheduling changes and communication tone."
      },
      "mentions": 87,
      "sentiment": "positive"
    },
    {
      "topic": "waiting",
      "title": {
        "en": "Extended operating hours and wait times"
      },
      "text": {
        "en": "Pet owners highlight the convenience of extended weekday and weekend operating hours until late evening, allowing access to urgent care when other clinics are closed. However, several reviewers noted extended waiting room delays and sudden appointment rescheduling during busy shifts."
      },
      "mentions": 9,
      "sentiment": "mixed"
    },
    {
      "topic": "communication",
      "title": {
        "en": "Appointment scheduling and clear updates"
      },
      "text": {
        "en": "Feedback regarding communication reflects both responsive guidance and notable gaps. Many clients appreciate clear medical updates from attending doctors, whereas critical reviewers cited unconfirmed booking cancellations, unreturned inquiries, and difficulties obtaining quotes over the phone."
      },
      "mentions": 5,
      "sentiment": "negative"
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What are the operating hours at North Star 410 Animal Hospital?"
      },
      "a": {
        "en": "The hospital operates with extended hours seven days a week, remaining open until late evening on weekends and select weekdays."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the hospital provide urgent care services?"
      },
      "a": {
        "en": "Yes, reviewers report accessing urgent medical evaluations for acute pet injuries and illnesses without prior appointments."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners schedule appointments online?"
      },
      "a": {
        "en": "Yes, digital appointment scheduling and new client registration are supported on the clinic website."
      },
      "basis": "both"
    }
  ],
