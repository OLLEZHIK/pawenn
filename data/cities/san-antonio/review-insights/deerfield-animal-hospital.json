  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Attentive and experienced veterinary staff"
      },
      "text": {
        "en": "Pet owners commend the veterinary team, including Dr Cantu, Dr Faseler, and Dr Castillo, for their expertise, warmth, and prompt communication. Reviews describe a courteous front office and helpful technicians who follow up diligently after visits. While one reviewer expressed frustration with clinical staff, the consensus highlights supportive care."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Gentle and compassionate animal handling"
      },
      "text": {
        "en": "Clients frequently remark on how kindly doctors and assistants handle pets, comforting anxious dogs and soothing sick animals during examinations. Long-time patrons praise the sensitive and dignified care provided during senior consultations and difficult farewells. One reviewer noted an isolated incident where a pet slipped away during a bathroom break."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 10,
      "title": {
        "en": "Clear explanations and attentive follow-up"
      },
      "text": {
        "en": "Pet parents commend the doctors and technicians for explaining treatment options and diagnoses clearly and answering every question without rushing. Clients frequently mention that staff follow up promptly by phone to check on their animals' recovery progress after procedures. Reviewers value the informative guidance and ongoing clinical support."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet parents book technician appointments online at Deerfield?"
      },
      "a": {
        "en": "Yes, clients note that online booking is straightforward and allows quick visits for technician services."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic accommodate emergency cases?"
      },
      "a": {
        "en": "Reviewers share that the hospital accommodated urgent cases promptly, including emergency procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How long has the clinic served local pet owners?"
      },
      "a": {
        "en": "Several clients mention trusting Deerfield Animal Hospital with their dogs and cats for fifteen to twenty years."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are follow-up calls provided after medical treatments?"
      },
      "a": {
        "en": "Yes, pet owners appreciate that clinic staff call to check on their animals' recovery progress."
      },
      "basis": "reviews"
    }
