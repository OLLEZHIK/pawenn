  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "en": "Attentive and caring clinical practitioners"
      },
      "text": {
        "en": "Reviewers frequently commend the attending veterinary surgeons and technicians, singling out Dr. Ward and Dr. Dietz for their compassionate, patient manner. Many clients report that clinic staff handle nervous dogs and cats with genuine care, explaining diagnoses thoroughly. While several reviews mention unhelpful encounters at reception, the predominant feedback for clinical care remains favourable."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Compassionate handling across companion pets"
      },
      "text": {
        "en": "Pet owners frequently recount gentle and affectionate handling of their dogs and cats during routine wellness examinations and vaccination clinics. Reviewers note that technicians take time to calm trembling puppies and nervous rescue animals, offering treats and reassurance. Aside from one isolated complaint regarding rough handling, owner observations highlight a kind patient environment."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Affordable wellness and medication rates"
      },
      "text": {
        "en": "The clinic is widely praised for providing low-cost veterinary services, making preventive care and essential treatments accessible. Pet owners highlight substantial savings on annual vaccinations, heartworm procedures, and routine office visits compared to standard veterinary hospitals. A minority of reviewers expressed frustration regarding technician fees, but overall pricing satisfaction is high."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Low Cost Pet Vet accommodate walk-in visits?"
      },
      "a": {
        "en": "Reviewers note that walk-in clinics are available on select days, such as Sundays, though owners of sick pets are advised to schedule an appointment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How responsive is the clinic to telephone inquiries?"
      },
      "a": {
        "en": "Clients report frequent challenges reaching the clinic by phone, with many recommending in-person visits or early inquiries to secure care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are medication and vaccination prices lower than typical clinics?"
      },
      "a": {
        "en": "Yes, customer feedback consistently highlights substantial savings on routine immunisations, flea prevention, and heartworm treatments."
      },
      "basis": "reviews"
    }
  ],
