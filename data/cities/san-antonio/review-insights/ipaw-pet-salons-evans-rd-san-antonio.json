  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Attentive and accommodating salon staff"
      },
      "text": {
        "en": "Reviewers frequently commend the front desk staff and owner Sebastian for their friendly attitude, clear communication, and attentiveness to specific grooming requests. Clients appreciate receiving notification calls when their pets are ready for collection. A few owners experienced miscommunication regarding cut styles or pricing surcharges, but most describe a dependable and welcoming team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Gentle approach for anxious pets"
      },
      "text": {
        "en": "Clients note that groomers handle anxious, nervous, or squirmy pets with patience and reassurance. Multiple reviews praise the gentle treatment of cats and senior dogs, noting that animals return home calm and relaxed. Although one client reported a past grooming injury requiring veterinary attention, reviewers overwhelmingly trust the salon staff to treat their pets with affection and careful handling."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Consistent grooming and styling results"
      },
      "text": {
        "en": "Pet parents consistently express satisfaction with the styling outcomes for their dogs and cats, highlighting neat haircuts, thorough deshedding, and pleasant-smelling coats. Cat owners specifically commend the groomers for handling Persian coats and mat removal without unnecessary shaving. While one client reported an uneven poodle trim and another an accidental nick, the vast majority praise the grooming quality."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does iPaw Pet Salons offer grooming for cats?"
      },
      "a": {
        "en": "Yes, the salon provides specialised cat grooming services including gentle bathing, mat removal, sanitary trims, and lion cuts."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners book grooming appointments online?"
      },
      "a": {
        "en": "Yes, clients can schedule grooming appointments for dogs and cats through the salon's online booking system."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients find out when their pet is ready?"
      },
      "a": {
        "en": "Reviewers report that staff consistently call approximately 30 minutes before grooming is completed so owners can plan collection."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients rate the grooming rates at the Evans Road salon?"
      },
      "a": {
        "en": "Most pet parents describe the pricing as reasonable and competitive, though clients advise clarifying breed-specific styling costs in advance."
      },
      "basis": "reviews"
    }
