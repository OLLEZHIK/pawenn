  "cards": [
    {
      "topic": "staff",
      "title": {
        "en": "Compassionate veterinary team and doctors"
      },
      "text": {
        "en": "Most pet owners praise Dr Schmeltzer, Dr Zengler, and the clinic staff for their kindness, thorough examinations, and honest advice. Long-standing clients note that practitioners do not attempt to upsell unnecessary products and show genuine concern for animal welfare. A small number of reviewers reported dissatisfaction with receptionist handling or emergency triage."
      },
      "mentions": 43,
      "sentiment": "positive"
    },
    {
      "topic": "animals",
      "title": {
        "en": "Comfortable handling for companion animals"
      },
      "text": {
        "en": "Reviewers highlight the team’s patient approach towards dogs and cats during clinical appointments. Clients with reactive dogs or nervous pets appreciate that staff take steps to clear lobbies, keep animals calm, and treat each four-legged visitor with gentle consideration."
      },
      "mentions": 7,
      "sentiment": "positive"
    },
    {
      "topic": "prices",
      "title": {
        "en": "Fair pricing and transparent estimates"
      },
      "text": {
        "en": "Several clients describe the clinic’s pricing as reasonable and competitive compared with regional veterinary practices. Pet parents appreciate receiving clear costs prior to treatments, although a couple of visitors noted frustration regarding stray intake charges."
      },
      "mentions": 5,
      "sentiment": "mixed"
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does O’Connor Road Animal Hospital accommodate walk-in visits?"
      },
      "a": {
        "en": "The clinic accommodates walk-ins alongside pre-booked visits, though scheduling in advance helps reduce wait times."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are bilingual consultations provided at the clinic?"
      },
      "a": {
        "en": "Yes, bilingual Spanish-speaking veterinary staff members are available to assist clients."
