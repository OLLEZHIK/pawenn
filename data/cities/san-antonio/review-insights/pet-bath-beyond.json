  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 17,
      "title": {
        "en": "Friendly groomers with some front desk friction"
      },
      "text": {
        "en": "Many clients praise individual stylists such as Daniel, Danny, Max, and Drina for their welcoming attitude and willingness to listen to styling requests. However, a few reviewers reported rude interactions at drop-off or pick-up when questioning uneven haircuts, early-morning arrival rules, or scheduling mistakes."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Clean baths alongside occasional cut complaints"
      },
      "text": {
        "en": "Most owners of Shih Tzus, Cavaliers, Labradors, and Persian cats are pleased with the baths, nail trims, and breed haircuts at this Northwest Military Highway salon. Still, one client reported a bleeding paw after a nail trim and another complained that two dogs received choppy, overly short coats from a different stylist."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Gentle care for dogs and Persian cats"
      },
      "text": {
        "en": "Reviewers frequently note that their dogs and cats return home happy and relaxed, even pets that normally dislike bathing or brushing. Owners appreciate the patient care during spa and boarding stays, though one customer was alarmed to find their dog bleeding from a nail cut upon getting into the car."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Pet Bath & Beyond groom cats as well as dogs?"
      },
      "a": {
        "en": "Yes, the salon provides bathing, nail trimming, and full grooming for both dogs and cats, including long-haired Persian cats."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners request a specific groomer when booking?"
      },
      "a": {
        "en": "Yes, reviewers regularly request specific groomers such as Daniel, Danny, Max, or Drina for their pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What happens if a client is unhappy with a grooming session?"
      },
      "a": {
        "en": "One reviewer noted that management issued a credit towards a follow-up visit after a previous groom did not meet expectations."
      },
      "basis": "reviews"
    }
  ],
