  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "en": "Dedicated and welcoming veterinary team"
      },
      "text": {
        "en": "Clients describe the veterinarians, veterinary technicians, and reception staff as caring, knowledgeable, and friendly. Reviews repeatedly praise the team for answering questions thoroughly, explaining treatment options, and creating a supportive environment. While one client felt rushed regarding surgical follow-up, the consensus reflects deep gratitude."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Loving care for family pets"
      },
      "text": {
        "en": "Pet owners note the genuine affection and gentle touch shown to dogs and cats during exams, vaccinations, and recovery periods. Clients with nervous or rescue pets appreciate that staff take time to soothe animals and minimize distress in the exam rooms. Reviewers frequently describe the practice as treating their fur babies like beloved family members."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "en": "Clean and welcoming veterinary facility"
      },
      "text": {
        "en": "Clients frequently remark on the modern, clean, and well-maintained facility at Community Pet Health Center. Pet owners appreciate the comfortable and organized reception area and exam rooms, which help pets and their families feel at ease during visits. Reviewers note that the welcoming environment contributes to a smooth and positive clinical experience."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What preventive services are offered at Community Pet Health Center?"
      },
      "a": {
        "en": "The hospital provides comprehensive wellness exams, vaccinations, heartworm prevention, and routine health checks."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are spay and neuter surgeries performed here?"
      },
      "a": {
        "en": "Yes, clients frequently mention successful and well-managed spay, neuter, and soft tissue surgeries."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can appointments be scheduled online?"
      },
      "a": {
        "en": "Yes, the practice offers online appointment requests alongside standard telephone scheduling."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients describe the general veterinary pricing?"
      },
      "a": {
        "en": "Reviewers frequently describe the clinic's fees as fair, reasonable, and accessible for family pets."
      },
      "basis": "reviews"
    }
  ],
