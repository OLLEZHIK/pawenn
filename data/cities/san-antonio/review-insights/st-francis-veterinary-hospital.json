  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 94,
      "title": {
        "en": "Supportive doctors and clinical team"
      },
      "text": {
        "en": "Pet owners frequently praise the veterinary doctors and veterinary nurses for their approachable manner and dedication. Many clients highlight that the team answers questions thoroughly and maintains a friendly environment. While a couple of reviews mention communication disconnects between reception and clinicians, the general reception remains very positive."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 69,
      "title": {
        "en": "Attentive care for dogs and cats"
      },
      "text": {
        "en": "Clients consistently appreciate the gentle handling shown to anxious dogs, cats, and exotic pets during routine check-ups and diagnostic exams. Reviewers observe that clinical staff take time to calm stressed animals before administering injections. With rare exceptions regarding clinical oversight, owners feel their companions are treated with kindness."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Fair pricing and clear estimates"
      },
      "text": {
        "en": "Many reviewers describe the clinic's charges as fair and accessible compared to other veterinary practices in San Antonio. Pet owners appreciate transparent quotes for routine vaccinations, wellness checks, and minor procedures. A few reviewers noted unexpected add-on charges on surgical invoices, but most clients consider the medical fees very reasonable."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the hospital treat exotic pets as well as dogs and cats?"
      },
      "a": {
        "en": "Yes, clients mention bringing birds and small exotic pets alongside dogs and cats for health consultations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How are surgical and dental consultations scheduled?"
      },
      "a": {
        "en": "Appointments can be arranged in advance, with clinical staff performing preliminary evaluations prior to surgery."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are treatment estimates provided prior to procedures?"
      },
      "a": {
        "en": "Yes, reviewers generally report receiving treatment outlines, although clients recommend reviewing all itemised fees beforehand."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pet prescription refills be collected on site?"
      },
      "a": {
        "en": "Yes, pet owners regularly obtain prescribed medications, dietary supplies, and preventive treatments directly from the clinic."
      },
      "basis": "both"
    }
  ],
