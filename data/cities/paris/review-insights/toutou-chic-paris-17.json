  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "fr": "Accueil chaleureux et toiletteuses attentionnées",
        "en": "Warm welcome and attentive groomers"
      },
      "text": {
        "fr": "Les propriétaires de chiens saluent unanimement l'accueil souriant et le professionnalisme de l'équipe du 17e arrondissement, notamment Gwendoline. Les soignantes prennent le temps de rassurer les maîtres et d'écouter leurs souhaits de coupe avec patience et bienveillance.",
        "en": "Dog guardians consistently commend the smiling reception and high professionalism of the grooming staff in the 17th arrondissement, especially Gwendoline. The groomers take time to reassure pet parents and attentively listen to specific styling preferences before every session."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "fr": "Coupes soignées et pelage soyeux",
        "en": "Neat scissor styling and coat care"
      },
      "text": {
        "fr": "Les avis mettent en avant la grande qualité des coupes aux ciseaux, le démêlage méticuleux et la propreté impeccable des chiens à la sortie du salon. Malgré quelques rares remarques sur les retards ou devis imprévus, l'esthétique générale et le parfum du poil font l'admiration.",
        "en": "Reviews highlight the high standard of scissor styling, careful detangling, and impeccable coat freshness when dogs leave the salon. While a few isolated comments note occasional scheduling shifts or extra fees, the overall aesthetic result and pleasant fragrance win wide acclaim."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "fr": "Douceur envers les chiens craintifs",
        "en": "Gentle patience with nervous dogs"
      },
      "text": {
        "fr": "Les maîtres soulignent la bienveillance de l'équipe face aux chiots découvrant le toilettage et aux chiens sensibles. Même les animaux d'ordinaire nerveux sur la table d'intervention ressortent calmes, joyeux et en totale confiance, sans montrer le moindre signe de stress.",
        "en": "Clients frequently note the team's gentle attitude when handling puppies receiving their first grooming or naturally timid dogs. Even pets typically nervous during salon treatments emerge calm, happy, and confident, showing no signs of distress following their bath."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Le salon propose-t-il des séances d'initiation pour chiots ?",
        "en": "Does the salon offer introductory grooming for puppies?"
      },
      "a": {
        "fr": "Oui, des forfaits d'initiation tout en douceur permettent d'habituer sereinement les jeunes chiots aux bruits et au bain.",
        "en": "Yes, gentle introductory sessions help young puppies grow accustomed to salon sounds, water, and brushing tools."
      },
      "basis": "website"
    },
    {
      "q": {
        "fr": "Quels types de soins du pelage sont réalisés rue Lebon ?",
        "en": "What coat grooming services are performed on Rue Lebon?"
      },
      "a": {
        "fr": "Les prestations comprennent le bain complet, le brushing, la coupe aux ciseaux, la tonte et les soins d'hygiène des coussinets.",
        "en": "Services include complete baths, brush-outs, hand scissor styling, hygienic trims, and claw and pad care."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Comment réserver un créneau de toilettage ?",
        "en": "How can clients schedule a grooming appointment?"
      },
      "a": {
        "fr": "La réservation s'effectue en ligne via la plateforme dédiée du salon ou par téléphone pour les demandes spécifiques.",
        "en": "Appointments can be booked online through the salon's booking system or by telephone for specialized requests."
      },
      "basis": "website"
    }
  ],
