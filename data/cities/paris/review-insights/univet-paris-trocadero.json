  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "fr": "Équipe attentive du 16e arrondissement",
        "en": "Attentive veterinary team in Paris 16"
      },
      "text": {
        "fr": "Une large majorité de maîtres salue la disponibilité, la gentillesse et le grand professionnalisme du Dr Fiocre et des auxiliaires de la rue de Longchamp. Même si quelques avis isolés déplorent un manque de flexibilité horaire ou d'écoute, le dévouement global inspire confiance.",
        "en": "A large majority of pet guardians commends the availability, kindness, and high professionalism of Dr Fiocre and the clinical staff on Rue de Longchamp. While occasional negative reviews regret strict scheduling or communication limits, the overall veterinary dedication inspires confidence."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "fr": "Douceur des soins pour animaux",
        "en": "Gentle medical handling of pets"
      },
      "text": {
        "fr": "Les propriétaires de chiens et de chats soulignent la prévenance des soignants lors des examens cliniques. Les gestes sont calmes et rassurants pour apaiser les animaux inquiets, bien qu'un retour critique déplore une anesthésie jugée excessive lors d'un démêlage félin délicat.",
        "en": "Dog and cat owners frequently emphasize the caregivers' gentle attitude during routine physical check-ups. Examinations are conducted calmly to reassure nervous pets, although one critical review regrets a sedation deemed excessive during a difficult feline mat-removal procedure."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 12,
      "title": {
        "fr": "Prise en charge et retours partagés",
        "en": "Clinical care and varied outcomes"
      },
      "text": {
        "fr": "De nombreux avis témoignent de chirurgies réussies, de soins dentaires soignés et de diagnostics rapides ayant permis de soulager efficacement les animaux. En revanche, quelques clients font part de réserves sur la pertinence de certains actes ou la gestion de cas complexes.",
        "en": "Numerous reviews report successful soft tissue surgeries, careful dentistry, and prompt diagnostics that relieved ailing pets. In contrast, several clients express reservations concerning the diagnostic precision or the clinical management of more complicated medical cases."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "La clinique soigne-t-elle les nouveaux animaux de compagnie (NAC) ?",
        "en": "Does the clinic treat exotic small pets (small mammals)?"
      },
      "a": {
        "fr": "Oui, l'équipe accueille les petits mammifères tels que les lapins et rongeurs pour des consultations de médecine générale.",
        "en": "Yes, the team admits small exotic mammals including rabbits and rodents for general veterinary examinations."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Quelles chirurgies sont pratiquées rue de Longchamp ?",
        "en": "What surgeries are performed on Rue de Longchamp?"
      },
      "a": {
        "fr": "L'établissement pratique la chirurgie des tissus mous, les stérilisations, les soins dentaires et l'hospitalisation pré-opératoire.",
        "en": "The clinic carries out soft tissue surgery, neutering procedures, dental treatments, and inpatient pre-operative care."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Comment sont gérées les urgences en dehors des horaires d'ouverture ?",
        "en": "How are out-of-hours veterinary emergencies handled?"
      },
      "a": {
        "fr": "En cas d'urgence la nuit ou le dimanche, le répondeur téléphonique de la clinique oriente vers les structures d'urgence de garde.",
        "en": "During night hours or Sundays, the clinic answering service directs emergencies to on-duty partner veterinary hospitals."
      },
      "basis": "both"
    }
