  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 34,
      "title": {
        "fr": "Écoute médicale et accueil d'urgence",
        "en": "Medical listening and emergency reception"
      },
      "text": {
        "fr": "Une majorité de propriétaires salue la bienveillance des vétérinaires et la clarté des explications lors des hospitalisations. Les soignants sont décrits comme attentifs et dévoués, notamment face aux pathologies complexes. Quelques usagers font toutefois part d'un accueil perçu comme impersonnel ou d'un manque d'empathie lors des périodes de forte affluence.",
        "en": "A majority of pet owners praise the veterinarians' kindness and clear explanations during hospital stays. Caregivers are described as attentive and dedicated, particularly when dealing with complex conditions. However, several visitors report an experience perceived as impersonal or a lack of empathy during intense emergency peaks."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 18,
      "title": {
        "fr": "Prise en charge chirurgicale et soins",
        "en": "Surgical intervention and patient recovery"
      },
      "text": {
        "fr": "De nombreux avis soulignent des opérations vitales réussies, des diagnostics précis grâce au scanner et des guérisons inespérées après des traumatismes sévères. À l'inverse, plusieurs maîtres regrettent des erreurs diagnostiques supposées ou une issue fatale pour leur compagnon, déplorant parfois des examens redondants en réanimation.",
        "en": "Numerous reviews highlight successful life-saving surgeries, accurate CT scanner diagnoses, and unexpected recoveries following severe trauma. Conversely, several clients report suspected diagnostic errors or tragic outcomes for their companions, occasionally regretting redundant examinations performed in intensive care."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 16,
      "title": {
        "fr": "Gestion des urgences et rendez-vous",
        "en": "Emergency flow and appointment delays"
      },
      "text": {
        "fr": "La rapidité de triage pour les urgences vitales est appréciée, plusieurs animaux ayant été pris en charge immédiatement à leur arrivée. Néanmoins, d'autres retours pointent des délais d'attente prolongés malgré une prise de rendez-vous préalable, ainsi que des erreurs d'inscription sur le planning de garde qui ont suscité une vive frustration.",
        "en": "Prompt triage for critical emergencies is widely appreciated, with several pets admitted immediately upon arrival. Nonetheless, other reviews point to prolonged waiting periods despite pre-booked appointments, alongside scheduling errors on the on-call roster that caused considerable distress for families."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "La clinique dispose-t-elle d'un service d'urgence 24h/24 ?",
        "en": "Does the clinic offer a 24/7 emergency service?"
      },
      "a": {
        "fr": "Oui, l'établissement assure les urgences vétérinaires et les gardes 24h/24 et 7j/7 avec une équipe soignante présente en continu.",
        "en": "Yes, the facility provides 24/7 round-the-clock emergency and critical care with continuous veterinary staffing."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "La structure accueille-t-elle les nouveaux animaux de compagnie (NAC) ?",
        "en": "Does the clinic treat exotic pets (small mammals)?"
      },
      "a": {
        "fr": "Oui, des vétérinaires formés aux NAC prennent en charge les lapins et petits mammifères en consultation et en urgence.",
        "en": "Yes, veterinarians trained in exotic pet medicine care for rabbits and small mammals for routine and emergency visits."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Quels examens d'imagerie avancée sont disponibles sur place ?",
        "en": "What advanced imaging equipment is available on site?"
      },
      "a": {
        "fr": "Le plateau technique comprend un scanner CT, de l'échographie cardiaque et abdominale, ainsi que de la radiographie numérique.",
        "en": "The facility includes a CT scanner, cardiac and abdominal ultrasound, and digital radiography for referral cases."
      },
      "basis": "website"
    },
    {
      "q": {
        "fr": "Comment s'organisent les visites lors d'une hospitalisation ?",
        "en": "How are visits arranged during animal hospitalization?"
      },
      "a": {
        "fr": "Les visites aux animaux hospitalisés se font sur créneau dédié et accord de l'équipe médicale pour préserver le repos des patients.",
        "en": "Visits to hospitalized pets require dedicated scheduling and medical approval to protect recovering patients."
      },
      "basis": "reviews"
    }
