  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "fr": "Dévouement exemplaire de l'équipe soignante",
        "en": "Exemplary dedication of clinic staff"
      },
      "text": {
        "fr": "Les propriétaires expriment une reconnaissance unanime envers les docteurs Sutter et Lanza ainsi que l'équipe d'accueil sur le boulevard de Magenta. La bienveillance, la réactivité et les explications pédagogiques sont citées comme des repères essentiels pour rassurer les maîtres.",
        "en": "Pet owners express unanimous appreciation for Dr. Sutter, Dr. Lanza, and the reception team on Boulevard de Magenta. Kindness, responsiveness, and clear explanations are highlighted as essential pillars that reassure pet parents during routine visits and urgent situations."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "fr": "Douceur exceptionnelle avec les animaux",
        "en": "Exceptional gentleness with companion animals"
      },
      "text": {
        "fr": "Les maîtres décrivent une manipulation très apaisante des chiens, chats et lapins, y compris les plus stressés. Les consultations se déroulent sans précipitation, permettant aux animaux apeurés de reprendre confiance. Plusieurs remarquent que leurs bêtes entrent volontiers dans la clinique.",
        "en": "Owners describe a very calming approach toward dogs, cats, and rabbits, including particularly anxious pets. Examinations take place unhurriedly, allowing fearful animals to regain confidence. Several clients note that their pets enter the clinic without any signs of resistance."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "fr": "Soins d'urgence et diagnostics fiables",
        "en": "Reliable emergency care and diagnostics"
      },
      "text": {
        "fr": "Les avis soulignent l'efficacité des traitements prescrits, la précision des diagnostics et la prise en charge rapide d'urgences graves comme des morsures. Des maîtres rapportent que des animaux en péril ont pu être sauvés avec succès. La continuité des soins sur plusieurs années est très appréciée.",
        "en": "Reviews emphasize the precision of clinical diagnoses, effective treatment plans, and swift handling of acute emergencies such as bite injuries. Owners report that severely ill animals were saved through prompt intervention. Long-term medical consistency spanning years is widely valued."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Peut-on obtenir un rendez-vous d'urgence le jour même ?",
        "en": "Can clients get a same-day emergency appointment?"
      },
      "a": {
        "fr": "Oui, de nombreux retours soulignent la grande réactivité de la clinique pour recevoir les animaux en urgence le jour même.",
        "en": "Yes, numerous client reviews highlight the clinic's responsiveness in accommodating emergencies on the same day."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "La clinique soigne-t-elle les lapins et petits mammifères ?",
        "en": "Does the clinic treat rabbits and small mammals?"
      },
      "a": {
        "fr": "Oui, l'équipe prend en charge les lapins en plus des chiens et des chats, tant pour la médecine que pour des urgences vitales.",
        "en": "Yes, the team cares for rabbits alongside dogs and cats, covering general medicine as well as critical emergencies."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Quels services spécialisés sont proposés sur place ?",
        "en": "What specialized facilities are offered on site?"
      },
      "a": {
        "fr": "L'établissement dispose de la chirurgie des tissus mous, de l'échographie, de la radiographie numérique et de la rééducation.",
        "en": "The facility provides soft tissue surgery, ultrasound, digital radiography, in-house laboratory testing, and physical rehabilitation."
      },
      "basis": "website"
    }
  ],
