  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "fr": "Compétence médicale et écoute dévouée",
        "en": "Medical competence and compassionate staff"
      },
      "text": {
        "fr": "Une large majorité de propriétaires salue la gentillesse et le dévouement des docteurs Boivin, Attali, Furst et de leurs confrères. L'équipe médicale est réputée attentive, disponible et capable de dialoguer en anglais avec les expatriés. Seules quelques critiques visent des vétérinaires de garde nocturne jugés inexpérimentés sur des urgences.",
        "en": "A large majority of pet owners commend the warmth and dedication of Dr. Boivin, Dr. Attali, Dr. Furst, and their colleagues. The clinical staff is regarded as attentive, accessible, and fluent in English for expatriates. Only a few criticisms target on-call night practitioners perceived as junior during emergency care."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "fr": "Expertise des NAC et douceur animale",
        "en": "Exotic pet expertise and gentle handling"
      },
      "text": {
        "fr": "La clinique se distingue par une prise en charge reconnue des nouveaux animaux de compagnie, incluant lapins, hamsters et oiseaux grâce au docteur Anna Furst. Les propriétaires de chiens et de chats louent également la délicatesse des praticiens, qui savent rassurer les animaux anxieux ou craintifs tout au long de la consultation.",
        "en": "The clinic stands out for its recognized care of exotic companion animals, including rabbits, hamsters, and pet birds under Dr. Anna Furst. Dog and cat owners likewise praise practitioners' gentleness, effectively comforting anxious or defensive pets throughout every stage of clinical examinations."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 9,
      "title": {
        "fr": "Qualité des soins et diagnostics",
        "en": "Care quality and diagnostic outcomes"
      },
      "text": {
        "fr": "De nombreux avis soulignent des traitements réussis en cardiologie avec le docteur Saponaro, des chirurgies efficaces d'abcès et des sauvetages lors d'urgences aiguës. À l'opposé, quelques usagers regrettent des oublis de prescription antalgique pour une hernie discale ou une absence d'amélioration lors d'hospitalisations prolongées.",
        "en": "Numerous reviews report excellent therapeutic outcomes in cardiology with Dr. Saponaro, successful abscess surgeries, and timely life-saving interventions. Conversely, a few clients regret forgotten pain management prescriptions for a herniated disc or lack of clinical recovery during extended hospitalizations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "La clinique soigne-t-elle les rongeurs, lapins et oiseaux (NAC) ?",
        "en": "Does the clinic care for rodents, rabbits, and pet birds?"
      },
      "a": {
        "fr": "Oui, le docteur Anna Furst est spécialisée dans les NAC et réalise les consultations médicales ainsi que les chirurgies dédiées.",
        "en": "Yes, Dr. Anna Furst specializes in exotic pets, offering tailored medical consultations and specialized surgeries."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Les vétérinaires peuvent-ils consulter en langue anglaise ?",
        "en": "Can veterinarians conduct consultations in English?"
      },
      "a": {
        "fr": "Oui, plusieurs vétérinaires de la clinique s'expriment couramment en anglais pour accueillir les propriétaires internationaux.",
        "en": "Yes, several clinic veterinarians speak fluent English to accommodate international and expatriate pet owners."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Existe-t-il un service de cardiologie vétérinaire sur place ?",
        "en": "Is specialized veterinary cardiology available on site?"
      },
      "a": {
        "fr": "Oui, le cabinet dispose d'une compétence avancée en cardiologie avec échographies Doppler et bilans cardiaques complets.",
        "en": "Yes, the practice features advanced cardiology expertise, including Doppler ultrasounds and comprehensive heart evaluations."
      },
      "basis": "website"
    },
    {
      "q": {
        "fr": "Quels sont les horaires d'accueil des urgences ?",
        "en": "What are the hours for urgent medical care?"
      },
      "a": {
        "fr": "La clinique reçoit les urgences sur ses plages d'ouverture ; il est conseillé de téléphoner avant de se déplacer en soirée.",
        "en": "The clinic handles emergencies during operating hours; calling ahead is recommended before visiting in the evening."
      },
      "basis": "both"
    }
