  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "fr": "Attachement remarquable envers le Dr Klein",
        "en": "Deep trust in Dr Klein"
      },
      "text": {
        "fr": "Les maîtres expriment une admiration constante pour le Dr Anne-Marie Klein et son équipe d'assistantes place de la Nation. La patience, l'écoute et la bienveillance sont saluées par des familles fidèles depuis dix à vingt ans. Le professionnalisme inspire un climat de totale confiance.",
        "en": "Pet owners consistently praise Dr. Anne-Marie Klein and her assisting staff at Place de la Nation. Attentiveness, warmth, and thorough consultations are celebrated by families loyal for over a decade. The empathetic guidance provided establishes an enduring bond of mutual trust."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "fr": "Grande délicatesse avec les animaux",
        "en": "Remarkable gentleness with companion pets"
      },
      "text": {
        "fr": "Les propriétaires soulignent le comportement exceptionnellement doux avec les chiens craintifs, les chats et les petits rongeurs. Les gestes sont calmes et prévenants, ce qui apaise immédiatement les bêtes stressées. Les maîtres apprécient cette attention sincère au bien-être animal.",
        "en": "Clients highlight exceptional gentleness when examining fearful dogs, timid cats, and small rodents. Calm handling and attentive reassurance immediately soothe anxious pets during clinic visits. Guardians deeply appreciate this authentic consideration for domestic animal welfare."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "fr": "Diagnostics sûrs et accompagnement pérenne",
        "en": "Accurate diagnostics and durable support"
      },
      "text": {
        "fr": "Les retours mettent en lumière la pertinence des diagnostics médicaux et la réussite des traitements entrepris. De nombreux cas complexes ont trouvé une issue favorable après des avis infructueux ailleurs. L'accompagnement respectueux des animaux en fin de vie touche profondément les familles.",
        "en": "Reviews emphasize the precision of clinical diagnoses and the positive outcome of prescribed therapies. Several complicated conditions improved significantly following tailored treatments. Dignified palliative support during end-of-life stages also leaves pet families deeply comforted."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "La clinique soigne-t-elle les petits rongeurs et NAC ?",
        "en": "Does the clinic treat small rodents and exotics?"
      },
      "a": {
        "fr": "Oui, les clients mentionnent le suivi régulier et attentionné de lapins et petits mammifères en plus des chiens et des chats.",
        "en": "Yes, client reviews mention regular and considerate medical care for rabbits and small mammals alongside cats and dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "Comment sont gérées les urgences en dehors des ouvertures ?",
        "en": "How are out-of-hours emergencies handled?"
      },
      "a": {
        "fr": "La clinique dispose d'une permanence téléphonique 24/7 avec orientation vers le service à domicile Vétoadom.",
        "en": "The clinic maintains a 24/7 emergency telephone service with referrals to the Vetoadom home veterinary team."
      },
      "basis": "website"
    },
    {
      "q": {
        "fr": "Faut-il obligatoirement prendre rendez-vous avant de venir ?",
        "en": "Is booking an appointment required before visiting?"
      },
      "a": {
        "fr": "Oui, les consultations se déroulent sur rendez-vous du lundi au samedi pour assurer un temps d'échange suffisant.",
        "en": "Yes, consultations are held by appointment from Monday to Saturday to ensure dedicated time for each patient."
      },
      "basis": "website"
    }
  ],
