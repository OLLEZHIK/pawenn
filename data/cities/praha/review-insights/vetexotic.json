      "a": {
        "en": "The clinic specializes exclusively in exotic pets, including birds, reptiles, amphibians, and small mammals.",
        "cs": "Klinika se specializuje výhradně na exotická zvířata, zejména ptáky, plazy, obojživelníky a drobné savce."
      },
      "basis": "both"
    },
