  "cards": [
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 32,
      "title": {
        "en": "Care for parrots and exotic species",
        "cs": "Péče o papoušky a exotické druhy"
      },
      "text": {
        "en": "Keepers of parrots, lizards, chameleons, and small mammals highlight the clinic's narrow specialization in exotic animals and life-saving treatments. Conversely, critical reviews come from bird owners whose pets unfortunately did not survive complex illnesses or surgeries.",
        "cs": "Chovatelé papoušků, ještěrů, chameleonů i drobných savců vyzdvihují úzkou specializaci kliniky na exotická zvířata a záchranu složitých případů. Na druhé straně se objevují kritická hodnocení majitelů ptáků, jejichž zvířata po léčbě nebo operaci uhynula."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Expertise and approach of doctors",
        "cs": "Odbornost a přístup lékařů"
      },
      "text": {
        "en": "Most clients speak highly of the expertise and empathy shown by the veterinary team, particularly Dr. Franco and Dr. Zahálková, during delicate examinations. A few dissatisfied owners point out insufficient explanations regarding pet diagnoses and proposed treatment plans.",
        "cs": "Většina zákazníků velmi pozitivně hodnotí odbornost a empatii lékařů, zejména MVDr. Franca a MVDr. Zahálkové, při náročných vyšetřeních. Několik nespokojených hlasů však personálu vytýká nedostatečné vysvětlení zdravotního stavu zvířete a volbu léčebných kroků."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 25,
      "title": {
        "en": "Treatment results and procedure outcomes",
        "cs": "Léčebné výsledky a úspěšnost zákroků"
      },
      "text": {
        "en": "Many reviewers express gratitude for successful management of acute injuries, beak corrections, and stabilization of critically ill exotic pets. In contrast, negative reviews mention misdiagnoses or delayed therapeutic choices leading to a rapid decline in the animal's health.",
        "cs": "Řada recenzentů vděčně popisuje úspěšné zvládnutí akutních úrazů, korekcí zobáků i záchranu zvířat v kritickém stavu. Oproti tomu stojí negativní recenze poukazující na chybnou nebo opožděnou diagnostiku, po které došlo k rychlému zhoršení zdravotního stavu mazlíčka."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What types of animals are treated at VetExotic?",
        "cs": "O jaká zvířata se na klinice VetExotic starají?"
