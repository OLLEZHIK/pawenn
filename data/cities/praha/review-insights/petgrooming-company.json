  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 95,
      "title": {
        "en": "Grooming quality and coat care",
        "cs": "Kvalita střihu a kosmetické péče"
      },
      "text": {
        "en": "Clients express great satisfaction with neat haircuts, trimming, washing, and thorough de-shedding treatments. Pets leave looking clean and well-groomed, while occasional complaints mention overly short trims or minor skin irritation following the visit.",
        "cs": "Zákazníci vyjadřují mimořádnou spokojenost s precizním stříháním, trimováním, koupáním i vyčesáváním línající srsti. Mazlíčci odcházejí velmi pěkně upravení a voňaví, přičemž ojedinělé stížnosti se týkají příliš krátkého střihu nebo podráždění kůže po návštěvě."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Friendly and patient grooming staff",
        "cs": "Přátelský a trpělivý personál"
      },
      "text": {
        "en": "Dog and cat owners appreciate the kind, patient, and professional attitude of the staff, especially groomers Angelina and Lyudmila. The team manages anxious pets with calm care, though isolated reviews noted a desire for gentler handling of fearful cats.",
        "cs": "Majitelé psů i koček oceňují laskavé, trpělivé a profesionální chování personálu, zejména masterek Angeliny a Ljudmily. Groomerky zvládají i bojácná zvířata bez zbytečného stresu, ačkoli ojedinělí zákazníci postrádali větší citlivost u citlivých koček."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Attention to dogs and feline clients",
        "cs": "Péče o psy i kočičí klienty"
      },
      "text": {
        "en": "The salon welcomes a diverse range of breeds, from toy poodles and Pomeranians to large dogs and long-haired cats including Ragdolls and Maine Coons. Most pets handle the sessions smoothly, though handling nervous cats occasionally proved more demanding.",
        "cs": "Salon navštěvují zástupci nejrůznějších plemen, od toy pudlů a pomeranianů po velké psy a dlouhosrsté kočky včetně plemene ragdoll či mainská mývalí. Většina zvířat snáší procedury klidně, ačkoliv u některých nervózních koček byla úprava srsti náročnější."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can appointments at PetGrooming Company be booked online?",
        "cs": "Objednává se do salonu PetGrooming Company online?"
      },
      "a": {
        "en": "Yes, clients in reviews highlight the quick and easy online booking without needing to make a phone call.",
        "cs": "Ano, klienti v recenzích vyzdvihují možnost rychlé online rezervace termínu bez nutnosti telefonování."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the salon provide grooming services for cats?",
        "cs": "Stříhají v salonu také kočky?"
      },
      "a": {
        "en": "Yes, the salon offers haircuts, de-shedding, and brushing for cats of various breeds.",
        "cs": "Ano, salon nabízí stříhání, holení při sezónním línání i vyčesávání koček různých plemen."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does PetGrooming Company offer pet taxi services?",
        "cs": "Nabízí salon PetGrooming Company také zoo taxi?"
      },
      "a": {
        "en": "Yes, satisfied owners in reviews mention a reliable pet taxi service for transporting animals.",
        "cs": "Ano, spokojení majitelé v recenzích zmiňují spolehlivou službu zoo taxi pro dopravu mazlíčka."
      },
      "basis": "reviews"
    }
