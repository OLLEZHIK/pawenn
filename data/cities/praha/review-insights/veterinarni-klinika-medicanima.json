  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "cs": "Profesionální přístup s výhradami chovatelů",
        "en": "Professional care with client reservations"
      },
      "text": {
        "cs": "Většina klientů velmi chválí empatii, ochotu a odbornost ošetřujících lékařů i vlídné chování sestřiček při plánovaných zákrocích. Významná část negativních recenzí však kritizuje odmítnutí ošetření v akutních případech a méně vstřícnou telefonickou komunikaci.",
        "en": "Most clients warmly commend the empathy, diligence, and professionalism of veterinarians and nurses during scheduled procedures. However, a significant portion of negative reviews criticizes refusals to see acute emergency cases and curt telephone communication."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "cs": "Péče o psy i kočky",
        "en": "Attentive care for pets"
      },
      "text": {
        "cs": "Majitelé psů a koček vyzdvihují klidné zacházení se zvířaty při vyšetření i během pooperační hospitalizace na klinice. V kritických ohlasech se však objevují stížnosti na nedostatečnou péči o zvířata v kritickém stavu, kdy klinika doporučila převoz jinam.",
        "en": "Owners of dogs and cats highlight calm animal handling during medical examinations and post-operative hospitalization. Conversely, critical reviews express disappointment over unaddressed emergencies where guardians were instructed to seek care elsewhere."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "cs": "Úspěšná diagnostika a chirurgické zákroky",
        "en": "Successful diagnostics and surgical procedures"
      },
      "text": {
        "cs": "Klienti oceňují moderní vybavení kliniky, spolehlivé laboratorní testy, kvalitní zubní ošetření a záchranu zvířat v těžkém zdravotním stavu. Na druhé straně nespokojení chovatelé zmiňují pochybnosti o správnosti stanovené diagnózy a dalšího postupu léčby.",
        "en": "Pet guardians appreciate modern clinical equipment, reliable laboratory tests, quality dentistry, and lifesaving medical interventions. On the other hand, dissatisfied owners report doubts about diagnostic thoroughness and specific therapeutic decisions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "cs": "Je na klinice Medicanima k dispozici pohotovost?",
        "en": "Does Medicanima clinic provide emergency care?"
      },
      "a": {
        "cs": "Klinika poskytuje rozšířenou péči, ale pro akutní neodkladné případy mimo ordinační dobu se doporučuje předchozí telefonát.",
        "en": "The clinic provides extended care, but calling ahead is strongly advised for acute cases outside regular hours."
      },
      "basis": "both"
    },
    {
      "q": {
        "cs": "Provádí klinika ošetření zubů u psů a koček?",
        "en": "Does the clinic perform dental treatments for dogs and cats?"
      },
      "a": {
        "cs": "Ano, klienti v recenzích často chválí úspěšné dentální ošetření a odstraňování zubního kamene.",
        "en": "Yes, client reviews frequently praise successful dental procedures and ultrasound tartar removal."
      },
      "basis": "both"
    },
    {
      "q": {
