  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 54,
      "title": {
        "cs": "Zkušení chirurgové a smíšené hodnocení recepce",
        "en": "Skilled surgeons and mixed reception feedback"
      },
      "text": {
        "cs": "Majitelé zvířat často vyzdvihují vysokou odbornost a lidský přístup operatérů i ošetřujících lékařů při náročných chirurgických zákrocích. Klienti oceňují detailní vysvětlení pooperační péče. Zároveň se však v recenzích objevují výtky vůči organizaci práce na recepci a chladnějšímu jednání některých sloužících lékařů na pohotovosti.",
        "en": "Pet owners frequently praise the high expertise and humane approach of surgeons and attending veterinarians during complex operations. Clients appreciate detailed guidance on postoperative care. At the same time, reviews raise concerns about front desk organization and occasionally cold communication from emergency duty staff."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 31,
      "title": {
        "cs": "Úspěšné operace i sporné diagnózy",
        "en": "Successful surgeries alongside disputed diagnoses"
      },
      "text": {
        "cs": "Klinika dosahuje podle recenzentů velmi dobrých výsledků při záchraně akutních pacientů, složité neurologii a ortopedických operacích. Řada zvířat se díky včasné intenzivní péči úspěšně zotavila. Několik chovatelů však vyjadřuje zklamání z neúspěšné léčby či nesprávně vyhodnoceného zdravotního stavu u rizikových případů.",
        "en": "According to reviewers, the hospital achieves very good outcomes in emergency resuscitation, complex neurology, and orthopedic surgeries. Many animals made a full recovery thanks to timely intensive therapy. However, several guardians express disappointment over unsuccessful treatment or disputed diagnoses in critical situations."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 28,
      "title": {
        "cs": "Dlouhé čekání během pohotovosti",
        "en": "Extended waiting times during emergency hours"
      },
      "text": {
        "cs": "Čekací doby v čekárně bývají terčem časté kritiky návštěvníků, a to i u chovatelů s předchozím časovým objednáním. Návštěvníci upozorňují, že kvůli přednosti pro život ohrožující stavy se pobyt v čekárně může protáhnout na několik hodin. Někteří klienti proto doporučují předem ověřit aktuální vytížení pracoviště.",
        "en": "Waiting times in the reception area are frequently criticized by visitors, even by pet owners who booked an appointment in advance. Visitors point out that emergency prioritization for life-threatening cases can extend waiting room stays to several hours. Several clients therefore recommend calling ahead to check current clinic volume."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "cs": "Lze na kliniku přijet na pohotovost bez objednání?",
        "en": "Can clients arrive for emergency care without an appointment?"
      },
      "a": {
        "cs": "Ano, nemocnice zajišťuje nepřetržitou pohotovost, ale přednostně jsou vždy ošetřováni pacienti v kritickém ohrožení života.",
        "en": "Yes, the hospital operates a 24/7 emergency service, though patients in life-threatening condition are always given immediate priority."
      },
      "basis": "both"
    },
    {
      "q": {
        "cs": "Je u kliniky VETCENTRUM Duchek k dispozici parkování?",
        "en": "Is dedicated parking available at VETCENTRUM Duchek?"
      },
      "a": {
        "cs": "Ano, klinika disponuje vlastním vyhrazeným parkovištěm pro klienty a venčicí plochou pro psy přímo v areálu.",
        "en": "Yes, the clinic provides its own customer parking lot and an on-site dog walking area for visiting pet owners."
      },
      "basis": "both"
    },
    {
      "q": {
        "cs": "Jaké diagnostické vybavení má klinika přímo na pracovišti?",
        "en": "What diagnostic equipment is available on site at the clinic?"
      },
      "a": {
        "cs": "Nemocnice má k dispozici počítačovou tomografii (CT), digitální rentgen, ultrazvuk a plně vybavenou jednotku intenzivní péče.",
        "en": "The hospital is equipped with on-site computed tomography (CT), digital X-ray, ultrasound, and an intensive care hospitalization unit."
      },
      "basis": "both"
    }
  ],
