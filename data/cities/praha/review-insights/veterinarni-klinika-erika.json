  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "cs": "Ochotný tým s citlivým přístupem",
        "en": "Helpful veterinary team with compassionate care"
      },
      "text": {
        "cs": "Většina chovatelů vyzdvihuje vstřícnost lékařů i sestřiček, jejich ochotu uklidnit vystrašené zvíře a srozumitelně popsat každou fázi ošetření. Majitelé oceňují vlídné a trpělivé vystupování personálu. Kladně je hodnocena také jazyková vybavenost týmu při bezproblémové komunikaci se zahraničními klienty.",
        "en": "Most pet owners highlight the helpfulness of doctors and veterinary nurses, their ability to soothe anxious animals, and clear explanations of every care step. Owners value the kind and patient team approach. Foreign clients also appreciate the staff's fluent multilingual communication."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "cs": "Rychlá záchrana při otravách a dušení",
        "en": "Prompt assistance in poisoning and choking"
      },
      "text": {
        "cs": "Klinika si získala velkou důvěru klientů díky úspěšným zásahům při akutním udušení, otravách i náhlých zhoršeních zdravotního stavu psů a koček. Recenzenti děkují za včasné zahájení intenzivní terapie a profesionální péči, která jejich zvířatům pomohla překonat krizový stav a zachránila jim život.",
        "en": "The practice earned strong trust through prompt intervention during acute choking, toxic ingestions, and sudden health crises in dogs and cats. Reviewers express deep gratitude for rapid intensive therapy and professional care that helped their pets overcome critical distress and saved their lives."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 19,
      "title": {
        "cs": "Pohotovostní příjem a víkendové čekání",
        "en": "Emergency intake and weekend queue times"
      },
      "text": {
        "cs": "Díky nepřetržitému provozu je klinika častým cílem pro akutní případy, což však zejména o víkendech a večerech vede k delšímu čekání v čekárně. Akutní pacienti mají přednost, což prodlužuje dobu ošetření běžných případů. Majitelé doporučují před neurgentní návštěvou na kliniku předem zavolat a ověřit vytížení.",
        "en": "Due to continuous operation, the clinic frequently handles acute admissions, which can result in longer waiting times on weekends and evenings. Acute patients take precedence, delaying non-urgent appointments. Guardians suggest calling ahead before routine visits to verify current waiting room capacity."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "cs": "Poskytuje klinika Erika nepřetržitou veterinární pohotovost?",
        "en": "Does Erika clinic provide round-the-clock emergency care?"
      },
      "a": {
        "cs": "Ano, klinika funguje v nepřetržitém režimu včetně víkendů a svátků pro všechny akutní veterinární případy.",
        "en": "Yes, the clinic operates continuously including weekends and public holidays to handle urgent veterinary emergencies."
      },
      "basis": "both"
    },
    {
      "q": {
        "cs": "Jaké platební metody klinika akceptuje?",
        "en": "What payment methods are accepted at the clinic?"
      },
      "a": {
        "cs": "Na klinice lze platit hotově i běžnými platebními kartami, při pohotovostním ošetření je účtován pohotovostní příplatek.",
        "en": "The clinic accepts cash and standard payment cards; an emergency surcharge applies during night and weekend shifts."
      },
      "basis": "both"
    },
    {
      "q": {
        "cs": "Ošetřují na klinice také drobná zvířata a hlodavce?",
        "en": "Does the clinic treat small pets and exotic mammals?"
      },
      "a": {
        "cs": "Primární zaměření kliniky tvoří psi a kočky; u specifických onemocnění drobných savců klienti doporučují konzultovat přítomnost specialisty.",
        "en": "The clinic focuses primarily on dogs and cats; for complex small mammal conditions, owners recommend verifying specialist availability."
      },
      "basis": "reviews"
    }
