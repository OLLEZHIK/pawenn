  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 68,
      "title": {
        "de": "Kompetente Beratung für Haustierhalter",
        "en": "Knowledgeable guidance for pet guardians"
      },
      "text": {
        "de": "Tierhalter loben die Hilfsbereitschaft und das Fachwissen der Mitarbeitenden bei der Erstausstattung von Welpen oder der Auswahl passender Geschirre. Bei Fragen zu Futtermitteln und Aquaristik nimmt sich das Verkaufsteam viel Zeit für eine persönliche und engagierte Beratung.",
        "en": "Pet owners commend the helpfulness and expertise of staff members when selecting starter kits for puppies or fitting dog harnesses. For dietary inquiries and aquarium setup questions, the sales team readily takes time to deliver thoughtful, personalized advice."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "de": "Gepflegte Tierabteilungen und Hundefreundlichkeit",
        "en": "Well-maintained livestock and canine hospitality"
      },
      "text": {
        "de": "Besucher äußern sich positiv über die artgerechte und saubere Unterbringung der Zierfische, Vögel und Kleinsäuger im Markt. Hunde sind gern gesehene Begleiter beim Einkauf und können Geschirre oder Liegematten direkt im Geschäft entspannt anprobieren.",
        "en": "Visitors speak favorably of clean and well-kept enclosures for ornamental fish, birds, and small mammals throughout the store. Dogs are warmly welcomed during shopping trips and can comfortably try out harnesses and sleeping mats directly on the retail floor."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "de": "Riesige Auswahl im Euro-Industriepark",
        "en": "Vast assortment at Euro-Industriepark"
      },
      "text": {
        "de": "Kunden schätzen die weitläufige Verkaufsfläche und die enorme Produktvielfalt für Hunde, Katzen, Kleintiere und Vögel. Von Spezialfutter über Autotransportboxen bis hin zu Kratzbäumen ist das Sortiment überaus reichhaltig, sauber und übersichtlich präsentiert.",
        "en": "Shoppers appreciate the spacious retail layout and extensive variety of supplies for dogs, cats, small animals, and birds. From specialized pet foods and vehicle crates to scratching posts, the assortment is comprehensively stocked, clean, and well organized."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Dürfen Kunden ihre Hunde zum Einkaufen mitbringen?",
        "en": "Can customers bring their dogs along while shopping?"
      },
      "a": {
        "de": "Ja, angeleinte Hunde sind im Fachmarkt willkommen und können Zubehör wie Geschirre oder Mäntel vor Ort anprobieren.",
        "en": "Yes, leashed dogs are welcome in the store and may test accessories such as harnesses or coats on site."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es Parkmöglichkeiten vor dem Markt im Euro-Industriepark?",
        "en": "Is customer parking available at the Euro-Industriepark branch?"
      },
      "a": {
        "de": "Ja, direkt vor der Filiale stehen zahlreiche kostenfreie Parkplätze für einen bequemen Einkauf zur Verfügung.",
        "en": "Yes, numerous free parking spaces are available right in front of the store for convenient shopping."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden Fische und Aquaristikbedarf im Markt angeboten?",
        "en": "Are ornamental fish and aquarium supplies sold in the store?"
      },
      "a": {
        "de": "Ja, der Standort verfügt über eine große Aquaristikabteilung mit Zierfischen, Wasserpflanzen, Aquarien und Zubehör.",
        "en": "Yes, the location features an extensive aquaristics department offering fish, aquatic plants, aquariums, and accessories."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Bietet das Geschäft Unterstützung bei der Auswahl von Autotransportboxen?",
        "en": "Does the store assist with fitting vehicle dog crates?"
      },
      "a": {
        "de": "Ja, Kunden berichten von ausführlicher Beratung zur passenden Transportbox für den jeweiligen Fahrzeugtyp.",
        "en": "Yes, customers report detailed guidance on choosing suitable transport boxes tailored to specific vehicle models."
      },
      "basis": "reviews"
    }
  ],
