  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 53,
      "title": {
        "de": "Engagierte Fachärzte und medizinisches Personal",
        "en": "Dedicated veterinary specialists and clinic staff"
      },
      "text": {
        "de": "Viele Tierhalterinnen loben das Fachwissen der Universitätstierärzte sowie den empathischen Einsatz des Pflegeteams. Ärztinnen wie Frau Doerr oder Frau Dr. Kuzek werden für ihre gründliche Diagnostik und einfühlsame Betreuung schwer kranker Tiere dankbar hervorgehoben.",
        "en": "Many pet owners praise the specialist knowledge of university clinicians and the compassionate dedication of nursing staff. Doctors are frequently commended for thorough diagnostics and empathetic support during critical illnesses and stressful medical treatments."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 28,
      "title": {
        "de": "Geteilte Erfahrungen bei Notdienst-Wartezeiten",
        "en": "Mixed experiences with emergency waiting times"
      },
      "text": {
        "de": "Während akute Notfallpatienten oft sofort erstversorgt werden, beklagen Besucher stabilerer Tiere teils mehrstündige Wartezeiten in der Notaufnahme. Hohe Auslastung und personelle Engpässe in Nachtschichten führen zu spürbaren Verzögerungen im Wartebereich.",
        "en": "While acute life-threatening emergencies often receive immediate triage, visitors with stable animals report multi-hour waiting periods in emergency reception. High caseloads and staffing constraints during overnight shifts lead to noticeable delays in the waiting room."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "de": "Lebensrettende Versorgung bei schweren Notfällen",
        "en": "Lifesaving interventions in acute emergencies"
      },
      "text": {
        "de": "Rezensionen berichten wiederholt von erfolgreichen Operationen, kardiologischen Eingriffen und neurologischen Behandlungen, die Haustieren in lebensbedrohlichen Lagen das Leben retteten. Die moderne universitäre Ausstattung ermöglicht Therapien auf höchstem Niveau.",
        "en": "Reviews consistently describe successful surgical procedures, interventional cardiology, and neurology therapies that saved animal lives in critical situations. Advanced university equipment enables complex interventions exceeding standard practice capabilities."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Bietet die LMU Kleintierklinik einen 24-Stunden-Notdienst an?",
        "en": "Does the LMU Small Animal Clinic provide 24-hour emergency care?"
      },
      "a": {
        "de": "Ja, die Notfallambulanz ist rund um die Uhr für akut lebensbedrohlich erkrankte und verletzte Haustiere geöffnet.",
        "en": "Yes, the emergency casualty unit is open around the clock for critically ill and injured animals."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Welche Spezialdisziplinen stehen an der Klinik zur Verfügung?",
        "en": "What specialist medical disciplines are available at the clinic?"
      },
      "a": {
        "de": "Die Klinik verfügt über Fachabteilungen für Kardiologie, Onkologie, Neurologie, Weichteilchirurgie und Gastroenterologie.",
        "en": "The clinic houses departments for cardiology, oncology, neurology, soft-tissue surgery, and gastroenterology."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Wie werden Notfallpatienten vor Ort priorisiert?",
        "en": "How are emergency patients triaged on arrival?"
      },
      "a": {
        "de": "Patienten werden nach medizinischer Dringlichkeit behandelt, weshalb bei stabilerem Zustand längere Wartezeiten entstehen können.",
        "en": "Patients are treated according to medical urgency, meaning stable cases may experience prolonged waiting times."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Gibt es vor Ort ein eigenes Blutspendeprogramm für Hunde?",
        "en": "Does the clinic run a dedicated canine blood donation program?"
      },
      "a": {
        "de": "Ja, die Klinik führt Blutspendeaktionen für Hunde durch, um Notfalltransfusionen jederzeit sicherzustellen.",
        "en": "Yes, the hospital operates a canine blood donor registry to secure plasma and blood for emergency transfusions."
      },
      "basis": "reviews"
    }
  ],
