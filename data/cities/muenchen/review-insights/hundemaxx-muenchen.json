  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "de": "Fachkundige Beratung für Maulkörbe und Geschirre",
        "en": "Expert guidance for muzzles and harnesses"
      },
      "text": {
        "de": "In zahlreichen Rezensionen wird die individuelle Beratung bei der Maulkorbanpassung und Geschirrauswahl lobend erwähnt. Das Personal nimmt sich viel Zeit für die genaue Passform und berät geduldig. Nur vereinzelt wünschen sich Besucher an gut besuchten Tagen mehr verfügbare Berater.",
        "en": "Numerous customer reviews highlight individual fitting consultations for muzzles and ergonomic harnesses. Staff members take substantial time to verify accurate sizing with patience. Only occasionally do shoppers note a desire for more available staff during peak shopping hours."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "de": "Hundefreundliche Umgebung mit physiotherapeutischem Angebot",
        "en": "Dog-friendly setting with physiotherapy services"
      },
      "text": {
        "de": "Vierbeiner sind im Laden ausdrücklich willkommen und können Geschirre oder Schlafplätze direkt vor Ort ausprobieren. Kunden heben zudem positiv hervor, dass eine hauseigene Hunde-Physiotherapeutin mit viel Gespür auf Bewegungseinschränkungen und das Wohlbefinden der Tiere eingeht.",
        "en": "Dogs are explicitly welcomed inside the store and can try on harnesses or bedding on the spot. Pet guardians also highlight the presence of an in-house canine physiotherapist who handles mobility issues and physical well-being with exceptional sensitivity and care."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "de": "Große Ausstellungsfläche auf drei Etagen",
        "en": "Extensive retail space on three floors"
      },
      "text": {
        "de": "Hundehalter schätzen die enorme Produktauswahl des Fachgeschäfts im Münchner Westen. Auf mehreren Ebenen finden Besucher ein breit gefächertes Angebot an Hundebetten, Leinen, Geschirren und Futtermarken. Parkplätze direkt vor dem Gebäude erleichtern den Transport schwerer Einkäufe.",
        "en": "Dog owners appreciate the huge selection of supplies at this specialty store in western Munich. Across multiple levels, shoppers discover an expansive range of dog beds, leashes, harnesses, and nutrition brands. Dedicated parking spaces in front of the building facilitate loading."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Bietet der Hundemaxx professionelle Maulkorbberatung an?",
        "en": "Does Hundemaxx offer professional muzzle fittings?"
      },
      "a": {
        "de": "Ja, geschulte Mitarbeiterinnen führen individuelle Maulkorbanpassungen direkt am Hund durch, um optimalen Sitz zu gewährleisten.",
        "en": "Yes, trained staff members perform customized muzzle fittings on dogs to ensure a secure and comfortable fit."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Dürfen Hunde beim Einkaufen mit in den Laden?",
        "en": "Are dogs allowed inside the store during visits?"
      },
      "a": {
        "de": "Ja, Hunde sind herzlich willkommen und dürfen Geschirre, Mäntel oder Betten direkt vor Ort anprobieren.",
        "en": "Yes, dogs are warmly welcomed and may test harnesses, coats, or beds directly on the sales floor."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es Parkplätze direkt vor dem Geschäft?",
        "en": "Is parking available directly at the store?"
      },
      "a": {
        "de": "Ja, vor dem Gebäude stehen Kundenparkplätze für ein bequemes Be- und Entladen zur Verfügung.",
        "en": "Yes, on-site customer parking spaces are available right in front of the building for easy loading."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es auch Produkte für Katzen im Geschäft?",
        "en": "Are cat supplies also available in the store?"
