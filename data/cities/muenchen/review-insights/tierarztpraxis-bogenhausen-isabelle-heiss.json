  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "de": "Vielseitiges Ärzteteam mit engagierter Patientenbetreuung",
        "en": "Versatile team with dedicated patient care"
      },
      "text": {
        "de": "Patientenbesitzer heben die hohe fachliche Qualifikation und die freundliche Art der Tierärztinnen um Isabelle Heiss hervor. Das Team nimmt sich viel Zeit für Fragen und berät ausführlich zu Diagnosen und Vorsorgeuntersuchungen. Vereinzelt äußern Halter Kritik an wechselnden Ansprechpartnern oder missglückten Behandlungsgesprächen.",
        "en": "Pet owners commend the high clinical competence and friendly demeanor of the veterinarians led by Isabelle Heiss. The clinic staff takes ample time for questions and provides detailed consultations on diagnoses and preventive check-ups. Occasional reviews voice criticism regarding rotating doctors or communication lapses."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "de": "Einfühlsame Behandlung von Hunden und Katzen",
        "en": "Compassionate treatment of dogs and cats"
      },
      "text": {
        "de": "Besucher schätzen den ruhigen und liebevollen Umgang mit Tieren in allen Lebensphasen, von Welpen bis zu hochbetagten Senioren. Selbst nervöse Katzen und ängstliche Hunde werden geduldig betreut, sodass Untersuchungen möglichst schonend verlaufen. Halter heben das spürbare Einfühlungsvermögen des gesamten Praxisteams hervor.",
        "en": "Visitors appreciate the gentle and calm approach towards animals across all life stages, from young puppies to geriatric seniors. Even nervous cats and anxious dogs are attended to patiently, keeping clinical procedures gentle. Guardians consistently highlight the tangible empathy shown by the entire veterinary team."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "de": "Wochenendsprechstunden bei geteilten Erfahrungen mit Wartezeiten",
        "en": "Weekend consultations with mixed waiting times"
      },
      "text": {
        "de": "Besonders positiv bewerten Tierhalter die regulären Sprechzeiten am Samstag und Sonntag, die Berufstätigen und Akutfällen entgegenkommen. Termine werden meist zügig vergeben. Dennoch berichten mehrere Rezensenten über spürbare Wartezeiten in der Praxis von bis zu 45 Minuten, selbst wenn vorab ein fester Termin vereinbart wurde.",
        "en": "Pet owners particularly value the regular clinic consultation hours on Saturdays and Sundays, which greatly benefit working owners and acute cases. Appointments are generally arranged promptly. However, multiple reviewers report noticeable clinic waiting times of up to 45 minutes, even when an appointment was scheduled in advance."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Bietet die Tierarztpraxis Bogenhausen Sprechstunden am Wochenende an?",
        "en": "Does the Bogenhausen practice offer weekend hours?"
      },
      "a": {
        "de": "Ja, die Praxis bietet auch an Samstagen und Sonntagen reguläre Sprechstunden für Kleintiere an.",
        "en": "Yes, the clinic offers regular consultation hours on both Saturdays and Sundays for small animals."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden in der Praxis spezialisierte Fachgebiete abgedeckt?",
        "en": "Are specialized disciplines covered at the clinic?"
      },
      "a": {
        "de": "Ja, im Team sind Fachärztinnen für verschiedene Disziplinen wie Zahnmedizin, Kardiologie und Chirurgie tätig.",
        "en": "Yes, the clinic team includes specialists in diverse fields such as veterinary dentistry, cardiology, and surgery."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden Hausbesuche für Patienten durchgeführt?",
        "en": "Are home visits conducted for patients?"
      },
      "a": {
        "de": "Hausbesuche werden im näheren Umkreis angeboten, wobei die Praxis einen festen Radius von rund 10 km einhält.",
        "en": "Home visits are offered within the immediate area, adhering to a defined radius of approximately 10 km."
      },
      "basis": "both"
    }
