  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "de": "Einfühlsame Betreuung mit gelegentlicher Kritik",
        "en": "Compassionate care with occasional criticism"
      },
      "text": {
        "de": "Zahlreiche Tierhalter schätzen die freundliche Atmosphäre und den liebevollen Umgang mit ängstlichen Hunden und Katzen. Viele Patienten fühlen sich bei Routinebehandlungen und akuten Notfällen fachlich gut aufgehoben, wenngleich einzelne Halter in Ernstfällen mangelndes Feingefühl beklagen.",
        "en": "Many pet owners appreciate the welcoming atmosphere and gentle handling of anxious dogs and cats. Numerous clients feel well supported during routine examinations and emergency visits, though isolated reviews report perceived insensitivity during difficult health crises."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "de": "Moderne Praxisräume an der Theresienwiese",
        "en": "Modern clinic facilities near Theresienwiese"
      },
      "text": {
        "de": "Die Praxisräumlichkeiten am Bavariaring werden als ausgesprochen sauber, ansprechend gestaltet und gut ausgestattet beschrieben. Tierhalter schätzen die gepflegte Praxiseinrichtung und die angenehme Umgebung, die Tieren und Haltern den Praxisaufenthalt spürbar erleichtert.",
        "en": "The practice premises on Bavariaring are described as exceptionally clean, appealingly designed, and well equipped. Pet guardians value the pristine clinic interior and pleasant environment, which noticeably eases the clinical experience for animals and owners alike."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "de": "Schnelle Notfallhilfe und digitale Buchung",
        "en": "Rapid emergency support and digital booking"
      },
      "text": {
        "de": "Besucher äußern sich positiv über die zügige Terminvergabe und die unkomplizierte Terminbuchung über das Online-System. Im akuten Notfall erhalten verletzte oder erkrankte Haustiere oft ohne lange Verzögerung eine kompetente medizinische Erstversorgung in der Praxis.",
        "en": "Visitors express positive feedback regarding prompt appointment availability and straightforward scheduling through the online system. In urgent emergencies, injured or sick companion animals frequently receive swift and competent medical care without long delays."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Bietet die filu Tierarztpraxis Theresienwiese eine Notfallversorgung an?",
        "en": "Does the filu Theresienwiese clinic offer emergency care?"
      },
      "a": {
        "de": "Ja, die Praxis deckt neben der Allgemeinmedizin auch Akut- und Notfallbehandlungen für Kleintiere ab.",
        "en": "Yes, alongside general veterinary medicine, the practice provides acute and emergency care for small animals."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Können Termine bei filu online gebucht werden?",
        "en": "Can appointments at filu be booked online?"
      },
      "a": {
        "de": "Ja, Termine können unkompliziert über die Website oder das digitale Buchungssystem der Praxis vereinbart werden.",
        "en": "Yes, appointments can be scheduled easily via the clinic website and online booking platform."
      },
      "basis": "website"
    },
    {
      "q": {
        "de": "Wie werden tierärztliche Behandlungen abgerechnet?",
        "en": "How are veterinary treatments billed at the clinic?"
      },
      "a": {
        "de": "Die Abrechnung erfolgt nach der Tierärztlichen Gebührenordnung (GOT), wobei häufig der zweifache Satz angesetzt wird.",
        "en": "Treatments are billed under the German veterinary fee schedule (GOT), frequently applying a two-fold multiplier rate."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Werden Hunde mit ausgeprägter Angst vor Tierarztbesuchen einfühlsam behandelt?",
        "en": "Are anxious pets handled with special patience?"
      },
      "a": {
        "de": "Ja, Rezensenten berichten überwiegend von geduldigem und behutsamem Eingehen auf ängstliche oder schüchterne Tiere.",
        "en": "Yes, reviewers predominantly report patient, gentle handling of timid or fearful companion animals."
      },
      "basis": "reviews"
    }
