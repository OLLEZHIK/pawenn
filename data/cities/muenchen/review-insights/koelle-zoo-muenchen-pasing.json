  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "de": "Freundliche Beratung im Fachmarkt",
        "en": "Friendly guidance from store staff"
      },
      "text": {
        "de": "Zahlreiche Besucher heben die Zuvorkommenheit und Fachkenntnis einzelner Teammitglieder hervor. Ob bei Fragen zu Hundegeschirren, Nagetieren oder Futtermarken – Kunden schätzen die geduldigen Auskünfte vor Ort. Nur vereinzelt wird von wenig aufmerksamen Servicekräften berichtet.",
        "en": "Many visitors praise the helpfulness and specialist knowledge of individual team members. Whether inquiring about dog harnesses, small rodents, or specialized pet foods, customers value patient advice. Only occasional reviews mention inattentive customer service interactions."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 33,
      "title": {
        "de": "Geteiltes Echo zur Lebendtierhaltung",
        "en": "Mixed feedback on livestock care"
      },
      "text": {
        "de": "Während Besucher das tierfreundliche Umfeld für Begleithunde und die Kleintierabteilung schätzen, äußern Aquarianer deutliche Kritik. Wiederholt werden kranke Zierfische in den Becken sowie unzureichend versorgte Futterinsekten beanstandet, was zu geteilten Erfahrungsberichten führt.",
        "en": "While visitors appreciate the pet-friendly setting for companion dogs and small animals, aquarium keepers express strong dissatisfaction. Multiple reports point out diseased fish in display tanks and neglected feeder insects, resulting in mixed customer assessments."
      }
    },
    {
      "topic": "place",
      "sentiment": "mixed",
      "mentions": 25,
      "title": {
        "de": "Modernisierter Markt mit geteilter Resonanz",
        "en": "Modernized store with varied impressions"
      },
      "text": {
        "de": "Nach dem Umbau präsentiert sich die Pasinger Filiale hell und mit praktischen Parkplätzen direkt vor dem Haus. Neben Lob für den barrierefreien Eingang und saubere Gänge bedauern Stammkunden jedoch die Verkleinerung einzelner Fachabteilungen und ein kompakteres Gesamtsortiment.",
        "en": "Following store renovations, the Pasing branch presents a bright retail area with convenient car parking right outside. Beside praise for step-free access and clean aisles, longtime patrons note reduced floor space in specialist sections and a narrower overall range."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Dürfen Hunde mit in den Kölle Zoo Pasing genommen werden?",
        "en": "Are dogs allowed inside the Kölle Zoo Pasing store?"
      },
      "a": {
        "de": "Ja, angeleinte Hunde sind im Markt willkommen und dürfen Produkte wie Geschirre oder Hundebetten direkt vor Ort testen.",
        "en": "Yes, leashed dogs are welcome inside the store and may try on harnesses or dog beds directly on site."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es Parkplätze direkt vor dem Geschäft?",
        "en": "Is parking available directly outside the store?"
      },
      "a": {
        "de": "Ja, vor dem Fachmarkt steht den Kunden ein eigener Parkplatz mit barrierefreiem Zugang zur Verfügung.",
        "en": "Yes, a dedicated customer car park with step-free entrance access is located right in front of the store."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es im Markt einen Tierarzt oder Hundesalon?",
        "en": "Are veterinary or dog grooming services available in the store?"
      },
      "a": {
        "de": "Ja, am Standort sind Partnerdienstleistungen wie ein Tierarzt und ein Pflegesalon für Hunde integriert.",
        "en": "Yes, partner services including a veterinary practice and a dog grooming salon are integrated at this location."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden lebende Fische und Aquarienpflanzen geführt?",
        "en": "Does the store sell live fish and aquarium plants?"
      },
      "a": {
        "de": "Ja, der Markt führt Süßwasserfische und Wasserpflanzen, jedoch keine Meerwasserabteilung.",
        "en": "Yes, the store carries freshwater fish and aquatic plants, though it does not feature a marine aquarium section."
      },
      "basis": "reviews"
    }
