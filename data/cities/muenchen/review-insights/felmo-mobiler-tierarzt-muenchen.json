  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "de": "Einfühlsame Tierärztinnen beim Hausbesuch",
        "en": "Compassionate veterinarians during home visits"
      },
      "text": {
        "de": "Zahlreiche Tierhalterinnen loben die Geduld und Fachkompetenz der mobilen Tierärzte bei Untersuchungen in den eigenen vier Wänden. Das Team nimmt sich viel Zeit für Fragen, berät ausführlich zu Medikation und Fütterung und schafft eine vertrauensvolle Atmosphäre für Mensch und Tier.",
        "en": "Numerous pet owners highlight the patience and clinical competence of the mobile veterinarians during home examinations. The team takes ample time to address questions, provides detailed guidance on medication and nutrition, and creates a reassuring environment for pets and owners alike."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "de": "Stressfreie Untersuchung für ängstliche Haustiere",
        "en": "Stress-free care for anxious animals"
      },
      "text": {
        "de": "In den Berichten wird besonders hervorgehoben, wie behutsam die Tierärztinnen mit scheuen Katzen und nervösen Hunden umgehen. Der Hausbesuch erspart den Tieren den anstrengenden Transport in eine Praxis, sodass Behandlungen und Impfungen ohne Panik oder Zwang durchgeführt werden.",
        "en": "Reviews emphasize how gently the veterinarians handle timid cats and nervous dogs in their familiar domestic environment. Home appointments eliminate the stress of travel to a clinic, allowing routine treatments and vaccinations to proceed calmly without fear or restraint."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "de": "Pünktliche Hausbesuche und zügige Terminvergabe",
        "en": "Punctual arrivals and prompt booking"
      },
      "text": {
        "de": "Tierbesitzer schätzen die unkomplizierte Buchung über die App sowie die Zuverlässigkeit bei vereinbarten Terminen. Die Tierärzte treffen meist pünktlich im vereinbarten Zeitfenster ein, was die Tagesplanung erleichtert und unnötige Wartezeiten in vollen Wartezimmern vermeidet.",
        "en": "Pet owners appreciate straightforward appointment scheduling via the mobile app alongside dependable arrival times. Veterinarians generally arrive promptly within the agreed time window, making daily planning convenient and avoiding uncomfortable waits in crowded waiting rooms."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Wie läuft ein mobiler Tierarztbesuch von felmo ab?",
        "en": "How does a mobile vet visit from felmo work?"
      },
      "a": {
        "de": "Die Tierärzte kommen direkt nach Hause, bringen medizinische Ausrüstung sowie Medikamente mit und untersuchen das Tier in seiner gewohnten Umgebung.",
        "en": "Veterinarians visit directly at home, bringing necessary diagnostic tools and medications to examine the pet in its familiar surroundings."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Können auch Impfungen und Blutabnahmen zu Hause gemacht werden?",
        "en": "Can vaccinations and blood tests be performed at home?"
      },
      "a": {
        "de": "Ja, Routineuntersuchungen, Impfungen, Krallenschneiden und Blutabnahmen werden regelmäßig vor Ort beim Hausbesuch durchgeführt.",
        "en": "Yes, routine check-ups, vaccinations, nail trimming, and blood draws are routinely performed on site during home visits."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Ist eine Begleitung beim Abschied des Haustiers zu Hause möglich?",
        "en": "Is home euthanasia available for pets?"
      },
      "a": {
        "de": "Ja, felmo bietet würdevolle Einschläferungen in vertrauter Umgebung an, um dem Tier den Stress eines Kliniktransports zu ersparen.",
        "en": "Yes, felmo provides compassionate home euthanasia in familiar surroundings to spare animals the distress of clinic visits."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Wie werden Termine bei felmo vereinbart?",
        "en": "How are appointments booked with felmo?"
      },
      "a": {
        "de": "Termine werden bequem über die felmo-App oder die Website für ein gewünschtes Zeitfenster gebucht.",
        "en": "Appointments are scheduled conveniently through the felmo app or website for a chosen time slot."
      },
      "basis": "website"
    }
  ],
