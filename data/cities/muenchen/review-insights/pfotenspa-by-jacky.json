  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "de": "Herzliches und kundenorientiertes Grooming-Team",
        "en": "Warm and customer-focused grooming team"
      },
      "text": {
        "de": "Kundinnen und Kunden loben Jacky und Sam für ihre außergewöhnliche Freundlichkeit, fachliche Kompetenz und sympathische Art. Das Team nimmt sich viel Zeit für persönliche Absprachen und schafft eine entspannte Wohlfühlatmosphäre für Halter und Tiere im Salon in Trudering.",
        "en": "Clients praise Jacky and Sam for their exceptional friendliness, professional expertise, and pleasant manner. The team takes ample time for individual consultations and creates a relaxed, comfortable atmosphere for both guardians and pets in the Trudering salon."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "de": "Einfühlsamer Umgang mit ängstlichen Vierbeinern",
        "en": "Gentle approach with sensitive companion pets"
      },
      "text": {
        "de": "Zahlreiche Bewertungen betonen den liebevollen und geduldigen Umgang selbst mit nervösen, wasserscheuen Hunden oder scheuen Katzen. Durch behutsames Vorgehen und gezielte Pausen fassen selbst traumatisierte Tierschutztiere schnell Vertrauen bei der Fell- und Krallenpflege.",
        "en": "Numerous reviews emphasize the loving and patient handling of anxious dogs and hesitant cats. Thanks to gentle handling and thoughtful breaks, even sensitive rescue pets quickly gain confidence and remain at ease during coat grooming and nail trimming."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "de": "Hervorragende Schnitte und professionelle Fellpflege",
        "en": "Outstanding trims and skilled coat maintenance"
      },
      "text": {
        "de": "Tierhalter zeigen sich begeistert von den typgerechten Schuren, dem präzisen Auskämmen der Unterwolle und der sorgfältigen Entfilzung. Selbst bei stark vernachlässigtem Fell oder Hautproblemen liefert der Salon saubere, natürlich gepflegte und formschöne Ergebnisse.",
        "en": "Pet owners are delighted with breed-appropriate trims, precise undercoat de-shedding, and meticulous de-matting. Even when handling heavily matted fur or sensitive skin conditions, the salon achieves clean, naturally well-groomed, and visually appealing results."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Werden bei PfotenSpa by Jacky auch Katzen gepflegt?",
        "en": "Are cats also groomed at PfotenSpa by Jacky?"
      },
      "a": {
        "de": "Ja, mehrere Halterinnen und Halter berichten von erfolgreicher, einfühlsamer Fell- und Krallenpflege bei Katzen und Katern.",
        "en": "Yes, multiple pet owners report successful and gentle grooming treatments for cats and toms."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Können Termine im Hundesalon online gebucht werden?",
        "en": "Can grooming sessions be booked online?"
      },
      "a": {
        "de": "Ja, Kunden heben hervor, dass Termine bequem über das Online-System im Voraus geplant und vereinbart werden können.",
        "en": "Yes, clients highlight that appointments can be conveniently scheduled and booked in advance through the online system."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Nimmt der Salon Hunde mit stark verfilztem Fell an?",
        "en": "Does the salon accept dogs with heavily matted fur?"
      },
      "a": {
        "de": "Ja, Erfahrungsberichte bestätigen, dass das Team auch schwierige Pflegefälle geduldig und professionell aufarbeitet.",
        "en": "Yes, customer experiences confirm that the team handles challenging de-matting cases with great patience and skill."
      },
      "basis": "reviews"
    }
