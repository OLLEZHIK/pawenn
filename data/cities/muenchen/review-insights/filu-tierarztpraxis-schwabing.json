  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "de": "Freundliches und engagiertes Praxisteam",
        "en": "Friendly and dedicated practice staff"
      },
      "text": {
        "de": "Tierhalter in Schwabing heben die herzliche Atmosphäre und die geduldige Betreuung durch das junge Ärzteteam und die Fachangestellten hervor. Viele Patienten fühlen sich bei Vorsorgeuntersuchungen und Routinebehandlungen gut beraten, wenngleich einzelne Halter in Ernstfällen mehr Gründlichkeit vermissen.",
        "en": "Pet owners in Schwabing highlight the warm atmosphere and patient care delivered by the veterinary practitioners and clinical assistants. Many clients feel thoroughly advised during routine check-ups and preventative care, though isolated reviews express a desire for greater diligence during health crises."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "de": "Digitale Terminbuchung neben Notfallengpässen",
        "en": "Digital appointment booking alongside emergency constraints"
      },
      "text": {
        "de": "Klienten schätzen die unkomplizierte Online-Terminvergabe und kurze Wartezeiten bei Routinekontrollen sowie Sprechstunden am Samstag. Demgegenüber äußern mehrere Rezensenten deutliche Kritik an langen Rückrufzeiten im Notfall sowie festen Zusatzgebühren bei kurzfristigen Besuchen ohne Voranmeldung.",
        "en": "Clients appreciate straightforward online appointment booking and brief waiting times for routine exams and Saturday consultations. In contrast, several reviewers voice criticism regarding delayed callbacks during urgent complications and rigid surcharges applied for unscheduled walk-in visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 10,
      "title": {
        "de": "Behutsamer Umgang mit nervösen Haustieren",
        "en": "Gentle handling of nervous pets"
      },
      "text": {
        "de": "Besitzer von Hunden, Welpen und Katzen loben die liebevolle Zuwendung und den ruhigen Umgang während der Behandlungen. Selbst ängstliche Tierschutzhunde und scheue Katzen fassen dank geduldiger Berührung schnell Vertrauen, was den Stressfaktor beim Tierarztbesuch spürbar verringert.",
        "en": "Guardians of dogs, puppies, and cats praise the affectionate care and tranquil handling maintained during clinical examinations. Even anxious rescue dogs and timid felines settle down quickly thanks to patient touch, visibly lowering stress levels during examination room visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Können Termine bei filu in Schwabing online gebucht werden?",
        "en": "Can appointments at filu Schwabing be booked online?"
      },
      "a": {
        "de": "Ja, Halter heben die einfache und schnelle Terminvereinbarung über das digitale Buchungssystem hervor.",
        "en": "Yes, pet owners highlight the simple and quick appointment scheduling through the digital booking system."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Hat die Praxis auch samstags für Behandlungen geöffnet?",
        "en": "Is the clinic open for consultations on Saturdays?"
      },
      "a": {
        "de": "Ja, die Praxis bietet auch samstags reguläre Sprechstunden und Notfalltermine für Haustiere an.",
        "en": "Yes, the practice offers regular consultation hours and emergency appointments for pets on Saturdays."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es eine Gebühr für Notfalltermine ohne Termin?",
        "en": "Is there a surcharge for walk-in emergency visits without an appointment?"
      },
      "a": {
        "de": "Ja, Kunden weisen darauf hin, dass für spontane Notfallvorstellungen ohne vorherige Buchung ein Aufpreis berechnet wird.",
        "en": "Yes, clients note that a supplementary emergency fee applies for walk-in emergency visits without prior scheduling."
      },
      "basis": "reviews"
