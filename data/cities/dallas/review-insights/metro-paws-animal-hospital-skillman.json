    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Attentive and compassionate veterinary doctors"
      },
      "text": {
        "en": "Clients consistently commend the veterinarians and veterinary technicians, frequently praising Dr. Jarvis, Dr. Scott, Dr. Williams, and technician Ashleigh. Reviewers appreciate that the team treats pets with warmth and takes time to explain diagnoses thoroughly. While one reviewer reported a tragic outcome following a medical visit, the overwhelming majority describe an exceptional clinical team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Gentle and patient handling for pets"
      },
      "text": {
        "en": "Pet parents highlight the compassionate care given to anxious dogs, rescues, and cats during routine examinations and emergency visits. Reviewers note that technicians sit on the floor and use gentle techniques to earn the trust of nervous animals. Multiple clients express deep appreciation for the dignity and comfort shown to aging pets during end-of-life care."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 7,
      "title": {
        "en": "Thorough explanations and responsive support"
      },
      "text": {
        "en": "Reviewers emphasize the clear, unhurried communication from doctors and reception staff. Clients appreciate receiving itemized treatment options, follow-up calls after vaccinations, and transparent guidance on preventive wellness plans. Pet owners note that the staff listens attentively to questions and helps them feel confident in clinical decisions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What are the outpatient hours at the Skillman clinic?"
      },
      "a": {
        "en": "The hospital is open seven days a week, operating Monday through Friday from 8 am to 6 pm, Saturday 8 am to 2 pm, and Sunday 12 pm to 5 pm."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "How do staff handle nervous or fearful pets?"
      },
      "a": {
        "en": "Clients mention that technicians and doctors sit on the floor, speak softly, and use gentle handling techniques to soothe anxious pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can clients discuss treatment options and costs before procedures?"
      },
      "a": {
        "en": "Yes, reviewers note that veterinarians provide clear explanations and outline treatment options before proceeding with care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer preventive wellness membership plans?"
      },
      "a": {
        "en": "Yes, pet owners mention utilizing the hospital's preventive care wellness plan for ongoing veterinary savings."
