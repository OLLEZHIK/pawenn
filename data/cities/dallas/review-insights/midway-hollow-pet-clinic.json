  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Caring veterinary team and surgeons"
      },
      "text": {
        "en": "Most pet owners praise Dr Carroll and the clinic staff for their kindness, patience, and attentive bedside manner. Reviewers frequently note that veterinary nurses and receptionists help calm anxious pets and keep visits organised. Although one client questioned surgical supervision after an anaesthesia complication, most clients express strong trust in the team."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Reliable treatments and dental procedures"
      },
      "text": {
        "en": "Pet owners report successful outcomes for routine dental cleanings, preventative care, and unexpected illnesses. Several reviews highlight clear clinical improvements after targeted treatments and prompt wound dressing. While one reviewer experienced a fatal post-operative complication with a kitten, the majority of clients describe dependable medical care."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Gentle handling for nervous animals"
      },
      "text": {
        "en": "Clients frequently remark on how gently dogs and cats are treated during examinations and routine procedures. Several reviewers note that the team takes extra time to soothe pets with prior clinical trauma or anxiety. Pet owners appreciate that their animals return from dental cleanings and treatments relaxed and settled rather than distressed."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pets undergo dental cleanings at Midway Hollow Pet Clinic?"
      },
      "a": {
        "en": "Yes, clients frequently mention booking dogs for dental examinations and teeth cleanings."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do reviewers describe the clinic staff?"
      },
      "a": {
        "en": "Pet owners describe Dr Carroll, technicians, and receptionists as welcoming, kind, and attentive with animals."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are walk-in consultations available at the clinic?"
      },
      "a": {
        "en": "Clients generally schedule consultations in advance, though urgent cases are accommodated by appointment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are anxious pets accommodated during appointments?"
      },
      "a": {
        "en": "Reviewers note that nurses and veterinary surgeons work gently with traumatised or nervous pets to minimise stress."
      },
      "basis": "reviews"
    }
