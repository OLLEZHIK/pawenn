  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 178,
      "title": {
        "en": "Substantial progress in canine obedience"
      },
      "text": {
        "en": "Pet owners consistently report marked improvements in canine behaviour following board-and-train courses and in-home lessons. Reviewers highlight reliable leash manners, rapid mastery of essential commands such as sit and stay, and successful curb of unwanted habits including jumping and excessive barking. Clients express gratitude for programmes that make daily dog walking and home life manageable."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 151,
      "title": {
        "en": "Tailored training across dog breeds"
      },
      "text": {
        "en": "Clients emphasize that training methods adapt well to diverse temperaments, ranging from high-energy puppies to stubborn adult dogs and rescue pets. Reviewers frequently remark that their dogs enjoy the training process, returning home calm, confident, and eager to learn rather than stressed or withdrawn. Pet parents value the positive, structured approach to canine care."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 112,
      "title": {
        "en": "Patient instructors and clear coaching"
      },
      "text": {
        "en": "Dog owners praise trainer Mac and the training staff for their patience, clear guidance, and practical coaching during handover sessions. Reviewers appreciate that the trainers take the time to instruct family members thoroughly on maintaining training consistency at home. Clients describe the team as approachable, knowledgeable, and dedicated."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What training programmes are available in Dallas?"
      },
      "a": {
        "en": "The centre provides two-week board-and-train packages, private in-home lessons, and targeted behavioral modification."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do owners receive instruction on continuing training at home?"
      },
      "a": {
        "en": "Yes, clients emphasize that trainers provide comprehensive handover sessions and practical guidance for owners."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can energetic puppies enrol in obedience courses?"
      },
      "a": {
        "en": "Yes, numerous reviewers report successful foundational obedience and manners training with young puppies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where is the Dallas training centre located?"
      },
      "a": {
        "en": "The facility is located on North Ervay Street in Downtown Dallas, offering both on-site and in-home services."
      },
      "basis": "website"
    }
  ],
