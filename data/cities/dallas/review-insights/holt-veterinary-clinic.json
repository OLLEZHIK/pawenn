  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Compassionate and communicative veterinary doctors"
      },
      "text": {
        "en": "Pet owners overwhelmingly praise Dr. Bratton, Dr. Kiefer, Dr. Watkins, Dr. Harden, Dr. Thomas, and the support staff on SMU Boulevard for their kindness and clear communication. Reviewers appreciate that the veterinarians listen attentively, answer every question thoroughly, and focus on necessary care without pushing excessive treatments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Gentle care for puppies, rescues, and seniors"
      },
      "text": {
        "en": "Clients frequently highlight how gently the clinical team handles pets of all ages and temperaments, from tiny puppies and reactive rescue dogs to senior cats. Owners also express deep gratitude for the comforting, unhurried environment provided when saying goodbye to ageing pets."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Convenient weekday walk-ins with short waits"
      },
      "text": {
        "en": "Reviewers value the clinic walk-in system on weekdays, noting that they can bring sick pets in without a prior appointment and still be seen quickly. Many clients remark on the smooth check-in at reception and how efficiently visits move from the waiting room to the examination."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do I need an appointment at Holt Veterinary Clinic?"
      },
      "a": {
        "en": "No appointment is required Monday through Friday, as the clinic operates on a walk-in basis on weekdays and schedules appointments on Saturdays."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How long is the typical wait for a walk-in visit?"
      },
      "a": {
        "en": "Reviewers consistently report short wait times and fast check-in even when arriving without an appointment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients describe the pricing and treatment recommendations?"
      },
      "a": {
        "en": "Pet owners describe the fees as fair and appreciate that the veterinarians take a conservative approach without recommending unnecessary tests."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can Holt Veterinary Clinic assist with international pet travel permits?"
      },
      "a": {
        "en": "Yes, client feedback mentions assistance with USDA international pet import permits for travelling animals."
      },
      "basis": "reviews"
    }
  ],
