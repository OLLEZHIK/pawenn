  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Welcoming and attentive grooming team"
      },
      "text": {
        "en": "Dog owners consistently praise Gary, Irene, and the grooming team in Oak Cliff for their friendly, welcoming demeanour and thorough consultations. Reviewers appreciate that the staff listens closely to styling requests, explains coat care options clearly, and takes time to answer questions before starting a bath or haircut."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Neat haircuts and thorough nail care"
      },
      "text": {
        "en": "Clients report great grooming outcomes across breeds ranging from Pomeranians and Yorkies to Golden Retrievers and Goldendoodles. Many owners highlight clean, even haircuts, shiny coats, and careful nail trimming and dremelling, including for matted fur or overgrown dewclaws that were difficult to clip elsewhere."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Gentle care for anxious and senior dogs"
      },
      "text": {
        "en": "Reviewers frequently emphasise how calm and comfortable their pets remain during visits. Owners of nervous rescues, first-time puppies, reactive dogs, and senior pets with health conditions note that the groomers handle animals with patience and gentleness, even offering house-call grooming for dogs that need extra comfort."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners watch the grooming process at Fluffy Pet Grooming?"
      },
      "a": {
        "en": "Yes, reviewers mention that the salon has a glass partition that allows owners to see their dogs being groomed."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Fluffy Pet Grooming accept same-day or short-notice bookings?"
      },
      "a": {
        "en": "Several clients report booking same-day appointments or finding flexible availability for baths, haircuts, and nail trims."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are vaccinations required before a grooming appointment?"
      },
      "a": {
        "en": "Yes, reviewers note that the salon checks that pet vaccinations are up to date and offers guidance on local vaccine clinics."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients describe the grooming prices?"
      },
      "a": {
        "en": "Pet owners consistently describe the rates for full grooms and nail trims as fair and budget-friendly."
      },
      "basis": "reviews"
    }
