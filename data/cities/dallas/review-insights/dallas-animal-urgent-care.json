    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "en": "Caring clinicians during acute pet crises"
      },
      "text": {
        "en": "Pet owners commend clinicians such as Dr Lam, Dr Green, and Dr Danawala for their compassion, attentiveness, and support during traumatic emergencies. Families especially appreciate the comforting care offered during difficult euthanasia decisions, though a couple of clients reported blunt bedside manners and pressured recommendations."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Manageable fees and transparent estimates"
      },
      "text": {
        "en": "Most pet owners find urgent care fees significantly more affordable and transparent than traditional 24-hour emergency animal hospitals in Dallas. Several clients commend the absence of hidden charges for last-minute euthanasia and surgical care, though a few reviewers experienced disputes regarding treatment options and diagnostic quotes."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 13,
      "title": {
        "en": "Compassionate bedside manner and discharge records"
      },
      "text": {
        "en": "Numerous pet parents praise the clinical staff for explaining diagnosis options with empathy and providing thoughtful follow-up calls the next day. Conversely, critical reviews cite rushed medical explanations, inadequate communication regarding illness severity, and missing medication dosage records upon hospital discharge."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the virtual check-in waiting list work?"
      },
      "a": {
        "en": "Pet owners can register on the clinic's online waitlist before departing home, significantly reducing time spent in the lobby."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is Dallas Animal Urgent Care cheaper than a 24-hour ER?"
      },
      "a": {
        "en": "Reviewers consistently state that consultation and treatment fees are more affordable than traditional round-the-clock emergency hospitals."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the urgent care clinic handle dog attack trauma?"
      },
      "a": {
        "en": "Yes, veterinary surgeons promptly treat traumatic bite wounds, lacerations, and acute surgical emergencies."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What should pet owners request upon patient discharge?"
      },
      "a": {
        "en": "Clients advise requesting complete discharge notes detailing all administered medications and dosages if transfer to another hospital is required."
      },
      "basis": "reviews"
    }
