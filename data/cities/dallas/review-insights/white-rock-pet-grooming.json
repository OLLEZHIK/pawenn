  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Patient care for sensitive pets"
      },
      "text": {
        "en": "Numerous pet owners highlight the extraordinary gentleness shown towards blind dogs, 140-pound German Shepherds, and rescue pets prone to anxiety. Clients note that dogs who normally fear grooming salons happily enter this facility, often rolling over for belly rubs without displaying any fear."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Proper coat styling and scissor care"
      },
      "text": {
        "en": "Reviewers consistently praise the quality of the haircuts, noting soft coats, clean ears, and neat nail clipping. Owners of double-coated breeds appreciate that groomers use scissors rather than damaging shears, ensuring dogs leave looking handsome, smelling fresh, and feeling comfortable."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Caring and attentive salon staff"
      },
      "text": {
        "en": "Clients describe the staff at White Rock Pet Grooming, including business manager Dorothy and the styling team, as exceptionally loving and attentive. Pet owners emphasize that the team listens closely to special instructions and treats pets with warmth, establishing years of genuine loyalty."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does White Rock Pet Grooming handle anxious or senior dogs?"
      },
      "a": {
        "en": "Reviewers emphasize that the staff are exceptionally gentle and patient with blind, elderly, or nervous rescue dogs, keeping them calm and relaxed."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the salon accommodate large dog breeds?"
      },
      "a": {
        "en": "Yes, clients report taking large breeds, including German Shepherds weighing up to 140 pounds, with groomers providing thorough care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the team handle coat maintenance for double-coated breeds?"
      },
      "a": {
        "en": "Clients note that groomers use scissors rather than aggressive clippers on undercoats, preserving the natural coat texture and reducing excess shedding."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the salon communicate with clients regarding appointments?"
      },
      "a": {
        "en": "Pet owners appreciate prompt text messaging for booking confirmations, appointment reminders, and pickup notifications."
      },
      "basis": "reviews"
    }
  ],
