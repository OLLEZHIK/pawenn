    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Compassionate emergency and specialty clinicians"
      },
      "text": {
        "en": "Most pet owners praise the emergency doctors, veterinary nurses, and reception team on Inwood Road for their compassion, attentiveness, and swift action during critical moments. Clients frequently mention being kept informed and supported during stressful hospital visits. Although several reviewers report frustrating encounters regarding delayed updates or perceived indifference, the team is widely commended."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Critical care and lifesaving interventions"
      },
      "text": {
        "en": "Reviewers emphasize successful clinical outcomes in life-threatening situations, including emergency surgical procedures, trauma management, and intensive stabilization. Pet parents credit the hospital's diagnostic capabilities, including rapid ultrasound and blood analysis, with saving their animals' lives during late-night emergencies when ordinary practices were closed."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Gentle treatment during critical distress"
      },
      "text": {
        "en": "Clients appreciate the gentle and sensitive approach demonstrated by clinical staff towards severely ill or injured dogs and cats. Pet parents remark that technicians treat hospitalized patients with genuine tenderness, keeping them comfortable and secure in the ICU while medical interventions and monitoring are underway."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is emergency veterinary care available 24/7?"
      },
      "a": {
        "en": "Yes, the hospital operates a 24-hour emergency team every day of the week on Inwood Road."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What advanced diagnostics are available on-site?"
      },
      "a": {
        "en": "The facility utilizes ultrasound imaging, endoscopy, digital radiography, and in-house laboratory testing."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "How are urgent cases triaged upon arrival?"
      },
      "a": {
        "en": "Patients are evaluated upon entry, though non-critical visits may experience waits during peak emergency hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are specialist consultations available by appointment?"
      },
      "a": {
        "en": "Yes, specialists in veterinary cardiology, internal medicine, and surgery see patients by consultation."
      },
      "basis": "website"
    }
