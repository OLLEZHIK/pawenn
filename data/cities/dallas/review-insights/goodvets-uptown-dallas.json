  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 27,
      "title": {
        "en": "Praised regular vets alongside relief vet complaints"
      },
      "text": {
        "en": "Many Uptown pet owners praise Dr. Motley, Dr. Herman, Dr. Lorien, and the reception team for attentive consultations and clear explanations. However, several reviewers report frustrating visits with relief veterinarians or technicians, citing rushed exams, unempathetic communication during urgent drop-offs, or refusal to issue travel certificates."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "en": "Gentle care for dogs and cats"
      },
      "text": {
        "en": "Most clients note that the doctors and veterinary assistants handle their dogs and cats with patience during wellness exams, vaccinations, and ear infection treatments. While a couple of owners felt a relief vet or technician was uneasy around large or reactive dogs, most reviewers say their pets are kept calm and comfortable."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 9,
      "title": {
        "en": "High fees and wellness plan frustrations"
      },
      "text": {
        "en": "Many reviewers criticise the pricing at this Howell Street clinic, describing consultations, injections, and diagnostic tests as expensive compared to other local vets, or noting difficulties qualifying for monthly wellness payment plans. However, a few pet owners appreciate that the staff shares cost estimates upfront before treatment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can appointments be booked online at GoodVets Uptown?"
      },
      "a": {
        "en": "Yes, the clinic offers online booking, and reviewers note that scheduling appointments online is quick and straightforward."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the clinic accommodate urgent or late arrivals?"
      },
      "a": {
        "en": "Several clients mention being fitted in at opening for sudden illnesses or accommodated when delayed by traffic, though one owner with an injured dog was referred elsewhere."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What veterinary services and diagnostics are available?"
      },
      "a": {
        "en": "The clinic provides wellness exams, vaccinations, parasite prevention, dental care, surgery, X-rays, and in-house laboratory testing."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients view the pricing and wellness plans?"
      },
      "a": {
        "en": "Reviewers state that staff share pricing upfront, though many find the fees on the higher side and note that monthly payment plans require approval."
      },
      "basis": "reviews"
    }
