  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Dedicated and compassionate clinical team"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinary team, including Dr Deason and Dr Mountain, alongside front desk coordinators Charlene and Leigh, for their kind approach during distressing medical situations. Clients highlight that staff take time to explain surgical options thoroughly and comfort distraught owners, though one client reported difficulty reaching them during busy peak periods."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Accessible fees and charity support"
      },
      "text": {
        "en": "Reviewers emphasize that this non-profit clinic offers substantially lower rates than traditional private practices across Dallas. Multiple clients express deep relief over financial help received through the clinic's Compassion Fund, which enabled urgent surgical procedures and fracture repairs for families who could not otherwise afford private veterinary bills."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Successful operations and life-saving treatments"
      },
      "text": {
        "en": "Numerous clients report successful clinical outcomes for complicated interventions, such as perineal hernia repairs, TPLO procedures, and emergency surgeries. Several reviewers recount instances where other practices recommended euthanasia due to severity or expense, yet the surgical team here intervened effectively to restore their companions to active health."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does CHEW Animal Clinic provide emergency surgery?"
      },
      "a": {
        "en": "Yes, the clinic performs urgent soft-tissue and orthopaedic surgeries, including hernia corrections and fracture management."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What financial assistance is available for pet owners?"
      },
      "a": {
        "en": "The clinic manages a Compassion Fund to assist eligible low-income clients facing costly medical procedures."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are walk-in consultations accepted at the clinic?"
      },
      "a": {
        "en": "The clinic operates primarily by appointment, and client intake may occasionally pause when surgical capacity is full."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do the veterinary surgeons carry out routine neutering?"
      },
      "a": {
        "en": "Yes, clients frequently report bringing dogs and cats for routine desexing and vaccination appointments."
      },
      "basis": "reviews"
    }
  ],
