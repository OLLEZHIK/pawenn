  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 89,
      "title": {
        "en": "Gentle handling for community animals"
      },
      "text": {
        "en": "Pet parents and animal rescue volunteers appreciate the clinic dedicated support for community cats, feral colonies, rescue dogs, and companion puppies. Reviewers consistently remark on the gentle and compassionate handling provided during drop-off and post-operative recovery, noting that pets are kept secure throughout high-volume clinic days."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 88,
      "title": {
        "en": "Hardworking and compassionate clinical team"
      },
      "text": {
        "en": "Clients frequently commend the surgeons, veterinary technicians, and check-in assistants for their patience, warmth, and informative post-operative discharge instructions. While a few clients reported rushed interactions or difficulties regarding breed size restrictions, the overwhelming majority describe a team committed to accessible pet care."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 65,
      "title": {
        "en": "Reliable surgeries and routine vaccinations"
      },
      "text": {
        "en": "Pet owners report smooth recoveries following routine spay, neuter, microchipping, and vaccination services, with incisions healing cleanly and without complication. Although a very small number of clients experienced serious surgical complications or anesthetic issues, most reviewers praise the surgical standards and clinical care provided."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Spay Neuter Network assist with feral or community cats?"
      },
      "a": {
        "en": "Yes, the clinic regularly assists rescue caretakers and local residents with trap-neuter-return services and community cat sterilisation."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are pet microchips and core vaccines available?"
      },
      "a": {
        "en": "Yes, clients frequently add core vaccinations, rabies shots, and microchip registration alongside scheduled surgery appointments."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are there weight or size limitations for surgery?"
      },
      "a": {
        "en": "Reviewers note that appointments for extra-large dogs over a certain weight may be limited or require specific scheduling tiers."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do owners prepare pets for morning drop-off?"
      },
      "a": {
        "en": "Clients report arriving early in the morning for check-in lines and receiving clear pick-up times for the afternoon."
      },
      "basis": "reviews"
    }
  ],
