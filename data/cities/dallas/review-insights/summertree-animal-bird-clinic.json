  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Expert handling for exotic animals"
      },
      "text": {
        "en": "Pet parents appreciate the clinic specialized expertise with avian and exotic companions, including parrots, macaws, rabbits, guinea pigs, and reptiles alongside dogs and cats. Many clients highlight that technicians and veterinarians handle delicate or anxious animals with patience, though a few reviewers experienced distressing small animal losses."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Knowledgeable and compassionate clinical team"
      },
      "text": {
        "en": "Reviewers frequently praise veterinarians such as Dr Finn and Dr Nasser, alongside veterinary technicians Bree and Cat, for their thorough explanations and kind bedside manner. While a handful of clients felt individual consultations were rushed or received defensive communication following complications, the vast majority describe a supportive practice."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 12,
      "title": {
        "en": "Effective treatments alongside surgical concerns"
      },
      "text": {
        "en": "Many owners report successful wellness examinations, routine vaccinations, and timely recoveries from avian illnesses or rabbit neutering procedures. However, other clients experienced significant clinical complications during small animal surgeries, prompting reviewers to recommend thorough pre-operative discussions for delicate exotic pets."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Summertree Animal & Bird Clinic treat exotic pets?"
      },
      "a": {
        "en": "Yes, the clinic provides specialized veterinary medical care for birds, rabbits, guinea pigs, reptiles, and other exotic animals."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are same-day veterinary appointments available?"
      },
      "a": {
        "en": "Yes, clients note that the clinic can often accommodate same-day urgent visits or consultations for sick pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can rabbits and birds undergo surgical procedures here?"
      },
      "a": {
        "en": "Reviewers mention scheduling rabbit neutering and avian treatments, though owners advise discussing surgical risks for delicate species."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do staff handle nervous companion animals?"
      },
      "a": {
        "en": "Clients report that technicians and veterinarians use calm handling techniques, treats, and patient approaches to ease stress during exams."
      },
      "basis": "reviews"
    }
  ],
