  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 154,
      "title": {
        "en": "Skilled and dedicated emergency specialists"
      },
      "text": {
        "en": "Most clients praise the round-the-clock emergency doctors, veterinary surgeons, and veterinary nurses for their deep medical expertise and empathy. Reviewers frequently thank clinical teams for guiding them through critical health crises. While several reviewers felt front-desk communication or bedside manner was lacking during chaotic nights, the vast majority describe an extraordinary clinical staff."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 127,
      "title": {
        "en": "Loving care for critically ill pets"
      },
      "text": {
        "en": "Pet parents frequently highlight the gentle, dedicated care given to critically ill dogs and cats in the ICU and emergency wards. Reviewers share deep gratitude for veterinary technicians who stayed by their pets' side, comforted animals during painful episodes, and provided dignity during difficult medical moments. Clients appreciate the attentive and tender handling of their companions."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 115,
      "title": {
        "en": "Life-saving emergency surgeries and critical treatments"
      },
      "text": {
        "en": "Numerous reviewers credit MedVet surgeons and emergency clinicians with saving their pets' lives through complex surgeries, transfusions, and intensive oncology and neurology care. Pet parents report positive recoveries from severe trauma, foreign object ingestion, and sudden organ failures. Although some clients faced tragic outcomes despite treatment, most express deep gratitude for the hospital's capabilities."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is MedVet Dallas open 24 hours for pet emergencies?"
      },
      "a": {
        "en": "Yes, MedVet Dallas operates a 24-hour pet emergency and critical care center open 365 days a year."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do emergency pet visits require an advance appointment?"
      },
      "a": {
        "en": "No appointment is necessary for emergency admissions, and patients are prioritized by clinical urgency upon arrival."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What veterinary specialties are available at MedVet Dallas?"
      },
      "a": {
        "en": "Specialties include emergency medicine, cardiology, internal medicine, medical oncology, neurology, and surgery."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "How do clients describe the cost of emergency care?"
      },
      "a": {
        "en": "Reviewers note that emergency hospitalization and diagnostic imaging are costly, but many emphasize the life-saving results."
      },
      "basis": "reviews"
    }
  ],
