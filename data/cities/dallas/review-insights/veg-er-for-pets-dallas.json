  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 110,
      "title": {
        "en": "Empathetic emergency veterinary clinicians"
      },
      "text": {
        "en": "Clients express deep gratitude for the emergency veterinary team, praising veterinarians and veterinary nurses for their bedside empathy, clear diagnostic explanations, and constant updates. While two reviewers felt staff communication fell short during stressful visits, the overwhelming consensus highlights an extraordinary, dedicated team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 85,
      "title": {
        "en": "Open-floor care and pet comfort"
      },
      "text": {
        "en": "Pet parents deeply value the hospital's open-concept design, which allows owners to remain right by their pets' side throughout examinations, stabilization, and procedures. Although one reviewer felt their pet was neglected in an emergency, reviewers overwhelmingly describe gentle, attentive clinicians who treat animals with tenderness."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "en": "Clear bedside updates and diagnostic clarity"
      },
      "text": {
        "en": "Pet owners consistently praise the clinical team for transparent, empathetic communication during emergency visits. Clinicians walk families through vital signs, treatment choices, and diagnostic findings step by step. While two reviewers felt communication faltered during critical cases, most clients highlight compassionate clarity."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners stay with their animals during emergency treatment?"
      },
      "a": {
        "en": "Yes, the hospital's open-floor policy allows owners to remain alongside their pets during examinations, diagnostic tests, and treatments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is VEG ER for Pets open 24/7 in Dallas?"
      },
      "a": {
        "en": "Yes, the facility operates 24 hours a day, 7 days a week, providing continuous emergency and urgent veterinary care."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the emergency triage process work upon arrival?"
      },
      "a": {
        "en": "Reviewers note that triage begins immediately upon entering the hospital, with doctors and veterinary nurses assessing pets right away."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are cost estimates provided before emergency procedures begin?"
      },
      "a": {
        "en": "Yes, clients mention that the clinical team discusses treatment options and provides transparent fee estimates before starting procedures."
      },
      "basis": "reviews"
    }
  ],
