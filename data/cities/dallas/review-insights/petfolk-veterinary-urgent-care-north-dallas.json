  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "en": "Supportive and attentive veterinary professionals"
      },
      "text": {
        "en": "The majority of pet owners praise the veterinary doctors and nurses for their compassionate care, clear medical explanations, and calming influence on anxious animals. Clients repeatedly commend individual clinicians for thorough consultations. While occasional service disputes arise, overall sentiment regarding clinical attentiveness is strongly positive."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "en": "Calm and compassionate patient care"
      },
      "text": {
        "en": "Pet owners consistently note how attentive clinicians are with frightened, injured, or reactive pets. The clinic features dedicated feline spaces to reduce exam room stress, while veterinarians and nurses use patient handling methods that comfort dogs and soothe nervous companions throughout treatments."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 13,
      "title": {
        "en": "Efficient urgent intake and scheduling"
      },
      "text": {
        "en": "Reviewers value the ability to book same-day appointments and access urgent veterinary attention on weekends when other clinics are closed. Pet parents note swift intake during emergencies and minimal lobby delays, although a couple of visitors experienced appointment postponements or end-of-day turnaways."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet parents schedule urgent veterinary care on weekends?"
      },
      "a": {
        "en": "Yes, the North Dallas facility operates on Saturdays and Sundays from 09:00 until 17:00 for routine and urgent visits."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Are same-day urgent care appointments available?"
      },
      "a": {
        "en": "Yes, pet owners can schedule same-day urgent examinations directly through the digital reservation platform."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can medications be fulfilled at external pharmacies?"
      },
      "a": {
        "en": "Yes, clients can request written prescriptions from the veterinarian to fill at retail pet pharmacies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is visitor parking available directly outside the clinic?"
      },
      "a": {
        "en": "Yes, convenient surface parking spaces are located immediately in front of the building."
      },
      "basis": "website"
    }
  ],
