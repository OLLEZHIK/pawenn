  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 112,
      "title": {
        "es": "Amabilidad y profesionalidad del equipo",
        "en": "Polite and professional store staff"
      },
      "text": {
        "es": "Los clientes alaban de forma constante la cortesía y cercanía del equipo de ventas y caja en la avenida de los Toreros. Resaltan de manera especial a las peluqueras Andrea y Ana por su paciencia, dulzura y capacidad de hacer sentir cómodos tanto a los perros como a sus familias.",
        "en": "Shoppers repeatedly praise the courtesy and friendliness of the retail and checkout team on Avenida de los Toreros in Salamanca. Reviewers especially highlight groomers Andrea and Ana for their gentle patience and ability to reassure dogs and owners alike."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "es": "Trato afectuoso hacia las mascotas",
        "en": "Affectionate handling of visiting pets"
      },
      "text": {
        "es": "Las opiniones coinciden en el cariño con el que se atiende a cada animal en la peluquería y en la sala de ventas. Los usuarios comentan que sus perros entran contentos y sin temor, recibiendo caricias y atenciones que convierten la visita o el baño en una experiencia positiva.",
        "en": "Reviews consistently emphasize the affection shown to pets both in the retail aisles and inside the grooming area. Owners note that their dogs walk in happily without stress, receiving gentle handling and warmth that turns bath appointments into pleasant visits."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "es": "Tienda agradable y bien surtida",
        "en": "Pleasant and well-stocked pet shop"
      },
      "text": {
        "es": "Los visitantes señalan que el local en el distrito de Salamanca es cómodo, ordenado y cuenta con una variada oferta de piensos, antiparasitarios y complementos. Destacan la facilidad para encontrar marcas habituales y la limpieza mantenida en todas las secciones.",
        "en": "Visitors point out that the Salamanca store is clean, comfortable, and well organized, offering a diverse inventory of pet food, antiparasitics, and accessories. Clients appreciate the easy access to popular brands and the tidy layout across all departments."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Qué opinan los clientes sobre la peluquería de Toreros?",
        "en": "What do clients say about the Toreros grooming service?"
      },
      "a": {
        "es": "Recibe valoraciones excelentes por el trato dulce y la destreza de las estilistas caninas Andrea y Ana.",
        "en": "It receives excellent reviews for the gentle handling and professional skill of groomers Andrea and Ana."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "es": "¿Qué variedad de productos para mascotas se puede adquirir?",
        "en": "What variety of pet supplies can be purchased?"
      },
      "a": {
        "es": "Disponen de piensos especializados, snacks naturales, arneses, correas, camas y productos de botiquín veterinario.",
        "en": "They offer specialized diets, natural treats, harnesses, leashes, beds, and over-the-counter pet healthcare items."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Se necesita cita previa para la peluquería canina?",
        "en": "Is an appointment needed for dog grooming?"
      },
      "a": {
        "es": "Sí, se recomienda reservar turno con antelación para asegurar disponibilidad en el servicio de baño y peluquería.",
        "en": "Yes, reserving a time slot in advance is recommended to ensure availability for bathing and grooming."
      },
      "basis": "both"
    }
  ],
