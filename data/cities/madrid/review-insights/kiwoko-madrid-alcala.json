  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 69,
      "title": {
        "es": "Asesoramiento atento y trato cordial",
        "en": "Attentive customer guidance and service"
      },
      "text": {
        "es": "La gran mayoría de los clientes destaca la amabilidad y buena disposición del personal de la tienda en la calle Alcalá, mencionando a empleadas como Mayra por su cercanía y rapidez. Valoran las recomendaciones acertadas y la paciencia para resolver dudas sobre productos.",
        "en": "The vast majority of customers highlight the friendly and helpful attitude of the staff at the Calle Alcalá store, frequently praising employees like Mayra for their attentive assistance. Shoppers appreciate prompt service and practical advice on pet supplies."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "es": "Cuidado integral para diversas mascotas",
        "en": "Comprehensive care for various pets"
      },
      "text": {
        "es": "Las opiniones valoran positivamente los consejos nutricionales para perros y gatos, así como el surtido específico para aves, peces y pequeños roedores. Los visitantes aprecian que el equipo entienda las necesidades de cada animal y oriente con criterio en cada compra.",
        "en": "Customer reviews value the nutritional recommendations offered for dogs and cats, as well as specific supplies for birds, fish, and small pets. Shoppers appreciate that the team understands animal welfare and helps select appropriate feed and enrichment items."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 6,
      "title": {
        "es": "Surtido completo y tienda organizada",
        "en": "Wide selection in organized aisles"
      },
      "text": {
        "es": "Los usuarios aprecian la amplitud y el orden del establecimiento en el barrio de Salamanca. Comentan que disponen de gran variedad de marcas de pienso, snacks, camas y juguetes, lo que facilita encontrar todo lo necesario para sus animales sin desplazarse lejos.",
        "en": "Visitors appreciate the clean layout and wide variety of merchandise at this Salamanca district shop. Reviewers note that finding specific food brands, treats, bedding, and accessories is easy and convenient thanks to well-organized aisles and steady inventory."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Qué tipo de productos se encuentran en Kiwoko Alcalá?",
        "en": "What types of products are available at Kiwoko Alcalá?"
      },
      "a": {
        "es": "Disponen de alimentación seca y húmeda, antiparasitarios, accesorios, juguetes e higiene para perros, gatos, roedores y aves.",
        "en": "They stock dry and wet food, antiparasitics, accessories, toys, and grooming supplies for dogs, cats, small pets, and birds."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿El personal ofrece asesoramiento sobre alimentación?",
        "en": "Does the staff provide nutritional guidance?"
      },
      "a": {
        "es": "Sí, los clientes señalan que los empleados orientan con agrado según la raza, edad y preferencias dietéticas de la mascota.",
        "en": "Yes, customers note that staff members gladly help choose diets based on pet breed, life stage, and nutritional needs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "es": "¿Es posible recoger pedidos online en la tienda?",
        "en": "Can online orders be picked up in-store?"
      },
      "a": {
        "es": "Sí, la tienda permite gestionar compras web y encargar productos específicos si no están disponibles en los lineales.",
        "en": "Yes, customers can arrange in-store pickup for web orders and request assistance if an item needs to be ordered."
      },
      "basis": "both"
    }
  ],
