  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 96,
      "title": {
        "es": "Asesoramiento cercano y atención del personal",
        "en": "Attentive guidance and friendly store staff"
      },
      "text": {
        "es": "Una inmensa mayoría de clientes aplaude la amabilidad, paciencia y profesionalidad del equipo de la tienda en Plenilunio. Los visitantes agradecen las recomendaciones personalizadas para la alimentación de perros y gatos, así como la ayuda para encontrar productos adecuados.",
        "en": "An overwhelming majority of shoppers applauds the kindness, patience, and professional help provided by the Plenilunio staff. Visitors value personalized recommendations for dog and cat nutrition, as well as assistance in locating the right accessories across the store."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "es": "Tienda espaciosa y variedad de productos",
        "en": "Spacious boutique and comprehensive product variety"
      },
      "text": {
        "es": "Las reseñas destacan la amplitud y el orden de los pasillos, permitiendo pasear cómodamente con las mascotas mientras se realizan las compras. Valoran la enorme variedad de piensos, accesorios y juguetes, además de la facilidad de aparcamiento en el centro comercial.",
        "en": "Reviewers emphasize the broad, tidy aisles that allow pet owners to browse comfortably with their animals during shopping trips. Clients appreciate the extensive selection of pet food brands, toys, and gear, alongside convenient parking access in the shopping center."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 4,
      "title": {
        "es": "Promociones atractivas y buena relación calidad-precio",
        "en": "Appealing promotions and good overall value"
      },
      "text": {
        "es": "Los compradores señalan positivamente los descuentos regulares, las ofertas del club de fidelización y los precios competitivos en marcas reconocidas de alimentación. Resaltan que las promociones periódicas permiten ahorrar sustancialmente en la compra mensual.",
        "en": "Shoppers highlight the frequent sales discounts, loyalty club rewards, and competitive pricing across well-known pet nutrition brands. Many customers note that seasonal deals make stocking up on staple foods, litter, and treats significantly more economical."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Se puede acudir con la mascota a la tienda de Plenilunio?",
        "en": "Are pets allowed inside the Plenilunio store?"
      },
      "a": {
        "es": "Sí, los animales de compañía son bienvenidos en el establecimiento y en las zonas autorizadas del centro comercial.",
        "en": "Yes, pets are welcome inside the store and designated public areas of the shopping center."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Tienen aparcamiento disponible?",
        "en": "Is customer parking available on site?"
      },
      "a": {
        "es": "Sí, se puede utilizar el amplio aparcamiento gratuito del centro comercial Plenilunio.",
        "en": "Yes, visitors can utilize the free underground and outdoor parking at the Plenilunio shopping complex."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Tienen sección de animales vivos o peces?",
        "en": "Do they keep live animals or fish?"
      },
      "a": {
        "es": "Disponen principalmente de peces de agua dulce en su área de acuariofilia.",
        "en": "They maintain freshwater aquarium fish within their specialized aquatics department."
      },
      "basis": "reviews"
    }
