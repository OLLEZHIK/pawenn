  "reviews_in_period": 105,
  "observed_at": "2026-10-16",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 70,
      "title": {
        "es": "Atención médica dedicada y recepción dispar",
        "en": "Dedicated medical team and reception complaints"
      },
      "text": {
        "es": "Una amplia mayoría de clientes valora la dedicación, profesionalidad y cariño de los veterinarios que atienden casos graves y cirugías de urgencia. No obstante, numerosas reseñas critican el trato seco o poco empático en el mostrador de recepción y durante las admisiones.",
        "en": "A clear majority of pet guardians commends the dedication, skill, and genuine kindness of veterinarians managing grave illnesses and urgent surgeries. Nevertheless, numerous reviews report dry, indifferent, or blunt customer service at the front reception desk during triage."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 37,
      "title": {
        "es": "Vidas salvadas y desacuerdos en tratamientos",
        "en": "Saved lives and disputed treatment outcomes"
      },
      "text": {
        "es": "Muchos tutores agradecen de corazón intervenciones quirúrgicas que salvaron la vida de sus mascotas en situaciones críticas. Por otra parte, otros usuarios manifiestan descontento por diagnósticos que consideran poco certeros o complicaciones durante hospitalizaciones.",
        "en": "Many clients express heartfelt gratitude for successful emergency surgeries that saved their pets' lives in critical condition. On the other hand, several reviews articulate strong dissatisfaction regarding disputed medical diagnoses or complications during hospitalization."
      }
    },
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 25,
      "title": {
        "es": "Atención telefónica deficiente e información médica",
        "en": "Phone line delays and unclear updates"
      },
      "text": {
        "es": "Las opiniones reflejan quejas recurrentes sobre la dificultad para comunicarse por teléfono, con llamadas no atendidas o tonos bruscos al pedir información. También se señalan demoras para recibir partes clínicos actualizados sobre mascotas ingresadas en planta.",
        "en": "Client reviews reflect frequent frustration regarding difficult phone communication, citing unanswered calls and curt responses when requesting information. Pet owners also point out delays in receiving timely clinical updates regarding pets admitted for inpatient care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Está el hospital abierto las 24 horas para urgencias?",
        "en": "Is the hospital open 24 hours for emergencies?"
      },
      "a": {
        "es": "Sí, prestan servicio continuado de urgencias veterinarias durante las 24 horas del día en el distrito de Retiro.",
        "en": "Yes, they provide 24-hour continuous emergency veterinary medical services in the Retiro district."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Se puede visitar a los animales ingresados?",
        "en": "Are pet visits permitted for hospitalized animals?"
      },
      "a": {
        "es": "Sí, el centro cuenta con horarios establecidos para que los tutores puedan visitar a sus mascotas hospitalizadas.",
        "en": "Yes, the facility maintains scheduled visiting hours for owners to see their hospitalized pets."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Ofrecen servicio de hospitalización y cuidados intensivos?",
        "en": "Do they provide hospitalization and intensive care units?"
      },
      "a": {
        "es": "Sí, disponen de área de hospitalización y monitorización veterinaria continua para pacientes críticos.",
        "en": "Yes, they offer dedicated inpatient wards with continuous veterinary monitoring for critical care cases."
      },
      "basis": "both"
    }
  ],
