  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 56,
      "title": {
        "es": "Especialistas valorados y discrepancias en urgencias",
        "en": "Respected specialists and emergency reception disparities"
      },
      "text": {
        "es": "Numerosas opiniones elogian la alta cualificación y cercanía de veterinarios y auxiliares durante ingresos prolongados e intervenciones complejas. Por el contrario, un grupo significativo de usuarios critica falta de empatía o frialdad en la atención inicial de urgencias.",
        "en": "Numerous client reviews praise the high medical proficiency and compassionate bedside manner of veterinarians during extended hospital stays and complex surgeries. Conversely, a noticeable group of visitors criticizes coldness or poor empathy during urgent triage intake."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 33,
      "title": {
        "es": "Intervenciones complejas y desenlaces clínicos",
        "en": "Complex clinical care and diagnostic outcomes"
      },
      "text": {
        "es": "Muchos tutores agradecen diagnósticos precisos que lograron salvar la vida de animales en estado crítico gracias a su tecnología médica. Sin embargo, otras reseñas relatan decepción ante diagnósticos contradictorios, complicaciones o falta de alternativas terapéuticas.",
        "en": "Many pet owners express deep gratitude for accurate diagnoses that saved their pets' lives in critical situations through advanced veterinary technology. In contrast, other reviews recount disappointment regarding disputed diagnoses, complications, or limited therapy options."
      }
    },
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 15,
      "title": {
        "es": "Avisos telefónicos y coordinación informativa",
        "en": "Telephone communication and coordination issues"
      },
      "text": {
        "es": "Las críticas señalan falta de fluidez en las comunicaciones sobre el estado de mascotas ingresadas y demoras al confirmar informes por teléfono. Varios usuarios señalan dificultades para obtener partes médicos puntuales o explicaciones claras sobre protocolos de admisión.",
        "en": "Reviewers voice dissatisfaction regarding the flow of information about hospitalized pets and delays when confirming diagnostic reports by phone. Several clients describe difficulties obtaining prompt medical updates or clear explanations regarding intake and admission rules."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Dispone el hospital de servicio de urgencias 24 horas?",
        "en": "Does the hospital operate a 24-hour emergency service?"
      },
      "a": {
        "es": "Sí, el centro ofrece atención continuada de urgencias veterinarias durante las 24 horas del día.",
        "en": "Yes, the hospital maintains continuous 24-hour emergency veterinary care every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Cuentan con equipos de diagnóstico avanzado como TAC o resonancia?",
        "en": "Do they have advanced diagnostic imaging such as CT or MRI?"
      },
      "a": {
        "es": "Sí, disponen de tecnología diagnóstica avanzada para estudios neurológicos y traumatológicos.",
        "en": "Yes, they are equipped with advanced diagnostic imaging tools for specialized neurological and orthopedic evaluations."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Es necesario que un veterinario externo remita al paciente?",
        "en": "Is a referral from a primary veterinarian required?"
      },
      "a": {
        "es": "Atienden tanto urgencias directas como pacientes derivados por clínicas veterinarias externas para pruebas especializadas.",
        "en": "They handle direct emergency walk-ins as well as patient referrals from external veterinary practices for specialty tests."
      },
      "basis": "both"
    }
  ],
