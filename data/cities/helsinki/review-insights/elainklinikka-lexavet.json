  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 98,
      "title": {
        "fi": "Erittäin ystävällinen ja asiantunteva henkilökunta",
        "en": "Warm, professional, and attentive veterinary staff"
      },
      "text": {
        "fi": "Lexavet Pukinmäessä saa poikkeuksellisen paljon kiitosta lämpimästä, huomaavaisesta ja ammattitaitoisesta palvelustaan. Eläinlääkärit ja hoitajat ottavat jokaisen potilaan vastaan kiireettömästi ja perusteellisesti. Asiakkaat kokevat saavansa aidosti välittävää ja asiantuntevaa hoitoa lemmikeilleen myös englannin kielellä.",
        "en": "Lexavet in Pukinmäki receives overwhelming praise for its warm, considerate, and thoroughly professional customer service. Veterinarians and nurses welcome every patient with unhurried care and detailed consultations. Pet owners consistently highlight feeling supported by genuine compassion and skilled medical guidance in Finnish and English."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "fi": "Hellävarainen ja kärsivällinen eläinten käsittely",
        "en": "Gentle and patient companion animal handling"
      },
      "text": {
        "fi": "Palautteissa toistuu kiitos siitä, miten kauniisti ja rauhallisesti arkoja koiria ja kissoja kohdellaan toimenpiteiden aikana. Lääkärit etenevät lemmikin tahtiin, mikä vähentää eläimen jännitystä huomattavasti ja luo turvallisen ilmapiirin. Omistajat arvostavat erityisesti henkilöstön empaattista asennetta ja kärsivällisyyttä tutkimuksissa.",
        "en": "Reviews frequently commend how gently and calmly anxious dogs and cats are handled throughout procedures and examinations. Practitioners adapt to the animal's pace, noticeably lowering stress levels and establishing a secure clinical atmosphere. Pet owners especially appreciate the team's empathetic dedication and patience during complex treatments."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "fi": "Perusteellinen diagnostiikka ja onnistuneet hoidot",
        "en": "Thorough diagnostics and successful treatments"
      },
      "text": {
        "fi": "Asiakkaat ovat erittäin tyytyväisiä klinikan laadukkaisiin hoitotuloksiin, kuten onnistuneisiin hammashoitoihin ja tarkkoihin terveystarkastuksiin. Tutkimukset suoritetaan huolellisesti ja tulokset sekä jatkohoito-ohjeet käydään omistajan kanssa läpi selkeästi. Klinikan osaamiseen luotetaan vaativissakin toimenpiteissä.",
        "en": "Pet owners express great satisfaction with the clinic's dependable treatment results, including dental procedures and meticulous health checkups. Diagnostics are conducted thoroughly, with findings and aftercare instructions explained clearly to clients. Reviewers place high trust in the clinic's veterinary expertise for complex care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fi": "Onko Lexavetissä saatavilla englanninkielistä palvelua?",
        "en": "Is service available in English at Lexavet?"
      },
      "a": {
        "fi": "Kyllä, henkilökunta palvelee asiakkaita sujuvasti sekä suomeksi että englanniksi.",
        "en": "Yes, the clinic team provides consultations fluently in both Finnish and English."
      },
      "basis": "both"
    },
    {
      "q": {
        "fi": "Miten klinikka huomioi arat ja jännittyneet lemmikit?",
        "en": "How does the clinic accommodate anxious and timid pets?"
      },
      "a": {
        "fi": "Eläinlääkärit käyttävät rauhallisia, kärsivällisiä otteita ja etenevät lemmikin ehdoilla stressin välttämiseksi.",
        "en": "Veterinarians use gentle, patient handling methods and proceed at the animal's pace to minimize stress."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fi": "Missä Eläinklinikka Lexavet sijaitsee ja onko siellä pysäköintitilaa?",
        "en": "Where is Eläinklinikka Lexavet located and is parking available?"
      },
      "a": {
        "fi": "Klinikka sijaitsee Pukinmäessä osoitteessa Säterintie 16, ja sen edustalla on asiakaspysäköintipaikkoja.",
        "en": "The clinic is situated in Pukinmäki at Säterintie 16, with customer parking spaces available directly outside."
      },
      "basis": "both"
    }
  ],
