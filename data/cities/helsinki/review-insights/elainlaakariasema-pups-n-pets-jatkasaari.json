  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 57,
      "title": {
        "fi": "Lämmin ja asiantunteva hoitohenkilökunta Jätkäsaaressa",
        "en": "Warm and dedicated veterinary team in Jätkäsaari"
      },
      "text": {
        "fi": "Valtaosa asiakkaista kiittää Jätkäsaaren klinikan henkilöstöä erittäin empaattisesta, ammattitaitoisesta ja inhimillisestä palvelusta. Lääkärit ottavat lemmikin asiat omakseen ja tarjoavat tukea useilla kielillä. Yksittäisissä kriittisissä arvioissa kuitenkin mainitaan ajoittain tylyä käytöstä tai väärinkäsityksiä henkilökunnan kanssa.",
        "en": "The vast majority of clients praise the Jätkäsaari clinic staff for empathetic, highly competent, and humane customer care. Practitioners treat pets with genuine dedication and communicate fluently in multiple languages. Nevertheless, a small number of critical reviews describe occasional friction or miscommunications during stressful visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "fi": "Huolellinen ja rauhallinen potilaiden huomiointi",
        "en": "Attentive and gentle care for companion animals"
      },
      "text": {
        "fi": "Lemmikinomistajat arvostavat eläinlääkäreiden rauhallista ja hellävaraista otetta koirien ja kissojen hoidossa. Henkilökunta antaa eläimelle aikaa tottua tutkimustilanteeseen ja pyrkii tekemään käynnistä mahdollisimman mukavan. Muutama arvostelija nostaa esiin toivomuksen sujuvammasta kivunlievityksestä herkkien kissojen kohdalla.",
        "en": "Pet owners appreciate the calm and reassuring handling provided to dogs and cats during clinic appointments. The team allows animals ample time to adjust to exam rooms and strives to create a positive visit experience. A few reviewers note that communication regarding feline sedation and comfort during stressful waits could be improved."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "fi": "Onnistuneet leikkaukset ja laaja diagnostiikka",
        "en": "Successful surgeries and comprehensive pet diagnostics"
      },
      "text": {
        "fi": "Useimmat kävijät raportoivat erinomaisista hoitotuloksista hammashoidoissa, leikkauksissa sekä sydän- ja ultraäänitutkimuksissa. Toimenpiteet sujuvat rutiinilla ja lemmikit toipuvat hyvin selkeiden ohjeiden kera. Toisaalta yksittäisissä palautteissa kerrotaan komplikaatioista tai jälkihoidon riittämättömäksi koetusta seurannasta.",
        "en": "Most pet owners report highly successful clinical outcomes for dental operations, soft-tissue surgeries, and diagnostic ultrasounds. Procedures are carried out smoothly, helping pets recover well under clear guidance. Conversely, isolated reviews express frustration over postoperative complications or perceived shortcomings in follow-up advice."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fi": "Mitä erikoispalveluita Jätkäsaaren klinikalla tarjotaan?",
        "en": "What specialized services are available at Jätkäsaari clinic?"
      },
      "a": {
        "fi": "Klinikalla on kattavat valmiudet kardiologiaan, hammashoitoihin, leikkauksiin, ultraääneen ja digiröntgeniin.",
        "en": "The clinic provides specialized capabilities in cardiology, dentistry, surgery, ultrasound, and digital X-rays."
      },
      "basis": "both"
    },
    {
      "q": {
        "fi": "Millä kielillä klinikalla palvellaan?",
        "en": "Which languages are spoken by clinic staff?"
      },
      "a": {
        "fi": "Klinikalla palvellaan suomen kielen lisäksi sujuvasti englanniksi ja saksaksi.",
        "en": "In addition to Finnish, consultations are readily available in English and German."
      },
      "basis": "both"
    },
    {
      "q": {
        "fi": "Miten Jätkäsaaren toimipisteelle pääsee parhaiten?",
        "en": "How can the Jätkäsaari clinic be reached most easily?"
      },
      "a": {
        "fi": "Klinikka sijaitsee Atlantinkadulla, jonne pääsee kätevästi raitiovaunulla ja lähistöllä on pysäköintimahdollisuuksia.",
        "en": "The clinic is located on Atlantinkatu, conveniently reached via tram lines with nearby street parking."
      },
      "basis": "both"
    }
