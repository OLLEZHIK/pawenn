  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 94,
      "title": {
        "fr": "Personnel médical attentionné en urgence",
        "en": "Attentive emergency medical staff"
      },
      "text": {
        "fr": "De nombreux propriétaires expriment leur gratitude envers les vétérinaires et les techniciens pour leur humanité lors d'admissions d'urgence en pleine nuit. Les équipes soignantes expliquent clairement les procédures médicales, bien que de rares clients déplorent un accueil administratif distant.",
        "en": "Numerous pet owners express gratitude toward veterinarians and technicians for their compassionate support during late-night emergency admissions. Medical teams explain procedures clearly, although occasional clients report an impersonal front-desk interaction."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 68,
      "title": {
        "fr": "Prise en charge des cas critiques",
        "en": "Care for critical animal emergencies"
      },
      "text": {
        "fr": "Les clients soulignent la délicatesse des soins prodigués aux chiens et chats hospitalisés pour des pathologies sévères ou des chirurgies vitales. Les soignants veillent au confort physique des animaux traumatisés et rassurent les familles dans des moments particulièrement éprouvants.",
        "en": "Clients highlight the gentle care delivered to dogs and cats hospitalized for severe conditions or emergency operations. Caregivers prioritize physical comfort for distressed companions and support worried families through deeply stressful circumstances."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "fr": "Accueil rapide et triage efficace",
        "en": "Rapid intake and effective triage"
      },
      "text": {
        "fr": "La majorité des usagers rapportent une prise en charge rapide des détresses respiratoires et des hémorragies dès l'arrivée au centre. Lorsque l'affluence est forte, des délais d'attente de plusieurs heures peuvent survenir pour les motifs ne mettant pas la vie de l'animal en péril immédiat.",
        "en": "Most visitors report rapid intake for severe respiratory issues and hemorrhages upon arriving at the clinic. During peak emergency hours, waiting times can extend to several hours for non-life-threatening conditions prioritized behind critical patients."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Le centre vétérinaire est-il ouvert 24 heures sur 24 ?",
        "en": "Is the veterinary hospital open 24/7?"
      },
      "a": {
        "fr": "Oui, le centre assure un service d'urgence continue de jour comme de nuit tous les jours de l'année.",
        "en": "Yes, the hospital operates a continuous 24/7 emergency service every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Comment fonctionne le triage des urgences animales ?",
        "en": "How does emergency patient triage operate?"
      },
      "a": {
        "fr": "Les cas les plus critiques sont pris en charge en priorité dès leur arrivée par l'équipe soignante.",
        "en": "The most life-threatening emergencies are prioritized immediately upon arrival by medical staff."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "Où se trouve l'hôpital vétérinaire à Montréal ?",
        "en": "Where is the emergency hospital located in Montreal?"
      },
      "a": {
        "fr": "L'établissement est situé sur le boulevard de Maisonneuve Est, à proximité de la station Papineau.",
        "en": "The facility is located on Boulevard de Maisonneuve East, close to the Papineau metro station."
      },
      "basis": "both"
    }
  ],
