  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 67,
      "title": {
        "fr": "Équipe vétérinaire attentive et rassurante",
        "en": "Compassionate and attentive veterinary staff"
      },
      "text": {
        "fr": "Les maîtres d'animaux soulignent avec insistance la grande empathie, le dévouement et l'écoute de l'équipe vétérinaire d'Hochelaga. Les praticiens comme les techniciennes prennent le temps nécessaire pour instaurer un climat serein et sans pression, tant à la réception qu'en salle de consultation.",
        "en": "Pet owners consistently emphasize the remarkable empathy, patience, and professional dedication shown by the veterinary team in Hochelaga. Veterinarians and veterinary technicians take ample time to foster an unhurried, reassuring environment during examinations and consultations."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "fr": "Douceur des soins animaliers",
        "en": "Gentle feline and canine care"
      },
      "text": {
        "fr": "Les commentaires témoignent d'une approche particulièrement délicate et respectueuse envers les chiens et les chats, notamment les félins craintifs et les animaux âgés. Les gestes sont calmes, adaptés aux besoins émotionnels de chaque patient et réduisent notablement l'anxiété liée à la visite.",
        "en": "Reviews highlight a remarkably gentle and respectful approach toward dogs and cats, particularly timid felines and elderly pets requiring special consideration. Calm handling techniques tailored to each animal's emotional state ensure visits remain peaceful and significantly reduce pet anxiety."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "fr": "Clarté des explications et transparence",
        "en": "Thorough medical explanations and advice"
      },
      "text": {
        "fr": "Les familles apprécient la précision des explications fournies par les vétérinaires au sujet des diagnostics, des vaccins et des soins postopératoires. Les options thérapeutiques sont présentées en toute transparence avec des conseils préventifs clairs, sans jamais forcer la décision des maîtres.",
        "en": "Pet families appreciate the thorough explanations offered by the veterinary team regarding health diagnostics, vaccines, and post-surgery care plans. Treatment options and preventive recommendations are presented transparently, allowing owners to make informed medical choices without pressure."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Les animaux craintifs sont-ils pris en charge avec douceur ?",
        "en": "Are anxious or fearful pets handled gently?"
      },
      "a": {
        "fr": "Oui, de nombreux témoignages confirment la patience et les gestes calmes de l'équipe pour apaiser les chats et chiens stressés.",
        "en": "Yes, numerous reviews confirm the team's patience and calm techniques to soothe stressed cats and dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "Quels types de soins de routine sont offerts à la clinique ?",
        "en": "What routine care services are provided at the clinic?"
      },
      "a": {
        "fr": "La clinique assure les consultations pédiatriques et gériatriques, la vaccination, les chirurgies de stérilisation et les suivis de santé réguliers.",
        "en": "The clinic provides pediatric and geriatric exams, vaccinations, spay/neuter surgeries, and regular wellness health checkups."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "La clinique dispose-t-elle de locaux récemment rénovés ?",
        "en": "Does the clinic feature recently renovated facilities?"
      },
      "a": {
        "fr": "Oui, plusieurs clients apprécient la modernité des espaces rénovés et l'aménagement pensé pour le bien-être des animaux.",
        "en": "Yes, multiple clients appreciate the newly renovated, modern spaces designed for animal comfort and separation."
      },
      "basis": "reviews"
    }
  ],
