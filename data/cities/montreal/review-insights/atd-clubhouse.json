  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 64,
      "title": {
        "fr": "Équipe attentionnée et dévouée",
        "en": "Attentive and dedicated staff"
      },
      "text": {
        "fr": "Les maîtres décrivent une équipe passionnée, chaleureuse et extrêmement attentive au bien-être de chaque chien accueilli en garderie comme en pension. Le personnel est salué pour son professionnalisme et sa capacité à rassurer les animaux les plus timides dès leur première visite.",
        "en": "Dog owners describe a passionate, warm, and highly attentive team dedicated to the well-being of every dog in daycare and boarding. Staff members are praised for their professionalism and ability to comfort even anxious or timid dogs right from their very first visit."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 61,
      "title": {
        "fr": "Socialisation et bien-être canin",
        "en": "Canine socialization and daily well-being"
      },
      "text": {
        "fr": "Les retours mettent en avant un environnement sans cage propice au jeu et aux interactions positives entre pensionnaires de toutes tailles. Les chiens reviennent détendus, épanouis et heureux de retrouver leurs camarades de jeu au centre de la rue Sainte-Catherine Est.",
        "en": "Reviews highlight a cage-free environment fostering playful socialization and positive interactions among dogs of all sizes. Pets return home relaxed, energized, and visibly happy after spending time with fellow companions at the Sainte-Catherine Street East clubhouse."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "fr": "Mises à jour régulières et photos",
        "en": "Regular updates and daily photos"
      },
      "text": {
        "fr": "Les clients apprécient grandement la transmission quotidienne de photos et de vidéos montrant les activités et les moments de repos de leur animal. Cette communication constante procure une grande tranquillité d'esprit aux propriétaires lors des séjours prolongés.",
        "en": "Clients greatly appreciate receiving daily photos and video updates showcasing their dog's activities and restful moments. This consistent communication brings immense peace of mind to guardians throughout daycare days and extended overnight boarding stays."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Les chiens sont-ils gardés en cage pendant la pension ?",
        "en": "Are dogs kept in cages during daycare or overnight boarding?"
      },
      "a": {
        "fr": "Non, le clubhouse privilégie un environnement ouvert et familial sans cage où les chiens peuvent circuler et se reposer confortablement.",
        "en": "No, the clubhouse operates a cage-free, home-style setting where dogs roam, socialize, and rest in comfortable shared lounge spaces."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Les propriétaires reçoivent-ils des nouvelles quotidiennes de leur animal ?",
        "en": "Do pet owners receive daily updates and photos during boarding?"
      },
      "a": {
        "fr": "Oui, l'équipe partage régulièrement des photos et de courtes vidéos illustrant les activités des pensionnaires tout au long de la journée.",
        "en": "Yes, the staff routinely shares pictures and video clips highlighting their pets' daily play sessions and companionship."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "Un service de transport ou navette est-il offert pour les chiens ?",
        "en": "Is a pet transit or shuttle service offered for dogs?"
      },
      "a": {
        "fr": "Oui, un service de navette pour chiens est proposé afin de faciliter les déplacements entre le domicile et le centre.",
        "en": "Yes, a canine shuttle service is available to transport dogs conveniently between home and the clubhouse facility."
      },
      "basis": "both"
    }
  ],
