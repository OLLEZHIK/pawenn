      "q": {
        "fr": "La clinique prend-elle en charge les urgences de jour ?",
        "en": "Does the clinic handle daytime pet emergencies?"
      },
      "a": {
        "fr": "Oui, la clinique offre des consultations d'urgence et le triage vétérinaire pour chiens et chats pendant ses heures d'ouverture régulières.",
        "en": "Yes, the clinic provides triage and emergency medical care for cats and dogs during its regular operating hours."
      },
