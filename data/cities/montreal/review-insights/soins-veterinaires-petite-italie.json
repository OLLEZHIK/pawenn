  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "fr": "Vétérinaires dévoués et accueil chaleureux",
        "en": "Dedicated veterinarians and warm welcome"
      },
      "text": {
        "fr": "Les clients de la Petite-Italie soulignent unanimement l'accueil bienveillant et la disponibilité de la Dre Marylin Cuisinier et de ses collègues. L'équipe médicale prend le temps d'écouter les familles et de répondre posément à toutes les interrogations. Cette approche personnalisée et chaleureuse fait de la clinique une référence appréciée du quartier.",
        "en": "Pet guardians in Little Italy consistently highlight the kind welcome and helpful approach of Dr. Marylin Cuisinier and her colleagues. The medical staff take generous time to listen to family concerns and answer questions thoroughly. This attentive, personalized atmosphere makes the neighborhood practice a trusted choice for local pet owners."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "fr": "Douceur envers les animaux sensibles",
        "en": "Gentle handling of sensitive pets"
      },
      "text": {
        "fr": "Les avis mettent en lumière la grande délicatesse démontrée envers les chiens anxieux, les chats stressés et les nouveaux animaux de compagnie comme les lapins. Les praticiens adoptent une méthode douce et sécurisante qui permet aux animaux de se détendre en salle de soins. Les maîtres sont rassurés par cette manipulation respectueuse et bienveillante.",
        "en": "Reviews emphasize the thoughtful gentleness displayed when caring for anxious dogs, stressed cats, and exotic companions such as rabbits. The clinicians employ quiet, reassuring techniques that help nervous pets relax during medical examinations. Pet parents feel completely reassured watching their animals being handled with such respectful tenderness."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "fr": "Échanges rassurants et pédagogie médicale",
        "en": "Reassuring guidance and clear communication"
      },
      "text": {
        "fr": "Les propriétaires apprécient les explications pédagogiques des vétérinaires qui prennent le temps de clarifier les protocoles de soins sans jargon. Les clients hispanophones soulignent également avec joie la prise en charge en espagnol. Un avis isolé mentionne cependant un retard dans la communication téléphonique de résultats d'analyses sanguines.",
        "en": "Pet owners appreciate the informative and educational explanations provided by veterinarians who outline care options without medical jargon. Spanish-speaking clients also express delight at receiving consultations in Spanish. An isolated review noted a delay in receiving phone callbacks regarding routine blood test results, though overall communication remains highly rated."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "La clinique traite-t-elle les animaux exotiques comme les lapins ?",
        "en": "Does the clinic treat exotic pets like rabbits?"
      },
      "a": {
        "fr": "Oui, la Dre Cuisinier et l'équipe soignante reçoivent régulièrement des lapins et autres petits mammifères pour des consultations spécialisées.",
        "en": "Yes, Dr. Cuisinier and the medical team regularly consult on rabbits and small companion animals."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Est-il possible de recevoir un service en espagnol ?",
        "en": "Is service available in Spanish at the clinic?"
      },
      "a": {
        "fr": "Oui, plusieurs clients indiquent avoir été chaleureusement accueillis et conseillés en espagnol lors de leurs visites.",
        "en": "Yes, multiple clients report receiving consultations and assistance in Spanish during their visits."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "La clinique pratique-t-elle des tarifs abordables ?",
        "en": "Are veterinary fees considered affordable?"
      },
      "a": {
        "fr": "Les avis soulignent des prix très raisonnables et l'absence de vente incitative pour des traitements superflus.",
        "en": "Client reviews consistently mention reasonable pricing and the absence of pressure to purchase unnecessary treatments."
      },
      "basis": "reviews"
    }
  ],
