  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "fr": "Épanouissement et bien-être canin",
        "en": "Dog socialization and daily wellness"
      },
      "text": {
        "fr": "Les maîtres expriment une grande satisfaction quant à la garde en pension et à la garderie de jour. Les chiens reviennent visiblement heureux, détendus et bien dépensés après de longues séances de jeu avec leurs congénères. De nombreux clients réguliers considèrent cet environnement stimulant comme une véritable seconde maison.",
        "en": "Dog owners express exceptional satisfaction with the boarding and daycare programs at Doggieville. Dogs regularly return home joyful, relaxed, and happily tired after energetic play sessions with other companions. Many longtime clients view the supervised group play environment as a trusted second home."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "fr": "Équipe dévouée et communication",
        "en": "Dedicated staff and photo updates"
      },
      "text": {
        "fr": "Le personnel reçoit des éloges constants pour sa bienveillance, son accueil chaleureux et son dévouement envers chaque animal. Les propriétaires apprécient particulièrement les nouvelles régulières, les comptes-rendus détaillés et les photos envoyées pendant les séjours, offrant une grande tranquillité d'esprit aux familles.",
        "en": "The staff receives consistent praise for their attentiveness, warm demeanor, and sincere commitment to pet safety. Pet parents particularly appreciate the frequent photo updates and detailed daily reports sent during overnight stays, ensuring complete peace of mind while away on trips."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "fr": "Installations modernes et propreté",
        "en": "Modern facilities and canine pool"
      },
      "text": {
        "fr": "Les installations de ce centre canin montréalais sont reconnues pour leur modernité, leur propreté impeccable et la sécurité des espaces de pension. La piscine intérieure chauffée Yoda Splash et le café canin Ruby Café constituent des atouts appréciés des visiteurs pour nager avec leur compagnon ou partager une boisson.",
        "en": "The facilities at this Montreal pet center earn high praise for their modern design, pristine cleanliness, and secure boarding areas. The heated indoor canine pool and the pet-friendly on-site cafe stand out as unique amenities where guardians can swim with their dogs or enjoy a relaxed beverage together."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Les propriétaires reçoivent-ils des nouvelles durant la pension ?",
        "en": "Do pet owners receive updates during overnight boarding?"
      },
      "a": {
        "fr": "Oui, l'équipe transmet régulièrement des photos et des résumés d'activités pour rassurer les maîtres durant leur absence.",
        "en": "Yes, staff members regularly provide photos and activity updates to reassure pet parents while they are traveling."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "La piscine intérieure est-elle ouverte aux maîtres et à leurs chiens ?",
        "en": "Is the indoor canine pool accessible to owners and their dogs?"
      },
      "a": {
        "fr": "Oui, le bassin Yoda Splash permet aux maîtres de nager avec leur chien sur réservation dans des installations sécurisées.",
        "en": "Yes, the Yoda Splash indoor pool allows owners to book sessions to swim with their dogs in a secure setting."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Le centre offre-t-il également des services de garderie de jour ?",
        "en": "Does the facility offer daytime dog daycare services?"
      },
      "a": {
        "fr": "Oui, Doggieville propose un service complet de garderie de jour favorisant la socialisation et le jeu supervisé.",
        "en": "Yes, Doggieville provides full dog daycare services centered on structured socialization and supervised play."
      },
      "basis": "both"
    }
  ],
