  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 239,
      "title": {
        "fr": "Vitalité et bienfaits sur la santé",
        "en": "Health benefits and improved pet vitality"
      },
      "text": {
        "fr": "Les propriétaires rapportent des effets très positifs de cette alimentation crue sur la santé de leurs chiens et chats. Les maîtres constatent une nette amélioration de la digestion, la disparition d'allergies cutanées tenaces et un regain notable d'énergie et de vitalité.",
        "en": "Pet owners report remarkably positive effects from this raw food diet on the health of their dogs and cats. Guardians observe improved digestive health, the resolution of persistent skin allergies, and a noticeable boost in overall energy and vitality."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 75,
      "title": {
        "fr": "Emballage pratique et livraison fiable",
        "en": "Convenient packaging and reliable delivery"
      },
      "text": {
        "fr": "Les avis saluent le conditionnement ingénieux en portions individuelles faciles à servir sans gaspillage. La livraison à domicile avec glace sèche garantit la parfaite fraîcheur des repas congelés jusqu'à la porte, même lors de fortes chaleurs estivales à travers le Québec.",
        "en": "Reviewers commend the practical portion-controlled blocks that make daily raw feeding simple and mess-free. Home delivery packaged with dry ice ensures frozen meals remain completely fresh upon arrival at the door, even during warm summer temperatures across Quebec."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 58,
      "title": {
        "fr": "Rapport qualité-prix avantageux",
        "en": "Exceptional value for raw nutrition"
      },
      "text": {
        "fr": "La majorité des clients considèrent cette nourriture crue comme l'une des options les plus abordables et nutritives sur le marché canadien. Les formats en gros volume et les offres d'achat groupé permettent de nourrir de grands chiens avec des ingrédients de qualité sans excéder son budget.",
        "en": "Most pet owners regard this raw food formula as one of the most cost-effective and nutritious diets on the Canadian market. Bulk purchasing options and competitive pricing make feeding human-grade raw nutrition feasible and sustainable for owners of larger breeds."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Comment la nourriture crue est-elle conservée pendant la livraison ?",
        "en": "How is the raw food kept frozen during doorstep delivery?"
      },
      "a": {
        "fr": "Les commandes sont expédiées dans des boîtes isothermes renforcées avec de la glace sèche pour maintenir la chaîne du froid intacte.",
        "en": "Orders are shipped in insulated boxes with dry ice to keep raw food solidly frozen until delivery."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Cette nourriture aide-t-elle les chiens souffrant d'allergies alimentaires ?",
        "en": "Does this raw diet help dogs with food allergies and skin issues?"
      },
      "a": {
        "fr": "Oui, de nombreux propriétaires témoignent d'une réduction marquée des démangeaisons et des intolérances grâce aux ingrédients naturels.",
        "en": "Yes, many owners report significant relief from skin irritations and intolerances thanks to simple natural ingredients."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "Peut-on ramasser sa commande directement à l'atelier de Montréal ?",
        "en": "Can customers pick up their online orders directly at the Montreal facility?"
      },
      "a": {
        "fr": "Oui, le ramassage sur place à l'atelier de l'avenue Beaumont est proposé en plus du service de livraison locale.",
        "en": "Yes, in-person pickup at the Beaumont Avenue workshop is available alongside local delivery options."
      },
      "basis": "both"
    }
  ],
