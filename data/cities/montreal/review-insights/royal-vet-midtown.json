  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 91,
      "title": {
        "fr": "Équipe attentionnée et accueil chaleureux",
        "en": "Caring team and welcoming reception"
      },
      "text": {
        "fr": "Une forte majorité de propriétaires salue la bienveillance des vétérinaires, des techniciennes et du personnel d'accueil sur la rue des Jockeys. L'équipe médicale fait preuve d'empathie lors des moments d'angoisse et accompagne les familles avec courtoisie.",
        "en": "A large majority of pet parents praise the kindness and dedication of veterinarians, vet techs, and receptionists on Rue des Jockeys. The clinical staff displays genuine empathy during difficult moments, ensuring families feel supported and well attended."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 66,
      "title": {
        "fr": "Prendre soin des patients anxieux",
        "en": "Compassionate care for anxious pets"
      },
      "text": {
        "fr": "De nombreux avis soulignent la douceur exemplaire dont bénéficient les chats craintifs et les chiens nerveux lors des examens. Les soignants prennent le temps de calmer les compagnons agités, leur offrant des gâteries et manipulant chaque animal sans précipitation.",
        "en": "Numerous reviews emphasize the soothing gentleness shown to frightened cats and nervous dogs during clinical examinations. The healthcare team takes time to settle restless pets, offering tasty treats and handling every companion with reassurance and calm."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "fr": "Installations propres et environnement moderne",
        "en": "Clean facilities and clinical space"
      },
      "text": {
        "fr": "Les visiteurs apprécient la propreté méticuleuse des salles de consultation et la grande modernité des équipements vétérinaires sur place. L'atmosphère générale est calme, aérée et soignée, offrant un cadre rassurant pour les animaux malades et leurs propriétaires.",
        "en": "Visitors commend the meticulous cleanliness of the examination rooms and the comfortable, well-kept environment. The premises are organized, bright, and hygienic, providing a reassuring clinical setting for pets requiring diagnostics or emergency attention."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "La clinique accepte-t-elle les urgences sans rendez-vous préalable ?",
        "en": "Does the clinic accommodate emergency cases without prior appointments?"
      },
      "a": {
        "fr": "Oui, la clinique offre des rendez-vous le jour même et prend en charge les urgences médicales pour chiens et chats.",
        "en": "Yes, the clinic regularly provides same-day appointments and accommodates medical emergencies for dogs and cats."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Peut-on réserver un rendez-vous vétérinaire directement en ligne ?",
        "en": "Can veterinary appointments be booked directly online?"
      },
      "a": {
        "fr": "Oui, une plateforme de réservation en ligne permet de choisir facilement un créneau selon ses disponibilités.",
        "en": "Yes, an online booking platform allows pet owners to view available slots and schedule appointments conveniently."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Comment sont pris en charge les animaux craintifs à la clinique ?",
        "en": "How are anxious or fearful animals handled at the clinic?"
      },
      "a": {
        "fr": "Le personnel utilise des techniques douces, des gâteries et un rythme apaisant pour limiter le stress des animaux.",
        "en": "The veterinary team uses gentle handling, treats, and low-stress techniques to help nervous pets feel secure."
      },
      "basis": "reviews"
    }
  ],
