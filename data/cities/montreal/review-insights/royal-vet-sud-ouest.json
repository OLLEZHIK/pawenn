  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "fr": "Équipe soignante chaleureuse et attentionnée",
        "en": "Warm and caring veterinary team"
      },
      "text": {
        "fr": "Les propriétaires d'animaux saluent l'accueil attentionné et le dévouement du personnel vétérinaire dans Le Sud-Ouest. L'équipe prend le temps d'écouter les inquiétudes lors des consultations et assure un suivi apprécié après les soins. Plusieurs maîtres soulignent la compétence des techniciens et des médecins pour sécuriser les animaux et leurs familles.",
        "en": "Pet owners consistently praise the attentive welcome and dedication of the veterinary staff in Le Sud-Ouest. The team takes ample time to listen to client concerns during appointments and provides thoughtful follow-up care. Multiple clients highlight the professionalism of technicians and vets in reassuring both animals and their families."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "fr": "Douceur envers les chiens et chats",
        "en": "Gentle handling of dogs and cats"
      },
      "text": {
        "fr": "Les avis mettent en avant la grande délicatesse déployée auprès des chiens et des chats craintifs ou nerveux. Les soignants adaptent leurs gestes avec calme, offrent des gâteries et veillent à instaurer un climat apaisant en salle d'examen. Les maîtres apprécient cette patience remarquable qui réduit le stress des animaux hospitalisés ou blessés.",
        "en": "Client reviews emphasize the gentle approach shown toward nervous, shy, or fearful dogs and cats. Staff members adapt their handling calmly, offer treats, and strive to create a soothing exam room environment. Pet owners appreciate this consistent patience, which significantly eases tension for companion animals undergoing procedures or treatments."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 13,
      "title": {
        "fr": "Explications médicales et suivi des urgences",
        "en": "Medical explanations and emergency communication"
      },
      "text": {
        "fr": "La majorité des clients apprécie les explications claires et détaillées fournies lors des bilans de santé de routine. Toutefois, quelques avis critiques signalent un manque de transparence lors d'urgences graves ou de complications post-opératoires imprévues. Certains propriétaires auraient souhaité des informations plus directes sur les limites de plateau technique avant d'engager des frais.",
        "en": "Most clients appreciate the thorough and clear explanations provided during routine wellness examinations. However, several critical reviews point to communication gaps during critical emergencies or unexpected post-operative complications. A few pet owners felt that diagnostic capabilities and procedural limits should have been clarified earlier before incurring high expenses."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "La clinique accepte-t-elle les urgences sans rendez-vous ?",
        "en": "Does the clinic accept walk-in emergencies?"
      },
      "a": {
        "fr": "La clinique prend en charge les urgences mineures durant ses heures d'ouverture, mais il est fortement recommandé d'appeler avant de vous déplacer.",
        "en": "The clinic handles minor pet emergencies during open hours, though calling ahead before arriving is strongly recommended."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Y a-t-il un stationnement disponible pour les clients ?",
        "en": "Is customer parking available on site?"
      },
      "a": {
        "fr": "Oui, plusieurs clients confirment la présence d'un stationnement gratuit situé à l'arrière du bâtiment de la clinique.",
        "en": "Yes, multiple clients confirm that free parking is available behind the clinic building."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "La prise de rendez-vous en ligne est-elle possible ?",
        "en": "Is online appointment booking available?"
      },
      "a": {
        "fr": "Oui, les clients peuvent facilement réserver leurs consultations régulières en ligne sur le site officiel de la clinique.",
        "en": "Yes, clients can easily book routine veterinary appointments online through the clinic's official website."
      },
      "basis": "both"
    }
