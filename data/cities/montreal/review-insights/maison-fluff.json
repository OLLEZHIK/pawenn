  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "fr": "Toiletteur attentionné et communication exemplaire",
        "en": "Attentive groomer and excellent communication"
      },
      "text": {
        "fr": "Une immense majorité de clients loue la bienveillance, la courtoisie et la disponibilité de Samuel dans son salon du Vieux-Montréal. Son accueil personnalisé, sa maîtrise bilingue du français et de l'anglais et son écoute des demandes spécifiques mettent immédiatement les propriétaires en totale confiance lors du dépôt de leur animal.",
        "en": "A vast majority of clients praise Samuel's kindness, courtesy, and attentiveness at his Old Montreal studio. His personalized welcome, fluent bilingual communication in French and English, and careful listening to specific requests immediately put pet guardians at total ease when dropping off their dogs."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "fr": "Toilettage sans cage pour chiens sensibles",
        "en": "Cage-free care for sensitive dogs"
      },
      "text": {
        "fr": "Le concept sans cage ni contention est vivement plébiscité par les maîtres de chiens nerveux, âgés ou craintifs des manipulations. Les animaux sont accueillis individuellement dans une atmosphère sereine, même si un avis isolé a signalé une réaction cutanée et un inconfort temporaire après une tonte courte.",
        "en": "The cage-free and restraint-free approach is widely appreciated by guardians of nervous, senior, or touch-sensitive dogs. Pets receive one-on-one attention in a serene atmosphere, though an isolated review noted post-grooming skin irritation and temporary discomfort following a short trim."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "fr": "Coupes soignées et pelage soyeux",
        "en": "Neat haircuts and soft coats"
      },
      "text": {
        "fr": "Les maîtres soulignent la beauté des coupes aux ciseaux, le démêlage délicat et la douceur soyeuse du pelage au retour de la séance. Les finitions des visages et les coupes estivales sont largement vantées, en dépit d'une critique isolée concernant une coupe jugée inégale sur une peau sensibilisée.",
        "en": "Owners frequently praise the aesthetics of the scissor styling, gentle de-shedding, and the soft, fresh texture of their dogs' coats upon pickup. Facial trims and summer cuts receive broad acclaim, despite a single review mentioning an uneven trim on sensitive skin."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Le toilettage s'effectue-t-il sans cage ni contention ?",
        "en": "Is grooming conducted without cages or restraints?"
      },
      "a": {
        "fr": "Oui, le salon applique une méthode sans cage où chaque chien bénéficie d'un suivi individuel personnalisé.",
        "en": "Yes, the studio operates strictly cage-free, providing individual one-on-one attention to each dog."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Les services sont-ils proposés en français et en anglais ?",
        "en": "Are services offered in both French and English?"
      },
      "a": {
        "fr": "Oui, le toiletteur accueille la clientèle et communique couramment en français ainsi qu'en anglais.",
        "en": "Yes, the groomer welcomes pet guardians and communicates fluently in both French and English."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "L'établissement prend-il en charge les chiens réactifs ou anxieux ?",
        "en": "Does the studio accept reactive or anxious dogs?"
      },
      "a": {
        "fr": "Oui, l'approche douce sans bruit d'autres chiens permet d'apaiser les animaux sensibles ou craintifs des étrangers.",
        "en": "Yes, the calm setting without overlapping barking helps soothe nervous dogs or those hesitant around strangers."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Des produits hypoallergéniques sont-ils utilisés pour les peaux sensibles ?",
        "en": "Are hypoallergenic products used for sensitive coats?"
      },
      "a": {
        "fr": "Oui, les soins intègrent des nettoyants et lotions sans alcool spécialement conçus pour les épidermes délicats.",
        "en": "Yes, treatments feature alcohol-free formulas specially selected to protect delicate or reactive skin."
      },
      "basis": "both"
    }
  ],
