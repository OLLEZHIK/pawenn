  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 69,
      "title": {
        "fr": "Équipe spécialisée et accueil chaleureux",
        "en": "Specialized team and warm reception"
      },
      "text": {
        "fr": "Les propriétaires louent le dévouement et l'empathie remarquables des vétérinaires ophtalmologistes et des techniciennes. L'équipe médicale prend le temps de rassurer les familles, d'examiner minutieusement les animaux et d'expliquer chaque étape du diagnostic.",
        "en": "Pet owners consistently praise the remarkable empathy and dedication shown by the veterinary ophthalmologists and staff. The medical team takes ample time to reassure worried families, conduct thorough examinations, and clearly explain every diagnostic step."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "fr": "Douceur auprès des animaux anxieux",
        "en": "Gentle handling of anxious pets"
      },
      "text": {
        "fr": "De nombreux témoignages mettent en valeur l'approche calme et rassurante adoptée envers les chiens et les chats stressés. Les soignants manipulent les yeux avec délicatesse, évitant ainsi d'effrayer les animaux souffrant de troubles de la vue ou de douleur oculaire.",
        "en": "Numerous reviews highlight the calm and comforting approach used with stressed dogs and cats during appointments. The clinicians handle sensitive eyes with great gentleness, preventing unnecessary anxiety for companions suffering from vision loss or ocular pain."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "fr": "Efficacité des soins de la vue",
        "en": "Effectiveness of ocular medical care"
      },
      "text": {
        "fr": "Les clients rapportent des réussites médicales et chirurgicales majeures pour traiter les ulcères cornéens, les cataractes ou le glaucome. Beaucoup expriment leur soulagement de voir leur animal recouvrer la vue ou retrouver un confort visuel durable après l'intervention.",
        "en": "Clients report major surgical and therapeutic successes when treating corneal ulcers, cataracts, and feline glaucoma. Many pet parents express immense relief after seeing their companions regain their vision or achieve lasting comfort following specialized treatment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Quels problèmes oculaires sont traités par cette clinique ?",
        "en": "What ocular conditions are treated at this clinic?"
      },
      "a": {
        "fr": "L'établissement prend en charge les ulcères cornéens, la cataracte, le glaucome, les uvéites et les chirurgies palpébrales complexes.",
        "en": "The clinic handles corneal ulcers, cataracts, glaucoma, uveitis, and complex eyelid or intraocular surgeries."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Les animaux anxieux sont-ils bien pris en charge lors de la consultation ?",
        "en": "How are anxious pets accommodated during examinations?"
      },
      "a": {
        "fr": "Oui, le personnel prend le temps d'apaiser l'animal par des gestes doux et un environnement calme avant de procéder aux examens.",
        "en": "Yes, the clinical team adopts gentle handling techniques and maintains a quiet setting to keep anxious animals calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "Peut-on obtenir un rendez-vous d'urgence pour une blessure à l'œil ?",
        "en": "Are urgent appointments available for sudden eye injuries?"
      },
      "a": {
        "fr": "Oui, la clinique réserve des créneaux pour les urgences ophtalmiques telles que les traumatismes ou ulcères profonds.",
        "en": "Yes, the clinic accommodates urgent ophthalmic cases such as corneal trauma or acute eye pain during regular hours."
      },
      "basis": "both"
    }
  ],
