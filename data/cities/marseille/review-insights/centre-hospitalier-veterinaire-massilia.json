  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 60,
      "title": {
        "fr": "Praticiens réputés mais accueil très contesté",
        "en": "Renowned clinicians alongside heavily disputed reception"
      },
      "text": {
        "fr": "Les retours sur les équipes du centre hospitalier sont très contrastés. D'un côté, de nombreux maîtres saluent le dévouement et l'expertise technique de spécialistes et chirurgiens renommés comme le Dr Vassal. De l'autre, de multiples avis dénoncent un accueil impersonnel, une attitude jugée froide ou hautaine et un manque d'empathie face à la détresse.",
        "en": "Feedback concerning the hospital staff is sharply divided. On one hand, many owners praise the technical dedication and skill of recognized specialists and surgeons such as Dr. Vassal. On the other hand, numerous reviews report an impersonal intake process, perceived aloofness from desk staff, and a lack of empathy during emotional crises."
      }
    },
    {
      "topic": "results",
      "sentiment": "negative",
      "mentions": 34,
      "title": {
        "fr": "Soins intensifs et complications douloureuses",
        "en": "Intensive care and contentious clinical outcomes"
      },
      "text": {
        "fr": "Si le plateau technique moderne permet de réaliser des chirurgies complexes et des examens d'imagerie avancés, les critiques négatives prédominent dans les retours récents. Plusieurs familles déplorent des diagnostics erronés, des détériorations rapides en hospitalisation ou des pertes tragiques d'animaux, générant une amertume profonde chez les maîtres.",
        "en": "While the advanced medical infrastructure enables complex surgeries and specialized imaging procedures, negative evaluations outweigh positive accounts in recent feedback. Several families report alleged misdiagnoses, rapid decline during hospitalization, or tragic pet losses, leading to profound disappointment and grievance among guardians."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 27,
      "title": {
        "fr": "Facturations hospitalières jugées très excessives",
        "en": "Hospital invoices perceived as highly excessive"
      },
      "text": {
        "fr": "Le niveau tarifaire du centre hospitalier suscite une vive réprobation parmi les propriétaires d'animaux. Les usagers dénoncent des consultations de base à plus de cent trente euros et des devis chirurgicaux atteignant plusieurs milliers d'euros. Beaucoup perçoivent une logique commerciale trop agressive, exigeant des règlements avant tout acte médical.",
        "en": "Pricing levels at the veterinary hospital encounter persistent criticism from visiting pet parents. Clients point out consultation base fees exceeding one hundred thirty euros and surgical quotes running into thousands of euros. Many reviewers describe an overly commercial orientation that insists on financial guarantees before proceeding with care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Le centre hospitalier dispose-t-il d'un équipement d'imagerie spécialisé ?",
        "en": "Does the hospital have advanced imaging and surgical facilities?"
      },
      "a": {
        "fr": "Oui, l'établissement est doté d'un plateau technique complet comprenant scanner, IRM et blocs chirurgicaux spécialisés.",
        "en": "Yes, the hospital operates advanced diagnostic equipment including CT scan, MRI, and specialized surgical suites."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Quels sont les retours sur les tarifs des consultations d'urgence ?",
        "en": "What do reviews report concerning emergency consultation fees?"
      },
      "a": {
        "fr": "Les avis soulignent régulièrement des tarifs très élevés, avec des consultations initiales dépassant cent trente euros.",
        "en": "Reviews consistently note very high rates, with baseline emergency consultations exceeding one hundred thirty euros."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "fr": "Le centre prend-il en charge les urgences 24h/24 ?",
        "en": "Does the center admit emergency cases 24 hours a day?"
      },
      "a": {
        "fr": "Oui, la structure fonctionne en continu pour assurer les admissions d'urgence de jour comme de nuit.",
        "en": "Yes, the hospital provides continuous around-the-clock emergency admissions day and night."
      },
      "basis": "reviews"
    }
  ],
