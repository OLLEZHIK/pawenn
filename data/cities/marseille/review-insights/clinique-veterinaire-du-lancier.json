  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 62,
      "title": {
        "fr": "Praticiens réputés et disponibilité constante",
        "en": "Renowned clinicians and constant availability"
      },
      "text": {
        "fr": "Les familles du 8e arrondissement saluent chaleureusement l'écoute et l'expertise des docteurs Genty, Mayaud, Play et Canovas au Lancier. L'accueil des assistantes est qualifié de prévenant, l'équipe prenant le temps d'expliquer chaque traitement sans presser les consultations.",
        "en": "Pet owners in the 8th arrondissement warmly praise the attentive expertise of Dr Genty, Dr Mayaud, Dr Play, and Dr Canovas at Le Lancier. Front desk staff are commended for their kindness, while clinicians take time to explain each treatment without rushing appointments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "fr": "Bientraitance animale et accompagnement attentif",
        "en": "Animal welfare and attentive companionship"
      },
      "text": {
        "fr": "Les propriétaires mettent en avant la délicatesse des vétérinaires envers les chats craintifs, les chiots et les bêtes âgées. Qu'il s'agisse d'un premier vaccin ou d'un suivi au long cours, les animaux sont examinés avec douceur, patience et une grande sensibilité.",
        "en": "Guardians emphasize the gentle approach shown by clinicians toward fearful cats, young puppies, and senior companions. Whether conducting a first vaccination or long-term chronic monitoring, veterinary staff treat visiting animals with patience, warmth, and genuine care."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 9,
      "title": {
        "fr": "Prise en charge réactive des urgences",
        "en": "Responsive intake for urgent care"
      },
      "text": {
        "fr": "La clinique est réputée pour sa réactivité lors des situations d'urgence, y compris le samedi matin ou sans rendez-vous préalable. La prise de rendez-vous en ligne via application mobile et la présence de plusieurs praticiens réduisent considérablement les délais d'attente.",
        "en": "The practice is widely praised for its rapid response in emergencies, including Saturday mornings and same-day walk-in situations. Mobile app scheduling and the presence of multiple practitioners on site noticeably shorten waiting intervals for anxious pet parents."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Peut-on obtenir un rendez-vous rapide ou d'urgence le samedi ?",
        "en": "Can clients book urgent or fast Saturday appointments?"
      },
      "a": {
        "fr": "Oui, de nombreux avis soulignent une prise en charge rapide des urgences le samedi et en semaine.",
        "en": "Yes, numerous reviews praise prompt emergency care on Saturdays and throughout the week."
      },
      "basis": "reviews"
    },
