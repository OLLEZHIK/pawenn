  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 112,
      "title": {
        "pt": "Atendimento caloroso e prontidão médica",
        "en": "Compassionate service and clinical readiness"
      },
      "text": {
        "pt": "A equipe clínica em Copacabana é amplamente celebrada pela agilidade e empatia demonstradas em momentos de urgência. Médicos e recepcionistas recebem frequentes elogios pelo acolhimento atencioso, apesar de queixas pontuais sobre suporte administrativo.",
        "en": "The veterinary team in Copacabana is widely commended for agility and compassionate dedication during emergencies. Doctors and front desk staff frequently receive praise for supportive care, alongside occasional complaints about administrative billing issues."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "pt": "Respeito e carinho pelos pacientes",
        "en": "Respectful and gentle animal care"
      },
      "text": {
        "pt": "Tutores destacam a postura amorosa e a paciência com que os animais são manuseados durante consultas, exames de imagem e internações. Essa atenção acolhedora transmite segurança aos donos e assegura conforto para os animais durante todo o atendimento.",
        "en": "Guardians commend the patient and gentle touch applied when treating companion animals during examinations, imaging, and hospital stays. This comforting demeanor brings reassurance to anxious pet parents and ensures a secure, calm setting for their companions."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 12,
      "title": {
        "pt": "Preços de consultas e exames complementares",
        "en": "Consultation fees and additional exam costs"
      },
      "text": {
        "pt": "Embora a consulta inicial seja considerada acessível por muitos tutores, surgem reclamações constantes sobre os custos elevados de exames laboratoriais e procedimentos cirúrgicos. Vários clientes relatam surpresa com valores finais bem acima do esperado para uma clínica popular.",
        "en": "Although initial consultations are considered affordable by many pet owners, frequent complaints arise regarding the steep cost of lab exams and procedures. Several clients express surprise at final bills that notably exceed expectations for a popular clinic."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "A clínica HV Copacabana atende emergências 24 horas?",
        "en": "Does HV Copacabana attend emergencies 24 hours daily?"
      },
      "a": {
        "pt": "Sim, a clínica mantém atendimento emergencial contínuo e leitos de internação 24 horas por dia em Copacabana.",
        "en": "Yes, the clinic operates 24-hour continuous emergency triage and inpatient hospitalization in Copacabana."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "É necessário agendamento prévio para consultas de emergência?",
        "en": "Is prior booking required for urgent medical visits?"
      },
      "a": {
        "pt": "Não, casos emergenciais são atendidos por ordem de chegada com triagem médica imediata na unidade.",
        "en": "No, emergency visits are handled on a walk-in basis with immediate clinical triage upon arrival."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "A unidade aceita pagamentos via Pix e cartões?",
        "en": "Does the facility accept Pix and card payments?"
      },
      "a": {
        "pt": "Sim, o hospital aceita cartões e dinheiro, embora clientes sugiram verificar condições vigentes para transferências Pix.",
        "en": "Yes, the hospital accepts major credit cards and cash, though clients suggest verifying specific policies for Pix transfers."
      },
      "basis": "reviews"
    }
  ],
