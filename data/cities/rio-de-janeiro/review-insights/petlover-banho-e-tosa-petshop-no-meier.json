  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 58,
      "title": {
        "pt": "Equipe atenciosa com ressalvas operacionais",
        "en": "Attentive team with occasional operational concerns"
      },
      "text": {
        "pt": "A dedicação da maioria dos tosadores é amplamente elogiada pelo carinho demonstrado com animais idosos e filhotes no Méier. Contudo, relatos críticos pontuais mencionam desentendimentos sobre atrasos no agendamento e postura ríspida da gerência diante de queixas.",
        "en": "The dedication of most groomers is widely applauded for caring gentleness toward senior pets and young puppies in Méier. However, isolated critical reports mention disagreements regarding scheduling delays and tense management reactions when handling customer feedback."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "pt": "Cuidado dedicado com animais de estimação",
        "en": "Dedicated care for beloved companion animals"
      },
      "text": {
        "pt": "Os donos de cães e gatos expressam imensa tranquilidade pelo tratamento afetuoso dispensado aos animais durante as sessões de estética. Tutores observam que os pets se sentem protegidos e recebem atenção gentil, saindo relaxados e seguros após os banhos na unidade.",
        "en": "Dog and cat owners express immense peace of mind regarding the gentle and affectionate care given to pets during grooming visits. Guardians note that their animals feel protected and receive kind attention, leaving relaxed and content following baths at the salon."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "pt": "Higiene caprichada e perfume marcante",
        "en": "Quality pet hygiene and memorable fragrance"
      },
      "text": {
        "pt": "Os clientes no Méier elogiam com entusiasmo a qualidade dos banhos e o acabamento das tosas higiênicas e na tesoura. Tutores destacam a maciez da pelagem e os perfumes duradouros utilizados nos cães, afirmando que os animais voltam para casa limpíssimos e cheirosos.",
        "en": "Clients in Méier praise the bathing quality and neat finish of hygienic and scissor grooming trims with great enthusiasm. Guardians highlight the softness of the coat and pleasant lingering fragrances, affirming pets return home impeccably clean and smelling wonderful."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "É possível assistir ao banho do animal através de vidro?",
        "en": "Can pet owners watch the bath through a viewing window?"
      },
      "a": {
        "pt": "Sim, o estabelecimento possui vitrine de vidro permitindo que os tutores acompanhem os cuidados estéticos.",
        "en": "Yes, the salon features a glass viewing partition allowing guardians to observe aesthetic grooming steps."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "pt": "O local atende cães idosos para serviços de tosa?",
        "en": "Does the salon groom senior pets needing extra time?"
      },
      "a": {
        "pt": "Sim, a equipe atende animais idosos com tosa na tesoura, embora procedimentos delicados possam exigir mais tempo.",
        "en": "Yes, the staff cares for elderly dogs with scissor trimming, though delicate work may require extended time."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "pt": "Como os clientes avaliam o perfume utilizado nos banhos?",
        "en": "How do customers describe the grooming fragrances used?"
      },
      "a": {
        "pt": "A maioria das avaliações destaca que o perfume do banho tem excelente fixação e agradável suavidade.",
        "en": "Most reviews emphasize that the shampoo fragrances offer great durability and pleasant subtlety on fur."
      },
      "basis": "reviews"
    }
