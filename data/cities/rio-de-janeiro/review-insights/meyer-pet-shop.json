  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "pt": "Cordialidade e atenção da equipe",
        "en": "Helpful customer service and cordial staff"
      },
      "text": {
        "pt": "A equipe do Meyer Pet Shop no Méier é elogiada com frequência pela simpatia e disposição em auxiliar nas compras e agendamentos presenciais. Atendentes e tosadores são descritos como prestativos e educados, apesar de raras críticas sobre falhas na entrega.",
        "en": "The staff at Meyer Pet Shop in Méier is regularly praised for their friendly approach and helpful assistance with retail purchases and grooming bookings. Team members are described as polite and attentive, despite rare complaints regarding delivery delays."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "pt": "Cuidado delicado no banho e tosa",
        "en": "Gentle pet handling during grooming"
      },
      "text": {
        "pt": "Tutores ressaltam o carinho e a paciência com que os pets são tratados nos serviços de estética animal no Méier. Cães e gatos saem limpinhos, cheirosos e sem sinais de estresse, embora uma reclamação isolada aponte incidente com corte de unha durante a tosa.",
        "en": "Guardians commend the patient and affectionate handling given to pets during grooming sessions. Dogs and cats return clean, fragrant, and relaxed, though one isolated review notes a minor nail-trimming incident during an otherwise thorough grooming visit."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "pt": "Pontualidade e rapidez nas entregas",
        "en": "Punctual deliveries and prompt service"
      },
      "text": {
        "pt": "A pontualidade na realização dos serviços de banho e a agilidade nas entregas de produtos em domicílio são pontos positivos frequentes na loja. A maioria dos clientes valoriza a rapidez com que os pedidos chegam às residências nas imediações do Méier.",
        "en": "Punctuality during scheduled grooming sessions and rapid home delivery of pet essentials are frequently praised by local clients. Most pet owners appreciate the dependable speed with which retail store orders arrive at homes across the Méier neighborhood."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "Quais produtos e serviços estão disponíveis no Meyer Pet Shop?",
        "en": "What products and services does Meyer Pet Shop provide?"
      },
      "a": {
        "pt": "O pet shop oferece rações, petiscos, medicamentos e acessórios, além de centro de banho e tosa para cães e gatos.",
        "en": "The shop offers pet food, treats, medicines, and accessories alongside a dedicated bathing and grooming salon."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "O estabelecimento realiza entregas em domicílio no Méier?",
        "en": "Does the store offer home delivery services in Méier?"
      },
      "a": {
        "pt": "Sim, a loja conta com entrega a domicílio ágil para rações e produtos veterinários em bairros da Zona Norte.",
        "en": "Yes, the store provides dependable home delivery for pet food and supplies across the North Zone neighborhoods."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Como os clientes avaliam os serviços de estética animal?",
        "en": "How do clients evaluate the pet grooming and bathing services?"
      },
      "a": {
        "pt": "Os clientes elogiam a higiene, o carinho dos tosadores e a qualidade dos banhos, deixando os pets cheirosos e calmos.",
        "en": "Clients praise the cleanliness, gentle handling by groomers, and thorough baths that leave pets fresh and relaxed."
      },
      "basis": "reviews"
    }
  ],
