  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "pt": "Equipe solícita com atendimento prestativo",
        "en": "Helpful team with attentive customer service"
      },
      "text": {
        "pt": "A maioria dos tutores valoriza a simpatia e a atenção dos funcionários no Centro, destacando a orientação atenciosa na escolha de rações e medicamentos. Profissionais do banho e tosa e veterinários recebem elogios frequentes pela dedicação. No entanto, clientes pontuais apontam demora em caixas e conversas paralelas.",
        "en": "Most pet owners appreciate the friendliness and helpfulness of staff in Centro, highlighting attentive guidance when selecting pet food and medications. Groomers and consulting veterinarians receive frequent praise for their dedication. However, occasional reviews note register delays and staff chatting."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "pt": "Cuidado carinhoso com cães e gatos",
        "en": "Affectionate care for dogs and cats"
      },
      "text": {
        "pt": "Tutores relatam que seus animais são recebidos com carinho genuíno durante as compras, serviços de banho e consultas veterinárias. Os clientes destacam a tranquilidade dos cães no corte de unhas e na higienização, além da paciência demonstrada com animais idosos ou agitados ao longo de todo o atendimento.",
        "en": "Guardians report that their pets are welcomed with genuine affection during store visits, grooming sessions, and veterinary checks. Clients emphasize how calm dogs remain during nail trims and bathing, alongside the patience shown toward senior or nervous animals throughout their care in the shop."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "pt": "Loja organizada com boa variedade",
        "en": "Organized store with broad product variety"
      },
      "text": {
        "pt": "Os clientes elogiam a variedade de produtos disponíveis na loja da Rua Riachuelo, incluindo rações especiais, brinquedos, petiscos e medicamentos de farmácia veterinária. A organização das prateleiras e a disponibilidade de serviço de entrega rápida no bairro são apontadas como pontos práticos para a rotina.",
        "en": "Clients praise the variety of products available at the Rua Riachuelo shop, including specialized pet food, toys, treats, and veterinary pharmacy items. Neat shelf organization and the availability of prompt local delivery in the neighborhood are frequently highlighted as practical assets for daily routines."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "A Utilipet oferece serviço de entrega em domicílio?",
        "en": "Does Utilipet offer home delivery services?"
      },
      "a": {
        "pt": "Sim, avaliações confirmam que a loja disponibiliza entregas locais para rações, itens de higiene e medicamentos.",
        "en": "Yes, reviews confirm that the store provides local home delivery for pet food, hygiene supplies, and medicines."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "pt": "A loja conta com serviços de banho e tosa?",
        "en": "Does the shop provide bathing and grooming?"
