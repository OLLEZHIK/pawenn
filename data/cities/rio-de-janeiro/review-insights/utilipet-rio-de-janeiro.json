      "a": {
        "pt": "Sim, tutores elogiam os serviços de estética animal, corte de unhas e banhos com profissionais dedicados.",
        "en": "Yes, pet owners praise grooming services, nail trimming, and baths performed by dedicated on-site staff."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Há atendimento veterinário no local?",
        "en": "Are veterinary consultations available on-site?"
