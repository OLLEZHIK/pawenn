  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "pt": "Corpo clínico prestativo e queixas pontuais",
        "en": "Dedicated clinical staff and isolated complaints"
      },
      "text": {
        "pt": "A vasta maioria dos clientes no Recreio dos Bandeirantes elogia a atenção e a competência técnica dos veterinários e enfermeiros, ressaltando o carinho nos momentos de urgência. Diversos relatos citam acolhimento exemplar em plantões 24 horas. Contudo, há reclamações pontuais e contundentes sobre diagnósticos equivocados e atitudes rudes de alguns funcionários.",
        "en": "The vast majority of clients in Recreio dos Bandeirantes praise the attentiveness and medical skill of the vets and nursing team, noting genuine dedication during emergency shifts. Many reviews celebrate life-saving clinical interventions. However, a small number of severe complaints cite diagnostic discrepancies, strong medications, and occasional curt staff behavior."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "pt": "Acolhimento afetuoso de cães e gatos",
        "en": "Gentle handling of canine and feline pets"
      },
      "text": {
        "pt": "Tutores destacam o respeito e o carinho com que cães e felinos são tratados durante internações e procedimentos ambulatoriais. A equipe médica demonstra sensibilidade para acalmar animais assustados ou em sofrimento agudo, proporcionando um ambiente acolhedor. Esse tratamento humanizado gera forte sentimento de alívio e segurança para as famílias assistidas.",
        "en": "Owners highlight the genuine gentleness and respect shown to canine and feline patients during hospitalization and routine visits. Clinical staff take time to soothe frightened pets or those undergoing severe pain, creating a comfortable care environment. This empathetic approach provides significant relief and reassurance to families during stressful visits."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "pt": "Instalações modernas e estrutura 24 horas",
        "en": "Modern 24-hour infrastructure and cleanliness"
      },
      "text": {
        "pt": "A estrutura física do hospital no Recreio é frequentemente apontada como limpa, organizada e bem aparelhada para atendimentos complexos. Os clientes valorizam a disponibilidade de centro cirúrgico completo, leitos de internação e equipamentos de imagem no próprio local. A presença de ambientes planejados para felinos também é mencionada como diferencial positivo.",
        "en": "The hospital's facilities in Recreio receive regular praise for being clean, orderly, and well-equipped for complex veterinary medical care. Clients value having surgical suites, intensive care inpatient beds, and diagnostic imaging available under one roof. Dedicated consultation spaces designed specifically for cats are also frequently highlighted by feline owners."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "A unidade do Recreio possui atendimento de emergência durante a madrugada?",
        "en": "Does the Recreio branch offer veterinary emergency care overnight?"
      },
      "a": {
        "pt": "Sim, a clínica opera em regime 24 horas ininterrupto todos os dias, com equipe veterinária de plantão para urgências e internação.",
        "en": "Yes, the clinic operates 24/7 with on-duty veterinary staff available for medical emergencies and hospital monitoring at any hour."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "O hospital conta com exames diagnósticos como ultrassom e raio-x no local?",
        "en": "Does the facility provide diagnostic ultrasound and X-ray on site?"
      },
      "a": {
        "pt": "Sim, a unidade dispõe de aparelhos de imagem digital e exames laboratoriais próprios para agilizar diagnósticos clínicos.",
        "en": "Yes, the facility features on-site digital imaging equipment and clinical laboratory testing for rapid medical evaluation."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Há espaço de atendimento específico para felinos?",
        "en": "Are there separate consultation spaces for feline patients?"
      },
      "a": {
        "pt": "Sim, a estrutura do Cetra Vet Recreio conta com consultórios dedicados para proporcionar um ambiente calmo e seguro para gatos.",
        "en": "Yes, Cetra Vet Recreio features designated feline rooms designed to maintain a quiet, low-stress environment for cats."
      },
      "basis": "website"
    }
