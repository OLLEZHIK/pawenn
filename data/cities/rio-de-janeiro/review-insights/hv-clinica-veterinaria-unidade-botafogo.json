      "a": {
        "pt": "Sim, a clínica mantém atendimento clínico ininterrupto, exames e leitos de internação 24 horas em Botafogo.",
        "en": "Yes, the clinic operates 24-hour emergency triage, diagnostics, and inpatient hospitalization in Botafogo."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Quais exames diagnósticos são realizados na clínica de Botafogo?",
        "en": "What diagnostic tests are performed at the Botafogo clinic?"
      },
      "a": {
        "pt": "O estabelecimento realiza ultrassonografia, raio-x, análises laboratoriais e cirurgias veterinárias gerais.",
        "en": "The facility performs ultrasound scans, digital radiography, clinical laboratory tests, and veterinary surgeries."
      },
      "basis": "website"
    },
