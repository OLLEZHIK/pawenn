  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 91,
      "title": {
        "pt": "Dedicação humanizada e carinho profissional",
        "en": "Compassionate bedside manner and staff dedication"
      },
      "text": {
        "pt": "A equipe da Luar Vet em Inhaúma recebe elogios quase unânimes dos clientes pelo acolhimento caloroso e pela dedicação exemplar no dia a dia. Médicos e atendentes são reconhecidos pela atenção contínua e paciência, com raríssimos relatos de insatisfação pontual.",
        "en": "The veterinary team at Luar Vet in Inhaúma receives near-unanimous praise for compassionate hospitality and dedicated clinical care. Doctors and assistants are celebrated for their warmth and patience, with very few isolated criticisms regarding consultations."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "pt": "Acolhimento amoroso aos animais",
        "en": "Gentle and affectionate animal handling"
      },
      "text": {
        "pt": "Tutores ressaltam o amor genuíno e o respeito demonstrados a cães e gatos em cada atendimento clínico. O manejo delicado acalma os pacientes mais assustados ou estressados, garantindo que os exames e procedimentos transcorram com segurança e tranquilidade.",
        "en": "Pet owners commend the genuine love and patience shown to dogs and cats during every clinical appointment. Gentle, thoughtful handling comforts nervous or fearful companion animals, allowing examinations and medical procedures to proceed smoothly and calmly."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "pt": "Tratamentos resolutivos e cirurgias seguras",
        "en": "Effective treatments and dependable surgeries"
      },
      "text": {
        "pt": "Os clientes destacam a eficácia dos tratamentos clínicos e a perícia demonstrada em procedimentos cirúrgicos. Os relatos apontam rápida recuperação dos animais e diagnósticos assertivos, gerando confiança sólida na capacidade técnica do corpo clínico.",
        "en": "Clients highlight the efficacy of clinical therapies and dependable technical skill shown in surgical interventions in Inhaúma. Reviews report prompt recoveries and accurate diagnoses, cultivating deep trust in the medical competence of the veterinary staff."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "Quais são os dias e horários de atendimento da Luar Vet?",
        "en": "What are the operating hours of Luar Vet clinic?"
      },
      "a": {
        "pt": "A clínica funciona de segunda a sexta das 09h às 18h e aos sábados das 09h às 14h, não abrindo aos domingos.",
        "en": "The clinic operates Monday through Friday from 09:00 to 18:00 and Saturdays from 09:00 to 14:00, closed on Sundays."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "A Luar Vet em Inhaúma realiza cirurgias e exames laboratoriais?",
        "en": "Does Luar Vet in Inhaúma conduct surgeries and lab tests?"
      },
      "a": {
        "pt": "Sim, o espaço oferece cirurgias veterinárias, ultrassonografia, cardiologia e suporte a análises laboratoriais.",
        "en": "Yes, the clinic performs veterinary surgeries, ultrasound diagnostics, cardiology, and clinical laboratory testing."
      },
      "basis": "website"
    },
    {
      "q": {
        "pt": "Como os tutores descrevem o tratamento dispensado aos pets?",
        "en": "How do pet owners describe the handling of pets at the clinic?"
      },
      "a": {
        "pt": "Clientes enfatizam o carinho constante, a paciência e a empatia da equipe durante todos os atendimentos clínicos.",
        "en": "Clients emphasize consistent gentleness, patience, and empathetic care displayed by the entire team during visits."
      },
      "basis": "reviews"
    }
  ],
