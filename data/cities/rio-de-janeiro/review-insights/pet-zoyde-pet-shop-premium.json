  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 145,
      "title": {
        "pt": "Atendimento prestativo e veterinários qualificados",
        "en": "Helpful customer care and qualified veterinarians"
      },
      "text": {
        "pt": "Os clientes elogiam com frequência o atendimento cortês, ágil e atencioso da equipe no Centro do Rio de Janeiro. Tanto os balconistas da loja quanto os veterinários da clínica recebem avaliações positivas pela paciência e orientações claras sobre a saúde dos animais.",
        "en": "Clients frequently commend the courteous, prompt, and attentive service of the team in downtown Rio de Janeiro. Both store retail clerks and clinic veterinarians receive high marks for patient handling and clear medical guidance regarding companion pet healthcare."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "pt": "Carinho constante e atenção aos pets",
        "en": "Loving attention and care for pets"
      },
      "text": {
        "pt": "O cuidado com os animais de estimação é destacado com entusiasmo pelos frequentadores da loja e da clínica. Cães e gatos são recebidos com carinho pelos atendentes e examinados com delicadeza pelos médicos, criando uma experiência acolhedora e segura para os animais.",
        "en": "Care for companion animals is highlighted enthusiastically by regular visitors to the shop and clinic. Dogs and cats are greeted with affection by store clerks and examined gently by veterinarians, creating a welcoming and reassuring atmosphere for all four-legged pets."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "pt": "Variedade de produtos e conveniência central",
        "en": "Wide product range and central convenience"
      },
      "text": {
        "pt": "A loja é amplamente reconhecida pela organização dos corredores e pelo estoque completo de rações, brinquedos e acessórios para pets. A localização central é apontada como muito conveniente para moradores e trabalhadores que precisam de itens essenciais no dia a dia.",
        "en": "The shop is widely recognized for well-arranged aisles and an extensive selection of pet foods, toys, and accessories. Its central location is praised as highly convenient for downtown residents and commuters needing essential supplies during their daily routine."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "O pet shop conta com farmácia veterinária no Centro do Rio?",
        "en": "Does the pet shop feature a veterinary pharmacy in Centro?"
      },
      "a": {
        "pt": "Sim, os clientes encontram ampla variedade de medicamentos veterinários e rações medicamentosas na loja.",
        "en": "Yes, customers find an extensive range of veterinary medications and specialized prescription diets in store."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "pt": "O estabelecimento oferece consultas veterinárias no mesmo local?",
        "en": "Does the establishment provide on-site veterinary appointments?"
      },
      "a": {
        "pt": "Sim, o espaço combina a venda de produtos com consultório veterinário para atendimento clínico de rotina.",
        "en": "Yes, the facility combines retail pet supplies with an on-site veterinary office for routine clinical care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "pt": "A loja física possui opções de rações e acessórios?",
        "en": "Does the physical store stock various food and accessories?"
