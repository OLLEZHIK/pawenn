  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 165,
      "title": {
        "en": "Transformative training for reactive dogs"
      },
      "text": {
        "en": "Dog owners report remarkable progress following the intensive residential Bootcamp and structured training programmes. Reviewers describe taking formerly reactive dogs past bicycles, joggers, and other animals without incident, with many dogs able to relax inside busy pubs and markets. Clients emphasise that training delivers reliable recall and dependable off-lead control."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 155,
      "title": {
        "en": "Supportive and highly skilled instructors"
      },
      "text": {
        "en": "Clients speak glowingly of the training staff, regularly thanking instructors such as Lee, Toni, and Ian for their patience and clarity. Reviewers appreciate that sessions educate the human handlers as much as the dogs, giving owners the confidence and practical handling skills needed to succeed. Handlers note that staff remain encouraging throughout the process."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 95,
      "title": {
        "en": "Understanding complex canine behavioral issues"
      },
      "text": {
        "en": "Pet parents highlight the academy's deep understanding of fearful, anxious, and high-drive dogs. Reviewers who felt exhausted by persistent leash reactivity note that trainers tailor techniques to each individual animal's temperament. Owners describe seeing nervous or defensive dogs build genuine confidence and establish calm, trusting relationships with handlers."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What training formats does Yorkshire Canine Academy offer?"
      },
      "a": {
        "en": "The academy provides residential bootcamps, structured group sessions, private one-to-one programmes, and online training courses."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can the academy help with severe dog reactivity?"
      },
      "a": {
        "en": "Yes, reviewers frequently report dramatic behavioural improvements with dogs that reacted intensely to triggers like other dogs, joggers, or bikes."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where is Yorkshire Canine Academy located?"
      },
      "a": {
        "en": "The training academy is based on Swan Lane in Eccup, situated in the countryside north of Leeds."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Are owners trained alongside their pets during programmes?"
      },
      "a": {
        "en": "Yes, clients emphasize that the academy focuses heavily on coaching handlers in body language, timing, and consistent handling skills."
      },
      "basis": "reviews"
    }
  ],
