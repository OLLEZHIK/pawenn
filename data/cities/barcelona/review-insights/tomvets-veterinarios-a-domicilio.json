  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 128,
      "title": {
        "es": "Personal veterinario empático y cercano",
        "en": "Empathetic and gentle veterinary staff"
      },
      "text": {
        "es": "La mayoría de usuarios elogia la delicadeza y paciencia del equipo veterinario durante las visitas domiciliarias. Valoran el trato afectuoso hacia felinos tímidos y canes ancianos, transmitiendo serenidad a las familias tanto en revisiones periódicas como en despedidas compasivas.",
        "en": "A large majority of users commend the gentleness and patience of the veterinary team during home visits. They value the affectionate care shown to shy cats and elderly dogs, providing genuine calm to pet parents during both routine checkups and compassionate end-of-life care."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "es": "Atención veterinaria en el hogar",
        "en": "Veterinary attention in the home"
      },
      "text": {
        "es": "Los clientes de Gràcia y de toda Barcelona valoran la posibilidad de recibir atención veterinaria directamente en casa. Resaltan que evitar el transportín y los viajes por la ciudad previene el estrés en gatos nerviosos y perros convalecientes, creando un ambiente de calma total durante la consulta.",
        "en": "Clients in Gràcia and across Barcelona appreciate receiving veterinary care directly at home. They emphasize that avoiding carriers and urban journeys prevents anxiety in nervous cats and recovering dogs, creating an atmosphere of complete calm throughout the consultation."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "es": "Procedimientos eficaces y diagnósticos precisos",
        "en": "Effective procedures and accurate diagnostics"
      },
      "text": {
        "es": "Numerosas familias destacan la eficacia de los tratamientos aplicados, la vacunación puntual y la gestión de pasaportes europeos. Los dueños comentan agradecidos la evolución médica favorable de sus animales y el alivio de resolver analíticas y revisiones completas en su propio salón.",
        "en": "Numerous families highlight the efficacy of medical treatments, punctual vaccination, and handling of European pet passports. Owners gratefully note the positive recovery of their pets and the comfort of resolving comprehensive blood tests and exams right in their living room."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Cómo funciona el servicio veterinario a domicilio de TomVets?",
        "en": "How does TomVets mobile veterinary service work?"
      },
      "a": {
        "es": "Los veterinarios se desplazan al domicilio del cliente con el instrumental necesario para exploraciones y tratamientos.",
        "en": "Veterinarians travel to the client's home equipped with necessary tools for examinations and treatments."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Tramitan certificados y pasaportes para viajar al extranjero?",
        "en": "Do they process travel certificates and pet passports?"
      },
      "a": {
        "es": "Sí, gestionan la documentación oficial, vacunas requeridas y revisiones clínicas para desplazamientos internacionales.",
        "en": "Yes, they manage official health certificates, required vaccines, and clinical exams for international travel."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Ofrece el equipo servicio de eutanasia compasiva en el hogar?",
        "en": "Does the team offer compassionate home euthanasia?"
      },
      "a": {
        "es": "Sí, proporcionan acompañamiento digno y sin dolor en casa para que la mascota se despida en su entorno habitual.",
        "en": "Yes, they provide dignified, painless in-home end-of-life care allowing pets to pass peacefully in familiar surroundings."
      },
      "basis": "reviews"
    }
  ],
