  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 76,
      "title": {
        "en": "Dedicated clinicians amidst management challenges"
      },
      "text": {
        "en": "Many pet owners praise individual veterinary surgeons and veterinary nurses for their clinical dedication, kindness, and emergency lifesaving interventions. However, a significant portion of reviews criticise front-desk organisation and administrative responsiveness under corporate management. Clients describe hardworking veterinary staff operating in a visibly strained practice environment."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 30,
      "title": {
        "en": "Frequent delays and prolonged waiting"
      },
      "text": {
        "en": "A widespread point of dissatisfaction among clients is the prevalence of severe appointment delays. Pet owners frequently report waiting thirty to sixty minutes past scheduled times in crowded reception areas, which causes considerable distress to poorly animals. Reviewers also express frustration when pre-booked surgeries were postponed after pets had waited all day."
      }
    },
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 30,
      "title": {
        "en": "Communication breakdowns and telephone delays"
      },
      "text": {
        "en": "Reviewers frequently report difficulty reaching the practice by telephone, citing extended hold times and calls going unanswered during busy hours. Multiple pet parents express deep frustration over having to chase repeatedly for diagnostic test results, medical updates, and prescription paperwork. Clients highlight that follow-up communication requires substantial improvement."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is 24-hour emergency veterinary care available here?"
      },
      "a": {
        "en": "Yes, Streatham Hill operates as a 24-hour veterinary hospital providing round-the-clock emergency consultations, intensive hospitalization, and urgent surgeries."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What issues do clients report regarding appointment delays?"
      },
      "a": {
        "en": "Multiple reviewers report significant waiting times past scheduled appointment slots, advising pet owners to prepare for potential delays during peak clinic hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How easy is it to reach the clinic by phone for updates?"
      },
      "a": {
        "en": "Clients report that telephone lines can be congested with long hold times, often requiring owners to chase repeatedly for routine test results and prescription paperwork."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What advanced surgical and diagnostic facilities are provided?"
      },
      "a": {
        "en": "The hospital offers comprehensive diagnostics including CT scanning, endoscopy, digital radiography, ultrasound, and specialized orthopedic surgery."
      },
      "basis": "website"
    }
  ],
