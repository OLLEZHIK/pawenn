  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 53,
      "title": {
        "en": "Welcoming and attentive veterinary team"
      },
      "text": {
        "en": "Pet owners consistently commend the clinicians, veterinary nurses, and receptionists for their compassionate care and approachable manner. Multiple clients highlight Dr Nikki and Dr Julia for their patience and reassuring presence during examinations. Although a small number of reviewers reported dissatisfaction with communication or bedside manner, the vast majority describe an experienced and supportive team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Gentle and patient pet handling"
      },
      "text": {
        "en": "Clients frequently emphasize how gently their pets are treated, including nervous rescue cats, boisterous dogs, and exotic companions like bearded dragons. Owners value the veterinary team's unhurried approach when administering vaccinations, clipping claws, or managing painful conditions. Reviewers appreciate that practitioners take extra time to keep anxious animals calm and comfortable."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Clean and well-presented practice"
      },
      "text": {
        "en": "Reviewers regularly note that the surgery provides a tidy, clean, and welcoming clinical setting for routine consultations and treatments. Pet owners appreciate the comfortable waiting area and well-maintained facilities in Blackheath. While a few clients noted that parking can occasionally be limited, families generally describe a calming atmosphere that eases the anxiety of visiting the vet."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does The Animal Clinic treat exotic pets?"
      },
      "a": {
        "en": "Yes, reviewers report successful consultations and treatments for exotic companions, including bearded dragons and ferrets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients arrange pet travel certificates?"
      },
      "a": {
        "en": "Pet owners note that the practice efficiently assists with Animal Health Certificates and rabies documentation for overseas travel."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are weekend appointments available at the practice?"
      },
      "a": {
        "en": "Reviewers confirm that routine and urgent weekend appointments are offered without prohibitive out-of-hours surcharges."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What routine preventive services are offered for cats and dogs?"
      },
      "a": {
        "en": "The clinic provides annual booster vaccinations, microchipping, claw trims, and preventive flea and worming advice."
      },
      "basis": "both"
    }
  ],
