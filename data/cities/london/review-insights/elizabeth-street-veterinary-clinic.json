  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Skilled and empathetic emergency team"
      },
      "text": {
        "en": "Pet owners widely commend the clinical veterinarians and nursing staff for their technical capability, compassion, and tireless dedication during critical emergencies. Reviewers highlight practitioners like Dr Lillian for providing clear medical explanations and attentive hospitalisation monitoring. A few reviewers voiced dissatisfaction with telephone manner during stressful night triage calls."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Dedicated care for hospitalised pets"
      },
      "text": {
        "en": "Clients report that critically ill, injured, or post-surgical pets receive attentive monitoring and gentle nursing in the clinic's hospitalisation ward. Pet parents appreciate that staff keep animals comfortable, hydrated, and calm during long stays. Owners express deep gratitude for lifesaving treatments that helped beloved dogs and cats pull through severe medical crises."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Emergency triage and waiting times"
      },
      "text": {
        "en": "As a central London emergency hospital operating around the clock, the clinic prioritises life-threatening cases much like a human emergency department. Many clients appreciate rapid intake when pets require immediate life-saving stabilization. However, reviewers with less critical conditions note that waiting times can extend to several hours during peak emergency shifts."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is Elizabeth Street Veterinary Clinic open 24 hours a day?"
      },
      "a": {
        "en": "Yes, the Belgravia hospital provides 24-hour emergency veterinary care and staffed in-patient hospitalisation every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the clinic prioritise emergency cases and waiting times?"
      },
      "a": {
        "en": "The hospital operates an emergency triage system where critical emergencies receive immediate care, which can cause waits for stable cases during busy periods."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What diagnostic and surgical facilities are available on-site?"
      },
      "a": {
        "en": "The facility features in-house digital radiography, diagnostic ultrasound, dedicated surgical suites, and intensive care wards."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "How do pet owners view the clinic's treatment fees?"
      },
      "a": {
        "en": "Clients value the lifesaving medical expertise available round the clock, while noting that emergency examinations and advanced diagnostic scans represent significant financial investments."
      },
      "basis": "reviews"
    }
  ],
