    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Compassionate veterinary doctors and nurses"
      },
      "text": {
        "en": "Pet owners frequently highlight veterinarians like Dr Marek, Louie, and Alessandro alongside nurses Becky and Charlene for their compassion, dedication, and clinical expertise. While a couple of reviewers found the reception team brusque or hurried, most clients feel deeply supported during visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Careful attention for kittens and dogs"
      },
      "text": {
        "en": "Reviewers emphasize how gently puppies, cats, and rescue pets are handled across consultations, vaccinations, and specialised BOAS surgeries. Owners appreciate that clinical staff take time to soothe nervous animals, ensuring that pets remain calm and comfortable throughout treatments and post-op recovery."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 9,
      "title": {
        "en": "Informative advice with occasional gaps"
      },
      "text": {
        "en": "Several clients praise the practice for clear procedure explanations, helpful health tips, and proactive post-surgery phone check-ins. In contrast, other reviewers experienced communication difficulties, pointing out confusing quotes for non-requested dental work, dismissive booking advice, or language barriers."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic perform specialised soft-tissue surgeries?"
      },
      "a": {
        "en": "Yes, reviewers note successful outcomes for complex procedures, including BOAS airway surgery for brachycephalic dogs and dental extractions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can Poplar Vets assist with pet insurance claims?"
      },
      "a": {
        "en": "Pet owners mention that clinic nursing staff actively assist with filing insurance claims and resolving paperwork issues with insurers."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How quickly can urgent or short-notice appointments be booked?"
      },
      "a": {
        "en": "Clients report securing last-minute appointments and timely vaccinations when pets faced urgent deadlines or sudden health issues."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where does the clinic coordinate out-of-hours care?"
      },
      "a": {
        "en": "Poplar Vets operates as a day practice, with out-of-hours emergency care provided through partner veterinary facilities like Veteris."
      },
      "basis": "both"
    }
