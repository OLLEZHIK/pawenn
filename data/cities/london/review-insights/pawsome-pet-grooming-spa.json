    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Attentive and welcoming grooming staff"
      },
      "text": {
        "en": "Pet owners warmly commend groomers Paige, Nina, and the wider salon team for their friendly approach and professional skill. Clients note that stylists listen closely to specific haircut requests, explain procedures clearly, and go out of their way to make pets feel welcomed with treats and thoughtful goodie bags."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Low-stress care for nervous pets"
      },
      "text": {
        "en": "Reviewers emphasize how comfortably anxious dogs, young puppies, and senior cats settle during their visits to Harbord Square. Owners appreciate that groomers take time before appointments to help nervous pets adjust, adapting handling techniques so that animals remain calm, happy, and relaxed throughout their session."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Precise styling and coat conditioning"
      },
      "text": {
        "en": "Clients frequently rave about the transformation of their pets' coats, describing fresh-smelling, neatly trimmed dogs and cats with silky fur. While one customer reported a clipped quick and uneven drying, the overwhelming majority praise the team for thorough de-shedding, neat breed-specific cuts, and tidy nail trims."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do the groomers cater to senior and nervous pets?"
      },
      "a": {
        "en": "Yes, clients frequently note that stylists take time to settle anxious dogs and adapt treatments for senior animals."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What services are provided for cats at the salon?"
      },
      "a": {
        "en": "The spa offers dedicated feline grooming, including coat brushing, wet baths, nail trimming, and hygiene clipping."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are special puppy introductory sessions available?"
      },
      "a": {
        "en": "Yes, the salon offers gentle introductory grooming sessions designed to help young puppies acclimatise to grooming."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is there a waiting area for dogs at the Canary Wharf branch?"
      },
      "a": {
        "en": "Yes, reviewers mention a comfortable waiting section and play area where pets can relax after their grooming appointment."
      },
      "basis": "reviews"
