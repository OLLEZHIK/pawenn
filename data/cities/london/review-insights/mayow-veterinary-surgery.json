  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "en": "Compassionate vets and friendly nurses"
      },
      "text": {
        "en": "Clients speak warmly of veterinarians and veterinary nurses including Grace, Vanessa, and Emma. Reviewers praise their gentle bedside manner, thorough medical explanations, and willingness to listen. While a few clients noted occasional reception delays or curt desk communication during busy hours, overall trust in the clinical personnel remains exceptionally high."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Gentle handling for cats and dogs"
      },
      "text": {
        "en": "Pet owners consistently highlight the sensitive, reassuring care given to anxious, elderly, and poorly animals. Reviewers describe clinicians examining nervous dogs on the floor to keep them calm, taking extra time with blind rescue cats, and accommodating urgent emergency cases promptly to protect animal welfare."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Effective treatments and surgical care"
      },
      "text": {
        "en": "Reviewers report positive medical outcomes across routine preventative treatments and complex interventions. Clients praise successful lap spays, dental cleanings, nail infections treated promptly, and effective long-term disease management, noting that pets recover comfortably following their procedures."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Mayow Veterinary Surgery treat out-of-hours emergencies?"
      },
      "a": {
        "en": "Emergency care and night admissions are handled in close collaboration with the 24-hour hospital in Streatham Hill."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are consultations available on weekends?"
      },
      "a": {
        "en": "Yes, the clinic operates seven days a week, offering regular appointment slots on Saturdays and Sundays."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What surgical and diagnostic procedures are performed?"
      },
      "a": {
        "en": "Services include laparoscopic spays, routine neutering, dental hygiene treatments, ultrasound, and digital radiography."
      },
      "basis": "both"
    }
  ],
