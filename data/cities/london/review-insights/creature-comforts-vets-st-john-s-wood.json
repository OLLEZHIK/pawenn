  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 75,
      "title": {
        "en": "Compassionate doctors and friendly front desk"
      },
      "text": {
        "en": "Clients overwhelmingly praise Dr Russell and the clinic staff for their thorough explanations, empathetic approach, and warm reception. Although most visitors report a flawless customer journey, isolated complaints noted frustration with front-desk chat support or diagnostic costs."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "en": "Relaxing environment for visiting pets"
      },
      "text": {
        "en": "Pet parents highlight how comfortable dogs and cats remain during routine examinations and vaccinations. Reviewers appreciate that veterinary teams offer generous treats, speak soothingly to timid animals, and handle routine health checks with careful and unhurried attention."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Boutique clinic setting and pristine suites"
      },
      "text": {
        "en": "Reviewers frequently praise the aesthetic, spotless cleanliness, and peaceful layout of the St John's Wood premises. Clients compare the reception area to a calm lounge rather than a conventional clinical surgery, noting it makes veterinary visits far less daunting for their pets."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the membership model work?"
      },
      "a": {
        "en": "Clients frequently mention joining the clinic membership, which includes routine consultations and health monitoring."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How quickly can appointments be scheduled?"
      },
      "a": {
        "en": "Reviewers report fast booking via the clinic app, with convenient same-day and next-day availability."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is the clinic suitable for nervous dogs and cats?"
      },
      "a": {
        "en": "Yes, many reviewers highlight the quiet waiting area and gentle handling that helps anxious pets stay calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where is the St John's Wood practice located?"
      },
      "a": {
        "en": "The clinic is situated on St John's Wood High Street, close to Regent's Park and local underground stations."
      },
      "basis": "both"
    }
