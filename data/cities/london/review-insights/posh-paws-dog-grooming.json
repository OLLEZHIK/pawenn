  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Quality styling and fresh coats"
      },
      "text": {
        "en": "Reviewers consistently praise the finished grooming results, noting that dogs return looking neat, soft, and smelling fresh without overpowering artificial perfumes. Pet owners of wire-haired dachshunds, bichons, and cavapoos frequently highlight stylish scissoring, tidy nail work, and immaculate face trims."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Patient and attentive grooming staff"
      },
      "text": {
        "en": "Clients describe groomers Anthony, Ahmed, and the parlour team as warm, polite, and genuinely knowledgeable about canine body language. Pet owners appreciate staff who take detailed styling notes at drop-off, listen to specific owner preferences, and accommodate last-minute scheduling requests whenever possible."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Gentle handling for dogs and puppies"
      },
      "text": {
        "en": "Pet parents highlight the compassionate care given to anxious puppies having their first groom as well as older senior dogs needing extra support. Clients report that pets who normally dislike bathing or clipping feel at ease, with multiple owners noting their dogs eagerly run toward the entrance on arrival."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the parlour groom nervous or anxious dogs?"
      },
      "a": {
        "en": "Yes, reviewers note that groomers work patiently with nervous dogs and vocal puppies, using calm techniques to keep pets relaxed throughout the session."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can the team accommodate last-minute grooming bookings?"
      },
      "a": {
        "en": "Clients report being fitted in on short notice when urgent grooming was required, though one reviewer noted an occasional scheduling mix-up."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What services are included in a full groom?"
      },
      "a": {
        "en": "Full grooms typically include warm hydrobath bathing, coat conditioning, breed styling, blow drying, nail clipping, and gentle ear cleaning."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Where is Posh Paws Dog Grooming situated?"
      },
      "a": {
        "en": "The salon is located on St John's Hill in Wandsworth, a short walk from Clapham Junction station."
      },
      "basis": "both"
    }
  ],
