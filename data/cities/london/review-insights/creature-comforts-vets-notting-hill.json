  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 75,
      "title": {
        "en": "Attentive and reassuring veterinary team"
      },
      "text": {
        "en": "Pet parents highlight the professionalism, warmth, and genuine kindness displayed by the veterinarians and nursing staff on Westbourne Grove. Reviewers consistently praise clinicians for their thorough examinations, calm bedside manner, and willingness to answer questions comprehensively. Clients note that the team treats both animals and their guardians with patience and respect."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "en": "Gentle care for visiting animals"
      },
      "text": {
        "en": "Clients frequently note how relaxed their dogs and cats feel throughout check-ups and routine procedures. Veterinarians take time to build trust with treats and soothing interaction before conducting physical exams or administering vaccinations. Pet owners with nervous or sensitive animals appreciate the unhurried approach and careful handling."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Clear explanations and attentive communication"
      },
      "text": {
        "en": "Reviewers emphasize the clarity and transparency of communication from the clinical team. Vets explain diagnosis options, treatment rationales, and preventative recommendations in easy-to-understand terms. Clients also appreciate timely follow-up messages and detailed post-consultation care summaries provided through the clinic's digital channels."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do clients rate the veterinary team at Notting Hill?"
      },
      "a": {
        "en": "Pet owners consistently commend the veterinarians and receptionists for their friendly demeanour, thorough examinations, and clear guidance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What is the consulting room environment like for pets?"
      },
      "a": {
        "en": "The Westbourne Grove clinic is modern, clean, and unhurried, with veterinarians taking time on the floor with treats to keep pets relaxed."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the practice provide follow-up communication after visits?"
      },
      "a": {
        "en": "Yes, reviewers appreciate clear aftercare instructions, digital consultation summaries, and responsive follow-up communication."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Which veterinary services are available at this location?"
      },
      "a": {
        "en": "Services include general health consultations, vaccinations, microchipping, routine dental treatments, diagnostic ultrasound, and surgery."
      },
      "basis": "both"
    }
  ],
