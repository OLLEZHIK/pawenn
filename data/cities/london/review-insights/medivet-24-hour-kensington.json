      "title": {
        "en": "Supportive clinicians and nursing team"
      },
      "text": {
        "en": "Pet owners consistently commend the veterinarians and veterinary nurses for their empathy, dedication, and clear guidance during stressful emergency visits. While several reviewers expressed frustration over phone triage and reception interactions, the clinical staff are widely trusted."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Compassionate bedside attention for pets"
      },
      "text": {
        "en": "Clients frequently remark on the kind, calm, and gentle way hospital staff handle dogs, cats, and even wildlife in distress. Pet parents note that nervous or injured animals are kept comfortable and settled during overnight observation in dedicated hospital wards."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Rapid emergency response and diagnosis"
      },
      "text": {
        "en": "Owners praise the round-the-clock emergency team for prompt medical intervention, advanced diagnostics, and complex surgical care. Numerous reviewers share that the hospital's swift treatment saved their pets' lives during acute late-night crises and accidents."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is Medivet 24 Hour Kensington open for emergencies at night?"
      },
      "a": {
        "en": "Yes, the hospital operates 24 hours a day, 7 days a week, with veterinary surgeons and nurses permanently on site."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What diagnostic equipment is available on site?"
      },
      "a": {
        "en": "The facility is equipped with advanced diagnostic tools including CT imaging, digital x-ray, ultrasound, and an in-house laboratory."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are emergency appointments seen immediately upon arrival?"
      },
      "a": {
        "en": "Emergency cases are prioritised according to clinical urgency, with critical trauma and resuscitation receiving immediate attention."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pets stay overnight for observation?"
      },
      "a": {
        "en": "Yes, the practice features continuous hospitalisation facilities where patients receive monitoring and nursing care throughout the night."
      },
      "basis": "both"
    }
