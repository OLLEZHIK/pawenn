    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Gentle grooming for nervous pets"
      },
      "text": {
        "en": "Pet parents consistently praise how calmly dogs and cats are handled during styling sessions in Muswell Hill. Reviewers with anxious, excitable, or fear-aggressive dogs emphasize that groomers Edina and Ema show exceptional patience and gentle technique. Cat owners also report smooth experiences with long-haired felines who normally find professional grooming stressful."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "High-quality cuts and clean styling"
      },
      "text": {
        "en": "Reviewers are delighted with the standard of grooming, noting that dogs and cats return looking immaculate, well-brushed, and smelling clean. Clients frequently mention precise breed-standard haircuts, thorough de-shedding, and neat coat trims. Owners of double-coated breeds and long-haired cats express satisfaction with the lasting freshness and tidy appearance of their pets."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Patient and attentive grooming team"
      },
      "text": {
        "en": "Clients describe the team as warm, professional, and dedicated, singling out groomer Edina for her attentive customer service and clear communication. Pet parents appreciate that staff take time to discuss styling preferences, offer helpful coat care tips, and remain flexible when appointments need rescheduling. The welcoming atmosphere encourages regular visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Clique Pet Grooming cater to cats as well as dogs?"
      },
      "a": {
        "en": "Yes, the salon regularly grooms cats, offering brush-outs, hygiene trims, and coat maintenance for long-haired felines."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can the groomers handle nervous or reactive dogs?"
      },
      "a": {
        "en": "Yes, clients frequently note that the staff successfully calm nervous, excitable, and fear-aggressive pets who struggle at other parlours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What styling and hygiene treatments are provided?"
      },
      "a": {
        "en": "The parlour offers full coat styling, clipping, hygiene trims, bath and blow-dry packages, and ultrasonic dental care."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Is appointment rescheduling accommodated flexibly?"
      },
      "a": {
        "en": "Reviewers note that the team is understanding and helpful when owners need to rearrange booking times."
      },
      "basis": "reviews"
    }
