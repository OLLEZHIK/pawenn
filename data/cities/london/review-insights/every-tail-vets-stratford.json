  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "en": "Warm and attentive veterinary team"
      },
      "text": {
        "en": "Pet owners frequently praise the veterinary surgeons and nurses for their friendly, patient, and compassionate approach. Reviewers note that the team explains medical conditions and procedures with great clarity, helping anxious owners feel reassured. While one client felt rushed during a consultation, the vast majority commend the attentive care provided to their pets."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Gentle handling for nervous pets"
      },
      "text": {
        "en": "Clients consistently highlight how gently cats and dogs are handled during examinations, routine vaccinations, and post-surgery checks. Many pet parents appreciate that the team offers treats and creates a calm atmosphere, noting that even nervous animals feel comfortable. Reviewers describe pets that are eager to enter the clinic without fear."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Prompt updates and WhatsApp advice"
      },
      "text": {
        "en": "Reviewers appreciate the clinic dedicated WhatsApp messaging service, describing quick replies to health queries and helpful guidance before visits. Clients note that staff provide thorough explanations regarding treatments, medications, and surgical recovery. Pet owners value the transparent communication and regular updates."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Every Tail Vets Stratford handle urgent pet emergencies?"
      },
      "a": {
        "en": "Yes, clients report that the clinic accommodates same-day emergency appointments and can arrange rapid hospital referrals when required."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How can pet owners contact the clinic for advice?"
      },
      "a": {
        "en": "Pet owners frequently communicate with the practice team via WhatsApp for quick advice, preparation tips, and test updates."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer health plans or memberships?"
      },
      "a": {
        "en": "Yes, clients mention subscribing to a health plan or care club that covers regular visits and routine preventative healthcare."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can owners book veterinary consultations online?"
      },
      "a": {
        "en": "Yes, the practice provides an online booking system that clients describe as convenient and easy to schedule."
