      "title": {
        "en": "Kind reception and dedicated clinicians"
      },
      "text": {
        "en": "Pet parents frequently commend the clinical team at Southwark, offering special praise for veterinary surgeons Dr Giuseppe and nursing staff Audrey and Alex. Reviewers appreciate friendly, attentive consultations, though isolated reviews mention frustrations with staff turnover and corporate policies."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Gentle treatment for diverse companions"
      },
      "text": {
        "en": "Clients report that companion animals receive gentle, reassuring care during appointments. Dogs and cats, including rescue pets and nervous animals, are handled with patience. Owners highlight that staff make visits relaxing by offering praise and treats throughout physical examinations."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "en": "Dependable routine healthcare and vaccinations"
      },
      "text": {
        "en": "Reviewers express strong confidence in standard veterinary interventions, highlighting thorough yearly booster vaccinations, microchipping, and effective treatment plans. Pet owners appreciate clear advice on managing ongoing pet health and reliable follow-up communications."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can travel certificates and pet documentation be arranged?"
      },
      "a": {
        "en": "Yes, the practice issues animal health certificates for travel, though clients advise confirming full certification fees in advance."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does Medivet Southwark provide out-of-hours emergency care?"
      },
      "a": {
        "en": "Emergencies occurring outside normal working hours are redirected to partner 24-hour veterinary centres in the Medivet network."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "What routine preventive treatments are offered?"
      },
      "a": {
        "en": "The practice provides wellness assessments, routine vaccinations, flea and worm preventative therapies, and microchipping."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the clinic support nervous or frightened animals?"
      },
      "a": {
        "en": "Veterinarians and nurses take a patient, calming approach, helping anxious cats and dogs settle comfortably during examinations."
      },
      "basis": "reviews"
    }
