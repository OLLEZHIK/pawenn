  "faq": [
    {
      "q": {
        "en": "What routine services are provided at Medivet Clapham?"
      },
      "a": {
        "en": "The clinic provides regular health checks, booster vaccinations, nail trimming, dental cleaning, microchipping, and routine surgeries."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can the clinic assist with Animal Health Certificates for travel?"
      },
      "a": {
        "en": "Yes, reviewers note that the veterinarians help owners navigate the requirements for EU Animal Health Certificates."
      },
      "basis": "reviews"
    },
