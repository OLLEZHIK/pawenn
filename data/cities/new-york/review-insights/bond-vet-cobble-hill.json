  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 149,
      "title": {
        "en": "Enthusiastic praise for clinic staff"
      },
      "text": {
        "en": "Pet owners consistently celebrate the warm welcome provided by front desk staff, especially receptionist Robert who is named across dozens of reviews. Clinicians such as Dr. Bloomfield receive commendations for their compassionate bedside manner and thorough explanations. Rare criticisms mention isolated administrative friction."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Gentle handling for anxious pets"
      },
      "text": {
        "en": "Clients frequently note how comfortable their nervous dogs and shy cats feel throughout routine examinations and urgent care visits. Attendants provide tasty treats, speak in soothing tones, and allow pets to explore the examination rooms without rush. This gentle approach creates a calm atmosphere that puts pets at ease."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 16,
      "title": {
        "en": "Medical guidance and communication friction"
      },
      "text": {
        "en": "Reviewers highlight transparent discussions regarding treatment options, diagnostic test findings, and preventive care regimens. Veterinarians take time to answer all client questions and follow up via text messages or telephone calls after appointments. Occasional criticisms cite difficulties reaching doctors directly by phone."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Bond Vet Cobble Hill accept walk-in patients?"
      },
      "a": {
        "en": "The clinic primarily schedules appointments online, but clients note same-day urgent care slots are frequently available."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the clinic suitable for nervous or reactive pets?"
      },
      "a": {
        "en": "Yes, pet parents report that the staff uses low-stress handling methods, gentle treats, and unhurried examinations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are detailed price estimates provided before treatment?"
      },
      "a": {
        "en": "Staff members typically present treatment estimates for review, though clients suggest discussing optional tests upfront."
      },
      "basis": "reviews"
    }
  ],
