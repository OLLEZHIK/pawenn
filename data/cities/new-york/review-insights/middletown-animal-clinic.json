    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Praise for welcoming staff and kind doctors"
      },
      "text": {
        "en": "Clients speak highly of the clinic's veterinarians and veterinary assistants, highlighting the attentive care provided by Dr. Anastasiou and the front-desk team. Most pet owners appreciate their patience and warmth, though a few negative reviews cite frustrations with appointment availability during urgent crises."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Gentle and compassionate handling of pets"
      },
      "text": {
        "en": "Reviewers emphasize the gentle bedside manner displayed when examining dogs and cats. Staff members take time to pet, comfort, and reassure nervous animals, creating a calm clinical atmosphere that helps alleviate anxiety for both family pets and their accompanying owners."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Clean facility and comfortable exam spaces"
      },
      "text": {
        "en": "Visitors consistently remark on the neatness, cleanliness, and welcoming environment of the clinic facility. The waiting area and examination rooms are described as well-kept, orderly, and comfortable for pets awaiting wellness checks or medical procedures."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How clean and maintained is the clinic facility?"
      },
      "a": {
        "en": "Clients frequently praise the cleanliness of the clinic, noting spotless examination rooms and a comfortable waiting environment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do staff members handle anxious dogs and cats?"
      },
      "a": {
        "en": "Reviewers report that veterinarians and assistants use gentle handling and patience to help nervous animals feel secure."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are same-day emergency appointments guaranteed?"
      },
      "a": {
        "en": "While many routine visits proceed smoothly, reviewers note that same-day emergency appointments may not always be available if the schedule is fully booked."
      },
      "basis": "reviews"
    }
