  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "en": "Attentive groomers with high loyalty"
      },
      "text": {
        "en": "Clients frequently praise individual groomers such as Olga, Cecily, and Elena for their gentle demeanor and patience with pets. Many pet owners report visiting consistently for years, though an isolated complaint cited a dismissive reception interaction and refusal to serve a bully breed."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Styling cuts with cat disputes"
      },
      "text": {
        "en": "Dog owners express immense satisfaction with precise breed trims, healthy de-shedding treatments, and neat nail and ear maintenance. In contrast, several cat owners reported severe dissatisfaction over unexpected close shaves and unfinished grooming work that failed to justify premium pricing."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Gentle approach for anxious pets"
      },
      "text": {
        "en": "Reviewers emphasize the salon's comfortable handling of fragile seniors, excitable puppies, and pets with aggressive tendencies. Pet parents value the transparent glass viewing window that allows owners to watch treatments, along with a cage-free waiting area where groomed dogs rest peacefully."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can owners watch their pets being groomed?"
      },
      "a": {
        "en": "Yes, clients frequently mention a large glass window that allows owners to observe the grooming area from reception."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are dogs kept in cages after grooming?"
      },
      "a": {
        "en": "Reviewers appreciate that dogs are kept in an open, cage-free waiting area rather than crates while awaiting pickup."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do they groom cats as well as dogs?"
      },
      "a": {
        "en": "Yes, the salon offers cat grooming, although reviews show mixed satisfaction regarding feline haircuts."
      },
      "basis": "reviews"
    }
  ],
