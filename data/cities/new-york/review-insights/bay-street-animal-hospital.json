  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 19,
      "title": {
        "en": "Caring veterinarians beside front desk friction"
      },
      "text": {
        "en": "Clients frequently praise Dr. Caban, Dr. Aanonsen, and the veterinary technicians for compassionate bedside care during routine visits and difficult end-of-life moments. However, multiple visitors report negative experiences at the reception desk, noting long telephone hold times and unwelcoming interactions when checking in."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 4,
      "title": {
        "en": "Complex surgeries alongside difficult outcomes"
      },
      "text": {
        "en": "Pet owners credit the surgical team with life-saving interventions, including successful caesarean deliveries and critical procedures. At the same time, some reviewers express grief and frustration over costly hospital stays where pets could not be saved, emphasizing the emotional difficulty of managing serious chronic illness."
      }
    },
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 3,
      "title": {
        "en": "Inconsistent communication and follow-up support"
      },
      "text": {
        "en": "While some pet parents appreciate texting doctors for quick updates, others report significant communication breakdowns. Reviewers highlight withheld medication renewals over scheduling disagreements and unreturned phone calls when trying to retrieve memorial keepsakes after a pet passed away."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can doctors be reached for emergency consultations?"
      },
      "a": {
        "en": "Reviewers note that doctors can sometimes be reached directly via text message, though the hospital may reach full patient capacity during busy shifts."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital perform surgeries on site?"
      },
      "a": {
        "en": "Yes, clients report successful surgical treatments including caesarean sections and general soft tissue operations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients describe the front desk wait times?"
      },
      "a": {
        "en": "Several pet owners report long telephone hold times and occasional delays at the reception desk during peak hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Bay Street Animal Hospital provide end-of-life care?"
      },
      "a": {
        "en": "Yes, reviewers describe compassionate euthanasia support from the veterinary team, though some note delays in receiving memorial keepsakes afterward."
      },
      "basis": "reviews"
    }
