  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Compassionate emergency veterinary clinicians"
      },
      "text": {
        "en": "Reviewers applaud the emergency medical team in Williamsburg for showing immense empathy during high-stress medical crises. Clinicians like Dr. France and attentive triage nurses are commended for reassuring distressed owners while caring for sick animals. A few negative accounts cite moments of communication strain when busy."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 9,
      "title": {
        "en": "Open facility updates and communication gaps"
      },
      "text": {
        "en": "Many pet owners appreciate the clinic's open floor layout where medical teams provide ongoing bedside updates. However, several reviewers experienced inconsistent communication regarding laboratory test turnarounds or discharge instructions. Clearer follow-up after complex emergency procedures remains a common client request."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 11,
      "title": {
        "en": "Extended triage delays during peak hours"
      },
      "text": {
        "en": "Visiting pet parents note that waiting times can fluctuate significantly depending on incoming emergency cases. Several clients report waiting between two and four hours before their pets could be examined by an attending emergency clinician. In contrast, critical patients in life-threatening distress are stabilized immediately."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do I need an appointment for emergency care at VEG Williamsburg?"
      },
      "a": {
        "en": "No appointment is needed; VEG operates 24/7 as an open-admission emergency animal hospital for walk-in emergencies."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Can pet parents remain with their pets during treatment?"
      },
      "a": {
        "en": "Yes, reviewers highlight the open-concept layout that permits owners to stay right beside their animals during examinations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the emergency triage process work?"
      },
      "a": {
        "en": "Critical cases are prioritized immediately upon arrival, while stable pets may experience longer waits during busy shifts."
      },
      "basis": "reviews"
    }
  ],
