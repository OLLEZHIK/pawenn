  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 28,
      "title": {
        "en": "Caring veterinarians amid front-desk friction"
      },
      "text": {
        "en": "Veterinarians including Dr. Lotus, Dr. Ibrahim, and Dr. Benson earn strong praise for gentle bedside manners, thorough exams, and patient dedication. Conversely, several clients report significant friction with reception staff, describing argumentative attitudes, rigid cancellation policies, and poor empathy during urgent check-ins."
      }
    },
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 16,
      "title": {
        "en": "Prescription errors and follow-up lapses"
      },
      "text": {
        "en": "Communication is a primary source of negative feedback among reviewers. Multiple pet owners cite prescription format errors, unreturned calls for laboratory diagnostics, and inaccurate external emergency referrals. Clients also mention difficulties coordinating medications through external pet pharmacies."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 10,
      "title": {
        "en": "Disputes regarding unexpected fees"
      },
      "text": {
        "en": "Billing and fees draw consistent criticism from dissatisfied visitors. Reviewers describe unexpected charges for duplicated testing, expensive replacement medications caused by prescription errors, and steep surgery estimates. While some note reasonable wellness fees, cost transparency remains a concern."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic accommodate emergency or urgent visits?"
      },
      "a": {
        "en": "Reviewers indicate the clinic accommodates urgent situations during open hours, though some note strict arrival cutoffs and recommend calling ahead."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are prescriptions handled by the office?"
      },
      "a": {
        "en": "The practice features an in-house pharmacy for medications, though several clients report complications when transferring prescriptions to outside mail-order pharmacies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is parking readily available near the facility?"
      },
      "a": {
        "en": "Clients mention that finding street parking near the Flushing clinic location is relatively easy."
      },
      "basis": "reviews"
    }
