  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "en": "Widespread praise for attentive veterinary team"
      },
      "text": {
        "en": "Clients express immense loyalty to the veterinary team, warmly commending Dr. Mike, Dr. McCarthy, Dr. Kelly, and Dr. Roemmelt. Pet parents appreciate thorough thirty-minute visits, gentle technician handling, and an honest approach free of aggressive upselling. Many families have trusted the clinic with multiple generations of pets across decades."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 10,
      "title": {
        "en": "Responsive updates and clear guidance"
      },
      "text": {
        "en": "Pet parents regularly appreciate the transparent communication offered by doctors and office staff. Reviewers note prompt responses to text inquiries, clear diagnostic explanations, and follow-up telephone calls with laboratory findings. Clinicians take time to explain options thoroughly without rushing appointments."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 8,
      "title": {
        "en": "Strict capacity limits for new clients"
      },
      "text": {
        "en": "The hospital high popularity has created significant capacity constraints. Multiple reviewers express deep frustration after being turned away due to closed new-patient registration. Established clients also note a strict punctuality policy requiring rescheduling if owners arrive more than fifteen minutes late for appointments."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is the clinic currently accepting new pet patients?"
      },
      "a": {
        "en": "Recent reviews indicate the practice frequently caps new patient registration due to high demand and staffing capacity."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the clinic handle scheduling and punctuality?"
      },
      "a": {
        "en": "Appointments run on time, and clients note the practice enforces a strict fifteen-minute arrival policy before rescheduling."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can established clients communicate with staff by text?"
      },
      "a": {
        "en": "Yes, pet owners report convenient two-way text messaging with the front desk for quick questions and scheduling."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What medical services are provided at the hospital?"
      },
      "a": {
        "en": "The hospital offers wellness exams, routine vaccinations, dental cleanings, soft-tissue surgery, and chronic disease management."
      },
      "basis": "both"
    }
  ],
