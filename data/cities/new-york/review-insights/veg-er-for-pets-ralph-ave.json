  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 126,
      "title": {
        "en": "Compassionate bedside manner during emergencies"
      },
      "text": {
        "en": "Pet parents across Brooklyn consistently commend the dedicated clinicians and technicians at this Ralph Avenue hospital. Attending veterinarians such as Dr. Cale receive widespread praise for their patience and gentle guidance during stressful health emergencies. A few critical reviews cite occasional perceived lapses in urgency."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 53,
      "title": {
        "en": "Transparent triage discussions and updates"
      },
      "text": {
        "en": "Reviewers emphasize the open hospital floor where families receive direct updates on diagnostics and ongoing medical interventions. Clinicians explain medical options clearly and walk owners through realistic expectations for emergency stabilization. Clients appreciate phone updates when their pets must remain hospitalized."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "en": "Stress-reducing care for hospitalized animals"
      },
      "text": {
        "en": "The facility is praised for its pet-friendly environment that keeps companion animals comfortable during medical emergencies. Veterinary nurses regularly provide cuddles, soothing blankets, and close monitoring to keep patients calm throughout treatment. Owners appreciate being allowed to stay directly beside their pets during exams."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is VEG Ralph Avenue open 24 hours every day?"
      },
      "a": {
        "en": "Yes, the hospital is open 24/7 every day of the year for emergency and urgent veterinary admissions without appointment."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Are clients allowed to stay with their pets in triage?"
      },
      "a": {
        "en": "Yes, reviewers highlight the open hospital setup that lets pet parents stay beside their animals throughout care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does payment work for emergency interventions?"
      },
      "a": {
        "en": "Staff members provide a cost estimate before procedures, collect a deposit, and refund any unused balance upon discharge."
      },
      "basis": "reviews"
    }
  ],
