  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Dedicated veterinarians with multi-decade client loyalty"
      },
      "text": {
        "en": "The practice enjoys long-standing trust from Upper West Side residents, with many clients having visited doctors like Dr. Cantor and Dr. Smith for decades. Reviewers praise the veterinary team for their diagnostic thoroughness and warmth. A few negative accounts cite unhelpful or abrupt phone interactions with front-desk staff."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Reliable diagnostic medicine and surgical recovery"
      },
      "text": {
        "en": "Most pet owners describe successful health outcomes, noting prompt recovery from acute illnesses, well-managed chronic conditions, and effective surgical care. Diagnostic testing is commonly described as thoughtful and sequential, though isolated reviews express distress over unresolved symptoms or misdiagnoses."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Gentle attentiveness for dogs and cats"
      },
      "text": {
        "en": "Reviewers emphasize the compassionate bedside care provided to both felines and canines across routine appointments and emergency visits. Doctors take extra time to calm nervous rescue dogs and fragile elderly cats, ensuring physical evaluations remain stress-free and animals feel secure throughout their clinical examinations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pets receive ultrasound imaging at Westside Veterinary Center?"
      },
      "a": {
        "en": "Yes, the clinic has ultrasound equipment and veterinary radiologists, though specialized scans require advance scheduling."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are surgical and routine care costs viewed by clients?"
      },
      "a": {
        "en": "Clients note that medical fees are on the higher end for Manhattan, advising pet parents to ask for written estimates prior to procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer extended operating hours?"
      },
      "a": {
        "en": "The facility operates into the evening on weekdays, accommodating working pet owners, though appointments are required."
      },
      "basis": "reviews"
    }
  ],
