  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "en": "Caring veterinary doctors and supportive reception"
      },
      "text": {
        "en": "Pet owners praise the warmth, attentiveness, and clinical professionalism demonstrated by the veterinarians and receptionists. Clients highlight their reassuring demeanor during stressful visits, though isolated reviews express frustration with perceived aloofness or bureaucratic friction when requesting records."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Gentle and patient handling for dogs and cats"
      },
      "text": {
        "en": "Reviewers consistently describe how comfortably their dogs and cats are handled during routine health checks and medical treatments. The clinical team takes time to soothe nervous animals, offering patient encouragement and gentle care that helps pets stay calm in the clinic's exam rooms."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Clear consultations and detailed treatment guidance"
      },
      "text": {
        "en": "Communication generally receives positive ratings from clients, who appreciate doctors taking time to explain diagnoses, outline preventative care, and answer questions thoroughly. A small number of owners, however, report occasional difficulties transferring pet records or obtaining medication refills."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do veterinarians interact with nervous pets?"
      },
      "a": {
        "en": "Clients report that veterinarians and veterinary assistants handle anxious animals with patience, gentle restraint, and soothing care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are examination details explained to pet owners?"
      },
      "a": {
        "en": "Reviewers confirm that doctors explain diagnoses and preventative treatment options clearly during visits and answer owner questions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pet medical records be easily transferred?"
      },
      "a": {
        "en": "Most clients report seamless administrative support, though strict verification policies may apply when requesting records under different names."
      },
      "basis": "reviews"
    }
  ],
