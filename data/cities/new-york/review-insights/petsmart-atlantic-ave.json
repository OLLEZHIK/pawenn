  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 39,
      "title": {
        "en": "Dedicated floor team facing customer critiques"
      },
      "text": {
        "en": "Numerous shoppers celebrate individual associates, particularly cashier Devine and helpful floor clerks, for their cheerful demeanor and patient assistance. Regular patrons appreciate staff who help carry heavy supplies and guide product choices. However, other reviewers cite instances of unhelpful staff and unprofessional remarks on the retail floor."
      }
    },
    {
      "topic": "place",
      "sentiment": "mixed",
      "mentions": 8,
      "title": {
        "en": "Convenient location with difficult parking"
      },
      "text": {
        "en": "The Boerum Hill superstore provides an organized layout and extensive selection of pet foods, cages, and accessories. While shoppers appreciate store cleanliness and consistent product availability, parking represents a significant challenge. Visitors frequently report having to rely on expensive commercial garages due to congested street parking."
      }
    },
    {
      "topic": "animals",
      "sentiment": "negative",
      "mentions": 7,
      "title": {
        "en": "Critiques regarding pet grooming handling"
      },
      "text": {
        "en": "Feedback concerning pet services and live animals reveals notable customer anxiety. Several pet parents express dissatisfaction with the grooming salon, citing severe haircuts, communication breakdowns regarding pet vaccination requirements, and concerns over fish department maintenance following losses of purchased aquatic pets."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is parking available at the Atlantic Avenue store?"
      },
      "a": {
        "en": "Dedicated customer parking is not provided, and street parking in Boerum Hill is limited, leading many drivers to use paid garages."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does this location have an on-site grooming salon?"
      },
      "a": {
        "en": "Yes, the store operates a grooming salon for dogs, though owners advise confirming specific grooming styling instructions in advance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are cat adoption services offered in store?"
      },
      "a": {
        "en": "Yes, the store partners with local rescue groups to host cat adoption areas inside the facility."
      },
      "basis": "website"
    }
  ],
