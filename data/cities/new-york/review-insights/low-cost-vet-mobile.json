  "cards": [
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 26,
      "title": {
        "en": "Widespread friction in phone communication"
      },
      "text": {
        "en": "A substantial volume of reviews criticizes telephone interactions, reporting abrupt hang-ups, condescending responses, and service refusals when inquiring about availability or pricing. While in-person technicians can be pleasant, remote customer service generates widespread dissatisfaction among prospective and existing clients."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 24,
      "title": {
        "en": "Lengthy lines and outdoor queuing delays"
      },
      "text": {
        "en": "Clients frequently point out that the walk-in, first-come-first-served setup results in substantial waiting times outside the mobile unit, often spanning one to two hours. Reviewers recommend arriving well before listed opening hours or using the dedicated mobile app to reserve slots and minimize street delays."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Affordable rates for routine veterinary care"
      },
      "text": {
        "en": "Pet owners consistently commend the mobile clinic for providing accessible pricing on vaccinations, spay and neuter procedures, and basic diagnostic tests. Multiple clients emphasize that these economical rates enable necessary pet healthcare that would otherwise prove cost-prohibitive elsewhere."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the mobile clinic handle walk-in appointments?"
      },
      "a": {
        "en": "The service operates on a primarily first-come, first-served basis, leading reviewers to strongly suggest arriving early before queues accumulate."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is there an indoor waiting area at the mobile clinic?"
      },
      "a": {
        "en": "No, visits take place at a mobile van or truck on the street, so pet owners wait outdoors regardless of weather conditions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are prices significantly lower than brick-and-mortar clinics?"
      },
      "a": {
        "en": "Yes, reviews widely confirm that standard procedures, vaccinations, and basic blood panels are considerably more affordable than conventional animal hospitals."
      },
      "basis": "reviews"
    }
  ],
