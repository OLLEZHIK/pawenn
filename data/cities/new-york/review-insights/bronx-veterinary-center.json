  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 57,
      "title": {
        "en": "Praise for clinical staff amidst complaints"
      },
      "text": {
        "en": "Pet parents frequently commend veterinary technicians and attending doctors for their gentle touch and patience with nervous animals. Dedicated staff members like technician Hector receive repeated praise for thoughtful guidance during visits. At the same time, numerous reviewers criticize front desk receptionists for curt and dismissive behavior."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 25,
      "title": {
        "en": "Mixed experiences with communication"
      },
      "text": {
        "en": "Clients report varying experiences when communicating with the practice. In examination rooms, clinicians and assistants answer questions clearly and explain medical procedures thoroughly. Conversely, pet owners report significant difficulty reaching the clinic by telephone, noting unreturned voicemails and abrupt disconnections."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 19,
      "title": {
        "en": "Substantial delays and extended waits"
      },
      "text": {
        "en": "Extended waiting times represent a primary source of customer dissatisfaction at the Webster Avenue clinic. Multiple reviewers report waiting two to four hours past their scheduled arrival times before being seen by a veterinarian. Clients note that emergency cases frequently back up regular appointments without advance notice from the reception desk."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are walk-in visits accepted at Bronx Veterinary Center?"
      },
      "a": {
        "en": "While walk-in emergencies are accepted, scheduled appointments often experience lengthy delays due to urgent triage cases."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners request specific veterinary technicians?"
      },
      "a": {
        "en": "Clients frequently highlight positive experiences with specific technicians like Hector, though staffing depends on clinic schedules."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are diagnostic test results communicated?"
      },
      "a": {
        "en": "Results are typically provided by phone, but several reviewers recommend following up proactively if lab updates are delayed."
      },
      "basis": "reviews"
    }
  ],
