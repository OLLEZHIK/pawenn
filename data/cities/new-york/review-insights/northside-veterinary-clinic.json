  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Attentive clinical team in Williamsburg"
      },
      "text": {
        "en": "Clients speak warmly of Dr. Stacy Leiman and the veterinary team, noting thorough examinations, thoughtful medical guidance, and compassionate care for neighborhood pets. Multiple reviews highlight attentive listening from doctors. A small number of reviewers express disappointment, however, citing bedside friction during emergency decisions and end-of-life visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Comforting care for cats and dogs"
      },
      "text": {
        "en": "Pet owners consistently praise the clinic for gentle, patient handling of canine and feline patients, from puppy wellness checks to senior cat acupuncture and pain management. Dogs and cats are described as unusually relaxed during exams, though one reviewer reported distress during a feline intake procedure."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 8,
      "title": {
        "en": "Clear consultations alongside scheduling disputes"
      },
      "text": {
        "en": "Numerous pet parents value clear explanations of medical diagnoses, transparent test assessments, and prompt follow-up calls after clinical visits. In contrast, several clients describe communication breakdowns, including delayed ultrasound reporting and disputes concerning administrative travel certifications."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic offer appointments on schedule?"
      },
      "a": {
        "en": "Most clients report straightforward scheduling and punctual appointments, though specialized diagnostic procedures like ultrasounds can occasionally experience delays."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What services are available for senior companion animals?"
      },
      "a": {
        "en": "Reviewers mention comprehensive geriatric care for aging pets, including pain management, holistic acupuncture, and supportive palliative consultations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are international pet travel health certificates provided?"
      },
      "a": {
        "en": "While travel document appointments are available, clients recommend verifying documentation requirements and associated fees well ahead of departure."
      },
      "basis": "reviews"
    }
  ],
