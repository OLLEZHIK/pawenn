    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 33,
      "title": {
        "en": "Compassionate doctors alongside front-desk friction"
      },
      "text": {
        "en": "Pet owners describe starkly contrasting experiences with hospital personnel. Many clients express heartfelt gratitude to emergency doctors and veterinary nurses for attentive, lifesaving care during critical crises. Conversely, numerous reviewers criticize receptionists for perceived indifference and conflicting communications."
      }
    },
    {
      "topic": "results",
      "sentiment": "negative",
      "mentions": 16,
      "title": {
        "en": "Grave concerns regarding medical emergency outcomes"
      },
      "text": {
        "en": "While several clients credit the emergency team with swift, lifesaving interventions during critical health scares, a substantial number of reviewers report tragic treatment failures. Families describe devastating experiences involving suspected medication overdoses, rapid diagnostic deterioration, and disputed clinical advice."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 11,
      "title": {
        "en": "Severe frustration over emergency medical fees"
      },
      "text": {
        "en": "Billing policies and diagnostic expenses draw substantial criticism from pet parents facing acute emergencies. Reviewers report high upfront examination fees, substantial required deposits, and multi-thousand dollar treatment estimates, leaving many owners feeling financially vulnerable during stressful hospital visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is emergency care available 24/7 at this hospital?"
      },
      "a": {
        "en": "The hospital provides 24-hour emergency care, though clients advise calling ahead as overnight intake may occasionally be restricted by capacity."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are upfront deposits required before emergency treatment?"
      },
      "a": {
        "en": "Yes, reviewers consistently report that substantial deposits are required before diagnostic workups or hospitalizations proceed."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How long should pet owners expect to wait in the ER lobby?"
      },
      "a": {
        "en": "Patients are triaged by medical severity; while critical emergencies are seen immediately, stable pets often wait two to five hours."
      },
      "basis": "reviews"
    }
