  "observed_at": "2026-10-08",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 49,
      "title": {
        "en": "Skilled clinicians with mixed desk feedback"
      },
      "text": {
        "en": "Many pet owners express immense gratitude for the emergency doctors and veterinary nurses at this downtown hospital, highlighting clinicians like Dr. Fuller, Dr. Seltzer, and Dr. Ho for saving critically ill animals late at night. However, several clients report negative experiences during intake, describing front desk staff and certain specialists as dismissive, indifferent, or rushed during stressful emergencies."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 17,
      "title": {
        "en": "Attentive updates alongside coordination gaps"
      },
      "text": {
        "en": "Communication feedback varies significantly among visiting pet owners. Many clients report excellent phone updates while their pets were hospitalized overnight, appreciating clinicians who clearly outlined medical diagnostics and discharge instructions. Conversely, other reviewers experienced phone tag, conflicting information between staff members, and difficulty getting prompt clinical updates."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 11,
      "title": {
        "en": "Lengthy triage waits during emergency visits"
      },
      "text": {
        "en": "Multiple reviewers express frustration over extended waiting times in the emergency lobby, frequently reporting delays between one and three hours before seeing a veterinarian. While critical cases are prioritized through medical triage, owners of vomiting or anxious pets report sitting for hours without updates, leading to distress during urgent visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is BluePearl Downtown open 24/7 for pet emergencies?"
      },
      "a": {
        "en": "Yes, the hospital operates 24 hours a day, 7 days a week, providing emergency veterinary medicine and continuous overnight pet monitoring."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the emergency hospital prioritize incoming patients?"
      },
      "a": {
        "en": "Patients are assessed based on clinical urgency, meaning severe or life-threatening cases are evaluated ahead of stable patients."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do clinicians provide phone updates while pets are hospitalized?"
      },
      "a": {
        "en": "Yes, pet owners frequently report receiving detailed updates and phone check-ins from overnight veterinary staff."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Where is BluePearl Pet Hospital Downtown located?"
      },
      "a": {
        "en": "The facility is located at 1 W 15th Street in Manhattan, near Union Square."
      },
      "basis": "website"
    }
  ],
