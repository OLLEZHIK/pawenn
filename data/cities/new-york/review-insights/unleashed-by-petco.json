  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Helpful retail associates and attentive cashiers"
      },
      "text": {
        "en": "Shoppers consistently praise the store associates on Seventh Avenue for their warm greetings, product guidance, and cheerful demeanor. Employees like Lily receive frequent personal mentions for outstanding assistance. A couple of patrons noted occasional friction at checkout, but overall customer service remains a highlight."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Clean neighborhood aisles and organized shelves"
      },
      "text": {
        "en": "Pet owners appreciate the tidy, well-organized layout of the store, noting that finding dog food, cat treats, and pet accessories is straightforward. Most visitors describe the atmosphere as welcoming and convenient for quick neighborhood shopping, though occasional inventory gaps for specific canned foods are reported."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Catering to local dogs and cats"
      },
      "text": {
        "en": "Pet parents highlight the store's extensive selection of high-quality treats, wholesome kibble, and practical accessories tailored for urban pets. Customers appreciate finding reliable supplies for both puppies and older dogs. An isolated reviewer expressed sadness over a faulty fish tank filter, but overall care for pet needs is well-regarded."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does this Unleashed by Petco location host veterinary clinics?"
      },
      "a": {
        "en": "Yes, pet owners report convenient access to on-site veterinary services, including quick walk-in rabies vaccinations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are online sale prices matched at the physical register?"
      },
      "a": {
        "en": "Shoppers note occasional discrepancies between online promotions and shelf tags, so confirming discounts with cashiers is advised."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What pets are accommodated at this location?"
      },
      "a": {
        "en": "The store primarily stocks food, supplies, and wellness items for dogs and cats, along with basic aquatic and small-pet accessories."
      },
      "basis": "reviews"
    }
