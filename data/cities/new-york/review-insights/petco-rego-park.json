  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 91,
      "title": {
        "en": "Mixed feedback on store associates"
      },
      "text": {
        "en": "Customer reviews on personnel at the Rego Park store vary considerably. Several shoppers praise individual associates like Ethan, Sam, and Myles for helpful guidance and friendly checkout service. However, numerous patrons report encountering unhelpful floor clerks, dismissive attitudes from management, and delays in getting assistance."
      }
    },
    {
      "topic": "place",
      "sentiment": "mixed",
      "mentions": 21,
      "title": {
        "en": "Convenient location with inventory inconsistencies"
      },
      "text": {
        "en": "Shoppers appreciate the convenient Metropolitan Avenue location and on-site parking lot. While visitors enjoy browsing the newly renovated layout and broad retail selection, reviewers frequently note restocking delays, pointing out empty shelves in the cat food section and occasional shortages of feeder insects."
      }
    },
    {
      "topic": "animals",
      "sentiment": "negative",
      "mentions": 17,
      "title": {
        "en": "Concerns regarding pet care and services"
      },
      "text": {
        "en": "Pet owners raise recurring concerns about animal handling and specialty departments. Several reviews cite distressing experiences in the grooming salon, including rejected appointments for matted coats and trimmed eyelashes. Others report disputes over aquarium fish purchases and concerns regarding aquatic stock health."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the Rego Park location have dedicated parking?"
      },
      "a": {
        "en": "Yes, the store features a dedicated customer parking lot on site, making visits by car convenient."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are dog grooming services available at this store?"
      },
      "a": {
        "en": "Yes, full-service dog grooming is offered, though owners recommend confirming appointment terms and coat requirements in advance."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can customers purchase aquarium fish here?"
      },
      "a": {
        "en": "Yes, the aquatics section carries live fish and aquarium supplies, with associates available to answer care questions."
      },
      "basis": "reviews"
    }
  ],
