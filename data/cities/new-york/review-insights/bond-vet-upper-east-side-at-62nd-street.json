  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 76,
      "title": {
        "en": "Attentive veterinarians and supportive nurses"
      },
      "text": {
        "en": "The medical team receives wide acclaim for bedside manner, empathy, and clear explanations during wellness exams and urgent visits. Pet parents praise doctors like Dr. Yu and Dr. Yoon along with nurses for gentle handling. A small number of reviewers felt front-desk staff were inflexible when handling appointment delays."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "en": "Prompt relief and reliable medical diagnostics"
      },
      "text": {
        "en": "Clients report quick and effective medical care for urgent conditions, ear infections, gastrointestinal upset, and routine booster shots. Many owners note that treatments helped pets recover rapidly. In rare instances, owners felt that complex recurring symptoms were not definitively diagnosed during initial consultations."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Clear explanations and responsive follow-up"
      },
      "text": {
        "en": "Clients frequently praise attending veterinarians and nursing staff for explaining treatment plans clearly and following up promptly via phone and text. Pet owners feel well-informed about diagnostic findings, though a few reviewers experienced miscommunications regarding appointment rescheduling or pharmacy requests."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can owners accompany their pets into the treatment area?"
      },
      "a": {
        "en": "Reviewers note that while exams take place in standard consult rooms, specific procedures like vaccinations may take place in clinical back rooms."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer urgent care walk-in appointments?"
      },
      "a": {
        "en": "Yes, walk-in and same-day requests are accepted online, though clients advise monitoring confirmation messages closely to avoid sudden scheduling shifts."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How strict is the late arrival policy?"
      },
      "a": {
        "en": "The clinic enforces a strict 10-minute grace period policy, and reviewers note that arriving past this window may lead to rescheduling."
      },
      "basis": "reviews"
    }
  ],
