  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 80,
      "title": {
        "en": "Empathetic emergency medical team"
      },
      "text": {
        "en": "Visitors overwhelmingly praise the compassionate emergency doctors, nurses, and support staff for providing comforting bedside care during frightening pet crises. Reviewers appreciate the staff's dedication and emotional support, though several critical reviews cite occasional lapses in medical urgency and unhelpful front-desk interactions."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "en": "Open-hospital model keeping owners with pets"
      },
      "text": {
        "en": "Pet owners value the clinic's open-concept setup that allows families to stay directly beside their dogs and cats during emergency assessments and stabilization. Reviewers emphasize how this presence reduces pet fear and panic, with veterinary nurses providing gentle handling and treats throughout acute medical treatments."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "en": "Rapid triage with occasional emergency delays"
      },
      "text": {
        "en": "As a 24/7 emergency hospital, the clinic receives strong marks for swift intake and immediate vital checks upon arrival. Most clients report being seen without delay, though several pet parents during peak hours experienced extended waiting periods while critical cases took priority."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners stay with their animals during emergency care?"
      },
      "a": {
        "en": "Yes, reviewers highlight the open-floor policy where pet parents remain beside their dogs or cats throughout examinations and medical interventions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the emergency facility open overnight?"
      },
      "a": {
        "en": "Reviewers confirm that the Chelsea location operates 24/7, providing round-the-clock emergency intake and urgent care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the hospital prioritize arriving patients?"
      },
      "a": {
        "en": "Emergency staff perform immediate triage upon arrival, prioritizing critical and life-threatening conditions over less urgent health concerns."
      },
      "basis": "reviews"
    }
