  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "en": "Effective paw protection with WagWellies"
      },
      "text": {
        "en": "Dog parents enthusiastically praise the WagWellies line of dog boots for their reliable fit and durability. Reviewers note the shoes stay securely on paws during walks, effectively protecting pads from scorching summer sidewalks, winter snow, and rough terrain. Owners of senior pets also report significant mobility help for paw-dragging injuries."
      }
    },
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "en": "Helpful custom fittings despite desk friction"
      },
      "text": {
        "en": "Many reviewers praise the friendly assistance provided during coat and shoe fittings, noting that team members patiently help size pets properly. In contrast, several shoppers recount unwelcoming encounters with store staff, describing dismissive attitudes at the checkout counter and unanswered telephone customer service inquiries."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 8,
      "title": {
        "en": "Online shopping support and order questions"
      },
      "text": {
        "en": "Customer experiences regarding digital purchasing and remote support reflect a mix of satisfaction and friction. Multiple buyers note helpful guidance through online chat channels when determining proper shoe sizes. However, other reviewers express annoyance with unanswered customer service calls and delays regarding order fulfillment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can dogs try on boots and apparel in the store?"
      },
      "a": {
        "en": "Yes, pet parents can bring their dogs to the Greenwich Village boutique for in-person shoe fittings and custom coat sizing."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can single replacement boots be purchased?"
      },
      "a": {
        "en": "Yes, reviewers highlight the ability to purchase individual replacement WagWellies shoes if a single boot is lost or damaged."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do WagWellies protect paws against extreme weather?"
      },
      "a": {
        "en": "Clients report the booties effectively shield sensitive paw pads against scorching summer pavement and cold winter snow."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What other canine apparel and accessories are sold?"
      },
      "a": {
        "en": "The brand designs signature canvas pet carriers, winter fleece jackets, raincoats, beds, leashes, and collars."
      },
      "basis": "website"
    }
  ],
