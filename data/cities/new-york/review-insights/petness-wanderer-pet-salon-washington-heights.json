  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 61,
      "title": {
        "en": "Gentle attention for companion pets"
      },
      "text": {
        "en": "Dog and cat owners frequently emphasize how lovingly groomers treat their four-legged family members during bath and trim sessions. Many clients with nervous rescue dogs report that the team creates a calming setting with gentle handling, though isolated complaints describe feeling uneasy when dogs socialize openly in the workspace."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Welcoming and accommodating grooming team"
      },
      "text": {
        "en": "Reviewers warmly commend the stylists and receptionists for their attentive communication, polite demeanor, and willingness to adapt to specific requests. Front desk employees are described as friendly and well organized, with the vast majority of visitors reporting dependable and considerate service across multiple visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "High quality grooming cuts and care"
      },
      "text": {
        "en": "Clients consistently celebrate the grooming outcomes, noting neat sanitary trims, soft and fragrant coats, and stylish breed-specific haircuts. Multiple reviews showcase dogs leaving with colorful bandanas and looking exceptionally well cared for, motivating pet parents to return on a regular monthly schedule."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can the salon groom anxious or timid dogs?"
      },
      "a": {
        "en": "Yes, many reviewers highlight that groomers handle anxious dogs with patience and gentle reassurance throughout styling."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do they provide specialized breed cuts and deshedding baths?"
      },
      "a": {
        "en": "Yes, clients note that stylists deliver precise breed trims, thorough brush-outs, and refreshing conditioning treatments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is advance booking required for full grooming packages?"
      },
      "a": {
        "en": "Pet parents recommend booking ahead because weekend slots fill quickly, although quick nail trims can occasionally be accommodated."
      },
      "basis": "reviews"
    }
  ],
