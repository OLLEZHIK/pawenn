  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Patient and caring salon professionals"
      },
      "text": {
        "en": "Reviewers widely commend the salon team for their patience, kindness, and meticulous attention to detail. Clients note that groomers listen attentively to specific styling requests and provide progress photos and video updates. One reviewer especially praised staff integrity when returning overpaid cash."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Fluffy coats and stylish trims"
      },
      "text": {
        "en": "Owners consistently praise the finished grooming results, emphasizing clean, fluffy fur, thorough ear cleaning, and pleasant-smelling coats. Reviewers note expert scissor work on both dogs and cats, including customized lion cuts, teddy bear cuts, and neat summer styling tailored to each breed."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Stress-free care for sensitive pets"
      },
      "text": {
        "en": "Numerous reviews emphasize the calm, soothing environment provided for anxious dogs and easily frightened cats. Owners report that timid pets, including cats usually scared of baths, remain relaxed throughout the session and return home cheerful rather than stressed or exhausted."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do they groom cats as well as dogs?"
      },
      "a": {
        "en": "Yes, reviewers frequently praise their specialized cat grooming services, including baths and lion cuts for long-haired felines."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do they share updates during the grooming session?"
      },
      "a": {
        "en": "Yes, pet parents appreciate that staff members often take photos or send video clips of the pet during grooming."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the grooming area visible to owners?"
      },
      "a": {
        "en": "Reviewers note that the facility features video monitoring and transparent viewing areas so clients feel secure leaving their pets."
      },
      "basis": "reviews"
    }
  ],
