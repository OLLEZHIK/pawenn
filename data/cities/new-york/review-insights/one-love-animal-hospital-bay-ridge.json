  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 65,
      "title": {
        "en": "Caring, attentive staff and vets"
      },
      "text": {
        "en": "An overwhelming majority of reviews highlight the warmth and professionalism of the entire team — from front desk to vet techs to doctors. Dr. Matos and Dr. D'Onofrio receive repeated praise by name for their patience, follow-up calls, and genuine care. Long-term clients spanning years and multiple pets consistently describe One Love as the only vet they trust."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Gentle approach with nervous and senior pets"
      },
      "text": {
        "en": "Owners of anxious dogs, senior cats, and exotic animals like guinea pigs report their pets are handled with calm patience and reassurance. Staff reportedly take time before procedures to let animals settle, which multiple reviewers call out as making a real difference. Dogs and cats that previously disliked vet visits are described as at ease here."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "en": "Clear explanations and transparent pricing"
      },
      "text": {
        "en": "Numerous owners highlight that doctors walk through every step of a visit and explain options without pressure. Several reviewers specifically mention that Dr. Matos follows up by phone even for unexpected issues. Pricing is described as transparent, and email responsiveness earns positive mention from several long-term clients."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does One Love treat exotic pets like guinea pigs?"
      },
      "a": {
        "en": "Yes, multiple reviewers mention bringing guinea pigs and receiving knowledgeable, caring treatment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How quickly can I get an appointment?"
      },
      "a": {
        "en": "Reviewers report same-day or next-day availability for sick visits in several recent reviews."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Will the vet communicate with me during the visit?"
      },
      "a": {
        "en": "Yes — reviewers consistently mention detailed explanations, clear pricing breakdowns, and follow-up calls after appointments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can I be in the room with my pet during the exam?"
      },
      "a": {
        "en": "One reviewer noted that animals are sometimes taken into a separate exam room without the owner; policies may vary by procedure."
      },
      "basis": "reviews"
    }
  ],
