  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Dedicated clinicians throughout critical emergency situations"
      },
      "text": {
        "en": "Pet owners widely commend the clinical staff for their compassionate and dedicated emergency care. Emergency veterinarians like Dr. Walsh, Dr. Pasaturo, and Dr. Flagiello receive frequent praise for thorough examinations and reassuring bedside manner during crises. While a few critical reviews cite encounters with dismissive front-desk personnel, the broad consensus highlights supportive medical professionals."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Rapid stabilization for distressed emergency patients"
      },
      "text": {
        "en": "Clients frequently note the attentive, gentle treatment their pets receive during high-stress emergency visits. Reviewers describe rapid stabilization for critically injured dogs, immediate oxygen therapy for animals in respiratory distress, and careful handling of trauma patients. Pet parents express deep gratitude for clinicians who treat vulnerable animals with genuine warmth and patience."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 14,
      "title": {
        "en": "Triage efficiency alongside non-emergency delays"
      },
      "text": {
        "en": "Wait times draw mixed feedback that reflects the triage nature of emergency veterinary medicine. Clients with life-threatening emergencies report being admitted immediately upon arrival and receiving rapid clinical interventions. However, owners of less critical patients describe waiting between two and five hours in the lobby without clear updates, leading to noticeable frustration during stressful visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How are patients prioritized upon arrival?"
      },
      "a": {
        "en": "Reviews indicate that the clinic operates on medical triage, with life-threatening cases admitted immediately while non-critical patients may experience extended wait times."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are emergency services available 24/7?"
      },
      "a": {
        "en": "Yes, reviewers frequently rely on the hospital for round-the-clock emergency care, weekend crises, and after-hours medical stabilization."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How are treatment costs and diagnostics communicated?"
      },
      "a": {
        "en": "Emergency fees can be substantial, and several reviewers advise requesting an itemized estimate for diagnostic testing and blood work before procedures begin."
      },
      "basis": "reviews"
    }
  ],
