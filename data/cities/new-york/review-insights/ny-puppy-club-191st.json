  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 88,
      "title": {
        "en": "Engaging daycare and puppy socialization"
      },
      "text": {
        "en": "Dog owners frequently praise the lively daycare groups, noting how puppies gain confidence and learn socialization skills in the puppy kindergarten program. Pets consistently come home tired and content after play sessions, though one customer expressed concern regarding daycare room supervision."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 86,
      "title": {
        "en": "Attentive care from groomers and staff"
      },
      "text": {
        "en": "Reviewers emphasize the warm and accommodating attitude across the team, frequently singling out groomers like Su for patient handling during haircuts and baths. Staff are noted for greeting pets by name and communicating clearly with owners, with rare complaints noting occasional aloofness."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 85,
      "title": {
        "en": "Clean facility with live webcam monitoring"
      },
      "text": {
        "en": "Clients appreciate the clean and well-kept boarding suites in Flushing, noting that live video streams allow them to check in on their dogs throughout the day. The facility provides peace of mind for traveling owners, although one reviewer suggested more frequent sanitation sweeps."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can owners watch their dogs during daycare and boarding?"
      },
      "a": {
        "en": "Yes, clients frequently mention using live video webcams to monitor their dogs playing and resting throughout the day."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does NY Puppy Club offer puppy socialization programs?"
      },
      "a": {
        "en": "Yes, reviewers highlight a puppy kindergarten program that helps young dogs socialize safely with other puppies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are grooming services available on site?"
      },
      "a": {
        "en": "Yes, many customers book baths and haircuts with staff groomers during or alongside daycare appointments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do dogs typically act after their stay?"
      },
      "a": {
        "en": "Pet owners consistently note their dogs return home tired, happy, and relaxed after active play sessions."
      },
      "basis": "reviews"
    }
