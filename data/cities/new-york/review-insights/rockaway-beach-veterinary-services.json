  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "en": "Outstanding praise for dedicated veterinary staff"
      },
      "text": {
        "en": "The clinic enjoys overwhelmingly positive reviews celebrating its passionate doctors and technicians, especially Dr. Sarter, Dr. Weinstock, and Dr. Ruggiero. Pet parents describe clinicians who treat pets with personal warmth, sitting on the floor to calm nervous patients. Client support from technicians and receptionists is widely commended."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "en": "Thoughtful accommodations for anxious animals"
      },
      "text": {
        "en": "Pet owners value the clinic gentle, patient approach toward sensitive pets. The team routinely offers treats, minimizes waiting room contact for dog-reactive animals, and creates a relaxed environment. Clients with senior pets and rescue animals note that the gentle handling noticeably reduced their pets customary clinic distress."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Clear explanations and attentive follow-up"
      },
      "text": {
        "en": "Reviewers frequently applaud the thorough communication provided by attending veterinarians. Doctors take time to explain surgical procedures, discuss diagnosis details, and address owner concerns without rushing. Clients also appreciate proactive post-operative phone check-ins from staff to monitor recovery progress at home."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the clinic accommodate nervous or reactive dogs?"
      },
      "a": {
        "en": "Staff clear the waiting area and prepare exam rooms ahead of time to minimize stressful interactions for reactive dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic perform pet surgical and dental procedures?"
      },
      "a": {
        "en": "Yes, the practice performs routine surgeries, dental cleanings under anesthesia, and urgent medical procedures."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the practice offer round-the-clock emergency intake?"
      },
      "a": {
        "en": "The facility operates as a daytime general practice and refers critical emergency trauma to specialized regional hospitals."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are feral and community cats accommodated?"
      },
      "a": {
        "en": "Reviewers note the veterinarians treat community and rescue cats with patience and compassionate clinical care."
      },
      "basis": "reviews"
    }
