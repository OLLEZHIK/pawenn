  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "en": "Attentive boutique and grooming specialists"
      },
      "text": {
        "en": "Groomers Clara and Jenny receive extensive praise for their kind manner, attentive listening, and gentle touch with senior dogs. While a few pet owners report stressful interactions with specific front desk managers regarding drop-off policies, the broad consensus highlights friendly and helpful customer service."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Spotless coats and stylish haircuts"
      },
      "text": {
        "en": "Clients consistently commend the team for restoring matted coats, shaping adorable breed cuts, and using natural shampoos that leave pets fresh. Isolated reviews mention uneven scissoring on a Schnauzer cut, but most owners describe dependable, attractive results that keep them returning regularly."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Comforting care for shy dogs"
      },
      "text": {
        "en": "Pet parents highlight that timid rescues and elderly pets feel comfortable at the salon, entering and leaving without anxiety. Reviewers appreciate that the team handles delicate physical needs patiently, taking time to ensure nervous pets feel calm throughout their styling appointments."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Pet Story NY groom senior and anxious dogs?"
      },
      "a": {
        "en": "Yes, reviewers specifically note that groomers are gentle and accommodating with elderly dogs and shy rescue pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What boutique products are sold on site?"
      },
      "a": {
        "en": "Clients mention finding healthy pet foods, fresh bakery treats, clothing, and natural pet care supplies in the store."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the salon determine grooming prices?"
      },
      "a": {
        "en": "Grooming fees are based on pet size and weight; reviewers recommend confirming the exact fee and coat condition at check-in before service begins."
      },
      "basis": "reviews"
    }
  ],
