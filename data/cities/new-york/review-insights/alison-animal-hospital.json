  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "en": "Attentive, empathetic veterinary care team"
      },
      "text": {
        "en": "Most pet owners praise the doctors, technicians, and front desk staff at this Brooklyn practice for their warmth, patience, and dedication. Practitioners like Dr. Ryan, Dr. Klein, and Dr. Suarez receive frequent compliments for thorough exams and genuine compassion. However, a small number of dissatisfied clients felt that individual interactions were rushed or dismissive during difficult visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Gentle handling for sensitive pets"
      },
      "text": {
        "en": "Reviewers frequently highlight the gentle handling of their pets, particularly senior animals and pets with elevated stress or anxiety. Many clients note that their cats and dogs remain calm during checkups, blood draws, and routine vaccinations. One owner noted extreme handling precautions during a routine visit, but most report that pets are treated with patience and love."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "en": "Responsive emails alongside mixed callbacks"
      },
      "text": {
        "en": "Pet owners generally appreciate the clinic's responsive email communication and clear medical explanations from the veterinarians and office manager. Many clients note that staff take time to answer all questions without rushing. At the same time, a few reviewers report frustrations with delayed callbacks, mixed guidance, or difficulty reaching clinicians about test results and prescriptions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Alison Animal Hospital see anxious or nervous pets?"
      },
      "a": {
        "en": "Yes, reviewers frequently note that the veterinary team is patient and accommodating with anxious dogs and cats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How responsive is the staff to questions and follow-ups?"
      },
      "a": {
        "en": "Clients report that the office manager and team respond promptly to emails, though a few owners noted delays with phone callbacks."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are appointments required to visit the clinic?"
      },
      "a": {
        "en": "Yes, appointments are standard practice, and reviewers mention that popular slots can book up quickly."
      },
      "basis": "both"
    }
  ],
