  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "en": "Attentive clinical team and technicians"
      },
      "text": {
        "en": "Veterinary assistants like Hector and attending clinicians receive widespread praise from pet parents across the Bronx. Reviewers highlight their gentle handling, patience during nervous exams, and thorough answers to medical concerns. Isolated complaints center around occasional curt interactions at the front desk."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 9,
      "title": {
        "en": "Frequent delays despite scheduled appointments"
      },
      "text": {
        "en": "Extended waiting times are a recurring issue for clients visiting this Eastchester Road facility. Several pet owners report waiting between one and three hours past their appointment times before being admitted. Delays are especially common during busy afternoon hours or when urgent emergency cases take priority."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 8,
      "title": {
        "en": "High costs and separate fee assessments"
      },
      "text": {
        "en": "Several pet owners describe unexpected expenses for routine treatments, diagnostics, and surgical procedures. Reviewers note that fees can quickly exceed hundreds of dollars and express frustration with separate billing for each clinical step. Requiring full payment at booking also surprised first-time visitors."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do I need to pay for appointments in advance?"
      },
      "a": {
        "en": "Yes, clients report that payment for the examination is required when scheduling the visit online or over the phone."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How long is the typical wait time at the clinic?"
      },
      "a": {
        "en": "While morning visits often proceed on schedule, reviewers note that afternoon waiting times can stretch to two hours or more."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can I request a specific veterinary technician?"
      },
      "a": {
        "en": "Many clients specifically request technician Hector due to his gentle handling and patient demeanor during checkups."
      },
      "basis": "reviews"
    }
