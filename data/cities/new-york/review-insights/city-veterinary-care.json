  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "en": "Decades of loyal clients trust the whole team"
      },
      "text": {
        "en": "Dr. Kaplan, Dr. Lamb, Dr. Cloudman, and Dr. Khan each receive heartfelt, name-specific praise from clients who have been coming for ten, twenty, and even twenty-five years. Reviewers describe the team as compassionate, unhurried, and genuinely invested in each animal's wellbeing. Several long-term clients credit individual doctors with saving their pets' lives across multiple health crises."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Thorough exams and sound clinical judgment"
      },
      "text": {
        "en": "Owners describe detailed, comprehensive examinations including in-clinic ultrasound, orthopedic evaluations, and surgery — all with clear explanations of findings and next steps. The practice is praised for honest guidance about which procedures are truly necessary. Several clients transferred to City Vet after disappointing chain experiences and describe the quality of care as markedly different."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 6,
      "title": {
        "en": "Easy scheduling with timely appointments"
      },
      "text": {
        "en": "Multiple reviewers highlight that booking is straightforward and that visits begin close to the scheduled time. Tech appointments for routine checks are available without a full vet visit, which clients appreciate for convenience. The clinic's walk-in lobby scale is noted as a practical touch for monitoring weight between formal visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does City Veterinary Care perform in-clinic ultrasound?"
      },
      "a": {
        "en": "Yes, at least one recent reviewer describes a wellness abdominal ultrasound done in-office during the appointment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can I book a tech appointment without seeing a vet?"
      },
      "a": {
        "en": "Yes, reviewers mention tech appointments for weight checks and routine items that don't require a full vet exam."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the practice see rescue animals?"
      },
      "a": {
        "en": "Yes, at least one rescue organization describes the clinic as a reliable resource for cats arriving in urgent or unpredictable condition."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is there a scale available between appointments?"
      },
      "a": {
        "en": "Yes, one reviewer mentions a scale in the lobby that can be used for weight checks outside of scheduled visits."
      },
      "basis": "reviews"
    }
