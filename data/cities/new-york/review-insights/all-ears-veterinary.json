  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "en": "Warm, welcoming team from check-in to discharge"
      },
      "text": {
        "en": "Nearly every reviewer mentions the exceptional care shown by the entire staff — from the front desk through vet techs to the veterinarians. Dr. Kasprow, Dr. Fortier, and Dr. Nieto are praised for deep knowledge, genuine warmth, and clear explanations. Several reviewers describe All Ears as the best vet experience they've had after visiting dozens of practices across New York."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Specialist knowledge for exotic and small animals"
      },
      "text": {
        "en": "Clients bring rabbits, snakes, turtles, and other exotic pets and consistently receive knowledgeable, species-specific care that goes beyond standard veterinary practices. Reviewers note that the team understands husbandry nuances for reptiles and exotics — not just anatomy. Animals are described as visibly at ease during visits, with cats staying in provided beds during check-ups."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Thorough care with same-day follow-up reports"
      },
      "text": {
        "en": "Multiple owners describe receiving detailed written follow-up notes on the same day as the visit, outlining findings and next steps clearly. The practice is praised for taking issues seriously when other vets hadn't, and for conducting complete, comprehensive exams. Transparent pricing and emergency availability add to its reputation for reliable, trustworthy care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does All Ears Veterinary treat exotic animals?"
      },
      "a": {
        "en": "Yes, the practice has treated rabbits, snakes, turtles, and other exotic species with knowledgeable, species-specific care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is there a new-client discount?"
      },
      "a": {
        "en": "Several reviewers mention a $50 discount applied to the first visit."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does All Ears provide follow-up care notes after appointments?"
      },
      "a": {
        "en": "Yes, multiple owners mention receiving detailed written follow-up reports on the same day as the visit."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are nervous cats and dogs handled?"
      },
      "a": {
        "en": "Reviewers describe staff taking time to let animals settle before exams and using calm, patient handling throughout."
      },
      "basis": "reviews"
    }
