  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Attentive and patient grooming team"
      },
      "text": {
        "en": "Reviewers consistently applaud the grooming crew for their warm attitude, personal attention, and years of reliable service in the neighborhood. Long-time clients frequently highlight how welcome their dogs feel upon arrival. A few negative comments note frustrations with staff accountability during scheduling delays or uneven haircut results, but most clients praise their dedication."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Fresh cuts and fragrant coats"
      },
      "text": {
        "en": "Clients frequently report that their dogs return home looking handsome, properly bathed, and smelling pleasant. Owners praise neat scissor work, stylish breed-specific trims, and effective de-matting. A few reviewers expressed frustration over occasional incorrect cuts, such as unintended close buzzes, but overall customer feedback about grooming outcomes remains strongly positive."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "en": "Gentle handling for anxious pets"
      },
      "text": {
        "en": "Numerous pet owners highlight the calm, gentle approach used with puppies, senior companions, and anxious dogs. Many observe that nervous pets relax quickly in the hands of the groomers and return without stress. One feline owner reported difficulty when a cat arrived heavily matted, but dog owners overwhelmingly describe a caring, low-stress environment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Zen Animals accommodate same-day appointments?"
      },
      "a": {
        "en": "Yes, reviewers note that the salon sometimes accepts short-notice or same-day grooming appointments, though advance booking is recommended."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do they work with anxious or sensitive dogs?"
      },
      "a": {
        "en": "Reviewers frequently praise the groomers for their patience and gentle handling with nervous pups, senior pets, and first-time visitors."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do they offer services for cats as well as dogs?"
      },
      "a": {
        "en": "While cat grooming has been attempted, feedback indicates the salon primarily specializes in dogs and may decline severely matted cats."
      },
      "basis": "reviews"
    }
  ],
