  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Praise for compassionate medical teams"
      },
      "text": {
        "en": "Pet parents widely commend the medical and support staff for maintaining calm, empathetic care during high-stress visits. Reviewers highlight dedicated veterinary technicians, responsive front-desk staff, and thoughtful specialists in neurology and oncology. Clients note feeling thoroughly supported when navigating complex medical decisions."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Effective treatments for acute emergencies"
      },
      "text": {
        "en": "Reviewers report successful medical interventions for severe emergencies, including toxin ingestions, emergency surgeries, seizure management, and acute urinary issues. Pet owners praise the hospital intensive inpatient care and diagnostic capabilities, although occasional clients wished for faster diagnosis during terminal illnesses."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "en": "Varied wait times during emergency intake"
      },
      "text": {
        "en": "Experiences regarding wait times vary widely depending on clinical severity. Pets with acute, critical trauma are ushered immediately into examination rooms without delay. However, pet parents presenting with non-life-threatening ailments frequently report waiting three to four hours during peak evening triage periods."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is emergency veterinary care available twenty-four hours a day?"
      },
      "a": {
        "en": "Yes, the hospital provides continuous twenty-four-hour emergency veterinary intake every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can owners visit pets staying in the intensive care unit?"
      },
      "a": {
        "en": "Clients report that the hospital accommodates daily visitation for pets undergoing multi-day hospital stays."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What specialty veterinary services are offered?"
      },
      "a": {
        "en": "The hospital provides comprehensive specialty departments including neurology, medical oncology, diagnostic imaging, and internal medicine."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Are emergency examination fees required upon arrival?"
      },
      "a": {
        "en": "Reviewers note an initial emergency consultation base fee of around $275, with diagnostic tests and inpatient treatments quoted separately."
      },
      "basis": "reviews"
    }
  ],
