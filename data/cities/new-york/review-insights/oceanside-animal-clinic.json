  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "title": {
        "en": "Warm and attentive veterinary team"
      },
      "text": {
        "en": "Many clients commend Dr. Valentina Anurova and Dr. Vlad Anurov for their dedication, thorough examinations, and bedside manner. Long-term pet owners report feeling treated like family by the doctors, groomer Natasha, and veterinary technicians. The front desk staff, particularly receptionist Francesca, frequently receives praise for remaining compassionate during stressful appointments."
      },
      "mentions": 47
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "title": {
        "en": "Clear explanations and bilingual support"
      },
      "text": {
        "en": "Reviewers highlight that doctors and assistants explain diagnoses and medication instructions step by step without rushing. Clients frequently appreciate having fluent Russian and Spanish speakers available on staff to answer questions. Several owners also note prompt follow-up calls after surgeries and assistance with international travel health certificates."
      },
      "mentions": 13
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "title": {
        "en": "Affordable fees alongside estimate disputes"
      },
      "text": {
        "en": "Numerous reviewers praise the clinic for providing significantly lower rates than neighboring veterinary practices, including emergency payment plans. However, several dissatisfied pet owners criticize the office for declining to provide price estimates over the phone and requiring a sixty-five dollar preliminary exam before quoting dental work or radiographs."
      },
      "mentions": 12
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic offer bilingual service?"
      },
      "a": {
        "en": "Yes, reviewers frequently praise the team for speaking fluent Russian and Spanish alongside English."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can Oceanside Animal Clinic assist with travel certificates?"
      },
      "a": {
        "en": "Yes, clients note that Dr. Anurova helps prepare veterinary documentation for international pet travel."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are same-day emergency appointments accommodated?"
      },
      "a": {
        "en": "Multiple reviewers report that the clinic accepts urgent walk-in cases and has stayed past closing hours on Friday evenings."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can I get price estimates over the phone?"
      },
      "a": {
        "en": "Reviewers report that the clinic generally requires a preliminary clinical examination before quoting diagnostic or surgical costs."
      },
      "basis": "reviews"
    }
  ],
