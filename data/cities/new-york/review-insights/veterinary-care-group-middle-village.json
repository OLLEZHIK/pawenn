  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "en": "Welcoming reception and attentive veterinary doctors"
      },
      "text": {
        "en": "Pet owners consistently highlight the warm professionalism of the staff, noting welcoming front-desk receptionists, thorough technicians, and caring veterinarians. Doctors are praised for their clinical knowledge and unhurried examinations, though isolated negative reviews describe severe dissatisfaction with diagnostic care during complex feline illnesses."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Gentle and affectionate handling of pets"
      },
      "text": {
        "en": "Clients frequently remark on how gently dogs and cats are treated throughout routine exams, vaccinations, and diagnostic visits. Reviewers note that veterinary technicians take time to offer treats and comfort anxious animals, helping pets remain calm and relaxed in the examination rooms."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "en": "Clear explanations and transparent treatment guidance"
      },
      "text": {
        "en": "Pet owners appreciate the clear, detailed guidance provided by veterinarians during appointments. Doctors and staff take time to answer owner questions, discuss treatment options thoroughly, and provide transparent cost estimates without unnecessary upselling."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do veterinarians interact with nervous pets?"
      },
      "a": {
        "en": "Reviewers report that the medical staff and technicians handle nervous pets with patience and gentle affection, often using treats to keep them comfortable."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are treatment costs explained upfront?"
      },
      "a": {
        "en": "Clients note that doctors and staff provide transparent cost explanations and treatment alternatives before proceeding with procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can clients bring both cats and dogs to this clinic?"
      },
      "a": {
        "en": "Yes, reviews describe routine and preventive care visits for both dogs and cats across all age stages."
      },
      "basis": "reviews"
    }
  ],
