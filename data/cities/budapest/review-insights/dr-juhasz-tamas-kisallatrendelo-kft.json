  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 44,
      "title": {
        "hu": "Felkészült orvosok és megosztó ügyfélkezelés",
        "en": "Skilled veterinarians with polarizing reception"
      },
      "text": {
        "hu": "A pozitív visszajelzésekben a gazdik hálájukat fejezik ki az életmentő beavatkozásokat végző tapasztalt állatorvosoknak Budapest 11. kerületében. Ugyanakkor számos éles bírálat érinti a recepció és az asszisztensek modorát az éjszakai ügyeletben, ahol a látogatók empátiahiányt és távolságtartó viselkedést tapasztaltak.",
        "en": "Positive reviews express deep gratitude to dedicated veterinarians performing life-saving emergency surgeries in Budapest's 11th district. However, multiple sharp criticisms highlight the reception and assistant staff during night shifts, where visitors felt communication lacked empathy and adequate understanding."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 27,
      "title": {
        "hu": "Éjjel-nappali ügyelet változó bejutással",
        "en": "Round-the-clock service with variable access"
      },
      "text": {
        "hu": "A gazdik nagy értékként kezelik a 0-24 órás folyamatos nyitvatartást, amely hétvégén és éjszaka is elérhető sürgős esetekben, gyakran azonnali ellátással. Más értékelők viszont hosszadalmas kapuban várakozásról, nehézkes bejutásról és elhúzódó éjszakai várakozási időről panaszkodnak az ügyelet során.",
        "en": "Pet owners value continuous round-the-clock operation, ensuring access to medical facilities on weekends and in the middle of the night with prompt admissions. On the other hand, other reviews report frustrating waits at the clinic gate, delayed entry, and long waiting times before receiving emergency care."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 26,
      "title": {
        "hu": "Sürgősségi sikerek és súlyos bírálatok",
        "en": "Emergency rescues alongside severe concerns"
      },
      "text": {
        "hu": "Számos vélemény dicséri a gyors orvosi beavatkozást mérgezések, komplikált császármetszések és sürgősségi műtétek sikeres elvégzése során. Ezzel szemben több elkeseredett gazdi számol be félrediagnosztizált állapotokról, elmulasztott vizsgálatokról vagy tragikus kimenetelről, ami mélyen megosztja az értékeléseket.",
        "en": "Many clients commend rapid clinical interventions during acute intoxications, emergency caesarean sections, and complex surgical rescues. Conversely, distressed owners report perceived misdiagnoses, missed clinical findings, or tragic outcomes, resulting in deeply divided opinions regarding medical care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "hu": "Milyen ellátást biztosít a Dr. Juhász Tamás Állatkórház éjszaka?",
        "en": "What emergency care does the Juhász Animal Hospital provide at night?"
      },
      "a": {
        "hu": "A kórház 0-24 órás sürgősségi ellátást, intenzív kezelést és bentlakásos kórházi elhelyezést nyújt társállatok számára.",
        "en": "The facility provides 24/7 continuous emergency medicine, intensive therapy, and inpatient hospitalization for companion pets."
      },
      "basis": "both"
    },
    {
      "q": {
        "hu": "Szükséges telefonon egyeztetni az éjszakai érkezés előtt?",
        "en": "Is phone contact recommended prior to arriving at night?"
      },
      "a": {
        "hu": "A vélemények alapján határozottan célszerű előzetesen telefonálni az ügyeletre a gyorsabb bejutás és fogadás érdekében.",
        "en": "Based on reviews, calling the on-call desk prior to arrival is strongly advised to facilitate prompt gate entry and intake."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "hu": "Milyen vizsgálati lehetőségek érhetők el a klinikán?",
        "en": "What diagnostic facilities are available at the clinic?"
      },
      "a": {
        "hu": "A létesítményben digitális röntgen, hasi ultrahang, laboratóriumi vizsgálatok és sebészeti műtők működnek.",
        "en": "The hospital is equipped with digital radiography, abdominal ultrasound, an in-house laboratory, and dedicated operating rooms."
      },
      "basis": "both"
    },
    {
      "q": {
        "hu": "Milyen fizetési módok érhetők el a rendelőben?",
        "en": "What payment methods are accepted at the clinic?"
      },
      "a": {
        "hu": "A rendelőben készpénzes és bankkártyás fizetés is elérhető, de a látogatók javasolják a fizetési feltételek előzetes tisztázását.",
        "en": "Both cash and card payments are accepted, though clients suggest confirming payment arrangements during emergency admissions."
