  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "hu": "Gondos és nagy szakértelmű orvosok",
        "en": "Attentive and highly experienced veterinarians"
      },
      "text": {
        "hu": "A látogatók dicsérik Dr. Varsányi Béla, Dr. Suszter Norbert és a zuglói rendelő orvosainak figyelmes, közvetlen és lelkiismeretes munkáját. Az orvosok és asszisztensek türelmesen válaszolnak minden kérdésre, megnyugtatják a gazdikat, és alapos vizsgálatokat végeznek.",
        "en": "Clients commend Dr. Béla Varsányi, Dr. Norbert Suszter, and the veterinary team in Zugló for their thorough, attentive, and reassuring approach. Practitioners take time to address questions in detail, easing owners' concerns and performing diligent medical evaluations."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "hu": "Kedves és türelmes állatbánásmód",
        "en": "Gentle and patient pet handling"
      },
      "text": {
        "hu": "A vélemények kiemelik, hogy a rendelőben különleges empátiával és szeretettel fordulnak a kutyákhoz, cicákhoz és más kisállatokhoz. Még a kezelések során félénk, remegő vagy nehezebben kezelhető állatokkal is megértően bánnak, így a vizsgálatok zökkenőmentesen zajlanak.",
        "en": "Feedback highlights the gentle empathy and affection shown toward dogs, cats, and small animals at the clinic. Even nervous, trembling, or uncooperative pets are handled with soothing patience, ensuring that vaccinations and physical examinations proceed smoothly."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 6,
      "title": {
        "hu": "Pontos időpontok és gördülékeny behívás",
        "en": "Punctual appointments and smooth intake"
      },
      "text": {
        "hu": "A vendégek nagyra értékelik az előre egyeztetett időpontok pontos betartását a Varsó utcai rendelőben, ami segít elkerülni a hosszú várakozást más állatokkal a váróteremben. Ugyanakkor gyógyszervásárlás esetén akadt panasz a váratlanul megnövekedett várakozási időre.",
        "en": "Clients appreciate the punctual adherence to scheduled appointments on Varsó utca, which prevents stressful waits alongside other pets in the waiting area. However, occasional feedback noted unexpected delays when dropping in to collect prescription medication."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "hu": "Szükséges előzetes időpontfoglalás a vizsgálatokhoz?",
        "en": "Is advance appointment booking required for checkups?"
      },
      "a": {
        "hu": "Igen, a vélemények szerint az előre egyeztetett időpontok segítik a pontos és várakozásmentes ellátást.",
        "en": "Yes, reviews indicate that booking appointments in advance ensures timely care without extended waits."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "hu": "Milyen állatfajokat látnak el a zuglói rendelőben?",
        "en": "What types of companion pets are treated at the Zugló clinic?"
      },
      "a": {
        "hu": "Kutyák és macskák mellett a beszámolók alapján papagájok, hörcsögök és egyéb kisállatok kezelését is vállalják.",
        "en": "Alongside dogs and cats, reviews confirm that birds, hamsters, and other small companion pets receive care."
      },
      "basis": "reviews"
    },
    {
