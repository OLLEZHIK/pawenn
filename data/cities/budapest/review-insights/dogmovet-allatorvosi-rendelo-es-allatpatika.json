  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "hu": "Szakértő orvosok és empátiával teli ellátás",
        "en": "Expert veterinarians and empathetic clinical care"
      },
      "text": {
        "hu": "A gazdik kiemelkedő elismeréssel szólnak Dr. Gunde Éva és Dr. Gyuricza Ákos lelkiismeretes munkájáról. A vélemények dicsérik a részletes magyarázatokat, a türelmes hozzáállást és az asszisztensek kedvességét, bár a recepció stílusát egy-két esetben hűvösnek találták a látogatók.",
        "en": "Pet guardians express high praise for the conscientious care provided by Dr. Éva Gunde and Dr. Ákos Gyuricza. Reviews commend detailed medical explanations, calm patience, and gentle nursing support, although a couple of visitors noted cooler communication at the front desk."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "hu": "Kutyák, macskák és egzotikus állatok kezelése",
        "en": "Care for dogs, cats and exotic species"
      },
      "text": {
        "hu": "A páciensek között kutyák és macskák mellett kaméleonok, tengerimalacok és madarak is rendszeresen megfordulnak a zuglói rendelőben. A gazdák értékelik a stresszmentes vizsgálatokat és a különleges fajok iránti odafigyelést, miközben az érzékenyebb esetek fokozott gondosságot kívánnak.",
        "en": "Alongside dogs and cats, patients at the Zugló practice frequently include chameleons, guinea pigs, and pet birds. Guardians value the calm examinations and clinical interest shown toward exotic companion animals, while delicate cases demand close veterinary attention and follow-up."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "hu": "Sikeres beavatkozások és hétvégi ügyeleti ellátás",
        "en": "Successful interventions and weekend emergency care"
      },
      "text": {
        "hu": "A látogatók beszámolói szerint a klinika megbízható segítséget nyújt sürgős műtétek és hétvégi beavatkozások során, megmentve a sérült kutyákat és macskákat. A gazdák hálásak a gyors beavatkozásért, még ha egyes bonyolult egzotikus kórképek kimenetele szomorúan is alakult.",
        "en": "Visitor accounts confirm the clinic provides dependable support during urgent surgeries and weekend appointments, successfully treating critically injured pets. Guardians express gratitude for prompt medical intervention, even when certain complex exotic cases faced difficult outcomes."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "hu": "Vállalnak egzotikus állatokat és hüllőket a rendelőben?",
        "en": "Do they treat exotic animals and reptiles at the clinic?"
