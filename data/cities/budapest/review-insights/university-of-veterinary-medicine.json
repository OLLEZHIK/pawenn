  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "hu": "Kiemelkedő tudású szakorvosok és professzorok",
        "en": "Highly skilled specialists and professors"
      },
      "text": {
        "hu": "A látogatók döntő többsége nagyra értékeli az egyetemi klinika elismert orvosait, sebészeit és professzorait az István utcai kampuszon. A gazdik dicsérik az alapos kivizsgálásokat és az odaadó hozzáállást, bár a recepció stílusával kapcsolatban néhány kritikus vélemény is megjelent.",
        "en": "The vast majority of visitors hold the university clinic's renowned veterinarians, surgeons, and professors in high regard on the István street campus. Owners commend the detailed clinical examinations and dedication, though occasional criticisms note administrative friction at reception."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "hu": "Történelmi kampusz és modern diagnosztika",
        "en": "Historic campus and advanced diagnostics"
      },
      "text": {
        "hu": "Az értékelésekben gyakran emelik ki a 7. kerületi kampusz szépségét, a díszparkot és a patinás épületeket. A klinika felszereltsége kiemelkedő, a modern CT, röntgen és ultrahang eszközök biztos hátteret nyújtanak, ugyanakkor a belső parkolás szűkössége miatt a megállás nehézkes lehet.",
        "en": "Reviews frequently praise the beauty of the 7th district campus, with its landscaped park and historic brick architecture. The clinical facilities are outstanding, equipped with advanced CT, radiography, and ultrasound units, though visitors observe that on-site parking can be constrained."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "hu": "Sikeres műtétek és összetett kezelések",
        "en": "Complex surgeries and specialized therapies"
      },
      "text": {
        "hu": "A visszajelzések alapján az egyetem klinikája megbízható segítséget nyújt súlyos daganatos megbetegedések, szalagszakadások és ritka kórképek esetén. A gazdik hálásak az életmentő beavatkozásokért és a speciális terápiákért, amelyek más rendelőkben nem elérhetők.",
        "en": "Client feedback indicates that the university clinic provides dependable solutions for severe oncological conditions, ligament tears, and complex medical cases. Owners express gratitude for life-saving surgeries and specialized treatments unavailable in standard local practices."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "hu": "Milyen korszerű diagnosztikai eszközök érhetők el a klinikán?",
        "en": "What advanced diagnostic facilities are available at the clinic?"
      },
      "a": {
        "hu": "A klinika modern képalkotó eszközökkel, köztük CT-vel, digitális röntgennel és ultrahanggal felszerelt.",
        "en": "The clinic is equipped with advanced imaging modalities, including veterinary CT, digital radiography, and ultrasound."
      },
      "basis": "both"
    },
    {
      "q": {
        "hu": "Szükséges előzetes időpontfoglalás a szakrendelésekre?",
        "en": "Is prior appointment scheduling required for specialist consultations?"
      },
      "a": {
        "hu": "Igen, a vélemények alapján a tervezett vizsgálatokhoz és szakrendelésekhez előzetes egyeztetés szükséges.",
        "en": "Yes, reviews indicate that specialized examinations and consultations generally require advance appointments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "hu": "Könnyű autóval parkolni a klinika területén?",
        "en": "Is parking convenient on the clinic premises?"
      },
