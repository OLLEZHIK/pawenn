  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "hu": "Kedves és felkészült rendelői csapat",
        "en": "Friendly and skilled veterinary team"
      },
      "text": {
        "hu": "A gazdik rendkívül elégedettek az Etele úti rendelő orvosaival és asszisztenseivel, kiemelve Dr. Karsai és Dr. Kőrösy Johanna türelmes munkáját. A vélemények hangsúlyozzák, hogy a személyzet minden vizsgálatot alaposan elmagyaráz, és a félénkebb kutyákkal, cicákkal is nagy empátiával, szeretettel bánnak a kezelések során.",
        "en": "Pet owners frequently praise the veterinarians and assistants on Etele út, especially noting the patient care provided by Dr. Karsai and Dr. Johanna Kőrösy. Reviews emphasize that the team explains procedures thoroughly and approaches nervous dogs and cats with genuine empathy throughout their visit."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "hu": "Szeretetteljes gondoskodás a kedvencekről",
        "en": "Gentle handling and animal comfort"
      },
      "text": {
        "hu": "A páciensek és gazdáik kiemelik a rendelő állatközpontú és megértő légkörét, ahol kutyusok és cicák egyaránt biztonságban érzik magukat. Az asszisztensek és az orvosok simogatással, jutalomfalatokkal és türelmes mozdulatokkal nyugtatják a feszült állatokat a kötelező oltások és az alapos vizsgálatok idején.",
        "en": "Clients highlight the warm, pet-centered environment where dogs and cats feel genuinely safe and cared for. Veterinary assistants and doctors comfort stressed pets with gentle touch and patient handling, making routine health checks and vaccination appointments substantially calmer for animals and owners."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "hu": "Megbízható kezelések és sikeres ellátás",
        "en": "Reliable diagnostics and successful treatments"
      },
      "text": {
        "hu": "A látogatók dicsérik a pontos diagnosztikát, a sikeres ultrahangos vizsgálatokat, a fogászati beavatkozásokat és a rutin műtétek kimenetelét. Több gazdi arról számol be, hogy a rendelőben még súlyosabb balesetek és mérgezések után is gyorsan talpra állították kedvencüket a szakszerű terápiás ellátásnak köszönhetően.",
        "en": "Clients commend the clinic for accurate diagnostics, ultrasound imaging, dental procedures, and smooth recoveries following routine surgeries. Several owners share that pets suffering from acute injuries or intoxications were stabilized promptly thanks to the team's swift and capable medical intervention."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "hu": "Van vasárnapi nyitvatartás vagy ügyelet az EteleVet rendelőben?",
        "en": "Is there Sunday service or on-call duty at EteleVet?"
      },
      "a": {
        "hu": "Igen, a rendelő vasárnap 9:00 és 19:00 között ügyeleti rendelést tart a hétvégi sürgős esetek ellátására.",
        "en": "Yes, the practice holds Sunday on-call consultations between 09:00 and 19:00 for weekend medical issues."
      },
      "basis": "both"
    },
    {
      "q": {
        "hu": "Lehet online időpontot foglalni a vizsgálatokra?",
        "en": "Can pet owners book appointments online for consultations?"
      },
      "a": {
        "hu": "Igen, a páciensek kényelmesen foglalhatnak időpontot a rendelő weboldalán keresztül a várakozási idő elkerülésére.",
        "en": "Yes, clients can easily book consultation slots online via the clinic website to minimize in-clinic waiting."
      },
      "basis": "both"
    },
    {
      "q": {
        "hu": "Milyen diagnosztikai eszközökkel rendelkezik a rendelő?",
        "en": "What diagnostic equipment is available at the clinic?"
      },
      "a": {
        "hu": "A rendelőben korszerű hasi és kardiológiai ultrahang, laboratóriumi vizsgálatok és fogászati gépek állnak rendelkezésre.",
        "en": "The facility is equipped with modern abdominal and cardiac ultrasound scanners, in-house laboratory units, and dental gear."
      },
      "basis": "both"
    },
    {
      "q": {
        "hu": "Fogadnak sürgős eseteket előzetes bejelentkezés nélkül is?",
        "en": "Do they accept emergency patients without prior booking?"
      },
      "a": {
        "hu": "Igen, akut eseteket fogadnak, de a visszajelzések alapján előzetes telefonos értesítés javasolt a zökkenőmentes fogadáshoz.",
        "en": "Yes, acute emergencies are admitted, though calling ahead is recommended to allow the team to prepare accordingly."
      },
      "basis": "reviews"
    }
  ],
