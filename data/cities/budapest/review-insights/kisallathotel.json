  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "hu": "Szakszerű gondozás kisemlősöknek és hüllőknek",
        "en": "Skilled care for small exotics"
      },
      "text": {
        "hu": "A gazdik lenyűgözőnek találják a panzió sokoldalúságát: a nyuszik és tengerimalacok mellett sünik, hörcsögök, madarak, teknősök és agámák is szakszerű ellátást kapnak. A gondozók pontosan követik az egyes fajok speciális etetési és tisztántartási igényeit. A kisállatok többsége nyugodtan, kiegyensúlyozottan és jó egészségben tér haza a gazdájához.",
        "en": "Owners find the hotel's versatility exceptional: alongside rabbits and guinea pigs, hedgehogs, hamsters, cage birds, turtles, and bearded dragons receive experienced care. Caretakers strictly adhere to the distinct feeding and hygiene needs of each species. The vast majority of pets return home relaxed, healthy, and in great spirits."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "hu": "Elhivatott és figyelmes gondozók",
        "en": "Dedicated and attentive caretakers"
      },
      "text": {
        "hu": "A vendégek kiemelik a szálláshely munkatársainak rendkívüli rugalmasságát, kedvességét és az állatok iránti őszinte szeretetét a XIV. kerületben. A gondozók kérésre gyógyszerbeadást és karomvágást is vállalnak, felkészülten fogadva a nyaralás ideje alatt rájuk bízott kedvenceket. Bár egyetlen gazdi elégedetlen volt a tisztasággal, a látogatók túlnyomó része megbízhatónak tartja a csapatot.",
        "en": "Clients highlight the extraordinary flexibility, warmth, and genuine affection shown by staff in District XIV. The caretakers accommodate special medication routines and nail trimming, welcoming boarders attentively while owners are on holiday. Although one reviewer was dissatisfied with cage tidiness, the vast majority consider the staff dependable."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "hu": "Tiszta és hűvös szálláshely",
        "en": "Clean and cool boarding environment"
      },
      "text": {
        "hu": "A kisállattartók dicsérik a panzió tiszta, rendezett és biztonságos környezetét, ahol a ketreceket és a felszerelést gondosan karbantartják. A nyári forróság idején különösen nagy előny a hűvös, klimatizált elhelyezés, amely védelmet nyújt a melegre érzékeny rágcsálóknak. A gazdik megnyugtató környezetben tudhatják kedvenceiket a nyaralás alatt.",
        "en": "Pet owners commend the boarding hotel's clean, well-kept, and secure setting, where cages and supplies are thoroughly maintained. During hot summer months, the cool, air-conditioned accommodation provides vital comfort for heat-sensitive rodents and pets. Guardians appreciate leaving their companions in a safe and peaceful environment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "hu": "Milyen állatokat fogad a Kisállathotel megőrzésre?",
        "en": "What types of pets can be boarded at Kisállathotel?"
      },
      "a": {
        "hu": "A panzió nyulakat, tengerimalacokat, hörcsögöket, süniket, madarakat, teknősöket és más kisemlősöket vagy hüllőket fogad.",
        "en": "The hotel boards rabbits, guinea pigs, hamsters, hedgehogs, birds, turtles, and other small exotics or reptiles."
      },
      "basis": "both"
    },
    {
      "q": {
        "hu": "Küldenek fotókat vagy tájékoztatást a gazdiknak a panzióztatás alatt?",
        "en": "Do caretakers send photos or updates while pets are boarding?"
      },
      "a": {
        "hu": "Igen, a vélemények alapján a gondozók igény szerint naponta küldenek fényképes beszámolót az állatokról.",
        "en": "Yes, client reviews confirm that staff regularly send daily photos and reports on the pet's condition."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "hu": "Vállalják a gondozók speciális gyógyszerek beadását?",
        "en": "Can caretakers administer prescription medication during the stay?"
      },
      "a": {
        "hu": "Igen, a visszajelzések szerint a személyzet felkészülten végzi a rendszeres gyógyszerezést és egyedi ápolási kéréseket.",
        "en": "Yes, feedback indicates that staff handle routine medications and customized care instructions reliably."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "hu": "Lehet saját felszerelést és ketrecet hozni a kisállatnak?",
        "en": "Can owners bring their own cage accessories and equipment?"
      },
      "a": {
        "hu": "Igen, a gazdik behozhatják kedvencük megszokott felszerelését, tálkáit és játékait a bérelt szállásra.",
        "en": "Yes, owners are welcome to supply familiar bedding, food bowls, and toys for their pet's stay."
      },
      "basis": "reviews"
    }
  ],
