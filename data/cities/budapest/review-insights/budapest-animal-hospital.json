  "google_maps_url": "https://www.google.com/maps/place/Budapest+Animal+Hospital/data=!4m7!3m6!1s0x4741db8ddd72bfa1:0x9fa11f0173c2dfce!8m2!3d47.524031!4d19.0754767!16s%2Fg%2F11dxpg4wyc!19sChIJob9y3Y3bQUcRzt_CcwEfoZ8?authuser=0&hl=en&g_ep=EgoyMDI2MTAxMy4wIJJjKgBIAVAD&rclk=1",
  "period_from": "2026-04-22",
  "period_to": "2026-10-22",
  "reviews_in_period": 110,
  "observed_at": "2026-10-22",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 81,
      "title": {
        "hu": "Kiemelkedő orvosok eltérő ügyfélszolgálati tapasztalatokkal",
        "en": "Dedicated clinicians with mixed desk impressions"
      },
      "text": {
        "hu": "A vélemények alapján a kórház orvosai és műtéti szakemberei sok esetben elhivatott és életmentő munkát végeznek az éjszakai ügyeletben. Ugyanakkor számos gazdi panaszkodott a recepció leterheltségére, hűvös modorára és a túlterhelt műszakok alatti kommunikációs nehézségekre. A kliensek a szakorvosi hozzáértést dicsérik, míg a fogadtatás vegyes megítélésű.",
        "en": "Client feedback reflects high praise for attending veterinary surgeons and emergency specialists who perform vital interventions during night shifts. However, numerous pet owners report long delays, impersonal triage attitudes, and stressed communication at reception. While medical proficiency receives strong appreciation, bedside manner remains mixed."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 29,
      "title": {
        "hu": "Hosszú várakozási idő a sürgősségin",
        "en": "Extensive waiting times during emergencies"
      },
      "text": {
        "hu": "A visszajelzések leggyakoribb kritikai pontja a sokszor többórás várakozás a sürgősségi osztályon és az ügyeletben. A gazdák beszámolói szerint még előzetes online regisztráció vagy súlyos panaszok esetén is előfordulhat két-három órás csúszás a behívásig. A látogatók nehezményezik a tájékoztatás hiányát a várakozás alatt és a lassú betegfelvételt.",
        "en": "The most prominent source of dissatisfaction is the prolonged waiting period experienced in the emergency department. Pet guardians report that even with advance online registration or acute symptoms, delays of two to three hours are frequent before clinical admission. Reviewers express frustration over the lack of status updates while waiting in line."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 26,
      "title": {
        "hu": "Életmentő beavatkozások megosztó klinikai kimenetelekkel",
        "en": "Lifesaving operations alongside disputed treatment outcomes"
      },
      "text": {
        "hu": "A látogatók jelentős része végtelenül hálás a sikeres éjszakai műtétekért, a gyors intenzív terápiáért és a kritikus állapotú kedvencek megmentéséért. Ezzel szemben több tulajdonos számolt be sikertelen kezelésekről, megkésett diagnózisokról vagy elveszített háziállatokról. A kórházi ellátás eredményessége a súlyos esetek függvényében megosztja a gazdikat.",
        "en": "A significant portion of visitors express profound gratitude for successful overnight surgeries, prompt intensive care, and saved companions in critical states. Conversely, several owners report unsuccessful therapies, missed diagnoses, or tragic losses during hospital stays. Clinical treatment efficacy reflects sharply divided experiences among clients."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "hu": "Működik folyamatos 0-24 órás sürgősségi ügyelet a kórházban?",
        "en": "Does the hospital provide continuous 24/7 emergency care?"
      },
      "a": {
        "hu": "Igen, az állatkórház a nap 24 órájában, éjszaka és ünnepnapokon is fogadja a sürgősségi ellátásra szoruló kisállatokat.",
        "en": "Yes, the hospital operates a 24-hour continuous emergency service for acute cases on nights, weekends, and holidays."
      },
      "basis": "both"
    },
    {
      "q": {
        "hu": "Mire kell számítani a sürgősségi várakozási időknél?",
        "en": "What waiting times should be expected in the emergency unit?"
      },
      "a": {
        "hu": "A vélemények szerint a súlyosabb esetek prioritást élveznek (triage), emiatt csúcsidőben és éjszaka többórás várakozás is kialakulhat.",
        "en": "Client reviews indicate that patients are prioritized by clinical severity (triage), which can lead to multi-hour waits during peak hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "hu": "Rendelkezik a kórház saját intenzív bentlakásos részleggel?",
        "en": "Does the hospital have inpatient hospitalization facilities?"
      },
      "a": {
        "hu": "Igen, a kórházban fekvőbeteg-ellátó részleg és műtét utáni megfigyelő áll rendelkezésre a folyamatos kezelést igénylő állatoknak.",
        "en": "Yes, the facility features dedicated inpatient hospitalization and postoperative recovery wards for intensive patient monitoring."
      },
      "basis": "website"
    }
  ],
