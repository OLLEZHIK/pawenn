  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 89,
      "title": {
        "de": "Hohe Wertschätzung für das Praxisteam",
        "en": "High appreciation for clinic team"
      },
      "text": {
        "de": "Eine überwältigende Mehrheit der Kunden lobt das gesamte Team am Rudolfplatz für seine außergewöhnliche Freundlichkeit, Empathie und Professionalität. Behandelnde Ärzte und Fachangestellte nehmen sich viel Zeit und schaffen eine entspannte Atmosphäre für Mensch und Tier.",
        "en": "An overwhelming majority of clients praise the entire team at Rudolfplatz for their warmth, empathy, and medical dedication. Veterinarians and veterinary nurses take extensive time during appointments, creating a calm and reassuring atmosphere for pets and owners alike."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "de": "Einfache Online-Buchung und kurze Wartezeiten",
        "en": "Simple online booking and short waits"
      },
      "text": {
        "de": "Besucher schätzen die unkomplizierte Terminvergabe über die Website oder App sowie die kaum vorhandenen Wartezeiten vor Ort. Die Praxisorganisation wird als vorbildlich beschrieben, sodass Behandlungen pünktlich beginnen und Tiere kaum Zeit im Wartezimmer verbringen.",
        "en": "Visitors appreciate straightforward appointment scheduling via the website or mobile app as well as minimal on-site waiting times. Clinic workflow is described as highly efficient, ensuring examinations start punctually and pets spend hardly any time in the waiting area."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "de": "Transparente Beratung und verständliche Erklärungen",
        "en": "Transparent consultations and clear explanations"
      },
      "text": {
        "de": "Tierhalter heben die klare und transparente Aufklärung über Befunde, Diagnosewege und Behandlungsschritte hervor. Fragen werden geduldig beantwortet, und Kostenschätzungen werden vorab besprochen, wenngleich einzelne Kunden vereinzelt hohe Gebührensätze bemängeln.",
        "en": "Pet owners highlight the clear and transparent communication regarding medical findings, diagnostic steps, and treatments. Questions are answered patiently, and cost estimates are discussed in advance, although isolated reviews mention higher fee rates for minor interventions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Können Termine online gebucht werden?",
        "en": "Can appointments be booked online?"
      },
      "a": {
        "de": "Ja, Kunden heben die einfache und schnelle Terminbuchung über das Online-System der Praxis hervor.",
        "en": "Yes, clients emphasize the fast and convenient appointment booking through the online system."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Sind die Behandlungsräume klimatisiert?",
        "en": "Are the examination rooms air-conditioned?"
      },
      "a": {
        "de": "Ja, Rezensionen erwähnen modern ausgestattete und klimatisierte Praxisräume für angenehme Besuche.",
        "en": "Yes, reviews mention well-equipped, air-conditioned clinic facilities providing comfortable visits."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Werden Notfälle kurzfristig aufgenommen?",
        "en": "Are emergency cases accepted short notice?"
      },
      "a": {
        "de": "Ja, die Praxis bietet auch Akuttermine und Notfallversorgungen während der regulären Öffnungszeiten an.",
        "en": "Yes, the practice offers urgent care slots and emergency support during regular opening hours."
      },
      "basis": "reviews"
    }
  ],
