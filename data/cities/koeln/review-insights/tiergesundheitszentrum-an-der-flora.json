  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 76,
      "title": {
        "de": "Breite Zufriedenheit mit dem Praxisteam",
        "en": "Broad satisfaction with clinic team"
      },
      "text": {
        "de": "Die überwiegende Mehrheit der Tierhalter schätzt das Team für die fürsorgliche, ruhige und fachlich gründliche Betreuung. Die Mitarbeiterinnen und Mitarbeiter begegnen Tieren und Haltern mit Respekt, auch wenn vereinzelte Rezensionen personelle Wechsel kritisch sehen.",
        "en": "The vast majority of pet owners appreciate the clinic staff for their caring, composed, and medically thorough attention. Employees treat pets and their companions with dedication, although isolated reviews voice disappointment over frequent veterinarian rotations."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "de": "Reibungslose Organisation und zügige Terminvergabe",
        "en": "Smooth organization and prompt scheduling"
      },
      "text": {
        "de": "Kunden heben die strukturierte Praxisorganisation hervor. Termine werden zeitnah vergeben und Wartezeiten im Empfangsbereich fallen meist kurz aus. Auch bei dringenden Vorstellungen bemüht sich das Team, Patienten schnellstmöglich in den Behandlungsablauf einzubinden.",
        "en": "Clients highlight the well-structured clinic management. Appointments are scheduled promptly and waiting times in the reception area are mostly short. Even during urgent visits, the staff endeavor to integrate patients into the treatment flow as swiftly as possible."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "de": "Verständliche Aufklärung über Befunde und Therapien",
        "en": "Clear guidance on findings and therapies"
      },
      "text": {
        "de": "Halterinnen und Halter schätzen die ausführliche und verständliche Erklärung diagnostischer Schritte, Operationen und Medikamente. Fragen werden geduldig beantwortet, wenngleich einzelne kritische Stimmen in schweren Krankheitsphasen mehr Einfühlungsvermögen vermissten.",
        "en": "Pet owners appreciate the thorough and intelligible explanation of diagnostic findings, surgical options, and medications. Questions are patiently addressed, though isolated critical voices wished for greater sensitivity during distressing terminal disease phases."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Werden in der Praxis Operationen durchgeführt?",
        "en": "Are operations conducted at clinic?"
      },
      "a": {
        "de": "Ja, Halter berichten von erfolgreichen chirurgischen Eingriffen und Zahnsanierungen vor Ort.",
        "en": "Yes, owners report successful surgical procedures and dental treatments performed on site."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Wie sind die Wartezeiten vor Ort?",
        "en": "What are on-site waiting times like?"
      },
      "a": {
        "de": "Besucher beschreiben die Wartezeiten durch geregelte Terminvergabe als überwiegend kurz und planbar.",
        "en": "Visitors describe wait times as predominantly short and predictable thanks to scheduled appointments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Werden Diagnosen verständlich erklärt?",
        "en": "Are medical diagnoses explained clearly?"
      },
      "a": {
        "de": "Ja, das Praxisteam nimmt sich Zeit für ausführliche Erläuterungen und beantwortet Halterfragen geduldig.",
        "en": "Yes, the veterinary team takes time for detailed explanations and patiently answers owner questions."
      },
      "basis": "reviews"
    }
  ],
