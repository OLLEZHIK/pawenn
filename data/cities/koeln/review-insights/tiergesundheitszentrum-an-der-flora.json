  "google_maps_url": "https://www.google.com/maps/place/Tiergesundheitszentrum+an+der+Flora/@50.9670622,6.9677389,17z/data=!3m1!4b1!4m6!3m5!1s0x47bf2581ec348819:0xefafa6d117c7aec1!8m2!3d50.9670622!4d6.9677389!16s%2Fg%2F1tcyk55w?authuser=0&hl=de&entry=ttu&g_ep=EgoyMDI2MDkzMC4wIKXMDSoASAFQAw%3D%3D",
  "period_from": "2026-04-06",
  "period_to": "2026-10-06",
