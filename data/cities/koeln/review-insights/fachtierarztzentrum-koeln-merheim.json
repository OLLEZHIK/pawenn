  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 60,
      "title": {
        "de": "Hervorragende fachliche und menschliche Betreuung",
        "en": "Outstanding professional and compassionate care"
      },
      "text": {
        "de": "Kunden loben die Spezialisten und tiermedizinischen Fachangestellten für ihre hohe fachliche Expertise und die einfühlsame Betreuung. Auch in komplexen chirurgischen oder internistischen Fällen fühlen sich Patientenbesitzer durchgehend professionell begleitet.",
        "en": "Clients praise the veterinary specialists and nursing staff for their profound medical expertise and compassionate approach. Even in complex surgical or internal medicine cases, pet owners feel consistently supported by a highly dedicated professional team."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "de": "Detaillierte Aufklärung über komplexe Eingriffe",
        "en": "Detailed guidance on complex procedures"
      },
      "text": {
        "de": "Halter heben die umfassende und verständliche Beratung vor Operationen und anspruchsvollen Diagnostiken hervor. Risiken, Nachsorge und Therapieoptionen werden ausführlich besprochen, sodass Tierbesitzer zu jedem Zeitpunkt fundierte Entscheidungen treffen können.",
        "en": "Owners emphasize the comprehensive and transparent consultations prior to operations and advanced diagnostics. Risks, post-operative care, and therapeutic options are discussed in detail, allowing pet companions to make well-informed healthcare decisions at all times."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "de": "Effiziente Abläufe und kurze Wartezeiten",
        "en": "Efficient workflows and brief waits"
      },
      "text": {
        "de": "Besucher loben die exzellente Organisation des Fachtierarztzentrums. Trotz des Charakters einer Überweisungs- und Fachpraxis verlaufen Termine pünktlich, und Wartezeiten vor Voruntersuchungen oder Entlassungen nach Operationen fallen erfreulich kurz aus.",
        "en": "Visitors commend the excellent organizational efficiency of the specialist center. Despite handling complex medical cases, scheduled appointments proceed punctually, and waiting times prior to consultations or surgical discharges remain pleasantly short."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Werden in der Praxis spezielle Operationen durchgeführt?",
        "en": "Are operations conducted at center?"
      },
      "a": {
        "de": "Ja, Halter berichten von anspruchsvollen chirurgischen Eingriffen, CT-Diagnostik und stationärer Nachsorge.",
        "en": "Yes, clients report advanced surgical procedures, CT diagnostics, and inpatient postoperative monitoring."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Benötigt man für den Besuch eine Überweisung?",
        "en": "Is a referral needed for visit?"
      },
      "a": {
        "de": "Als Fachtierarztzentrum werden viele Patienten überwiesen; Termine können nach Rücksprache vereinbart werden.",
        "en": "As a specialist veterinary center, many patients are referred; appointments are arranged following inquiry."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Wie ist die zeitliche Organisation bei Terminen?",
        "en": "How well organized are appointments?"
      },
      "a": {
        "de": "Besucher heben hervor, dass Termine pünktlich eingehalten werden und kaum Wartezeiten entstehen.",
        "en": "Visitors emphasize that scheduled appointments are kept punctually with minimal on-site waiting."
      },
      "basis": "reviews"
    }
  ],
