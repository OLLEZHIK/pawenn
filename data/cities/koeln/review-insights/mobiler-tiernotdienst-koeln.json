  "google_maps_url": "https://www.google.com/maps/place/Mobiler+Tiernotdienst/@50.8824462,7.0766162,17z/data=!3m1!4b1!4m6!3m5!1s0x47bed829c9b042d1:0xd6ad167428d977e5!8m2!3d50.8824462!4d7.0766162!16s%2Fg%2F11b6nnxvxp?authuser=0&hl=de&entry=ttu&g_ep=EgoyMDI2MDkzMC4wIKXMDSoASAFQAw%3D%3D",
  "period_from": "2026-04-06",
  "period_to": "2026-10-06",
  "reviews_in_period": 53,
  "observed_at": "2026-10-06",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 47,
      "title": {
        "de": "Hausbesuche mit stark geteilten Erfahrungen",
        "en": "Home visits with sharply divided reviews"
      },
      "text": {
        "de": "Zahlreiche Tierhalter äußern tiefe Dankbarkeit für einfühlsame und beruhigende Hilfe bei Hausbesuchen in späten Abendstunden. Demgegenüber stehen scharfe Beschwerden über unempathisches Auftreten oder mangelnde Sorgfalt während schmerzhafter Notlagen und Euthanasien.",
        "en": "Numerous pet owners express heartfelt gratitude for empathetic and calming assistance during late-night home visits. In contrast, sharp complaints cite uncompassionate behavior or perceived lack of care during painful emergency situations and end-of-life procedures."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 20,
      "title": {
        "de": "Geteilte Bewertungen zu telefonischer Beratung",
        "en": "Divided ratings for phone consultations"
      },
      "text": {
        "de": "Während die telefonische Notfallannahme von vielen Anrufern als freundlich und hilfsbereit beschrieben wird, berichten andere Halter von Sprachbarrieren mit vor Ort eintreffenden Tierärzten oder unzureichender Information über voraussichtliche Behandlungskosten.",
        "en": "While the initial emergency dispatch by telephone is described by many callers as friendly and supportive, other clients report noticeable language barriers with visiting veterinarians or a lack of clear information regarding anticipated medical expenses."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 17,
      "title": {
        "de": "Schnelles Eintreffen bei vereinzelten Verzögerungen",
        "en": "Prompt arrival alongside occasional delays"
      },
      "text": {
        "de": "In vielen akuten Fällen schätzen Halter das zügige Erscheinen des mobilen Dienstes, wodurch schwerkranken Tieren der Transportstress erspart bleibt. Wiederholt wird jedoch auch von langen Wartezeiten oder fehlenden Terminbestätigungen bei dringenden Notfällen berichtet.",
        "en": "In many acute cases, owners value the prompt arrival of the mobile service, sparing critically ill pets the severe distress of transportation. However, repeated reports also mention prolonged waiting times or unconfirmed arrival windows during urgent emergencies."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Wann ist der mobile Tiernotdienst erreichbar?",
        "en": "When is mobile emergency service available?"
      },
      "a": {
        "de": "Der Dienst wird insbesondere abends, an Wochenenden und bei akuten Notfällen telefonisch angefordert.",
        "en": "The service is requested by telephone particularly during evening hours, weekends, and acute emergencies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Können Behandlungen direkt vor Ort abgerechnet werden?",
        "en": "Can treatments be paid directly on site?"
      },
      "a": {
        "de": "Ja, Einsätze werden üblicherweise vor Ort per Kartenzahlung oder in bar mit dem Tierarzt abgerechnet.",
        "en": "Yes, callouts are typically settled directly on site with the veterinarian via card or cash."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Führt der mobile Notdienst auch Euthanasien zu Hause durch?",
        "en": "Does mobile emergency service perform home euthanasia?"
      },
      "a": {
        "de": "Ja, Halter können Hausbesuche vereinbaren, um Tieren den letzten Weg im vertrauten Umfeld zu ermöglichen.",
        "en": "Yes, pet owners can arrange home visits to allow animals a peaceful farewell in familiar surroundings."
      },
      "basis": "reviews"
    }
  ],
