  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "de": "Freundliche Beratung im Fachmarkt Bilderstöckchen",
        "en": "Helpful advice at the Bilderstöckchen store"
      },
      "text": {
        "de": "Kunden loben die Hilfsbereitschaft und das Fachwissen der Angestellten in vielen Abteilungen des Marktes. An der Kasse und bei Fragen zu Futterzusammensetzungen erhalten Besucher zügige Unterstützung. In speziellen Bereichen wie der Aquaristik wird jedoch gelegentlich zusätzliches Beratungspersonal vermisst.",
        "en": "Customers praise the helpfulness and expertise of the staff across multiple store departments. Shoppers receive prompt assistance at the checkouts and when inquiring about pet food ingredients. In specialized sections like aquatics, however, extra advisory staff is occasionally missed."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "de": "Umfangreiches Sortiment für die tägliche Haustierhaltung",
        "en": "Extensive selection for everyday pet essentials"
      },
      "text": {
        "de": "Der Markt überzeugt mit einer breiten Auswahl an Trocken- und Nassfutter, Snacks sowie Basisbedarf für Hunde, Katzen und Kleintiere. Während das Angebot für den alltäglichen Einkauf hoch geschätzt wird, vermissen einzelne Kunden bei Großartikeln und speziellen Zubehörlinien eine noch tiefere Auswahl.",
        "en": "The megastore impresses with a wide selection of dry and wet food, treats, and everyday equipment for dogs, cats, and small animals. While everyday supplies are highly regarded, some shoppers note that specialized accessories and larger equipment lines could offer even deeper variety."
      }
    },
    {
      "topic": "place",
      "sentiment": "mixed",
      "mentions": 5,
      "title": {
        "de": "Großzügige Verkaufsfläche mit strenger Parkplatzüberwachung",
        "en": "Spacious store with strict parking rules"
      },
      "text": {
        "de": "Die Filiale bietet breite Gänge und eine aufgeräumte Atmosphäre, die einen entspannten Einkauf ermöglichen. Auf dem Kundenparkplatz führt die strikte Überwachung der einstündigen Höchstparkdauer jedoch bei geringfügigen Überschreitungen zu empfindlichen Strafzetteln, was mehrfach kritisiert wird.",
        "en": "The store provides wide aisles and an organized layout that make shopping comfortable. On the customer parking lot, however, strict enforcement of the one-hour maximum parking limit leads to hefty penalty tickets for minor delays, which is frequently criticized by visitors."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Gibt es Parkplätze vor dem Fressnapf XXL?",
        "en": "Is customer parking available at Fressnapf XXL?"
      },
      "a": {
        "de": "Ja, es gibt Parkplätze direkt vor dem Markt, Kunden müssen jedoch auf die zeitliche Höchstparkdauer achten.",
        "en": "Yes, parking is directly outside, but visitors must strictly observe the time limit to avoid fines."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden im Markt auch Aquarienfische angeboten?",
        "en": "Are aquarium fish available for purchase in store?"
      },
      "a": {
        "de": "Ja, der Markt führt eine Aquaristikabteilung, wobei Kunden für den Fischkauf die Anwesenheit von Fachpersonal empfehlen.",
        "en": "Yes, there is an aquatics section, though shoppers advise verifying staff availability for fish purchases."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Können Hunde mit in das Geschäft genommen werden?",
        "en": "Are dogs allowed inside the megastore?"
      },
      "a": {
        "de": "Ja, Hunde sind im Markt an der Leine willkommen und können beispielsweise für Zubehör anprobiert werden.",
        "en": "Yes, dogs on leashes are welcome inside the store and can try on accessories such as harnesses."
      },
      "basis": "both"
    }
