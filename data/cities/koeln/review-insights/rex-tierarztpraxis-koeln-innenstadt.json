  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "de": "Zugewandtes Personal mit ausführlicher Beratung",
        "en": "Attentive staff offering thorough consultations"
      },
      "text": {
        "de": "Tierhalter loben das gesamte Team der Rex-Praxis in der Kölner Innenstadt für seine außergewöhnliche Freundlichkeit und Geduld. Die Tierärzte nehmen sich viel Zeit für Untersuchungen, erklären Behandlungsschritte und Befunde detailliert und gehen empathisch auf Rückfragen ein. Auch neurodivergente Halter fühlen sich verstanden und sicher begleitet.",
        "en": "Pet owners praise the entire Rex team in central Cologne for exceptional friendliness and patience. The veterinarians take ample time during appointments, explain treatment stages and clinical findings thoroughly, and answer questions with empathy. Handlers with neurodivergent needs also feel respected and secure."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "de": "Behutsamer Umgang mit Katzen und Hunden",
        "en": "Gentle handling of cats and dogs"
      },
      "text": {
        "de": "Die Praxis zeichnet sich durch einen besonders feinfühligen Umgang mit Haustieren aus. Scheue Katzen werden behutsam untersucht, und Hunde mit sensiblem Gemüt oder chronischen Magen-Darm-Problemen erhalten eine ruhige, stressfreie Betreuung. Halter betonen, dass Vierbeiner ohne Hektik untersucht werden und Vertrauen fassen können.",
        "en": "The clinic distinguishes itself through remarkably gentle handling of companion animals. Timid cats receive calm examinations, and sensitive dogs with delicate temperaments or chronic gastrointestinal issues receive low-stress care. Owners appreciate that appointments proceed without rush so pets remain at ease."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 7,
      "title": {
        "de": "Schnelle Online-Terminvergabe und kurze Wartezeiten",
        "en": "Rapid online scheduling and short waits"
      },
      "text": {
        "de": "Die Organisation der Praxis wird von Kundinnen und Kunden durchweg gelobt. Termine können unkompliziert und kurzfristig über die Website oder per App gebucht werden. Vor Ort profitieren Tierbesitzer von reibungslosen Abläufen und minimalen Wartezeiten im Wartezimmer, was den Tierarztbesuch für alle Beteiligten spürbar entlastet.",
        "en": "The clinic's digital organization earns frequent praise from visitors. Consultations can be booked swiftly and conveniently via website or smartphone app. On site, pet parents benefit from punctual schedules and minimal waiting times, significantly reducing visit stress for both humans and animals."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Können Termine online oder per App gebucht werden?",
        "en": "Can appointments be booked online or via an app?"
      },
      "a": {
        "de": "Ja, Kunden heben die unkomplizierte und schnelle Online-Terminbuchung über die Praxis-Website oder App positiv hervor.",
        "en": "Yes, clients highlight the straightforward and fast online booking via the clinic's website or app."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden in der Praxis auch Zahnoperationen bei älteren Katzen durchgeführt?",
        "en": "Does the clinic perform dental surgery on senior cats?"
      },
      "a": {
        "de": "Ja, Halter berichten von erfolgreichen und schonend durchgeführten Zahnoperationen, etwa bei Seniorkatzen.",
        "en": "Yes, owners report successful and carefully conducted dental procedures, such as for senior cats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Welche Zahlungsmethoden werden in der Praxis akzeptiert?",
        "en": "Which payment methods are accepted at the clinic?"
      },
      "a": {
        "de": "Die Abrechnung erfolgt vor Ort bargeldlos per Karte; direkte Abrechnungen mit Tierversicherungen sind laut Kunden nicht möglich.",
        "en": "Billing is handled cashless on site by card; direct settlement with pet health insurances is not supported according to clients."
      },
      "basis": "reviews"
    }
