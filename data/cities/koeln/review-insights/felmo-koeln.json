  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 193,
      "title": {
        "de": "Einfühlsame Tierärzte bei Hausbesuchen",
        "en": "Empathetic veterinarians on home visits"
      },
      "text": {
        "de": "Tierhalter in Köln heben die ruhige und geduldige Art der mobilen Tierärzte hervor. Bei Hausbesuchen nehmen sich die Behandler viel Zeit für Diagnostik und Beratung, ohne Hektik aufkommen zu lassen. Fragen zu Medikamenten und Nachsorge werden verständlich und ausführlich beantwortet.",
        "en": "Pet owners in Cologne emphasize the calm and patient approach of mobile veterinarians. During home visits, the practitioners take plenty of time for diagnostics and advice without rushing. Questions about medications and aftercare are answered clearly and thoroughly."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 59,
      "title": {
        "de": "Verlässliche Versorgung von Routine bis Notfall",
        "en": "Reliable care from checkups to emergencies"
      },
      "text": {
        "de": "Viele Kunden berichten von rascher Besserung nach Impfungen, Blutabnahmen oder der Behandlung akuter Infektionen. Notwendige Medikamente werden direkt vor Ort verabreicht oder per digitalem Rezept bereitgestellt, sodass Beschwerden zügig gelindert werden.",
        "en": "Many clients report prompt recovery following vaccinations, blood draws, or targeted therapies for acute infections. Necessary medications are administered directly on site or issued via digital prescriptions, ensuring health issues are alleviated swiftly."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "de": "Pünktliche Hausbesuche mit verlässlicher Terminplanung",
        "en": "Punctual home visits with dependable scheduling"
      },
      "text": {
        "de": "Kunden schätzen die unkomplizierte Terminvergabe über die App sowie die hohe Pünktlichkeit der Tierärzte. Das vereinbarte Zeitfenster für den Hausbesuch wird verlässlich eingehalten, sodass Besitzer ihren Tagesablauf ohne zeitraubendes Warten im Praxisflur planen können.",
        "en": "Clients value straightforward booking through the app along with the strong punctuality of visiting veterinarians. Agreed appointment windows for home visits are reliably observed, allowing pet owners to organize their schedules without sitting in crowded waiting rooms."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Bietet Felmo in ganz Köln Hausbesuche an?",
        "en": "Does Felmo provide home visits across all of Cologne?"
      },
      "a": {
        "de": "Ja, die mobilen Tierärzte fahren Halter in sämtlichen Kölner Stadtteilen direkt zu Hause an.",
        "en": "Yes, the mobile vets visit pet owners directly at their homes throughout all Cologne districts."
      },
      "basis": "website"
    },
    {
      "q": {
        "de": "Wie erfolgt die Terminbuchung?",
        "en": "How are appointments scheduled?"
      },
      "a": {
        "de": "Termine können bequem über die Felmo-App oder die Website für passende Zeitfenster gebucht werden.",
        "en": "Appointments can be scheduled conveniently through the Felmo app or website for suitable time slots."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Können auch ängstliche Tiere zu Hause behandelt werden?",
        "en": "Can anxious animals be treated at home?"
      },
      "a": {
        "de": "Ja, Halter schätzen besonders den ruhigen Ablauf ohne stressige Transporte für scheue Hunde und Katzen.",
        "en": "Yes, owners particularly value the calm procedure without stressful travel for shy dogs and cats."
      },
      "basis": "reviews"
    }
  ],
