  "cards": [
    {
      "topic": "staff",
      "title": {
        "en": "Caring clinical staff contrasted with reception friction",
        "pl": "Zaangażowany personel medyczny i skargi na recepcję"
      },
      "text": {
        "en": "A significant majority of clients praise the empathy, expertise, and dedication of attending doctors and surgeons, especially during night emergencies. Conversely, critical reviews regularly point to unwelcoming reception staff, chaotic communication, and occasional perceived indifference.",
        "pl": "Znaczna część opiekunów bardzo chwali empatię, profesjonalizm i zaangażowanie lekarzy dyżurnych oraz chirurgów ratujących zwierzęta w nocy. Jednocześnie w opiniach powtarzają się krytyczne głosy dotyczące nieuprzejmej obsługi w rejestracji, chaosu organizacyjnego i braku wyczucia."
      },
      "mentions": 76,
      "sentiment": "mixed"
    },
    {
      "topic": "results",
      "title": {
        "en": "Effective emergency rescues alongside diagnostic grievances",
        "pl": "Skuteczna pomoc powypadkowa i zastrzeżenia do diagnoz"
      },
      "text": {
        "en": "The clinic receives heartfelt appreciation for successful urgent surgeries, rapid stabilization of road accident victims, and dependable inpatient observation. Nevertheless, several reviews recount painful experiences with missed diagnoses, prolonged hospital stays, and patient decline.",
        "pl": "Klinika zbiera wiele podziękowań za udane operacje w trybie pilnym, szybką stabilizację rannych czworonogów i całodobową opiekę szpitalną. Część wpisów wyraża jednak żal z powodu nietrafionych rozpoznań, nieskutecznych kuracji lub nagłego pogorszenia stanu leczonych pacjentów."
      },
      "mentions": 52,
      "sentiment": "mixed"
    },
    {
      "topic": "waiting",
      "title": {
        "en": "Variable admission speed and long emergency queues",
        "pl": "Zróżnicowane tempo przyjęć i długie nocne kolejki"
      },
      "text": {
        "en": "While urgent triage cases are handled promptly upon arrival, pet owners visiting with non-critical conditions often endure waits lasting from one to two hours. Reviewers mention that waiting times escalate considerably during night shifts and on weekends due to incoming trauma admissions.",
        "pl": "Podczas gdy przypadki bezpośredniego zagrożenia życia przyjmowane są natychmiast, pozostali opiekunowie nierzadko czekają w poczekalni od jednej do dwóch godzin. Klienci wskazują, że kolejki wydłużają się zwłaszcza na dyżurach nocnych i w weekendy przy dużym napływie nagłych pacjentów."
      },
      "mentions": 25,
      "sentiment": "mixed"
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Klinika Sfora operate continuously throughout the night?",
        "pl": "Czy Klinika Sfora przyjmuje pacjentów całodobowo?"
      },
      "a": {
        "en": "Yes, the clinic operates 24 hours every day with round-the-clock emergency medical staff, surgery, and hospital wards.",
        "pl": "Tak, klinika działa 24 godziny na dobę przez cały rok, oferując ostry dyżur internistyczny, chirurgiczny oraz szpital."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How long do pet owners typically wait during emergency shifts?",
        "pl": "Ile wynosi czas oczekiwania na ostrym dyżurze?"
      },
      "a": {
        "en": "Triage prioritizes life-threatening cases immediately, while stable patients often wait between 45 and 90 minutes during busy hours.",
        "pl": "Przypadki zagrożenia życia przyjmowane są priorytetowo, natomiast pacjenci stabilni mogą czekać w kolejce od 45 do 90 minut."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is dedicated customer parking provided on site?",
        "pl": "Czy przy klinice znajduje się parking dla klientów?"
      },
      "a": {
        "en": "Yes, the clinic maintains its own private parking lot directly adjacent to the entrance on Trakt Lubelski.",
        "pl": "Tak, klinika posiada własny, wygodny parking dla opiekunów zwierząt tuż obok wejścia przy Trakcie Lubelskim."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do clients describe procedure and treatment fees?",
        "pl": "Jak klienci oceniają wysokość opłat za leczenie w klinice?"
      },
      "a": {
        "en": "Reviewers generally perceive night emergency rates and inpatient monitoring costs as elevated and substantially above standard clinic prices.",
        "pl": "Klienci w recenzjach powszechnie oceniają stawki nocnego dyżuru oraz opieki szpitalnej jako wysokie i przewyższające średnie ceny."
      },
      "basis": "reviews"
    }
  ],
