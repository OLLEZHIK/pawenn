  "cards": [
    {
      "topic": "staff",
      "title": {
        "en": "Devoted Targówek veterinarians with immense client trust",
        "pl": "Oddani lekarze z Targówka cieszący się ogromnym zaufaniem"
      },
      "text": {
        "en": "With dozens of positive reviews each month, the medical staff at Lupus is celebrated for unwavering empathy, great patience, and dedicated care. While a few critical voices note stressful peak rush hours, the overall appreciation for the team is overwhelming.",
        "pl": "Przychodnia Lupus gromadzi co miesiąc dziesiątki entuzjastycznych opinii chwalących lekarzy za empatię, cierpliwość i oddanie pacjentom. Chociaż pojedyncze głosy krytyczne dotyczą pośpiechu w godzinach największego ruchu, zaufanie do zespołu pozostaje olbrzymie."
      },
      "mentions": 94,
      "sentiment": "positive"
    },
    {
      "topic": "animals",
      "title": {
        "en": "Gentle bedside manner for anxious and elderly pets",
        "pl": "Bezstresowe podejście do lękliwych i starszych zwierząt"
      },
      "text": {
        "en": "Pet parents regularly note how calmly dogs and cats are handled during examinations, routine blood draws, and dental work. The veterinarians excel at soothing stressed companion animals, turning potentially tense visits into safe and comfortable experiences.",
        "pl": "Opiekunowie zwierząt wielokrotnie opisują, z jakim spokojem traktowane są psy i koty podczas wizyt, pobierania krwi oraz zabiegów stomatologicznych. Lekarze potrafią skutecznie zredukować stres u czworonogów, zapewniając im pełne poczucie bezpieczeństwa w gabinecie."
      },
      "mentions": 16,
      "sentiment": "positive"
    },
    {
      "topic": "results",
      "title": {
        "en": "Effective therapies, dental surgeries, and diagnostics",
        "pl": "Skuteczne leczenie, chirurgia stomatologiczna i badania"
      },
      "text": {
        "en": "Reviewers frequently cite successful recoveries from acute internal illnesses, highly accurate digital X-rays, and professional dental cleanings. Reliable clinical judgment and accessible laboratory diagnostics allow for fast and targeted health interventions.",
        "pl": "Recenzenci bardzo często wymieniają udane kuracje internistyczne, rzetelne zdjęcia rentgenowskie RTG oraz profesjonalną sanację jamy ustnej. Trafne diagnozy i szybki dostęp do badań na miejscu umożliwiają natychmiastowe wdrożenie skutecznego postępowania medycznego."
      },
      "mentions": 16,
      "sentiment": "positive"
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is Przychodnia Lupus open 7 days a week?",
        "pl": "Czy Przychodnia Lupus jest otwarta przez 7 dni w tygodniu?"
      },
      "a": {
        "en": "Yes, Lupus is open Monday to Friday from 8:00 to 22:00, and on weekends at designated extended hours.",
        "pl": "Tak, przychodnia przyjmuje od poniedziałku do piątku w godzinach 8:00–22:00 oraz w weekendy."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "What diagnostics are carried out at Lupus?",
        "pl": "Jakie badania diagnostyczne wykonuje przychodnia Lupus?"
      },
      "a": {
        "en": "The clinic performs digital X-rays, abdominal ultrasound scans, and comprehensive blood and urine laboratory tests.",
        "pl": "Placówka wykonuje cyfrowe zdjęcia RTG, badania USG jamy brzusznej oraz pełną diagnostykę laboratoryjną."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Where is the clinic located in Targówek?",
        "pl": "Gdzie na Targówku znajduje się Przychodnia Lupus?"
      },
      "a": {
        "en": "The practice is situated at Aleksandra Gajkowicza 2 in the Targówek district of Warsaw.",
        "pl": "Przychodnia mieści się przy ulicy Aleksandra Gajkowicza 2 na warszawskim Targówku."
      },
      "basis": "website"
    }
  ],
  "reviews_in_period": 94
