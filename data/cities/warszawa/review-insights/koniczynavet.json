  "cards": [
    {
      "topic": "staff",
      "title": {
        "en": "Exceptional veterinary specialists and care",
        "pl": "Wybitni specjaliści i troskliwa opieka"
      },
      "text": {
        "en": "Clients give overwhelming praise to the team, highlighting Dr. Aleksandra Tomkowicz, Dr. Alicja Gajosz, and other specialists for in-depth knowledge and deep empathy. Owners consistently emphasize thorough examinations, clear treatment plans, and exceptional bedside manners.",
        "pl": "Klienci z ogromnym uznaniem wypowiadają się o zespole, wyróżniając doktor Aleksandrę Tomkowicz, doktor Alicję Gajosz oraz innych lekarzy za ogromną wiedzę i empatię. Opiekunowie podkreślają wnikliwe badania, cierpliwe wyjaśnienia i wielkie serce do pacjentów."
      },
      "mentions": 35,
      "sentiment": "positive"
    },
    {
      "topic": "results",
      "title": {
        "en": "Successful surgeries and advanced dentistry",
        "pl": "Udane operacje i zaawansowana stomatologia"
      },
      "text": {
        "en": "Reviewers report outstanding medical and surgical outcomes, citing successful cataract operations, corneal ulcer healing, and tooth reconstructions with pulp capping. Handlers credit the clinic with saving pets' vision and resolving critical health conditions.",
        "pl": "Recenzenci wskazują na znakomite rezultaty zabiegów, opisując udane operacje zaćmy, wyleczenie wrzodów rogówki oraz zaawansowaną rekonstrukcję złamanych zębów. Opiekunowie czworonogów dziękują za uratowanie wzroku i wyprowadzenie zwierząt ze skomplikowanych chorób."
      },
      "mentions": 16,
      "sentiment": "positive"
    },
    {
      "topic": "animals",
      "title": {
        "en": "Gentle and stress-free patient handling",
        "pl": "Łagodne i bezstresowe podejście do zwierząt"
      },
      "text": {
        "en": "Pet owners appreciate the patient, calming environment cultivated by veterinarians and assistants. Reviewers note that nervous dogs and sensitive cats are examined gently with reassuring strokes, making visits comfortable rather than frightening for pets.",
        "pl": "Właściciele zwierząt doceniają spokojną atmosferę oraz ogromną cierpliwość wykazywaną przez lekarzy i personel pomocniczy. Recenzenci zauważają, że zestresowane psy i wrażliwe koty są traktowane niezwykle łagodnie, co pozwala uniknąć niepotrzebnego lęku w gabinecie."
      },
      "mentions": 13,
      "sentiment": "positive"
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What veterinary specializations are available at KoniczynaVET?",
        "pl": "W jakich dziedzinach specjalizuje się przychodnia KoniczynaVET?"
      },
      "a": {
        "en": "The practice is widely recognized for veterinary ophthalmology, advanced dentistry, oral surgery, and internal diagnostics.",
        "pl": "Placówka jest szczególnie ceniona za okulistykę weterynaryjną, zaawansowaną stomatologię, chirurgię szczękową i diagnostykę internistyczną."
      },
      "basis": "both"
    },
    {
      "q": {
