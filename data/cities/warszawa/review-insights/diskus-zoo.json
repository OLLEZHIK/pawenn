  "cards": [
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "en": "Outstanding selection of specialized aquarium supplies",
        "pl": "Znakomicie zaopatrzony sklep dla pasjonatów akwarystyki"
      },
      "text": {
        "en": "Aquarists across Warsaw praise Diskus Zoo as an exceptionally well-stocked destination for aquarium setups, tanks, filters, and fertilizers. Reviewers consistently celebrate finding rare accessories, hard-to-source aquatic plants, and specialized nutrients all in one store.",
        "pl": "Akwaryści z całej Warszawy zgodnie chwalą Diskus Zoo jako wyjątkowo dobrze zaopatrzony sklep oferujący zbiorniki, filtry, nawozy i sprzęt techniczny. Klienci doceniają stałą dostępność rzadkich akcesoriów, bogaty wybór roślin wodnych oraz specjalistycznych preparatów akwarystycznych."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 35,
      "title": {
        "en": "Broad array of fish specimens with occasional quarantine notes",
        "pl": "Bogaty wybór ryb akwariowych z uwagami o kwarantannie"
      },
      "text": {
        "en": "The majority of customers commend the remarkable diversity of freshwater fish, invertebrates, and live foods. However, several critical reviews point out health complications with newly bought specimens, advising newcomers to practice thorough quarantine before introducing fish to established tanks.",
        "pl": "Większość klientów chwali bogaty wybór ryb słodkowodnych, bezkręgowców oraz żywego pokarmu. Część recenzji zwraca jednak uwagę na sporadyczne problemy zdrowotne zakupionych okazów, sugerując konieczność przeprowadzenia starannej kwarantanny przed wpuszczeniem ryb do akwarium domowego."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Knowledgeable and communicative aquatic specialists",
        "pl": "Doświadczona i pomocna kadra specjalistów akwarystyki"
      },
      "text": {
        "en": "Shoppers express deep appreciation for the store personnel, praising their extensive technical knowledge, genuine passion, and readiness to explain water parameters. Pet owners highlight friendly advice that reliably steers beginners toward optimal tank choices.",
        "pl": "Kupujący wyrażają duże uznanie dla pracowników sklepu, doceniając ich fachową wiedzę techniczną, pasję oraz gotowość do objaśniania parametrów wody. Klienci podkreślają życzliwe doradztwo, które ułatwia początkującym akwarystom właściwy dobór obsady i sprzętu w zbiorniku."
      }
    }
  ],
  "faq": [
    {
      "basis": "reviews",
      "q": {
        "en": "What is the primary specialty of Diskus Zoo?",
        "pl": "W czym specjalizuje się sklep Diskus Zoo?"
      },
      "a": {
        "en": "Reviews identify it as one of Warsaw's premier specialty stores for aquaristics, fish, and aquatic plants.",
        "pl": "Opinie wskazują go jako jeden z czołowych warszawskich sklepów specjalizujących się w akwarystyce, rybach i roślinach."
      }
    },
    {
      "basis": "reviews",
      "q": {
        "en": "How do clients evaluate staff competence in aquarium advice?",
        "pl": "Jak klienci oceniają fachowość obsługi w doradztwie akwarystycznym?"
      },
      "a": {
        "en": "Staff members receive wide acclaim for profound aquatic knowledge, patient advice, and kind service.",
        "pl": "Pracownicy otrzymują liczne pochwały za fachową wiedzę akwarystyczną, cierpliwe porady i życzliwość."
      }
    },
    {
      "basis": "reviews",
      "q": {
        "en": "What is the general condition of aquarium specimens?",
        "pl": "W jakim stanie są ryby i żywe organizmy w sprzedaży?"
      },
      "a": {
        "en": "Clients praise healthy fish variety, though some reviews advise routine quarantine for newly purchased animals.",
        "pl": "Klienci chwalą różnorodność ryb, choć część opinii zaleca rutynową kwarantannę po zakupie nowych okazów."
      }
    }
