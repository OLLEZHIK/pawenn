  "cards": [
    {
      "topic": "results",
      "title": {
        "en": "Precise breed styling and detangling",
        "pl": "Precyzyjne strzyżenie i rozczesywanie"
      },
      "text": {
        "en": "Pet owners widely commend the aesthetic finish, highlighting neat breed haircuts for Poodles, Yorkies, and Bichons, as well as complex detangling on heavily matted coats. A few reviews reported instances where fur was cut shorter than requested by handlers.",
        "pl": "Opiekunowie czworonogów powszechnie chwalą estetykę wykonania, wskazując na staranne fryzury dla pudli, yorków i biszonów oraz sprawne rozczesywanie trudnych kołtunów. W pojedynczych opiniach pojawiły się uwagi o zbyt krótkim skróceniu szaty względem oczekiwań."
      },
      "mentions": 30,
      "sentiment": "positive"
    },
    {
      "topic": "staff",
      "title": {
        "en": "Skilled, patient, and dedicated stylists",
        "pl": "Cierpliwe i wykwalifikowane stylistki"
      },
      "text": {
        "en": "Reviewers warmly highlight groomers such as Kamila, Wiktoria, and Eliza for their gentleness, attention to detail, and attentive client communication. Critical feedback was sparse, mostly centered on occasional scheduling disputes and execution nuances.",
        "pl": "Recenzenci ciepło doceniają groomerki, w tym Kamilę, Wiktorię i Elizę, za cierpliwość, dbałość o detale i profesjonalny kontakt z klientem. Nieliczne uwagi krytyczne dotyczyły głównie kwestii organizacyjnych lub odmiennych oczekiwań co do fryzury pupila."
      },
      "mentions": 21,
      "sentiment": "mixed"
    },
    {
      "topic": "animals",
      "title": {
        "en": "Gentle approach to fearful animals",
        "pl": "Czułe podejście do lękliwych psów"
      },
      "text": {
        "en": "Clients appreciate that treatments are performed calmly without causing distress, noting that even shy shelter adoptees and nervous pets remain relaxed. Dogs leave the grooming table happy, calm, and frequently adorned with decorative ribbons after visits.",
        "pl": "Klienci doceniają, że zabiegi odbywają się w spokojnej atmosferze, dzięki czemu nawet lękliwe psy po przejściach i wrażliwe czworonogi znoszą pielęgnację bez stresu. Zwierzęta opuszczają salon zrelaksowane, często z ozdobną kokardką podarowaną przez personel."
      },
      "mentions": 12,
      "sentiment": "positive"
    }
  ],
