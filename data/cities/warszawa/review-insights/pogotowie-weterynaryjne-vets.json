  "cards": [
    {
      "topic": "staff",
      "title": {
        "en": "Experienced 24/7 doctors and warm team",
        "pl": "Doświadczeni lekarze dyżurni i pomocny zespół"
      },
      "text": {
        "en": "Clients give overwhelming praise to the medical team, singling out doctors such as Dr. Jarek and Dr. Iwona for their clinical excellence, calm guidance, and reassuring communication. Pet parents appreciate that staff remain deeply attentive day and night.",
        "pl": "Klienci z ogromnym uznaniem wypowiadają się o tutejszych lekarzach, wyróżniając między innymi doktora Jarka i doktor Iwonę za wiedzę, spokój i rzeczowe wyjaśnienia. Opiekunowie doceniają pełną empatii postawę personelu w dzień oraz podczas dyżurów nocnych."
      },
      "mentions": 38,
      "sentiment": "positive"
    },
    {
      "topic": "results",
      "title": {
        "en": "Life-saving emergency surgeries and care",
        "pl": "Ratujące życie operacje i leczenie szpitalne"
      },
      "text": {
        "en": "Reviewers emphasize vital medical and surgical interventions, including urgent exploratory laparotomies, bone fracture repairs, and pancreatitis management. Handlers credit the clinic with pulling critically ill animals back from life-threatening situations.",
        "pl": "Recenzenci opisują skuteczne zabiegi operacyjne i hospitalizację, w tym pilne laparotomie zwiadowcze, operacje złamań oraz leczenie ostrego zapalenia trzustki. Właściciele dziękują lecznicy za uratowanie życia ciężko chorym czworonogom w stanach zagrożenia."
      },
      "mentions": 17,
      "sentiment": "positive"
    },
    {
      "topic": "waiting",
      "title": {
        "en": "Prompt emergency intake and round-the-clock aid",
        "pl": "Sprawne przyjęcia nagłe i dyżur całodobowy"
      },
      "text": {
        "en": "Pet owners value that the emergency hospital operates continuously 24/7, admitting urgent cases with minimal delay even in the middle of the night. Swift phone responses and rapid on-site triage allow critical pets to receive immediate necessary attention.",
        "pl": "Właściciele zwierząt bardzo doceniają całodobowy tryb pracy pogotowia, który umożliwia natychmiastowe przyjęcie nagłych pacjentów bez zbędnego czekania w nocy. Szybki kontakt telefoniczny i sprawna ocena stanu pupila pozwalają na błyskawiczne wdrożenie pomocy."
      },
      "mentions": 10,
      "sentiment": "positive"
    }
  ],
