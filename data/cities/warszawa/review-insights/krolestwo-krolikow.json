  "cards": [
    {
      "topic": "staff",
      "title": {
        "en": "Specialized rabbit carers and groomers",
        "pl": "Wyspecjalizowane opiekunki i króliczy groomerzy"
      },
      "text": {
        "en": "Rabbit owners warmly commend the staff for their profound understanding of rabbit psychology, delicate touch during nail trims, and skilled dematting. The team provides attentive post-operative support and thorough daily photo updates during hotel stays, ensuring complete peace of mind for guardians traveling away from home.",
        "pl": "Właściciele uszaków serdecznie chwalą personel za doskonałą znajomość psychologii królików, delikatność przy obcinaniu pazurków oraz wprawne strzyżenie. Zespół zapewnia troskliwą opiekę także po zabiegach kastracji i regularne fotorelacje z hotelu, dając opiekunom pełen spokój ducha podczas wyjazdów poza miasto."
      },
      "mentions": 22,
      "sentiment": "positive"
    },
    {
      "topic": "place",
      "title": {
        "en": "Dedicated boarding hotel and shop",
        "pl": "Dedykowany hotelik oraz bogaty sklep"
      },
      "text": {
        "en": "Reviewers emphasize the impeccably clean, spacious pens tailored specifically for lagomorphs, avoiding the stress of typical mixed-pet boarding facilities. Visitors also highlight the well-curated on-site shop, stocked with premium herbal blends, healthy treats, high-grade hay, and natural foraging supplies.",
        "pl": "Klienci podkreślają nienaganną czystość i przestronne kojce dostosowane specjalnie do potrzeb królików, co pozwala uniknąć stresu znanego z tradycyjnych hoteli dla zwierząt. Bardzo chwalony jest również świetnie zaopatrzony sklep stacjonarny oferujący jakościowe sianka, zioła, zdrowe przysmaki i akcesoria."
      },
      "mentions": 22,
      "sentiment": "positive"
    },
    {
      "topic": "animals",
      "title": {
        "en": "Safe environment for timid rabbits",
        "pl": "Bezpieczne środowisko dla płochliwych uszaków"
      },
      "text": {
        "en": "Guardians of particularly shy, fearful, or fragile rabbits express gratitude for the gentle handling that prioritizes the comfort and low-stress experience of each animal. Bunnies leave grooming sessions calm and groomer-friendly, while hotel guests settle peacefully into their pens and eat their meals without tension.",
        "pl": "Opiekunowie lękliwych i wrażliwych uszaków wyrażają wdzięczność za niezwykle łagodne podejście, które minimalizuje stres podczas zabiegów pielęgnacyjnych. Króliki opuszczają zabiegi wyczesania i strzyżenia spokojne, a goście hotelowi szybko adaptują się w kojcach, chętnie jedzą posiłki i czują się bezpiecznie."
      },
      "mentions": 22,
      "sentiment": "positive"
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What rabbit services are provided at Królestwo Królików?",
        "pl": "Jakie usługi dla królików oferuje Królestwo Królików?"
      },
      "a": {
        "en": "The facility provides dedicated rabbit boarding hotel services, grooming and nail clipping, rabbit bonding assistance, and an herb shop.",
        "pl": "Ośrodek oferuje specjalistyczny hotelik dla królików, zabiegi pielęgnacyjne i obcinanie pazurków, łączenie uszaków w pary oraz sklep zoologiczny."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pet parents receive updates during boarding?",
        "pl": "Czy właściciele otrzymują relacje podczas pobytu królika w hotelu?"
      },
      "a": {
        "en": "Yes, reviews frequently praise the detailed daily messages, photos, and videos sent to guardians.",
        "pl": "Tak, recenzje bardzo chwalą codzienne wiadomości, zdjęcia oraz filmiki przesyłane opiekunom."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is post-operative or medical care available?",
        "pl": "Czy możliwa jest opieka nad królikiem po zabiegach medycznych?"
      },
      "a": {
        "en": "Yes, the team handles medication administration, feeding support, and convalescence care after sterilization or illness.",
        "pl": "Tak, personel ma doświadczenie w podawaniu leków, dokarmianiu oraz opiece nad uszakami po sterylizacji i w trakcie rekonwalescencji."
      },
      "basis": "reviews"
    }
