  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 52,
      "title": {
        "en": "Warm and dedicated grooming specialists",
        "no": "Varme og dedikerte hundefrisører"
      },
      "text": {
        "en": "Pet owners express overwhelming appreciation for Alba and Paulina at Oppsal. Clients praise their genuine warmth, high professionalism, and welcoming hospitality. Many dog owners note that they have followed the stylists for years and consider them like trusted family members.",
        "no": "Hundeeiere uttrykker overstrømmende begeistring for Alba og Paulina på Oppsal. Kunder fremhever deres ekte varme, høye fagkompetanse og imøtekommende vesen. Mange faste kunder forteller at de har fulgt frisørene i flere år og betrakter dem som trygge støttespillere for dyrene."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "en": "Patience with scared and young dogs",
        "no": "Tålmodighet med redde og unge hunder"
      },
      "text": {
        "en": "Guardians highlight the extraordinarily calm and reassuring handling of dogs inside the salon. Even puppies experiencing their first scissors or older dogs who normally dislike grooming remain relaxed and content, walking out cheerful, proud, and completely unhurried.",
        "no": "Hundeeiere legger vekt på den ekstraordinært rolige og trygge behandlingen i salongen på Oppsal. Både unge valper som møter saksa for første gang og hunder som misliker pelsstell, forholder seg rolige og fornøyde, og forlater lokalet trygge, logrende og helt uten stress."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "en": "Flawless haircuts and coat care",
        "no": "Plettfri klipp og nydelig pelsstell"
      },
      "text": {
        "en": "Reviewers consistently commend the beautiful aesthetic outcome of cuts, trims, and fur washes. Whether preparing show poodles or giving hunting spaniels functional summer clips, owners praise the clean lines, fragrant coats, and neatly trimmed nails that dogs receive.",
        "no": "Anmeldere roser jevnlig det vakre håndverket bak klipp, stuss og vask. Enten det gjelder forberedelse av utstillingspudler eller praktisk sommerklipp på jaktspaniels, trekker eiere frem de jevne linjene, den velduftende pelsen og pent trimmede klør etter hver behandling."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Where is Eira Hundesalong located?",
        "no": "Hvor holder Eira Hundesalong til?"
      },
      "a": {
        "en": "The salon is located at Vetlandsveien 123 at Oppsal Senter in eastern Oslo.",
        "no": "Salongen ligger i Vetlandsveien 123 på Oppsal Senter øst i Oslo."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do the groomers handle dogs that fear scissors or baths?",
        "no": "Hvordan håndterer frisørene hunder som er redde for saks eller bad?"
      },
      "a": {
        "en": "Reviewers highlight great patience and calm techniques that help anxious dogs relax.",
        "no": "Anmeldere fremhever stor tålmodighet og rolige metoder som hjelper urolige hunder å finne trygghet."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can puppies get introductory grooming sessions?",
        "no": "Tilbyr salongen tilvenning for valper?"
      },
      "a": {
        "en": "Yes, groomers offer gentle puppy sessions focused on positive acclimatization to grooming.",
        "no": "Ja, frisørene tilbyr skånsom valpeklipp med fokus på en trygg og positiv førstegangsopplevelse."
      },
      "basis": "reviews"
