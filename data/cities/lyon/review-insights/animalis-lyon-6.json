  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "fr": "Équipe disponible et conseils attentionnés",
        "en": "Helpful staff and attentive advice"
      },
      "text": {
        "fr": "Les clients mettent en avant un accueil particulièrement agréable et la politesse de l'équipe rue de Sèze. Les conseillers prennent le temps d'orienter les visiteurs vers une alimentation adaptée pour chiens ou chats et répondent volontiers aux questions sur le choix des accessoires du quotidien.",
        "en": "Shoppers regularly praise the warm welcome and polite demeanor of the team on Rue de Sèze. Staff members take time to assist visitors in selecting suitable food for dogs or cats and gladly answer questions regarding everyday pet care, accessories, and feeding supplies."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "fr": "Boutique de quartier claire et bien achalandée",
        "en": "Well-stocked neighborhood store in central location"
      },
      "text": {
        "fr": "Le magasin est apprécié pour son agencement soigné, son ambiance calme et son implantation pratique dans le 6e arrondissement. Les maîtres y trouvent l'essentiel pour leurs compagnons, même si un avis isolé a signalé une rupture temporaire sur certaines croquettes en rayon.",
        "en": "The shop is valued for its tidy layout, calm shopping atmosphere, and convenient location in Lyon's 6th arrondissement. Pet owners readily find daily essentials for their animals, though an occasional review noted a brief out-of-stock situation on specific kibble brands."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 5,
      "title": {
        "fr": "Articles variés pour chiens, chats et rongeurs",
        "en": "Varied supplies for dogs, cats, and rodents"
      },
      "text": {
        "fr": "Les propriétaires apprécient la diversité des articles proposés pour les félins, les canidés et les petits animaux. Les friandises, le foin de qualité et les jouets en bois pour lapins nains reçoivent de bons retours, bien que le rayon rongeurs puisse encore s'étoffer.",
        "en": "Pet guardians appreciate the variety of products available for felines, dogs, and small domestic animals. Tasty treats, good quality hay, and wooden toys for dwarf rabbits receive positive feedback, although some feel the small mammal aisle could offer broader selections."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "fr": "Le magasin propose-t-il le retrait en boutique ?",
        "en": "Does the store offer in-store pickup?"
      },
      "a": {
        "fr": "Oui, les commandes passées en ligne peuvent être retirées sur place grâce au service Click and Collect en deux heures.",
        "en": "Yes, orders placed online can be picked up at the store within two hours via the Click and Collect service."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Trouve-t-on des produits pour les lapins et petits rongeurs ?",
        "en": "Are products available for rabbits and small rodents?"
      },
      "a": {
        "fr": "Oui, le magasin propose du foin, de la litière et des friandises adaptés aux lapins nains et petits rongeurs.",
        "en": "Yes, the store carries hay, bedding, and specialized treats tailored for dwarf rabbits and small rodents."
      },
      "basis": "both"
    },
    {
      "q": {
        "fr": "Les chiens sont-ils admis à l'intérieur du magasin ?",
        "en": "Are dogs allowed inside the shop?"
      },
      "a": {
        "fr": "Oui, les animaux tenus en laisse sont les bienvenus avec leurs maîtres pendant les achats.",
        "en": "Yes, pets kept on leash are warmly welcomed to accompany their owners while shopping."
      },
      "basis": "reviews"
    }
  ],
