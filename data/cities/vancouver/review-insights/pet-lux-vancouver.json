  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Attentive and caring grooming professionals"
      },
      "text": {
        "en": "Pet owners consistently praise groomers Sahar, Jina, Kristy, and Zara for their patience, warmth, and attentive customer service on Pacific Street. Clients appreciate that the stylists listen carefully to styling preferences and explain procedures clearly. Reviewers describe the staff as dedicated individuals who make both pets and owners feel at ease."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Expert coat styling with rare lapses"
      },
      "text": {
        "en": "Most reviewers are delighted with the grooming outcomes, commending tidy scissor cuts, fluffy washes, and dematting treatments for dogs and long-haired cats. Clients appreciate the thoughtful complimentary bow tie accessories. Nevertheless, two visitors reported dissatisfaction with an uneven ear trim and an incomplete nail and hygiene treatment."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Gentle handling for cats and dogs"
      },
      "text": {
        "en": "Clients frequently highlight the team's exceptional skill with sensitive, rescue, and senior pets. Reviewers note that cats who dislike water or brushing are handled with calm reassurance, safely clearing heavy mats without panic. Dog owners similarly report that anxious pups leave the Yaletown salon relaxed, content, and wagging their tails."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Pet Lux Vancouver groom cats?"
      },
      "a": {
        "en": "Yes, the salon provides specialized cat grooming, including bathing, dematting, sanitary trims, and nail clipping."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the team handle rescue or anxious pets?"
      },
      "a": {
        "en": "Reviewers emphasize that groomers work patiently and gently, successfully keeping nervous cats and dogs calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can clients book grooming appointments online?"
      },
      "a": {
        "en": "Yes, appointments can be requested online through the salon's website or by telephone."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "What finishing touch do pets receive after grooming?"
      },
      "a": {
        "en": "Clients appreciate that groomers often add a cute bow or bow tie to pets' collars after completing their groom."
      },
      "basis": "reviews"
    }
