  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Tidy breed haircuts and grooming"
      },
      "text": {
        "en": "Dog and cat owners consistently praise the salon for neat haircuts, fresh-smelling coats, and skillful nail trims across diverse breeds. Clients commend Victor and Patricia for meticulous styling on poodles, schnauzers, and long-haired cats, though two reviews reported an uneven trim or minor injury during appointments."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Attentive groomers with reception complaints"
      },
      "text": {
        "en": "The majority of reviewers describe the family-run team as warm, patient, and deeply dedicated to companion animal welfare. Long-term visitors appreciate that staff accommodate senior pets and handle cumbersome dogs calmly, while isolated complaints mention poor phone customer service from management and rushed handling."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Gentle approach for anxious companions"
      },
      "text": {
        "en": "Pet guardians appreciate that groomers take time to comfort nervous dogs, senior cats, and pets that typically resist grooming tables. Many clients report that their companions leave relaxed and cheerful, although one owner noted distress during handling of a dog with hip dysplasia and another cited a bleeding paw."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Pet Parlour groom cats as well as dogs?"
      },
      "a": {
        "en": "Yes, clients frequently bring both short-haired and long-haired cats, including senior Persian cats, for de-matting and styling."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does the Cambie Street facility offer self-serve pet washing?"
      },
      "a": {
        "en": "Yes, the shop features self-serve dog wash stations alongside full-service professional styling and daycare options."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "How long does a standard dog grooming session take?"
      },
      "a": {
        "en": "Routine nail clipping and express trims can take fifteen minutes, while full haircuts typically take a few hours depending on coat condition."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are senior pets accommodated for grooming appointments?"
      },
      "a": {
        "en": "Yes, many pet owners bring older dogs and cats, though owners of pets with chronic joint conditions recommend discussing handling requirements in advance."
      },
      "basis": "reviews"
    }
  ],
