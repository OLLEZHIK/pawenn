  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Dedicated veterinarians and warm reception team"
      },
      "text": {
        "en": "Pet owners enthusiastically commend Dr. Michelle Chen and Dr. Rebecca Burke alongside receptionists Jenny and Sana for their expertise, kindness, and unhurried approach. Reviewers appreciate that the veterinarians take time to explain medical issues in clear, jargon-free terms and never push unnecessary diagnostics. Clients note that the entire team treats pets like family, creating a supportive clinical experience."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Fear-free approach for anxious animals"
      },
      "text": {
        "en": "Clients highlight the clinic's exceptional patience with nervous, rescue, and reactive pets. Reviewers describe how veterinarians adapt exams to the animal's comfort, examining cats on the floor or in carriers and letting anxious dogs proceed at their own pace. Multiple owners share that pets who previously dreaded clinical visits felt relaxed, curious, and eager to interact with the team."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "en": "Welcoming, modern, and spotless facility"
      },
      "text": {
        "en": "Visitors frequently praise the clinic's thoughtful design, noting the beautiful decor, immaculately clean exam rooms, and calming ambiance. Clients appreciate hospitable hospitality touches including complimentary beverages, comfortable seating, and personalized greeting notes for their pets. Reviewers emphasize that the peaceful atmosphere helps keep both animals and owners at ease."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Woodland Veterinary Clinic use fear-free handling methods?"
      },
      "a": {
        "en": "Yes, the clinical team uses low-stress, fear-free techniques, examining animals wherever they feel most comfortable and adapting to nervous or reactive pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the clinic open for appointments on weekends?"
      },
      "a": {
        "en": "Yes, Woodland Veterinary Clinic operates on weekends, including Sunday hours for scheduled consultations and urgent care needs."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the clinic handle treatment estimates and costs?"
      },
      "a": {
        "en": "The veterinarians provide clear, upfront estimates before performing procedures and avoid ordering unnecessary diagnostic tests."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What amenities are available for pet owners during visits?"
      },
      "a": {
        "en": "The clinic offers a welcoming lounge area with complimentary refreshments such as coffee and flavored water for visiting pet owners."
      },
      "basis": "reviews"
    }
