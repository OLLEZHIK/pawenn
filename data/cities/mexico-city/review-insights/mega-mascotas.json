  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 90,
      "title": {
        "es": "Asesoría experta y atención personalizada",
        "en": "Expert guidance and personalized assistance"
      },
      "text": {
        "es": "Los visitantes de la tienda en Portales Norte elogian de manera constante el trato amable y servicial del equipo. Destacan en repetidas ocasiones la orientación de asesores como Harrison, quienes brindan recomendaciones precisas sobre alimentación y accesorios según cada mascota.",
        "en": "Visitors to the store in Portales Norte consistently praise the friendly and helpful customer service. Reviewers frequently highlight the practical advice of staff members like Harrison, who provide tailored recommendations for specialized pet diets and pet supplies."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "es": "Amplio surtido para mascotas y acuarios",
        "en": "Extensive pet selection and aquarium supplies"
      },
      "text": {
        "es": "Los compradores valoran la extensa variedad de artículos disponibles en Mega Mascotas en Benito Juárez. Resaltan la disponibilidad de alimentos medicados, accesorios para perros y gatos, así como equipamiento completo y acondicionadores para peceras y estanques acuáticos.",
        "en": "Shoppers appreciate the wide variety of items stocked at Mega Mascotas in Benito Juárez. They emphasize the availability of prescription pet food, everyday accessories for dogs and cats, as well as comprehensive filtration equipment and water conditioners for aquariums."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "es": "Precios competitivos y convenientes",
        "en": "Competitive and affordable retail prices"
      },
      "text": {
        "es": "Diversos clientes consideran que los precios en la tienda física y en línea son accesibles en comparación con otros establecimientos de la zona. Subrayan la excelente relación entre costo y calidad en marcas especializadas de croquetas, juguetes e insumos para el mantenimiento de peces.",
        "en": "Multiple clients find that prices both in-store and online remain budget-friendly compared to competing shops in the area. They highlight good overall value across premium kibble brands, companion animal toys, and supplies needed for fish tank and aquatic pond care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Mega Mascotas cuenta con productos especializados para acuarios y peces?",
        "en": "Does Mega Mascotas stock specialized equipment for fish tanks and aquariums?"
      },
      "a": {
        "es": "Sí, disponen de peceras, filtros, acondicionadores de agua y alimento para peces de agua dulce y marina.",
        "en": "Yes, they provide glass tanks, filtration units, water conditioners, and fish foods."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Ofrecen servicio de entrega a domicilio para compras de tienda?",
        "en": "Do they provide home delivery services for pet supplies?"
      },
      "a": {
        "es": "Sí, cuentan con cobertura de envíos para pedidos de alimento, accesorios y equipamiento para mascotas.",
        "en": "Yes, they offer delivery options across Mexico for pet food, aquatic products, and pet gear."
      },
      "basis": "website"
    },
    {
      "q": {
        "es": "¿El personal brinda orientación para elegir alimento medicado?",
        "en": "Does the staff assist customers with specialized or prescription pet food?"
      },
      "a": {
        "es": "Sí, los usuarios destacan la disposición del personal para recomendar opciones dietéticas adecuadas para perros y gatos.",
        "en": "Yes, reviewers highlight knowledgeable employees who help choose suitable dietary choices for dogs and cats."
      },
      "basis": "reviews"
    }
  ],
