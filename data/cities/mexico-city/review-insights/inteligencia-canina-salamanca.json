  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "es": "Afecto continuo y equipo capacitado",
        "en": "Consistent warmth and qualified staff"
      },
      "text": {
        "es": "Decenas de tutores en la colonia Roma Norte elogian el cariño y la entrega de coordinadoras como Sarai y Karen. Destacan la amabilidad al recibir a las mascotas y el envío frecuente de fotos y videos durante el hospedaje, aunque una minoría señala fricciones en el trato inicial.",
        "en": "Dozens of pet guardians in Roma Norte praise the warmth and dedication of coordinators like Sarai and Karen. They highlight the friendly greeting given to pets and frequent photo updates during boarding, though a small minority mentions occasional friction during reception."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "es": "Socialización divertida y perros consentidos",
        "en": "Fun socialization and pampered dogs"
      },
      "text": {
        "es": "Los usuarios celebran que sus compañeros caninos disfruten plenamente de la guardería diurna y salgan contentos tras jugar con otros perros. Señalan que incluso animales tímidos o nerviosos logran integrarse con tranquilidad, recibiendo atenciones cuidadosas durante cada estancia.",
        "en": "Clients celebrate that their canine companions thoroughly enjoy daytime daycare and leave happy after playing with other dogs. They note that even timid or nervous pets integrate smoothly into the pack, receiving attentive and affectionate care throughout each boarding stay."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 6,
      "title": {
        "es": "Cambios de conducta con opiniones diversas",
        "en": "Behavioral improvements with varied reviews"
      },
      "text": {
        "es": "Múltiples clientes observan avances notables en la disciplina y tranquilidad de sus perros, facilitando la convivencia cotidiana y los paseos con correa. Sin embargo, un par de reseñas críticas considera que la instrucción fue insuficiente frente al costo invertido en el curso.",
        "en": "Multiple pet owners observe noticeable progress in their dogs' obedience and demeanor, making daily coexistence and leash walks much easier. However, a couple of critical reviews argue that the instruction provided did not meet expectations given the tuition paid for the course."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "es": "¿Envían fotografías y videos durante el hospedaje de las mascotas?",
        "en": "Do they provide photos and videos during pet boarding stays?"
      },
      "a": {
        "es": "Sí, numerosos clientes confirman que el personal envía videos y fotos periódicas sobre las actividades de sus perros.",
        "en": "Yes, numerous clients confirm that staff regularly provide videos and photos documenting their dogs' activities."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "es": "¿Se requiere reservación previa para el servicio de hotel?",
        "en": "Is an advance booking required for dog boarding services?"
      },
      "a": {
        "es": "Sí, se recomienda programar una cita con anticipación para revisar esquemas sanitarios y coordinar el ingreso.",
        "en": "Yes, scheduling an appointment in advance is advised to verify health records and coordinate arrival."
      },
      "basis": "both"
    },
    {
      "q": {
        "es": "¿Qué modalidades de educación canina manejan en Salamanca?",
        "en": "What canine training programs are offered at Salamanca?"
      },
      "a": {
        "es": "Ofrecen cursos de obediencia básica y avanzada, adiestramiento a domicilio y corrección de hábitos de conducta.",
        "en": "They provide basic and advanced obedience training, in-home instruction, and behavioral modification."
      },
      "basis": "website"
    }
  ],
