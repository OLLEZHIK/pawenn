    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Knowledgeable and compassionate clinic staff"
      },
      "text": {
        "en": "Pet owners frequently commend the veterinary team and front desk staff for their helpfulness, friendliness, and dedication. Clients appreciate that vets such as Ruth, Fiona, and Jennifer take time to explain treatment plans clearly and provide practical guidance. Multiple reviewers note that the team goes above and beyond during challenging appointments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Renowned care for exotic species"
      },
      "text": {
        "en": "The hospital is widely recognized for its specialized care of rabbits, guinea pigs, ferrets, hamsters, reptiles, birds, and small rodents alongside dogs and cats. Clients highlight gentle handling techniques and deep familiarity with delicate exotic species. Pet parents appreciate having access to knowledgeable practitioners for less common animals."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 7,
      "title": {
        "en": "Effective treatments and surgical care"
      },
      "text": {
        "en": "Reviewers report dependable medical outcomes for complex treatments, including life-saving interventions for ferrets and rabbits, routine vaccinations, and abscess drainage. While one client reported a traumatic procedure involving a reptile, the vast majority of pet parents express strong trust in the hospital surgical competence and recovery support."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Palmerstown Veterinary Hospital treat exotic pets?"
      },
      "a": {
        "en": "Yes, the practice is widely known for treating exotic animals, including rabbits, ferrets, reptiles, birds, rodents, and hedgehogs."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How can appointments be arranged?"
      },
      "a": {
        "en": "Appointments can be booked using the PetsApp mobile platform, online, or by phoning the hospital directly."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is on-site car parking available?"
      },
      "a": {
        "en": "Yes, clients mention that ample car parking is available adjacent to the hospital building."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What are the hospital weekend opening hours?"
      },
      "a": {
        "en": "The hospital is open on both Saturdays and Sundays from 9:30 to 16:30 for scheduled appointments and urgent cases."
      },
      "basis": "website"
    }
