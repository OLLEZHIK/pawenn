    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "en": "Supportive and approachable veterinary team"
      },
      "text": {
        "en": "Pet owners frequently highlight the kindness, dedication, and clinical expertise of the veterinarians and nursing staff. Clients appreciate that practitioners take time to discuss options and guide families through stressful medical situations. While an occasional review notes rushed interactions during emergencies, most praise the compassionate support."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Successful surgeries and referral treatments"
      },
      "text": {
        "en": "Clients report positive medical outcomes for complex procedures, including orthopaedic surgeries, CT scans, and emergency stabilisations. Reviewers appreciate that veterinary surgeons follow up closely throughout recovery. Although a few pet owners report severe diagnostic complications, the majority express confidence in the hospital medical capabilities."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Gentle care for companion animals"
      },
      "text": {
        "en": "Reviewers frequently describe how gently and patiently their dogs and cats are treated during consultations and hospital stays. Owners of reactive or nervous pets emphasize that staff remain calm and help animals feel secure. Pet parents value the thoughtful attention shown to animals during end-of-life care and long-term treatments."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does MyVet Lucan offer out-of-hours emergency care?"
      },
      "a": {
        "en": "Yes, the hospital operates a dedicated 24/7 emergency service with on-site veterinary and nursing staff."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What referral services are provided at the clinic?"
      },
      "a": {
        "en": "The facility provides specialised referrals in orthopaedic surgery, soft tissue surgery, and advanced CT diagnostic imaging."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners book routine appointments online?"
      },
      "a": {
        "en": "Yes, appointments for standard checkups and routine treatments can be booked online via the MyVet website."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Are cat-friendly consultations available?"
      },
      "a": {
        "en": "Yes, the practice is accredited as a cat-friendly clinic with dedicated facilities for feline patients."
      },
      "basis": "website"
    }
