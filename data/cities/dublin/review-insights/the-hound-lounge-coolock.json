  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 52,
      "title": {
        "en": "Friendly and attentive salon team"
      },
      "text": {
        "en": "Clients express great appreciation for groomers Kasey, Dayna, and the salon team. Visitors highlight that the groomers are lovely to deal with, offer attentive customer service, and communicate clearly by sending collection notifications when dogs are ready to be picked up."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Impeccable styling and fresh grooming"
      },
      "text": {
        "en": "Dog owners frequently praise the salon for high quality haircuts, wash and blow-dry treatments, and neat nail trimming. Reviewers regularly report that their dogs emerge looking dapper, smelling fantastic, and sporting cute finishing bows, with coat styling executed exactly as requested."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Gentle approach for first-time puppies"
      },
      "text": {
        "en": "Multiple pet parents highlight how calm and cheerful their dogs remain throughout their grooming sessions. Reviews note particular success with first-time puppy grooms, large breeds, and shy or nervous rescue dogs who are handled with reassurance and genuine patience."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Where is The Hound Lounge located in Coolock?"
      },
      "a": {
        "en": "The salon is located on Greencastle Parade within the Malahide Road Industrial Park in Dublin 17."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Do the groomers cater to shy or nervous dogs?"
      },
      "a": {
        "en": "Yes, clients frequently mention that anxious dogs and young puppies are handled with gentleness and patience."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are owners notified when grooming is finished?"
      },
      "a": {
        "en": "Staff provide advance collection alerts, typically contacting owners about 15 minutes before their dog is ready."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is on-site parking available for customer drop-offs?"
      },
      "a": {
        "en": "Yes, convenient parking spaces are accessible right outside the industrial park salon unit."
      },
      "basis": "both"
    }
  ],
