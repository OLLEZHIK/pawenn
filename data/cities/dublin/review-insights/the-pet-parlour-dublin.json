        "en": "Does The Pet Parlour deliver pet food across Ireland?"
      },
      "a": {
        "en": "Yes, reviewers highlight fast local courier deliveries within Dublin as well as reliable nationwide shipping across Ireland."
      },
      "basis": "reviews"
    },
