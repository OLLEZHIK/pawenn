  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Calm and gentle pet handling"
      },
      "text": {
        "en": "Pet parents highlight the team's soothing approach with senior dogs, energetic puppies, and nervous rescue animals, with one owner noting their dog fell asleep during styling. Dogs commonly emerge relaxed, happy, and wagging their tails after both grooming and daycare sessions. Owners express great confidence leaving anxious pets in the care of groomers who clearly love animals."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "en": "Precision styling and puppy packages"
      },
      "text": {
        "en": "Clients frequently praise the high styling standards at Zoomies, remarking that dogs return with neat breed haircuts, clean coats, and cute bandanas. Pet owners appreciate full grooms, puppy introductory sessions, and deshedding baths. While two reviewers were unhappy with severe clipping and shaving unevenness, the overwhelming majority describe immaculate cuts and handsome styling results."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Friendly and attentive grooming team"
      },
      "text": {
        "en": "Reviewers warmly commend the team, specifically praising groomers Reese, Lauren, and Niamh for listening carefully to coat preferences and explaining grooming plans beforehand. Clients highlight the warm reception and frequent photo updates provided for daycare dogs. Despite an isolated complaint regarding dispute resolution, most owners praise the staff's dedication and responsiveness."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Zoomies provide dog daycare in addition to grooming?"
      },
      "a": {
        "en": "Yes, the facility offers structured dog daycare with supervised play and regular photo updates sent to owners."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the team accommodate anxious or nervous dogs?"
      },
      "a": {
        "en": "Reviewers note that groomers use gentle and patient handling, helping nervous rescues and timid pets settle comfortably."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners discuss specific styling lengths beforehand?"
      },
      "a": {
        "en": "Yes, clients appreciate consultations where groomers review coat condition and listen to desired haircut lengths."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is online booking supported for appointments?"
      },
      "a": {
        "en": "Yes, clients frequently mention the convenience of booking grooming and daycare visits through the online system."
      },
      "basis": "both"
    }
  ],
