  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 154,
      "title": {
        "en": "Dedicated medical specialists and technicians"
      },
      "text": {
        "en": "Many reviewers express deep gratitude for oncologists, neurologists, surgeons, and intensive care nurses who treat complicated cases with skill and empathy. Clients note that clinicians provide thorough consults and demonstrate genuine warmth toward stressed families. Although several pet owners experienced detached communication, the prevailing view highlights devoted clinical teams."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 105,
      "title": {
        "en": "Attentive care for critically ill patients"
      },
      "text": {
        "en": "Owners highlight the thoughtful handling provided to hospitalised pets during chemotherapy, post-surgical recovery, and emergency triage. Clients appreciate that veterinary nurses comfort anxious animals, keep bedding clean, and offer gentle reassurance during stressful stays. Reviewers report feeling confident leaving their dogs and cats in the care of attentive hospital personnel."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 43,
      "title": {
        "en": "Specialised surgical and medical outcomes"
      },
      "text": {
        "en": "Pet parents report favourable recoveries following intricate orthopaedic operations, spinal surgeries, and oncology treatments. Many clients credit timely diagnoses and emergency interventions with preserving their pets' quality of life through serious illnesses. While a few reviewers faced disappointing outcomes or complicated diagnoses, most celebrate successful clinical treatments."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Veterinary Specialty Hospital Sorrento Valley operate 24-hour emergency care?"
      },
      "a": {
        "en": "Yes, clients confirm the facility is open 24 hours daily for urgent veterinary trauma and emergency consultations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "What veterinary specialities are available at this hospital?"
      },
      "a": {
        "en": "Reviewers report accessing internal medicine, veterinary oncology, neurology, cardiology, and orthopaedic surgery."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are advanced imaging services like MRI and CT scans performed on-site?"
      },
      "a": {
        "en": "Yes, specialists utilise on-site magnetic resonance imaging and computed tomography scans for diagnostic evaluations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners receive daily updates when pets are hospitalised overnight?"
      },
      "a": {
        "en": "Yes, nursing teams and attending specialists provide telephone status updates on hospitalised animals."
      },
      "basis": "reviews"
    }
  ],
