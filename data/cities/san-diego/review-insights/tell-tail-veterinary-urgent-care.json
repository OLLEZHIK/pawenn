      "q": {
        "en": "Are payment plans available for unexpected medical bills?"
      },
      "a": {
        "en": "Reviewers mention that interest-free financing options are offered, though emergency deposits may be required upon admission."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are patient wait times determined at the clinic?"
      },
      "a": {
        "en": "Arrivals are triaged based on clinical severity, with critical emergencies taken back immediately while stable cases wait longer."
      },
