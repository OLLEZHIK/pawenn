  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 174,
      "title": {
        "en": "Attentive specialists and nursing personnel"
      },
      "text": {
        "en": "Many clients commend the veterinary oncologists, surgeons, and emergency attendants for their clinical competence and reassurance during acute health scares. Reviewers appreciate that doctors spend time answering intricate medical questions and tailoring recovery regimens. Although several pet owners noted rushed interactions or delayed follow-ups, most describe a compassionate hospital team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 130,
      "title": {
        "en": "Compassionate handling for vulnerable pets"
      },
      "text": {
        "en": "Owners consistently praise the gentle care shown to dogs and cats undergoing intensive hospitalisation or complex post-operative monitoring. Pet parents report that veterinary nurses sit with frightened animals, comfort recovering patients, and maintain meticulous hygiene. Families observe that their vulnerable companions receive genuine affection from the clinical staff."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "en": "Successful surgical interventions and treatments"
      },
      "text": {
        "en": "Pet owners report encouraging outcomes for complex orthopaedic repairs, spinal stabilisations, and ongoing cancer therapies. Many reviewers recount how emergency diagnostic scans and prompt interventions stabilised animals facing life-threatening conditions. While a minority of clients experienced rapid clinical declines or bereavement, most report significant improvements in pet health."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Veterinary Specialty Hospital North County offer 24/7 emergency services?"
      },
      "a": {
        "en": "Yes, clients confirm the hospital provides round-the-clock emergency triage, critical care, and diagnostic assessments."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pets receive specialised oncology and chemotherapy treatments here?"
      },
      "a": {
        "en": "Yes, pet owners report working with veterinary oncologists for cancer diagnoses, chemotherapy protocols, and staging."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are advanced orthopaedic surgeries like TPLO performed on-site?"
      },
      "a": {
        "en": "Yes, board-certified surgeons routinely carry out cruciate ligament repairs, fracture stabilisations, and joint surgeries."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are urgent emergency cases prioritised upon arrival?"
      },
      "a": {
        "en": "Staff perform triage upon arrival to ensure critically unwell animals receive immediate medical attention ahead of stable cases."
      },
      "basis": "reviews"
    }
  ],
