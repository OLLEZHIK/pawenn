  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 80,
      "title": {
        "en": "Compassionate emergency veterinary clinicians"
      },
      "text": {
        "en": "Pet owners consistently commend the emergency veterinarians and nurses for their empathy, reassurance, and thoroughness during critical situations. Reviewers appreciate that clinicians explain care plans in detail and allow families to remain beside their animals. While several clients reported rigid financial interactions during crises, the vast majority praise the team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 59,
      "title": {
        "en": "Gentle emergency care for distressed pets"
      },
      "text": {
        "en": "Clients highlight the calm, gentle handling provided to injured dogs, trauma cases, and sick cats arriving at all hours. Owners note that staff provide warming blankets, gentle soothing, and stress-free triage to ease animal distress immediately upon arrival. Pet parents describe immense relief seeing their vulnerable companions treated with genuine tenderness."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Transparent updates and medical communication"
      },
      "text": {
        "en": "Pet owners consistently praise clinicians and emergency nurses for their clear explanations and attentive telephone updates throughout treatment. Reviewers appreciate that veterinary teams explain medical options transparently and answer urgent questions with patience. While a few visitors experienced frustration regarding aftercare emails, the consensus highlights dependable communication."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is VEG ER for Pets open for emergencies 24/7?"
      },
      "a": {
        "en": "Yes, clients confirm the hospital operates 24 hours a day with emergency doctors and veterinary nurses on duty."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners stay with their animals during emergency treatment?"
      },
      "a": {
        "en": "Yes, an open-floor design allows owners to remain alongside their pets throughout examinations and medical procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the hospital handle immediate medical triage?"
      },
      "a": {
        "en": "Staff begin assessing vital signs immediately upon arrival in the emergency area without making pets wait in reception."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are emergency surgeries performed on-site at night?"
      },
      "a": {
        "en": "Yes, surgeons and clinical teams perform urgent operations overnight for traumatic injuries and acute conditions."
      },
      "basis": "reviews"
    }
  ],
