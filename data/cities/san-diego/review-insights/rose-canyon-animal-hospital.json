    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Empathetic and communicative veterinary clinicians"
      },
      "text": {
        "en": "Clients frequently commend Dr. Hanks, Dr. Hoard, and Dr. Sanabria alongside the nursing team on Jutland Drive for their thorough consultations and clear explanations. Pet owners appreciate that doctors spend ample time sitting with pets to ease tension, though one client expressed regret over corporate ownership."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Comforting care for anxious pets"
      },
      "text": {
        "en": "Reviewers repeatedly highlight the compassionate touch shown towards elderly pets, nervous rescues, and difficult feral cats. Owners appreciate that clinicians take a gentle approach to routine examinations, though one reviewer was dissatisfied with the heavy sedation prescribed for diagnostic x-rays."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 7,
      "title": {
        "en": "Reliable surgical outcomes and urgent treatments"
      },
      "text": {
        "en": "Pet parents report positive clinical results for complex surgical interventions, including CCL knee repairs, spays with gastropexy, and ear hematoma procedures. Clients value that the hospital resolves persistent infections and oral growths efficiently, helping companion animals regain mobility and health."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the hospital provide weekend urgent care appointments?"
      },
      "a": {
        "en": "Yes, clients note that the clinic offers urgent care appointments on Sundays and weekdays for acute illnesses and sudden injuries."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are complex surgical procedures performed on-site?"
      },
      "a": {
        "en": "Yes, pet owners report successful outcomes for cranial cruciate ligament (CCL) repairs, ear hematoma surgeries, and routine spay operations."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can feral or reactive cats receive treatment here?"
      },
      "a": {
        "en": "Yes, clients commend clinicians like Dr. Hanks for their patient and calm approach when handling fearful or aggressive feral cats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do veterinarians pressure clients into unnecessary diagnostics?"
      },
      "a": {
        "en": "Reviewers specifically highlight that clinicians explain treatment options clearly without pressuring owners into non-essential medical procedures."
      },
      "basis": "reviews"
    }
