  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Dedicated and reassuring veterinary team"
      },
      "text": {
        "en": "The vast majority of clients speak highly of Dr. Polosetski, Dr. Paxton, and support staff such as Forrest, Cesar, and Sarah for their attentive manner and thorough explanations. Reviewers appreciate that the team explains diagnosis options clearly during both routine checks and emergencies. A couple of reviewers felt staff were dismissive during billing or scheduling disputes, but positive feedback dominates."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Gentle handling for nervous pets"
      },
      "text": {
        "en": "Numerous pet parents emphasize the team's thoughtful handling of frightened or anxious animals. Reviewers describe veterinarians conducting exams on the floor to keep trembling dogs calm, as well as taking time to comfort cats and puppies during intake and vaccinations. Owners note that this gentle care significantly reduces stress during medical appointments."
      }
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "mentions": 11,
      "title": {
        "en": "Varied feedback on treatment costs"
      },
      "text": {
        "en": "Many reviewers find the clinic's fees fair and appreciate upfront written estimates before procedures begin, contrasting them favourably with corporate practices. Conversely, several clients express frustration over expensive emergency visits and surprise costs for diagnostic imaging, comparing the billing conversations to sales negotiations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the team accommodate anxious or fearful dogs?"
      },
      "a": {
        "en": "Reviewers mention staff sitting on the floor with nervous dogs and taking extra time during intake to ensure pets feel secure."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pet owners get upfront estimates for procedures?"
      },
      "a": {
        "en": "Yes, many clients confirm that the clinic provides cost breakdowns and seeks approval before proceeding with non-routine treatments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Black Mountain Animal Hospital accommodate short-notice sick visits?"
      },
      "a": {
        "en": "Multiple reviewers report that the clinic squeezed their pets in on the same day for sudden injuries or acute illnesses."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What routine preventative services are commonly mentioned?"
      },
      "a": {
        "en": "Pet parents frequently cite puppy vaccinations, nail trims, wellness examinations, and dental check-ups."
      },
      "basis": "reviews"
