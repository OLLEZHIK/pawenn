  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 68,
      "title": {
        "en": "Knowledgeable and dedicated aquascaping specialists",
        "pl": "Wiedza i zaangażowanie doradców akwarystycznych"
      },
      "text": {
        "en": "Customers enthusiastically praise the staff expertise and dedication, noting specialists like Łukasz and Agnieszka. Advisors actively assist with equipment selection, aquascaping, and solving water chemistry issues. A few visitors mention occasional service delays during busy afternoon store hours.",
        "pl": "Klienci z uznaniem podkreślają wiedzę i pasję personelu, w tym doradców takich jak pan Łukasz czy pani Agnieszka. Pracownicy chętnie pomagają w doborze sprzętu, aranżacji zbiorników oraz rozwiązywaniu problemów z glonami. Nieliczne uwagi dotyczą dłuższego oczekiwania na obsługę w godzinach szczytu."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 59,
      "title": {
        "en": "Inspiring showroom and comprehensive stock",
        "pl": "Inspirujący salon i bogaty asortyment"
      },
      "text": {
        "en": "Visitors admire the extensive showroom display, spotless exhibition aquariums, and comprehensive selection of aquascaping supplies. The store offers complete tank setups, specialized filters, fertilizers, and pond gear, making it a leading aquarium destination across Wrocław.",
        "pl": "Odwiedzający zachwycają się ekspozycją salonu stacjonarnego, czystością zbiorników pokazowych oraz szerokim wyborem asortymentu akwarystycznego. W sklepie można znaleźć kompletne zestawy, filtry, nawozy i akcesoria do oczek wodnych, co czyni go jednym z najpopularniejszych miejsc we Wrocławiu."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Healthy fish and vibrant plants",
        "pl": "Zdrowe ryby i bujne rośliny"
      },
      "text": {
        "en": "Reviewers speak very positively about the health and vitality of freshwater and marine fish, shrimps, and aquarium plants. Specimens are kept in clean, well-filtered quarantine tanks, and keepers highlight excellent survival rates and vibrant condition after transport into home aquariums.",
        "pl": "Recenzenci bardzo pozytywnie oceniają kondycję oferowanych ryb słodkowodnych i morskich, krewetek oraz roślin akwariowych. Zwierzęta przebywają w zadbanych, czystych akwariach kwarantannowych, a kupujący podkreślają wysoką przeżywalność i zdrowie nowych okazów po wpuszczeniu do zbiornika."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are marine fish and live corals available in the store?",
        "pl": "Czy w sklepie można kupić ryby morskie i koralowce?"
      },
      "a": {
        "en": "Yes, customers confirm a specialized marine aquarium section featuring marine fish, corals, and invertebrates.",
        "pl": "Tak, klienci potwierdzają obecność rozbudowanego działu akwarystyki morskiej z rybami i koralowcami."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do staff members help beginners set up their first aquarium?",
        "pl": "Czy pracownicy pomagają w aranżacji pierwszego akwarium?"
      },
      "a": {
        "en": "Yes, reviewers frequently commend patient guidance regarding tank sizing, filtration systems, and plant choices.",
        "pl": "Tak, recenzenci regularnie chwalą cierpliwe doradztwo w doborze zbiornika, filtracji i roślin."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is in-store pickup available for online web orders?",
        "pl": "Czy możliwy jest odbiór zamówień internetowych na miejscu?"
      },
      "a": {
        "en": "Yes, shoppers actively take advantage of smooth in-store pickup for purchases placed via the web shop.",
        "pl": "Tak, kupujący korzystają z wygodnego odbioru zamówień złożonych w sklepie internetowym salonu."
      },
      "basis": "reviews"
    }
  ],
