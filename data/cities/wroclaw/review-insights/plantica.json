  "cards": [
    {
      "topic": "place",
      "sentiment": "mixed",
      "mentions": 42,
      "title": {
        "en": "Great showroom but mixed online packaging",
        "pl": "Świetny salon lecz zróżnicowane pakowanie"
      },
      "text": {
        "en": "Customers appreciate the rich selection of aquatic plants, hardscape stones, driftwoods, and technical gear in the showroom. However, online shoppers raise notable concerns regarding inventory discrepancies and the packaging quality of delicate goods during courier transportation.",
        "pl": "Klienci doceniają bogaty wybór roślin akwariowych, korzeni, kamieni oraz profesjonalnego sprzętu w salonie stacjonarnym. Z drugiej strony kupujący przez internet zgłaszają zastrzeżenia do rozbieżności stanów magazynowych oraz sposobu pakowania delikatnych artykułów w przesyłkach."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 35,
      "title": {
        "en": "Frequent online delivery and dispatch delays",
        "pl": "Częste opóźnienia w realizacji wysyłek"
      },
      "text": {
        "en": "Many online customers sharply criticize dispatch delays and slow order processing times. Reviewers report that parcel delivery frequently takes significantly longer than promised on the website, causing particular frustration for those awaiting temperature-sensitive live plants.",
        "pl": "Wielu kupujących w sklepie internetowym krytykuje opóźnienia w realizacji zamówień i wysyłce paczek. Recenzenci wskazują, że czas oczekiwania na przesyłkę bywa znacznie dłuższy niż deklarowany na stronie, co budzi szczególny niepokój przy zamawianiu żywych roślin akwariowych."
      }
    },
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 32,
      "title": {
        "en": "Competent advisors yet slow remote support",
        "pl": "Kompetentni doradcy lecz powolne wsparcie"
      },
      "text": {
        "en": "Opinions regarding customer service are mixed. Physical showroom advisors receive compliments for competent setup guidance, whereas remote helpline and complaint handling staff face critique for slow communication and prolonged resolution of refunds and damaged shipments.",
        "pl": "Opinie o obsłudze są podzielone. Doradcy w salonie stacjonarnym zbierają pochwały za fachowe wskazówki przy zakładaniu akwarium, natomiast kontakt z działem reklamacji i infolinią internetową bywa oceniany chłodno z powodu opieszałego rozwiązywania problemów i zwrotów."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can aquatic plants be inspected in person before buying?",
        "pl": "Czy w salonie można obejrzeć rośliny akwariowe przed zakupem?"
      },
      "a": {
        "en": "Yes, the physical showroom on ul. Kwidzyńska allows shoppers to choose live plants and hardscape in person.",
        "pl": "Tak, punkt stacjonarny przy ulicy Kwidzyńskiej umożliwia osobisty wybór roślin i korzeni."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do customers review online order fulfillment speeds?",
        "pl": "Jak klienci oceniają czas realizacji zamówień internetowych?"
      },
      "a": {
        "en": "Reviews highlight frequent shipping delays, advising buyers to order well in advance of setup deadlines.",
        "pl": "Recenzje wskazują na częste opóźnienia w wysyłce paczek, sugerując wcześniejsze zamawianie."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is professional aquascaping advice available on site?",
        "pl": "Czy na miejscu można uzyskać fachową poradę akwarystyczną?"
      },
      "a": {
        "en": "Yes, showroom consultants are commended for practical guidance on fertilization and filtration choices.",
        "pl": "Tak, personel punktu stacjonarnego jest chwalony za pomoc w doborze nawożenia i filtracji."
      },
      "basis": "reviews"
    }
  ],
