  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 79,
      "title": {
        "en": "Specialized doctors with compassionate approach",
        "pl": "Lekarze specjaliści o empatycznym podejściu"
      },
      "text": {
        "en": "Pet guardians highlight the extensive expertise of veterinarians and surgeons, noting clear medical explanations and attentive consultations. Clinicians frequently receive warm gratitude for calm, reassuring communication during stressful examinations and difficult treatments.",
        "pl": "Opiekunowie zwierząt podkreślają dużą wiedzę lekarzy weterynarii i chirurgów, doceniając jasne wyjaśnienia medyczne oraz uważne konsultacje. Personel zbiera wyrazy wdzięczności za spokojną i rzeczową komunikację w trakcie stresujących badań oraz wymagającego leczenia."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 76,
      "title": {
        "en": "Advanced surgical care and diagnostics",
        "pl": "Zaawansowana chirurgia i diagnostyka kliniczna"
      },
      "text": {
        "en": "Numerous reviews describe successful orthopedic interventions, oncological therapies, and accurate internal diagnoses that restored pet health. A minority of owners experienced complications or unresolved chronic symptoms despite repeated diagnostic visits and procedures.",
        "pl": "Liczne opinie opisują udane interwencje ortopedyczne, terapie onkologiczne i trafne diagnozy internistyczne, które przywróciły zdrowie pupilom. Mniejsza część opiekunów wspomina o powikłaniach lub braku poprawy przy przewlekłych schorzeniach mimo wykonanych badań."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 63,
      "title": {
        "en": "Treatment for canine and feline patients",
        "pl": "Troska o pacjentów psich i kocich"
      },
      "text": {
        "en": "Dogs and cats are treated with genuine care, with veterinarians taking extra time to soothe anxious pets during checkups and injections. Some reviewers nevertheless mention significant stress experienced by sensitive animals in busy waiting rooms and during hospital stays.",
        "pl": "Psy oraz koty otoczone są rzetelną opieką, a lekarze poświęcają czas na uspokojenie lękliwych zwierząt podczas oględzin i iniekcji. Niektórzy opiekunowie zwracają jednak uwagę na wysoki poziom stresu wrażliwych pacjentów w zatłoczonej poczekalni i w szpitalu."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pets undergo ultrasound and blood tests during one visit?",
        "pl": "Czy podczas jednej wizyty można wykonać USG i badania krwi?"
      },
      "a": {
        "en": "Yes, client reviews indicate that diagnostic ultrasound and comprehensive blood analyses are frequently performed on site.",
        "pl": "Tak, relacje klientów wskazują, że badania ultrasonograficzne oraz pełna morfologia krwi są często realizowane na miejscu."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is hospitalization available for postoperative pets?",
        "pl": "Czy klinika oferuje opiekę szpitalną po zabiegach?"
      },
      "a": {
        "en": "Yes, the practice features a dedicated hospital ward for animals recovering from surgery and intensive medical procedures.",
        "pl": "Tak, placówka dysponuje oddziałem szpitalnym dla zwierząt dochodzących do siebie po operacjach i procedurach medycznych."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How are urgent walk-in cases prioritized?",
        "pl": "Jak przyjmowane są pilne przypadki bez rejestracji?"
      },
      "a": {
        "en": "Urgent trauma and acute conditions are evaluated upon arrival, though wait times may vary based on ongoing emergency triage.",
        "pl": "Nagłe wypadki i ostre stany oceniane są po przybyciu, choć czas oczekiwania zależy od bieżącej kolejki dyżurowej."
      },
      "basis": "reviews"
    }
  ],
