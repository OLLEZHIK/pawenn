  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 62,
      "title": {
        "en": "Active and joyful stay for dogs",
        "pl": "Aktywny i radosny pobyt psów"
      },
      "text": {
        "en": "Dozens of owners report that their dogs return from 4Pets wonderfully tired, cheerful, and eager to come back. Pet parents of anxious and energetic breeds appreciate customized play sessions, gentle socialization, and attentive handling throughout the day.",
        "pl": "Dziesiątki właścicieli opisują, że ich psy wracają z hotelu przyjemnie zmęczone, zadowolone i chętne do kolejnych wizyt. Opiekunowie lękliwych oraz bardzo aktywnych ras doceniają indywidualne podejście do zabaw, łagodną socjalizację i troskę na co dzień."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "en": "Spacious play yards and tidy rooms",
        "pl": "Przestronne wybiegi i czyste pokoje"
      },
      "text": {
        "en": "Clients emphasize the impressive green outdoor yards, secure fencing, and hygienic indoor quarters at the hotel. Facilities are well maintained and climate-controlled, giving pets plenty of safe territory for running, exploring, and resting comfortably.",
        "pl": "Klienci podkreślają imponujące zielone wybiegi, solidne ogrodzenie oraz nienaganny standard higieny w pomieszczeniach. Cały obiekt jest bardzo zadbany i klimatyzowany, zapewniając zwierzętom mnóstwo bezpiecznej przestrzeni do swobodnego biegania i odpoczynku."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Exemplary contact and daily photo reports",
        "pl": "Wzorowy kontakt i codzienne fotorelacje"
      },
      "text": {
        "en": "Reviewers praise seamless and proactive communication from caregivers, particularly Pani Kaja and Pani Daria. Owners consistently receive multiple daily photos, videos, and detailed status updates, giving full peace of mind during business trips and vacations.",
        "pl": "Osoby oceniające chwalą sprawny i bezpośredni kontakt ze strony opiekunek, zwłaszcza pani Kai i pani Darii. Właściciele regularnie dostają liczne fotografie, filmy oraz bieżące informacje o pupilu, co zapewnia pełen spokój podczas wszelkich wyjazdów i urlopów."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do caregivers provide daily photo and video reports?",
        "pl": "Czy opiekunowie przesyłają codzienne zdjęcia i filmy?"
      },
      "a": {
        "en": "Yes, comprehensive daily photo and video coverage is one of the most praised features across client reviews.",
        "pl": "Tak, szczegółowe codzienne relacje zdjęciowe i filmowe są jednym z najczęściej chwalonych elementów w opiniach."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are dogs exercised in secure outdoor gardens?",
        "pl": "Czy psy korzystają z bezpiecznych wybiegów na świeżym powietrzu?"
      },
      "a": {
        "en": "Yes, the facility offers large fenced grass yards for supervised runs and structured group or individual play.",
        "pl": "Tak, hotel dysponuje dużymi, ogrodzonymi wybiegami trawiastymi do nadzorowanych zabaw i spacerów."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can high-energy or reactive dogs stay at 4Pets?",
        "pl": "Czy hotel przyjmuje psy aktywne lub wymagające szczególnej uwagi?"
      },
      "a": {
        "en": "Yes, multiple reviews highlight tailored care and patient handling for high-energy and reactive dogs.",
        "pl": "Tak, liczne recenzje potwierdzają cierpliwe i indywidualne podejście do psów bardzo żywiołowych oraz lękowych."
      },
      "basis": "reviews"
    }
  ],
