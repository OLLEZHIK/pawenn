  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 73,
      "title": {
        "en": "Dedicated emergency veterinary medical team",
        "pl": "Dedykowany zespół ostrego dyżuru weterynaryjnego"
      },
      "text": {
        "en": "Pet owners frequently praise the medical team for prompt emergency care, empathetic consultations, and round-the-clock availability during night emergencies. Clinicians explain diagnoses clearly and handle critical trauma cases with great dedication and professional focus.",
        "pl": "Opiekunowie zwierząt często chwalą zespół medyczny za szybką pomoc doraźną, empatyczne konsultacje i całodobową dyspozycyjność podczas ostrych dyżurów. Lekarze jasno tłumaczą diagnozy i prowadzą ciężkie przypadki urazowe z dużym zaangażowaniem oraz profesjonalizmem."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 69,
      "title": {
        "en": "Complex surgical procedures and therapies",
        "pl": "Skomplikowane zabiegi chirurgiczne oraz terapie"
      },
      "text": {
        "en": "Many clients report life-saving surgical outcomes, including successful jaw repairs, foreign body removals, and stabilization of acute poisoning. However, several owners express disappointment when diagnostic imaging was delayed or when critically ill animals could not be saved.",
        "pl": "Wielu klientów opisuje ratujące życie operacje, w tym udane zabiegi na żuchwie, usuwanie ciał obcych i stabilizację po zatruciach. Z kolei część opiekunów zwraca uwagę na opóźnienia w badaniach obrazowych lub brak możliwości uratowania zwierząt w stanie krytycznym."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 65,
      "title": {
        "en": "Intensive care and hospital monitoring",
        "pl": "Opieka intensywna i monitoring szpitalny"
      },
      "text": {
        "en": "Canine and feline patients receive direct medical intervention during nocturnal trauma, with gentle handling reported by many visitors. At the same time, some guardians note stress during hospitalization and request closer updates or camera monitoring of their hospitalized pets.",
        "pl": "Psy i koty otrzymują bezpośrednią pomoc medyczną podczas nocnych urazów, a wielu właścicieli podkreśla delikatne podejście personelu. Jednocześnie część opiekunów wspomina o stresie podczas hospitalizacji i sugeruje potrzebę częstszego kontaktu lub monitoringu kamerami."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Klinika Psa i Kota operate an emergency 24/7 service?",
        "pl": "Czy Klinika Psa i Kota prowadzi całodobowy ostry dyżur?"
      },
      "a": {
        "en": "Yes, the clinic provides round-the-clock veterinary emergency care for dogs and cats, including nighttime admissions.",
        "pl": "Tak, placówka zapewnia całodobową pomoc doraźną dla psów i kotów, w tym nocne przyjęcia nagłych przypadków."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are advanced imaging diagnostics like CT available on site?",
        "pl": "Czy w klinice można wykonać zaawansowane badania obrazowe jak tomografia?"
      },
      "a": {
        "en": "Yes, client reviews and clinic profiles confirm on-site computed tomography (CT) and digital radiography.",
        "pl": "Tak, opinie opiekunów i informacje placówki potwierdzają dostępność tomografii komputerowej oraz cyfrowego RTG."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is appointment booking required for emergency visits?",
        "pl": "Czy na wizytę w trybie nagłym trzeba się wcześniej umawiać?"
      },
      "a": {
        "en": "Emergency cases are admitted without prior booking, though non-urgent specialist consultations require scheduling.",
        "pl": "Nagłe przypadki przyjmowane są bez wcześniejszych zapisów, natomiast planowe konsultacje specjalistyczne wymagają rejestracji."
      },
      "basis": "reviews"
    }
  ],
