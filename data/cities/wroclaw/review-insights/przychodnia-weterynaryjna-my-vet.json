  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 71,
      "title": {
        "en": "Enthusiastic and welcoming veterinary team",
        "pl": "Życzliwy i pełen zaangażowania zespół lecznicy"
      },
      "text": {
        "en": "Reviewers overwhelmingly praise the veterinary personnel for their warmth, politeness, and attentive attitude. Doctors such as Dr Daria, Dr Jagoda, and Pan Krzysztof receive glowing compliments for creating a comforting atmosphere that puts both pets and owners at ease.",
        "pl": "Klienci z ogromnym entuzjazmem oceniają kadrę przychodni za serdeczność, kulturę osobistą i zaangażowanie. Lekarze, w tym doktor Daria, doktor Jagoda oraz pan Krzysztof, zbierają liczne pochwały za tworzenie ciepłej atmosfery, która uspokaja opiekunów i czworonogi."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 60,
      "title": {
        "en": "Gentle approach to puppies, dogs, and cats",
        "pl": "Delikatne podejście do psów, kotów i szczeniąt"
      },
      "text": {
        "en": "Clients emphasize the wonderful connection staff members establish with four-legged patients during first visits and routine vaccinations. Reviewers note that even timid cats and energetic puppies remain calm and cheerful, leaving the clinic happy and unstressed.",
        "pl": "Opiekunowie podkreślają świetny kontakt lekarzy z czworonogami podczas pierwszych wizyt adaptacyjnych oraz szczepień. Klienci wskazują, że nawet lękliwe koty i ruchliwe szczenięta zachowują spokój podczas badań, opuszczając gabinet bez niepotrzebnego stresu."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Effective treatments and thorough health checks",
        "pl": "Skuteczne leczenie i rzetelna profilaktyka"
      },
      "text": {
        "en": "Pet guardians commend the practice for prompt diagnostic support, successful resolutions of bladder infections, and well-managed treatments. While a few isolated reviews questioned treatment choices, most owners report quick pet recovery and reliable care plans.",
        "pl": "Opiekunowie chwalą placówkę za sprawną diagnostykę, skuteczne wyleczenie infekcji pęcherza oraz trafnie dobrane terapie. Mimo nielicznych uwag dotyczących trudniejszych przypadków, większość właścicieli opisuje szybki powrót pupili do zdrowia i rzetelne zalecenia."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is the clinic suitable for first puppy or kitten checkups?",
        "pl": "Czy przychodnia jest polecana na pierwsze wizyty ze szczeniakiem lub kociakiem?"
      },
      "a": {
        "en": "Yes, many reviews highlight positive first visits, thorough adaptation checkups, and gentle vaccinations.",
        "pl": "Tak, liczne opinie chwalą bezstresowe pierwsze wizyty, spokojne badania adaptacyjne oraz szczepienia młodych zwierząt."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do pet owners receive printed visit summaries and medical cards?",
        "pl": "Czy opiekunowie otrzymują pisemne zalecenia i karty po wizycie?"
      },
      "a": {
        "en": "Yes, clients appreciate receiving information folders with comprehensive health notes and post-visit advice.",
        "pl": "Tak, klienci doceniają otrzymywanie teczek informacyjnych z czytelnym podsumowaniem zaleceń po konsultacji."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are prices at My Vet considered reasonable?",
        "pl": "Jak kształtują się ceny usług weterynaryjnych w My Vet?"
      },
      "a": {
        "en": "Reviewers broadly find the service pricing attractive and fair given the modern facilities and attentive care.",
        "pl": "Klienci w większości uznają stawki za przystępne i adekwatne do nowoczesnego wyposażenia i wysokiej jakości opieki."
      },
      "basis": "reviews"
    }
  ],
