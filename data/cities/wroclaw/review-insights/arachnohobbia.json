  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 173,
      "title": {
        "en": "Outstanding passion and patient guidance",
        "pl": "Wybitna pasja i cierpliwe doradztwo"
      },
      "text": {
        "en": "Customers are thrilled by the welcoming attitude of the Arachnohobbia team. Visitors highlight genuine kindness, passion, and an eagerness to share deep knowledge regarding tarantula husbandry. Every visitor receives detailed explanations and reliable ongoing breeding advice.",
        "pl": "Klienci są zachwyceni podejściem właścicieli i pracowników sklepu Arachnohobbia. Odwiedzający podkreślają niezwykłą życzliwość, pasję oraz gotowość do dzielenia się wiedzą na temat hodowli pająków. Każdy kupujący może liczyć na wyczerpujące wyjaśnienia i wsparcie merytoryczne."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 121,
      "title": {
        "en": "Premier exotic hub and secure packaging",
        "pl": "Renomowany salon i bezpieczne pakowanie"
      },
      "text": {
        "en": "The store enjoys an outstanding reputation as an exotic terrarium destination in Wrocław. Shoppers praise the vast selection of glass and acrylic terrariums, specialized substrates, and decorations, alongside meticulous parcel packing that ensures items arrive in pristine condition.",
        "pl": "Sklep cieszy się znakomitą opinią jako wrocławskie centrum terrarystyki. Klienci chwalą bogaty asortyment terrariów szklanych i akrylowych, podłoży, elementów wystroju oraz profesjonalne zabezpieczenie paczek wysyłkowych, dzięki czemu zamówiony sprzęt dociera w nienaruszonym stanie."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 75,
      "title": {
        "en": "Pristine tarantulas and healthy live feeders",
        "pl": "Wspaniałe ptaszniki i świeża karmówka"
      },
      "text": {
        "en": "Arachnid enthusiasts unanimously praise the superb condition of available tarantulas and feeder insects. Specimens are healthy, active, and securely packed for transport, with keepers highlighting an impressive variety of species tailored to both beginners and advanced hobbyists.",
        "pl": "Pasjonaci pająków i skorpionów jednogłośnie chwalą znakomitą kondycję oferowanych ptaszników oraz owadów karmowych. Zwierzęta są zdrowe, zadbane i bezpiecznie pakowane na czas transportu, a hodowcy zwracają uwagę na imponujący wybór gatunków zarówno dla początkujących, jak i zaawansowanych."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the store offer tarantulas suitable for beginners?",
        "pl": "Czy sklep oferuje ptaszniki dla początkujących hodowców?"
      },
      "a": {
        "en": "Yes, staff eagerly help select docile terrestrial or arboreal species and explain setup essentials.",
        "pl": "Tak, personel chętnie dobiera łagodne gatunki nadrzewne lub naziemne i tłumaczy zasady opieki."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are live animal shipments packed safely for courier delivery?",
        "pl": "Czy zamówienia internetowe ze zwierzętami są bezpiecznie pakowane?"
      },
      "a": {
        "en": "Yes, customers consistently praise professional thermal packaging and careful transit protection.",
        "pl": "Tak, klienci masowo chwalą profesjonalne zabezpieczenie termiczne i mechaniczne przesyłek."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can terrariums and live feeders be purchased on site?",
        "pl": "Czy na miejscu można kupić terraria i pokarm?"
      },
      "a": {
        "en": "Yes, the retail salon provides complete enclosures, hardscape decor, and fresh feeder bugs.",
        "pl": "Tak, salon oferuje kompletne zbiorniki, elementy aranżacji oraz świeżą karmówkę owadzią."
      },
      "basis": "reviews"
    }
  ],
