  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Skilled specialists with reception critiques",
        "pl": "Doświadczeni specjaliści i uwagi do recepcji"
      },
      "text": {
        "en": "Numerous clients express profound appreciation for neurologists such as Dr Aleksandra Banasik, Dr Agata Guzikowska, and Dr Yaroslav Yarotnyk. While the clinical specialists receive glowing feedback for their expertise, some reviews criticize reception coordination.",
        "pl": "Wielu klientów wyraża głęboką wdzięczność neurologom, w tym doktor Aleksandrze Banasik, doktor Agacie Guzikowskiej i doktorowi Yarotnykowi. Podczas gdy lekarze są chwaleni za wiedzę i zaangażowanie, część opinii zgłasza uwagi do organizacji pracy recepcji lecznicy."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "en": "Care for pets with severe neurological issues",
        "pl": "Opieka nad zwierzętami ze schorzeniami układu nerwowego"
      },
      "text": {
        "en": "Owners bring dogs and cats suffering from spinal disc herniation, seizures, and limb paralysis for specialized neurological support. Reviewers frequently describe how dedicated clinicians saved paralyzed pets and guided anxious families through complex recovery phases.",
        "pl": "Opiekunowie zgłaszają się z psami i kotami zmagającymi się z dyskopatią, padaczką oraz niedowładem kończyn. Klienci wielokrotnie opisują uratowanie sprawności sparaliżowanych czworonogów oraz profesjonalne wsparcie personelu w trudnych etapach rehabilitacji."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 29,
      "title": {
        "en": "Advanced MRI diagnostics and disputed outcomes",
        "pl": "Zaawansowany rezonans i sporne wyniki terapii"
      },
      "text": {
        "en": "Many guardians credit successful neurosurgeries and advanced MRI imaging with restoring their pets' mobility and saving lives. Conversely, critical reviews complain about inconclusive MRI descriptions, heavy medication regimens, and lack of improvement after costly surgeries.",
        "pl": "Wielu opiekunów przypisuje udanym operacjom neurologicznym i badaniom MRI uratowanie życia oraz sprawności swoich pupili. Z drugiej strony głosy krytyczne zarzucają klinice mało precyzyjne opisy rezonansu, nadmiar leków oraz brak poprawy po kosztownych zabiegach."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What diagnostic equipment is available at NeuroTeam?",
        "pl": "Jakim sprzętem diagnostycznym dysponuje NeuroTeam?"
      },
      "a": {
        "en": "The clinic features an advanced magnetic resonance imaging (MRI) scanner dedicated to pet neurological diagnostics.",
        "pl": "Klinika dysponuje własnym aparatem rezonansu magnetycznego (MRI) do zaawansowanej diagnostyki neurologicznej."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does NeuroTeam perform emergency neurological admissions?",
        "pl": "Czy NeuroTeam przyjmuje pacjentów w trybie pilnym?"
      },
      "a": {
        "en": "Yes, reviews confirm that critically deteriorating pets are accepted on an urgent emergency basis for rapid evaluation.",
        "pl": "Tak, opinie potwierdzają przyjmowanie pacjentów w stanie nagłym w trybie cito na pilną konsultację i diagnostykę."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are appointment delays common at the clinic?",
        "pl": "Czy w klinice zdarzają się opóźnienia w przyjęciach?"
      },
      "a": {
        "en": "While visits are thorough, reviewers occasionally report schedule delays due to emergency cases and reception delays.",
        "pl": "Wizyty są wnikliwe, jednak z uwagi na nagłe przypadki i pracę rejestracji mogą zdarzyć się przesunięcia godzin wizyt."
      },
      "basis": "reviews"
    }
