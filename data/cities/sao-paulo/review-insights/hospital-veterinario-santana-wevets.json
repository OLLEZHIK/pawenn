  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 75,
      "title": {
        "pt": "Atendimento humanizado e dedicação clínica",
        "en": "Compassionate staff and dedicated clinical care"
      },
      "text": {
        "pt": "A equipe médica e de enfermagem em Santana recebe elogios constantes pelo acolhimento caloroso e pela competência técnica demonstrada nas consultas. Os tutores sentem segurança no diagnóstico e destacam a empatia com que os profissionais explicam os tratamentos e acompanham os pets em momentos delicados.",
        "en": "The veterinary and nursing team in Santana garners widespread praise for welcoming bedside manners and solid clinical competence during consultations. Pet owners feel reassured by thorough diagnostic explanations and highlight the staff's empathy when supporting families through stressful medical moments."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "pt": "Carinho e atenção no manejo dos animais",
        "en": "Affectionate handling and gentle pet comfort"
      },
      "text": {
        "pt": "O cuidado com os pacientes de quatro patas é um ponto forte salientado pelos frequentadores da clínica. Cães e gatos são atendidos com paciência, carinho e respeito aos seus limites, o que ameniza o estresse das consultas veterinárias e garante conforto aos animais internados na unidade.",
        "en": "Gentle attention towards canine and feline patients is a notable strength highlighted by clinic visitors. Pets are examined with patience, warmth, and respect for their comfort levels, which noticeably alleviates clinic anxiety and fosters reassurance for animals undergoing inpatient monitoring."
      }
    },
    {
      "topic": "place",
      "sentiment": "mixed",
      "mentions": 15,
      "title": {
        "pt": "Estrutura moderna com ressalvas operacionais",
        "en": "Modern facility with occasional operational friction"
      },
      "text": {
        "pt": "A infraestrutura do hospital é elogiada pelo conforto, limpeza e tecnologia dos equipamentos diagnósticos disponíveis. No entanto, tutores apontam preços elevados para determinados exames e relatam eventuais cancelamentos de horários de convênio, sugerindo alinhamento prévio antes de procedimentos.",
        "en": "The hospital's physical facilities earn praise for cleanliness, modern comfort, and advanced diagnostic equipment. Nevertheless, visitors note premium pricing for certain specialized tests and occasional scheduling hiccups with pet health plans, advising pet owners to confirm coverage details beforehand."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "O hospital veterinário oferece atendimento 24 horas?",
        "en": "Does the veterinary hospital offer 24-hour service?"
      },
      "a": {
        "pt": "Sim, a unidade funciona 24 horas todos os dias para urgências, emergências e internação hospitalar.",
        "en": "Yes, the facility operates 24/7 every day for urgent triage, emergency care, and hospital boarding."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "O local aceita planos de saúde para animais?",
        "en": "Does the clinic accept pet health insurance plans?"
      },
      "a": {
        "pt": "Sim, a clínica aceita convênios veterinários parceiros, sendo recomendável verificar a cobertura específica de cada exame.",
        "en": "Yes, the clinic accepts partnered pet insurance plans, though confirming specific exam coverage in advance is advised."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "pt": "Há serviços de exames e diagnósticos no próprio hospital?",
        "en": "Are diagnostic and imaging tests conducted on-site?"
      },
      "a": {
        "pt": "Sim, a estrutura dispõe de exames laboratoriais e diagnósticos por imagem para pronto atendimento aos pacientes.",
        "en": "Yes, the facility provides on-site laboratory testing and diagnostic imaging for prompt patient evaluations."
      },
      "basis": "both"
    }
  ],
