  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 104,
      "title": {
        "pt": "Equipe médica elogiada com atritos pontuais",
        "en": "Praised medical staff with occasional disputes"
      },
      "text": {
        "pt": "A maioria esmagadora das avaliações celebra a dedicação, a competência e o carinho dos médicos veterinários, citando nominalmente cirurgiões e plantonistas dedicados. O atendimento de emergência salva vidas e transmite segurança às famílias. Queixas esporádicas concentram-se em desacordos com a coordenação e atritos na liberação de laudos.",
        "en": "The vast majority of reviews celebrate the clinical skill, dedication, and kindness of the veterinarians, frequently praising emergency doctors and surgeons by name. Rapid interventions save pet lives and reassure families. Sporadic complaints focus on administrative disputes with coordination staff and delays in receiving diagnostic reports."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 91,
      "title": {
        "pt": "Cuidado intensivo com cães e gatos",
        "en": "Intensive care for dogs and cats"
      },
      "text": {
        "pt": "O acolhimento atencioso a pets gravemente enfermos ou acidentados é um dos aspectos mais reconhecidos do hospital na Mooca. Os tutores destacam o carinho da equipe de enfermagem durante a internação e o respeito aos animais em estado crítico. Casos raros de insatisfação mencionam protocolos invasivos sem autorização prévia detalhada.",
        "en": "Attentive care for severely sick or injured companions is one of the most recognized aspects of the Mooca hospital. Owners highlight the gentleness of veterinary nurses during hospitalization and their respectful handling of critical cases. Rare critical remarks mention invasive procedures initiated without exhaustive advance consent."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "pt": "Estrutura moderna e pronto-socorro 24 horas",
        "en": "Modern facilities and 24-hour emergency room"
      },
      "text": {
        "pt": "A infraestrutura do hospital impressiona os clientes pelo ambiente limpo, consultórios modernos e ala de internação completa com equipamentos avançados. O funcionamento ininterrupto 24 horas oferece suporte imediato em situações de emergência noturna. A organização visual das instalações transmite profissionalismo e segurança aos donos.",
        "en": "The hospital's facilities impress clients with clean premises, modern consultation rooms, and a comprehensive inpatient unit equipped with advanced monitoring tools. Continuous 24-hour operation provides crucial support for nighttime emergencies. The orderly environment reinforces a strong sense of professionalism and clinical readiness."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "O hospital dispõe de internação e pronto-socorro 24 horas?",
        "en": "Does the hospital have 24-hour inpatient and emergency care?"
      },
      "a": {
        "pt": "Sim, o Hospital Veterinário Paulistano conta com pronto atendimento e leitos de internação 24 horas na Mooca.",
        "en": "Yes, Hospital Veterinário Paulistano offers round-the-clock emergency assistance and inpatient beds in Mooca."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Quais recursos diagnósticos estão disponíveis no local?",
        "en": "What diagnostic tools are available on-site?"
      },
      "a": {
        "pt": "A unidade realiza exames laboratoriais, ultrassonografia, radiografias e procedimentos cirúrgicos no próprio prédio.",
        "en": "The facility performs on-site laboratory testing, ultrasound imaging, X-rays, and surgical operations."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Como os tutores acompanham animais internados?",
        "en": "How do guardians track the progress of hospitalized pets?"
      },
      "a": {
        "pt": "Os clientes contam com boletins médicos e horários de visita, sendo recomendada comunicação ativa com a equipe.",
        "en": "Owners receive medical updates and have scheduled visitation hours, with clear communication recommended."
      },
      "basis": "reviews"
    }
  ],
