  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 90,
      "title": {
        "pt": "Atendimento médico exemplar e acolhimento contínuo",
        "en": "Exemplary medical expertise and dedicated support"
      },
      "text": {
        "pt": "A ampla maioria dos tutores elogia a competência, a agilidade e a dedicação dos veterinários e especialistas na Vila Mariana. O acolhimento humano em situações de risco e a paciência para esclarecer diagnósticos e tirar dúvidas transmitem muita tranquilidade às famílias que buscam o hospital.",
        "en": "The vast majority of pet guardians commend the medical skill, promptness, and dedication shown by veterinarians and specialists in Vila Mariana. Compassionate bedside care during emergencies and patient communication regarding diagnoses provide reassurance to visiting families."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "pt": "Acolhimento afetuoso e cuidado com os pets",
        "en": "Compassionate care and affection for pets"
      },
      "text": {
        "pt": "A dedicação e o afeto demonstrados pelos profissionais aos cães e gatos internados são elogiados com entusiasmo pelos tutores na Vila Mariana. Os animais recebem atenção carinhosa e vigilância constante em momentos delicados, garantindo conforto e segurança emocional para os pets e suas famílias.",
        "en": "The dedication and tenderness demonstrated by medical staff toward hospitalized dogs and cats are warmly praised by pet guardians in Vila Mariana. Patients receive gentle care and vigilant supervision during critical hours, ensuring emotional comfort and security for both pets and their owners."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "pt": "Infraestrutura moderna e ambiente acolhedor",
        "en": "Modern hospital facilities and welcoming space"
      },
      "text": {
        "pt": "A infraestrutura do hospital veterinário na Sena Madureira impressiona pela organização, limpeza impecável e aparelhos modernos de diagnóstico. O ambiente espaçoso e bem planejado oferece suporte completo para internação e pronto-socorro, garantindo um atendimento seguro e eficiente em São Paulo.",
        "en": "The hospital facilities on Sena Madureira impress visitors with their cleanliness, well-ordered spaces, and advanced diagnostic imaging technology. The expansive, well-maintained environment provides comprehensive inpatient support and emergency capacity, ensuring safe care in São Paulo."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "A unidade da Sena Madureira possui pronto atendimento 24 horas?",
        "en": "Does the Sena Madureira hospital have a 24-hour emergency room?"
      },
      "a": {
        "pt": "Sim, o hospital funciona em regime de plantão ininterrupto 24 horas para atendimento emergencial e internação clínica.",
        "en": "Yes, the hospital operates 24 hours continuously for emergency walk-ins, intensive medical care, and clinical observation."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "É possível realizar exames de imagem avançados no local?",
        "en": "Can advanced imaging and diagnostic scans be conducted on site?"
      },
      "a": {
        "pt": "Sim, a unidade conta com estrutura completa para tomografia computadorizada, radiografias digitais e ultrassonografia.",
        "en": "Yes, the facility features comprehensive imaging equipment including CT scans, digital x-rays, and ultrasound examinations."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "O hospital oferece atendimento veterinário especializado em endocrinologia?",
        "en": "Does the hospital offer specialized endocrinology consultations?"
      },
      "a": {
        "pt": "Sim, a instituição dispõe de consultas especializadas em diversas áreas veterinárias, incluindo endocrinologia e oncologia.",
        "en": "Yes, the institution provides specialized appointments across multiple disciplines, including veterinary endocrinology and oncology."
      },
      "basis": "reviews"
    }
  ],
