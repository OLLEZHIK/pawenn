  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 65,
      "title": {
        "pt": "Profissionais dedicados e suporte clínico caloroso",
        "en": "Dedicated veterinary team and attentive care"
      },
      "text": {
        "pt": "Inúmeros tutores elogiam a empatia e a atenção dos médicos veterinários e enfermeiros no Tucuruvi, ressaltando o carinho dispensado aos pets durante consultas e internações. A dedicação da equipe de plantão em situações de emergência é apontada como fundamental para a recuperação e conforto dos animais atendidos.",
        "en": "Numerous pet parents commend the empathy and dedication shown by vets and nursing staff in Tucuruvi, highlighting attentive care during examinations and hospital stays. The on-duty team's commitment during medical emergencies is frequently cited as key to patient recovery and family comfort throughout visits."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 15,
      "title": {
        "pt": "Custos elevados frente à proposta popular",
        "en": "Elevated expenses contrasting with popular branding"
      },
      "text": {
        "pt": "O custo dos atendimentos é a principal queixa dos clientes, que consideram os valores de exames, medicamentos e internações muito altos em comparação ao que o nome 'popular' sugere. Vários tutores recomendam solicitar orçamentos detalhados antes de autorizar procedimentos de maior complexidade médica.",
        "en": "Treatment costs represent the most frequent criticism among clients, who find fees for diagnostic tests, medications, and hospitalization steep relative to the 'popular' branding. Several pet owners advise requesting itemized price quotes before authorizing complex medical procedures or extended admissions."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 14,
      "title": {
        "pt": "Agilidade no pronto atendimento e esperas pontuais",
        "en": "Prompt triage alongside occasional waiting delays"
      },
      "text": {
        "pt": "O atendimento inicial de emergência costuma ser ágil e eficaz, mas clientes relatam esperas prolongadas em dias de grande movimento na unidade. Atrasos na liberação de altas médicas e lentidão no suporte telefônico ou digital também são apontados por tutores que buscaram informações sobre seus animais.",
        "en": "Initial emergency triage is typically swift and effective, yet clients report prolonged waiting periods during peak hours at the clinic. Delays in completing discharge paperwork and slow responses via digital messaging channels were also highlighted by families seeking timely updates on their pets."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "O hospital no Tucuruvi funciona 24 horas?",
        "en": "Does the Tucuruvi hospital operate 24 hours?"
      },
      "a": {
        "pt": "Sim, o hospital mantém atendimento ininterrupto 24 horas para casos clínicos de rotina e emergências veterinárias.",
        "en": "Yes, the hospital operates 24/7 around the clock for routine clinical visits and urgent veterinary emergencies."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "A unidade oferece estrutura completa de internação?",
