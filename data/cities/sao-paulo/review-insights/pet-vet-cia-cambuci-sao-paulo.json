  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "pt": "Atendimento clínico humanizado e dedicado",
        "en": "Compassionate and dedicated clinical care"
      },
      "text": {
        "pt": "Os clientes manifestam profunda gratidão ao Dr. Daniel e aos demais veterinários pela atenção calorosa e conduta humana em tratamentos e cirurgias. A equipe de banho e tosa, com destaque para Carlos e Sandra, também é elogiada por anos de dedicação, embora ocorram críticas a falhas de comunicação na recepção.",
        "en": "Clients express profound gratitude to Dr. Daniel and fellow veterinarians for empathetic, human bedside care during treatments and surgeries. The grooming team, particularly Carlos and Sandra, is also celebrated for years of loyal care, though occasional critiques point to communication delays at the front desk."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "pt": "Cuidado contínuo com pets idosos",
        "en": "Continuous care for senior pets"
      },
      "text": {
        "pt": "O centro veterinário no Cambuci é reconhecido pelo carinho e respeito no acompanhamento de cães e gatos de todas as idades, incluindo animais idosos com doenças crônicas ou necessidade de cirurgias. A dedicação da equipe transmite segurança aos tutores mesmo em momentos delicados de internação ou luto.",
        "en": "The Cambuci veterinary center is praised for attentive and respectful care across all life stages, including geriatric pets with chronic health issues or surgical needs. The staff's gentle bedside approach gives pet owners peace of mind, even during challenging periods of hospitalization or palliative care."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "pt": "Estrutura hospitalar e ambiente acolhedor",
        "en": "Hospital facilities and clean environment"
      },
      "text": {
        "pt": "Os tutores avaliam positivamente a infraestrutura limpa, organizada e bem aparelhada do centro no Cambuci, ressaltando a conveniência de integrar consultas clínicas, internação, farmácia e estética no mesmo endereço, proporcionando comodidade e conforto aos animais atendidos na Avenida Lacerda Franco.",
        "en": "Pet owners view the Cambuci facility's clean, well-organized, and equipped environment very favorably. Reviewers value having veterinary visits, hospitalization, an on-site pharmacy, and grooming services located in one accessible venue, ensuring practical comfort for animals on Avenida Lacerda Franco."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "A clínica realiza cirurgias veterinárias e internação?",
        "en": "Does the clinic perform surgeries and provide hospitalization?"
      },
      "a": {
        "pt": "Sim, o centro veterinário conta com centro cirúrgico para procedimentos eletivos e leitos de internação monitorada.",
        "en": "Yes, the veterinary center features a surgical suite for elective procedures and monitored inpatient hospitalization."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "O estabelecimento oferece banho e tosa no local?",
        "en": "Are pet bathing and grooming services available on-site?"
      },
      "a": {
        "pt": "Sim, a unidade dispõe de salão de banho e tosa integrado para higiene e embelezamento de cães e gatos.",
        "en": "Yes, the facility maintains an integrated grooming salon for regular baths, coat brushing, and aesthetic pet care."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Há serviço de transporte ou táxi dog disponível?",
        "en": "Is a pet transport or taxi service provided?"
      },
      "a": {
        "pt": "Sim, a clínica disponibiliza serviço de transporte pet móvel para maior comodidade dos tutores.",
        "en": "Yes, the clinic offers a mobile pet transport service to assist owners with travel to and from appointments."
      },
      "basis": "both"
    }
