  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 85,
      "title": {
        "pt": "Especialistas dedicados e queixas na urgência",
        "en": "Dedicated specialists alongside emergency complaints"
      },
      "text": {
        "pt": "Muitos tutores elogiam a competência técnica e a dedicação de especialistas renomados em oncologia, cardiologia e cirurgia. Por outro lado, há frequentes críticas à falta de empatia e ao distanciamento de profissionais do pronto-atendimento em situações críticas.",
        "en": "Many guardians praise the clinical competence and dedication of renowned specialists in oncology, cardiology, and surgery. Conversely, persistent complaints criticize perceived lack of empathy and communication lapses from emergency room staff during critical moments."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 35,
      "title": {
        "pt": "Longos períodos de espera no atendimento",
        "en": "Protracted waiting times across hospital departments"
      },
      "text": {
        "pt": "A demora no atendimento emerge como uma das principais fontes de insatisfação entre os clientes. Relatos apontam horas de espera no pronto-socorro e atrasos significativos para a realização de exames complexos agendados, como ressonâncias magnéticas e ultrassons.",
        "en": "Excessive waiting stands out as a leading source of client dissatisfaction at the hospital. Reviews describe hours of waiting in the emergency department and substantial delays for scheduled imaging tests, including specialized magnetic resonance scans and ultrasounds."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "pt": "Infraestrutura avançada e instalações completas",
        "en": "Advanced hospital infrastructure and modern facilities"
      },
      "text": {
        "pt": "Os clientes reconhecem amplamente a sofisticação da estrutura hospitalar, considerada de padrão internacional. O complexo veterinário dispõe de centro de diagnóstico por imagem de última geração, internação limpa e organizada, além de manobrista e recepção ampla.",
        "en": "Clients broadly acknowledge the sophisticated hospital infrastructure, often comparing it to international standards. The veterinary complex features cutting-edge diagnostic imaging suites, clean and orderly inpatient wards, as well as spacious reception lounges."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "pt": "O hospital possui atendimento de emergência 24 horas?",
        "en": "Does the hospital operate a 24-hour emergency service?"
      },
      "a": {
        "pt": "Sim, o pronto-atendimento veterinário funciona ininterruptamente todos os dias da semana.",
        "en": "Yes, emergency veterinary care is available around the clock seven days a week."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "O centro veterinário realiza exames de ressonância magnética e tomografia?",
        "en": "Does the center provide MRI and CT scan imaging?"
      },
      "a": {
        "pt": "Sim, a unidade conta com parque tecnológico completo para diagnóstico por imagem avançado.",
        "en": "Yes, the facility maintains comprehensive imaging technology for MRI and CT diagnostics."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "É possível agendar consultas com médicos veterinários especialistas?",
        "en": "Can consultations be scheduled with board-certified specialists?"
      },
      "a": {
        "pt": "Sim, o corpo clínico reúne especialistas em cardiologia, oncologia, neurologia e ortopedia.",
        "en": "Yes, the hospital hosts specialists in cardiology, oncology, neurology, and orthopedics."
      },
      "basis": "both"
    },
    {
      "q": {
        "pt": "Os clientes relatam tempos de espera elevados no pronto-socorro?",
        "en": "Do clients report extended waiting times in the emergency unit?"
      },
      "a": {
        "pt": "Sim, avaliações indicam que casos de urgência podem enfrentar esperas prolongadas em dias de alta demanda.",
        "en": "Yes, reviews indicate that urgent visits may experience prolonged wait times during peak hours."
      },
      "basis": "reviews"
    }
  ],
