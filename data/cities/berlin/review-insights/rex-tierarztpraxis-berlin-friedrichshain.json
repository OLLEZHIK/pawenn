  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "de": "Zugewandtes Praxisteam und verständliche Beratung",
        "en": "Attentive clinic team and clear guidance"
      },
      "text": {
        "de": "Besitzer schätzen das aufmerksame Auftreten der Tierärzte und des Empfangspersonals in Friedrichshain. Fragen zur Medikation werden ruhig beantwortet und Untersuchungen laufen ohne Hektik ab. Auch englischsprachige Halter fühlen sich gut beraten, wenngleich vereinzelt wechselnde Bezugspersonen auffallen.",
        "en": "Owners appreciate the attentive manner of the veterinarians and reception staff in Friedrichshain. Medication questions are answered calmly and examinations proceed without haste. English-speaking clients also feel well advised, though occasional changing doctors are noted."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "de": "Geduldiger Umgang mit ängstlichen Tieren",
        "en": "Patient handling of fearful pets"
      },
      "text": {
        "de": "Hunde und Katzen werden behutsam an Untersuchungstische herangeführt, was nervösen Vierbeinern rasch die Anspannung nimmt. Tierärztinnen tasten Tiere vorsichtig ab und gehen gezielt auf das individuelle Temperament ein. Selbst schreckhafte Katzen und Welpen überstehen Kontrollen meist stressfrei.",
        "en": "Dogs and cats are gently introduced to examination tables, which quickly eases tension for nervous four-legged companions. Veterinarians palpate pets carefully and adjust to individual temperaments. Even skittish cats and young puppies handle routine checkups with minimal stress."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "de": "Getrennte Wartebereiche und gepflegte Räume",
        "en": "Separate waiting areas and tidy premises"
      },
      "text": {
        "de": "In den Rezensionen wird die Praxisausstattung regelmäßig positiv hervorgehoben. Räumlich getrennte Wartezonen für Hunde und Katzen sowie erhöhte Stellflächen für Transportboxen reduzieren Stress vor Behandlungsbeginn spürbar. Die Räumlichkeiten werden als sauber und übersichtlich strukturiert beschrieben.",
        "en": "In reviews, the clinic setup is frequently highlighted in a positive light. Spatially separated waiting zones for dogs and cats as well as elevated stands for carrier boxes noticeably reduce pre-visit stress. The facilities are described as clean and orderly arranged."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Gibt es getrennte Wartezimmer für Hunde und Katzen?",
        "en": "Are there separate waiting rooms for dogs and cats?"
      },
      "a": {
        "de": "Ja, die Praxis bietet separate Wartezonen für Hunde und Katzen mit erhöhten Abstellflächen für Boxen.",
        "en": "Yes, the clinic provides separate waiting areas for dogs and cats with elevated box platforms."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Können Termine kurzfristig online gebucht werden?",
        "en": "Can appointments be booked online on short notice?"
      },
      "a": {
        "de": "Ja, Termine lassen sich direkt online oder über die Rex-App auswählen und buchen.",
        "en": "Yes, appointments can be selected and booked directly online or via the Rex app."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Wird in der Praxis auch Englisch gesprochen?",
        "en": "Is English spoken at the practice?"
      },
      "a": {
        "de": "Ja, mehrere Ärztinnen und Mitarbeiter im Team beraten Tierhalter problemlos auf Englisch.",
        "en": "Yes, multiple doctors and staff members consult pet owners smoothly in English."
      },
      "basis": "both"
    }
  ],
