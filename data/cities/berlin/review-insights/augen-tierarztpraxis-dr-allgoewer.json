  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "de": "Höchste Fachkompetenz bei der augenärztlichen Diagnostik",
        "en": "Specialized expertise in veterinary ophthalmology"
      },
      "text": {
        "de": "Tierhalter loben das Team um Dr. Allgöwer für tiefgreifendes Fachwissen bei komplexen Augenerkrankungen. Die Mediziner erklären Diagnosen verständlich und stimmen Therapieschritte eng mit den überweisenden Haustierärzten ab. Auch englischsprachige Beratungen werden positiv erwähnt.",
        "en": "Pet owners commend the clinical team led by Dr. Allgöwer for profound expertise in intricate eye conditions. The veterinarians explain findings clearly and coordinate therapy steps closely with referring general vets. Consultations conducted in English also receive favorable feedback."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "de": "Erfolgreiche Eingriffe bei Hornhaut und Glaukom",
        "en": "Successful surgeries for cornea and glaucoma"
      },
      "text": {
        "de": "Zahlreiche Berichte schildern erfolgreiche operative Behandlungen von Hornhautverletzungen, Rolllidern, Katarakten und grünem Star. Viele Tiere konnten vor einer Erblindung bewahrt werden oder erholten sich nach Eingriffen zügig. Die Behandlungsresultate schaffen bei Haltern großes Vertrauen.",
        "en": "Numerous accounts describe successful surgical interventions for corneal injuries, entropion, cataracts, and glaucoma. Many companion animals were saved from vision loss or recovered quickly following clinical procedures. The treatment outcomes foster substantial confidence among pet owners."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "de": "Ruhiger und geduldiger Umgang mit Angstpatienten",
        "en": "Calm approach to anxious animal patients"
      },
      "text": {
        "de": "Besitzer schätzen die besonnene Atmosphäre, durch die selbst nervöse Hunde und scheue Katzen während der Augenuntersuchung ruhig bleiben. Die Fachkräfte gehen behutsam vor, um unnötigen Stress zu vermeiden. Lediglich vereinzelt wurde ein zu energisches Festhalten bei einer Behandlung kritisiert.",
        "en": "Guardians value the composed setting that keeps even nervous dogs and timid felines relaxed during ocular examinations. Practitioners proceed gently to minimize examination stress. Only isolated feedback noted overly firm restraint techniques during a specific clinical appointment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Werden Augenoperationen direkt in der Praxis durchgeführt?",
        "en": "Are ophthalmic surgeries performed directly at the practice?"
      },
      "a": {
        "de": "Ja, Halterinnen berichten regelmäßig über ambulante Operationen bei Hornhautdefekten, Rolllidern oder Katarakt.",
        "en": "Yes, owners frequently report outpatient surgeries for corneal damage, entropion, and cataract treatment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Ist eine Beratung in englischer Sprache möglich?",
        "en": "Can consultations be conducted in English?"
      },
      "a": {
        "de": "Ja, Patientenbesitzer heben hervor, dass Beratungsgespräche problemlos auch auf Englisch stattfinden können.",
        "en": "Yes, clients highlight that consultations are readily offered in English upon request."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Gibt es einen Außenbereich zum Warten mit nervösen Tieren?",
        "en": "Is there an outdoor waiting garden for stressed animals?"
      },
      "a": {
        "de": "Ja, die Praxis bietet einen Garten mit Aufrufsystem (Pieper), wodurch Tiere im Grünen auf ihren Aufruf warten können.",
        "en": "Yes, the clinic features a garden equipped with pagers so pets can wait quietly outside."
      },
      "basis": "reviews"
    }
