  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "de": "Freundliche Marktberatung bei geteilten Eindrücken",
        "en": "Friendly store advice alongside varying experiences"
      },
      "text": {
        "de": "Ein Großteil der Besucher schätzt die zuvorkommende Art und das Fachwissen der Angestellten in den Fachabteilungen. Fragen zu Futter und Zubehör werden oft geduldig beantwortet. Dennoch berichten vereinzelte Kunden über unmotiviertes Auftreten an Kassen oder mangelnde Auskunftsbereitschaft.",
        "en": "A large majority of visitors value the courteous attitude and product knowledge of department staff. Inquiries regarding feed and pet gear are often handled patiently. Nevertheless, isolated shoppers report indifferent cashier interactions or unhelpful responses when asking specific questions."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "de": "Riesige Verkaufsfläche mit beeindruckender Aquaristik",
        "en": "Expansive retail space with impressive aquatics"
      },
      "text": {
        "de": "Kunden loben die enorme Größe des Marktes, die breite Produktauswahl für Hunde, Katzen und Exoten sowie die übersichtliche Gestaltung. Das Geschäft bietet eine eindrucksvolle Schau an Schauaquarien. Einzelne Stimmen weisen jedoch auf unsaubere Regalecken oder beschädigte Verpackungen hin.",
        "en": "Shoppers praise the sheer size of the superstore, wide product ranges for dogs, cats, and exotics, and organized layout. The facility presents an impressive array of display aquariums. Isolated reviews point to dusty shelf sections or occasional damaged product packaging on display."
      }
    },
    {
      "topic": "results",
      "sentiment": "negative",
      "mentions": 5,
      "title": {
        "de": "Ernsthafte Beschwerden beim Kauf lebender Heimtiere",
        "en": "Serious concerns regarding live pet purchases"
      },
      "text": {
        "de": "Kritische Rezensionen befassen sich mit gesundheitlichen Problemen bei erworbenen Zierfischen, Schnecken oder Kaninchen. Käufer schildern Parasitenbefall oder unerwartete Verluste kurz nach dem Einzug. Diese Vorfälle führen bei betroffenen Tierfreunden zu deutlichem Unmut und Vertrauensverlust.",
        "en": "Critical reviews focus on health issues encountered with purchased aquarium fish, snails, or rabbits. Buyers describe parasite infestations or sudden losses shortly after arrival at home. These occurrences lead to significant disappointment and eroded trust among affected animal lovers."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Bietet der Megazoo Lankwitz eine Aquaristikabteilung?",
        "en": "Does Megazoo Lankwitz offer an aquatics department?"
      },
      "a": {
        "de": "Ja, der Markt führt Süß- und Meerwasseraquaristik mit Zierfischen, Wasserpflanzen und Technik.",
        "en": "Yes, the branch features freshwater and marine aquatics with ornamental fish, plants, and gear."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es vor der Filiale in Lankwitz Parkplätze?",
        "en": "Are customer parking spaces available at Lankwitz?"
      },
      "a": {
        "de": "Ja, direkt auf dem Gelände vor dem Fachmarkt befinden sich zahlreiche Stellplätze für Kunden.",
        "en": "Yes, numerous designated customer parking spaces are situated directly on the store premises."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Führt der Markt auch Rohfutter und BARF-Artikel?",
        "en": "Does the store carry raw pet food and BARF products?"
      },
      "a": {
        "de": "Ja, im Markt gibt es eine eigene Abteilung mit Tiefkühlfleisch und BARF-Zusätzen für Hunde und Katzen.",
        "en": "Yes, the branch maintains a dedicated section with frozen meat and BARF supplements for pets."
      },
      "basis": "both"
    }
  ],
