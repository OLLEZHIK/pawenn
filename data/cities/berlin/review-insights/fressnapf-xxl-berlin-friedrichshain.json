  "observed_at": "2026-10-06",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 79,
      "title": {
        "de": "Freundliche Fachberatung im gesamten Fachmarkt",
        "en": "Friendly advice across the superstore"
      },
      "text": {
        "de": "Viele Kunden heben die hilfsbereite und kompetente Unterstützung der Marktmitarbeiter hervor. In den verschiedenen Abteilungen wird gern bei Ernährungsfragen geholfen. Vereinzelt berichten Besucher jedoch über schroffere Antworten oder unbesetzte Beratungsplätze in der Aquaristikabteilung bei hohem Andrang.",
        "en": "Many customers emphasize the helpful and knowledgeable assistance provided by store employees. Staff members gladly offer guidance on pet nutrition across different sections. However, isolated visitors mention brusque answers or unstaffed service counters in the aquatics area during busy hours."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "de": "Großflächiger XXL-Markt mit breitem Sortiment",
        "en": "Spacious XXL store with wide selection"
      },
      "text": {
        "de": "Der Markt überzeugt Tierhalter durch seine weitläufige Verkaufsfläche, ein umfangreiches Futterangebot und kostenlose Parkplätze vor dem Gebäude. Während Hunde- und Katzenhalter fast alles finden, merken manche Kleintier- oder Vogelhalter an, dass spezielle Artikel gelegentlich vergriffen sind.",
        "en": "The store impresses pet guardians with its expansive retail floor, comprehensive pet food variety, and free parking outside the building. While dog and cat owners find almost everything, some bird and small animal enthusiasts note that specialized supplies are occasionally out of stock."
      }
    },
    {
      "topic": "results",
      "sentiment": "negative",
      "mentions": 4,
      "title": {
        "de": "Gemischte Erfahrungen bei Futterfrische und Zierfischen",
        "en": "Critical issues with specialty goods and fish"
      },
      "text": {
        "de": "Mehrere Rezensenten äußern Kritik an der Qualität spezieller Zukäufe im Markt. Bemängelt werden fehlerhaft zugeordnete Aquarienfische, verdorbenes Frostfutter oder fehlende Spezialdiäten aus dem Onlineshop. Diese Einzelfälle trüben bei den betroffenen Haltern den ansonsten soliden Gesamteindruck des Marktes.",
        "en": "Several reviewers express dissatisfaction with the quality of certain specialty purchases in the store. Complaints involve incorrectly identified aquarium fish, spoiled frozen feed, or unavailable dietary brands listed online. These isolated incidents diminish the otherwise solid overall store experience for affected shoppers."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Gibt es vor dem Markt in Friedrichshain Parkmöglichkeiten?",
        "en": "Are parking spaces available outside the Friedrichshain store?"
      },
      "a": {
        "de": "Ja, direkt vor dem XXL-Fachmarkt stehen Kunden kostenfreie Parkplätze zur Verfügung.",
        "en": "Yes, dedicated complimentary parking spaces are available directly outside the XXL branch."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Führt die Filiale auch Zubehör für Aquaristik und Terraristik?",
        "en": "Does the branch stock supplies for aquatics and terrariums?"
      },
      "a": {
        "de": "Ja, der Markt verfügt über Aquarien, Zierfische, Technik sowie Lebendfutter für Terrarientiere.",
        "en": "Yes, the store features an aquatics section with ornamental fish, equipment, and live feed for terrariums."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Dürfen Hunde beim Einkaufen mit in den Markt genommen werden?",
        "en": "Are dogs allowed inside the store during shopping?"
      },
      "a": {
        "de": "Ja, angeleinte Hunde sind im Markt willkommen und können an der Hundewaage gewogen werden.",
        "en": "Yes, leashed dogs are welcome inside the superstore and can use the on-site canine scales."
      },
      "basis": "reviews"
    }
  ],
