  "google_maps_url": "https://www.google.com/maps/place/Fressnapf+XXL+Berlin-Friedrichhain/@52.5225945,13.4645626,17z/data=!3m1!4b1!4m6!3m5!1s0x47a84e62e2808973:0xa6110b9cc47b90aa!8m2!3d52.5225945!4d13.4645626!16s%2Fg%2F1tf30d_j?authuser=0&hl=de&entry=ttu&g_ep=EgoyMDI2MDkzMC4wIKXMDSoASAFQAw%3D%3D",
  "period_from": "2026-04-06",
