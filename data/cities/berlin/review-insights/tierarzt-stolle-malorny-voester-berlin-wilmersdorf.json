  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "de": "Kompetente Fachtierärzte und eingespieltes Team",
        "en": "Skilled veterinary specialists and coordinated staff"
      },
      "text": {
        "de": "Tierhalter loben die hohe Fachkompetenz und das einfühlsame Auftreten der Tierärztinnen in Berlin-Wilmersdorf. Besonders Frau Stolle-Malorny und Dr. Vöster werden für fundierte Beratungen bei chronischen Leiden geschätzt. Auch das Empfangsteam wird als freundlich und gut organisiert wahrgenommen.",
        "en": "Clients praise the deep clinical competence and empathetic conduct of the veterinarians in Berlin-Wilmersdorf. In particular, Dr. Stolle-Malorny and Dr. Vöster are valued for thorough advice regarding chronic illnesses. The reception staff is likewise perceived as courteous and well-organized."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "de": "Liebevolle Zuwendung für Hunde und Katzen",
        "en": "Affectionate care for dogs and cats"
      },
      "text": {
        "de": "Hunde, Katzen und Kaninchen werden mit spürbarer Tierliebe und Geduld untersucht. Halter von ängstlichen Tieren oder Hunden mit Epilepsie betonen, dass Behandlungen ohne Hektik und mit beruhigenden Gesten erfolgen. Sogar ein praktisches Pagersystem erlaubt stressfreies Warten im Auto.",
        "en": "Dogs, cats, and rabbits are examined with noticeable warmth and patience. Owners of nervous pets or epileptic canines emphasize that visits proceed without rush and with calming gestures. A convenient pager system also enables relaxed waiting outside inside one's car."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 7,
      "title": {
        "de": "Zuverlässige Diagnostik bei komplexen Leiden",
        "en": "Dependable diagnostics in complex medical conditions"
      },
      "text": {
        "de": "Zahlreiche Bewertungen berichten von erfolgreichen Therapien in Neurologie, Kardiologie und Zahnheilkunde. Chronische Krankheiten wie Diabetes oder Morbus Addison werden präzise eingestellt und engmaschig begleitet. Operationen wie Milzentfernungen verlaufen nach Kundenangaben reibungslos.",
        "en": "Numerous reviews report successful outcomes across neurology, cardiology, and veterinary dentistry. Chronic disorders such as diabetes or Addison's disease are managed accurately with close monitoring. Surgeries including splenectomies proceed smoothly according to client reports."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Bietet die Praxis eine Spezialisierung in Neurologie?",
        "en": "Does the clinic offer specialization in neurology?"
      },
      "a": {
        "de": "Ja, Halter heben die neurologische Expertise von Frau Stolle-Malorny bei Epilepsie und Wirbelsäulenleiden hervor.",
        "en": "Yes, clients highlight the neurological expertise of Dr. Stolle-Malorny for epilepsy and spinal conditions."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Können Tiere stressfrei außerhalb des Wartezimmers warten?",
        "en": "Can animals wait outside the waiting room?"
      },
      "a": {
        "de": "Ja, Kunden loben das praktische Pagersystem, mit dem ängstliche Tiere im Auto warten können.",
        "en": "Yes, clients praise the pager system allowing nervous pets to wait comfortably in the vehicle."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Gibt es Behandlungen für chronische Erkrankungen wie Diabetes?",
        "en": "Are treatments available for chronic diseases like diabetes?"
      },
      "a": {
        "de": "Ja, Halterinnen schätzen die fundierte internistische Betreuung bei Diabetes und endokrinologischen Leiden.",
        "en": "Yes, owners value the dedicated internal medicine support for diabetes and endocrine conditions."
      },
      "basis": "both"
    }
  ],
