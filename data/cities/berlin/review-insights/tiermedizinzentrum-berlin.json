  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "de": "Breite Fachkompetenz und loyale Patientenbindung",
        "en": "Broad clinical expertise and loyal clientele"
      },
      "text": {
        "de": "Ärzte wie Uğur Can Bozkır und Vogelspezialistin Dr. Schuhmann genießen bei Kunden großes Vertrauen; viele Halter bleiben ihnen über Jahre treu. Das Team wird für Gründlichkeit und Empathie gelobt. Nur wenige Stimmen kritisieren ein unnahbares Auftreten oder telefonische Abweisungen in den späten Abendstunden.",
        "en": "Clinicians such as Uğur Can Bozkır and avian expert Dr. Schuhmann enjoy tremendous trust, with many clients following them across clinics. Staff members are praised for thoroughness and empathy. Only a few reviews report an aloof reception or refusal over the telephone during late night hours."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "de": "Spezialisierte Versorgung von Heim- und Wildtieren",
        "en": "Dedicated care for small domestic animals"
      },
      "text": {
        "de": "Die Klinik ist eine gefragte Anlaufstelle für Kaninchen, Meerschweinchen, Vögel und verletzte Fundtiere wie Fledermäuse oder Krähen. Halter schätzen das Spezialwissen bei Nagerkrankheiten und die unkomplizierte Aufnahme von Wildtieren. Ein einzelner Katerhalter bemängelte hingegen unnötige Sedierungsmaßnahmen.",
        "en": "The medical center serves as a renowned destination for rabbits, guinea pigs, pet birds, and rescued wildlife such as bats and crows. Clients praise specialized knowledge in exotic mammal care and the willingness to accept found animals. Conversely, one feline owner questioned sedation protocols."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "de": "Verlässlicher Notdienst mit schwankenden Wartezeiten",
        "en": "Dependable emergency service with varied waits"
      },
      "text": {
        "de": "Der nächtliche Notdienst und Wochenend-Bereitschaftsdienst werden als Rettungsanker für akute Fälle geschätzt. Gleichzeitig berichten Besucher von längeren Wartezeiten im Wartezimmer trotz Termin, und nachts wird vereinzelt über unzureichende telefonische Erreichbarkeit kurz vor Praxisschluss geklagt.",
        "en": "The overnight on-call service and weekend readiness are valued as vital lifelines for acute emergencies. At the same time, daytime visitors report noticeable waiting periods despite fixed bookings, and isolated late-night reviews mention difficulties reaching staff just before closing."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Werden in der Praxis auch Wildtiere wie Fledermäuse oder Vögel angenommen?",
        "en": "Are wildlife like bats or birds admitted at the clinic?"
      },
      "a": {
        "de": "Ja, Finder berichten regelmäßig, dass verletzte Wildtiere wie Vögel oder Fledermäuse hilfsbereit aufgenommen werden.",
        "en": "Yes, finders regularly report that injured wild animals like birds or bats are compassionately admitted for care."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Gibt es Spezialisten für Kaninchen und Vögel?",
        "en": "Are there specialists for rabbits and birds?"
      },
      "a": {
        "de": "Ja, die Praxis verfügt über erfahrene Fachtierärzte für Heimtiere und Ziervögel, darunter Dr. Schuhmann.",
        "en": "Yes, the clinic houses experienced specialists for small exotic pets and pet birds, including Dr. Schuhmann."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Bietet das Zentrum einen Notdienst am Wochenende an?",
        "en": "Does the center provide weekend emergency services?"
      },
      "a": {
        "de": "Ja, es existiert ein Bereitschaftsdienst an Wochenenden und Feiertagen, wobei gesetzliche Notdienstgebühren anfallen.",
        "en": "Yes, an emergency service operates on weekends and holidays, subject to statutory emergency surcharge fees."
      },
      "basis": "both"
    }
  ],
