  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 53,
      "title": {
        "de": "Engagierte Intensivpflege neben deutlicher Kritik",
        "en": "Dedicated intensive care alongside sharp criticism"
      },
      "text": {
        "de": "Zahlreiche Kunden loben das einfühlsame Verhalten einzelner Notfallärzte und Pfleger bei akuten Lebensgefahr-Situationen. Viele andere Rezensenten beklagen jedoch mangelnde Empathie, kühle Kommunikation am Empfang und wechselnde Ansprechpartner bei stationären Aufenthalten.",
        "en": "Numerous clients commend compassionate conduct by emergency doctors and ward nurses during acute life-threatening situations. Many other reviewers complain, however, about cold reception staff, perceived lack of empathy, and rotating attending veterinarians during hospital stays."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 31,
      "title": {
        "de": "Erfolgreiche Notoperationen und tragische Komplikationen",
        "en": "Successful emergency surgeries and tragic complications"
      },
      "text": {
        "de": "Dankbare Halter berichten von lebensrettenden Eingriffen, schneller Stabilisierung und erfolgreicher Behandlung schwerer Traumata. Auf der anderen Seite äußern betroffene Tierhalter Frustration über unklare Diagnosen, plötzliche Todesfälle oder als unzureichend empfundene Therapien.",
        "en": "Grateful owners recount life-saving surgical procedures, prompt stabilization, and successful management of severe trauma. Conversely, distressed guardians express frustration over ambiguous diagnoses, sudden clinical declines, or therapeutic measures they perceived as ineffective."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 14,
      "title": {
        "de": "Erhebliche Verzögerungen im Notaufnahmebetrieb",
        "en": "Prolonged delays during emergency admissions"
      },
      "text": {
        "de": "Die Wartezeiten im Klinikalltag werden von vielen Rezensenten stark kritisiert. Selbst mit schwerkranken Tieren mussten Besitzer teils mehrere Stunden im Wartebereich ausharren. Das medizinische Notfall-Triage-System sorgt bei wartenden Haltern wiederholt für Unverständnis und Anspannung.",
        "en": "Waiting times during emergency operations are strongly criticized by many reviewers. Even with severely ill pets, owners had to endure several hours in waiting rooms. The clinical triage prioritization protocol frequently causes heightened stress and confusion among waiting guardians."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Ist die Tierklinik in Biesdorf rund um die Uhr besetzt?",
        "en": "Is the veterinary clinic in Biesdorf staffed around the clock?"
      },
      "a": {
        "de": "Ja, die Klinik unterhält einen durchgehenden 24/7-Notdienst an allen Tagen des Jahres.",
        "en": "Yes, the hospital maintains continuous 24/7 emergency service every day of the year."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden in der Klinik auch Reptilien und Exoten behandelt?",
        "en": "Are reptiles and exotic pets treated at the clinic?"
      },
      "a": {
        "de": "Ja, das Ärzteteam verfügt über tiermedizinische Fachexpertise für Kleinsäuger und Reptilien.",
        "en": "Yes, the medical staff provides specialized clinical expertise for small mammals and reptiles."
      },
      "basis": "website"
    },
    {
      "q": {
        "de": "Werden Notfälle nach Ankunftszeit oder Dringlichkeit behandelt?",
        "en": "Are emergency cases handled by arrival time or urgency?"
      },
      "a": {
        "de": "Behandlungen im Notdienst erfolgen nach medizinischer Dringlichkeit (Triage), wodurch Wartezeiten entstehen können.",
        "en": "Emergency admissions follow clinical urgency (triage), meaning non-critical cases may experience waits."
      },
      "basis": "reviews"
    }
  ],
