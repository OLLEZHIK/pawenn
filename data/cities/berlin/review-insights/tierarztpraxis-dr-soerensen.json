  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 104,
      "title": {
        "de": "Hohe fachliche Kompetenz und herzliche Betreuung",
        "en": "High clinical competence and warm care"
      },
      "text": {
        "de": "Tierhalter äußern sich überaus positiv über das gesamte Praxisteam und Dr. Sörensen. Die Tierärzte nehmen sich viel Zeit, erklären Diagnosen verständlich und schaffen eine vertrauensvolle Atmosphäre. Nur vereinzelt wird über sachlichere oder knappere Gespräche bei Vertretungen berichtet.",
        "en": "Pet owners express overwhelmingly positive feedback about Dr. Sörensen and the clinic team. Veterinarians take ample time, explain diagnoses clearly, and foster a trusting atmosphere. Only isolated reviews mention briefer or more clinical interactions during locum consultations."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 21,
      "title": {
        "de": "Schnelle Terminvergabe neben vereinzelten Wartezeiten",
        "en": "Prompt scheduling alongside occasional waiting times"
      },
      "text": {
        "de": "Die Online-Buchung und die Vergabe zeitnaher Termine werden von vielen Rezensenten sehr gelobt. Trotz guter Organisation kann es an vollen Behandlungstagen oder bei unvorhergesehenen Notfällen zu Verzögerungen im Wartezimmer kommen, was von einzelnen Haltern bedauert wird.",
        "en": "Online booking and prompt appointment scheduling are praised by many reviewers. Despite good practice organization, busy treatment days or unexpected emergencies can occasionally result in delays inside the waiting room, which some pet guardians note in their reviews."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 12,
      "title": {
        "de": "Erfolgreiche Behandlungsverläufe in Orthopädie und Chirurgie",
        "en": "Successful surgical outcomes and orthopedic recovery"
      },
      "text": {
        "de": "Klienten berichten erfreut über gelungene Operationen, wirksame Schmerztherapien und die Genesung ihrer Hunde und Katzen. Das breite Spektrum an Diagnostik führt meist zu rascher Besserung. Vereinzelt schildern Halter jedoch unklare Krankheitsverläufe oder ausbleibende Fortschritte.",
        "en": "Clients report pleased experiences with successful operations, effective pain therapies, and positive recoveries for dogs and cats. Broad diagnostic capabilities generally lead to swift improvement. Isolated reviews recount ambiguous clinical progressions or slow convalescence."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Kann man bei Dr. Sörensen Termine online buchen?",
        "en": "Can appointments be booked online at Dr. Sörensen's clinic?"
      },
      "a": {
        "de": "Ja, die Praxis bietet eine bequeme Online-Terminbuchung über die eigene Webseite an.",
        "en": "Yes, the clinic offers convenient online appointment scheduling through its official website."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Welche chirurgischen Schwerpunkte bietet die Praxis an?",
        "en": "Which surgical specialties does the practice provide?"
      },
      "a": {
        "de": "Das Team führt Weichteiloperationen, Orthopädie sowie spezialisierte Zahnbehandlungen durch.",
        "en": "The team performs soft-tissue surgeries, orthopedic procedures, and specialized dental operations."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es Öffnungszeiten am Wochenende?",
        "en": "Are there weekend opening hours at the practice?"
      },
      "a": {
        "de": "Ja, die Praxis bietet auch an Samstagen und Sonntagen jeweils Sprechstunden von 10:00 bis 18:00 Uhr an.",
        "en": "Yes, the clinic holds regular weekend consultations on Saturdays and Sundays from 10:00 to 18:00."
      },
      "basis": "both"
    }
  ],
