  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "de": "Entspannte Behandlung sensibler Tiere",
        "en": "Gentle treatment for sensitive pets"
      },
      "text": {
        "de": "Besonders positiv fällt auf, wie behutsam das Team mit sensiblen oder nervösen Tieren umgeht. Hunde, die normalerweise Angst vor Pflegeutensilien haben, zeigen sich erstaunlich ruhig und entspannt. Auch Halter sensibler Katzen bestätigen einen stressfreien Ablauf ohne spürbare Hektik.",
        "en": "Pet parents highlight the compassionate touch shown toward sensitive or easily frightened animals. Dogs that normally dislike grooming tools remain remarkably calm throughout the session. Owners of anxious cats likewise confirm a stress-free experience carried out without any rushing."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "de": "Aufmerksames und einfühlsames Personal",
        "en": "Attentive and empathetic salon team"
      },
      "text": {
        "de": "Kunden heben durchweg die Freundlichkeit und Professionalität der Mitarbeiterinnen wie Darin und Oksana hervor. Das Team geht geduldig auf Kundenwünsche ein und nimmt sich ausreichend Zeit für jedes Tier. Halter schätzen die unkomplizierte Beratung und die herzliche Aufnahme bei jedem Termin.",
        "en": "Clients consistently commend the kindness and professionalism of stylists such as Darin and Oksana. The staff attentively accommodates specific requests and dedicates ample time to each pet. Owners appreciate the clear communication and welcoming reception experienced during every visit."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "de": "Präzise Haarschnitte und gründliche Pflege",
        "en": "Precise haircuts and complete grooming"
      },
      "text": {
        "de": "Zahlreiche Bewertungen berichten begeistert von perfekt geschnittenem Fell bei Rassen wie Maltipoo, Pudel oder Yorkie. Die Hunde wirken nach dem Besuch gepflegt, sauber und duftend. Auch die Behandlung von Katzen und das Entfilzen dichter Unterwolle werden handwerklich als exzellent beschrieben.",
        "en": "Numerous reviews enthusiastically describe neat and stylish cuts for breeds including Maltipoos, Poodles, and Yorkies. Pets return home thoroughly clean, fresh-smelling, and well-groomed. The careful detangling of thick undercoats and grooming of cats also receive widespread appreciation."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Können Termine auch kurzfristig und online vereinbart werden?",
        "en": "Can appointments be booked online and on short notice?"
      },
      "a": {
        "de": "Ja, Halter berichten von einer schnellen, unkomplizierten Terminvergabe online sowie flexiblen Absprachen bei Bedarf.",
        "en": "Yes, clients report smooth online scheduling and flexible appointment options even on shorter notice."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Werden im Salon auch Katzen fachgerecht gepflegt?",
        "en": "Does the salon groom cats in addition to dogs?"
      },
      "a": {
        "de": "Ja, mehrere Halter erwähnen erfolgreiche und stressfreie Pflegebehandlungen für sensible Katzen und Kater.",
        "en": "Yes, several owners report successful and calm grooming sessions for sensitive cats and kittens."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Ist vor Ort im Salon eine Kartenzahlung möglich?",
        "en": "Is card payment accepted at the salon?"
      },
      "a": {
        "de": "Ja, Kunden bestätigen, dass Behandlungen vor Ort problemlos per Karte bezahlt werden können.",
        "en": "Yes, customers confirm that treatments can be paid comfortably via card on site."
      },
      "basis": "reviews"
