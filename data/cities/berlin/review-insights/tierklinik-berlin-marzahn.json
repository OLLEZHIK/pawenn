  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 60,
      "title": {
        "de": "Engagierter Nachtdienst neben kritischen Stimmen",
        "en": "Dedicated night staff alongside critical voices"
      },
      "text": {
        "de": "Viele Tierhalter danken dem Notfallteam für die unermüdliche Betreuung ihrer Lieblinge zu nächtlicher Stunde. Andere Klienten kritisieren hingegen einen als unfreundlich, gehetzt oder wenig einfühlsam empfundenen Umgangston, insbesondere an stressigen Schichttagen mit hohem Patientenaufkommen.",
        "en": "Many pet owners thank the emergency team for tireless care given to their companions during overnight hours. Other clients criticize an attitude perceived as abrupt, rushed, or lacking empathy, particularly on stressful shifts with high patient volume."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 22,
      "title": {
        "de": "Rettende Notfallmedizin bei geteilten Therapieerfolgen",
        "en": "Life-saving emergency care with divided outcomes"
      },
      "text": {
        "de": "Rezensenten heben erfolgreiche Sofortoperationen und die Rettung von Tieren in kritischem Zustand dankbar hervor. Demgegenüber stehen schmerzhafte Berichte über verschlechterte Krankheitsverläufe, unklare Befunde oder Tiere, denen in der Notaufnahme nicht mehr geholfen werden konnte.",
        "en": "Reviewers gratefully highlight successful urgent operations and the recovery of animals admitted in critical condition. In contrast, painful reports describe deteriorating patient conditions, ambiguous diagnostic results, or cases where emergency intervention came too late."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 14,
      "title": {
        "de": "Lange Wartezeiten im Notaufnahmebetrieb",
        "en": "Protracted waits in emergency admissions"
      },
      "text": {
        "de": "Wiederholt berichten Halter über mehrstündiges Warten im Vorraum vor der ersten Untersuchung. Selbst bei akuten Schmerzen wird die Wartezeit als belastend empfunden. Die Klinik priorisiert Fälle nach medizinischer Dringlichkeit, was zu Verzögerungen für stabile Patienten führt.",
        "en": "Owners repeatedly recount waiting several hours in the reception area before initial veterinary evaluation. Waiting is perceived as distressing, particularly when pets suffer acute pain. The hospital triages cases by clinical urgency, leading to delays for more stable patients."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Ist die Notaufnahme in Marzahn jederzeit geöffnet?",
        "en": "Is the Marzahn emergency department open at all times?"
      },
      "a": {
        "de": "Ja, die Tierklinik bietet eine durchgehende 24-Stunden-Notaufnahme an 365 Tagen im Jahr an.",
        "en": "Yes, the veterinary hospital provides a continuous 24-hour emergency room 365 days a year."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Wie werden Notfälle in der Klinik gereiht?",
        "en": "How are emergency arrivals prioritized at the hospital?"
      },
      "a": {
        "de": "Die Aufnahme erfolgt nach lebensbedrohlicher Dringlichkeit (Triage) und nicht nach Eintreffen.",
        "en": "Admissions are prioritized according to life-threatening clinical urgency (triage) rather than arrival time."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Verfügt die Klinik über stationäre Betreuungsplätze?",
        "en": "Does the clinic have inpatient hospitalization facilities?"
      },
      "a": {
        "de": "Ja, die Einrichtung verfügt über Intensivstationen für die stationäre Überwachung kranker Tiere.",
        "en": "Yes, the facility maintains dedicated intensive care units for inpatient monitoring of ill pets."
      },
      "basis": "both"
    }
  ],
