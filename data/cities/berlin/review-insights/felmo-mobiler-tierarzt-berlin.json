  "google_maps_url": "https://www.google.com/maps/place/felmo+Mobiler+Tierarzt+Berlin/@52.5241016,13.3327137,17z/data=!3m1!4b1!4m6!3m5!1s0x47a851daf8337149:0x6726eb1d6104038b!8m2!3d52.5241016!4d13.3327137!16s%2Fg%2F11hds6bxzr?authuser=0&hl=de&entry=ttu&g_ep=EgoyMDI2MDkzMC4wIKXMDSoASAFQAw%3D%3D",
