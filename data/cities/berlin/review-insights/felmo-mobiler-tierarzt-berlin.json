  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 167,
      "title": {
        "de": "Einfühlsame Hausbesuche durch engagierte Tierärzte",
        "en": "Empathetic home visits by dedicated veterinarians"
      },
      "text": {
        "de": "Zahlreiche Tierhalter loben das mobile Praxisteam für seine ruhige und verständnisvolle Art bei Untersuchungen in den eigenen vier Wänden. Die Ärzte nehmen sich Zeit für gründliche Erklärungen und Beratung. Vereinzelt bemängeln Kunden jedoch wechselnde Ansprechpartner oder knappe Besuchszeiten bei Folgeterminen.",
        "en": "Numerous pet owners praise the mobile veterinary team for their calm and understanding bedside manner during examinations at home. The doctors take time for detailed explanations and medical advice. However, occasional reviewers note changing veterinary contacts or rushed appointment windows on follow-up visits."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "de": "Pünktliche Ankunft ohne Wartezimmerstress zu Hause",
        "en": "Punctual arrival without waiting room stress"
      },
      "text": {
        "de": "Kunden schätzen die verlässliche Einhaltung der vereinbarten Zeitfenster direkt an der Haustür. Das Entfallen langer Aufenthalte in vollen Wartezimmern wird als enorme Erleichterung empfunden. Die flexible Terminfindung über die Smartphone-App sorgt bei den meisten Haltern für eine reibungslose und planbare Versorgung.",
        "en": "Clients appreciate that scheduled arrival windows at the doorstep are consistently met. Eliminating prolonged stays in crowded clinical waiting rooms is seen as a major relief. Flexible appointment scheduling through the smartphone application provides most pet owners with predictable and smooth home veterinary care."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "de": "Stressarme Behandlung in vertrauter heimischer Umgebung",
        "en": "Low-stress care in familiar home surroundings"
      },
      "text": {
        "de": "Besonders für ängstliche Hunde und sensible Katzen bewerten Rezensenten den mobilen Service als großen Vorteil. Die Tiere bleiben in ihrer gewohnten Umgebung entspannter und fassen schneller Zutrauen zur behandelnden Tierärztin. Nur vereinzelt wird von Abwehrreaktionen oder unruhigen Momenten bei Blutabnahmen berichtet.",
        "en": "Reviewers highlight the mobile service as a major advantage, especially for anxious dogs and sensitive cats. Animals remain noticeably calmer in their familiar domestic environment and build trust with the visiting veterinarian faster. Only isolated reports mention defensive reactions or nervous moments during blood draws."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Wie werden Termine für den Hausbesuch von felmo vereinbart?",
        "en": "How are home visit appointments arranged with felmo?"
      },
      "a": {
        "de": "Termine und gewünschte Zeitfenster werden unkompliziert über die felmo-App oder online gebucht.",
        "en": "Appointments and desired time slots are booked straightforwardly via the felmo mobile app or online."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Welche Behandlungen können die Tierärzte direkt vor Ort durchführen?",
        "en": "Which treatments can the veterinarians carry out directly on site?"
      },
      "a": {
        "de": "Die mobilen Tierärzte übernehmen Allgemeinuntersuchungen, Impfungen, Blutabnahmen und die Versorgung chronischer Erkrankungen.",
        "en": "Mobile veterinarians perform general examinations, vaccinations, blood testing, and management of chronic diseases."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Ist der mobile Tierarzt-Service für ängstliche Haustiere geeignet?",
        "en": "Is the mobile veterinary service suitable for anxious pets?"
      },
      "a": {
        "de": "Ja, viele Halter berichten, dass Katzen und scheue Hunde in gewohnter Umgebung wesentlich ruhiger bleiben.",
        "en": "Yes, many owners report that cats and timid dogs remain significantly calmer in their everyday home surroundings."
      },
      "basis": "reviews"
    }
  ],
