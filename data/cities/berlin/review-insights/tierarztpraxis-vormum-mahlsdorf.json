  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 77,
      "title": {
        "de": "Herzliches Praxisteam und verlässliche Beratung",
        "en": "Warm practice team and dependable advice"
      },
      "text": {
        "de": "Tierhalter loben das einfühlsame und engagierte Auftreten des Teams in Berlin-Mahlsdorf. Ärztinnen und Assistentinnen nehmen sich viel Zeit für verständliche Erklärungen und schaffen eine vertrauensvolle Atmosphäre. Selbst bei hohem Patientenaufkommen bleibt das Personal freundlich und hilfsbereit.",
        "en": "Pet owners commend the compassionate and committed attitude of the team in Berlin-Mahlsdorf. Vets and assistants take ample time for clear explanations and create a trusting environment. Even during high patient volume, the staff remains notably courteous and supportive."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 30,
      "title": {
        "de": "Einfühlsamer Umgang mit ängstlichen Tieren",
        "en": "Gentle handling of fearful animal companions"
      },
      "text": {
        "de": "Hunde, Katzen und Kaninchen werden mit spürbarer Tierliebe und Ruhe empfangen. Besonders Besitzer von nervösen Hunden heben hervor, dass mit Geduld auf individuelle Eigenheiten eingegangen wird. Die sanfte Berührung nimmt Vierbeinern vor Behandlungen schnell die anfängliche Scheu.",
        "en": "Dogs, cats, and rabbits are welcomed with palpable warmth and calmness. Owners of nervous dogs particularly emphasize that individual traits are met with patient care. Gentle handling swiftly alleviates initial apprehension before clinical examinations take place."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "de": "Kurze Wartezeiten mit gelegentlichen Verzögerungen",
        "en": "Short waiting times with occasional delays"
      },
      "text": {
        "de": "Die Terminorganisation über das Online-System wird von vielen Kunden für planbare und zügige Abläufe gelobt. Bei akuten Notfällen oder personellen Engpässen berichten einzelne Tierhalter jedoch von spürbaren Wartezeiten vor Ort. Die Zufriedenheit mit der Termineinhaltung variiert daher gelegentlich.",
        "en": "Appointment scheduling via the online booking tool is praised by many clients for predictable, swift visits. During acute emergency arrivals or staffing constraints, however, individual owners report noticeable waiting times. Overall satisfaction with appointment punctuality varies accordingly."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Können Termine online vereinbart werden?",
        "en": "Can appointments be booked online?"
      },
      "a": {
        "de": "Ja, Halter heben die bequeme und unkomplizierte Terminvergabe über die Praxis-Website hervor.",
        "en": "Yes, clients highlight the convenient online booking tool directly on the clinic website."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden ängstliche Hunde besonders behutsam betreut?",
        "en": "Are anxious dogs treated with extra patience?"
      },
      "a": {
        "de": "Ja, Besitzer von Angsthunden berichten von viel Geduld und ruhigem Eingehen auf sensible Vierbeiner.",
        "en": "Yes, guardians of fearful dogs report patient care and calm management for sensitive pets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Gibt es Parkmöglichkeiten vor der Praxis?",
        "en": "Is parking available outside the practice?"
      },
      "a": {
        "de": "Ja, Kunden erwähnen gute Parkmöglichkeiten direkt am Praxiseingang in Mahlsdorf.",
        "en": "Yes, clients mention convenient parking options located right by the clinic entrance."
      },
      "basis": "reviews"
    }
  ],
