  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 112,
      "title": {
        "de": "Engagierte Notfallmediziner neben geteilten Teameindrücken",
        "en": "Dedicated emergency staff alongside mixed impressions"
      },
      "text": {
        "de": "Viele Halter bedanken sich herzlich für den nächtlichen Einsatz und die fachliche Fürsorge der behandelnden Ärzte in kritischen Momenten. Demgegenüber äußern etliche Rezensenten scharfe Kritik an unpersönlichem oder ungeduldigem Verhalten im Notdienst. Schichtwechsel führen mitunter zu Unruhe in den Abläufen.",
        "en": "Many pet owners express gratitude for overnight dedication and medical care provided by veterinarians during critical emergencies. In contrast, several reviewers voice sharp criticism regarding impersonal or impatient communication during emergency shifts. Staff rotations occasionally create friction in patient coordination."
      }
    },
    {
      "topic": "results",
      "sentiment": "negative",
      "mentions": 28,
      "title": {
        "de": "Lebensrettende Eingriffe und schwere Krankheitsverläufe",
        "en": "Urgent interventions alongside disputed outcomes"
      },
      "text": {
        "de": "Während dankbare Besitzer von geglückten Operationen und erfolgreicher Stabilisierung schwer verletzter Tiere berichten, schildern andere Rezensenten dramatische Verschlechterungen oder unerwartete Verluste. Manche Halter zweifeln an Diagnosen oder empfinden den Behandlungsverlauf als unzureichend abgestimmt.",
        "en": "While grateful guardians report successful surgeries and stabilization of critically injured animals, other reviewers recount tragic complications or unexpected losses. Some owners question diagnostic accuracy or perceive the clinical course of treatment as insufficiently coordinated during inpatient care."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 28,
      "title": {
        "de": "Umfassend ausgestattetes 24-Stunden-Zentrum",
        "en": "Well-equipped around-the-clock medical center"
      },
      "text": {
        "de": "Tierbesitzer heben die lückenlose Erreichbarkeit der Reinickendorfer Praxis an jedem Wochentag positiv hervor. Die vorhandene Medizintechnik für Bildgebung, Labor und stationäre Unterbringung vermittelt vielen Haltern Sicherheit. Auch eigene Parkplätze im Hof erleichtern das Ankommen in Notfällen.",
        "en": "Pet owners appreciate the continuous accessibility of the Reinickendorf facility every day of the week. Available equipment for diagnostic imaging, in-house laboratory testing, and inpatient wards provides a reassuring setting. On-site courtyard parking further eases urgent arrivals during emergency visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Ist die Tierarztpraxis Rödiger rund um die Uhr geöffnet?",
        "en": "Is Tierarztpraxis Rödiger open around the clock?"
      },
      "a": {
        "de": "Ja, die Praxis betreibt an 365 Tagen im Jahr einen durchgehenden 24-Stunden-Notdienst.",
        "en": "Yes, the facility operates a continuous 24-hour emergency service 365 days a year."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Welche Parkmöglichkeiten gibt es an der Praxis?",
        "en": "What parking facilities are available at the clinic?"
      },
      "a": {
        "de": "Auf dem Gelände stehen eigene Parkplätze für Kunden zur Verfügung, die das Erreichen erleichtern.",
        "en": "Dedicated customer parking spaces are available on the courtyard premises, easing arrival."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Können Vögel und Reptilien dort behandelt werden?",
        "en": "Can birds and reptiles be treated there?"
      },
      "a": {
        "de": "Ja, das tiermedizinische Zentrum verfügt über Spezialwissen und Stationen für Exoten und Vögel.",
        "en": "Yes, the medical center provides specialized care and inpatient accommodations for exotics and birds."
      },
      "basis": "website"
    }
  ],
