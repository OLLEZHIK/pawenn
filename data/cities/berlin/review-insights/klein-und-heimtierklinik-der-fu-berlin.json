  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "de": "Engagierte Universitätsärzte und sorgfältige Ausbildung",
        "en": "Dedicated university doctors and thorough training"
      },
      "text": {
        "de": "Viele Halter loben die ausführliche Betreuung, die wissenschaftliche Gründlichkeit und das feinfühlige Auftreten der Stationsärzte und Studierenden. Bei komplexen Krankheitsbildern wird viel Zeit investiert. Einzelne Kunden bemängeln jedoch hektische Abläufe oder wechselnde Ansprechpartner.",
        "en": "Many pet owners praise detailed consultations, academic thoroughness, and sensitive bedside manners of resident veterinarians and veterinary students. Ample time is devoted to complex cases. Some clients note, however, occasional rushed workflows or rotating case handlers."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 8,
      "title": {
        "de": "Fundierte Diagnostik bei komplexen Krankheitsbildern",
        "en": "Sound diagnostics in complex medical cases"
      },
      "text": {
        "de": "Rezensenten heben die präzisen Untersuchungsergebnisse, erfolgreiche Operationen und die Klärung schwerer Vorerkrankungen hervor. Tiere mit seltenen Leiden profitieren von den Spezialisten. Dennoch schildern manche Halter Enttäuschung bei schwierigen Prognosen oder Therapieverläufen.",
        "en": "Reviewers highlight precise diagnostic findings, successful surgeries, and the clarification of previously undiagnosed ailments. Animals with rare conditions benefit from clinical specialists. Still, some owners express sorrow regarding poor prognoses or complex outcomes."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 6,
      "title": {
        "de": "Strukturiertes Aufnahmeverfahren mit gelegentlichen Verzögerungen",
        "en": "Structured intake procedures with occasional delays"
      },
      "text": {
        "de": "Die geregelten Abläufe der universitären Notaufnahme finden bei vielen Klienten Anerkennung. Aufgrund von Lehrbetrieb und Notfalltriage müssen Tierhalter jedoch mitunter längere Wartezeiten im Vorraum einplanen, was bei akutem Behandlungsbedarf als belastend empfunden werden kann.",
        "en": "Structured routines at the university emergency intake are appreciated by many clients. Due to teaching clinical duties and emergency triage, owners must occasionally anticipate longer waiting room stays, which can feel challenging during urgent situations."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Wie funktioniert die Notfallaufnahme an der FU Berlin?",
        "en": "How does emergency intake work at FU Berlin?"
      },
      "a": {
        "de": "Notfälle werden tagsüber ohne Voranmeldung und außerhalb der regulären Zeiten nach telefonischer Vorankündigung angenommen.",
        "en": "Daytime emergencies are admitted without prior notice, while off-hours visits require prior telephone registration."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Können neben Hunden und Katzen auch Vögel oder Reptilien vorgestellt werden?",
        "en": "Can birds or reptiles be presented alongside dogs and cats?"
      },
      "a": {
        "de": "Ja, die Universitätsklinik verfügt über Spezialisten für Kleinsäuger, Heimtiere, Vögel und Reptilien.",
        "en": "Yes, the university hospital has dedicated clinical specialists for small mammals, birds, and reptiles."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Welche Zahlungsmethoden werden vor Ort akzeptiert?",
        "en": "Which payment methods are accepted on site?"
      },
      "a": {
        "de": "In der Klinik ist ausschließlich bargeldlose Zahlung per Girocard oder Kreditkarte möglich.",
        "en": "The clinic accepts exclusively cashless payment methods via debit or credit card."
      },
      "basis": "website"
