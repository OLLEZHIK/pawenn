  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "de": "Fachkundiges Personal in Fachabteilungen",
        "en": "Knowledgeable staff in specialty departments"
      },
      "text": {
        "de": "Kunden heben die fundierte und geduldige Beratung im Erlebnismarkt in Wien-Donaustadt hervor. Besonders in der Aquaristikabteilung sowie bei Katzen- und Hundebedarf schätzen Tierhalter das Engagement und praktische Tipps einzelner Mitarbeiter. Vereinzelt wird an frequenzstarken Tagen von Wartezeiten an den Becken berichtet.",
        "en": "Shoppers emphasize the sound and patient advice offered at the Donaustadt pet store. Particularly in aquatics as well as cat and dog care, pet guardians appreciate the dedication and practical tips provided by team members. Occasional waits at the display tanks are noted on busy days."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "de": "Umfangreiches Sortiment und barrierefreier Markt",
        "en": "Extensive product range and accessible store"
      },
      "text": {
        "de": "Besucher loben die enorme Auswahl an Futter, Zubehör und Naturkauartikeln für Hunde, Katzen und Kleintiere. Der Markt überzeugt durch breite Gänge, barrierefreie Zugänge mit Lift und Rolltreppe sowie ausreichend Parkmöglichkeiten direkt vor dem Gebäude. Das große Aquaristik-Sortiment gilt als beliebter Anlaufpunkt.",
        "en": "Visitors praise the vast assortment of pet food, accessories, and natural chews for dogs, cats, and small animals. The location impresses with spacious aisles, step-free access via elevator and escalator, and ample on-site parking. The extensive aquatics department serves as a main highlight."
      }
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "mentions": 9,
      "title": {
        "de": "Gehobenes Preisniveau für Spezialartikel",
        "en": "Premium pricing for specialized items"
      },
      "text": {
        "de": "Käufer beurteilen das Preisniveau als gehoben im Vergleich zum allgemeinen Zoohandel. Während Sonderangebote und Treueaktionen als fair wahrgenommen werden, stufen Kunden spezialisierte Markenartikel und Aquaristikzubehör als spürbar teurer ein. Für hochwertige Qualität wird der Aufpreis meist akzeptiert.",
        "en": "Shoppers assess price levels as somewhat elevated compared to standard discount pet retailers. While promotions and loyalty deals are seen as fair, customers rate specialized brand supplies and aquarium equipment as noticeably pricey. The higher price is mostly accepted for specialized quality."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Gibt es vor Ort eine eigene BARF-Abteilung?",
        "en": "Is there a dedicated raw food (BARF) section in store?"
      },
      "a": {
        "de": "Ja, Kunden bestätigen ein großes Sortiment an Frostfleisch, BARF-Zusätzen und natürlichen Kauartikeln.",
        "en": "Yes, customers confirm a large selection of frozen raw meat, BARF supplements, and natural chews."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Gibt es kostenlose Kundenparkplätze vor dem Geschäft?",
        "en": "Is free customer parking available in front of the store?"
      },
      "a": {
        "de": "Ja, der Erlebnismarkt im Gewerbepark Stadlau bietet zahlreiche Parkplätze direkt vor dem Eingang.",
        "en": "Yes, the retail location in Gewerbepark Stadlau provides abundant parking directly outside the entrance."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Ist der Markt mit Kinderwagen oder Rollstuhl zugänglich?",
        "en": "Is the store accessible for strollers and wheelchairs?"
      },
      "a": {
        "de": "Ja, Kundinnen berichten von breiten Gängen sowie einem Lift und Rolltreppen in das Obergeschoss.",
        "en": "Yes, shoppers report wide shopping aisles as well as an elevator and escalators to the upper floor."
      },
      "basis": "reviews"
    }
