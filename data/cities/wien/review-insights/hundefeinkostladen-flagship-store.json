  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 66,
      "title": {
        "de": "Kompetente Ernährungsberatung mit Herzblut",
        "en": "Knowledgeable nutrition guidance with passion"
      },
      "text": {
        "de": "Hundehalter schätzen die persönliche und fundierte Beratung zur artgerechten Hundeernährung in der Galleria Landstraße. Das Team nimmt sich Zeit für individuelle Futterpläne, BARF-Umstellungen und Allergien. Die Mitarbeiter begegnen Zwei- und Vierbeinern durchwegs freundlich und zuvorkommend.",
        "en": "Dog owners appreciate the personal and well-founded advice on canine nutrition in Galleria Landstraße. The team takes ample time for tailored feeding plans, raw transitions, and allergy considerations. Staff members treat pets and owners with consistent warmth and courtesy."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 55,
      "title": {
        "de": "Spezialisiertes BARF-Sortiment und Kauartikel",
        "en": "Specialized raw food selection and natural chews"
      },
      "text": {
        "de": "Kunden heben die große Auswahl an tiefgefrorenem Fleisch, naturbelassenen Kauartikeln und hochwertigen Futterzusätzen hervor. Das Fachgeschäft überzeugt durch übersichtliche Präsentation, Sauberkeit und eine einladende Einkaufsatmosphäre im Einkaufszentrum auf der Landstraßer Hauptstraße.",
        "en": "Customers highlight the extensive choice of frozen raw meat, untreated natural chews, and premium nutritional supplements. The store impresses with clear product displays, cleanliness, and an inviting shopping atmosphere located inside the shopping mall on Landstraßer Hauptstraße."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "de": "Hohe Akzeptanz und Verträglichkeit bei Hunden",
        "en": "High palatability and digestive tolerance in dogs"
      },
      "text": {
        "de": "Zahlreiche Bewertungen betonen, dass auch wählerische oder magenempfindliche Hunde das Futter und die Snacks mit Begeisterung fressen. Halter berichten von glänzendem Fell, stabiler Verdauung und gesteigerter Vitalität. Vierbeiner werden beim Betreten des Ladens oft mit einem Leckerli begrüßt.",
        "en": "Numerous reviews emphasize that even picky eaters or dogs with delicate digestion devour the meals and treats eagerly. Guardians report shiny coats, stable digestion, and increased vitality. Dogs are warmly welcomed with a complementary treat when entering the store."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Gibt es Beratung zur Futterumstellung auf Rohfütterung (BARF)?",
        "en": "Is advice available for transitioning dogs to raw feeding (BARF)?"
      },
      "a": {
        "de": "Ja, Kundinnen berichten von ausführlicher und fachkundiger Unterstützung bei der BARF-Umstellung.",
        "en": "Yes, clients report comprehensive and knowledgeable assistance when transitioning pets to BARF."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Dürfen Hunde mit in das Geschäft genommen werden?",
        "en": "Are dogs allowed inside the store?"
      },
      "a": {
        "de": "Ja, Hunde sind herzlich willkommen und werden vom Personal gerne mit Kostproben begrüßt.",
        "en": "Yes, dogs are warmly welcomed and frequently greeted by the staff with complimentary samples."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "de": "Bietet der Laden auch einen Lieferservice für Frostfutter an?",
        "en": "Does the shop offer a delivery service for frozen raw food?"
      },
      "a": {
        "de": "Ja, Bestellungen können vor Ort getätigt oder mit Hauszustellung nach Hause geliefert werden.",
        "en": "Yes, orders can be purchased in store or arranged for convenient home delivery."
      },
      "basis": "both"
    }
  ],
