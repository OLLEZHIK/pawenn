  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 123,
      "title": {
        "de": "Einfühlsames und spezialisiertes Ärzteteam",
        "en": "Compassionate and specialized veterinary team"
      },
      "text": {
        "de": "Tierhalter loben die hohe medizinische Fachkompetenz und das herzliche Engagement der Tierärztinnen, Tierärzte und Pflegekräfte in Wien-Liesing. In akuten Notfällen und bei stationären Aufenthalten schätzen Besitzer die verständlichen Erklärungen und die liebevolle Zuwendung zum Tier rund um die Uhr.",
        "en": "Pet owners commend the advanced clinical competence and caring dedication of the vets and nursing staff in Vienna-Liesing. In acute emergencies and inpatient hospitalization, guardians value the clear explanations and gentle care provided to companion animals around the clock."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "de": "Wartezeiten nach medizinischer Dringlichkeit",
        "en": "Wait times prioritized by medical urgency"
      },
      "text": {
        "de": "Während geplante Termine meist pünktlich eingehalten werden, berichten Besucher im Notdienst von spürbaren Wartezeiten. Rezensenten zeigen Verständnis dafür, dass lebensbedrohliche Notfälle stets vorrangig behandelt werden. Klare Informationen bei hohem Patientenaufkommen werden geschätzt.",
        "en": "While scheduled consultations generally run promptly on time, emergency visitors report noticeable waiting periods. Reviewers acknowledge that life-threatening emergencies are consistently prioritized in triage. Clear communication during peak clinic intake hours is appreciated."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 47,
      "title": {
        "de": "Erfolgreiche Operationen und Diagnostik",
        "en": "Successful surgeries and advanced diagnostics"
      },
      "text": {
        "de": "Zahlreiche Bewertungen berichten von erfolgreichen chirurgischen Eingriffen, präzisen CT-Untersuchungen und lebensrettenden Behandlungen schwer erkrankter Hunde und Katzen. Viele Patienten erholten sich nach intensiver stationärer Betreuung rasch. Vereinzelt führten schwere Verläufe zu Enttäuschung.",
        "en": "Numerous reviews report successful surgical procedures, precise CT scans, and life-saving treatments for critically ill dogs and cats. Many patients recovered quickly following intensive inpatient monitoring. In isolated complex emergencies, critical outcomes led to disappointment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Ist die Notfallambulanz im Vetklinikum rund um die Uhr geöffnet?",
        "en": "Is the emergency clinic at Vetklinikum open 24 hours a day?"
      },
      "a": {
        "de": "Ja, die Tierklinik bietet eine durchgehende 24-Stunden-Notfallversorgung an 365 Tagen im Jahr.",
        "en": "Yes, the veterinary clinic provides continuous 24-hour emergency care 365 days a year."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden Patienten nach Operationen stationär überwacht?",
        "en": "Are patients monitored as inpatients after surgery?"
      },
      "a": {
        "de": "Ja, Halter berichten von einer engmaschigen stationären Betreuung mit getrennten Stationen.",
        "en": "Yes, owners report closely monitored inpatient care with separate cat and dog wards."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Muss man vor einem Notfallbesuch telefonisch anrufen?",
        "en": "Should visitors call ahead before an emergency arrival?"
      },
      "a": {
        "de": "Eine telefonische Ankündigung wird empfohlen, damit sich das medizinische Notfallteam vorbereiten kann.",
        "en": "Calling ahead is recommended so that the emergency medical team can prepare for arrival."
      },
      "basis": "both"
    }
  ],
