  "period_to": "2026-10-06",
  "reviews_in_period": 73,
  "observed_at": "2026-10-06",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "de": "Fachliche Expertise und einfühlsames Notfallteam",
        "en": "Professional expertise and compassionate emergency team"
      },
      "text": {
        "de": "Zahlreiche Bewertungen heben die hohe fachliche Kompetenz und das empathische Handeln des Ärzte- und Pflegeteams hervor. Halter bedanken sich für den aufopferungsvollen Einsatz bei lebensbedrohlichen Notfällen rund um die Uhr. Vereinzelt wird jedoch bemängelt, dass es bei Schichtwechseln zu Informationsverlusten kommen kann.",
        "en": "Numerous reviews praise the high medical expertise and empathetic conduct of the veterinary and nursing staff. Pet owners express gratitude for dedicated care during life-threatening emergencies around the clock. Occasional comments note, however, that communication can vary during busy shift turnovers."
      }
    },
    {
      "topic": "results",
      "sentiment": "mixed",
      "mentions": 18,
      "title": {
        "de": "Lebensrettende Intensivmedizin mit gemischten Erfahrungen",
        "en": "Life-saving intensive care with mixed experiences"
      },
      "text": {
        "de": "Viele Klienten berichten dankbar von erfolgreichen chirurgischen Eingriffen und lebensrettenden Behandlungen auf der Intensivstation. Die rasche Verfügbarkeit moderner bildgebender Verfahren rettet vielen Tieren das Leben. Demgegenüber stehen vereinzelte Berichte über unklare Diagnosestellungen und unerwartete Komplikationen bei Schwerkranken.",
        "en": "Many clients gratefully report successful surgical interventions and life-saving care in the intensive ward. Immediate access to advanced imaging saves many animals in critical condition. In contrast, isolated reviews recount disputed diagnoses and unexpected complications in severely ill patients."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "de": "Modern ausgestattete 24-Stunden-Tierklinik",
        "en": "Modern equipped 24-hour veterinary hospital"
      },
      "text": {
        "de": "Die Klinik beeindruckt Tierhalter mit modernster Medizintechnik, getrennten Stationen für Hunde und Katzen sowie computertomographischer Diagnostik. Besucher schätzen die saubere Umgebung und die professionelle Klinikinfrastruktur für stationäre Patienten. Die gute Erreichbarkeit im 3. Bezirk wird positiv bewertet.",
        "en": "The clinic impresses pet guardians with state-of-the-art medical technology, separate wards for dogs and cats, and on-site computed tomography. Visitors appreciate the clean environment and professional hospital infrastructure for inpatients. Accessibility in the 3rd district is viewed favorably."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Ist die Tierklinik Erdberg rund um die Uhr geöffnet?",
        "en": "Is AniCura Tierklinik Erdberg open around the clock?"
      },
      "a": {
        "de": "Ja, die Klinik betreibt einen durchgehenden 24-Stunden-Notdienst an 365 Tagen im Jahr.",
        "en": "Yes, the hospital operates a continuous 24-hour emergency service 365 days a year."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Welche spezialisierten Diagnosegeräte sind vor Ort vorhanden?",
        "en": "What specialized diagnostic equipment is on site?"
      },
      "a": {
        "de": "Vor Ort stehen Computertomographie (CT), Endoskopie, Ultraschall sowie ein vollausgestattetes Sofortlabor bereit.",
        "en": "The facility is equipped with computed tomography (CT), endoscopy, ultrasound, and a full emergency laboratory."
      },
      "basis": "website"
    },
    {
      "q": {
        "de": "Gibt es getrennte Stationen für Hunde und Katzen?",
        "en": "Are there separate inpatient wards for dogs and cats?"
      },
      "a": {
        "de": "Ja, stationäre Patienten werden in getrennten Bereichen untergebracht, um Stress für Katzen zu minimieren.",
        "en": "Yes, hospitalized patients are accommodated in separate areas to minimize stress for feline guests."
      },
      "basis": "website"
    }
  ],
