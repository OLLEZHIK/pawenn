  "google_maps_url": "https://www.google.com/maps/place/WUNDERSCHNITT+Hundesalon/@48.2287103,16.3573157,17z/data=!3m1!4b1!4m6!3m5!1s0x476d0770d24af80d:0x1dd6c376c2cdc23e!8m2!3d48.2287103!4d16.3573157!16s%2Fg%2F11y654ylys?authuser=0&hl=de&entry=ttu&g_ep=EgoyMDI2MDkzMC4wIKXMDSoASAFQAw%3D%3D",
  "period_from": "2026-04-06",
