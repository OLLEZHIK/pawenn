  "observed_at": "2026-10-06",
  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "de": "Liebevoller Umgang mit sensiblen Hunden",
        "en": "Gentle approach to sensitive canines"
      },
      "text": {
        "de": "Halter von sensiblen, ängstlichen oder älteren Hunden schätzen die ruhige und einfühlsame Zuwendung im Salon. Selbst wasserscheue Vierbeiner entspannen sich dank geduldiger Berührung und sanfter Führung während der Pflege. Viele Hunde betreten das Studio freudig und ohne Scheu.",
        "en": "Guardians of sensitive, nervous, or senior dogs commend the calm and empathetic dedication inside the salon. Even water-shy companions relax thanks to patient touch and soothing guidance throughout grooming. Many dogs enter the parlor happily and without hesitation."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "de": "Engagiertes und herzliches Betreiberteam",
        "en": "Dedicated and warm styling team"
      },
      "text": {
        "de": "Angelina und Sladjan werden in zahlreichen Rezensionen für ihre Hingabe, handwerkliche Perfektion und Freundlichkeit gefeiert. Das Team nimmt sich ausreichend Zeit für eine genaue Vorbesprechung individueller Fellwünsche. Kunden loben die familiäre Atmosphäre und Verlässlichkeit.",
        "en": "Angelina and Sladjan are widely praised across reviews for their dedication, technical finesse, and kindness. The duo takes ample time to discuss tailored styling preferences prior to treatment. Customers value the welcoming family atmosphere and reliable appointment keeping."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 32,
      "title": {
        "de": "Erstklassige Schnitte und gründliche Fellpflege",
        "en": "First-rate styling and thorough coat care"
      },
      "text": {
        "de": "Kunden sind ausnahmslos begeistert vom gepflegten Aussehen ihrer Vierbeiner nach dem Friseurbesuch. Rassespezifische Formschnitte, Entfilzung sowie sanfte Zahnreinigung und Ozonbäder werden handwerklich meisterhaft umgesetzt. Das Fell glänzt seidig und fühlt sich gesund an.",
        "en": "Clients are universally thrilled with the immaculate appearance of their pets following each appointment. Breed-standard trims, dematting, gentle ultrasound teeth cleaning, and ozone baths are carried out with master craft. Coats emerge silky, clean, and remarkably healthy."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Welche Spezialbehandlungen werden neben dem Schnitt angeboten?",
        "en": "What specialized treatments are offered beyond clipping?"
      },
      "a": {
        "de": "Der Salon bietet professionelle Ozon-Hydrotherapie, sanfte Ultraschall-Zahnreinigung und Entfilzung an.",
        "en": "The parlor provides professional ozone hydrotherapy, gentle ultrasonic dental cleaning, and dematting."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Können Termine online vereinbart werden?",
        "en": "Can appointments be booked online?"
      },
      "a": {
        "de": "Ja, Termine können unkompliziert über das Online-Buchungssystem oder telefonisch reserviert werden.",
        "en": "Yes, appointments can be easily scheduled via the online booking tool or by telephone."
      },
      "basis": "website"
    },
    {
      "q": {
        "de": "Werden Hunde aller Rassen und Größen gepflegt?",
        "en": "Are dogs of all breeds and sizes groomed?"
      },
      "a": {
        "de": "Ja, vom kleinen Welpen bis zum großen Golden Retriever sind alle Rassen und Mischlinge willkommen.",
        "en": "Yes, from toy companions to large Golden Retrievers, all dog breeds and mixed breeds are welcome."
      },
      "basis": "both"
    }
  ],
