  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "de": "Herzliches und hochkompetentes Ärzteteam",
        "en": "Warm and highly competent veterinary team"
      },
      "text": {
        "de": "Besitzer schätzen die persönliche Betreuung, Fachkompetenz und Geduld des gesamten Klinikpersonals in Liesing. Behandler nehmen sich Zeit für ausführliche Beratung und beantworten alle Rückfragen verständlich und einfühlsam. Vereinzelte Stimmen bemerken gelegentliche Unruhe an stark besuchten Behandlungstagen.",
        "en": "Owners appreciate the personalized care, medical competence, and patience shown by the clinic team in Liesing. Veterinarians take time for thorough consultations and explain all questions clearly and calmly. Isolated comments note occasional organizational busyness during peak hours."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "de": "Einfühlsame Behandlung sensibler Vierbeiner",
        "en": "Gentle treatment of sensitive companions"
      },
      "text": {
        "de": "Tierhalter loben den liebevollen Umgang mit ängstlichen Hunden und scheuen Katzen während der Untersuchung. Durch sanftes Zureden und behutsame Handgriffe gelingt es dem Team, den Stresspegel der tierischen Patienten spürbar zu senken. Viele Tiere fassen schnell Vertrauen zu den Behandlern.",
        "en": "Pet owners commend the affectionate approach toward anxious dogs and timid cats during clinical examinations. Through calm encouragement and gentle handling, the team successfully lowers stress levels for patients. Many pets establish trust quickly with their practitioners."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 14,
      "title": {
        "de": "Freundliche Praxisatmosphäre und gute Organisation",
        "en": "Friendly clinic atmosphere and solid organization"
      },
      "text": {
        "de": "Die Klinikräumlichkeiten in Mauer werden von Besuchern als hell, gepflegt und hervorragend ausgestattet wahrgenommen. Halter heben die angenehme Wartebereichsatmosphäre und saubere Behandlungszimmer positiv hervor. Die Lage im Grünen und Parkmöglichkeiten vor Ort erleichtern den Besuch mit Tier.",
        "en": "The practice rooms in Mauer are perceived by visitors as bright, well-maintained, and well-equipped. Pet parents highlight the pleasant waiting area ambiance and clean exam rooms. The leafy location and adjacent parking options make arriving with animals straightforward."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "de": "Werden Konsultationen auch auf Englisch angeboten?",
        "en": "Are consultations available in English?"
      },
      "a": {
        "de": "Ja, die Tierklinik Mauer bietet vollwertige Beratungen und Behandlungen auf Englisch an.",
        "en": "Yes, Tierklinik Mauer provides comprehensive consultations and medical services in English."
      },
      "basis": "website"
    },
    {
      "q": {
        "de": "Gibt es einen Notdienst außerhalb der regulären Zeiten?",
        "en": "Is there an on-call emergency service outside regular hours?"
      },
      "a": {
        "de": "Ja, für dringende Notfälle ist die Klinik über eine eigene Notrufnummer rund um die Uhr erreichbar.",
        "en": "Yes, the clinic remains reachable around the clock for urgent emergencies via a dedicated phone number."
      },
      "basis": "both"
    },
    {
      "q": {
        "de": "Werden auch Zahnbehandlungen und digitales Röntgen durchgeführt?",
        "en": "Are dental treatments and digital radiography performed?"
      },
      "a": {
        "de": "Ja, moderne Zahnheilkunde sowie digitales Röntgen und Ultraschall gehören zum Leistungsspektrum.",
        "en": "Yes, modern veterinary dentistry alongside digital X-rays and ultrasound are part of their services."
      },
      "basis": "website"
    }
