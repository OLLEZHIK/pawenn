  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 33,
      "title": {
        "en": "Compassionate doctors and welcoming team"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinary team, technicians, and front desk staff for exceptional warmth and dedication. Reviewers single out Dr. Aylesworth and Dr. Konishi for answering complex questions thoroughly and providing thoughtful guidance. Although one client reported a lack of communication during a severe illness, the vast majority experience deep empathy and professionalism."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Fear-free handling and pet comfort"
      },
      "text": {
        "en": "Clients emphasize how gently and tenderly their dogs and cats are treated during visits. Reviewers note that staff distribute treats generously, accommodate anxious rescue animals, and take extra time to keep pets calm. Owners of elderly cats and nervous dogs report leaving appointments confident that their companions felt safe and respected."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Efficient scheduling and quick visits"
      },
      "text": {
        "en": "The clinic receives positive recognition for its streamlined scheduling and prompt lobby management. Several pet parents highlight the ease of securing same-day or next-day appointments when unexpected health concerns arise. Reviewers appreciate that scheduled exams begin on time, allowing families to complete routine checkups without unnecessary delays."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can pet owners schedule same-day appointments for urgent concerns?"
      },
      "a": {
        "en": "Yes, multiple clients mention that the clinic successfully accommodated urgent appointments on the same day."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Village West Veterinary offer grooming services?"
      },
      "a": {
        "en": "Reviewers frequently praise the on-site groomer, Jimmy, for gentle care and styling of both dogs and cats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How transparent is the clinic regarding treatment costs?"
      },
      "a": {
        "en": "Pet owners appreciate that veterinarians provide clear estimates and discuss procedural options before administering treatment."
      },
      "basis": "reviews"
    }
  ],
