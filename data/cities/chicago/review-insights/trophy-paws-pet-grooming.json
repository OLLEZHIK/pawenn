  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Skilled and attentive styling staff"
      },
      "text": {
        "en": "Pet owners express overwhelming appreciation for the grooming team, frequently highlighting stylists like Jesse, Nicole, and Yessenia. Reviewers commend their patient listening, gentle demeanor, and willingness to accommodate breed-specific preferences. While one client reported an uncomfortable front-desk interaction, the overwhelming majority describe friendly, dedicated professionals."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Consistently polished coat and trim"
      },
      "text": {
        "en": "Clients consistently celebrate the aesthetic and functional quality of the grooming services. Reviews mention beautifully trimmed coats, soft fur, smooth nail filing, and pleasant post-bath scents that last for days. Pet parents of heavy-shedding breeds and double-coated dogs specifically praise thorough de-shedding treatments and even coat management."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Calm handling for anxious pets"
      },
      "text": {
        "en": "Reviewers emphasize how comfortable and relaxed their pets feel throughout their appointments. Several owners note that shy, elderly, or bath-averse dogs were handled with extraordinary tenderness and given needed rest breaks. Clients appreciate that pets return home calm and happy, demonstrating trust in the salon's compassionate environment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do clients receive photos of their pets after grooming?"
      },
      "a": {
        "en": "Yes, many reviewers highlight themed seasonal photo shoots taken after styling as a beloved signature extra."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can the salon groom sensitive or nervous pets?"
      },
      "a": {
        "en": "Pet owners report that groomers take time with anxious, rescue, or senior animals, providing gentle handling and breaks."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Trophy Paws groom cats as well as dogs?"
      },
      "a": {
        "en": "Yes, clients note that stylists provide nail trims and grooming appointments for longhair cats in addition to dogs."
      },
      "basis": "reviews"
    }
  ],
