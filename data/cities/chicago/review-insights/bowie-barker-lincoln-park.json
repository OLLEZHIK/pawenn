  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Clean coats and handsome styling results"
      },
      "text": {
        "en": "Pet owners generally celebrate the quality of grooming and self-wash visits, noting that dogs return home fluffy, clean-smelling, and outfitted with seasonal bandanas. Even heavily matted coats were effectively restored by salon bathers. While two owners reported that their dogs received unintended close shaves, the vast majority praise the finished haircuts."
      }
    },
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 11,
      "title": {
        "en": "Welcoming groomers alongside desk inconsistencies"
      },
      "text": {
        "en": "Grooming staff like Alex, Nelly, and Delaney receive strong praise for their patience and cheerful attitude during baths. Owners enjoy receiving mid-session bath photos of their pets. However, a small group of dissatisfied clients cited communication issues at the front desk, unexpected operating hours, and unresolved concerns regarding nail trims."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "en": "Gentle approach for anxious dogs"
      },
      "text": {
        "en": "Numerous reviewers appreciate how staff handle young puppies and nervous rescue dogs. Clients share that bathers took time to ease dog anxiety and build confidence in the tubs. A couple of owners noted difficulty with nail clipping for fearful pets, but overall clients feel dogs are treated with kindness and care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Bowie Barker offer self-serve dog wash stations?"
      },
      "a": {
        "en": "Yes, the facility provides self-wash tubs equipped with specialized shampoo, conditioner, towels, and blow dryers."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do clients receive updates while pets are being groomed?"
      },
      "a": {
        "en": "Several reviewers mention that staff send cute text photos of dogs during their bath and grooming sessions."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are membership plans available for frequent visitors?"
      },
      "a": {
        "en": "Yes, customers note taking advantage of monthly bath and grooming memberships for regular care."
      },
      "basis": "both"
    }
  ],
