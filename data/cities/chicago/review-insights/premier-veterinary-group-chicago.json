  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 66,
      "title": {
        "en": "Compassionate emergency veterinary specialists"
      },
      "text": {
        "en": "Pet parents overwhelmingly praise the critical care doctors and intensive care nurses for their dedication and empathy during frightening pet emergencies. While most describe comforting support during crises, a minority of reviewers report cold interactions during triage."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 40,
      "title": {
        "en": "Frequent medical updates with occasional lapses"
      },
      "text": {
        "en": "Many families appreciate detailed clinical phone updates and clear prognoses from emergency doctors while their pets are hospitalized. Conversely, several clients felt left in the dark during critical triage or expressed frustration with incomplete discharge guidance."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 40,
      "title": {
        "en": "Rapid critical triage alongside lobby delays"
      },
      "text": {
        "en": "Severe trauma and acute life-threatening emergencies receive immediate medical intervention upon arrival. However, pet parents whose animals were stable reported waiting multiple hours in the lobby or exam rooms while doctors prioritized more critical patients."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is Premier Veterinary Group in Chicago open for 24/7 emergencies?"
      },
      "a": {
        "en": "Yes, clients frequently utilize this facility for round-the-clock urgent intake, overnight critical care, and trauma management."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the hospital handle emergency wait times?"
      },
      "a": {
        "en": "Triage is based on medical severity; life-threatening cases are seen immediately, while stable pets may experience multi-hour waits during peak emergency hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What do clients report about emergency treatment costs?"
      },
      "a": {
        "en": "Reviewers note that intensive emergency interventions, advanced imaging, and overnight hospitalization carry substantial specialty costs."
      },
      "basis": "reviews"
    }
  ],
