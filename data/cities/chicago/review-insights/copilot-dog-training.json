    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Patient and attentive training instructors"
      },
      "text": {
        "en": "Pet owners consistently praise the training team for their patience, practical guidance, and personalized attention. Clients frequently highlight instructors like Margaret, Ronnie, Cailin, and Hailey for breaking down training concepts clearly. While one handler felt the team was less equipped for large breeds, the vast majority describe the trainers as exceptionally helpful."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Noticeable progress in leash reactivity"
      },
      "text": {
        "en": "Reviewers report substantial behavioral improvements across both group classes and private in-home lessons. Many clients highlight rapid progress with leash reactivity, impulse control, and loose leash walking in neighborhood environments. Although one reviewer noted delayed communication regarding class results, most describe lasting positive changes in their dogs."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Gentle approach for anxious rescues"
      },
      "text": {
        "en": "Clients frequently emphasize how well the instructors work with sensitive rescue dogs and high-energy puppies. Handlers appreciate the gentle, reward-based methods that build confidence without causing unnecessary stress. With the exception of one client who felt larger dogs received less focus, owners report that their dogs feel safe and comfortable during classes."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What training formats does Copilot Dog Training offer?"
      },
      "a": {
        "en": "Reviewers note that the facility provides puppy foundation courses, small group classes, drop-off day training, and private in-home coaching."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do trainers help with leash reactivity and anxiety?"
      },
      "a": {
        "en": "Yes, many clients specifically highlight positive results when addressing leash pulling, dog reactivity, and rescue dog adjustment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners request private training sessions?"
      },
      "a": {
        "en": "Yes, pet parents frequently mention booking private lessons tailored to their household routine and individual dog temperaments."
      },
      "basis": "both"
    }
