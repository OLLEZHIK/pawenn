  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Compassionate care from exotic pet specialists"
      },
      "text": {
        "en": "Reviewers express exceptional appreciation for the veterinarians and support technicians, singling out Dr. Cynthia, Dr. Jenny, and Dr. Kim for their specialized expertise. Pet parents frequently note that clinicians listen with patience, answer detailed questions without rushing, and provide compassionate support during end-of-life care. Front desk staff members are widely described as warm and welcoming."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Dedicated care for exotic pets"
      },
      "text": {
        "en": "Clients strongly value the practice as a premier destination in Chicago for birds, reptiles, ferrets, rabbits, and other exotic animals alongside cats and dogs. Reviewers praise gentle pet handling during routine exams and complex medical procedures, including intricate bilateral eye surgeries and beak trims. Pets are treated with patience and affection, fostering comfort for both animals and owners."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 6,
      "title": {
        "en": "High fees and prescription limits"
      },
      "text": {
        "en": "While some reviewers consider veterinary fees worthwhile given the scarce specialty care for exotics, multiple pet parents express frustration with noncompetitive pricing. Clients report routine examination and vaccine packages costing significantly more than nearby practices, alongside expensive surgical estimates. Frustration is also voiced over corporate policies restricting direct script transfers to online pet pharmacies."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the hospital treat exotic animals and reptiles?"
      },
      "a": {
        "en": "Yes, the practice is renowned for treating birds, tortoises, ferrets, rabbits, guinea pigs, and other exotic pets alongside cats and dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can prescriptions be routed directly to third-party online pet pharmacies?"
      },
      "a": {
        "en": "Clients report that the clinic does not send prescriptions directly to external platforms such as Chewy, requiring in-house fulfillment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic perform complex exotic surgeries?"
      },
      "a": {
        "en": "Yes, pet owners report successful specialized surgical procedures, including delicate ophthalmologic and dental operations on exotic pets."
      },
      "basis": "reviews"
    }
  ],
