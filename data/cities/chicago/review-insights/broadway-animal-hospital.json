  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Empathetic doctors and dedicated support team"
      },
      "text": {
        "en": "Clients consistently praise the veterinarians and technicians for their clinical expertise, empathetic communication, and attentive bedside manner. Multiple pet parents specifically highlight Dr. Perry, Dr. Dupre, and Dr. Kim for walking them through difficult diagnoses and consultations with genuine compassion. While a few clients noted occasional front desk friction, the clinical staff is widely regarded as caring and trustworthy."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Gentle pet handling and patient care"
      },
      "text": {
        "en": "Pet owners emphasize that clinic staff handle animals with immense patience, care, and warmth throughout physical exams and procedures. Clinicians and assistants take extra time to comfort nervous dogs and fractious cats with treats, calm handling techniques, and gentle pacing. Multiple clients note that even pets with severe veterinary anxiety remain calm and relaxed during their appointments."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 11,
      "title": {
        "en": "Detailed medical guidance alongside prescription hurdles"
      },
      "text": {
        "en": "Most reviewers commend the veterinary team for clear consultations, thorough exam explanations, and thoughtful follow-up discussions regarding complex treatments. Doctors take time to answer all questions carefully. However, several pet owners report frustration over administrative communication regarding prescription renewals and restrictions on transferring orders to outside pharmacies."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the clinic accommodate anxious pets?"
      },
      "a": {
        "en": "Reviewers report that technicians and veterinarians use treats, gentle pacing, and calm handling to keep nervous cats and dogs comfortable."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can prescriptions be filled through outside pharmacies?"
      },
      "a": {
        "en": "Multiple clients report administrative difficulty transferring digital prescriptions to outside pharmacies, leading to higher medication costs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are installment payment options available?"
      },
      "a": {
        "en": "Yes, pet owners note that the clinic recently introduced a payment plan option to assist with unexpected medical expenses."
      },
      "basis": "reviews"
    }
  ],
