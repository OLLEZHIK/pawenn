  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Longtime practitioners and devoted care team"
      },
      "text": {
        "en": "Lincoln Park pet owners express strong loyalty to longtime clinicians, highlighting Dr. Gutierrez, Dr. Gonzalez, Dr. Driscoll, and Dr. Cheung. Clients note attentive support from clinical technicians and receptionists, with many families visiting the practice across decades."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Thorough discussions and post-visit check-ins"
      },
      "text": {
        "en": "Reviewers emphasize that veterinarians explain diagnostic findings in accessible terms and answer detailed questions during exams. Clients frequently commend clinicians and support staff for calling over weekends to check on recovering pets, though occasional phone hold times were noted."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "en": "Gentle handling for household pets"
      },
      "text": {
        "en": "Pet owners commend the clinic for accommodating anxious dogs and fractious cats with patience and gentle handling during routine exams and vaccinations. While one reviewer shared grief over a medical complication, the broad consensus reflects trust in the team's thoughtful care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do clinicians follow up after sick pet visits?"
      },
      "a": {
        "en": "Yes, clients frequently mention that veterinarians and veterinary technicians call or email to check on pets following treatments, even on weekends."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are appointments available for urgent situations?"
      },
      "a": {
        "en": "Yes, pet owners report that staff accommodate urgent situations and same-day visits for ailing pets when immediate evaluation is needed."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Family Pet Animal Hospital provide routine vaccinations and diagnostics?"
      },
      "a": {
        "en": "Yes, the hospital offers comprehensive wellness examinations, puppy and kitten vaccine protocols, digital radiography, and in-house laboratory testing."
      },
      "basis": "both"
    }
  ],
