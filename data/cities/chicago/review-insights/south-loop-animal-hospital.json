    },
    {
      "q": {
        "en": "Can owners schedule appointments for multiple pets together?"
      },
      "a": {
        "en": "Yes, clients frequently mention coordinating joint visits for their dogs and cats with the veterinary team."
      },
      "basis": "reviews"
    }
