  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 31,
      "title": {
        "en": "Attentive veterinarians alongside mixed interactions"
      },
      "text": {
        "en": "Most clients speak warmly of Dr. Fitzsimmons, Dr. Klein, and the veterinary nurses, praising their gentle bedside manner and clear explanations. Many owners note that clinicians follow up personally after visits. However, several reviewers voiced frustration with junior technicians offering diagnostic advice, reliance on artificial intelligence tools, or perceived coldness at checkout."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Reassuring accommodations for anxious pets"
      },
      "text": {
        "en": "Pet parents frequently applaud how team members interact with nervous dogs and fragile cats. Multiple reviewers mention that staff took extra time to triage pets calmly, provided treats, and accommodated fearful rescues so visits remained low-stress. Patients recovering from dental surgery and critical ailments were treated with genuine care and dedication."
      }
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "mentions": 13,
      "title": {
        "en": "Clear pricing with fee surprises"
      },
      "text": {
        "en": "Many reviewers appreciate the initial exam promotion, itemized estimates, and transparent cost breakdowns before treatment. In contrast, several clients reported unexpected charges, highlighting an unadvertised walk-in fee of 145 dollars, steep late cancellation penalties, and high itemized bills for basic lab tests and booster shots."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Bond Vet in Wicker Park accept walk-in patients?"
      },
      "a": {
        "en": "Yes, walk-ins are seen for urgent needs, though pet owners should be aware that walk-in exams carry a specific fee structure."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are promotional exam discounts available for new clients?"
      },
      "a": {
        "en": "Reviewers frequently note that their first wellness examination was free as part of a new client promotion."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the clinic handle pets with vet anxiety?"
      },
      "a": {
        "en": "Clients highlight that staff proactively accommodate anxious pets with quiet exam rooms, gentle pacing, and low-stress handling."
      },
      "basis": "reviews"
    }
  ],
