  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 56,
      "title": {
        "en": "Compassionate emergency clinicians with critiques"
      },
      "text": {
        "en": "The majority of pet owners praise the emergency veterinarians and support staff for their warmth, gentle handling, and emotional support during pet crises. However, a notable minority of reviewers reported encountering detached or dismissive communication during triage."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 28,
      "title": {
        "en": "Open-floor comfort alongside handling disputes"
      },
      "text": {
        "en": "Many families value being able to remain beside their dogs and cats on the open treatment floor to comfort them during medical evaluations. In contrast, several dissatisfied reviewers felt their pets did not receive adequate attention or felt left to hold unstable animals."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 24,
      "title": {
        "en": "Rapid intake alongside critical delays"
      },
      "text": {
        "en": "Pet parents report that acute trauma and critical respiratory distress receive immediate intervention from emergency nurses upon arrival. Nevertheless, non-critical patients during peak overnight hours experienced extended waiting periods before seeing a doctor."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is VEG South Loop open for overnight emergencies?"
      },
      "a": {
        "en": "Yes, reviewers confirm the hospital operates 24/7 with continuous emergency intake and overnight intensive medical monitoring."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can pet owners stay in the treatment area?"
      },
      "a": {
        "en": "Yes, the open-hospital layout allows families to stay right next to their dogs or cats during triage, examinations, and routine procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are emergency treatment estimates provided in advance?"
      },
      "a": {
        "en": "Reviewers state that staff discuss transparent pricing and obtain owner consent on treatment estimates prior to administering specialty care."
      },
      "basis": "reviews"
    }
  ],
