  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "en": "Compassionate, attentive urgent care clinicians"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinary team, technicians, and front desk staff for their warmth, calm demeanor, and empathy during stressful emergencies. Reviewers highlight practitioners like Dr. Gomez Postigo and Dr. Klemas for thorough examinations and unhurried medical guidance. Aside from isolated management disputes, clients feel deeply supported during critical visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Gentle handling of frightened animals"
      },
      "text": {
        "en": "Clients frequently remark on how gently the staff handles frightened, injured, or anxious animals. Pet parents note that veterinarians and assistants match each animal's comfort level, using calming techniques during urgent procedures and diagnostics. Reviewers describe pets remaining relaxed despite pain or distress, praising the clinic's patient, fear-free care approach."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Clear medical guidance and follow-up"
      },
      "text": {
        "en": "Reviewers emphasize the clinic's proactive communication, noting that doctors thoroughly explain potential diagnoses, diagnostic costs, and aftercare steps without pressure. Pet owners appreciate receiving prompt follow-up calls and detailed voicemails checking on recovering cats and dogs. Most clients report feeling fully informed and respected throughout each stage of treatment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can I schedule a same-day appointment online at Scout?"
      },
      "a": {
        "en": "Yes, clients frequently mention booking last-minute or same-day appointments online with minimal waiting upon arrival."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the urgent care team follow up after discharge?"
      },
      "a": {
        "en": "Reviewers consistently report that staff call or leave voicemails to check on their pet's recovery following treatment."
      },
      "basis": "reviews"
    },
