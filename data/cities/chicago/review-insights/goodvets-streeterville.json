  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "en": "Compassionate, knowledgeable veterinary team"
      },
      "text": {
        "en": "Most clients speak highly of the clinic's veterinary doctors and support staff, praising Dr. Flannagan, Dr. Creger, Dr. Rosen, Laura, and Candy for their warmth, expertise, and thorough explanations during exams. Pet parents value their attentive bedside manner during illnesses and emergencies. However, a small subset of reviewers reported negative experiences with staff turnover or perceived lack of empathy."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 29,
      "title": {
        "en": "Attentive care for diverse pets"
      },
      "text": {
        "en": "Reviewers highlight compassionate handling of dogs, puppies, and cats, noting that clinicians create a comforting environment for anxious animals and accommodate breeds like French bulldogs and Bengal cats. While two clients reported distressing incidents involving boarding care and muzzling, the vast majority of owners feel confident leaving their pets in the team's care."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 10,
      "title": {
        "en": "Efficient scheduling and prompt visits"
      },
      "text": {
        "en": "Pet owners frequently praise the clinic's streamlined appointment booking and prompt service during urgent situations. Several traveling clients and local residents appreciate securing same-day appointments on short notice, noting minimal waiting room delays and swift exam room check-ins. Reviewers emphasize that the responsive schedule provides vital peace of mind."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Can I book a same-day appointment at GoodVets Streeterville?"
      },
      "a": {
        "en": "Yes, clients frequently report successfully booking same-day and urgent appointments on short notice."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are veterinarians experienced with cats and specific dog breeds?"
      },
      "a": {
        "en": "Yes, reviewers highlight attentive care for Bengal cats, French bulldogs, doodles, and senior animals."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are Saturday emergency appointments available?"
      },
      "a": {
        "en": "Yes, clients appreciate that the clinic offers weekend appointments with on-site medications for sudden infections."
      },
      "basis": "reviews"
    }
  ],
