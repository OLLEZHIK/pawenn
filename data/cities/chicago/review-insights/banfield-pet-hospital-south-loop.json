  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Friendly and attentive veterinary team"
      },
      "text": {
        "en": "The majority of pet owners highlight courteous, warm, and accommodating interactions with veterinarians, veterinary assistants, and front desk receptionists. Families describe deeply empathetic support during challenging end-of-life visits and praise clinicians who listen attentively to ongoing health concerns. However, isolated reviews report rushed consultations and condescending communication styles."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 6,
      "title": {
        "en": "Affectionate and gentle pet care"
      },
      "text": {
        "en": "Clients appreciate that staff members treat dogs and cats with affection and patience during routine health visits and wellness exams. Reviewers observe that assistants build genuine relationships with individual animals, easing stress during clinic appointments. Conversely, one pet parent raised serious concerns regarding rough leash handling and unmonitored kennel conditions."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 3,
      "title": {
        "en": "Frustrations with rising costs and fees"
      },
      "text": {
        "en": "Pet owners express dissatisfaction regarding unexpected charges and recent price increases at the clinic. Multiple clients report high costs for administrative documentation, including government travel health certificates, as well as separate fees for feeding pets during day stays. Reviewers also express disappointment that multi-pet discount options are unavailable on wellness plans."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do clients rate the bedside manner of the veterinarians?"
      },
      "a": {
        "en": "Most pet owners describe the staff as compassionate and attentive, though occasional reviews mention rushed or impersonal communication."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are separate fees charged for day-stay care?"
      },
      "a": {
        "en": "Yes, clients report that additional charges may apply for feeding and monitoring pets during extended day drop-offs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital offer multi-pet plan discounts?"
      },
      "a": {
        "en": "Reviewers note that the clinic's Optimum Wellness Plans currently do not provide multi-pet discounts for families with several animals."
      },
      "basis": "reviews"
    }
  ],
