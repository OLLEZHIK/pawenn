  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 34,
      "title": {
        "en": "Attentive, friendly clinical care team"
      },
      "text": {
        "en": "Pet owners frequently praise the veterinarians, technicians, and front desk staff for their warm, supportive, and professional bedside manner. Reviewers highlight how clinicians listen patiently to owner questions and provide gentle care during routine wellness exams and emergency visits. While isolated negative experiences with individual doctors were reported, client feedback is broadly positive."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Fear-free comfort for nervous pets"
      },
      "text": {
        "en": "Clients frequently remark on the clinic's gentle, stress-free environment for anxious dogs and cats. Pet parents appreciate that staff members take time to let animals acclimate to examination rooms, using treats and patient handling techniques to ease veterinary anxiety. Many reviewers note that even shy or reactive pets handle examinations, blood draws, and routine vaccinations with ease."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 16,
      "title": {
        "en": "Helpful guidance alongside pricing transparency concerns"
      },
      "text": {
        "en": "Feedback regarding communication is mixed. Many clients appreciate thorough consultations and clear preventive care guidance from attentive doctors. However, several reviewers express frustration over a lack of upfront cost transparency for bloodwork and dental add-ons, as well as unexpected wellness plan cancellation terms. Pet owners urge visitors to request written estimates before agreeing to care."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the clinic accommodate anxious or reactive pets?"
      },
      "a": {
        "en": "Reviewers note that staff use treats and patient, fear-free handling techniques to help stressed dogs and cats feel comfortable."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What should pet owners know about wellness plan terms?"
      },
      "a": {
        "en": "Several clients recommend asking for detailed cancellation policies and coverage exclusions before enrolling in annual wellness plans."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can clients request itemized estimates before diagnostic testing?"
      },
      "a": {
        "en": "Reviewers advise asking for written cost estimates before authorizing diagnostic tests or additional clinic procedures."
      },
      "basis": "reviews"
    }
  ],
