  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Dedicated and dependable walking team"
      },
      "text": {
        "en": "Pet owners consistently commend business owner Gina and her walking staff for dedication and reliability. Reviewers value that team members arrive punctually and frequently accommodate short-notice requests during unexpected schedule changes. Clients express deep trust knowing their home and pets are treated with genuine respect."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Thoughtful attention for varied pets"
      },
      "text": {
        "en": "Clients highlight the team's gentle handling of diverse animals, including shy rescue cats, energetic puppies, and senior dogs with medical needs. Owners note that walkers patiently adapt to pets with separation anxiety or reactivity towards other dogs. Pet parents report that their animals genuinely look forward to visits and feel at ease."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "en": "Helpful app updates with photos"
      },
      "text": {
        "en": "Reviewers praise the convenience of the booking software and the thorough visit reports received through the mobile app. Pet parents appreciate GPS tracking logs, timestamped check-ins, and clear photos sent directly after each walk or sitting visit. Clients emphasize that these structured daily updates offer complete peace of mind while away."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the service provide GPS tracking and photo updates?"
      },
      "a": {
        "en": "Yes, clients receive timestamped check-ins, GPS walk routes, and multiple photos after every visit via a mobile app."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can sitters care for cats and senior pets?"
      },
      "a": {
        "en": "Yes, reviewers describe thorough cat visits including litter cleaning and playtime, as well as attentive care for senior dogs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are walkers able to accommodate short-notice bookings?"
      },
      "a": {
        "en": "Yes, several pet owners appreciate the team's flexibility when unexpected work shifts or travel plans arise."
      },
      "basis": "reviews"
    }
