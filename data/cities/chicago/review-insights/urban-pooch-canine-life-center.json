  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Enthusiastic and attentive care team"
      },
      "text": {
        "en": "Pet parents rave about the welcoming staff across all departments, noting that team members greet every dog by name and show genuine affection. Reviewers highlight the dedication of daycare attendants, trainer Sharon Ciernak, and groomers Deb and Amanda. Clients feel entirely confident leaving their dogs under the supervision of such skilled and loving animal care professionals."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Open play and minimal confinement"
      },
      "text": {
        "en": "Reviewers emphasize that dogs are thrilled to arrive, often pulling eagerly toward the doors to join group play. Pet owners appreciate the cage-free boarding environment, where crate time is reserved strictly for meals and resting. Staff members receive high praise for helping timid or fearful dogs build socialization confidence at their own pace without overwhelming them."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "en": "Expert grooming styling and behavioral progress"
      },
      "text": {
        "en": "Clients consistently praise the outcomes of grooming sessions and obedience classes. Owners report clean, stylish haircuts, excellent coat maintenance, and specialized hand-stripping services for wire-haired breeds. In addition, training clients highlight dramatic behavioral improvements in reactive and timid dogs, praising instructors for practical, confidence-building lessons."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Urban Pooch keep boarding dogs in cages all day?"
      },
      "a": {
        "en": "Reviewers note that boarding dogs enjoy open group play throughout the day, with crates used primarily for meals and sleeping."
      },
