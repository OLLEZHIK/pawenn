  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 52,
      "title": {
        "en": "Gentle treatment for sensitive pets"
      },
      "text": {
        "en": "Pet parents highlight the compassionate attention provided to anxious dogs and reactive cats. Reviewers appreciate that practitioners allow owners to assist with calming holds, use treats to distract nervous pets, and maintain quiet bedside manners. A few clients expressed distress during difficult euthanasia visits, but most owners report their pets feel safe."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "en": "Dedicated veterinarians and support personnel"
      },
      "text": {
        "en": "Most reviewers commend the medical team in Wicker Park, frequently naming Dr. Ryan, Dr. Kung, Tamara, and Everest for their thoroughness. Clients emphasize that clinicians sit with owners to discuss health concerns and offer clear care guidance. Critical feedback includes a client noting high staff turnover after a longtime director departed."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Responsive follow-ups and transparent guidance"
      },
      "text": {
        "en": "Clients appreciate the clinic's open communication channels, noting helpful text messaging, phone check-ins, and proactive post-visit follow-up calls. Veterinarians take time to answer detailed questions regarding diagnostics and prescriptions. A minority of reviewers felt updates were slow or lacked clarity during complex multi-week treatments."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Companion Animal Hospital Wicker Park accommodate anxious or reactive pets?"
      },
      "a": {
        "en": "Yes, clients report that veterinarians and technicians are experienced with anxious pets and accommodate owner involvement to keep animals calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners contact the clinic via text message?"
      },
      "a": {
        "en": "Yes, reviewers note that the practice offers a text and email service for convenient follow-up questions and scheduling."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is online appointment scheduling available?"
      },
      "a": {
        "en": "Yes, pet owners can book appointments directly through the clinic website."
      },
      "basis": "website"
    }
  ],
