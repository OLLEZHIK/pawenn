  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 57,
      "title": {
        "en": "Welcoming, attentive doctors and technicians"
      },
      "text": {
        "en": "Pet owners express deep appreciation for the veterinary team, frequently praising Dr. Henderson, Dr. Youk, Dr. Woods, and technicians like Kuro and Danely for their warmth and patience. Reviewers emphasize that staff treat pets with genuine affection and create a comfortable atmosphere. Despite isolated complaints regarding reception desk demeanor, feedback remains overwhelmingly positive."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Gentle handling of fearful pets"
      },
      "text": {
        "en": "Clients consistently highlight how calm and comfortable their pets remain during examinations, vaccinations, and nail trims. Reviewers note that technicians pay close attention to feline and canine body language, using soothing, fear-free handling techniques to reassure nervous rescues. Many owners mention that even pets with prior clinic anxiety handled visits with unexpected ease."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Thorough medical explanations and advice"
      },
      "text": {
        "en": "Pet parents appreciate the clear, proactive communication from attending veterinarians and assistants. Reviewers note that clinicians take ample time to answer detailed questions, explain medication options, and discuss preventive wellness plans without rushing. While a small number of clients noted scheduling confusion, most owners describe communication as attentive and helpful."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the team handle anxious or nervous pets?"
      },
      "a": {
        "en": "Clients frequently report that technicians use gentle techniques and observe pet body language to keep nervous animals calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are same-day visits available for acute symptoms?"
      },
      "a": {
        "en": "Reviewers mention being able to schedule prompt appointments for pressing issues like severe itching or sudden discomfort."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What should pet parents confirm regarding medication refills?"
      },
      "a": {
        "en": "A few reviewers suggest checking recheck testing policies in advance to avoid unexpected exam charges when refilling prescriptions."
      },
      "basis": "reviews"
    }
  ],
