    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Attentive veterinarians and support team"
      },
      "text": {
        "en": "Pet owners frequently praise the veterinary doctors, technicians, and front desk associates for their patience, clear guidance, and compassionate approach. Reviewers note that clinicians take ample time to answer questions regarding pet diagnoses and home treatments. Although a few clients expressed frustration regarding wellness plan cancellations, the majority highlight a welcoming clinical team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Patient and gentle pet handling"
      },
      "text": {
        "en": "Clients consistently emphasize that veterinary assistants and doctors treat dogs and cats with warmth and consideration. Several reviewers note that clinicians accommodate nervous or aging pets by performing physical exams gently on the floor beside their owners. Pet parents appreciate that staff work diligently to keep animals calm and comfortable throughout procedures."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "en": "Clean clinic facilities and accessibility"
      },
      "text": {
        "en": "Reviewers frequently describe the animal hospital as a clean, well-organized, and comfortable facility for appointments. Multiple clients mention that the team provided helpful elevator access for pets unable to navigate stairs. Visitors also appreciate the convenience of finding street parking near the building for early evening visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do veterinarians accommodate anxious or nervous pets?"
      },
      "a": {
        "en": "Clients mention that doctors and technicians handle animals gently, allowing nervous pets to remain close to their owners on the exam room floor."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are preventative wellness plans available at the clinic?"
      },
      "a": {
        "en": "Yes, the practice offers annual pet health plans covering routine checkups and lab tests with monthly billing options."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is the clinic building accessible for older or mobility-impaired pets?"
      },
      "a": {
        "en": "Reviewers report that clinic staff readily assist with elevator access for clients with strollers or pets unable to climb stairs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can the hospital handle urgent visits or travel certifications?"
      },
      "a": {
        "en": "Yes, several clients note that the clinic successfully accommodated short-notice travel health certificates and urgent appointments."
      },
      "basis": "reviews"
    }
