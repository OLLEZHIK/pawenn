  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Affectionate handlers and skilled groomers"
      },
      "text": {
        "en": "Clients warmly praise the daycare attendants, receptionists, and grooming specialists for their genuine love of dogs and personal attentiveness. Groomers Thomas and Julia receive frequent commendations for patient styling, while front desk staff members are recognized for greeting dogs by name. With very few exceptions, pet parents describe the team as reliable, accommodating, and caring."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Enthusiastic and joyful daycare experience"
      },
      "text": {
        "en": "Dog owners overwhelmingly report that their pets adore visiting the daycare and boarding facility, frequently showing intense excitement as soon as they arrive in the neighborhood. Dogs return home tired, happy, and well-exercised after full days of supervised play. Although two reviewers reported superficial scratches or distress following boarding stays, the vast majority describe thriving, confident pets."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 7,
      "title": {
        "en": "Quality grooming and styling results"
      },
      "text": {
        "en": "Pet parents highlight excellent results across professional grooming services, including thorough baths, breed styling, and delicate nail trims. Clients appreciate that groomers listen attentively to styling requests and handle pets with great patience and artistic care. Dogs leave looking handsome, smelling clean, and feeling comfortable after their grooming sessions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do pet parents receive photo updates during boarding?"
      },
      "a": {
        "en": "Yes, clients frequently receive photo updates and behavioral report cards, though some reviewers note these updates can occasionally be inconsistent."
      },
