      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the facility offer professional dog grooming?"
      },
      "a": {
        "en": "Yes, clients praise professional grooming services, including custom breed haircuts, baths, and nail trims."
      },
      "basis": "reviews"
    }
