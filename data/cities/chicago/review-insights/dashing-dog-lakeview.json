  "period_to": "2026-10-10",
  "reviews_in_period": 96,
  "observed_at": "2026-10-10",
  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 77,
      "title": {
        "en": "Friendly and attentive grooming team"
      },
      "text": {
        "en": "Clients frequently commend the individual stylists in Lakeview, citing Andrea, Maya, Stan, Jimmy, and Franco for their warmth and craftsmanship. Pet owners appreciate thoughtful touches such as take-home polaroid photos and toy gifts. A small number of reviewers noted frustration with abrupt customer service or groomers not listening closely to styling instructions."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 69,
      "title": {
        "en": "Gentle attention for nervous dogs"
      },
      "text": {
        "en": "Many reviewers highlight how calm and cheerful their pets appear after appointments, emphasizing that groomers handle anxious puppies, doodles, and senior dogs with patience. However, three dissatisfied pet parents reported rough physical handling, including nail quick bleeding and an ear nick during haircut sessions."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 68,
      "title": {
        "en": "Consistent styling and coat care"
      },
      "text": {
        "en": "Pet owners broadly praise the final appearance of their dogs, describing fresh-smelling coats, neat face trims, and thorough deshedding. Regulars note that coats come back fluffy and well-shaped. Conversely, several critical reviews pointed to uneven patches, missed matting, or lengths that differed from requested specifications."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do dogs receive take-home photos or treats after grooming?"
      },
      "a": {
        "en": "Yes, clients frequently mention that groomers provide an adorable Polaroid photo and a complimentary toy upon checkout."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Dashing Dog handle anxious dogs and puppies?"
      },
      "a": {
        "en": "Yes, reviewers consistently note that stylists show patience and gentle care with nervous dogs and first-time puppies."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can appointments be booked online?"
      },
      "a": {
        "en": "Yes, online booking is available, though reviewers recommend calling directly to confirm spot availability."
      },
      "basis": "both"
    }
  ],
