  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 18,
      "title": {
        "en": "Mixed views on veterinary personnel"
      },
      "text": {
        "en": "Pet owners share divergent perspectives on the clinic's veterinary personnel. Many clients express gratitude for caring, thorough doctors and helpful technicians who treat pets like family. However, several recent reviewers report significant frustrations with high doctor turnover, unnotified policy changes, perceived upselling, and dismissive bedside manner during difficult visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 8,
      "title": {
        "en": "Gentle and patient pet handling"
      },
      "text": {
        "en": "Reviewers frequently praise the attentive, gentle handling their pets receive from practitioners. Multiple clients note that nervous or senior animals were treated with genuine care, patience, and kindness during routine checkups and follow-up care. A rare complaint noted staff declining to assist a found wild animal, but pets under their care are generally reported to feel safe and relaxed."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 5,
      "title": {
        "en": "Responsive follow-up with administrative gaps"
      },
      "text": {
        "en": "Client experiences regarding clinical communication show varied feedback over the past six months. Several pet owners highlight prompt responses to phone calls and emails, easy access to medical records, and proactive post-operative follow-up calls from attending doctors. Conversely, critical reviews describe delays in transferring lab results to emergency facilities and insufficient notification of administrative changes."
      }
    }
  ],
