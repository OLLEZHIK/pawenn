  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "en": "Beloved veterinarians and caring clinical staff"
      },
      "text": {
        "en": "Pet owners consistently praise the doctors and technicians for their clinical expertise, empathetic communication, and accommodating attitudes. Reviewers frequently highlight Dr. Singh and Dr. Paik for taking extra time to answer questions thoroughly and providing honest, reassuring guidance. Families feel strongly supported and describe the practice as an exceptionally trustworthy neighborhood veterinary clinic."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Gentle pet handling and attentive care"
      },
      "text": {
        "en": "Clients highlight the team's kind, patient approach when examining both young puppies and aging senior pets. Staff members provide calm handling techniques that help ease veterinary anxiety in dogs and cats during routine physical exams, vaccinations, and nail trims. Reviewers emphasize that the clinicians genuinely love animals, treating each patient with attentiveness and family-like warmth."
      }
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "mentions": 8,
      "title": {
        "en": "Fair rates with paperwork disputes"
      },
      "text": {
        "en": "Most clients praise the clinic for reasonable, honest pricing, emphasizing that veterinarians avoid pushing unnecessary procedures or surprise expenses. Pet parents appreciate transparent estimates for routine wellness visits and surgeries. However, isolated reviewers report substantial frustration over steep charges for specific paperwork, such as international travel health documentation."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do reviewers view the clinic's pricing and honesty?"
      },
      "a": {
        "en": "Most pet owners praise the clinic for fair, transparent pricing and note that veterinarians avoid recommending unnecessary procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the team handle nervous animals?"
      },
      "a": {
        "en": "Clients report that doctors and technicians handle nervous dogs and cats with patience and gentle care, helping pets stay calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic assist with international pet travel documentation?"
      },
      "a": {
        "en": "Yes, veterinarians can process USDA travel health certificates, though clients advise confirming administrative service fees in advance."
      },
      "basis": "reviews"
    }
  ],
