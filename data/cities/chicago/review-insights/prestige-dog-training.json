    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Insightful and patient canine instructors"
      },
      "text": {
        "en": "Reviewers speak warmly of trainers Ulysses, Adonis, Brianna, and Ayla for their insightful instruction and patience. Clients appreciate that trainers take time to explain canine body language and root causes of behavior rather than offering generic advice. Owners feel guided and empowered to practice handling techniques effectively."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Support for reactive and fearful dogs"
      },
      "text": {
        "en": "Pet parents highlight the academy's success in helping dogs with severe leash reactivity, sound sensitivity, and fear-based aggression. Reviewers note that trainers use structured methods to build canine confidence step by step. Owners of both young puppies and adult rescues praise the calm, personalized approach taken with each dog."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Noticeable progress in daily obedience"
      },
      "text": {
        "en": "Clients report dramatic improvements in leash manners, reduced barking in apartments, and relaxed behavior around houseguests. Many owners who enrolled in the two-week board-and-train program describe returning home to a significantly calmer and more focused dog. Pet parents emphasize gaining lasting tools for everyday urban walks."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What training programs are offered?"
      },
      "a": {
        "en": "Reviewers mention one-on-one private lessons, specialized behavioral packages, and two-week board-and-train programs."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can trainers help with leash reactivity and anxiety?"
      },
      "a": {
        "en": "Yes, many clients report significant progress addressing leash pulling, lunging, sound sensitivity, and fear-based reactivity."
      },
      "basis": "reviews"
    },
