  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 36,
      "title": {
        "en": "Supportive store associates and groomers"
      },
      "text": {
        "en": "Pet parents extensively praise the store associates, cashiers, and grooming team members for their friendly and helpful assistance. Many reviewers specifically commend groomer Alex F for patience, attentiveness, and exceptional styling with energetic pets. While isolated complaints mentioned cashier indifference or opening delays, customer feedback remains overwhelmingly positive."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Quality grooming cuts and nail trims"
      },
      "text": {
        "en": "Clients frequently commend the grooming salon for delivering neat haircuts, thorough baths, and stress-free nail clippings. Reviewers report that dogs leave appointments looking clean, fluffy, and smelling fresh, with evenly shaped coats and tidy paws. Pet parents appreciate that groomers listen attentively to styling requests and complete services efficiently."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Comforting handling for nervous dogs"
      },
      "text": {
        "en": "Reviewers highlight that salon groomers handle timid, vocal, or high-energy dogs with remarkable gentleness and patience. Clients recount that their anxious pets relaxed quickly during bath sessions and nail trims without showing distress. Pet owners appreciate knowing that their animal companions are treated with affection and warmth throughout each visit."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What grooming services are offered at this location?"
      },
      "a": {
        "en": "Reviewers highlight full-service dog grooming, breed-specific haircuts, deshedding baths, nail trims, and ear cleaning."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can clients walk in for dog nail trims?"
      },
      "a": {
        "en": "While walk-in nail trims are often accommodated, reviewers suggest calling ahead or scheduling an appointment to ensure groomer availability."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do groomers handle anxious or sensitive pets?"
      },
      "a": {
        "en": "Multiple clients report that groomers take time to comfort nervous dogs, keeping sessions calm and stress-free."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do store staff help with dietary and product advice?"
      },
      "a": {
        "en": "Yes, customers note that retail associates readily assist with finding specialized pet foods, allergy formulas, and wellness supplies."
      },
      "basis": "reviews"
    }
