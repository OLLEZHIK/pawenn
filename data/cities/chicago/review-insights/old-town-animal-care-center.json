  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 51,
      "title": {
        "en": "Compassionate and knowledgeable clinicians"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinary team and clinical assistants for their empathy, dedication, and clear guidance. Reviewers regularly mention clinicians like Dr. Kessel and Dr. Phillips, appreciating thorough diagnostic explanations and thoughtful follow-up care. While a handful of clients expressed concern over doctor turnover or rushed visits, overall trust in the clinical staff remains very high."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Attentive comfort for companion animals"
      },
      "text": {
        "en": "Clients frequently emphasize how comfortable, safe, and loved their pets feel during visits. Reviewers note that staff approach anxious dogs and nervous felines with immense patience, offering tasty treats and soothing reassurance throughout exams. Pet parents report that even pets with severe veterinary anxiety are handled with exemplary tenderness and care."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 20,
      "title": {
        "en": "Timely check-ins and organized appointments"
      },
      "text": {
        "en": "Reviewers frequently highlight the efficiency of scheduling and clinic reception. Clients report that appointments start promptly with minimal lobby wait times, allowing dogs and cats to be settled in examination rooms swiftly. While one reviewer experienced difficulty scheduling under a wellness plan, the majority describe smooth, punctual visits."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do veterinarians accommodate nervous or anxious pets?"
      },
      "a": {
        "en": "Staff use patient handling, calming techniques, and treats to help anxious dogs and cats feel secure during physical exams."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic follow up after veterinary visits?"
      },
      "a": {
        "en": "Yes, clients report receiving proactive phone calls and emails from staff to check on recovering pets following appointments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How are treatment options and estimates discussed?"
      },
      "a": {
        "en": "Reviewers note that doctors provide clear explanations and walk owners through available testing and care options."
      },
      "basis": "reviews"
    }
  ],
