    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "en": "Supportive and attentive medical team"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinarians and technicians at Portage Park Animal Hospital for their warm bedside manner, thorough checkups, and patient guidance. Reviewers appreciate that the team listens closely to health concerns and explains every step of care clearly."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 19,
      "title": {
        "en": "Clear explanations and attentive consultations"
      },
      "text": {
        "en": "Clients highlight that doctors take the time to answer every medical question in detail, provide transparent diagnostics, and follow up promptly after procedures. Families feel well-informed and confident making treatment decisions for their dogs and cats."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Gentle handling for anxious pets"
      },
      "text": {
        "en": "Reviewers emphasize the staff's gentle approach when examining nervous or senior pets, keeping dogs and cats relaxed throughout physical exams and vaccine visits. Pet parents note that even fearful animals feel secure under the hospital's calm handling."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Portage Park Animal Hospital treat both dogs and cats?"
      },
      "a": {
        "en": "Yes, reviewers consistently describe routine and urgent care visits for both canine and feline family members."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients describe the appointment booking experience?"
      },
      "a": {
        "en": "Pet parents report smooth and accommodating scheduling for regular exams, annual vaccinations, and sudden medical issues."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are the veterinarians thorough when explaining test results?"
      },
      "a": {
        "en": "Reviewers highlight that doctors patiently explain bloodwork, diagnostic findings, and preventive options without rushing visits."
      },
      "basis": "reviews"
    }
