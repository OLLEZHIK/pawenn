  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 46,
      "title": {
        "en": "Kind and dependable veterinary staff"
      },
      "text": {
        "en": "Pet parents widely praise the veterinary doctors, technicians, and front desk team in Uptown for their kindness, deep knowledge, and compassionate bedside manner. Clients value the personalized attention their animals receive, with only isolated concerns regarding intake."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Informative medical consultations and guidance"
      },
      "text": {
        "en": "Clients emphasize that the clinical team communicates diagnostic test results and treatment recommendations with thorough clarity and patience. Reviewers feel well-guided during medical discussions, although one client reported dissatisfaction with electronic record handling."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "en": "Reliable wellness and medical recoveries"
      },
      "text": {
        "en": "Reviewers report positive health outcomes for both cats and dogs undergoing routine wellness care, chronic disease management, and minor surgeries. Pet parents appreciate that ongoing treatments effectively resolve symptoms and keep their family animals healthy."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Uptown Animal Hospital see both canine and feline patients?"
      },
      "a": {
        "en": "Yes, reviewers regularly bring both dogs and cats for routine wellness checkups, vaccinations, and targeted medical treatments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients describe the hospital's staff bedside manner?"
      },
      "a": {
        "en": "Clients consistently commend the doctors and technicians for showing genuine warmth, patience, and gentle handling during office visits."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are veterinary appointments easy to schedule?"
      },
      "a": {
        "en": "Pet parents report that scheduling is straightforward and the staff accommodates timely appointments for regular care and minor concerns."
      },
      "basis": "reviews"
    }
  ],
