    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 29,
      "title": {
        "en": "Attending clinicians versus support consistency"
      },
      "text": {
        "en": "Client sentiment regarding personnel is divided. Many pet owners express warm appreciation for individual veterinarians, specifically citing Dr. McCarthy and Dr. Elder for attentive examinations. Conversely, multiple visitors report friction with front desk receptionists and inconsistent handling by rotating technicians."
      }
    },
    {
      "topic": "prices",
      "sentiment": "negative",
      "mentions": 19,
      "title": {
        "en": "Concerns regarding fees and membership charges"
      },
      "text": {
        "en": "Pricing draws substantial criticism from reviewers across Andersonville. While select clients note upfront estimates for routine procedures, numerous reviewers describe steep exam fees, unexpected add-on testing costs, and pressure surrounding monthly wellness plans or app-based payment systems."
      }
    },
    {
      "topic": "communication",
      "sentiment": "negative",
      "mentions": 18,
      "title": {
        "en": "Frustrations with phone access and messaging"
      },
      "text": {
        "en": "Communication receives frequent negative feedback. Pet owners report difficulties reaching staff by phone during urgent situations, unanswered messages within the clinic app, and confusion regarding automated scheduling notices. Positive notes mention helpful direct text messaging with reception."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does GoodVets Andersonville offer dedicated parking?"
      },
      "a": {
        "en": "Yes, clients note that the location features an on-site parking lot along North Ridge Avenue, which eases arrival for appointments."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How can pet parents communicate with the clinic?"
      },
      "a": {
        "en": "Pet owners can reach the clinic by phone or through direct text messaging with the front desk, although several reviewers report delayed responses via the app."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are price estimates provided before treatments?"
      },
      "a": {
        "en": "Some clients report receiving cost estimates prior to procedures, but many reviewers advise confirming all exam and diagnostic fees in advance to avoid unexpected charges."
      },
      "basis": "reviews"
