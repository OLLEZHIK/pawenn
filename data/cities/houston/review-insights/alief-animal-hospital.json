  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 62,
      "title": {
        "en": "Praised doctors alongside reception friction"
      },
      "text": {
        "en": "Most pet owners praise the clinical personnel, with Dr. Jose and the veterinary technicians receiving consistent acclaim for their compassion, attentiveness, and patient care. Spanish-speaking clients especially value clear medical advice. At the same time, several reviewers report negative interactions at reception, citing unhelpful attitudes, abrupt telephone handling, and occasional friction during check-in."
      }
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "mentions": 29,
      "title": {
        "en": "Affordable rates alongside pricing disputes"
      },
      "text": {
        "en": "Clients widely appreciate the affordable fee structure for vaccinations, minor treatments, deworming, and surgical operations such as spaying and neutering. Many reviewers note that fees remain accessible for multi-pet households and pet rescues. A few owners, however, express caution over unexpected consultation charges or procedural add-ons that increased their final bill beyond expectations."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 16,
      "title": {
        "en": "Lengthy waits in walk-in queue"
      },
      "text": {
        "en": "Wait times represent a frequent source of complaint due to the clinic's walk-in operating model. Pet owners report waits ranging from one to four hours during peak periods, particularly on Saturdays. While clients appreciate being able to register and wait offsite or receive a callback when their turn approaches, several reviewers describe the first-come queue as disorganized and time-consuming."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the walk-in system work at Alief Animal Hospital?"
      },
      "a": {
        "en": "The clinic operates primarily on a first-come, first-served walk-in basis, and clients can leave their contact number to receive a callback when their turn approaches."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are prices affordable for routine procedures and vaccinations?"
      },
      "a": {
        "en": "Yes, many reviewers highlight budget-friendly rates for core shots, wellness visits, and spay or neuter surgeries, though some advise confirming itemized costs beforehand."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are Spanish-speaking veterinary staff available?"
      },
      "a": {
        "en": "Yes, clients frequently mention bilingual veterinarians and technicians, including Dr. Jose, who explain medical plans comfortably in Spanish."
      },
      "basis": "reviews"
    }
  ],
