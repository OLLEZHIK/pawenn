  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 50,
      "title": {
        "en": "Trusted veterinarians and caring team"
      },
      "text": {
        "en": "Pet owners consistently praise the veterinary personnel for their warmth, professionalism, and dedication. Doctors like Dr. Castro and Dr. Taylor earn widespread acclaim for their gentle bedside manner, thorough medical explanations, and willingness to discuss treatment alternatives, with long-time clients expressing immense loyalty and confidence in the entire care team."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Affectionate handling across pet ages"
      },
      "text": {
        "en": "Reviewers emphasize the compassionate and patient attention given to pets of all kinds, including senior dogs, playful puppies, cranky rescue cats, and French bulldogs. Clients frequently note that nervous animals remain calm during routine shots, exams, and minor procedures, praising the clinic's gentle environment and attentive post-operative checkups."
      }
    },
    {
      "topic": "prices",
      "sentiment": "mixed",
      "mentions": 12,
      "title": {
        "en": "Fair treatment costs alongside recent increases"
      },
      "text": {
        "en": "Many clients commend the clinic for avoiding aggressive upselling, noting reasonable fees for routine shots, parasite medicines, and minor surgeries compared to other local providers. However, several long-time clients raise concerns regarding recent price increases, citing upfront appointment booking deposits, steep blood work estimates, and higher procedural fees."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How do clients rate the veterinarians at Long Drive Dog & Cat Hospital?"
      },
      "a": {
        "en": "Veterinarians including Dr. Castro and Dr. Taylor receive high praise from reviewers for their gentle bedside manner, patience, and clear explanations."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are appointments required to visit the clinic?"
      },
      "a": {
        "en": "Yes, clients note that visits are conducted by appointment, and a booking deposit may be requested when scheduling."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do clients feel treatment prices are reasonable?"
      },
      "a": {
        "en": "Many reviewers find basic care and medication reasonably priced without hard upselling, though some long-time clients mention recent price increases on advanced testing."
      },
      "basis": "reviews"
    }
  ],
