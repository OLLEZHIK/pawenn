  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 71,
      "title": {
        "en": "Attentive clinical team during urgent visits"
      },
      "text": {
        "en": "Numerous pet owners express gratitude for the compassionate veterinary doctors and technicians who provide urgent interventions during critical pet health situations. Reviewers note that clinical staff show empathy during difficult medical decisions and emergency procedures, though isolated complaints describe rushed consultations or dismissive telephone interactions."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 57,
      "title": {
        "en": "Critical medical attention for companion pets"
      },
      "text": {
        "en": "Clients describe intensive veterinary support for dogs and cats experiencing acute trauma, severe gastrointestinal distress, seizures, or emergency C-sections. Pet parents appreciate that clinicians stabilize critically ill pets and provide continuous overnight monitoring, although grieving owners occasionally note poor prognoses in severe terminal cases."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 41,
      "title": {
        "en": "Rapid emergency intake alongside lengthy waits"
      },
      "text": {
        "en": "Experiences with admission times vary considerably depending on patient urgency and hospital volume. Clients arriving with life-threatening emergencies frequently report prompt triage and immediate stabilization. Conversely, non-critical cases and routine consultations often encounter waiting room delays extending to two hours or longer during peak evening hours."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Sunset Animal Hospital provide emergency veterinary care?"
      },
      "a": {
        "en": "Yes, the hospital operates around the clock for emergency pet admissions, critical surgeries, and urgent care."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are overnight hospitalization services available?"
      },
      "a": {
        "en": "Yes, critically ill animals can be admitted for continuous overnight medical monitoring and intravenous therapy."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How are patient wait times determined?"
      },
      "a": {
        "en": "The hospital utilizes a medical triage protocol where life-threatening emergencies receive immediate care ahead of routine visits."
      },
      "basis": "reviews"
    }
  ],
