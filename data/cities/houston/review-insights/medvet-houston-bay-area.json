  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 44,
      "title": {
        "en": "Specialized expertise from collaborative veterinary clinicians"
      },
      "text": {
        "en": "Pet owners commend specialists like cardiologist Dr. Wu, surgeon Dr. Banham, and dedicated nursing technicians for exceptional skill and bedside compassion. Clients feel confident in the team's diagnostic capability. A couple of critical reviews mention curt phone demeanor or missed findings, but the vast majority report deeply caring service."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "Clear explanations and transparent treatment plans"
      },
      "text": {
        "en": "Reviewers appreciate that specialists take time to explain echocardiogram readings, imaging diagnostics, and surgical alternatives without rushing. Clients note that clinicians provide realistic outlooks, discuss medication regimens, and keep families informed during procedures. Transparent pricing estimates also help owners prepare."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 15,
      "title": {
        "en": "Advanced specialty care and successful recovery"
      },
      "text": {
        "en": "Clients report significant medical successes in cardiology management, complex tumor diagnostics, and orthopedic surgery saving service dog limbs. Multiple pet owners express deep gratitude for stabilized heart conditions and thoughtful palliative solutions, noting that specialized interventions gave pets extended quality of life."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does MedVet Houston Bay Area operate as a 24/7 emergency room?"
      },
      "a": {
        "en": "No, this Bay Area location functions as a daytime referral specialty hospital focusing on cardiology, oncology, internal medicine, and surgery."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do I need a veterinarian referral to book a consultation?"
      },
      "a": {
        "en": "Yes, as a specialized referral center, appointments are typically coordinated in partnership with your primary care family veterinarian."
      },
      "basis": "website"
    },
    {
      "q": {
        "en": "Are cardiology diagnostic exams performed under sedation?"
      },
      "a": {
        "en": "Reviewers note that echocardiograms and cardiac evaluations are often performed during regular exams without requiring fasting or sedation."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What specialty services are offered at this location?"
      },
      "a": {
        "en": "The hospital provides advanced cardiology, medical oncology, internal medicine, and complex soft tissue and orthopedic surgery."
      },
      "basis": "both"
    }
