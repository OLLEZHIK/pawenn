  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Helpful store clerks and skilled groomers"
      },
      "text": {
        "en": "Shoppers frequently praise the retail associates and dog groomers at this Clear Lake store for their kindness, product knowledge, and attentiveness. Staff members like Connor and Jay receive special thanks for carrying heavy bags to cars and guiding first-time pet owners. While several dissatisfied reviewers noted communication lapses in the grooming department or disputed customer service attitudes, most clients report warm assistance."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "en": "Gentle pet care and puppy training"
      },
      "text": {
        "en": "Reviewers emphasize that pets are treated with patience during shopping visits, puppy training classes, and routine grooming appointments. Dog owners highlight groomer Taylor for her calm handling of sensitive dogs, and several clients mention successful obedience lessons with in-store dog trainers. Although one visitor was denied water for an overheated dog, most pet owners feel welcomed when visiting with their animals."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Well-stocked store with broad selection"
      },
      "text": {
        "en": "Pet owners appreciate the clean, organized aisles and broad merchandise selection available at this shopping plaza location. Customers mention finding everything from rabbit feed and feeder crickets to premium dog food brands not carried by larger big-box chains. Reviewers note that the store is easy to navigate, brightly lit, and consistently stocked with everyday pet essentials."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does this Pet Supplies Plus location offer dog grooming?"
      },
      "a": {
        "en": "Yes, clients frequently mention booking bath, brush, and full haircut services with the store's professional grooming team."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are puppy obedience classes available here?"
      },
      "a": {
        "en": "Yes, reviewers highlight working with an in-store dog trainer for puppy socialization and basic obedience training."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What types of small animal supplies does the store carry?"
      },
      "a": {
        "en": "Customers report a broad inventory including food, treats, and accessories for dogs, cats, rabbits, fish, and live feeder crickets."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are pets allowed inside the Clear Lake store?"
      },
      "a": {
        "en": "Yes, leashed pets are welcome to shop alongside their owners, and associates frequently greet visiting dogs."
      },
      "basis": "reviews"
    }
