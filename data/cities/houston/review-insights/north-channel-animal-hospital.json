  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 27,
      "title": {
        "en": "Gentle handling for fearful pets"
      },
      "text": {
        "en": "Pet owners consistently note how gently veterinarians and technicians handle their dogs and cats during exams, shots, and surgical procedures. Reviewers mention that staff often get down on the floor to calm nervous or large dogs, avoiding unnecessary muzzles and ensuring animals feel secure throughout appointments."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 26,
      "title": {
        "en": "Compassionate doctors and attentive assistants"
      },
      "text": {
        "en": "Clients frequently commend doctors such as Dr. Watts and Dr. Bordeaux alongside the nursing team for their clear medical explanations and attentive bedside manner. While a couple of reviewers experienced unhelpful front-desk interactions, most pet parents praise the team for thorough follow-through and genuine care."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "positive",
      "mentions": 11,
      "title": {
        "en": "Prompt check-ins with occasional delays"
      },
      "text": {
        "en": "Most visitors report quick check-ins and minimal time spent in the waiting room, often being called back within minutes for scheduled visits and urgent checkups. However, a reviewer noted frustration when staff appeared preoccupied with phones and left them waiting without initial acknowledgment at the front counter."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does North Channel Animal Hospital accommodate same-day or walk-in visits?"
      },
      "a": {
        "en": "Yes, pet owners report being able to book same-day appointments online or walk in for urgent pet concerns during regular morning hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Which surgical and preventive services are commonly reviewed?"
      },
      "a": {
        "en": "Reviewers frequently describe routine spaying and neutering, dental cleanings and extractions, annual vaccinations, and heartworm prevention shots."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do veterinarians take time to explain treatment plans?"
      },
      "a": {
        "en": "Yes, clients frequently mention that the doctors thoroughly outline diagnoses, aftercare instructions, and preventive wellness options."
      },
      "basis": "reviews"
    }
  ],
