  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 49,
      "title": {
        "en": "Feline-focused handling and gentle examinations"
      },
      "text": {
        "en": "Cat owners overwhelmingly celebrate this hospital for its exclusive feline environment and patient approach to medical treatment. Reviewers report that even highly stressed, aggressive, or elderly cats remain calm during checkups and routine blood draws. Clients deeply appreciate that attending clinicians understand nuanced feline behaviors and tailor care to keep visits low-stress."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 45,
      "title": {
        "en": "Specialized feline clinicians and caring technicians"
      },
      "text": {
        "en": "Clients frequently commend Dr. Folger, Dr. Rice, and Dr. Addleman for their extensive feline expertise and genuine affection for their feline patients. Technicians receive regular compliments for their attentiveness during exams and boarding stays. Although two reviewers experienced frustration regarding scheduling and triage decisions during urgent situations, the overall sentiment highlights deep trust in the veterinary staff."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Quiet dog-free facility and boarding"
      },
      "text": {
        "en": "Pet owners emphasize the calming benefit of a strictly feline veterinary clinic where there are no barking dogs or noisy distractions to agitate sick cats. Many reviewers also utilize the hospital's boarding services, reporting clean accommodations and reliable supervision while traveling. Clients note that exam rooms are peaceful and well equipped for comprehensive feline diagnostic testing."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Memorial Cat Hospital see dogs or other animals?"
      },
      "a": {
        "en": "No, the facility is strictly feline-only and specializes exclusively in medical care and surgery for cats."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can the veterinary team treat nervous or fractious cats?"
      },
      "a": {
        "en": "Yes, clients frequently note that clinicians and technicians handle aggressive or frightened cats with exceptional patience and gentle technique."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic offer feline boarding services?"
      },
      "a": {
        "en": "Yes, reviewers mention boarding their cats here during travel, citing attentive care and peace of mind in a dog-free environment."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How experienced are the doctors in feline internal medicine?"
      },
      "a": {
        "en": "Multiple clients highlight board-certified feline specialists on staff who diagnose complex conditions such as diabetes and feline infectious peritonitis."
      },
      "basis": "reviews"
    }
  ],
