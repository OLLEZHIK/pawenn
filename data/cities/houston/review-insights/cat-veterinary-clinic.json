  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 76,
      "title": {
        "en": "Compassionate, attentive feline care team"
      },
      "text": {
        "en": "Cat owners across Houston Heights widely praise the veterinarians, veterinary technicians, and front desk staff at this feline-only facility. Reviewers frequently highlight Dr. Cullen and Dr. Todd for their gentle bedside manner, thorough medical evaluations, and empathetic support. Although a few clients noted administrative and billing delays, the overwhelming majority describe the staff as dedicated and kind."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 72,
      "title": {
        "en": "Fear-free handling tailored for felines"
      },
      "text": {
        "en": "Reviewers consistently commend the clinic's gentle, cat-focused handling methods and stress-free atmosphere. Many pet owners note that cats who are normally terrified at traditional mixed-animal clinics stay remarkably calm, relaxed, and cooperative here. Clients deeply appreciate that examinations, vaccinations, and nail trims are conducted with patience, love, and quiet care."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Thorough medical guidance and consultation"
      },
      "text": {
        "en": "Pet owners appreciate that veterinarians take ample time during appointments to listen carefully, explain diagnoses in detail, and answer questions. Many clients note receiving prompt telephone follow-ups regarding lab results and treatment options. While a couple of reviewers experienced difficulty reaching office management regarding deposit refunds, most highlight clear communication."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Cat Veterinary Clinic treat dogs or other pets?"
      },
      "a": {
        "en": "No, the clinic exclusively cares for feline patients, providing a quiet, dog-free medical environment."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How do veterinarians handle highly anxious or fearful cats?"
      },
      "a": {
        "en": "Reviewers consistently note that doctors and technicians use gentle, low-stress handling methods to keep nervous cats calm."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are appointment deposits required before booking?"
      },
      "a": {
        "en": "Client reviews indicate that the clinic collects appointment deposits that apply toward the final balance."
      },
      "basis": "reviews"
    }
  ],
