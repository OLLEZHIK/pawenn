  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 37,
      "title": {
        "en": "Feline-focused expertise from veterinarians and technicians"
      },
      "text": {
        "en": "Reviewers warmly praise Dr. Becker, Dr. Rodriguez, and vet technicians like Toni and Whitney for specialized feline care and unhurried bedside manner. Cat owners appreciate that the team listens attentively to health histories. Although one reviewer noted frustration over office communication, the staff earns high praise for genuine warmth."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 21,
      "title": {
        "en": "Stress-free handling in dog-free clinic"
      },
      "text": {
        "en": "Clients emphasize the quiet, peaceful atmosphere of an exclusively feline hospital. Nervous and spicy cats remain visibly calmer without the sounds and scents of barking dogs in the waiting room. The veterinary team takes extra time to comfort fearful patients with gentle petting, soothing voices, and cat treats during routine exams."
      }
    },
    {
      "topic": "communication",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "en": "Informative medical guidance with prescription hurdles"
      },
      "text": {
        "en": "Most cat parents commend the doctors for thorough consultations, transparent treatment plans, and clear post-visit guidance. However, two dissatisfied clients cited administrative frustrations, particularly regarding difficulty obtaining written prescriptions for third-party pharmacies and occasional delays in scheduling callbacks."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic treat animals other than cats?"
      },
      "a": {
        "en": "No, Houston Cat Hospital is dedicated exclusively to feline medicine and surgery, providing a completely dog-free environment."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are same-day emergency appointments available for sick cats?"
      },
      "a": {
        "en": "Yes, reviewers report that the hospital accommodates urgent appointments on the same day when cats show acute respiratory or digestive distress."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can clients request external prescriptions for online pharmacies?"
      },
      "a": {
        "en": "While the clinic has an in-house pharmacy, clients note that physical paper prescriptions may require office pickup rather than automated transfers."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Is Houston Cat Hospital open on weekends?"
      },
      "a": {
        "en": "The hospital is open on Saturdays from 8:00 AM to 1:00 PM for scheduled appointments, and is closed on Sundays."
      },
      "basis": "website"
    }
  ],
