  "cards": [
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Patient care for nervous dogs"
      },
      "text": {
        "en": "Reviewers emphasize how patiently groomers and retail staff work with sensitive, anxious, or difficult dogs. Dog owners praise the grooming team, particularly Reahna, for taking extra time to reassure dogs during baths, nail trims, and haircuts. Although one owner reported an agitated large dog struggling during a floor nail trim, the vast majority of clients feel their pets are handled with genuine affection."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 23,
      "title": {
        "en": "Enthusiastic service and knowledgeable guidance"
      },
      "text": {
        "en": "Shoppers consistently highlight the warm greetings and hands-on guidance provided by associates like Alyssa, Michele, and Marlie. Staff members assist with pet food selections, carry heavy bags, and explain aquarium setup requirements in detail. While a few reviewers reported customer service friction during dog wash visits or when requesting help with large bags, most clients describe an exceptionally welcoming store team."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 16,
      "title": {
        "en": "High-quality grooming and coat maintenance"
      },
      "text": {
        "en": "Pet owners express great satisfaction with haircut styling, nail trimming, and bath services completed in the grooming salon. Reviewers frequently commend groomer Reahna for delivering neat, even haircuts that leave pets smelling fresh and looking clean. Aside from one client reporting a difficult nail trim on an unruly dog, clients report that grooming appointments leave their pets looking and feeling great."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does this store have a self-service dog wash station?"
      },
      "a": {
        "en": "Yes, customers report that the location provides a convenient self-service dog wash equipped with tubs, towels, and shampoos."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can owners book professional dog grooming appointments?"
      },
      "a": {
        "en": "Yes, reviewers frequently praise the in-store groomers for full-service haircuts, bath packages, and quick nail trims."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are associates available to help with pet nutrition choices?"
      },
      "a": {
        "en": "Yes, clients note that staff members walk the aisles with owners to help select appropriate dog food formulas and enroll in store rewards."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are leashed pets allowed inside the store?"
      },
      "a": {
        "en": "Yes, pet parents regularly bring their dogs inside to shop and visit the grooming and bathing stations."
      },
      "basis": "reviews"
    }
