  "cards": [
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "en": "Immaculate haircuts and grooming styling"
      },
      "text": {
        "en": "Clients rave about the exceptional quality of haircuts, bath packages, and neat scissor work. Dogs consistently leave looking fresh, smelling wonderful, and adorned with signature seasonal bandanas. While one owner reported superficial clipper scratches on a puppy, the vast majority highlight consistent, photo-ready styling across multiple visits."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 40,
      "title": {
        "en": "Loving care for pampered dogs"
      },
      "text": {
        "en": "Pet owners consistently note that their dogs love visiting the Tanglewood salon and arrive excitedly rather than showing fear. The stylists handle nervous rescues and energetic doodles with genuine affection, ensuring dogs remain relaxed throughout washing and blow-drying. Clients feel confident entrusting their beloved companions to the salon."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 24,
      "title": {
        "en": "Friendly, welcoming salon and boutique associates"
      },
      "text": {
        "en": "Reviewers emphasize the warm greeting from front-desk staff and the attentiveness of groomers such as Leo and Ashley. Stylists take time before each appointment to discuss specific coat preferences, scissor lengths, and nail trims. Clients appreciate the friendly environment and proactive updates when grooming sessions finish."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Are gourmet treats and custom cakes available at the salon?"
      },
      "a": {
        "en": "Yes, the boutique features a dedicated pet bakery offering freshly baked dog treats, decorated cookies, and celebration cakes."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do the groomers cater to specific dog breeds and sizes?"
      },
      "a": {
        "en": "Yes, groomers style all dog breeds and coat types, ranging from small Maltipoos to large Doodles."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does every grooming service include accessories like bandanas?"
      },
      "a": {
        "en": "Reviewers frequently note that dogs receive cute complimentary bandanas or bows following their grooming appointments."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are appointments required for full grooming services?"
      },
      "a": {
        "en": "Yes, scheduled appointments are standard for haircuts and bath packages, while bakery shopping is open for walk-ins."
      },
      "basis": "both"
    }
  ],
