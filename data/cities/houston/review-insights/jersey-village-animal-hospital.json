  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Attentive clinicians and welcoming front desk"
      },
      "text": {
        "en": "Clients consistently commend the veterinarians and support technicians at this AAHA-accredited hospital for their warmth, empathy, and bedside manner. Doctors like Dr. Peralta and Dr. Pham receive frequent praise for thorough examinations and taking time to answer owner questions. While one reviewer expressed disappointment with clinic management, pet parents overwhelmingly describe caring and dedicated personnel."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 25,
      "title": {
        "en": "Patient care for anxious pets"
      },
      "text": {
        "en": "Reviewers emphasize the gentle handling provided to nervous and defensive pets during wellness visits and emergency evaluations. Pet owners appreciate that doctors take a slow approach to help anxious dogs warm up before conducting examinations or administering vaccines. Multiple clients note that staff treat family pets with compassion as if they were their own beloved animals."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 18,
      "title": {
        "en": "Effective diagnostics and wellness treatments"
      },
      "text": {
        "en": "Pet parents highlight successful outcomes across a range of medical needs, from routine preventive vaccinations to emergency stabilization and lab diagnostics. Reviewers describe rapid diagnostic workups and well-planned treatment regimens that helped resolve illnesses like infections and injuries. Clients express confidence in the medical care plans and trust the clinical team with their pets' health."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does Jersey Village Animal Hospital offer online scheduling?"
      },
      "a": {
        "en": "Yes, clients mention that the clinic allows pet owners to book appointments conveniently online, including next-day visits."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "How does the veterinary staff approach anxious dogs?"
      },
      "a": {
        "en": "Reviewers report that clinicians use a gentle, unhurried approach to help nervous dogs stay calm and comfortable during physical exams."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the hospital assist with urgent veterinary situations?"
      },
      "a": {
        "en": "Yes, pet parents report that the clinic accommodates same-day urgent visits and helps stabilize pets before referring to 24/7 trauma hospitals if necessary."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does Jersey Village Animal Hospital provide boarding services?"
      },
      "a": {
        "en": "Yes, reviewers mention utilizing the clinic's boarding accommodations for their pets with attentive supervision from staff."
      },
      "basis": "reviews"
    }
