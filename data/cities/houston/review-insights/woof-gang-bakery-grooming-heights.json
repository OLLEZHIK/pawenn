  "cards": [
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 65,
      "title": {
        "en": "Charming boutique and treat assortment"
      },
      "text": {
        "en": "Visitors highlight the inviting atmosphere and extensive retail selection at this Houston Heights pet boutique and spa. Pet owners love the colorful bakery display cases filled with decorated dog treats, cookies, and seasonal pastries. Many clients note that stopping by to pick up canine birthday cakes or gourmet snacks has become a favorite neighborhood routine for their families."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 59,
      "title": {
        "en": "Patient care and gentle handling"
      },
      "text": {
        "en": "Dog owners frequently note how much their pets enjoy visiting the boutique, often pulling excitedly toward the entrance to greet staff members. Reviewers appreciate that groomers handle anxious or lively dogs with patience during baths, ear cleanings, and haircuts. Clients report feeling reassured that their animals are treated with affection and warmth throughout their salon stay."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 54,
      "title": {
        "en": "Neat haircuts and quality styling"
      },
      "text": {
        "en": "Clients express widespread satisfaction with the visual results of dog grooming sessions at this location. Reviews praise scissor work, fluffy blowouts, and precise breed cuts for doodles, schnauzers, and smaller toy breeds. Although several reviewers noted occasional inconsistencies with cut lengths, the overall feedback indicates dogs leave the salon looking tidy and smelling clean."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does this Houston Heights location offer custom dog cakes and bakery treats?"
      },
      "a": {
        "en": "Yes, clients frequently highlight the wide assortment of decorated canine cookies, birthday cakes, and gourmet bulk treats."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What dog grooming services are available at this salon?"
      },
      "a": {
        "en": "Reviewers mention booking full styling haircuts, luxury baths, nail trims, teeth brushing, and specialized breed styling."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are appointments required for grooming services?"
      },
      "a": {
        "en": "Appointments are recommended for full haircut styling, whereas visitors can browse bakery treats and retail merchandise anytime during open hours."
      },
      "basis": "both"
    }
  ],
