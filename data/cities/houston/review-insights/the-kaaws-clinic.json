  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 65,
      "title": {
        "en": "Approachable clinicians and courteous support staff"
      },
      "text": {
        "en": "Clients consistently commend the friendly and informative veterinary team at KAAWS, highlighting doctors who listen attentively, answer owner questions thoroughly, and refrain from pushing unnecessary treatments. While a few clients noted occasional telephone hold delays or curt receptionist encounters, the overall sentiment regarding the care team is highly appreciative."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "en": "Gentle pet handling and preventative care"
      },
      "text": {
        "en": "Pet owners emphasize that companion dogs and cats are handled with patience and gentleness during wellness checks, routine vaccinations, and surgical admissions. Reviewers note that nervous pets remain settled during physical examinations, and owners appreciate the staff's dedication to maintaining animal comfort throughout clinic visits."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Reliable outcomes in surgery and dentistry"
      },
      "text": {
        "en": "Pet parents report positive recovery experiences following routine spay and neuter procedures, dental cleanings, and diagnostic blood tests. Clients note clear postoperative guidance and prompt telephone follow-ups, with animals returning home healthy and recovering comfortably within a few days."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What services are offered at The KAAWS Clinic?"
      },
      "a": {
        "en": "The clinic provides routine veterinary examinations, vaccinations, low-cost spay and neuter surgeries, and dental cleanings."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Is appointment booking required for clinic visits?"
      },
      "a": {
        "en": "Yes, the practice utilizes an appointment-based scheduling system to minimize lobby waiting times."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How do clients view the clinic's pricing policy?"
      },
      "a": {
        "en": "Pet owners consistently praise the clinic for transparent, fair pricing and non-pushy treatment recommendations."
      },
      "basis": "reviews"
    }
  ],
