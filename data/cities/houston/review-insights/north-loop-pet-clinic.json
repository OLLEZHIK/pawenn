    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 13,
      "title": {
        "en": "Knowledgeable clinicians and bilingual team"
      },
      "text": {
        "en": "Clients frequently highlight the medical knowledge and care provided by Dr. Mares and the clinical team on North Loop Freeway. Pet owners value the bilingual assistance offered in English and Spanish, although a few reviewers noted uneven customer service over the phone or missed familiarity following doctor transitions."
      }
    },
    {
      "topic": "prices",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Economical rates for routine care"
      },
      "text": {
        "en": "Reviewers emphasize that this clinic provides some of the most affordable veterinary care in the area for vaccinations, deworming, and basic exams. Pet parents consistently note that the lower price point makes essential preventive care accessible, even as individual items like flea preventatives have experienced modest price bumps."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 13,
      "title": {
        "en": "Drive-up registration with vehicle waits"
      },
      "text": {
        "en": "Because the clinic operates on a first-come, first-served basis, clients describe lining up in their cars before opening hours. Owners register, pull around back, and wait in their vehicles until called by phone. While some visitors find the turnover smooth, others note that waiting several hours can be common during peak times."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "How does the check-in and waiting system operate?"
      },
      "a": {
        "en": "Clients register on arrival and wait in their vehicles in the parking lot until clinic staff call them when an examination room is ready."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are services available in languages other than English?"
      },
      "a": {
        "en": "Yes, reviewers mention that staff members assist clients in both English and Spanish."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do pet owners need to schedule an appointment in advance?"
      },
      "a": {
        "en": "No, North Loop Pet Clinic operates on a walk-in basis without advance appointments, and clients suggest arriving early in the morning."
      },
      "basis": "reviews"
    }
