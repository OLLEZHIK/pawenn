      "text": {
        "en": "Most reviewers praise the veterinarians, veterinary technicians, and front desk coordinators for their rapid empathy and professionalism during high-stress medical crises. Clients note that doctors take time to comfort worried families and treat critical pets with tenderness."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Life-saving emergency and ICU interventions"
      },
      "text": {
        "en": "Pet parents frequently report successful medical outcomes for acute trauma, severe respiratory distress, toxic ingestion, and emergency surgeries. Many clients credit the hospital's intensive care unit and prompt stabilization with saving their beloved animals' lives."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Equipped round-the-clock trauma facility"
      },
      "text": {
        "en": "Clients highlight the modern hospital environment, advanced diagnostic suites, and orderly patient areas available 24 hours a day. Pet owners appreciate having access to a fully staffed emergency trauma center capable of handling severe nighttime medical complications."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is VERGI open 24 hours every day?"
      },
      "a": {
        "en": "Yes, VERGI operates as a full-service veterinary emergency hospital 24 hours a day, 365 days a year."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are appointments required for emergency visits?"
      },
      "a": {
        "en": "No appointment is required; pet owners can arrive at any hour, though calling ahead helps the medical team prepare for critical arrivals."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Does VERGI provide intensive care hospitalization?"
      },
      "a": {
        "en": "Yes, the facility is equipped with an intensive care unit (ICU) and continuous monitoring for critically ill or postoperative pets."
      },
      "basis": "both"
    }
