  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 25,
      "title": {
        "en": "Helpful guidance alongside customer service critiques"
      },
      "text": {
        "en": "Many shoppers praise the store employees and owner for their extensive knowledge of exotic pets, reptiles, fish, and proper nutrition, highlighting patient guidance when selecting new animals. Conversely, several dissatisfied customers report unhelpful counter service, rude attitudes, and unwelcoming interactions, noting that attentiveness can vary significantly depending on who is working."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 21,
      "title": {
        "en": "Wide exotic variety with enclosure concerns"
      },
      "text": {
        "en": "Customers appreciate the shop's diverse inventory of tropical fish, feeder insects, reptiles, rodents, and exotic creatures like bearded dragons. Many report receiving thriving pets and helpful habitat setup advice. On the other hand, multiple reviewers raise concerns regarding animal wellness, citing occasional parasite issues in rodents, crowded plastic enclosures, or unstocked feeder fish."
      }
    },
    {
      "topic": "place",
      "sentiment": "mixed",
      "mentions": 10,
      "title": {
        "en": "Cozy shop setting with maintenance debates"
      },
      "text": {
        "en": "Reviewers often describe the shop as an inviting neighborhood fixture stocked with niche products that large chain pet stores rarely carry. At the same time, several visitors express discomfort with store conditions, specifically pointing out strong odors, gnat infestations near enclosures, and cluttered aisles that detract from the shopping environment."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "What types of pets and supplies does Animal Ark specialize in?"
      },
      "a": {
        "en": "The shop specializes in exotic animals, including reptiles, tropical fish, small rodents, and live feeder insects, alongside specialized habitat gear."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Do employees provide setup advice for first-time reptile owners?"
      },
      "a": {
        "en": "Yes, reviewers frequently praise experienced staff members like Kevin and Kobe for educating buyers on reptile care, nutrition, and tank setups."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are live feeder insects and feeder fish regularly available?"
      },
      "a": {
        "en": "While the store stocks live worms and feeder insects, multiple reviewers mention occasional shortages of feeder fish and specialty live cultures."
      },
      "basis": "reviews"
    }
