      "title": {
        "en": "Cage-free environment for small dogs"
      },
      "text": {
        "en": "Dog owners highlight the safe, crate-free atmosphere designed specifically for small dogs to socialize and exercise without fear of larger breeds. Reviewers frequently note that their pets return home happy and comfortably tired from daily supervised activities and play."
      }
    },
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 48,
      "title": {
        "en": "Caring and attentive daycare attendants"
      },
      "text": {
        "en": "Clients describe a warm and dedicated team that remembers individual dogs by name and accommodates special routines with genuine kindness. While the vast majority praise employee attentiveness, one owner expressed disappointment with staff changes and communication."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 42,
      "title": {
        "en": "Gentle bathing and professional grooming"
      },
      "text": {
        "en": "Pet parents praise the on-site grooming services, noting that dogs return clean, well-trimmed, and smelling fresh after boarding or daycare stays. Reviewers appreciate that groomers handle anxious pups with patience and follow specific styling and bath instructions."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Is the facility limited to small dogs only?"
      },
      "a": {
        "en": "Yes, the daycare and boarding facilities are exclusively dedicated to dogs thirty-five pounds and under to ensure safety during group play."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are dogs kept in crates during daycare or boarding?"
      },
      "a": {
        "en": "No, the facility operates entirely cage-free and crate-free throughout daytime hours, with staff remaining on-site overnight for supervision."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can pet owners request grooming services during boarding stays?"
      },
      "a": {
        "en": "Yes, clients frequently schedule baths, nail trims, and full haircuts for their dogs prior to departure or pick-up."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Do clients receive daily updates during overnight boarding?"
      },
      "a": {
        "en": "Pet parents report receiving daily photo updates and messages reassuring them about their pet's activities while they are away."
      },
      "basis": "reviews"
    }
