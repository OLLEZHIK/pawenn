    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 31,
      "title": {
        "en": "Dedicated clinicians alongside receptionist friction"
      },
      "text": {
        "en": "Many pet owners praise Dr. Challa and individual vet assistants for their dedicated care, thoroughness, and kindness toward animals. In contrast, several reviewers voice strong frustration with front-desk staff, reporting curt answers, unhelpful phone communication, and indifferent attitudes upon arrival."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "mixed",
      "mentions": 27,
      "title": {
        "en": "Lengthy lines and parking-lot waits"
      },
      "text": {
        "en": "Clients note that because this is a high-volume walk-in clinic, waits can extend from one to two hours or more, frequently requiring owners to wait in their vehicles before being called inside. Those who arrive right before morning opening generally report faster turnover than afternoon walk-ins."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 22,
      "title": {
        "en": "Effective preventive and dental treatments"
      },
      "text": {
        "en": "Pet parents highlight successful outcomes for core veterinary procedures, including dental cleanings, spay and neuter surgeries, puppy vaccinations, and parasite treatments. While a small number of clients experienced complications or diagnostic disputes, most report that their pets recovered well."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do clients need an appointment to be seen at the Tidwell clinic?"
      },
      "a": {
        "en": "No, the clinic operates on a walk-in basis, though clients advise arriving early in the morning because lines can form quickly outside."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the waiting process work for walk-ins?"
      },
      "a": {
        "en": "Pet owners typically check in at the front desk and wait in their vehicles until staff call them inside when an exam room becomes available."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "What procedures do pet parents most frequently bring their animals in for?"
      },
      "a": {
        "en": "Reviewers commonly mention routine puppy and kitten vaccines, heartworm medication, dental scale and polish visits, and spay or neuter surgeries."
      },
      "basis": "reviews"
    }
  ],
