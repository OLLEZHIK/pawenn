  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "en": "Trusted veterinarians and caring assistants"
      },
      "text": {
        "en": "The vast majority of clients praise the doctors and technicians for their longstanding dedication and compassionate care. Many pet owners note they have brought their animals here for years and trust the medical judgment of the senior clinicians. While a small number of reviews criticize junior staff or communication, overall sentiment remains warm."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 35,
      "title": {
        "en": "Considerate attention to pet comfort"
      },
      "text": {
        "en": "Clients frequently commend the clinic team for handling dogs and cats gently, easing the anxiety of sick or timid animals during consultations. Reviewers appreciate that veterinarians take time to examine pets thoroughly without making them feel frightened or rushed. Pet owners feel their companions are treated with genuine affection."
      }
    },
    {
      "topic": "place",
      "sentiment": "positive",
      "mentions": 17,
      "title": {
        "en": "Established facility with mixed feedback"
      },
      "text": {
        "en": "Many clients appreciate the welcoming and familiar atmosphere of this neighborhood practice, describing a comfortable setting for routine visits. However, several critical reviewers commented negatively on the aging physical facility and tight waiting area, noting that the building could benefit from updates and better layout management."
      }
    }
  ],
  "faq": [
