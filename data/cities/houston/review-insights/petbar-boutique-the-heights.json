  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 39,
      "title": {
        "en": "Attentive, friendly grooming boutique staff"
      },
      "text": {
        "en": "Reviewers warmly highlight stylists like Karina, Vee, and Grey alongside front desk personnel for their helpful and welcoming service. Many clients express gratitude for staff members who accommodate breed preferences and handle large or high-shedding dogs with patience. A few clients reported negative customer service exchanges following haircut complaints."
      }
    },
    {
      "topic": "results",
      "sentiment": "positive",
      "mentions": 38,
      "title": {
        "en": "Neat haircuts and thorough bathing services"
      },
      "text": {
        "en": "Pet parents frequently praise the finished results of full-service grooming sessions, mentioning clean de-shedding baths, tidy trims, and neat breed haircuts. Many clients report dogs smelling fresh and looking well-groomed for weeks. Conversely, a few reviewers expressed disappointment over uneven coats or cuts that did not match styling requests."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 11,
      "title": {
        "en": "Contrasting accounts of pet care experiences"
      },
      "text": {
        "en": "Numerous pet owners share that their dogs love visiting the salon and receive gentle, patient care from familiar groomers. However, several critical reviews raised serious concerns regarding pet safety, including heat distress in short-nosed breeds and an accidental clipper nick. Experiences vary between routine satisfaction and acute distress."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the boutique offer self-service dog washing tubs?"
      },
      "a": {
        "en": "Yes, clients frequently utilize elevated self-serve wash stations equipped with shampoo, aprons, and towels."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Are membership bath packages available?"
      },
      "a": {
        "en": "Yes, reviewers mention subscribing to unlimited monthly bath memberships for routine dog upkeep."
      },
      "basis": "both"
    },
    {
      "q": {
        "en": "Can owners request specific groomers for appointments?"
      },
      "a": {
        "en": "Yes, pet parents frequently schedule recurring visits with preferred stylists such as Karina, Vee, or Grey."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are large or shedding dogs accommodated?"
      },
      "a": {
        "en": "Yes, clients report bringing in large breeds including German Shepherds, Labradors, and Goldendoodles."
      },
      "basis": "reviews"
    }
