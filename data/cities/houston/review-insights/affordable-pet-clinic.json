  "cards": [
    {
      "topic": "staff",
      "sentiment": "mixed",
      "mentions": 34,
      "title": {
        "en": "Divided feedback across clinical teams"
      },
      "text": {
        "en": "Client feedback reveals a sharp divide between the veterinary medical team and the reception staff. Many pet owners commend attending veterinarians and technicians for their dedication, kindness, and clear answers. Conversely, numerous reviewers express frustration with receptionists and management, citing rude interactions, unhelpful telephone manners, and disorganization at the front counter."
      }
    },
    {
      "topic": "waiting",
      "sentiment": "negative",
      "mentions": 18,
      "title": {
        "en": "Frequent delays and scheduling backlogs"
      },
      "text": {
        "en": "Lengthy waiting times are a prominent subject of customer dissatisfaction at this clinic. Numerous pet parents report waiting between one and four hours to be examined, even after booking appointments well in advance. Several clients note confusion regarding walk-in priority over scheduled visits, while others describe crowded waiting areas and unpredictable delays."
      }
    },
    {
      "topic": "animals",
      "sentiment": "mixed",
      "mentions": 13,
      "title": {
        "en": "Gentle attention with occasional concerns"
      },
      "text": {
        "en": "Most pet owners highlight gentle and compassionate handling for dogs and cats during checkups, vaccinations, and surgical procedures, with several noting patient care for anxious or reactive pets. However, a minority of reviewers report distressing experiences, including rough handling during bone examinations or pets experiencing heightened stress during treatments."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Do pet owners recommend booking an appointment in advance?"
      },
      "a": {
        "en": "Yes, reviewers advise booking an appointment because walk-in visits can involve wait times of several hours."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are procedure and examination prices considered affordable?"
      },
      "a": {
        "en": "Many clients report that basic checkups, vaccinations, and surgeries are budget-friendly, though some owners note unexpected service charges."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Can clients reach the clinic easily by telephone?"
      },
      "a": {
        "en": "Reviewers frequently mention difficulty reaching reception by phone, reporting prolonged hold times and occasional dropped calls."
      },
      "basis": "reviews"
    }
  ],
