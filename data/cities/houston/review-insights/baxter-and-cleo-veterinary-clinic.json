  "cards": [
    {
      "topic": "staff",
      "sentiment": "positive",
      "mentions": 41,
      "title": {
        "en": "Caring clinicians and attentive nursing team"
      },
      "text": {
        "en": "Reviewers frequently commend veterinarians like Dr. Irell, Dr. Tran, and Dr. Nguyenphat alongside veterinary nurses for their warmth, patience, and dedication. Clients appreciate that staff members take time to answer detailed medical questions during wellness visits. While two owners felt disappointed by interactions during serious illnesses, most visitors praise a supportive clinic culture."
      }
    },
    {
      "topic": "animals",
      "sentiment": "positive",
      "mentions": 31,
      "title": {
        "en": "Gentle techniques for nervous pets"
      },
      "text": {
        "en": "Pet owners consistently remark on how skillfully the team puts anxious, fearful, or senior dogs and cats at ease. Clients highlight calm handling during blood draws, nail trims, and surgical procedures that minimizes animal stress. Multiple reviewers note that technicians and doctors make their pets feel safe and loved from check-in to examination."
      }
    },
    {
      "topic": "communication",
      "sentiment": "positive",
      "mentions": 12,
      "title": {
        "en": "Clear explanations and attentive follow-up"
      },
      "text": {
        "en": "Pet parents highlight the clinic's transparent communication, noting that clinicians explain diagnoses clearly and outline treatment options without rush. Clients value prompt email responses and thoughtful follow-up calls or condolence letters during difficult moments. A few reviewers noted communication hiccups around urgent callbacks, but overall communication is rated highly."
      }
    }
  ],
  "faq": [
    {
      "q": {
        "en": "Does the clinic accommodate emergency and same-day visits?"
      },
      "a": {
        "en": "Yes, multiple reviewers note that the clinic accommodated same-day urgent appointments when their pets experienced sudden illnesses."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "How does the team handle anxious or fearful pets?"
      },
      "a": {
        "en": "Clients report that nurses and doctors use gentle, fear-free handling techniques that keep stressed dogs and cats calm during exams."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Are veterinary fees explained transparently?"
      },
      "a": {
        "en": "Yes, clients frequently mention that staff provide clear cost estimates and discuss treatment options transparently before procedures."
      },
      "basis": "reviews"
    },
    {
      "q": {
        "en": "Does the clinic treat both dogs and cats?"
      },
      "a": {
        "en": "Yes, reviewers regularly bring dogs, puppies, cats, and senior felines for wellness checkups, diagnostics, and routine surgeries."
      },
      "basis": "reviews"
    }
