 tabindex="0"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2" href="#contact">Contact Us</a></div></div></div></div></div></div></section><section id="howItWorks" class="w-full relative block" style="opacity:0"><div class="w-full py-12 md:py-20 bg-gray-50/80 backdrop-blur-sm"><div class="container mx-auto px-4"><div style="opacity:0;transform:scale(0.95)" class=""><div class="text-center mb-8 md:mb-12"><h2 class="text-2xl md:text-4xl font-bold mb-3 md:mb-4 heading-underline">How Mobile Grooming Works</h2></div></div><div class="" style="opacity:0;transform:translateY(50px)"><div class="max-w-4xl mx-auto"><div class="text-center mb-8 md:mb-12" style="opacity:0"><div class="relative inline-block cursor-pointer group" tabindex="0"><div class="relative rounded-lg overflow-hidden shadow-xl"><img alt="Cool Dog Spa Mobile Grooming Van" loading="lazy" width="500" height="280" decoding="async" data-nimg="1" class="object-cover" style="color:transparent" src="/images/cooldog-van.png"/><div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors flex items-center justify-center"><div class="bg-white/90 rounded-full p-4 shadow-lg group-hover:bg-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play h-8 w-8 text-brand-orange"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg></div></div></div><div class="absolute bottom-0 left-0 right-0 bg-brand-orange text-white py-2 text-center font-medium">Watch